@anon.0af3f26833e13fc8eded44d8b0371b09.189 = private unnamed_addr constant <{ [13360 x i8] }> <{ [13360 x i8] c"type AliasRule = { type: 'ALIAS'; named: boolean; content: Rule; value: string };\0Atype BlankRule = { type: 'BLANK' };\0Atype ChoiceRule = { type: 'CHOICE'; members: Rule[] };\0Atype FieldRule = { type: 'FIELD'; name: string; content: Rule };\0Atype ImmediateTokenRule = { type: 'IMMEDIATE_TOKEN'; content: Rule };\0Atype PatternRule = { type: 'PATTERN'; value: string };\0Atype PrecDynamicRule = { type: 'PREC_DYNAMIC'; content: Rule; value: number };\0Atype PrecLeftRule = { type: 'PREC_LEFT'; content: Rule; value: number };\0Atype PrecRightRule = { type: 'PREC_RIGHT'; content: Rule; value: number };\0Atype PrecRule = { type: 'PREC'; content: Rule; value: number };\0Atype Repeat1Rule = { type: 'REPEAT1'; content: Rule };\0Atype RepeatRule = { type: 'REPEAT'; content: Rule };\0Atype SeqRule = { type: 'SEQ'; members: Rule[] };\0Atype StringRule = { type: 'STRING'; value: string };\0Atype SymbolRule<Name extends string> = { type: 'SYMBOL'; name: Name };\0Atype TokenRule = { type: 'TOKEN'; content: Rule };\0A\0Atype Rule =\0A  | AliasRule\0A  | BlankRule\0A  | ChoiceRule\0A  | FieldRule\0A  | ImmediateTokenRule\0A  | PatternRule\0A  | PrecDynamicRule\0A  | PrecLeftRule\0A  | PrecRightRule\0A  | PrecRule\0A  | Repeat1Rule\0A  | RepeatRule\0A  | SeqRule\0A  | StringRule\0A  | SymbolRule<string>\0A  | TokenRule;\0A\0Atype RuleOrLiteral = Rule | RegExp | string;\0A\0Atype GrammarSymbols<RuleName extends string> = {\0A  [name in RuleName]: SymbolRule<name>;\0A} &\0A  Record<string, SymbolRule<string>>;\0A\0Atype RuleBuilder<RuleName extends string> = (\0A  $: GrammarSymbols<RuleName>,\0A  previous: Rule,\0A) => RuleOrLiteral;\0A\0Atype RuleBuilders<\0A  RuleName extends string,\0A  BaseGrammarRuleName extends string\0A> = {\0A    [name in RuleName]: RuleBuilder<RuleName | BaseGrammarRuleName>;\0A  };\0A\0Ainterface Grammar<\0A  RuleName extends string,\0A  BaseGrammarRuleName extends string = never,\0A  Rules extends RuleBuilders<RuleName, BaseGrammarRuleName> = RuleBuilders<\0A    RuleName,\0A    BaseGrammarRuleName\0A  >\0A> {\0A  /**\0A   * Name of the grammar language.\0A   */\0A  name: string;\0A\0A  /** Mapping of grammar rule names to rule builder functions. */\0A  rules: Rules;\0A\0A  /**\0A   * An array of arrays of precedence names or rules. Each inner array represents\0A   * a *descending* ordering. Names/rules listed earlier in one of these arrays\0A   * have higher precedence than any names/rules listed later in the same array.\0A   *\0A   * Using rules is just a shorthand way for using a name then calling prec()\0A   * with that name. It is just a convenience.\0A   */\0A  precedences?: (\0A    $: GrammarSymbols<RuleName | BaseGrammarRuleName>,\0A    previous: Rule[][],\0A  ) => RuleOrLiteral[][],\0A\0A  /**\0A   * An array of arrays of rule names. Each inner array represents a set of\0A   * rules that's involved in an _LR(1) conflict_ that is _intended to exist_\0A   * in the grammar. When these conflicts occur at runtime, Tree-sitter will\0A   * use the GLR algorithm to explore all of the possible interpretations. If\0A   * _multiple_ parses end up succeeding, Tree-sitter will pick the subtree\0A   * whose corresponding rule has the highest total _dynamic precedence_.\0A   *\0A   * @param $ grammar rules\0A   */\0A  conflicts?: (\0A    $: GrammarSymbols<RuleName | BaseGrammarRuleName>,\0A    previous: Rule[][],\0A  ) => RuleOrLiteral[][];\0A\0A  /**\0A   * An array of token names which can be returned by an _external scanner_.\0A   * External scanners allow you to write custom C code which runs during the\0A   * lexing process in order to handle lexical rules (e.g. Python's indentation\0A   * tokens) that cannot be described by regular expressions.\0A   *\0A   * @param $ grammar rules\0A   * @param previous array of externals from the base schema, if any\0A   *\0A   * @see https://tree-sitter.github.io/tree-sitter/creating-parsers#external-scanners\0A   */\0A  externals?: (\0A    $: Record<string, SymbolRule<string>>,\0A    previous: Rule[],\0A  ) => RuleOrLiteral[];\0A\0A  /**\0A   * An array of tokens that may appear anywhere in the language. This\0A   * is often used for whitespace and comments. The default value of\0A   * extras is to accept whitespace. To control whitespace explicitly,\0A   * specify extras: `$ => []` in your grammar.\0A   *\0A   *  @param $ grammar rules\0A   */\0A  extras?: (\0A    $: GrammarSymbols<RuleName | BaseGrammarRuleName>,\0A  ) => RuleOrLiteral[];\0A\0A  /**\0A   * An array of rules that should be automatically removed from the\0A   * grammar by replacing all of their usages with a copy of their definition.\0A   * This is useful for rules that are used in multiple places but for which\0A   * you don't want to create syntax tree nodes at runtime.\0A   *\0A   * @param $ grammar rules\0A   */\0A  inline?: (\0A    $: GrammarSymbols<RuleName | BaseGrammarRuleName>,\0A    previous: Rule[],\0A  ) => RuleOrLiteral[];\0A\0A  /**\0A   * A list of hidden rule names that should be considered supertypes in the\0A   * generated node types file.\0A   *\0A   * @param $ grammar rules\0A   *\0A   * @see https://tree-sitter.github.io/tree-sitter/using-parsers#static-node-types\0A   */\0A  supertypes?: (\0A    $: GrammarSymbols<RuleName | BaseGrammarRuleName>,\0A    previous: Rule[],\0A  ) => RuleOrLiteral[];\0A\0A  /**\0A   * The name of a token that will match keywords for the purpose of the\0A   * keyword extraction optimization.\0A   *\0A   * @param $ grammar rules\0A   *\0A   * @see https://tree-sitter.github.io/tree-sitter/creating-parsers#keyword-extraction\0A   */\0A  word?: ($: GrammarSymbols<RuleName | BaseGrammarRuleName>) => RuleOrLiteral;\0A}\0A\0Atype GrammarSchema<RuleName extends string> = {\0A  [K in keyof Grammar<RuleName>]: K extends 'rules'\0A  ? Record<RuleName, Rule>\0A  : Grammar<RuleName>[K];\0A};\0A\0A/**\0A * Causes the given rule to appear with an alternative name in the syntax tree.\0A * For instance with `alias($.foo, 'bar')`, the aliased rule will appear as an\0A * anonymous node, as if the rule had been written as the simple string.\0A *\0A * @param rule rule that will be aliased\0A * @param name target name for the alias\0A */\0Adeclare function alias(rule: RuleOrLiteral, name: string): AliasRule;\0A\0A/**\0A * Causes the given rule to appear as an alternative named node, for instance\0A * with `alias($.foo, $.bar)`, the aliased rule `foo` will appear as a named\0A * node called `bar`.\0A *\0A * @param rule rule that will be aliased\0A * @param symbol target symbol for the alias\0A */\0Adeclare function alias(\0A  rule: RuleOrLiteral,\0A  symbol: SymbolRule<string>,\0A): AliasRule;\0A\0A/**\0A * Creates a blank rule, matching nothing.\0A */\0Adeclare function blank(): BlankRule;\0A\0A/**\0A * Assigns a field name to the child node(s) matched by the given rule.\0A * In the resulting syntax tree, you can then use that field name to\0A * access specific children.\0A *\0A * @param name name of the field\0A * @param rule rule the field should match\0A */\0Adeclare function field(name: string, rule: RuleOrLiteral): FieldRule;\0A\0A/**\0A * Creates a rule that matches one of a set of possible rules. The order\0A * of the arguments does not matter. This is analogous to the `|` (pipe)\0A * operator in EBNF notation.\0A *\0A * @param options possible rule choices\0A */\0Adeclare function choice(...options: RuleOrLiteral[]): ChoiceRule;\0A\0A/**\0A * Creates a rule that matches zero or one occurrence of a given rule.\0A * It is analogous to the `[x]` (square bracket) syntax in EBNF notation.\0A *\0A * @param value rule to be made optional\0A */\0Adeclare function optional(rule: RuleOrLiteral): ChoiceRule;\0A\0A/**\0A * Marks the given rule with a precedence which will be used to resolve LR(1)\0A * conflicts at parser-generation time. When two rules overlap in a way that\0A * represents either a true ambiguity or a _local_ ambiguity given one token\0A * of lookahead, Tree-sitter will try to resolve the conflict by matching the\0A * rule with the higher precedence.\0A *\0A * Precedence values can either be strings or numbers. When comparing rules\0A * with numerical precedence, higher numbers indicate higher precedences. To\0A * compare rules with string precedence, Tree-sitter uses the grammar's `precedences`\0A * field.\0A *\0A * rules is zero. This works similarly to the precedence directives in Yacc grammars.\0A *\0A * @param value precedence weight\0A * @param rule rule being weighted\0A *\0A * @see https://en.wikipedia.org/wiki/LR_parser#Conflicts_in_the_constructed_tables\0A * @see https://docs.oracle.com/cd/E19504-01/802-5880/6i9k05dh3/index.html\0A */\0Adeclare const prec: {\0A  (value: String | number, rule: RuleOrLiteral): PrecRule;\0A\0A  /**\0A   * Marks the given rule as left-associative (and optionally applies a\0A   * numerical precedence). When an LR(1) conflict arises in which all of the\0A   * rules have the same numerical precedence, Tree-sitter will consult the\0A   * rules' associativity. If there is a left-associative rule, Tree-sitter\0A   * will prefer matching a rule that ends _earlier_. This works similarly to\0A   * associativity directives in Yacc grammars.\0A   *\0A   * @param value (optional) precedence weight\0A   * @param rule rule to mark as left-associative\0A   *\0A   * @see https://docs.oracle.com/cd/E19504-01/802-5880/6i9k05dh3/index.html\0A   */\0A  left(rule: RuleOrLiteral): PrecLeftRule;\0A  left(value: String | number, rule: RuleOrLiteral): PrecLeftRule;\0A\0A  /**\0A   * Marks the given rule as right-associative (and optionally applies a\0A   * numerical precedence). When an LR(1) conflict arises in which all of the\0A   * rules have the same numerical precedence, Tree-sitter will consult the\0A   * rules' associativity. If there is a right-associative rule, Tree-sitter\0A   * will prefer matching a rule that ends _later_. This works similarly to\0A   * associativity directives in Yacc grammars.\0A   *\0A   * @param value (optional) precedence weight\0A   * @param rule rule to mark as right-associative\0A   *\0A   * @see https://docs.oracle.com/cd/E19504-01/802-5880/6i9k05dh3/index.html\0A   */\0A  right(rule: RuleOrLiteral): PrecRightRule;\0A  right(value: String | number, rule: RuleOrLiteral): PrecRightRule;\0A\0A  /**\0A   * Marks the given rule with a numerical precedence which will be used to\0A   * resolve LR(1) conflicts at _runtime_ instead of parser-generation time.\0A   * This is only necessary when handling a conflict dynamically using the\0A   * `conflicts` field in the grammar, and when there is a genuine _ambiguity_:\0A   * multiple rules correctly match a given piece of code. In that event,\0A   * Tree-sitter compares the total dynamic precedence associated with each\0A   * rule, and selects the one with the highest total. This is similar to\0A   * dynamic precedence directives in Bison grammars.\0A   *\0A   * @param value precedence weight\0A   * @param rule rule being weighted\0A   *\0A   * @see https://www.gnu.org/software/bison/manual/html_node/Generalized-LR-Parsing.html\0A   */\0A  dynamic(value: String | number, rule: RuleOrLiteral): PrecDynamicRule;\0A};\0A\0A/**\0A * Creates a rule that matches _zero-or-more_ occurrences of a given rule.\0A * It is analogous to the `{x}` (curly brace) syntax in EBNF notation. This\0A * rule is implemented in terms of `repeat1` but is included because it\0A * is very commonly used.\0A *\0A * @param rule rule to repeat, zero or more times\0A */\0Adeclare function repeat(rule: RuleOrLiteral): RepeatRule;\0A\0A/**\0A * Creates a rule that matches one-or-more occurrences of a given rule.\0A *\0A * @param rule rule to repeat, one or more times\0A */\0Adeclare function repeat1(rule: RuleOrLiteral): Repeat1Rule;\0A\0A/**\0A * Creates a rule that matches any number of other rules, one after another.\0A * It is analogous to simply wri