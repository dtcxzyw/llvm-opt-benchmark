@.str.63 = private unnamed_addr constant [2093 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// C-REPLACE \22std::isinf\22 \22casadi_isinf\22\0A// SYMBOL \22bound_consistency\22\0Atemplate<typename T1>\0Avoid casadi_bound_consistency(casadi_int n, T1* x, T1* lam,\0A                                 const T1* lbx, const T1* ubx) {\0A    // Local variables\0A    casadi_int i;\0A    T1 lb, ub;\0A    // Loop over variables\0A    for (i=0; i<n; ++i) {\0A      // Get bounds\0A      lb = lbx ? lbx[i] : 0.;\0A      ub = ubx ? ubx[i] : 0.;\0A      // Make sure bounds are respected\0A      x[i] = fmin(fmax(x[i], lb), ub);\0A      // Adjust multipliers\0A      if (std::isinf(lb) && std::isinf(ub)) {\0A        // Both multipliers are infinite\0A        lam[i] = 0.;\0A      } else if (std::isinf(lb) || x[i] - lb > ub - x[i]) {\0A        // Infinite lower bound or closer to upper bound than lower bound\0A        lam[i] = fmax(0., lam[i]);\0A      } else if (std::isinf(ub) || x[i] - lb < ub - x[i]) {\0A        // Infinite upper bound or closer to lower bound than upper bound\0A        lam[i] = fmin(0., lam[i]);\0A      }\0A    }\0A}\0A\00", align 1
