@.str.72 = private unnamed_addr constant [3113 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22from_mex\22\0Atemplate<typename T1>\0AT1* casadi_from_mex(const mxArray* p, T1* y, const casadi_int* sp, T1* w) {\0A  casadi_int nrow, ncol, is_sparse, c, k, p_nrow, p_ncol;\0A  const casadi_int *colind, *row;\0A  mwIndex *Jc, *Ir;\0A  const double* p_data;\0A  if (!mxIsDouble(p) || mxGetNumberOfDimensions(p)!=2)\0A    mexErrMsgIdAndTxt(\22Casadi:RuntimeError\22,\0A      \22\\\22from_mex\\\22 failed: Not a two-dimensional matrix of double precision.\22);\0A  nrow = *sp++;\0A  ncol = *sp++;\0A  colind = sp;\0A  row = sp+ncol+1;\0A  p_nrow = mxGetM(p);\0A  p_ncol = mxGetN(p);\0A  is_sparse = mxIsSparse(p);\0A  Jc = 0;\0A  Ir = 0;\0A  if (is_sparse) {\0A    Jc = mxGetJc(p);\0A    Ir = mxGetIr(p);\0A  }\0A  p_data = (const double*)mxGetData(p);\0A  if (p_nrow==1 && p_ncol==1) {\0A    casadi_int nnz;\0A    double v = is_sparse && Jc[1]==0 ? 0 : *p_data;\0A    nnz = sp[ncol];\0A    casadi_fill(y, nnz, v);\0A  } else {\0A    casadi_int tr = 0;\0A    if (nrow!=p_nrow || ncol!=p_ncol) {\0A      tr = nrow==p_ncol && ncol==p_nrow && (nrow==1 || ncol==1);\0A      if (!tr) mexErrMsgIdAndTxt(\22Casadi:RuntimeError\22,\0A                                 \22\\\22from_mex\\\22 failed: Dimension mismatch. \22\0A                                 \22Expected %d-by-%d, got %d-by-%d instead.\22,\0A                                 nrow, ncol, p_nrow, p_ncol);\0A    }\0A    if (is_sparse) {\0A      if (tr) {\0A        for (c=0; c<ncol; ++c)\0A          for (k=colind[c]; k<colind[c+1]; ++k) w[row[k]+c*nrow]=0;\0A        for (c=0; c<p_ncol; ++c)\0A          for (k=Jc[c]; k<(casadi_int) Jc[c+1]; ++k) w[c+Ir[k]*p_ncol] = p_data[k];\0A        for (c=0; c<ncol; ++c)\0A          for (k=colind[c]; k<colind[c+1]; ++k) y[k] = w[row[k]+c*nrow];\0A      } else {\0A        for (c=0; c<ncol; ++c) {\0A          for (k=colind[c]; k<colind[c+1]; ++k) w[row[k]]=0;\0A          for (k=Jc[c]; k<(casadi_int) Jc[c+1]; ++k) w[Ir[k]]=p_data[k];\0A          for (k=colind[c]; k<colind[c+1]; ++k) y[k]=w[row[k]];\0A        }\0A      }\0A    } else {\0A      for (c=0; c<ncol; ++c) {\0A        for (k=colind[c]; k<colind[c+1]; ++k) {\0A          y[k] = p_data[row[k]+c*nrow];\0A        }\0A      }\0A    }\0A  }\0A  return y;\0A}\0A\00", align 1
