@.str.46 = private unnamed_addr constant [1694 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22sparsify\22\0Atemplate<typename T1, typename T2>\0Avoid casadi_sparsify(const T1* x, T2* y, const casadi_int* sp_y, casadi_int tr) {\0A  casadi_int nrow_y, ncol_y, i, el;\0A  const casadi_int *colind_y, *row_y;\0A  nrow_y = sp_y[0];\0A  ncol_y = sp_y[1];\0A  colind_y = sp_y+2; row_y = sp_y+ncol_y+3;\0A  if (tr) {\0A    for (i=0; i<ncol_y; ++i) {\0A      for (el=colind_y[i]; el!=colind_y[i+1]; ++el) {\0A        *y++ = CASADI_CAST(T2, x[i + row_y[el]*ncol_y]);\0A      }\0A    }\0A  } else {\0A    for (i=0; i<ncol_y; ++i) {\0A      for (el=colind_y[i]; el!=colind_y[i+1]; ++el) {\0A        *y++ = CASADI_CAST(T2, x[row_y[el]]);\0A      }\0A      x += nrow_y;\0A    }\0A  }\0A}\0A\00", align 1
