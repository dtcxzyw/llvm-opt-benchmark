@.str.67 = private unnamed_addr constant [6110 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22convexify_strategy_t\22\0Atypedef enum {\0A  CVX_REGULARIZE,\0A  CVX_EIGEN_CLIP,\0A  CVX_EIGEN_REFLECT\0A} casadi_convexify_strategy_t;\0A// SYMBOL \22convexify_type_in_t\22\0Atypedef enum {\0A  CVX_SYMM, CVX_TRIL, CVX_TRIU\0A} casadi_convexify_type_in_t;\0A// SYMBOL \22convexify_config\22\0Atemplate<typename T1>\0Astruct casadi_convexify_config {\0A  casadi_convexify_strategy_t strategy;\0A  casadi_convexify_type_in_t type_in;\0A  const casadi_int * Hsp;\0A  const casadi_int * Hrsp;\0A  T1 margin;\0A  // Projection of Hessian sparsity needed? (cache)\0A  int Hsp_project;\0A  // Reordering of Hessian needed for scc? (cache)\0A  int scc_transform;\0A  /// Block structure of Hessian for certain convexification methods\0A  const casadi_int *scc_offset;\0A  const casadi_int *scc_mapping;\0A  casadi_int scc_offset_size;\0A  /// For eigen-* convexification strategies: maximum iterations for symmetric Schur decomposition\0A  // Needs to be \22big enough\22\0A  casadi_int max_iter_eig;\0A  int verbose;\0A};\0A// C-REPLACE \22casadi_convexify_config<T1>\22 \22struct casadi_convexify_config\22\0A// SYMBOL \22convexify_eval\22\0Atemplate<typename T1>\0Aint convexify_eval(const casadi_convexify_config<T1>* c, const T1* Hin, T1* Hout, casadi_int* iw, T1* w) { // NOLINT(whitespace/line_length)\0A    casadi_int i, j, k, kk, block_size, offset;\0A    int ret;\0A    T1 reg, e;\0A    T1 *H_block, *w_cvx;\0A    casadi_int Hrsp_nnz = c->Hrsp[2+c->Hrsp[1]];\0A    casadi_int nnz = c->Hsp[2+c->Hsp[1]];\0A    if (c->Hsp_project) {\0A      if (Hin==Hout) {\0A        casadi_copy(Hin, Hrsp_nnz, w);\0A        casadi_project(w, c->Hrsp, Hout, c->Hsp, w+Hrsp_nnz);\0A      } else {\0A        casadi_project(Hin, c->Hrsp, Hout, c->Hsp, w);\0A      }\0A    } else {\0A      if (Hin!=Hout) casadi_copy(Hin, nnz, Hout);\0A    }\0A    if (c->strategy==CVX_REGULARIZE) {\0A      // Determine regularization parameter with Gershgorin theorem\0A      reg = c->margin-casadi_lb_eig(c->Hsp, Hout);\0A      if (reg > 0) casadi_regularize(c->Hsp, Hout, reg);\0A    } else if (c->strategy==CVX_EIGEN_REFLECT || c->strategy==CVX_EIGEN_CLIP) {\0A      offset = 0;\0A      // Loop over Hessian blocks\0A      for (k=0;k<c->scc_offset_size-1;++k) {\0A        block_size = c->scc_offset[k+1]-c->scc_offset[k];\0A        H_block = w;\0A        w_cvx = w;\0A        // Set w_cvx to dense Hessian block from Hout\0A        if (c->scc_transform) {\0A          kk=0;\0A          if (c->type_in==CVX_SYMM) {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              // Loop over elements in column\0A              for (j=0;j<block_size;++j, ++kk) {\0A                H_block[kk] = Hout[c->scc_mapping[offset+kk]];\0A              }\0A            }\0A          } else if (c->type_in==CVX_TRIU) {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              // Loop over elements in column\0A              for (j=0;j<i+1;++j, ++kk) {\0A                  e = Hout[c->scc_mapping[offset+kk]];\0A                  H_block[i*block_size+j] = e;\0A                  H_block[i+block_size*j] = e;\0A              }\0A            }\0A          } else {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              for (j=i;j<block_size;++j, ++kk) {\0A                e = Hout[c->scc_mapping[offset+kk]];\0A                H_block[i*block_size+j] = e;\0A                H_block[i+block_size*j] = e;\0A              }\0A            }\0A          }\0A          w_cvx += block_size*block_size;\0A        } else {\0A          H_block = Hout+offset;\0A        }\0A        // Perform convexification\0A        ret = casadi_cvx(block_size, H_block, c->margin, 1e-10,\0A          c->strategy==CVX_EIGEN_REFLECT, c->max_iter_eig, w_cvx, iw);\0A        if (ret) return ret;\0A        // Fill in upper-rectangular part\0A        for (i=0;i<block_size;++i) {\0A          for (j=0;j<i+1;++j) {\0A            H_block[block_size*i+j] = H_block[block_size*j+i];\0A          }\0A        }\0A        // Put results back in Hout\0A        if (c->scc_transform) {\0A          kk=0;\0A          if (c->type_in==CVX_SYMM) {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              // Loop over elements in column\0A              for (j=0;j<block_size;++j, ++kk) {\0A                Hout[c->scc_mapping[offset+kk]] = H_block[kk];\0A              }\0A            }\0A          } else if (c->type_in==CVX_TRIU) {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              // Loop over elements in column\0A              for (j=0;j<i+1;++j, ++kk) {\0A                Hout[c->scc_mapping[offset+kk]] = H_block[block_size*i+j];\0A              }\0A            }\0A          } else {\0A            // Loop over columns of block\0A            for (i=0;i<block_size;++i) {\0A              // Loop over elements in column\0A              for (j=i;j<block_size;++j, ++kk) {\0A                Hout[c->scc_mapping[offset+kk]] = H_block[block_size*i+j];\0A              }\0A            }\0A          }\0A        }\0A        if (c->type_in==CVX_SYMM) {\0A          offset += block_size*block_size;\0A        } else {\0A          offset += block_size*(block_size+1)/2;\0A        }\0A      }\0A    }\0A    return 0;\0A  }\0A\00", align 1
