@.str.60 = private unnamed_addr constant [1425 x i8] c"// NOLINT(legal/copyright)\0A// SYMBOL \22bfgs\22\0A// BFGS update\0Atemplate<typename T1>\0Avoid casadi_bfgs(const casadi_int* sp_h, T1* h, const T1* dx,\0A                 const T1* glag, const T1* glag_old, T1* w) {\0A  // Local variables\0A  casadi_int nx;\0A  T1 *yk, *qk, dxBkdx, omega, theta, phi;\0A  // Dimension\0A  nx = sp_h[0];\0A  // Work vectors\0A  yk = w; w += nx;\0A  qk = w; w += nx;\0A  // yk = glag - glag_old\0A  casadi_copy(glag, nx, yk);\0A  casadi_axpy(nx, -1., glag_old, yk);\0A  // qk = H*dx\0A  casadi_clear(qk, nx);\0A  casadi_mv(h, sp_h, dx, qk, 0);\0A  // Calculating theta\0A  dxBkdx = casadi_dot(nx, dx, qk);\0A  // C-REPLACE \22if_else\22 \22casadi_if_else\22\0A  omega = if_else(casadi_dot(nx, yk, dx) < 0.2 * casadi_dot(nx, dx, qk),\0A                  0.8 * dxBkdx / (dxBkdx - casadi_dot(nx, dx, yk)), 1);\0A  // yk = omega * yk + (1 - omega) * qk;\0A  casadi_scal(nx, omega, yk);\0A  casadi_axpy(nx, 1 - omega, qk, yk);\0A  theta = 1. / casadi_dot(nx, dx, yk);\0A  phi = 1. / casadi_dot(nx, qk, dx);\0A  // Update H\0A  casadi_rank1(h, sp_h, theta, yk, yk);\0A  casadi_rank1(h, sp_h, -phi, qk, qk);\0A}\0A// SYMBOL \22bfgs_reset\22\0A// Removes off-diagonal entries\0Atemplate<typename T1>\0Avoid casadi_bfgs_reset(const casadi_int* sp_h, T1* h) {\0A  casadi_int ncol, c, k;\0A  const casadi_int *colind, *row;\0A  ncol = sp_h[1];\0A  colind = sp_h+2; row = sp_h+ncol+3;\0A  for (c=0; c<ncol; ++c) {\0A    for (k=colind[c]; k<colind[c+1]; ++k) {\0A      if (c!=row[k]) h[k] = 0;\0A    }\0A  }\0A}\0A\00", align 1
