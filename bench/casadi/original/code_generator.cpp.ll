@.str.70 = private unnamed_addr constant [5965 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22jac_prob\22\0Atemplate<typename T1>\0Astruct casadi_jac_prob {\0A  // Number of outputs, i.e. rows of the Jacobian\0A  casadi_int n_out;\0A  // Number of inputs, i.e. columns of the Jacobian\0A  casadi_int n_in;\0A  // Number of colors\0A  casadi_int n_color;\0A  // Extended Jacobian sparsity\0A  const casadi_int* sp_ext;\0A  // Jacobian coloring\0A  const casadi_int* coloring;\0A  // Nominal values for inputs, if any\0A  const T1* nom_in;\0A  // Index mapping for outputs (i.e. Jacobian rows), if any\0A  const size_t* map_out;\0A  // Index mapping for inputs (i.e.  Jacobian columns), if any\0A  const size_t* map_in;\0A};\0A// C-REPLACE \22casadi_jac_prob<T1>\22 \22struct casadi_jac_prob\22\0A// SYMBOL \22jac_setup\22\0Atemplate<typename T1>\0Avoid casadi_jac_setup(casadi_jac_prob<T1>* p, const casadi_int* sp_ext,\0A    const casadi_int* coloring) {\0A  // Set pointers\0A  p->sp_ext = sp_ext;\0A  p->coloring = coloring;\0A  // Dimensions are given by the sparsity patterns\0A  p->n_out = sp_ext[0];\0A  p->n_in = sp_ext[1];\0A  p->n_color = coloring[1];\0A  // The following defaults to null\0A  p->nom_in = 0;\0A  p->map_out = 0;\0A  p->map_in = 0;\0A}\0A// SYMBOL \22jac_work\22\0Atemplate<typename T1>\0Avoid casadi_jac_work(const casadi_jac_prob<T1>* p, casadi_int* sz_iw, casadi_int* sz_w) {\0A  // Reset sz_w, sz_iw\0A  *sz_w = *sz_iw = 0;\0A  // Work vectors in data struct\0A  *sz_iw += p->n_in;  // iseed\0A  *sz_w += p->n_in;  // seed\0A  *sz_iw += p->n_out;  // isens\0A  *sz_w += p->n_out;  // sens\0A  *sz_w += p->n_out;  // scal\0A  *sz_iw += p->n_out;  // wrt\0A  *sz_iw += p->n_out;  // nzind\0A}\0A// SYMBOL \22jac_data\22\0Atemplate<typename T1>\0Astruct casadi_jac_data {\0A  // Number of seeds, sensitivities for the current color\0A  casadi_int nseed, nsens;\0A  // Inputs that are being seeded\0A  casadi_int *iseed;\0A  // Set of seeds for the seeded inputs\0A  T1 *seed;\0A  // Set of outputs for which sensitivities are calculated\0A  casadi_int *isens;\0A  // Set of values for the calculated sensitivities\0A  T1 *sens;\0A  // Scaling factors for calculated sensitivities\0A  T1 *scal;\0A  // Input corresponding to calculated sensitivities\0A  casadi_int *wrt;\0A  // Jacobian nonzero corresponding to calculated sensitivities\0A  casadi_int *nzind;\0A};\0A// C-REPLACE \22casadi_jac_data<T1>\22 \22struct casadi_jac_data\22\0A// SYMBOL \22jac_init\22\0Atemplate<typename T1>\0Avoid casadi_jac_init(const casadi_jac_prob<T1>* p, casadi_jac_data<T1>* d,\0A    casadi_int** iw, T1** w) {\0A  // Set work vectors\0A  d->iseed = *iw; *iw += p->n_in;\0A  d->seed = *w; *w += p->n_in;\0A  d->isens = *iw; *iw += p->n_out;\0A  d->sens = *w; *w += p->n_out;\0A  d->scal = *w; *w += p->n_out;\0A  d->wrt = *iw; *iw += p->n_out;\0A  d->nzind = *iw; *iw += p->n_out;\0A}\0A// SYMBOL \22jac_pre\22\0Atemplate<typename T1>\0Avoid casadi_jac_pre(const casadi_jac_prob<T1>* p, casadi_jac_data<T1>* d, casadi_int c) {\0A  // Local variables\0A  casadi_int i, kc, vin, vout, Jk;\0A  double nom, inv_nom;\0A  const casadi_int *color_colind, *color_row, *jac_colind, *jac_row;\0A  // Extract sparsities\0A  color_colind = p->coloring + 2;\0A  color_row = color_colind + p->n_color + 1;\0A  jac_colind = p->sp_ext + 2;\0A  jac_row = jac_colind + p->n_in + 1;\0A  // Loop over input indices for color\0A  d->nseed = d->nsens = 0;\0A  for (kc = color_colind[c]; kc < color_colind[c + 1]; ++kc) {\0A    vin = color_row[kc];\0A    // Nominal value, used as a seed for the column\0A    nom = p->nom_in ? p->nom_in[vin] : 1;\0A    inv_nom = 1. / nom;\0A    // Collect seeds for column\0A    d->seed[d->nseed] = nom;\0A    d->iseed[d->nseed] = vin;\0A    d->nseed++;\0A    // Request corresponding outputs\0A    for (Jk = jac_colind[vin]; Jk < jac_colind[vin + 1]; ++Jk) {\0A      vout = jac_row[Jk];\0A      d->scal[d->nsens] = inv_nom;\0A      d->isens[d->nsens] = vout;\0A      d->wrt[d->nsens] = vin;\0A      d->nzind[d->nsens] = Jk;\0A      d->nsens++;\0A    }\0A  }\0A  // Map indices\0A  if (p->map_in) {\0A    for (i = 0; i < d->nseed; ++i) d->iseed[i] = p->map_in[d->iseed[i]];\0A    for (i = 0; i < d->nsens; ++i) d->wrt[i] = p->map_in[d->wrt[i]];\0A  }\0A  if (p->map_out) {\0A    for (i = 0; i < d->nsens; ++i) d->isens[i] = p->map_out[d->isens[i]];\0A  }\0A}\0A// SYMBOL \22jac_scale\22\0Atemplate<typename T1>\0Avoid casadi_jac_scale(const casadi_jac_prob<T1>* p, casadi_jac_data<T1>* d) {\0A  // Local variables\0A  casadi_int i;\0A  // Scale derivatives\0A  for (i = 0; i < d->nsens; ++i) d->sens[i] *= d->scal[i];\0A}\0A// SYMBOL \22get_sub\22\0Atemplate<typename T1>\0Avoid casadi_get_sub(T1* sub, const casadi_int* sp_a, const T1* nz_a,\0A    casadi_int rbegin, casadi_int rend, casadi_int cbegin, casadi_int cend) {\0A  // Local variables\0A  casadi_int nc, r, c, k;\0A  const casadi_int *colind, *row;\0A  // Quick return if null\0A  if (sub == 0) return;\0A  // Extract sparsity\0A  nc = sp_a[1];\0A  colind = sp_a + 2;\0A  row = colind + nc + 1;\0A  // Loop over columns\0A  for (c = cbegin; c < cend; ++c) {\0A    // Loop over nonzeros\0A    for (k = colind[c]; k < colind[c + 1]; ++k) {\0A      // Get row\0A      r = row[k];\0A      // Save, if in range\0A      if (r >= rbegin && r < rend) *sub++ = nz_a[k];\0A    }\0A  }\0A}\0A\00", align 1
