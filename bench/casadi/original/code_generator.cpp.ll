@.str.31 = private unnamed_addr constant [2606 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22trilsolve\22\0Atemplate<typename T1>\0Avoid casadi_trilsolve(const casadi_int* sp_a, const T1* nz_a, T1* x, int tr, int unity,\0A    casadi_int nrhs) {\0A  // Local variables\0A  casadi_int nrow, ncol, r, c, k, rhs;\0A  const casadi_int *colind, *row;\0A  // Extract sparsity\0A  nrow = sp_a[0];\0A  ncol = sp_a[1];\0A  colind = sp_a + 2;\0A  row = colind + ncol + 1;\0A  // For all right hand sides\0A  for (rhs = 0; rhs < nrhs; ++rhs) {\0A    if (unity) {\0A      if (tr) {\0A        // Backward substitution\0A        for (c = ncol; c-- > 0; ) {\0A          for (k = colind[c + 1]; k-- > colind[c]; ) {\0A            x[c] += nz_a[k] * x[row[k]];\0A          }\0A        }\0A      } else {\0A        // Forward substitution\0A        for (c = 0; c < ncol; ++c) {\0A          for (k = colind[c]; k < colind[c+1]; ++k) {\0A            x[row[k]] += nz_a[k] * x[c];\0A          }\0A        }\0A      }\0A    } else {\0A      if (tr) {\0A        // Backward substitution\0A        for (c = ncol; c-- > 0; ) {\0A          for (k = colind[c + 1]; k-- > colind[c]; ) {\0A            r = row[k];\0A            if (r == c) {\0A              x[c] /= nz_a[k];\0A            } else {\0A              x[c] -= nz_a[k] * x[r];\0A            }\0A          }\0A        }\0A      } else {\0A        // Forward substitution\0A        for (c = 0; c < ncol; ++c) {\0A          for (k = colind[c]; k < colind[c+1]; ++k) {\0A            r = row[k];\0A            if (r == c) {\0A              x[r] /= nz_a[k];\0A            } else {\0A              x[r] -= nz_a[k] * x[c];\0A            }\0A          }\0A        }\0A      }\0A    }\0A    // Next right-hand-side\0A    x += nrow;\0A  }\0A}\0A\00", align 1
