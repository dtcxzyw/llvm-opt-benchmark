@.str.71 = private unnamed_addr constant [2101 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22to_mex\22\0Atemplate<typename T1>\0AmxArray* casadi_to_mex(const casadi_int* sp, const T1* x) {\0A  casadi_int nrow, ncol, c, k;\0A#ifndef CASADI_MEX_NO_SPARSE\0A  casadi_int nnz;\0A#endif\0A  const casadi_int *colind, *row;\0A  mxArray *p;\0A  double *d;\0A#ifndef CASADI_MEX_NO_SPARSE\0A  casadi_int i;\0A  mwIndex *j;\0A#endif /* CASADI_MEX_NO_SPARSE */\0A  nrow = *sp++;\0A  ncol = *sp++;\0A  colind = sp;\0A  row = sp+ncol+1;\0A#ifndef CASADI_MEX_NO_SPARSE\0A  nnz = sp[ncol];\0A  if (nnz!=nrow*ncol) {\0A    p = mxCreateSparse(nrow, ncol, nnz, mxREAL);\0A    for (i=0, j=mxGetJc(p); i<=ncol; ++i) *j++ = *colind++;\0A    for (i=0, j=mxGetIr(p); i<nnz; ++i) *j++ = *row++;\0A    if (x) {\0A      d = (double*)mxGetData(p);\0A      for (i=0; i<nnz; ++i) *d++ = casadi_to_double(*x++);\0A    }\0A    return p;\0A  }\0A#endif /* CASADI_MEX_NO_SPARSE */\0A  p = mxCreateDoubleMatrix(nrow, ncol, mxREAL);\0A  if (x) {\0A    d = (double*)mxGetData(p);\0A    for (c=0; c<ncol; ++c) {\0A      for (k=colind[c]; k<colind[c+1]; ++k) {\0A        d[row[k]+c*nrow] = casadi_to_double(*x++);\0A      }\0A    }\0A  }\0A  return p;\0A}\0A\00", align 1
