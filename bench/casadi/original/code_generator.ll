@.str.20 = private unnamed_addr constant [1905 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22kron\22\0Atemplate<typename T1>\0Avoid casadi_kron(const T1* a, const casadi_int* sp_a, const T1* b, const casadi_int* sp_b, T1* r) {\0A    casadi_int a_ncol, b_ncol, k;\0A    const casadi_int *a_colind, *b_colind;\0A    T1 a_v, b_v;\0A    k = 0;\0A    a_ncol = sp_a[1];\0A    a_colind = sp_a+2;\0A    b_ncol = sp_b[1];\0A    b_colind = sp_b+2;\0A    // Loop over the columns\0A    for (casadi_int a_cc=0; a_cc<a_ncol; ++a_cc) {\0A      // Loop over the columns\0A      for (casadi_int b_cc=0; b_cc<b_ncol; ++b_cc) {\0A        // Loop over existing nonzeros\0A        for (casadi_int a_el=a_colind[a_cc]; a_el<a_colind[a_cc+1]; ++a_el) {\0A          a_v = a[a_el];\0A          // Loop over existing nonzeros\0A          for (casadi_int b_el=b_colind[b_cc]; b_el<b_colind[b_cc+1]; ++b_el) {\0A            b_v = b[b_el];\0A            r[k++] = a_v*b_v;\0A          }\0A        }\0A      }\0A    }\0A}\0A\00", align 1
