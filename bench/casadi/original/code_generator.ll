P solution\0A  T1 *dx_feas;\0A  T1 *dlam_feas;\0A  // Feasibility iterate\0A  T1 *z_feas;\0A  T1 *gf_feas;\0A  T1 *lbdz_feas, *ubdz_feas;\0A  T1* z_tmp;\0A  T1 *tr_scale_vector;\0A  casadi_int *tr_mask;\0A  // Hessian approximation\0A  T1 *Bk;\0A  // Jacobian\0A  T1* Jk;\0A  // Anderson vectors\0A  T1* anderson_memory_step;\0A  T1* anderson_memory_iterate;\0A  T1* gamma;\0A  // Function value of feasibility iterate\0A  T1 f_feas;\0A  // merit_mem\0A  // T1* merit_mem;\0A  // temp_mem\0A  // T1* temp_mem;\0A  // temp_sol\0A  // T1* temp_sol;\0A};\0A// C-REPLACE \22casadi_feasiblesqpmethod_data<T1>\22 \22struct casadi_feasiblesqpmethod_data\22\0A// SYMBOL \22feasiblesqpmethod_work\22\0Atemplate<typename T1>\0Avoid casadi_feasiblesqpmethod_work(const casadi_feasiblesqpmethod_prob<T1>* p,\0A    casadi_int* sz_iw, casadi_int* sz_w, int sz_anderson_memory) {\0A  // Local variables\0A  casadi_int nnz_h, nnz_a, nx, ng;\0A  nnz_h = p->sp_h[2+p->sp_h[1]];\0A  nnz_a = p->sp_a[2+p->sp_a[1]];\0A  nx = p->nlp->nx;\0A  ng = p->nlp->ng;\0A  // Reset sz_w, sz_iw\0A  *sz_w = *sz_iw = 0;\0A  // if (p->max_iter_ls>0) *sz_w += nx + ng; // z_cand\0A  // Lagrange gradient in the next iterate\0A  *sz_w += nx; // gLag\0A  *sz_w += nx; // gLag_old\0A  // Gradient of the objective\0A  *sz_w += nx; // gf\0A  // Bounds of the QP\0A  *sz_w += nx + ng; // lbdz\0A  *sz_w += nx + ng; // ubdz\0A  // QP solution\0A  *sz_w += nx; // dx\0A  *sz_w += nx + ng; // dlam\0A  // Feasibility QP solution\0A  *sz_w += nx; // dx_feas\0A  *sz_w += nx + ng; // dlam_feas\0A  // Feasibility iterate\0A  *sz_w += nx + ng; // x_feas + g_feas\0A  *sz_w += nx; // gf_feas\0A  *sz_w += nx + ng; // lower bounds feasibile QP\0A  *sz_w += nx + ng; // upper bounds feasible QP\0A  *sz_w += nx+ng; // x tmp feasible QP\0A  *sz_w += nx; // tr_scale_vector\0A  *sz_iw += nx; // tr_mask\0A  // Hessian approximation\0A  *sz_w += nnz_h; // Bk\0A  // Jacobian\0A  *sz_w += nnz_a; // Jk\0A  // merit_mem\0A  // if (p->max_iter_ls>0) *sz_w += p->merit_memsize;\0A  if (sz_anderson_memory > 0) {\0A    // for step (dx)\0A    *sz_w += sz_anderson_memory*nx;\0A    // for x\0A    *sz_w += sz_anderson_memory*nx;\0A    // for gamma\0A    *sz_w += sz_anderson_memory;\0A  }\0A  // if (elastic_mode) {\0A  //   // Additional work for larger objective gradient\0A  //   *sz_w += 2*ng; // gf\0A  //   // Additional work for the larger bounds\0A  //   *sz_w += 2*ng; // lbdz\0A  //   *sz_w += 2*ng; // ubdz\0A  //   // Additional work for larger solution\0A  //   *sz_w += 2*ng; // dx\0A  //   *sz_w += 2*ng; // dlam\0A  //   // Additional work for larger jacobian\0A  //   *sz_w += 2*ng; // Jk\0A  //   // Additional work for temp memory\0A  //   *sz_w += ng;\0A  // }\0A  // if (so_corr) *sz_w += nx+nx+ng; // Temp memory for failing soc\0A}\0A// SYMBOL \22feasiblesqpmethod_init\22\0Atemplate<typename T1>\0Avoid casadi_feasiblesqpmethod_init(casadi_feasiblesqpmethod_data<T1>* d,\0A    casadi_int** iw, T1** w, int sz_anderson_memory) {\0A  // Local variables\0A  casadi_int nnz_h, nnz_a, nx, ng;\0A  const casadi_feasiblesqpmethod_prob<T1>* p = d->prob;\0A  // Get matrix number of nonzeros\0A  nnz_h = p->sp_h[2+p->sp_h[1]];\0A  nnz_a = p->sp_a[2+p->sp_a[1]];\0A  nx = p->nlp->nx;\0A  ng = p->nlp->ng;\0A  // if (p->max_iter_ls>0) {\0A  //   d->z_cand = *w; *w += nx + ng;\0A  // }\0A  // Lagrange gradient in the next iterate\0A  d->gLag = *w; *w += nx;\0A  d->gLag_old = *w; *w += nx;\0A  // Hessian approximation\0A  d->Bk = *w; *w += nnz_h;\0A  // merit_mem\0A  // if (p->max_iter_ls>0) {\0A  //   d->merit_mem = *w; *w += p->merit_memsize;\0A  // }\0A  // if (so_corr) {\0A  //   d->temp_sol = *w; *w += nx+nx+ng;\0A  // }\0A  // Gradient of the objective\0A  d->gf = *w; *w += nx;\0A  // Bounds of the QP\0A  d->lbdz = *w; *w += nx + ng;\0A  d->ubdz = *w; *w += nx + ng;\0A  // QP solution\0A  d->dx = *w; *w += nx;\0A  d->dlam = *w; *w += nx + ng;\0A  // Feasible QP solution\0A  d->dx_feas = *w; *w += nx;\0A  d->dlam_feas = *w; *w += nx + ng;\0A  // feasibility iterate\0A  d->z_feas = *w; *w += nx + ng;\0A  d->gf_feas = *w; *w += nx;\0A  // Bounds of the feasibility QPs\0A  d->lbdz_feas = *w; *w += nx + ng;\0A  d->ubdz_feas = *w; *w += nx + ng;\0A  // x tmp for QPs\0A  d->z_tmp = *w; *w += sz_anderson_memory*nx+ng;\0A  // trust-region scale vector\0A  d->tr_scale_vector = *w; *w += nx;\0A  d->tr_mask = *iw; *iw += nx;\0A  // Jacobian\0A  d->Jk = *w; *w += nnz_a;\0A  // Anderson vector\0A  d->anderson_memory_step = *w; *w += sz_anderson_memory*nx;\0A  d->anderson_memory_iterate = *w; *w += sz_anderson_memory*nx;\0A  d->gamma = *w; *w += sz_anderson_memory;\0A}\0A\00", align 1
