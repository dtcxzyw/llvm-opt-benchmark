 loc, next_ind, tmp_ind, j;\0A  T1 trial_lam, new_tau, next_tau, tmp_tau;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Dual feasibility is piecewise linear. Start with one interval [0,tau]:\0A  tau_list[0] = tau;\0A  ind_list[0] = -1; // no associated index\0A  n_tau = 1;\0A  // Find the taus corresponding to lam crossing zero and insert into list\0A  for (i=0; i<p->qp->nz; ++i) {\0A    if (d->dlam[i]==0.) continue; // Skip zero steps\0A    if (d->lam[i]==0.) continue; // Skip inactive constraints\0A    // Trial dual step\0A    trial_lam = d->lam[i] + tau*d->dlam[i];\0A    // Skip if no sign change\0A    if (d->lam[i]>0 ? trial_lam>=0 : trial_lam<=0) continue;\0A    // Location of the sign change\0A    new_tau = -d->lam[i]/d->dlam[i];\0A    // Where to insert the w[i]\0A    for (loc=0; loc<n_tau-1; ++loc) {\0A      if (new_tau<tau_list[loc]) break;\0A    }\0A    // Insert element\0A    n_tau++;\0A    next_tau=new_tau;\0A    next_ind=i;\0A    for (j=loc; j<n_tau; ++j) {\0A      tmp_tau = tau_list[j];\0A      tau_list[j] = next_tau;\0A      next_tau = tmp_tau;\0A      tmp_ind = ind_list[j];\0A      ind_list[j] = next_ind;\0A      next_ind = tmp_ind;\0A    }\0A  }\0A  return n_tau;\0A}\0A// SYMBOL \22qrqp_dual_blocking\22\0Atemplate<typename T1>\0Acasadi_int casadi_qrqp_dual_blocking(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i, n_tau, j, k, du_index;\0A  T1 tau_k, dtau, new_infeas, tau1, infeas, tinfeas;\0A  const casadi_int *at_colind, *at_row;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Extract sparsities\0A  at_row = (at_colind = p->sp_at+2) + p->qp->na + 1;\0A  // Dual feasibility is piecewise linear in tau. Get the intervals:\0A  n_tau = casadi_qrqp_dual_breakpoints(d, d->w, d->iw, d->tau);\0A  // No dual blocking yet\0A  du_index = -1;\0A  // How long step can we take without exceeding e?\0A  tau_k = 0.;\0A  for (j=0; j<n_tau; ++j) {\0A    // Distance to the next tau (may be zero)\0A    dtau = d->w[j] - tau_k;\0A    // Check 