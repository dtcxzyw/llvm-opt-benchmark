tinue;\0A        // Enforced or not?\0A        if (d->lam[i]==0.) {\0A          if (d->z[i] <= d->ubz[i] && (d->z[i] >= d->lbz[i] ?\0A              d->dz[i] < -1e-12 : d->dz[i] > 1e-12)) {\0A            // Enforce lower bound?\0A            if (!d->neverlower[i]\0A                && (tau_test = (d->lbz[i] - d->z[i]) / d->dz[i]) < tau\0A                && casadi_qrqp_enforceable(d, i, -1)) {\0A              tau = tau_test;\0A              d->r_index = i;\0A              d->r_sign = -1;\0A              best_k = k;\0A              best_neg = neg;\0A            }\0A          } else if (d->z[i] >= d->lbz[i] && (d->z[i] <= d->ubz[i] ?\0A              d->dz[i] > 1e-12 : d->dz[i] < -1e-12)) {\0A            // Enforce upper bound?\0A            if (!d->neverupper[i]\0A                && (tau_test = (d->ubz[i] - d->z[i]) / d->dz[i]) < tau\0A                && casadi_qrqp_enforceable(d, i, 1)) {\0A              tau = tau_test;\0A              d->r_index = i;\0A              d->r_sign = 1;\0A              best_k = k;\0A              best_neg = neg;\0A            }\0A          }\0A        } else if (!d->neverzero[i]) {\0A          // Drop a constraint?\0A          if (d->lam[i] > 0 ? d->dlam[i] < -1e-12 : d->dlam[i] > 1e-12) {\0A            if ((tau_test = -d->lam[i] / d->dlam[i]) < tau) {\0A              tau = tau_test;\0A              d->r_index = i;\0A              d->r_sign = 0;\0A              best_k = k;\0A              best_neg = neg;\0A            }\0A          }\0A        }\0A      }\0A    }\0A  }\0A  // Can we restore feasibility?\0A  if (d->r_index < 0) return 1;\0A  // Recalculate direction, if needed\0A  if (--k != best_k) {\0A    // Need to recalculate direction\0A    casadi_qr_colcomb(d->dz, d->nz_r, p->sp_r, p->pc, 1e-12, best_k);\0A    casadi_qrqp_expand_step(d);\0A    if (best_neg) tau *= -1;\0A  } else if (--neg != best_neg) {\0A    // No need to recalculate, but opposite direction\0A    tau *= -1;\0A  }\0A  // Scale step so that that tau=1 corresponds to a full step\0A  casadi_scal(p->qp->nz, tau, d->dz);\0A  casadi_scal(p->qp->nz, tau, d->dlam);\0A  casadi_scal(p->qp->nx, tau, d->tinfeas);\0A  return 0;\0A}\0A// SYMBOL \22qrqp_calc_step\22\0Atemplate<typename T1>\0Aint casadi_qrqp_calc_step(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Reset returns\0A  d->r_index = -1;\0A  d->r_sign = 0;\0A  // Handle singularity\0A  if (d->sing) return casadi_qrqp_singular_step(d);\0A  // Negative KKT residual\0A  casadi_qrqp_kkt_residual(d, d->dz);\0A  // Solve to get step in z[:nx] and lam[nx:]\0A  casadi_qr_solve(d->dz, 1, 1, p->sp_v, d->nz_v, p->sp_r, d->nz_r, d->beta,\0A                  p->prinv, p->pc, d->w);\0A  // Have step in dz[:nx] and dlam[nx:]. Calculate complete dz and dlam\0A  casadi_qrqp_expand_step(d);\0A  // Successful return\0A  return 0;\0A}\0A// SYMBOL \22qrqp_calc_sens\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_calc_sens(casadi_qrqp_data<T1>* d, casadi_int i) {\0A  // Local variables\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Calculate sensitivities in decreasing dual infeasibility index i\0A  casadi_clear(d->sens, p->qp->nz);\0A  if (i >= 0) {\0A    d->sens[i] = d->infeas[i] > 0 ? -1. : 1.;\0A    casadi_mv(d->qp->a, p->qp->sp_a, d->sens, d->sens + p->qp->nx, 0);\0A  }\0A}\0A// SYMBOL \22qrqp_calc_dependent\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_calc_dependent(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i;\0A  T1 r;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Calculate f\0A  d->f = casadi_bilin(d->qp->h, p->qp->sp_h, d->z, d->z)/2.\0A       + casadi_dot(p->qp->nx, d->z, d->qp->g);\0A  // Calculate z[nx:]\0A  casadi_clear(d->z+p->qp->nx, p->qp->na);\0A  casadi_mv(d->qp->a, p->qp->sp_a, d->z, d->z+p->qp->nx, 0);\0A  // Calculate gradient of the Lagrangian\0A  casadi_copy(d->qp->g, p->qp->nx, d->infeas);\0A  casadi_mv(d->qp->h, p->qp->sp_h, d->z, d->infeas, 0);\0A  casadi_mv(d->qp->a, p->qp->sp_a, d->lam+p->qp->nx, d->infeas, 1);\0A  // Calculate lam[:nx] without changing the sign accidentally, dual infeasibility\0A  for (i=0; i<p->qp->nx; ++i) {\0A    // No change if zero\0A    if (d->lam[i]==0) continue;\0A    // lam[i] with no sign restrictions\0A    r = -d->infeas[i];\0A    if (d->lam[i]>0) {\0A      if (d->neverzero[i] && !d->neverlower[i]) {\0A        d->lam[i] = r==0 ? p->dmin : r; // keep sign if r==0\0A      } else {\0A        d->lam[i] = fmax(r, p->dmin); // no sign change\0A      }\0A    } else {\0A      if (d->neverzero[i] && !d->neverupper[i]) {\0A        d->lam[i] = r==0 ? -p->dmin : r; // keep sign if r==0\0A      } else {\0A        d->lam[i] = fmin(r, -p->dmin); // no sign change\0A      }\0A    }\0A    // Update dual infeasibility\0A    d->infeas[i] += d->lam[i];\0A  }\0A  // Calculate primal and dual error\0A  casadi_qrqp_pr(d);\0A  casadi_qrqp_du(d);\0A  // Acceptable primal and dual error\0A  d->epr = fmax(d->pr, (0.5 * p->constr_viol_tol / p->dual_inf_tol) * d->du);\0A  d->edu = fmax(d->du, (0.5 * p->dual_inf_tol / p->constr_viol_tol) * d->pr);\0A  // Sensitivity in decreasing |du|\0A  casadi_qrqp_calc_sens(d, d->idu);\0A}\0A// SYMBOL \22qrqp_linesearch\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_linesearch(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int du_index;\0A  // Start with a full step and no active set change\0A  d->sign = 0;\0A  d->index = -1;\0A  d->tau = 1.;\0A  // Find largest possible step without exceeding acceptable |pr|\0A  casadi_qrqp_primal_blocking(d);\0A  // Find largest possible step without exceeding acceptable |du|\0A  du_index = casadi_qrqp_dual_blocking(d);\0A  // Take primal-dual step, avoiding accidental sign changes for lam\0A  casadi_qrqp_take_step(d);\0A  // Handle dual blocking constraints\0A  if (du_index >= 0) {\0A    // Sensititivity in decreasing du_index\0A    casadi_qrqp_calc_sens(d, du_index);\0A    // Find corresponding index\0A    casadi_qrqp_du_index(d);\0A  }\0A}\0A// SYMBOL \22qrqp_flip\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_flip(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Try to restore regularity if possible\0A  if (d->index == -1 && d->r_index >= 0) {\0A    if (d->r_sign != 0 || casadi_qrqp_du_check(d, d->r_index)) {\0A      d->index = d->r_index;\0A      d->sign = d->r_sign;\0A      if (d->sign > 0) {\0A        d->msg = \22Enforced ubz for regularity\22;\0A      } else if (d->sign < 0) {\0A        d->msg = \22Enforced lbz for regularity\22;\0A      } else if (d->lam[d->index] > 0) {\0A        d->msg = \22Dropped ubz for regularity\22;\0A      } else {\0A        d->msg = \22Dropped lbz for regularity\22;\0A      }\0A      d->msg_ind = d->index;\0A    }\0A  }\0A  // If nonsingular and nonzero error, try to flip a constraint\0A  if (!d->sing && d->index == -1) {\0A    if (d->pr * p->dual_inf_tol >= p->constr_viol_tol * d->du) {\0A      // Improve primal feasibility if dominating\0A      if (d->pr >= p->constr_viol_tol) casadi_qrqp_pr_index(d);\0A    } else {\0A      // Improve dual feasibility if dominating\0A      if (d->du >= p->dual_inf_tol) casadi_qrqp_du_index(d);\0A    }\0A  }\0A  // No search direction given by default\0A  d->has_search_dir = 0;\0A  // If a constraint was added\0A  if (d->index >= 0) {\0A    // Detect singularity before it happens and get nullspace vectors\0A    if (!d->sing) d->has_search_dir = casadi_qrqp_flip_check(d);\0A    // Perform the active-set change\0A    d->lam[d->index] = d->sign==0 ? 0 : d->sign > 0 ? p->dmin : -p->dmin;\0A    // Recalculate primal and dual infeasibility\0A    casadi_qrqp_calc_dependent(d);\0A  }\0A}\0A// SYMBOL \22qrqp_prepare\22\0Atemplate<typename T1>\0Aint casadi_qrqp_prepare(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Calculate dependent quantities\0A  casadi_qrqp_calc_dependent(d);\0A  // Make an active set change\0A  casadi_qrqp_flip(d);\0A  // Form and factorize the KKT system\0A  casadi_qrqp_factorize(d);\0A  // Termination message\0A  if (!d->sing && d->index == -1) {\0A    d->status = QP_SUCCESS;\0A    d->msg = \22Converged\22;\0A    d->msg_ind = -2;\0A    return 1;\0A  } else if (d->iter >= p->max_iter) {\0A    d->status = QP_MAX_ITER;\0A    d->msg = \22Max iter\22;\0A    d->msg_ind = -2;\0A    return 1;\0A  } else if (!d->sing && d->ipr < 0 && d->idu < 0) {\0A    d->status = QP_SUCCESS;\0A    d->msg = \22No primal or dual error\22;\0A    d->msg_ind = -2;\0A    return 1;\0A  } else {\0A    // Keep iterating\0A    return 0;\0A  }\0A}\0A// SYMBOL \22qrqp_iterate\22\0Atemplate<typename T1>\0Aint casadi_qrqp_iterate(casadi_qrqp_data<T1>* d) {\0A  // Reset message flag\0A  d->msg = 0;\0A  // Start a new iteration\0A  d->iter++;\0A  // Calculate search direction\0A  if (casadi_qrqp_calc_step(d)) {\0A    d->status = QP_NO_SEARCH_DIR;\0A    return 1;\0A  }\0A  // Line search in the calculated direction\0A  casadi_qrqp_linesearch(d);\0A  // Keep iterating\0A  return 0;\0A}\0A// SYMBOL \22qrqp_print_header\22\0Atemplate<typename T1>\0Aint casadi_qrqp_print_header(casadi_qrqp_data<T1>* d, char* buf, size_t buf_sz) {\0A#ifdef CASADI_SNPRINTF\0A  int flag;\0A  // Print to string\0A  flag = CASADI_SNPRINTF(buf, buf_sz, \22%5s %5s %9s %9s %5s %9s %5s %9s %5s %9s  %4s\22,\0A          \22Iter\22, \22Sing\22, \22fk\22, \22|pr|\22, \22con\22, \22|du|\22, \22var\22,\0A          \22min_R\22, \22con\22, \22last_tau\22, \22Note\22);\0A  // Check if error\0A  if (flag < 0) {\0A    d->status = QP_PRINTING_ERROR;\0A    return 1;\0A  }\0A#else\0A  if (buf_sz) buf[0] = '\\0';\0A#endif\0A  // Successful return\0A  return 0;\0A}\0A// SYMBOL \22qrqp_print_colcomb\22\0Atemplate<typename T1>\0Aint casadi_qrqp_print_colcomb(casadi_qrqp_data<T1>* d, char* buf, size_t buf_sz, casadi_int j) {\0A#ifdef CASADI_SNPRINTF\0A  casadi_int num_size, n_print, i, k, buf_offset, val;\0A  size_t b;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  casadi_qr_colcomb(d->dlam, d->nz_r, p->sp_r, p->pc, 1e-12, j);\0A  // Determine max printing size\0A  num_size = 1;\0A  val = p->qp->nz-1;\0A  while (val) {\0A    val/=10;\0A    num_size++;\0A  }\0A  if (buf_sz<=4) return 1;\0A  // How many numbers can be printed?\0A  // Need some extra space for '...'\0A  // and null\0A  n_print = (buf_sz-4)/num_size;\0A  // Clear buffer\0A  for (b=0;b<buf_sz;++b) buf[b]=' ';\0A  buf_offset = 0;\0A  for (i=0;i<p->qp->nz;++i) {\0A    if (fabs(d->dlam[i]) >= 1e-12) {\0A      if (n_print==0) {\0A        buf[buf_sz-4] = '.';\0A        buf[buf_sz-3] = '.';\0A        buf[buf_sz-2] = '.';\0A        buf[buf_sz-1] = '\\0';\0A        return 1;\0A      }\0A      n_print--;\0A      CASADI_SNPRINTF(buf+buf_offset, num_size, \22%d\22, static_cast<int>(i));\0A      // Clear null chars\0A      for (k=0;k<num_size;++k) {\0A        if (buf[buf_offset+k]=='\\0') buf[buf_offset+k] = ' ';\0A      }\0A      buf_offset += num_size;\0A    }\0A  }\0A  buf[buf_sz-1] = '\\0';\0A#else\0A  if (buf_sz) buf[0] = '\\0';\0A#endif\0A  // Successful return\0A  return 0;\0A}\0A// SYMBOL \22qrqp_print_iteration\22\0Atemplate<typename T1>\0Aint casadi_qrqp_print_iteration(casadi_qrqp_data<T1>* d, char* buf, int buf_sz) {\0A#ifdef CASADI_SNPRINTF\0A  int flag;\0A  // Print iteration data without note to string\0A  flag = CASADI_SNPRINTF(buf, buf_sz,\0A    \22%5d %5d %9.2g %9.2g %5d %9.2g %5d %9.2g %5d %9.2g  \22,\0A    static_cast<int>(d->iter), static_cast<int>(d->sing), d->f, d->pr,\0A    static_cast<int>(d->ipr), d->du, static_cast<int>(d->idu),\0A    d->mina, static_cast<int>(d->imina), d->tau);\0A  // Check if error\0A  if (flag < 0) {\0A    d->status = QP_PRINTING_ERROR;\0A    return 1;\0A  }\0A  // Rest of buffer reserved for iteration note\0A  buf += flag;\0A  buf_sz -= flag;\0A  // Print iteration note, if any\0A  if (d->msg) {\0A    if (d->msg_ind > -2) {\0A      flag = CASADI_SNPRINTF(buf, buf_sz, \22%s, i=%d\22, d->msg, static_cast<int>(d->msg_ind));\0A    } else {\0A      flag = CASADI_SNPRINTF(buf, buf_sz, \22%s\22, d->msg);\0A    }\0A    // Check if error\0A    if (flag < 0) {\0A      d->status = QP_PRINTING_ERROR;\0A      return 1;\0A    }\0A  }\0A#else\0A  if (buf_sz) buf[0] = '\\0';\0A#endif\0A  // Successful return\0A  return 0;\0A}\0A\00", align 1
