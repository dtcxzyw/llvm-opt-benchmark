eturn;\0A  }\0A  // Construct the KKT matrix\0A  casadi_qrqp_kkt(d);\0A  // QR factorization\0A  casadi_qr(p->sp_kkt, d->nz_kkt, d->w, p->sp_v, d->nz_v, p->sp_r,\0A            d->nz_r, d->beta, p->prinv, p->pc);\0A  // Check singularity\0A  d->sing = casadi_qr_singular(&d->mina, &d->imina, d->nz_r, p->sp_r, p->pc, 1e-12);\0A}\0A// SYMBOL \22qrqp_expand_step\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_expand_step(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Calculate change in Lagrangian gradient\0A  casadi_clear(d->dlam, p->qp->nx);\0A  casadi_mv(d->qp->h, p->qp->sp_h, d->dz, d->dlam, 0); // gradient of the objective\0A  casadi_mv(d->qp->a, p->qp->sp_a, d->dz + p->qp->nx, d->dlam, 1); // gradient of the Lagrangian\0A  // Step in lam[:nx]\0A  casadi_scal(p->qp->nx, -1., d->dlam);\0A  // For inactive constraints, lam(x) step is zero\0A  for (i = 0; i < p->qp->nx; ++i) if (d->lam[i] == 0.) d->dlam[i] = 0.;\0A  // Step in lam[nx:]\0A  casadi_copy(d->dz+p->qp->nx, p->qp->na, d->dlam + p->qp->nx);\0A  // Step in z[nx:]\0A  casadi_clear(d->dz + p->qp->nx, p->qp->na);\0A  casadi_mv(d->qp->a, p->qp->sp_a, d->dz, d->dz + p->qp->nx, 0);\0A  // Avoid steps that are nonzero due to numerics\0A  for (i = 0; i < p->qp->nz; ++i) if (fabs(d->dz[i]) < 1e-14) d->dz[i] = 0.;\0A  // Tangent of the dual infeasibility at tau=0\0A  casadi_clear(d->tinfeas, p->qp->nx);\0A  casadi_mv(d->qp->h, p->qp->sp_h, d->dz, d->tinfeas, 0);\0A  casadi_mv(d->qp->a, p->qp->sp_a, d->dlam + p->qp->nx, d->tinfeas, 1);\0A  casadi_axpy(p->qp->nx, 1., d->dlam, d->tinfeas);\0A}\0A// SYMBOL \22casadi_qrqp_pr_direction\22\0Atemplate<typename T1>\0Aint casadi_qrqp_pr_direction(casadi_qrqp_data<T1>* d) {\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  for (i=0; i<p->qp->nz; ++i) {\0A    if (d->lbz[i] - d->z[i] >= d->epr) {\0A      // Prevent further violation of lower bound\0A      if (d->dz[i] < 0 || d->dlam[i] > 0) retur