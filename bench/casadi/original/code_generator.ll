t buffers\0A  for (i = 0; i < N_X; ++i) m->x[i] = m->v[x_vr[i]];\0A  for (i = 0; i < N_P; ++i) m->p[i] = m->v[p_vr[i]];\0A  for (i = 0; i < N_U; ++i) m->u[i] = m->v[u_vr[i]];\0A  // Map inputs to evaluation buffer\0A  i = 0;\0A  m->arg[i++] = &m->t;\0A  m->arg[i++] = m->x;\0A  m->arg[i++] = m->p;\0A  m->arg[i++] = m->u;\0A  // Map outputs to evaluation buffer\0A  i = 0;\0A  m->res[i++] = m->xdot;\0A  m->res[i++] = m->y;\0A  // Evaluate\0A  mem = MODELNAME_checkout();\0A  flag = MODELNAME(m->arg, m->res, m->iw, m->w, mem);\0A  MODELNAME_release(mem);\0A  // Copy from output buffers\0A  for (i = 0; i < N_X; ++i) m->v[xdot_vr[i]] = m->xdot[i];\0A  for (i = 0; i < N_Y; ++i) m->v[y_vr[i]] = m->y[i];\0A  return flag;\0A}\0Aint evaluate_forward(casadi_fmi_memory* m) {\0A  // Local variables\0A  size_t i;\0A  int mem, flag;\0A  // Copy seeds for states, inputs and parameters to input buffers\0A  for (i = 0; i < N_X; ++i) m->dx[i] = m->d[x_vr[i]];\0A  for (i = 0; i < N_P; ++i) m->dp[i] = m->d[p_vr[i]];\0A  for (i = 0; i < N_U; ++i) m->du[i] = m->d[u_vr[i]];\0A  // Map nondifferentiated inputs to evaluation buffer\0A  i = 0;\0A  m->arg[i++] = 0;  // t\0A  m->arg[i++] = m->x;\0A  m->arg[i++] = m->p;\0A  m->arg[i++] = m->u;\0A  // Map nondifferentiated outputs to evaluation buffer\0A  m->arg[i++] = m->xdot;\0A  m->arg[i++] = m->y;\0A  // Map forward seeds\0A  m->arg[i++] = 0;\0A  m->arg[i++] = m->dx;\0A  m->arg[i++] = m->dp;\0A  m->arg[i++] = m->du;\0A  // Map forward sensitivities\0A  i = 0;\0A  m->res[i++] = m->dxdot;\0A  m->res[i++] = m->dy;\0A  // Evaluate\0A  mem = fwd1_MODELNAME_checkout();\0A  flag = fwd1_MODELNAME(m->arg, m->res, m->iw, m->w, mem);\0A  fwd1_MODELNAME_release(mem);\0A  // Copy from output buffers\0A  for (i = 0; i < N_X; ++i) m->d[xdot_vr[i]] = m->dxdot[i];\0A  for (i = 0; i < N_Y; ++i) m->d[y_vr[i]] = m->dy[i];\0A  // Return evaluation flag\0A  return flag;\0A}\0Aint evaluate_adjoint(casadi_fmi_memory* m) {\0A  // Local variables\0A  size_t i;\0A  int mem, flag;\0A  // Copy seeds for output buffers\0A  for (i = 0; i < N_X; ++i) m->dxdot[i] = m->d[xdot_vr[i]];\0A  for (i = 0; i < N_Y; ++i) m->dy[i] = m->d[y_vr[i]];\0A  // Clear sensitivities\0A  for (i = 0; i < N_X; ++i) m->dx[i] = 0;\0A  for (i = 0; i < N_P; ++i) m->dp[i] = 0;\0A  for (i = 0; i < N_U; ++i) m->du[i] = 0;\0A  // Map nondifferentiated inputs to evaluation buffer\0A  i = 0;\0A  m->arg[i++] = 0;  // t\0A  m->arg[i++] = m->x;\0A  m->arg[i++] = m->p;\0A  m->arg[i++] = m->u;\0A  // Map nondifferentiated outputs to evaluation buffer\0A  m->arg[i++] = m->xdot;\0A  m->arg[i++] = m->y;\0A  // Map adjoint seeds\0A  m->arg[i++] = m->dxdot;\0A  m->arg[i++] = m->dy;\0A  // Map adjoint sensitivities\0A  i = 0;\0A  m->res[i++] = 0;  // t\0A  m->res[i++] = m->dx;\0A  m->res[i++] = m->dp;\0A  m->res[i++] = m->du;\0A  // Evaluate\0A  mem = adj1_MODELNAME_checkout();\0A  flag = adj1_MODELNAME(m->arg, m->res, m->iw, m->w, mem);\0A  adj1_MODELNAME_release(mem);\0A  // Copy from input buffers\0A  for (i = 0; i < N_X; ++i) m->d[x_vr[i]] = m->dx[i];\0A  for (i = 0; i < N_P; ++i) m->d[p_vr[i]] = m->dp[i];\0A  for (i = 0; i < N_U; ++i) m->d[u_vr[i]] = m->du[i];\0A  // Return evaluation flag\0A  return flag;\0A}\0AFMI3_Export fmi3Status fmi3Reset(fmi3Instance instance) {\0A  // Local variables\0A  size_t i;\0A  casadi_fmi_memory* m;\0A  // Cast to memory struct\0A  m = (casadi_fmi_memory*)instance;\0A  // Initialize variables\0A  for (i = 0; i < SZ_MEM; ++i) m->v[i] = start[i];\0A  // Reset derivative buffer\0A  for (i = 0; i < SZ_MEM; ++i) m->d[i] = 0;\0A  // Not evaluated\0A  m->up_to_date = 0;\0A  // Always successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Instance fmi3InstantiateModelExchange(\0A    fmi3String instanceName,\0A    fmi3String instantiationToken,\0A    fmi3String resourcePath,\0A    fmi3Boolean visible,\0A    fmi3Boolean loggingOn,\0A    fmi3InstanceEnvironment instanceEnvironment,\0A    fmi3LogMessageCallback logMessage) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  // Unused variables\0A  (void)resourcePath;  // unused\0A  (void)visible;  // unused\0A  (void)loggingOn;  // unused\0A  (void)instanceEnvironment;  // unused\0A  (void)logMessage;  // unused\0A  // Allocate memory structure\0A  m = (casadi_fmi_memory*)malloc(sizeof(casadi_fmi_memory));\0A  // If allocation was successful\0A  if (m) {\0A    // Increase counter for codegen\0A    MODELNAME_incref();\0A    // Copy meta data\0A    m->instance_name = instanceName;\0A    // Call reset function (return flag does not need to be checked)\0A    (void)fmi3Reset(m);\0A  }\0A  // Return pointer to instance, or null\0A  return m;\0A}\0AFMI3_Export fmi3Instance fmi3InstantiateCoSimulation(fmi3String instanceName,\0A    fmi3String instantiationToken,\0A    fmi3String resourcePath,\0A    fmi3Boolean visible,\0A    fmi3Boolean loggingOn,\0A    fmi3Boolean eventModeUsed,\0A    fmi3Boolean earlyReturnAllowed,\0A    const fmi3ValueReference requiredIntermediateVariables[],\0A    size_t nRequiredIntermediateVariables,\0A    fmi3InstanceEnvironment instanceEnvironment,\0A    fmi3LogMessageCallback logMessage,\0A    fmi3IntermediateUpdateCallback intermediateUpdate) {\0A  // Not implemented\0A  return 0;\0A}\0AFMI3_Export fmi3Instance fmi3InstantiateScheduledExecution(fmi3String instanceName,\0A    fmi3String instantiationToken,\0A    fmi3String resourcePath,\0A    fmi3Boolean visible,\0A    fmi3Boolean loggingOn,\0A    fmi3InstanceEnvironment instanceEnvironment,\0A    fmi3LogMessageCallback logMessage,\0A    fmi3ClockUpdateCallback clockUpdate,\0A    fmi3LockPreemptionCallback lockPreemption,\0A    fmi3UnlockPreemptionCallback unlockPreemption) {\0A  // Not implemented\0A  return 0;\0A}\0AFMI3_Export fmi3Status fmi3GetNumberOfVariableDependencies(fmi3Instance instance,\0A    fmi3ValueReference valueReference,\0A    size_t* nDependencies) {\0A  // Not implemented\0A  return fmi3Fatal;\0A}\0AFMI3_Export fmi3Status fmi3GetVariableDependencies(fmi3Instance instance