@.str.63 = private unnamed_addr constant [2217 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22newton_mem\22\0Atemplate<typename T1>\0Astruct casadi_newton_mem {\0A  casadi_int n;\0A  T1 abstol;\0A  T1 abstol_step;\0A  T1* x;\0A  T1* g;\0A  T1* jac_g_x;\0A  const casadi_int* sp_a;\0A  const casadi_int* sp_v;\0A  const casadi_int* sp_r;\0A  const casadi_int* prinv;\0A  const casadi_int* pc;\0A  T1* lin_w;\0A  T1* lin_v;\0A  T1* lin_r;\0A  T1* lin_beta;\0A};\0A// C-REPLACE \22casadi_newton_mem<T1>\22 \22struct casadi_newton_mem\22\0A// SYMBOL \22newton\22\0Atemplate<typename T1>\0Aint casadi_newton(const casadi_newton_mem<T1>* m) {\0A    // Check tolerance on residual\0A    if (m->abstol>0 && casadi_norm_inf(m->n, m->g) <= m->abstol) return 1;\0A    // Factorize J\0A    casadi_qr(m->sp_a, m->jac_g_x, m->lin_w,\0A              m->sp_v,  m->lin_v, m->sp_r, m->lin_r, m->lin_beta,\0A              m->prinv, m->pc);\0A    // Solve J^(-1) g\0A    casadi_qr_solve(m->g, 1, 0, m->sp_v, m->lin_v, m->sp_r, m->lin_r, m->lin_beta,\0A                    m->prinv, m->pc, m->lin_w);\0A    // Update Xk+1 = Xk - J^(-1) g\0A    casadi_axpy(m->n, -1., m->g, m->x);\0A    // Check tolerance on step\0A    if (m->abstol_step>0 && casadi_norm_inf(m->n, m->g) <= m->abstol_step) return 2;\0A    // We will need another newton step\0A    return 0;\0A}\0A\00", align 1
