o_date = 0;\0A  // Position in values vector\0A  val_ind = 0;\0A  // Loop over provided variables\0A  for (i = 0; i < nValueReferences; ++i) {\0A    // Get variable\0A    vr = valueReferences[i];\0A    // Get offset, size of variable\0A    var_off = var_offset[vr];\0A    var_sz = var_offset[vr + 1] - var_off;\0A    // Copy elements\0A    for (j = 0; j < var_sz; ++j) m->v[var_off + j] = values[val_ind++];\0A  }\0A  // Consistency check\0A  if (val_ind != nValues) return fmi3Fatal;\0A  // Successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Status fmi3GetFloat64(\0A    fmi3Instance instance,\0A    const fmi3ValueReference valueReferences[],\0A    size_t nValueReferences,\0A    fmi3Float64 values[],\0A    size_t nValues) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  size_t i, j, var_off, var_sz, val_ind;\0A  fmi3ValueReference vr;\0A  // Cast to memory struct\0A  m = (casadi_fmi_memory*)instance;\0A  // Evaluate, if necessary\0A  if (!m->up_to_date) {\0A    // Evaluate state derivatives and outputs\0A    if (evaluate(m)) return fmi3Error;\0A    // Now evaluated\0A    m->up_to_date = 1;\0A  }\0A  // Position in values vector\0A  val_ind = 0;\0A  // Loop over provided variables\0A  for (i = 0; i < nValueReferences; ++i) {\0A    // Get variable\0A    vr = valueReferences[i];\0A    // Get offset, size of variable\0A    var_off = var_offset[vr];\0A    var_sz = var_offset[vr + 1] - var_off;\0A    // Copy elements\0A    for (j = 0; j < var_sz; ++j) values[val_ind++] = m->v[var_off + j];\0A  }\0A  // Consistency check\0A  if (val_ind != nValues) return fmi3Fatal;\0A  // Successful return\0A  return fmi3OK;  \0A}\0AFMI3_Export fmi3Status fmi3EnterInitializationMode(\0A    fmi3Instance instance,\0A    fmi3Boolean toleranceDefined,\0A    fmi3Float64 tolerance,\0A    fmi3Float64 startTime,\0A    fmi3Boolean stopTimeDefined,\0A    fmi3Float64 stopTime) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  // Unused variables\0A  (void)toleranceDefined;  // unused\0A  (void)tolerance;  // unused\0A  (void)stopTimeDefined;  // unused\0A  (void)stopTime;  // unused\0A  // Cast to memory struct\0A  m = (casadi_fmi_memory*)instance;\0A  // Initialize time\0A  m->t = startTime;\0A  // Always successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Status fmi3ExitInitializationMode(fmi3Instance instance) {\0A  // Unused variables\0A  (void)instance;  // unused\0A  // Always successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Status fmi3EnterContinuousTimeMode(fmi3Instance instance) {\0A  // Unused variables\0A  (void)instance;  // unused\0A  // Always successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Status fmi3SetTime(fmi3Instance instance, fmi3Float64 time) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  // Cast to memory struct\0A  m = (casadi_fmi_memory*)instance;\0A  // Initialize time\0A  m->t = time;\0A  // Always successful return\0A  return fmi3OK;\0A}\0AFMI3_Export fmi3Status fmi3SetContinuousStates(\0A    fmi3Instance instance,\0A    const fmi3Float64 continuousStates[],\0A    size_t nContinuousStates) {\0A  return fmi3SetFloat64(instance, x_vr, N_X, continuousStates, nContinuousStates);\0A}\0AFMI3_Export fmi3Status fmi3GetContinuousStates(\0A    fmi3Instance instance,\0A    fmi3Float64 continuousStates[],\0A    size_t nContinuousStates) {\0A  return fmi3GetFloat64(instance, x_vr, N_X, continuousStates, nContinuousStates);\0A}\0Afmi3Status fmi3GetDirectionalDerivative(\0A    fmi3Instance instance,\0A    const fmi3ValueReference unknowns[],\0A    size_t nUnknowns,\0A    const fmi3ValueReference knowns[],\0A    size_t nKnowns,\0A    const fmi3Float64 seed[],\0A    size_t nSeed,\0A    fmi3Float64 sensitivity[],\0A    size_t nSensitivity) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  size_t i, j, var_off, var_sz, val_ind;\0A  fmi3ValueReference vr;\0A  int flag;\0A  // Cast to memory struct\0A  m = (casadi_fmi_memory*)instance;\0A  // Evaluate, if necessary\0A  if (!m->up_to_date) {\0A    // Evaluate state derivatives and outputs\0A    if (evaluate(m)) return fmi3Error;\0A    // Now evaluated\0A    m->up_to_date = 1;\0A  }\0A  // Pass derivative seeds\0A  val_ind = 0;\0A  for (i = 0; i < nKnowns; ++i) {\0A    // Get variable\0A    vr = knowns[i];\0A    // Get offset, size of variable\0A    var_off = var_offset[vr];\0A    var_sz = var_offset[vr + 1] - var_off;\0A    // Copy elements\0A    for (j = 0; j < var_sz; ++j) m->d[var_off + j] = seed[val_ind++];\0A  }\0A  // Consistency check\0A  if (val_ind != nSeed) return fmi3Fatal;\0A  // Evaluate forward directional derivatives\0A  flag = evaluate_forward(m);\0A  // Collect sensitivities\0A  val_ind = 0;\0A  for (i = 0; i < nUnknowns; ++i) {\0A    // Get variable\0A    vr = unknowns[i];\0A    // Get offset, size of variable\0A    var_off = var_offset[vr];\0A    var_sz = var_offset[vr + 1] - var_off;\0A    // Copy elements, clear d\0A    for (j = 0; j < var_sz; ++j) {\0A      sensitivity[val_ind++] = m->d[var_off + j];\0A      m->d[var_off + j] = 0;\0A    }\0A  }\0A  // Consistency check\0A  if (val_ind != nSensitivity) return fmi3Fatal;\0A  // Clear derivative seeds\0A  val_ind = 0;\0A  for (i = 0; i < nKnowns; ++i) {\0A    // Get variable\0A    vr = knowns[i];\0A    // Get offset, size of variable\0A    var_off = var_offset[vr];\0A    var_sz = var_offset[vr + 1] - var_off;\0A    // Clear elements\0A    for (j = 0; j < var_sz; ++j) m->d[var_off + j] = 0;\0A  }\0A  // Check for evaluation error\0A  if (flag) return fmi3Error;\0A  // Successful return\0A  return fmi3OK;\0A}\0Afmi3Status fmi3GetAdjointDerivative(\0A    fmi3Instance instance,\0A    const fmi3ValueReference unknowns[],\0A    size_t nUnknowns,\0A    const fmi3ValueReference knowns[],\0A    size_t nKnowns,\0A    const fmi3Float64 seed[],\0A    size_t nSeed,\0A    fmi3Float64 sensitivity[],\0A    size_t nSensitivity) {\0A  // Local variables\0A  casadi_fmi_memory* m;\0A  size_t i, j, var_off, var_sz, val_ind;\0A  fmi3ValueReference vr;\0A  int flag;\