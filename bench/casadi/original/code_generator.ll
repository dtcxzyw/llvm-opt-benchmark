@.str.56 = private unnamed_addr constant [39451 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22std::numeric_limits<T1>::min()\22 \22casadi_real_min\22\0A// C-REPLACE \22std::numeric_limits<T1>::infinity()\22 \22casadi_inf\22\0A// C-REPLACE \22static_cast<int>\22 \22(int) \22\0A// C-REPLACE \22casadi_qp_prob<T1>\22 \22struct casadi_qp_prob\22\0A// C-REPLACE \22casadi_qp_data<T1>\22 \22struct casadi_qp_data\22\0A// SYMBOL \22qrqp_prob\22\0Atemplate<typename T1>\0Astruct casadi_qrqp_prob {\0A  const casadi_qp_prob<T1>* qp;\0A  // Sparsity patterns\0A  const casadi_int *sp_at, *sp_kkt;\0A  // Symbolic QR factorization\0A  const casadi_int *prinv, *pc, *sp_v, *sp_r;\0A  // Smallest nonzero number\0A  T1 dmin;\0A  // Infinity\0A  T1 inf;\0A  // Smallest multiplier treated as inactive for the initial active set\0A  T1 min_lam;\0A  // Maximum number of iterations\0A  casadi_int max_iter;\0A  // Primal and dual error tolerance\0A  T1 constr_viol_tol, dual_inf_tol;\0A};\0A// C-REPLACE \22casadi_qrqp_prob<T1>\22 \22struct casadi_qrqp_prob\22\0A// SYMBOL \22qrqp_setup\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_setup(casadi_qrqp_prob<T1>* p) {\0A  p->dmin = std::numeric_limits<T1>::min();\0A  p->inf = std::numeric_limits<T1>::infinity();\0A  p->min_lam = 0;\0A  p->max_iter = 1000;\0A  p->constr_viol_tol = 1e-8;\0A  p->dual_inf_tol = 1e-8;\0A}\0A// SYMBOL \22qrqp_flag_t\22\0Atypedef enum {\0A  QP_SUCCESS,\0A  QP_MAX_ITER,\0A  QP_NO_SEARCH_DIR,\0A  QP_PRINTING_ERROR\0A} casadi_qrqp_flag_t;\0A// SYMBOL \22qrqp_data\22\0Atemplate<typename T1>\0Astruct casadi_qrqp_data {\0A  // Problem structure\0A  const casadi_qrqp_prob<T1>* prob;\0A  // Problem structure\0A  casadi_qp_data<T1>* qp;\0A  // Cost\0A  T1 f;\0A  // Solver status\0A  casadi_qrqp_flag_t status;\0A  // Vectors\0A  T1 *lbz, *ubz, *z, *infeas, *tinfeas, *sens, *lam, *w, *dz, *dlam;\0A  casadi_int *iw, *neverzero, *neverlower, *neverupper, *lincomb;\0A  // Numeric QR factorization\0A  T1 *nz_at, *nz_kkt, *beta, *nz_v, *nz_r;\0A  // Message buffer\0A  const char *msg;\0A  // Message index\0A  casadi_int msg_ind;\0A  // Stepsize\0A  T1 tau;\0A  // Singularity\0A  casadi_int sing;\0A  // Do we already have a search direction?\0A  int has_search_dir;\0A  // Smallest diagonal value for the QR factorization\0A  T1 mina;\0A  casadi_int imina;\0A  // Primal and dual error, corresponding index\0A  T1 pr, du, epr, edu;\0A  casadi_int ipr, idu;\0A  // Pending active-set change\0A  casadi_int index, sign;\0A  // Feasibility restoration active-set change\0A  casadi_int r_index, r_sign;\0A  // Iteration\0A  casadi_int iter;\0A};\0A// C-REPLACE \22casadi_qrqp_data<T1>\22 \22struct casadi_qrqp_data\22\0A// SYMBOL \22qrqp_work\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_work(const casadi_qrqp_prob<T1>* p, casadi_int* sz_arg, casadi_int* sz_res,\0A    casadi_int* sz_iw, casadi_int* sz_w) {\0A  // Local variables\0A  casadi_int nnz_a, nnz_kkt, nnz_v, nnz_r;\0A  casadi_qp_work(p->qp, sz_arg, sz_res, sz_iw, sz_w);\0A  // Get matrix number of nonzeros\0A  nnz_a = p->qp->sp_a[2+p->qp->sp_a[1]];\0A  nnz_kkt = p->sp_kkt[2+p->sp_kkt[1]];\0A  nnz_v = p->sp_v[2+p->sp_v[1]];\0A  nnz_r = p->sp_r[2+p->sp_r[1]];\0A  // Temporary work vectors\0A  *sz_w = casadi_max(*sz_w, p->qp->nz); // casadi_project, tau memory\0A  *sz_iw = casadi_max(*sz_iw, p->qp->nz); // casadi_trans, tau type, allzero\0A  *sz_w = casadi_max(*sz_w, 2*p->qp->nz); // casadi_qr\0A  // Persistent work vectors\0A  *sz_w += nnz_kkt; // kkt\0A  *sz_w += p->qp->nz; // z=[xk,gk]\0A  *sz_w += p->qp->nz; // lbz\0A  *sz_w += p->qp->nz; // ubz\0A  *sz_w += p->qp->nz; // lam\0A  *sz_w += p->qp->nz; // dz\0A  *sz_w += p->qp->nz; // dlam\0A  *sz_w += casadi_max(nnz_v+nnz_r, nnz_kkt); // [v,r] or trans(kkt)\0A  *sz_w += p->qp->nz; // beta\0A  *sz_w += nnz_a; // trans(a)\0A  *sz_w += p->qp->nx; // infeas\0A  *sz_w += p->qp->nx; // tinfeas\0A  *sz_w += p->qp->nz; // sens\0A  *sz_iw += p->qp->nz; // neverzero\0A  *sz_iw += p->qp->nz; // neverupper\0A  *sz_iw += p->qp->nz; // neverlower\0A  *sz_iw += p->qp->nz; // lincomb\0A}\0A// SYMBOL \22qrqp_init\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_init(casadi_qrqp_data<T1>* d, casadi_int** iw, T1** w) {\0A  // Local variables\0A  casadi_int nnz_a, nnz_kkt, nnz_v, nnz_r;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Get matrix number of nonzeros\0A  nnz_a = p->qp->sp_a[2+p->qp->sp_a[1]];\0A  nnz_kkt = p->sp_kkt[2+p->sp_kkt[1]];\0A  nnz_v = p->sp_v[2+p->sp_v[1]];\0A  nnz_r = p->sp_r[2+p->sp_r[1]];\0A  d->nz_kkt = *w; *w += nnz_kkt;\0A  d->z = *w; *w += p->qp->nz;\0A  d->lbz = *w; *w += p->qp->nz;\0A  d->ubz = *w; *w += p->qp->nz;\0A  d->lam = *w; *w += p->qp->nz;\0A  d->dz = *w; *w += p->qp->nz;\0A  d->dlam = *w; *w += p->qp->nz;\0A  d->nz_v = *w; *w += casadi_max(nnz_v+nnz_r, nnz_kkt);\0A  d->beta = *w; *w += p->qp->nz;\0A  d->nz_at = *w; *w += nnz_a;\0A  d->infeas = *w; *w += p->qp->nx;\0A  d->tinfeas = *w; *w += p->qp->nx;\0A  d->sens = *w; *w += p->qp->nz;\0A  d->neverzero = *iw; *iw += p->qp->nz;\0A  d->neverupper = *iw; *iw += p->qp->nz;\0A  d->neverlower = *iw; *iw += p->qp->nz;\0A  d->lincomb = *iw; *iw += p->qp->nz;\0A  d->w = *w;\0A  d->iw = *iw;\0A  d->nz_r = d->nz_v + nnz_v;\0A}\0A// SYMBOL \22qrqp_reset\22\0Atemplate<typename T1>\0Aint casadi_qrqp_reset(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Reset variables corresponding to previous iteration\0A  d->msg = 0;\0A  d->tau = 0.;\0A  d->sing = 0;\0A  // Correct lam if needed, determine permitted signs\0A  for (i=0; i<p->qp->nz; ++i) {\0A    // Permitted signs for lam\0A    d->neverzero[i] = d->lbz[i] == d->ubz[i];\0A    d->neverupper[i] = d->ubz[i] == p->inf;\0A    d->neverlower[i] = d->lbz[i] == -p->inf;\0A    if (d->neverzero[i] && d->neverupper[i] && d->neverlower[i]) return 1;\0A    // Small enough lambdas are treated as inactive\0A    if (!d->neverzero[i] && fabs(d->lam[i]) < p->min_lam) d->lam[i] = 0.;\0A    // Prevent illegal active sets\0A    if (d->neverzero[i] && d->lam[i] == 0.) {\0A      d->lam[i] = d->neverupper[i]\0A                || d->z[i]-d->lbz[i] <= d->ubz[i]-d->z[i] ? -p->dmin : p->dmin;\0A    } else if (d->neverupper[i] && d->lam[i]>0.) {\0A      d->lam[i] = d->neverzero[i] ? -p->dmin : 0.;\0A    } else if (d->neverlower[i] && d->lam[i]<0.) {\0A      d->lam[i] = d->neverzero[i] ? p->dmin : 0.;\0A    }\0A  }\0A  // Transpose A\0A  casadi_trans(d->qp->a, p->qp->sp_a, d->nz_at, p->sp_at, d->iw);\0A  // No pending active-set change\0A  d->index = -2;\0A  d->sign = 0;\0A  // No restoration index\0A  d->r_index = -2;\0A  d->r_sign = 0;\0A  // Reset iteration counter\0A  d->iter = 0;\0A  return 0;\0A}\0A// SYMBOL \22qrqp_pr\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_pr(casadi_qrqp_data<T1>* d) {\0A  // Calculate largest constraint violation\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  d->pr = 0;\0A  d->ipr = -1;\0A  for (i=0; i<p->qp->nz; ++i) {\0A    if (d->z[i] > d->ubz[i]+d->pr) {\0A      d->pr = d->z[i]-d->ubz[i];\0A      d->ipr = i;\0A    } else if (d->z[i] < d->lbz[i]-d->pr) {\0A      d->pr = d->lbz[i]-d->z[i];\0A      d->ipr = i;\0A    }\0A  }\0A}\0A// SYMBOL \22qrqp_du\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_du(casadi_qrqp_data<T1>* d) {\0A  // Calculate largest constraint violation\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  d->du = 0;\0A  d->idu = -1;\0A  for (i=0; i<p->qp->nx; ++i) {\0A    if (d->infeas[i] > d->du) {\0A      d->du = d->infeas[i];\0A      d->idu = i;\0A    } else if (d->infeas[i] < -d->du) {\0A      d->du = -d->infeas[i];\0A      d->idu = i;\0A    }\0A  }\0A}\0A// SYMBOL \22qrqp_du_check\22\0Atemplate<typename T1>\0Aint casadi_qrqp_du_check(casadi_qrqp_data<T1>* d, casadi_int i) {\0A  // Local variables\0A  casadi_int k;\0A  T1 new_du;\0A  const casadi_int *at_colind, *at_row;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // AT sparsity\0A  at_colind = p->sp_at + 2;\0A  at_row = at_colind + p->qp->na + 1;\0A  // Maximum infeasibility from setting from setting lam[i]=0\0A  if (i<p->qp->nx) {\0A    new_du = fabs(d->infeas[i]-d->lam[i]);\0A  } else {\0A    new_du = 0.;\0A    for (k=at_colind[i-p->qp->nx]; k<at_colind[i-p->qp->nx+1]; ++k) {\0A      new_du = fmax(new_du, fabs(d->infeas[at_row[k]]-d->nz_at[k]*d->lam[i]));\0A    }\0A  }\0A  return new_du <= d->du;\0A}\0A// SYMBOL \22qrqp_du_index\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_du_index(casadi_qrqp_data<T1>* d) {\0A  // Try to improve dual feasibility by removing a constraint\0A  // Local variables\0A  casadi_int i, s;\0A  T1 best_sens;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Find the best lam[i] to make zero\0A  d->index = -1;\0A  best_sens = -1;\0A  for (i = 0; i < p->qp->nz; ++i) {\0A    // Skip if no dual infeasibility sensitivity\0A    if (d->sens[i] == 0.) continue;\0A    // Is the constraint enforced?\0A    if (d->lam[i] == 0) {\0A      // We're enforcing constraints\0A      s = d->sens[i] > 0 ? 1 : -1;\0A      // Make sure that enforcing the constraint is possible\0A      if (s > 0 ? d->neverupper[i] : d->neverlower[i]) continue;\0A    } else {\0A      // We're removing constraints\0A      s = 0;\0A      // Make sure that it's a constraint that can be removed\0A      if (d->neverzero[i]) continue;\0A      // If variable influences du, make sure sign is right\0A      if (d->lam[i] > 0. ? d->sens[i] > 0. : d->sens[i] < 0.) continue;\0A      // Skip if maximum infeasibility increases\0A      if (!casadi_qrqp_du_check(d, i)) continue;\0A    }\0A    // Check if best so far\0A    if (fabs(d->sens[i]) > best_sens) {\0A      best_sens = fabs(d->sens[i]);\0A      d->index = i;\0A      d->sign = s;\0A    }\0A  }\0A  // Accept, if any\0A  if (d->index >= 0) {\0A    if (d->sign > 0) {\0A      d->msg = \22Enforced ubz to reduce |du|\22;\0A    } else if (d->sign < 0) {\0A      d->msg = \22Enforced lbz to reduce |du|\22;\0A    } else if (d->lam[d->index] > 0) {\0A      d->msg = \22Dropped ubz to reduce |du|\22;\0A    } else {\0A      d->msg = \22Dropped lbz to reduce |du|\22;\0A    }\0A    d->msg_ind = d->index;\0A  }\0A}\0A// SYMBOL \22qrqp_pr_index\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_pr_index(casadi_qrqp_data<T1>* d) {\0A  // Try to improve primal feasibility by adding a constraint\0A  if (d->lam[d->ipr] == 0.) {\0A    // Add the most violating constraint\0A    if (d->z[d->ipr] < d->lbz[d->ipr]) {\0A      d->sign = -1;\0A      d->msg = \22Added lbz to reduce |pr|\22;\0A    } else {\0A      d->sign = 1;\0A      d->msg = \22Added ubz to reduce |pr|\22;\0A    }\0A    d->msg_ind = d->ipr;\0A    d->index = d->ipr;\0A  } else {\0A    // No improvement possible\0A    d->index = -1;\0A  }\0A}\0A// SYMBOL \22qrqp_kkt\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_kkt(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i, k;\0A  const casadi_int *h_colind, *h_row, *a_colind, *a_row, *at_colind, *at_row,\0A                   *kkt_colind, *kkt_row;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Extract sparsities\0A  a_row = (a_colind = p->qp->sp_a+2) + p->qp->nx + 1;\0A  at_row = (at_colind = p->sp_at+2) + p->qp->na + 1;\0A  h_row = (h_colind = p->qp->sp_h+2) + p->qp->nx + 1;\0A  kkt_row = (kkt_colind = p->sp_kkt+2) + p->qp->nz + 1;\0A  // Reset w to zero\0A  casadi_clear(d->w, p->qp->nz);\0A  // Loop over rows of the (transposed) KKT\0A  for (i=0; i<p->qp->nz; ++i) {\0A    // Copy row of KKT to w\0A    if (i<p->qp->nx) {\0A      if (d->lam[i]==0) {\0A        for (k=h_colind[i]; k<h_colind[i+1]; ++k) d->w[h_row[k]] = d->qp->h[k];\0A        for (k=a_colind[i]; k<a_colind[i+1]; ++k) d->w[p->qp->nx+a_row[k]] = d->qp->a[k];\0A      } else {\0A        d->w[i] = 1.;\0A      }\0A    } else {\0A      if (d->lam[i]==0) {\0A        d->w[i] = -1.;\0A      } else {\0A        for (k=at_colind[i-p->qp->nx]; k<at_colind[i-p->qp->nx+1]; ++k) {\0A          d->w[at_row[k]] = d->nz_at[k];\0A        }\0A      }\0A    }\0A    // Copy row to KKT, zero out w\0A    for (k=kkt_colind[i]; k<kkt_colind[i+1]; ++k) {\0A      d->nz_kkt[k] = d->w[kkt_row[k]];\0A      d->w[kkt_row[k]] = 0;\0A    }\0A  }\0A}\0A// SYMBOL \22qrqp_kkt_vector\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_kkt_vector(casadi_qrqp_data<T1>* d, T1* kkt_i, casadi_int i) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_int *h_colind, *h_row, *a_colind, *a_row, *at_colind, *at_row;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Extract sparsities\0A  a_row = (a_colind = p->qp->sp_a+2) + p->qp->nx + 1;\0A  at_row = (at_colind = p->sp_at+2) + p->qp->na + 1;\0A  h_row = (h_colind = p->qp->sp_h+2) + p->qp->nx + 1;\0A  // Reset kkt_i to zero\0A  casadi_clear(kkt_i, p->qp->nz);\0A  // Copy sparse entries\0A  if (i<p->qp->nx) {\0A    for (k=h_colind[i]; k<h_colind[i+1]; ++k) kkt_i[h_row[k]] = d->qp->h[k];\0A    for (k=a_colind[i]; k<a_colind[i+1]; ++k) kkt_i[p->qp->nx+a_row[k]] = d->qp->a[k];\0A  } else {\0A    for (k=at_colind[i-p->qp->nx]; k<at_colind[i-p->qp->nx+1]; ++k) {\0A      kkt_i[at_row[k]] = -d->nz_at[k];\0A    }\0A  }\0A  // Add diagonal entry\0A  kkt_i[i] -= 1.;\0A}\0A// SYMBOL \22qrqp_kkt_dot\22\0Atemplate<typename T1>\0AT1 casadi_qrqp_kkt_dot(casadi_qrqp_data<T1>* d, const T1* v, casadi_int i) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_int *h_colind, *h_row, *a_colind, *a_row, *at_colind, *at_row;\0A  T1 r;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Extract sparsities\0A  a_row = (a_colind = p->qp->sp_a + 2) + p->qp->nx + 1;\0A  at_row = (at_colind = p->sp_at + 2) + p->qp->na + 1;\0A  h_row = (h_colind = p->qp->sp_h + 2) + p->qp->nx + 1;\0A  // Scalar product with the diagonal\0A  r = v[i];\0A  // Scalar product with the sparse entries\0A  if (i < p->qp->nx) {\0A    for (k=h_colind[i]; k<h_colind[i+1]; ++k) r -= v[h_row[k]] * d->qp->h[k];\0A    for (k=a_colind[i]; k<a_colind[i+1]; ++k) r -= v[p->qp->nx+a_row[k]] * d->qp->a[k];\0A  } else {\0A    for (k=at_colind[i-p->qp->nx]; k<at_colind[i-p->qp->nx+1]; ++k) {\0A      r += v[at_row[k]] * d->nz_at[k];\0A    }\0A  }\0A  return r;\0A}\0A// SYMBOL \22qrqp_kkt_residual\22\0Atemplate<typename T1>\0Avoid casadi_qrqp_kkt_residual(casadi_qrqp_data<T1>* d, T1* r) {\0A  casadi_int i;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  for (i=0; i<p->qp->nz; ++i) {\0A    if (d->lam[i]>0.) {\0A      r[i] = d->ubz[i]-d->z[i];\0A    } else if (d->lam[i]<0.) {\0A      r[i] = d->lbz[i]-d->z[i];\0A    } else if (i<p->qp->nx) {\0A      r[i] = d->lam[i]-d->infeas[i];\0A    } else {\0A      r[i] = d->lam[i];\0A    }\0A  }\0A}\0A// SYMBOL \22qrqp_zero_blocking\22\0Atemplate<typename T1>\0Aint casadi_qrqp_zero_blocking(casadi_qrqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int i;\0A  T1 dz_max = 0;\0A  const casadi_qrqp_prob<T1>* p = d->prob;\0A  // Look for violated constraints that are not improving\0A  fo