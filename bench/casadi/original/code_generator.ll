@.str.55 = private unnamed_addr constant [2800 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22std::numeric_limits<T1>::min()\22 \22casadi_real_min\22\0A// C-REPLACE \22std::numeric_limits<T1>::infinity()\22 \22casadi_inf\22\0A// C-REPLACE \22static_cast<int>\22 \22(int) \22\0A// SYMBOL \22qp_prob\22\0Atemplate<typename T1>\0Astruct casadi_qp_prob {\0A  // Sparsity patterns\0A  const casadi_int *sp_a, *sp_h;\0A  // Dimensions\0A  casadi_int nx, na, nz;\0A  casadi_int nnz_a, nnz_h;\0A};\0A// C-REPLACE \22casadi_qp_prob<T1>\22 \22struct casadi_qp_prob\22\0A// SYMBOL \22qp_setup\22\0Atemplate<typename T1>\0Avoid casadi_qp_setup(casadi_qp_prob<T1>* p) {\0A  p->na = p->sp_a[0];\0A  p->nx = p->sp_a[1];\0A  p->nz = p->na+p->nx;\0A  p->nnz_a = p->sp_a[2+p->sp_a[1]];\0A  p->nnz_h = p->sp_h[2+p->sp_h[1]];\0A}\0A// C-REPLACE \22UnifiedReturnStatus\22 \22int\22\0A// C-REPLACE \22bool\22 \22int\22\0A// SYMBOL \22qp_data\22\0Atemplate<typename T1>\0Astruct casadi_qp_data {\0A  // Problem structure\0A  const casadi_qp_prob<T1>* prob;\0A  UnifiedReturnStatus unified_return_status;\0A  bool success;\0A  // Number of iterations performed\0A  casadi_int iter_count;\0A  // QP data, pointers to arg (no allocations needed)\0A  const T1 *a, *h, *g, *lbx, *ubx, *lba, *uba, *x0, *lam_x0, *lam_a0;\0A  // QP results, pointers to res (no allocations needed)\0A  T1 *f, *x, *lam_x, *lam_a;\0A};\0A// C-REPLACE \22casadi_qp_data<T1>\22 \22struct casadi_qp_data\22\0A// SYMBOL \22qp_init\22\0Atemplate<typename T1>\0Avoid casadi_qp_init(casadi_qp_data<T1>* d, casadi_int** iw, T1** w) {\0A  // Local variables\0A  //const casadi_qp_prob<T1>* p = d->prob;\0A}\0A// SYMBOL \22qp_work\22\0Atemplate<typename T1>\0Avoid casadi_qp_work(const casadi_qp_prob<T1>* p, casadi_int* sz_arg, casadi_int* sz_res,\0A    casadi_int* sz_iw, casadi_int* sz_w) {\0A  // Reset sz_arg, sz_res\0A  *sz_arg = *sz_res = 0;\0A  // Reset sz_w, sz_iw\0A  *sz_w = *sz_iw = 0;\0A}\0A\00", align 1
