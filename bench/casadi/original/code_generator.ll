@.str.60 = private unnamed_addr constant [5002 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22casadi_nlpsol_prob<T1>\22 \22struct casadi_nlpsol_prob\22\0A// SYMBOL \22sqpmethod_prob\22\0Atemplate<typename T1>\0Astruct casadi_sqpmethod_prob {\0A  const casadi_nlpsol_prob<T1>* nlp;\0A  // Sparsity patterns\0A  const casadi_int *sp_h, *sp_a, *sp_hr;\0A  casadi_int merit_memsize;\0A  casadi_int max_iter_ls;\0A};\0A// C-REPLACE \22casadi_sqpmethod_prob<T1>\22 \22struct casadi_sqpmethod_prob\22\0A// SYMBOL \22sqpmethod_data\22\0Atemplate<typename T1>\0Astruct casadi_sqpmethod_data {\0A  // Problem structure\0A  const casadi_sqpmethod_prob<T1>* prob;\0A  T1* z_cand;\0A  // Lagrange gradient in the next iterate\0A  T1 *gLag, *gLag_old;\0A  // Gradient of the objective\0A  T1 *gf;\0A  // Bounds of the QP\0A  T1 *lbdz, *ubdz;\0A  // QP solution\0A  T1 *dx, *dlam;\0A  // Hessian approximation\0A  T1 *Bk;\0A  // Jacobian\0A  T1* Jk;\0A  // merit_mem\0A  T1* merit_mem;\0A  // temp_mem\0A  T1* temp_mem;\0A  // temp_sol\0A  T1* temp_sol;\0A  const T1** arg;\0A  T1** res;\0A  casadi_int* iw;\0A  T1* w;\0A};\0A// C-REPLACE \22casadi_sqpmethod_data<T1>\22 \22struct casadi_sqpmethod_data\22\0A// SYMBOL \22sqpmethod_work\22\0Atemplate<typename T1>\0Avoid casadi_sqpmethod_work(const casadi_sqpmethod_prob<T1>* p,\0A    casadi_int* sz_iw, casadi_int* sz_w, int elastic_mode, int so_corr) {\0A  // Local variables\0A  casadi_int nnz_h, nnz_a, nx, ng;\0A  nnz_h = p->sp_h[2+p->sp_h[1]];\0A  nnz_a = p->sp_a[2+p->sp_a[1]];\0A  nx = p->nlp->nx;\0A  ng = p->nlp->ng;\0A  // Reset sz_w, sz_iw\0A  *sz_w = *sz_iw = 0;\0A  if (p->max_iter_ls>0 || so_corr) *sz_w += nx + ng; // z_cand\0A  // Lagrange gradient in the next iterate\0A  *sz_w += nx; // gLag\0A  *sz_w += nx; // gLag_old\0A  // Gradient of the objective\0A  *sz_w += nx; // gf\0A  // Bounds of the QP\0A  *sz_w += nx + ng; // lbdz\0A  *sz_w += nx + ng; // ubdz\0A  // QP solution\0A  *sz_w += nx; // dx\0A  *sz_w += nx + ng; // dlam\0A  // Hessian approximation\0A  *sz_w += nnz_h; // Bk\0A  // Jacobian\0A  *sz_w += nnz_a; // Jk\0A  // merit_mem\0A  if (p->max_iter_ls>0 || so_corr) *sz_w += p->merit_memsize;\0A  if (elastic_mode) {\0A    // Additional work for larger objective gradient\0A    *sz_w += 2*ng; // gf\0A    // Additional work for the larger bounds\0A    *sz_w += 2*ng; // lbdz\0A    *sz_w += 2*ng; // ubdz\0A    // Additional work for larger solution\0A    *sz_w += 2*ng; // dx\0A    *sz_w += 2*ng; // dlam\0A    // Additional work for larger jacobian\0A    *sz_w += 2*ng; // Jk\0A    // Additional work for temp memory\0A    *sz_w += ng;\0A  }\0A  if (so_corr) *sz_w += nx+nx+ng; // Temp memory for failing soc\0A}\0A// SYMBOL \22sqpmethod_init\22\0Atemplate<typename T1>\0Avoid casadi_sqpmethod_init(casadi_sqpmethod_data<T1>* d,\0A    const T1*** arg, T1*** res, casadi_int** iw, T1** w,\0A    int elastic_mode, int so_corr) {\0A  // Local variables\0A  casadi_int nnz_h, nnz_a, nx, ng;\0A  const casadi_sqpmethod_prob<T1>* p = d->prob;\0A  // Get matrix number of nonzeros\0A  nnz_h = p->sp_h[2+p->sp_h[1]];\0A  nnz_a = p->sp_a[2+p->sp_a[1]];\0A  nx = p->nlp->nx;\0A  ng = p->nlp->ng;\0A  if (p->max_iter_ls>0 || so_corr) {\0A    d->z_cand = *w; *w += nx + ng;\0A  }\0A  // Lagrange gradient in the next iterate\0A  d->gLag = *w; *w += nx;\0A  d->gLag_old = *w; *w += nx;\0A  // Hessian approximation\0A  d->Bk = *w; *w += nnz_h;\0A  // merit_mem\0A  if (p->max_iter_ls>0 || so_corr) {\0A    d->merit_mem = *w; *w += p->merit_memsize;\0A  }\0A  if (so_corr) {\0A    d->temp_sol = *w; *w += nx+nx+ng;\0A  }\0A  if (elastic_mode) {\0A    // Gradient of the objective\0A    d->gf = *w; *w += nx + 2*ng;\0A    // Bounds of the QP\0A    d->lbdz = *w; *w += nx + 3*ng;\0A    d->ubdz = *w; *w += nx + 3*ng;\0A    // QP solution\0A    d->dx = *w; *w += nx + 2*ng;\0A    d->dlam = *w; *w += nx + 3*ng;\0A    // Jacobian\0A    d->Jk = *w; *w += nnz_a + 2*ng;\0A    // temp mem\0A    d->temp_mem = *w; *w += ng;\0A  } else {\0A    // Gradient of the objective\0A    d->gf = *w; *w += nx;\0A    // Bounds of the QP\0A    d->lbdz = *w; *w += nx + ng;\0A    d->ubdz = *w; *w += nx + ng;\0A    // QP solution\0A    d->dx = *w; *w += nx;\0A    d->dlam = *w; *w += nx + ng;\0A    // Jacobian\0A    d->Jk = *w; *w += nnz_a;\0A  }\0A  d->arg = *arg;\0A  d->res = *res;\0A  d->iw = *iw;\0A  d->w = *w;\0A}\0A\00", align 1
