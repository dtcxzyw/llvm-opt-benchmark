@.str.62 = private unnamed_addr constant [2341 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// SYMBOL \22lb_eig\22\0A// Use Gershgorin to finds upper and lower bounds on the eigenvalues\0Atemplate<typename T1>\0AT1 casadi_lb_eig(const casadi_int* sp_h, const T1* h) {\0A  // Local variables\0A  casadi_int ncol, c, k;\0A  T1 center, radius;\0A  const casadi_int *colind, *row;\0A  // Return value\0A  T1 lb_eig = 0;\0A  // Get sparsity\0A  ncol = sp_h[1];\0A  colind = sp_h+2; row = sp_h+ncol+3;\0A  for (c=0; c<ncol; ++c) {\0A    // Calculate Gershgorin discs\0A    center = 0;\0A    radius = 0;\0A    for (k=colind[c]; k<colind[c+1]; ++k) {\0A      if (row[k]==c) {\0A        center = h[k];\0A      } else {\0A        radius += fabs(h[k]);\0A      }\0A    }\0A    // Update the eigenvalue estimates\0A    if (c==0) {\0A      lb_eig = center - radius;\0A    } else {\0A      lb_eig = fmin(lb_eig, center - radius);\0A    }\0A  }\0A  return lb_eig;\0A}\0A// SYMBOL \22regularize\22\0A// Add a multiple of the identity matrix to the diagonal\0Atemplate<typename T1>\0Avoid casadi_regularize(const casadi_int* sp_h, T1* h, T1 reg) {\0A  // Local variables\0A  casadi_int ncol, c, k;\0A  const casadi_int *colind, *row;\0A  // Get sparsity\0A  ncol = sp_h[1];\0A  colind = sp_h+2; row = sp_h+ncol+3;\0A  // Shift diagonal entries\0A  for (c=0; c<ncol; ++c) {\0A    for (k=colind[c]; k<colind[c+1]; ++k) {\0A      if (row[k]==c) h[k] += reg;\0A    }\0A  }\0A}\0A\00", align 1
