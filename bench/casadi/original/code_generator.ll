@.str.58 = private unnamed_addr constant [24807 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22std::numeric_limits<T1>::min()\22 \22casadi_real_min\22\0A// C-REPLACE \22std::numeric_limits<T1>::infinity()\22 \22casadi_inf\22\0A// C-REPLACE \22static_cast<int>\22 \22(int) \22\0A// SYMBOL \22ipqp_prob\22\0Atemplate<typename T1>\0Astruct casadi_ipqp_prob {\0A  // Dimensions\0A  casadi_int nx, na, nz;\0A  // Smallest nonzero number\0A  T1 dmin;\0A  // Infinity\0A  T1 inf;\0A  // Maximum number of iterations\0A  casadi_int max_iter;\0A  // Error tolerance\0A  T1 pr_tol, du_tol, co_tol, mu_tol;\0A};\0A// C-REPLACE \22casadi_ipqp_prob<T1>\22 \22struct casadi_ipqp_prob\22\0A// SYMBOL \22ipqp_setup\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_setup(casadi_ipqp_prob<T1>* p, casadi_int nx, casadi_int na) {\0A  p->nx = nx;\0A  p->na = na;\0A  p->nz = nx + na;\0A  p->dmin = std::numeric_limits<T1>::min();\0A  p->inf = std::numeric_limits<T1>::infinity();\0A  p->max_iter = 100;\0A  p->pr_tol = 1e-8;\0A  p->du_tol = 1e-8;\0A  p->co_tol = 1e-8;\0A  p->mu_tol = 1e-8;\0A}\0A// SYMBOL \22ipqp_flag_t\22\0Atypedef enum {\0A  IPQP_SUCCESS,\0A  IPQP_MAX_ITER,\0A  IPQP_NO_SEARCH_DIR,\0A  IPQP_MV_ERROR,\0A  IPQP_FACTOR_ERROR,\0A  IPQP_SOLVE_ERROR,\0A  IPQP_PROGRESS_ERROR\0A} casadi_ipqp_flag_t;\0A// SYMBOL \22ipqp_task_t\22\0Atypedef enum {\0A  IPQP_MV,\0A  IPQP_PROGRESS,\0A  IPQP_FACTOR,\0A  IPQP_SOLVE} casadi_ipqp_task_t;\0A// SYMBOL \22ipqp_task_t\22\0Atypedef enum {\0A  IPQP_RESET,\0A  IPQP_RESIDUAL,\0A  IPQP_NEWITER,\0A  IPQP_PREPARE,\0A  IPQP_PREDICTOR,\0A  IPQP_CORRECTOR} casadi_ipqp_next_t;\0A// SYMBOL \22ipqp_blocker_t\22\0Atypedef enum {\0A  IPQP_NONE = 0x0,\0A  IPQP_UPPER = 0x1,\0A  IPQP_LOWER = 0x2,\0A  IPQP_PRIMAL = 0x4,\0A  IPQP_DUAL = 0x8\0A} casadi_blocker_t;\0A// SYMBOL \22ipqp_data\22\0Atemplate<typename T1>\0Astruct casadi_ipqp_data {\0A  // Problem structure\0A  const casadi_ipqp_prob<T1>* prob;\0A  // QP data\0A  const T1 *g;\0A  // Number of finite constraints\0A  casadi_int n_con;\0A  // Solver status\0A  casadi_ipqp_flag_t status;\0A  // User task\0A  casadi_ipqp_task_t task;\0A  // Next step\0A  casadi_ipqp_next_t next;\0A  // Linear system\0A  T1* linsys;\0A  // Message buffer\0A  const char *msg;\0A  // Complementarity measure\0A  T1 mu;\0A  // Stepsize\0A  T1 tau;\0A  // Primal and dual error, complementarity error, corresponding index\0A  T1 pr, du, co;\0A  casadi_int ipr, idu, ico;\0A  // Iteration\0A  casadi_int iter;\0A  // Bounds\0A  T1 *lbz, *ubz;\0A  // Current solution\0A  T1 *z, *lam, *lam_lbz, *lam_ubz;\0A  // Step\0A  T1 *dz, *dlam, *dlam_lbz, *dlam_ubz;\0A  // Residual\0A  T1 *rz, *rlam, *rlam_lbz, *rlam_ubz;\0A  // Diagonal entries\0A  T1* D;\0A  // Scaling factor\0A  T1* S;\0A  // Inverse of margin to bounds (0 if no bound)\0A  T1 *dinv_lbz, *dinv_ubz;\0A};\0A// C-REPLACE \22casadi_ipqp_data<T1>\22 \22struct casadi_ipqp_data\22\0A// SYMBOL \22ipqp_sz_w\22\0Atemplate<typename T1>\0Acasadi_int casadi_ipqp_sz_w(const casadi_ipqp_prob<T1>* p) {\0A  // Return value\0A  casadi_int sz_w = 0;\0A  // Persistent work vectors\0A  sz_w += p->nz; // lbz\0A  sz_w += p->nz; // ubz\0A  sz_w += p->nz; // z\0A  sz_w += p->nz; // lam\0A  sz_w += p->nz; // lam_lbz\0A  sz_w += p->nz; // lam_ubz\0A  sz_w += p->nz; // dz\0A  sz_w += p->nz; // dlam\0A  sz_w += p->nz; // dlam_lbz\0A  sz_w += p->nz; // dlam_ubz\0A  sz_w += p->nz; // rz\0A  sz_w += p->nz; // rlam\0A  sz_w += p->nz; // rlam_lbz\0A  sz_w += p->nz; // rlam_ubz\0A  sz_w += p->nz; // D\0A  sz_w += p->nz; // S\0A  sz_w += p->nz; // dinv_lbz\0A  sz_w += p->nz; // dinv_ubz\0A  return sz_w;\0A}\0A// SYMBOL \22ipqp_init\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_init(casadi_ipqp_data<T1>* d, casadi_int** iw, T1** w) {\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Assign memory\0A  d->lbz = *w; *w += p->nz;\0A  d->ubz = *w; *w += p->nz;\0A  d->z = *w; *w += p->nz;\0A  d->lam = *w; *w += p->nz;\0A  d->lam_lbz = *w; *w += p->nz;\0A  d->lam_ubz = *w; *w += p->nz;\0A  d->dz = *w; *w += p->nz;\0A  d->dlam = *w; *w += p->nz;\0A  d->dlam_lbz = *w; *w += p->nz;\0A  d->dlam_ubz = *w; *w += p->nz;\0A  d->rz = *w; *w += p->nz;\0A  d->rlam = *w; *w += p->nz;\0A  d->rlam_lbz = *w; *w += p->nz;\0A  d->rlam_ubz = *w; *w += p->nz;\0A  d->D = *w; *w += p->nz;\0A  d->S = *w; *w += p->nz;\0A  d->dinv_lbz = *w; *w += p->nz;\0A  d->dinv_ubz = *w; *w += p->nz;\0A  // New QP\0A  d->next = IPQP_RESET;\0A}\0A// SYMBOL \22ipqp_bounds\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_bounds(casadi_ipqp_data<T1>* d, const T1* g,\0A    const T1* lbx, const T1* ubx, const T1* lba, const T1* uba) {\0A  // Local variables\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Pass pointer to linear term in objective\0A  d->g = g;\0A  // Pass bounds on z\0A  casadi_copy(lbx, p->nx, d->lbz);\0A  casadi_copy(lba, p->na, d->lbz + p->nx);\0A  casadi_copy(ubx, p->nx, d->ubz);\0A  casadi_copy(uba, p->na, d->ubz + p->nx);\0A}\0A// SYMBOL \22ipqp_guess\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_guess(casadi_ipqp_data<T1>* d,\0A    const T1* x0, const T1* lam_x0, const T1* lam_a0) {\0A  // Local variables\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Pass initial guess\0A  casadi_copy(x0, p->nx, d->z);\0A  casadi_fill(d->z + p->nx, p->na, 0.);\0A  casadi_copy(lam_x0, p->nx, d->lam);\0A  casadi_copy(lam_a0, p->na, d->lam + p->nx);\0A  casadi_fill(d->lam_lbz, p->nz, 0.);\0A  casadi_fill(d->lam_ubz, p->nz, 0.);\0A}\0A// SYMBOL \22ipqp_reset\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_reset(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int k;\0A  T1 margin, mid;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Required margin to constraints\0A  margin = .1;\0A  // Reset constraint count\0A  d->n_con = 0;\0A  // Initialize constraints to zero\0A  for (k = p->nx; k < p->nz; ++k) d->z[k] = 0;\0A  // Find interior point\0A  for (k = 0; k < p->nz; ++k) {\0A    if (d->lbz[k] > -p->inf) {\0A      if (d->ubz[k] < p->inf) {\0A        // Both upper and lower bounds\0A        mid = .5 * (d->lbz[k] + d->ubz[k]);\0A        // Ensure margin to boundary, without crossing midpoint\0A        if (d->z[k] < mid) {\0A          d->z[k] = fmin(fmax(d->z[k], d->lbz[k] + margin), mid);\0A        } else if (d->z[k] > mid) {\0A          d->z[k] = fmax(fmin(d->z[k], d->ubz[k] - margin), mid);\0A        }\0A        if (d->ubz[k] > d->lbz[k] + p->dmin) {\0A          d->lam_lbz[k] = 1;\0A          d->lam_ubz[k] = 1;\0A          d->n_con += 2;\0A        }\0A      } else {\0A        // Only lower bound\0A        d->z[k] = fmax(d->z[k], d->lbz[k] + margin);\0A        d->lam_lbz[k] = 1;\0A        d->n_con++;\0A      }\0A    } else {\0A      if (d->ubz[k] < p->inf) {\0A        // Only upper bound\0A        d->z[k] = fmin(d->z[k], d->ubz[k] - margin);\0A        d->lam_ubz[k] = 1;\0A        d->n_con++;\0A      }\0A    }\0A  }\0A  // Clear residual\0A  casadi_clear(d->rz, p->nz);\0A  // Reset iteration counter\0A  d->iter = 0;\0A  // Reset iteration variables\0A  d->msg = 0;\0A  d->tau = -1;\0A}\0A// SYMBOL \22ipqp_diag\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_diag(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Diagonal entries corresponding to variables\0A  for (k = 0; k < p->nx; ++k) {\0A    if (d->ubz[k] <= d->lbz[k] + p->dmin) {\0A      // Fixed variable (eliminate)\0A      d->D[k] = -1;\0A    } else {\0A      d->D[k] = d->lam_lbz[k] * d->dinv_lbz[k]\0A        + d->lam_ubz[k] * d->dinv_ubz[k];\0A    }\0A  }\0A  // Diagonal entries corresponding to constraints\0A  for (; k < p->nz; ++k) {\0A    if (d->lbz[k] <= -p->inf && d->ubz[k] >= p->inf) {\0A      // Unconstrained (eliminate)\0A      d->D[k] = -1;\0A    } else if (d->ubz[k] <= d->lbz[k] + p->dmin) {\0A      // Equality constrained\0A      d->D[k] = 0;\0A    } else {\0A      d->D[k] = 1. / (d->lam_lbz[k] * d->dinv_lbz[k]\0A        + d->lam_ubz[k] * d->dinv_ubz[k]);\0A    }\0A  }\0A  // Scale diagonal entries\0A  for (k = 0; k < p->nz; ++k) {\0A    if (d->D[k] < 0) {\0A      // Eliminate\0A      d->S[k] = 0;\0A      d->D[k] = 1;\0A    } else {\0A      // Scale\0A      d->S[k] = fmin(1., std::sqrt(1. / d->D[k]));\0A      d->D[k] = fmin(1., d->D[k]);\0A    }\0A  }\0A}\0A// SYMBOL \22ipqp_newiter\22\0Atemplate<typename T1>\0Aint casadi_ipqp_newiter(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Converged?\0A  if (d->pr < p->pr_tol && d->du < p->du_tol && d->co < p->co_tol\0A      && d->mu < p->mu_tol) {\0A    d->status = IPQP_SUCCESS;\0A    return 1;\0A  }\0A  // Max number of iterations reached\0A  if (d->iter >= p->max_iter) {\0A    d->status = IPQP_MAX_ITER;\0A    return 1;\0A  }\0A  // Start new iteration\0A  d->iter++;\0A  // Calculate diagonal entries and scaling factors\0A  casadi_ipqp_diag(d);\0A  // Success\0A  return 0;\0A}\0A// SYMBOL \22ipqp_residual\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_residual(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int k;\0A  T1 bdiff, viol;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Gradient of the Lagrangian\0A  casadi_axpy(p->nx, 1., d->g, d->rz);\0A  for (k = 0; k < p->nx; ++k) {\0A    if (d->ubz[k] <= d->lbz[k] + p->dmin) {\0A      // Fixed variable: Solve to get multiplier explicitly\0A      d->lam[k] = -d->rz[k];\0A      d->rz[k] = 0;\0A    } else {\0A      // Residual\0A      d->rz[k] += d->lam[k];\0A    }\0A  }\0A  // Constraint violation (only possible for linear constraints)\0A  d->ipr = -1;\0A  d->pr = 0;\0A  for (k = p->nx; k < p->nz; ++k) {\0A    if (d->lbz[k] <= -p->inf && d->ubz[k] >= p->inf) {\0A      // Unconstrained: Solve to get g explicitly\0A      d->z[k] = d->rz[k];\0A      d->lam[k] = 0;\0A    } else {\0A      // Check constraint violation\0A      if (d->rz[k] + d->pr < d->lbz[k]) {\0A        d->pr = d->lbz[k] - d->rz[k];\0A        d->ipr = k;\0A      } else if (d->rz[k] - d->pr > d->ubz[k]) {\0A        d->pr = d->rz[k] - d->ubz[k];\0A        d->ipr = k;\0A      }\0A    }\0A  }\0A  // Dual infeasibility\0A  d->idu = -1;\0A  d->du = 0;\0A  for (k = 0; k < p->nx; ++k) {\0A    if (fabs(d->rz[k]) > d->du) {\0A      d->du = fabs(d->rz[k]);\0A      d->idu = k;\0A    }\0A  }\0A  // Linear constraint\0A  casadi_axpy(p->na, -1., d->z + p->nx, d->rz + p->nx);\0A  // Multiplier consistency\0A  for (k = 0; k < p->nz; ++k) {\0A    if (d->ubz[k] <= d->lbz[k] + p->dmin) {\0A      // Fixed variable: Solve to get lam_lbz, lam_ubz\0A      d->lam_ubz[k] = fmax(d->lam[k], 0.);\0A      d->lam_lbz[k] = fmax(-d->lam[k], 0.);\0A      d->rlam[k] = 0;\0A    } else {\0A      // Residual\0A      d->rlam[k] = d->lam_ubz[k] - d->lam_lbz[k] - d->lam[k];\0A    }\0A  }\0A  // Complementarity conditions, mu\0A  d->mu = 0;\0A  d->ico = -1;\0A  d->co = 0;\0A  for (k = 0; k < p->nz; ++k) {\0A    // Lower bound\0A    if (d->lbz[k] > -p->inf && d->ubz[k] > d->lbz[k] + p->dmin) {\0A      // Inequality constraint\0A      bdiff = d->z[k] - d->lbz[k];\0A      d->mu += d->rlam_lbz[k] = d->lam_lbz[k] * bdiff;\0A      d->dinv_lbz[k] = 1. / bdiff;\0A      // Constraint violation\0A      viol = bdiff * fmax(-d->lam[k], 0.);\0A      if (viol > d->co) {\0A        d->co = viol;\0A        d->ico = k;\0A      }\0A    } else {\0A      // No bound or equality constraint\0A      d->rlam_lbz[k] = 0;\0A      d->dinv_lbz[k] = 0;\0A    }\0A    // Upper bound\0A    if (d->ubz[k] < p->inf && d->ubz[k] > d->lbz[k] + p->dmin) {\0A      // Inequality constraint\0A      bdiff = d->ubz[k] - d->z[k];\0A      d->mu += d->rlam_ubz[k] = d->lam_ubz[k] * bdiff;\0A      d->dinv_ubz[k] = 1. / bdiff;\0A      // Constraint violation\0A      viol = bdiff * fmax(d->lam[k], 0.);\0A      if (viol > d->co) {\0A        d->co = viol;\0A        d->ico = k;\0A      }\0A    } else {\0A      // No bound or equality constraint\0A      d->rlam_ubz[k] = 0;\0A      d->dinv_ubz[k] = 0;\0A    }\0A  }\0A  // Divide mu by total number of finite constraints\0A  if (d->n_con > 0) d->mu /= d->n_con;\0A}\0A// SYMBOL \22ipqp_predictor_prepare\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_predictor_prepare(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Store r_lam - dinv_lbz * rlam_lbz + dinv_ubz * rlam_ubz in dz\0A  casadi_copy(d->rlam, p->nz, d->dz);\0A  for (k=0; k<p->nz; ++k) d->dz[k] += d->dinv_lbz[k] * d->rlam_lbz[k];\0A  for (k=0; k<p->nz; ++k) d->dz[k] -= d->dinv_ubz[k] * d->rlam_ubz[k];\0A  // Finish calculating x-component of right-hand-side and store in dz[:nx]\0A  for (k=0; k<p->nx; ++k) d->dz[k] += d->rz[k];\0A  // Copy tilde{r}_lam to dlam[nx:] (needed to calculate step in g later)\0A  for (k=p->nx; k<p->nz; ++k) d->dlam[k] = d->dz[k];\0A  // Finish calculating g-component of right-hand-side and store in dz[nx:]\0A  for (k=p->nx; k<p->nz; ++k) {\0A    if (d->S[k] == 0.) {\0A      // Eliminate\0A      d->dz[k] = 0;\0A    } else {\0A      d->dz[k] *= d->D[k] / (d->S[k] * d->S[k]);\0A      d->dz[k] += d->rz[k];\0A    }\0A  }\0A  // Scale and negate right-hand-side\0A  for (k=0; k<p->nz; ++k) d->dz[k] *= -d->S[k];\0A  // dlam_lbz := -rlam_lbz, dlam_ubz := -rlam_ubz\0A  for (k=0; k<p->nz; ++k) d->dlam_lbz[k] = -d->rlam_lbz[k];\0A  for (k=0; k<p->nz; ++k) d->dlam_ubz[k] = -d->rlam_ubz[k];\0A  // dlam_x := rlam_x\0A  for (k=0; k<p->nx; ++k) d->dlam[k] = d->rlam[k];\0A  // Solve to get step\0A  d->linsys = d->dz;\0A}\0A// SYMBOL \22ipqp_maxstep\22\0Atemplate<typename T1>\0Aint casadi_ipqp_maxstep(casadi_ipqp_data<T1>* d, T1* alpha, casadi_int* ind) {\0A  // Local variables\0A  T1 test;\0A  casadi_int k, blocking_k;\0A  int flag;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Reset variables\0A  blocking_k = -1;\0A  flag = IPQP_NONE;\0A  // Maximum step size is 1\0A  *alpha = 1.;\0A  // Primal step\0A  for (k=0; k<p->nz; ++k) {\0A    if (d->dz[k] < 0 && d->lbz[k] > -p->inf) {\0A      if ((test = (d->lbz[k] - d->z[k]) / d->dz[k]) < *alpha) {\0A        *alpha = test;\0A        blocking_k = k;\0A        flag = IPQP_PRIMAL | IPQP_LOWER;\0A      }\0A    }\0A    if (d->dz[k] > 0 && d->ubz[k] < p->inf) {\0A      if ((test = (d->ubz[k] - d->z[k]) / d->dz[k]) < *alpha) {\0A        *alpha = test;\0A        blocking_k = k;\0A        flag = IPQP_PRIMAL | IPQP_UPPER;\0A      }\0A    }\0A  }\0A  // Dual step\0A  for (k=0; k<p->nz; ++k) {\0A    if (d->dlam_lbz[k] < 0.) {\0A      if ((test = -d->lam_lbz[k] / d->dlam_lbz[k]) < *alpha) {\0A        *alpha = test;\0A        blocking_k = k;\0A        flag = IPQP_DUAL | IPQP_LOWER;\0A      }\0A    }\0A    if (d->dlam_ubz[k] < 0.) {\0A      if ((test = -d->lam_ubz[k] / d->dlam_ubz[k]) < *alpha) {\0A        *alpha = test;\0A        blocking_k = k;\0A        flag = IPQP_DUAL | IPQP_UPPER;\0A      }\0A    }\0A  }\0A  // Return information about blocking constraints\0A  if (ind) *ind = blocking_k;\0A  return flag;\0A}\0A// SYMBOL \22ipqp_predictor\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_predictor(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  casadi_int k;\0A  T1 t, alpha, sigma;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Scale results\0A  for (k=0; k<p->nz; ++k) d->dz[k] *= d->S[k];\0A  // Calculate step in z(g), lam(g)\0A  for (k=p->nx; k<p->nz; ++k) {\0A    if (d->S[k] == 0.) {\0A      // Eliminate\0A      d->dlam[k] = d->dz[k] = 0;\0A    } else {\0A      t = d->D[k] / (d->S[k] * d->S[k]) * (d->dz[k] - d->dlam[k]);\0A      d->dlam[k] = d->dz[k];\0A      d->dz[k] = t;\0A    }\0A  }\0A  // Finish calculation in dlam_lbz, dlam_ubz\0A  for (k=0; k<p->nz; ++k) {\0A    d->dlam_lbz[k] -= d->lam_lbz[k] * d->dz[k];\0A    d->dlam_lbz[k] *= d->dinv_lbz[k];\0A  }\0A  for (k=0; k<p->nz; ++k) {\0A    d->dlam_ubz[k] += d->lam_ubz[k] * d->dz[k];\0A    d->dlam_ubz[k] *= d->dinv_ubz[k];\0A  }\0A  // Finish calculation of dlam(x)\0A  for (k=0; k<p->nx; ++k) d->dlam[k] += d->dlam_ubz[k] - d->dlam_lbz[k];\0A  // Maximum primal and dual step\0A  (void)casadi_ipqp_maxstep(d, &alpha, 0);\0A  // Calculate sigma\0A  sigma = casadi_ipqp_sigma(d, alpha);\0A  // Prepare corrector step\0A  casadi_ipqp_corrector_prepare(d, -sigma * d->mu);\0A  // Solve to get step\0A  d->linsys = d->rz;\0A}\0A// SYMBOL \22ipqp_step\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_step(casadi_ipqp_data<T1>* d, T1 alpha_pr, T1 alpha_du) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Primal step\0A  for (k=0; k<p->nz; ++k) d->z[k] += alpha_pr * d->dz[k];\0A  // Dual step\0A  for (k=0; k<p->nz; ++k) d->lam[k] += alpha_du * d->dlam[k];\0A  for (k=0; k<p->nz; ++k) d->lam_lbz[k] += alpha_du * d->dlam_lbz[k];\0A  for (k=0; k<p->nz; ++k) d->lam_ubz[k] += alpha_du * d->dlam_ubz[k];\0A}\0A// SYMBOL \22ipqp_mu\22\0Atemplate<typename T1>\0AT1 casadi_ipqp_mu(casadi_ipqp_data<T1>* d, T1 alpha) {\0A  // Local variables\0A  T1 mu;\0A  casadi_int k;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Quick return if no inequalities\0A  if (d->n_con == 0) return 0;\0A  // Calculate projected mu (and save to sigma variable)\0A  mu = 0;\0A  for (k = 0; k < p->nz; ++k) {\0A    // Lower bound\0A    if (d->lbz[k] > -p->inf && d->ubz[k] > d->lbz[k] + p->dmin) {\0A      mu += (d->lam_lbz[k] + alpha * d->dlam_lbz[k])\0A        * (d->z[k] - d->lbz[k] + alpha * d->dz[k]);\0A    }\0A    // Upper bound\0A    if (d->ubz[k] < p->inf && d->ubz[k] > d->lbz[k] + p->dmin) {\0A      mu += (d->lam_ubz[k] + alpha * d->dlam_ubz[k])\0A        * (d->ubz[k] - d->z[k] - alpha * d->dz[k]);\0A    }\0A  }\0A  // Divide mu by total number of finite constraints\0A  mu /= d->n_con;\0A  return mu;\0A}\0A// SYMBOL \22ipqp_sigma\22\0Atemplate<typename T1>\0AT1 casadi_ipqp_sigma(casadi_ipqp_data<T1>* d, T1 alpha) {\0A  // Local variables\0A  T1 sigma;\0A  // Quick return if no inequalities\0A  if (d->n_con == 0) return 0;\0A  // Calculate projected mu (and save to sigma variable)\0A  sigma = casadi_ipqp_mu(d, alpha);\0A  // Finish calculation of sigma := (mu_aff / mu)^3\0A  sigma /= d->mu;\0A  sigma *= sigma * sigma;\0A  return sigma;\0A}\0A// SYMBOL \22ipqp_corrector_prepare\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_corrector_prepare(casadi_ipqp_data<T1>* d, T1 shift) {\0A  // Local variables\0A  casadi_int k;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Modified residual in lam_lbz, lam_ubz\0A  for (k=0; k<p->nz; ++k) d->rlam_lbz[k] = d->dlam_lbz[k] * d->dz[k] + shift;\0A  for (k=0; k<p->nz; ++k) d->rlam_ubz[k] = -d->dlam_ubz[k] * d->dz[k] + shift;\0A  // Difference in tilde(r)_x, tilde(r)_lamg\0A  for (k=0; k<p->nz; ++k)\0A    d->rz[k] = d->dinv_lbz[k] * d->rlam_lbz[k]\0A      - d->dinv_ubz[k] * d->rlam_ubz[k];\0A  // Difference in tilde(r)_g\0A  for (k=p->nx; k<p->nz; ++k) {\0A    if (d->S[k] == 0.) {\0A      // Eliminate\0A      d->rlam[k] = d->rz[k] = 0;\0A    } else {\0A      d->rlam[k] = d->rz[k];\0A      d->rz[k] *= d->D[k] / (d->S[k] * d->S[k]);\0A    }\0A  }\0A  // Scale and negate right-hand-side\0A  for (k=0; k<p->nz; ++k) d->rz[k] *= -d->S[k];\0A}\0A// SYMBOL \22ipqp_corrector\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_corrector(casadi_ipqp_data<T1>* d) {\0A  // Local variables\0A  T1 t, mu_test, primal_slack, primal_step, dual_slack, dual_step, max_tau;\0A  casadi_int k;\0A  int flag;\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Scale results\0A  for (k=0; k<p->nz; ++k) d->rz[k] *= d->S[k];\0A  // Calculate step in z(g), lam(g)\0A  for (k=p->nx; k<p->nz; ++k) {\0A    if (d->S[k] == 0.) {\0A      // Eliminate\0A      d->rlam[k] = d->rz[k] = 0;\0A    } else {\0A      t = d->D[k] / (d->S[k] * d->S[k]) * (d->rz[k] - d->rlam[k]);\0A      d->rlam[k] = d->rz[k];\0A      d->rz[k] = t;\0A    }\0A  }\0A  // Update step in dz, dlam\0A  for (k=0; k<p->nz; ++k) d->dz[k] += d->rz[k];\0A  for (k=p->nx; k<p->nz; ++k) d->dlam[k] += d->rlam[k];\0A  // Update step in lam_lbz\0A  for (k=0; k<p->nz; ++k) {\0A    t = d->dinv_lbz[k] * (-d->rlam_lbz[k] - d->lam_lbz[k] * d->rz[k]);\0A    d->dlam_lbz[k] += t;\0A    if (k<p->nx) d->dlam[k] -= t;\0A  }\0A  // Update step in lam_ubz\0A  for (k=0; k<p->nz; ++k) {\0A    t = d->dinv_ubz[k] * (-d->rlam_ubz[k] + d->lam_ubz[k] * d->rz[k]);\0A    d->dlam_ubz[k] += t;\0A    if (k<p->nx) d->dlam[k] += t;\0A  }\0A  // Find the largest step size, keeping track of blocking constraints\0A  flag = casadi_ipqp_maxstep(d, &max_tau, &k);\0A  // Handle blocking constraints using Mehrotra's heuristic\0A  if (flag == IPQP_NONE) {\0A    // No blocking constraints\0A    d->tau = 1;\0A  } else {\0A    // Calculate mu for maximum step\0A    mu_test = casadi_ipqp_mu(d, max_tau);\0A    // Get distance to constraints for blocking variable\0A    if (flag & IPQP_UPPER) {\0A      primal_slack = d->ubz[k] - d->z[k];\0A      primal_step = -d->dz[k];\0A      dual_slack = d->lam_ubz[k];\0A      dual_step = d->dlam_ubz[k];\0A    } else {\0A      primal_slack = d->z[k] - d->lbz[k];\0A      primal_step = d->dz[k];\0A      dual_slack = d->lam_lbz[k];\0A      dual_step = d->dlam_lbz[k];\0A    }\0A    // Mehrotra's heuristic as in in OOQP per communication with S. Wright\0A    if (flag & IPQP_PRIMAL) {\0A      d->tau = (0.01 * mu_test / (dual_slack + max_tau * dual_step)\0A        - primal_slack) / primal_step;\0A    } else {\0A      d->tau = (0.01 * mu_test / (primal_slack + max_tau * primal_step)\0A        - dual_slack) / dual_step;\0A    }\0A    d->tau = fmax(d->tau, 0.99 * max_tau);\0A  }\0A  // Take step\0A  casadi_ipqp_step(d, d->tau, d->tau);\0A  // Clear residual\0A  casadi_clear(d->rz, p->nz);\0A}\0A// SYMBOL \22ipqp\22\0Atemplate<typename T1>\0Aint casadi_ipqp(casadi_ipqp_data<T1>* d) {\0A  switch (d->next) {\0A    case IPQP_RESET:\0A      casadi_ipqp_reset(d);\0A      d->task = IPQP_MV;\0A      d->next = IPQP_RESIDUAL;\0A      return 1;\0A    case IPQP_RESIDUAL:\0A      // Calculate residual\0A      if (d->status == IPQP_MV_ERROR) break;\0A      casadi_ipqp_residual(d);\0A      d->task = IPQP_PROGRESS;\0A      d->next = IPQP_NEWITER;\0A      return 1;\0A    case IPQP_NEWITER:\0A      // New iteration\0A      if (d->status == IPQP_PROGRESS_ERROR) break;\0A      if (casadi_ipqp_newiter(d)) break;\0A      d->task = IPQP_FACTOR;\0A      d->next = IPQP_PREPARE;\0A      return 1;\0A    case IPQP_PREPARE:\0A      // Prepare predictor step\0A      if (d->status == IPQP_FACTOR_ERROR) break;\0A      casadi_ipqp_predictor_prepare(d);\0A      d->task = IPQP_SOLVE;\0A      d->next = IPQP_PREDICTOR;\0A      return 1;\0A    case IPQP_PREDICTOR:\0A      // Complete predictor step\0A      if (d->status == IPQP_SOLVE_ERROR) break;\0A      casadi_ipqp_predictor(d);\0A      d->task = IPQP_SOLVE;\0A      d->next = IPQP_CORRECTOR;\0A      return 1;\0A    case IPQP_CORRECTOR:\0A      // Complete predictor step\0A      if (d->status == IPQP_SOLVE_ERROR) break;\0A      casadi_ipqp_corrector(d);\0A      d->task = IPQP_MV;\0A      d->next = IPQP_RESIDUAL;\0A      return 1;\0A    default:\0A      break;\0A  }\0A  // Done iterating\0A  d->next = IPQP_RESET;\0A  return 0;\0A}\0A// SYMBOL \22ipqp_return_status\22\0Ainline\0Aconst char* casadi_ipqp_return_status(casadi_ipqp_flag_t status) {\0A  switch (status) {\0A    case IPQP_SUCCESS: return \22success\22;\0A    case IPQP_MAX_ITER: return \22Maximum number of iterations reached\22;\0A    case IPQP_NO_SEARCH_DIR: return \22Failed to calculate search direction\22;\0A    case IPQP_MV_ERROR: return \22Matrix-vector evaluation error\22;\0A    case IPQP_FACTOR_ERROR: return \22Linear solver factorization error\22;\0A    case IPQP_SOLVE_ERROR: return \22Linear solver solution error\22;\0A    case IPQP_PROGRESS_ERROR: return \22Printing error\22;\0A  }\0A  return 0;\0A}\0A// SYMBOL \22ipqp_solution\22\0Atemplate<typename T1>\0Avoid casadi_ipqp_solution(casadi_ipqp_data<T1>* d, T1* x, T1* lam_x, T1* lam_a) {\0A  // Local variables\0A  const casadi_ipqp_prob<T1>* p = d->prob;\0A  // Copy solution\0A  casadi_copy(d->z, p->nx, x);\0A  casadi_copy(d->lam, p->nx, lam_x);\0A  casadi_copy(d->lam + p->nx, p->na, lam_a);\0A}\0A// SYMBOL \22ipqp_print_header\22\0Atemplate<typename T1>\0Aint casadi_ipqp_print_header(casadi_ipqp_data<T1>* d, char* buf, size_t buf_sz) {\0A#ifdef CASADI_SNPRINTF\0A  int flag;\0A  // Print to string\0A  flag = CASADI_SNPRINTF(buf, buf_sz, \22%5s %9s %9s %5s %9s %5s \22\0A          \22%9s %5s %9s %4s\22,\0A          \22Iter\22, \22mu\22, \22|pr|\22, \22con\22, \22|du|\22, \22var\22, \22|co|\22, \22con\22,\0A          \22last_tau\22, \22Note\22);\0A  // Check if error\0A  if (flag < 0) {\0A    d->status = IPQP_PROGRESS_ERROR;\0A    return 1;\0A  }\0A#else\0A  if (buf_sz) buf[0] = '\\0';\0A#endif\0A  // Successful return\0A  return 0;\0A}\0A// SYMBOL \22ipqp_print_iteration\22\0Atemplate<typename T1>\0Aint casadi_ipqp_print_iteration(casadi_ipqp_data<T1>* d, char* buf, int buf_sz) {\0A#ifdef CASADI_SNPRINTF\0A  int flag;\0A  // Print iteration data without note