@.str.2 = private unnamed_addr constant [1282 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22copy\22\0Atemplate<typename T1>\0Avoid casadi_copy(const T1* x, casadi_int n, T1* y) {\0A  casadi_int i;\0A  if (y) {\0A    if (x) {\0A      for (i=0; i<n; ++i) *y++ = *x++;\0A    } else {\0A      for (i=0; i<n; ++i) *y++ = 0.;\0A    }\0A  }\0A}\0A\00", align 1
@casadi_copy_str = hidden global ptr @.str.2, align 8
@.str.3 = private unnamed_addr constant [10660 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22nullptr\22 \220\22\0A// SYMBOL \22cvx_house\22\0A/// Computes Householder vector\0A/// beta (output): scalar\0A/// v (input/output): vector of length nv\0A/// Returns 2-norm of v\0A///\0A/// Ref: Golub & Van Loan Alg 5.1.1\0Atemplate<typename T1>\0AT1 casadi_cvx_house(T1* v, T1* beta, casadi_int nv) {\0A  // Local variable\0A  casadi_int i;\0A  T1 v0, sigma, s, v02;\0A  // Calculate norm\0A  v0 = v[0]; // Save v0 (overwritten below)\0A  sigma=0;\0A  for (i=1; i<nv; ++i) sigma += v[i]*v[i];\0A  s = sqrt(v0*v0 + sigma); // s = norm(v)\0A  if (sigma==0) {\0A    // Note: third edition has *beta = 0\0A    // Note: fourth edition has *beta = -2*(v0<0)\0A    *beta = 2*(v0<0);\0A    v[0] = 1;\0A  } else {\0A    if (v0<=0) {\0A      v0 = v0 - s;\0A    } else {\0A      v0 = -sigma/(v0+s);\0A    }\0A    v02 = v0*v0;\0A    *beta = 2*v02/(sigma+v02);\0A    v[0] = 1;\0A    for (i=1;i<nv;++i) v[i] /= v0;\0A  }\0A  return s;\0A}\0A// SYMBOL \22cvx_house_apply_symm\22\0A// Apply householder transform to a symmetric submatrix\0A// on dense A m-by-n matrix\0A//\0A// A is modified in-place\0A//\0A// s : stride\0A//     normally equal to m\0A//     when A is a submatrix of a bigger matrix, set equal to latter's number of rows\0A// v : compact Housholder factorisation (length m)\0A//     First element (always one) is used to store beta\0A// p : length n\0A//\0A// Reference: Golub & Van Loan, Alg. 8.3.1\0Atemplate<typename T1>\0Avoid casadi_cvx_house_apply_symm(casadi_int n, casadi_int k, T1* A, T1* p, T1* v, T1 beta) {\0A  casadi_int i, j, stride, N;\0A  T1 *a;\0A  stride = k+1;\0A  A+= k+1+n*k;\0A  N = n-k-1;\0A  // p <- beta * A(k+1:n,k+1:n) v\0A  casadi_clear(p, N);\0A  a = A+n;\0A  // Loop over columns\0A  for (i=0;i<N;++i) {\0A    p[i] += beta*(*a++)*v[i];\0A    // Loop over rows\0A    for (j=i+1;j<N;++j) {\0A      p[j] += beta*(*a)*v[i];\0A      p[i] += beta*(*a++)*v[j];\0A    }\0A    a += stride+i+1;\0A  }\0A  // p <- p - (beta p'v/2) v\0A  casadi_axpy(N, -beta*casadi_dot(N, p, v)/2, v, p);\0A  // Rank-2 update\0A  a = A+n;\0A  // Loop over columns\0A  for (i=0;i<N;++i) {\0A    *a++ -= 2*v[i]*p[i];\0A    // Loop over rows\0A    for (j=i+1;j<N;++j) {\0A      *a++ -= v[i]*p[j]+v[j]*p[i];\0A    }\0A    a += stride+i+1;\0A  }\0A}\0A// SYMBOL \22cvx_tri\22\0A// Tri-diagonalize a symmetric matrix in-place\0A// Results are in lower-triangular part\0A//\0A// Upper triangular part contains compact Housholder factorisations\0A//\0A// A: n-by-n dense\0A// p: work vector; length n\0A//\0A// Reference: Golub & Van Loan, Alg. 8.3.1\0Atemplate<typename T1>\0Avoid casadi_cvx_tri(T1* A, casadi_int n, T1* beta, T1* p) {\0A  T1 pp[1000];\0A  casadi_int k, N;\0A  T1 *A_base, *v;\0A  for (k=0;k<n-2;++k) {\0A    A_base = A+k+1+n*k; // A(k+1)\0A    N = n-k-1;\0A    v = A+N*n;\0A    // Compute Householder transformation\0A    casadi_copy(A_base, N, v);\0A    // Assign 2-norm\0A    *A_base = casadi_cvx_house(v, &beta[k], N);\0A    casadi_cvx_house_apply_symm(n, k, A, pp, v, beta[k]);\0A  }\0A}\0A// SYMBOL \22cvx_givens\22\0A// Ref: Golub & Van Loan Alg. 5.1.3\0Atemplate<typename T1>\0Avoid casadi_cvx_givens(T1 a, T1 b, T1* c, T1* s) {\0A  T1 r;\0A  if (b==0) {\0A    *c = 1;\0A    *s = 0;\0A  } else {\0A    if (fabs(b)>fabs(a)) {\0A      r = -a/b;\0A      *s = 1/sqrt(1+r*r);\0A      *c = (*s)*r;\0A    } else {\0A      r = -b/a;\0A      *c = 1/sqrt(1+r*r);\0A      *s = (*c)*r;\0A    }\0A  }\0A}\0A// SYMBOL \22cvx_implicit_qr\22\0A// Implicit Symmetric QR step with Wilkinson shift\0A//\0A// Tri-diagonal n-by-n matrix\0A// Diagonal: t_diag (length n)\0A// Off-diagonal: t_off (length n-1)\0A// cs: [c0 s0 c1 s1 ...] length 2*(n-1)\0A// Golub & Van Loan Alg. 8.3.2\0Atemplate<typename T1>\0Avoid casadi_cvx_implicit_qr(casadi_int n, T1* t_diag, T1* t_off, T1* cs) {\0A  T1 d, mu, to2, x, z, c, s, t1, t2, d0, d1, o0, o1, sd;\0A  casadi_int i;\0A  d = 0.5*(t_diag[n-2]-t_diag[n-1]);\0A  to2 = t_off[n-2]*t_off[n-2];\0A  sd = 1;\0A  if (d<0) sd = -1;\0A  mu = t_diag[n-1]-to2/(d+sd*sqrt(d*d+to2));\0A  x = t_diag[0]-mu;\0A  z = t_off[0];\0A  for (i=0;i<n-1;++i) {\0A    // Compute Givens transformation\0A    casadi_cvx_givens(x, z, &c, &s);\0A    // T = G'TG (worked out with scalars)\0A    d0 = t_diag[i];\0A    d1 = t_diag[i+1];\0A    o0 = t_off[i];\0A    o1 = t_off[i+1];\0A    t1 = d0*c-o0*s;\0A    t2 = o0*c-d1*s;\0A    t_diag[i]   = c*t1-s*t2;\0A    t_off[i]    = s*t1+c*t2;\0A    t_diag[i+1] = d0*s*s+2*s*o0*c+d1*c*c;\0A    t_off[i+1] *= c;\0A    if (i>0) {\0A      t_off[i-1] = t_off[i-1]*c-z*s;\0A    }\0A    x = t_off[i];\0A    z = -s*o1;\0A    if (cs) {\0A      *cs++ = c;\0A      *cs++ = s;\0A    }\0A  }\0A}\0A// SYMBOL \22cvx_symm_schur\22\0A// Eigen-decomposition Q'TQ = D\0A// T tri-diagonal, with:\0A//   - t_diag the diagonal vector (length n)\0A//   - t_off the off-diagonal vector (length n-1)\0A//\0A// Eigenvalues can be read from returned t_diag\0A//\0A// tolerance greater than machine precision\0A//\0A// trace_meta: length 1+3*n_iter\0A// trace: length 2*(n-1)*n_iter\0A//\0A/// Golub & Van Loan Alg. 8.3.3\0Atemplate<typename T1>\0Aint casadi_cvx_symm_schur(casadi_int n, T1* t_diag, T1* t_off, T1 tol, casadi_int max_iter,\0A    casadi_int* trace_meta, T1* trace) {\0A  casadi_int i, p, q, sp, sq, trace_offset, nn;\0A  casadi_int* n_iter;\0A  n_iter = trace_meta++;\0A  trace_offset = 0;\0A  q = 0;\0A  *n_iter = 0;\0A  while (q<n) {\0A    if (*n_iter==max_iter) return 1;\0A    // Clip converged entries\0A    for (i=0;i<n-1;++i) {\0A      if (fabs(t_off[i])<=tol*(fabs(t_diag[i])+fabs(t_diag[i+1]))) {\0A        t_off[i] = 0;\0A      }\0A    }\0A    // Determine p, q\0A    p = 0;\0A    q = 0;\0A    sp = 0;\0A    sq = 0;\0A    for (i=0;i<n-1;++i) {\0A      if (t_off[n-i-2]==0 && sq==0) {\0A        q++;\0A      } else {\0A        sq = 1;\0A      }\0A      if (t_off[i]==0 && sp==0) {\0A        p++;\0A      } else {\0A        sp = 1;\0A      }\0A      if (q==n-1) {\0A        q = n;\0A        p = 0;\0A      }\0A    }\0A    nn = n-q-p;\0A    if (q<n) {\0A      casadi_cvx_implicit_qr(nn, t_diag+p, t_off+p, trace ? trace+trace_offset : nullptr);\0A      trace_offset += 2*(nn-1);\0A      if (trace_meta) {\0A        *trace_meta++ = nn;\0A        *trace_meta++ = p;\0A        *trace_meta++ = trace_offset;\0A      }\0A      (*n_iter)++;\0A    }\0A  }\0A  return 0;\0A}\0A// SYMBOL \22cvx_givens_apply\22\0Atemplate<typename T1>\0Avoid casadi_cvx_givens_apply(casadi_int n, T1* q, T1 c, T1 s, casadi_int p) {\0A  T1 t1, t2, t3, t4, a, b;\0A  casadi_int i;\0A  // Update rows\0A  T1 *m = q;\0A  m += p;\0A  for (i=0;i<p;++i) {\0A    a = m[0];\0A    b = m[1];\0A    m[0] = c*a+s*b;\0A    m[1] = c*b-s*a;\0A    m+=n;\0A  }\0A  // Update central patch\0A  t1 = c*m[0]+s*m[1];\0A  t2 = c*m[1]+s*m[n+1];\0A  t3 = c*m[1]-s*m[0];\0A  t4 = c*m[n+1]-s*m[1];\0A  m[0] = c*t1+s*t2;\0A  m[1] = c*t2-s*t1;\0A  m[n+1] = c*t4-s*t3;\0A  // Update columns\0A  m = q+n*p+p+2;\0A  for (i=0;i<n-p-2;++i) {\0A    a = m[0];\0A    b = m[n];\0A    m[0] = c*a+s*b;\0A    m[n] = c*b-s*a;\0A    m++;\0A  }\0A}\0A// SYMBOL \22cvx_house_apply\22\0A/// Apply householder transform\0A/// on dense A m-by-n matrix\0A///\0A/// A is modified in-place\0A///\0A/// s : stride\0A///     normally equal to m\0A///     when A is a submatrix of a bigger matrix, set equal to latter's number of rows\0A/// v : compact Housholder factorisation (length m)\0A///     First element (always one) is used to store beta\0A/// p : length n\0A///\0Atemplate<typename T1>\0Avoid casadi_cvx_house_apply(casadi_int n, casadi_int m, casadi_int s, T1* A,\0A    T1* p, const T1* v, T1 beta) {\0A  casadi_int i, j;\0A  T1 *a;\0A  // pi <- beta Aji vj\0A  casadi_clear(p, n);\0A  a = A;\0A  // Loop over columns\0A  for (i=0;i<n;++i) {\0A    p[i] += beta*a[0];\0A    // Loop over rows\0A    for (j=1;j<m;++j) {\0A      p[i] += beta*a[j]*v[j];\0A    }\0A    a += s;\0A  }\0A  a = A;\0A  // Loop over columns\0A  for (i=0;i<n;++i) {\0A    a[0] -= p[i];\0A    // Loop over rows\0A    for (j=1;j<m;++j) {\0A      a[j] -= v[j]*p[i];\0A    }\0A    a += s;\0A  }\0A}\0Atemplate<typename T1>\0AT1 casadi_cvx_scalar(T1 epsilon, casadi_int reflect, T1 eig) {\0A  return fmax(epsilon, reflect ? fabs(eig) : eig);\0A}\0A// SYMBOL \22cvx\22\0A// Convexify a dense symmetric Hessian\0A//\0A// w real work vector: length max(n,2*(n-1)*n_iter)\0A// iw integer work vector: 1+3*n_iter\0A//\0A// tol:     tolerance for symmetric schur\0A// epsilon: minimum magnitude of eigenvalues\0A// reflect: when nonzero, reflect negative eigenvalues\0Atemplate<typename T1>\0Aint casadi_cvx(casadi_int n, T1 *A, T1 epsilon, T1 tol, casadi_int reflect, casadi_int max_iter,\0A    T1* w, casadi_int* iw) {\0A  casadi_int i, j, k, n_iter, nn, p, trace_offset;\0A  casadi_int *t_meta;\0A  T1 c, s, t_off0;\0A  T1 *cs, *t_diag, *t_off;\0A  T1 beta[100];\0A  // Short-circuit for empty matrices\0A  if (n==0) return 0;\0A  // Short-circuit for scalar matrices\0A  if (n==1) {\0A    A[0] = casadi_cvx_scalar(epsilon, reflect, A[0]);\0A    return 0;\0A  }\0A  casadi_cvx_tri(A, n, beta, w);\0A  for (i=0;i<n;++i) {\0A    for (j=0;j<n;++j) {\0A      if (i-j>=2) {\0A        A[i+j*n] = 0;\0A      }\0A    }\0A  }\0A  // Represent tri-diagonal as vector pair (t_diag, t_off)\0A  t_off0 = A[1];\0A  t_diag = A;\0A  t_off = A+n;\0A  for (i=1;i<n;++i) {\0A    t_diag[i] = A[i+n*i];\0A  }\0A  t_off[0] = t_off0;\0A  for (i=1;i<n-1;++i) {\0A    t_off[i] = A[i+1+n*i];\0A  }\0A  // Diagonalize matrix by Symmetric QR\0A  if (casadi_cvx_symm_schur(n, t_diag, t_off, tol, max_iter, iw, w)) return 1;\0A  // Retain diagonals (eigenvalues)\0A  for (i=0;i<n;++i) {\0A    A[i+n*i] = casadi_cvx_scalar(epsilon, reflect, t_diag[i]);\0A  }\0A  // Reset other elements\0A  for (i=0;i<n;++i) {\0A    for (j=i+1;j<n;++j) A[j+i*n] = 0;\0A  }\0A  // Undo Symmetric QR\0A  n_iter = iw[0];\0A  t_meta = iw+3*(n_iter-1)+1;\0A  for (i=0;i<n_iter;++i) {\0A    nn = *t_meta++;\0A    p = *t_meta++;\0A    trace_offset = *t_meta++;\0A    cs = w+trace_offset;\0A    t_meta-= 6;\0A    for (j=0;j<nn-1;j++) {\0A      s = *--cs;\0A      c = *--cs;\0A      casadi_cvx_givens_apply(n, A, c, s, p+nn-j-2);\0A    }\0A  }\0A  // Undo triangularization\0A  for (k = n-3; k>=0; --k) {\0A    casadi_int N = n-k-1;\0A    T1 *v = A+N*n;\0A    casadi_cvx_house_apply_symm(n, k, A, w, v, beta[k]);\0A    casadi_cvx_house_apply(k+1, N, n, A+k+1, w, v, beta[k]);\0A  }\0A  return 0;\0A}\0A\00", align 1
@casadi_cvx_str = hidden global ptr @.str.3, align 8
@.str.4 = private unnamed_addr constant [1574 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22de_boor\22\0Atemplate<typename T1>\0Avoid casadi_de_boor(T1 x, const T1* knots, casadi_int n_knots, casadi_int degree, T1* boor) {\0A  // length boor: n_knots-1\0A  casadi_int d, i;\0A  for (d=1;d<degree+1;++d) {\0A    for (i=0;i<n_knots-d-1;++i) {\0A      T1 b, bottom;\0A      b = 0;\0A      bottom = knots[i + d] - knots[i];\0A      if (bottom) b = (x - knots[i]) * boor[i] / bottom;\0A      bottom = knots[i + d + 1] - knots[i + 1];\0A      if (bottom) b += (knots[i + d + 1] - x) * boor[i + 1] / bottom;\0A      boor[i] = b;\0A    }\0A  }\0A}\0A\00", align 1
@casadi_de_boor_str = hidden global ptr @.str.4, align 8
@.str.5 = private unnamed_addr constant [1875 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22densify\22\0Atemplate<typename T1, typename T2>\0Avoid casadi_densify(const T1* x, const casadi_int* sp_x, T2* y, casadi_int tr) {\0A  casadi_int nrow_x, ncol_x, i, el;\0A  const casadi_int *colind_x, *row_x;\0A  // Quick return - output ignored\0A  if (!y) return;\0A  nrow_x = sp_x[0]; ncol_x = sp_x[1];\0A  colind_x = sp_x+2; row_x = sp_x+ncol_x+3;\0A  // Zero out return value\0A  casadi_clear(y, nrow_x*ncol_x);\0A  // Quick return - input is zero\0A  if (!x) return;\0A  // Copy nonzeros\0A  if (tr) {\0A    for (i=0; i<ncol_x; ++i) {\0A      for (el=colind_x[i]; el!=colind_x[i+1]; ++el) {\0A        y[i + row_x[el]*ncol_x] = CASADI_CAST(T2, *x++);\0A      }\0A    }\0A  } else {\0A    for (i=0; i<ncol_x; ++i) {\0A      for (el=colind_x[i]; el!=colind_x[i+1]; ++el) {\0A        y[row_x[el]] = CASADI_CAST(T2, *x++);\0A      }\0A      y += nrow_x;\0A    }\0A  }\0A}\0A\00", align 1
