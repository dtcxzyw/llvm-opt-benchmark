@.str.35 = private unnamed_addr constant [3927 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22nd_boor_dual_eval\22\0Atemplate<typename T1>\0Acasadi_int casadi_nd_boor_dual_eval(T1* val, casadi_int* nz, casadi_int n_dims, const T1* all_knots, const casadi_int* offset, const casadi_int* all_degree, const casadi_int* strides, const T1* all_x, const casadi_int* lookup_mode, casadi_int* iw, T1* w) { // NOLINT(whitespace/line_length)\0A  casadi_int n_iter, k, pivot, nnz;\0A  casadi_int *boor_offset, *starts, *index, *coeff_offset;\0A  T1 *cumprod, *all_boor;\0A  boor_offset = iw; iw+=n_dims+1;\0A  starts = iw; iw+=n_dims;\0A  index = iw; iw+=n_dims;\0A  coeff_offset = iw;\0A  cumprod = w; w+= n_dims+1;\0A  all_boor = w;\0A  boor_offset[0] = 0;\0A  cumprod[n_dims] = 1;\0A  coeff_offset[n_dims] = 0;\0A  nnz = 0;\0A  n_iter = 1;\0A  for (k=0;k<n_dims;++k) {\0A    T1 *boor;\0A    const T1* knots;\0A    T1 x;\0A    casadi_int degree, n_knots, n_b, L, start;\0A    boor = all_boor+boor_offset[k];\0A    degree = all_degree[k];\0A    knots = all_knots + offset[k];\0A    n_knots = offset[k+1]-offset[k];\0A    n_b = n_knots-degree-1;\0A    x = all_x[k];\0A    L = casadi_low(x, knots+degree, n_knots-2*degree, lookup_mode[k]);\0A    start = L;\0A    if (start>n_b-degree-1) start = n_b-degree-1;\0A    starts[k] = start;\0A    casadi_clear(boor, 2*degree+1);\0A    if (x>=knots[0] && x<=knots[n_knots-1]) {\0A      if (x==knots[1]) {\0A        casadi_fill(boor, degree+1, 1.0);\0A      } else if (x==knots[n_knots-1]) {\0A        boor[degree] = 1;\0A      } else if (knots[L+degree]==x) {\0A        boor[degree-1] = 1;\0A      } else {\0A        boor[degree] = 1;\0A      }\0A    }\0A    casadi_de_boor(x, knots+start, 2*degree+2, degree, boor);\0A    boor+= degree+1;\0A    n_iter*= degree+1;\0A    boor_offset[k+1] = boor_offset[k] + degree+1;\0A  }\0A  casadi_clear_casadi_int(index, n_dims);\0A  // Prepare cumulative product\0A  for (pivot=n_dims-1;pivot>=0;--pivot) {\0A    cumprod[pivot] = (*(all_boor+boor_offset[pivot]))*cumprod[pivot+1];\0A    coeff_offset[pivot] = starts[pivot]*strides[pivot]+coeff_offset[pivot+1];\0A  }\0A  for (k=0;k<n_iter;++k) {\0A    casadi_int pivot = 0;\0A    // accumulate result\0A    nz[nnz] = coeff_offset[0];\0A    val[nnz++] += cumprod[0];\0A    // Increment index\0A    index[0]++;\0A    // Handle index overflow\0A    {\0A      // increment next index (forward)\0A      while (index[pivot]==boor_offset[pivot+1]-boor_offset[pivot]) {\0A        index[pivot] = 0;\0A        if (pivot==n_dims-1) break;\0A        index[++pivot]++;\0A      }\0A      // update cumulative structures (reverse)\0A      while (pivot>0) {\0A        // Compute product\0A        cumprod[pivot] = (*(all_boor+boor_offset[pivot]+index[pivot]))*cumprod[pivot+1];\0A        // Compute offset\0A        coeff_offset[pivot] = (starts[pivot]+index[pivot])*strides[pivot]+coeff_offset[pivot+1];\0A        pivot--;\0A      }\0A    }\0A    // Compute product\0A    cumprod[0] = (*(all_boor+index[0]))*cumprod[1];\0A    // Compute offset\0A    coeff_offset[0] = starts[0]+index[0]+coeff_offset[1];\0A  }\0A  return nnz;\0A}\0A\00", align 1
