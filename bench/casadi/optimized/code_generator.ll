@.str.68 = private unnamed_addr constant [1493 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22logsumexp\22\0Atemplate<typename T1>\0AT1 casadi_logsumexp(const T1* x, casadi_int n) {\0A  casadi_int i, max_ind;\0A  T1 max, r;\0A  if (n==1) return x[0];\0A  max_ind = 0;\0A  max = x[0];\0A  // Determine max, argmax\0A  for (i=1; i<n; ++i) {\0A    if (x[i]>x[0]) {\0A      max = x[i];\0A      max_ind = i;\0A    }\0A  }\0A  r = 0;\0A  for (i=0; i<n; ++i) {\0A    if (i!=max_ind) r += exp(x[i]-max);\0A  }\0A  // C-REPLACE \22log1p\22 \22casadi_log1p\22\0A  return log1p(r)+max;\0A}\0A\00", align 1
