@.str.30 = private unnamed_addr constant [1806 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22mv\22\0Atemplate<typename T1>\0Avoid casadi_mv(const T1* x, const casadi_int* sp_x, const T1* y, T1* z, casadi_int tr) {\0A  casadi_int ncol_x, i, el;\0A  const casadi_int *colind_x, *row_x;\0A  if (!x || !y || !z) return;\0A  // Get sparsities\0A  ncol_x = sp_x[1];\0A  colind_x = sp_x+2; row_x = sp_x + 2 + ncol_x+1;\0A  if (tr) {\0A    // loop over the columns of x\0A    for (i=0; i<ncol_x; ++i) {\0A      // loop over the non-zeros of x\0A      for (el=colind_x[i]; el<colind_x[i+1]; ++el) {\0A        z[i] += x[el] * y[row_x[el]];\0A      }\0A    }\0A  } else {\0A    // loop over the columns of x\0A    for (i=0; i<ncol_x; ++i) {\0A      // loop over the non-zeros of x\0A      for (el=colind_x[i]; el<colind_x[i+1]; ++el) {\0A        z[row_x[el]] += x[el] * y[i];\0A      }\0A    }\0A  }\0A}\0A\00", align 1
