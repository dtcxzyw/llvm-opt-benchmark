@.str.45 = private unnamed_addr constant [1600 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22rank1\22\0Atemplate<typename T1>\0Avoid casadi_rank1(T1* A, const casadi_int* sp_A, T1 alpha, const T1* x, const T1* y) {\0A  casadi_int ncol_A, cc, rr, el;\0A  const casadi_int *colind_A, *row_A;\0A  // Get sparsities\0A  ncol_A = sp_A[1];\0A  colind_A = sp_A+2; row_A = sp_A + 2 + ncol_A+1;\0A  // Loop over the columns of A\0A  for (cc=0; cc<ncol_A; ++cc) {\0A    // Loop over the nonzeros of A\0A    for (el=colind_A[cc]; el<colind_A[cc+1]; ++el) {\0A      // Get row\0A      rr = row_A[el];\0A      // Add the multiple\0A      A[el] += alpha*x[rr]*y[cc];\0A    }\0A  }\0A}\0A\00", align 1
