_d0, &boor1_d1, &boor1_d2, &boor1_d3);\0A  simde__m256d C[4];\0A  for (int j=0;j<4;++j) {\0A    C[j] = simde_mm256_loadu_pd(c+(starts[1]+j)*stride1+starts[0]);\0A  }\0A  simde__m256d a, b0, b1, b2, b3, c0, c1, c2, c3, r;\0A  simde__m256d ab[4];\0A  simde__m128d r0, r1;\0A  a = boor0_d0;\0A  b0 = simde_mm256_permute4x64_pd(boor1_d0, SIMDE_MM_SHUFFLE(0, 0, 0, 0));\0A  b1 = simde_mm256_permute4x64_pd(boor1_d0, SIMDE_MM_SHUFFLE(1, 1, 1, 1));\0A  b2 = simde_mm256_permute4x64_pd(boor1_d0, SIMDE_MM_SHUFFLE(2, 2, 2, 2));\0A  b3 = simde_mm256_permute4x64_pd(boor1_d0, SIMDE_MM_SHUFFLE(3, 3, 3, 3));\0A  // Need to compute sum_ab C_ab A_a B_b\0A  // Step 1: Outer product a b: A_a B_b\0A  ab[0] = simde_mm256_mul_pd(a, b0);\0A  ab[1] = simde_mm256_mul_pd(a, b1);\0A  ab[2] = simde_mm256_mul_pd(a, b2);\0A  ab[3] = simde_mm256_mul_pd(a, b3);\0A  // Sum over b axis: sum_b C_ab * (A_a B_b)_b\0A  // r <- r + ab[i]*C[i]\0A  r = simde_mm256_set1_pd(0);\0A  r = simde_mm256_fmadd_pd(ab[0], C[0], r);\0A  r = simde_mm256_fmadd_pd(ab[1], C[1], r);\0A  r = simde_mm256_fmadd_pd(ab[2], C[2], r);\0A  r = simde_mm256_fmadd_pd(ab[3], C[3], r);\0A  if (f) {\0A    // Sum all cab entries\0A    r0  = simde_mm256_castpd256_pd128(r);\0A    r1 = simde_mm256_extractf128_pd(r, 1);\0A    r0  = simde_mm_add_pd(r0, r1);\0A    f[0] = simde_mm_cvtsd_f64(simde_mm_add_sd(r0, simde_mm_unpackhi_pd(r0, r0)));\0A  }\0A  // First derivative\0A  if (dc && J) {\0A    stride1 = offset[1]-offset[0]-4-1;\0A    for (int j=0;j<4;++j) {\0A      C[j] = simde_mm256_loadu_pd(dc+(starts[1]+j)*stride1+starts[0]-1);\0A    }\0A    dc += stride1*(offset[2]-offset[1]-4);\0A    a = boor0_d1;\0A    ab[0] = simde_mm256_mul_pd(a, b0);\0A    ab[1] = simde_mm256_mul_pd(a, b1);\0A    ab[2] = simde_mm256_mul_pd(a, b2);\0A    ab[3] = simde_mm256_mul_pd(a, b3);\0A    // Sum over b axis: sum_b C_abc * (A_a B_b)_b\0A    // cab <- cab + ab[i]*C[i]\0A    r = simde_mm256_set1_pd(0);\0A    r = simde_mm256_fmadd_pd(ab[0], C[0], r);\0A    r = simde_mm25