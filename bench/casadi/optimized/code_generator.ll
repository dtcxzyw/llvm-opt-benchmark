@.str.73 = private unnamed_addr constant [13989 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0Atypedef struct {\0A  // Name of instance\0A  const char* instance_name;\0A  // Value for all variables\0A  double v[SZ_MEM];\0A  // Value for derivatives\0A  double d[SZ_MEM];\0A  // Has any variable been set since last call\0A  int up_to_date;\0A  // Buffers for evaluation generated code\0A  double t;\0A  double p[N_P];\0A  double x[N_X];\0A  double xdot[N_X];\0A  double u[N_U];\0A  double y[N_Y];\0A  // Buffers for derivative calculations\0A  double dp[N_P];\0A  double dx[N_X];\0A  double dxdot[N_X];\0A  double du[N_U];\0A  double dy[N_Y];\0A  // Work vectors for evaluation\0A  const double* arg[SZ_ARG];\0A  double* res[SZ_RES];\0A  casadi_int iw[SZ_IW];\0A  double w[SZ_W];\0A} casadi_fmi_memory;\0Aint evaluate(casadi_fmi_memory* m) {\0A  // Local variables\0A  size_t i;\0A  int mem, flag;\0A  // Copy states, inputs and parameters to inpu