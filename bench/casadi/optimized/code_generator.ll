@.str.53 = private unnamed_addr constant [3753 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22ldl\22\0A// Calculate the nonzeros of the transposed L factor (strictly lower entries only)\0A// as well as D for an LDL^T factorization\0A// len[w] >= n\0Atemplate<typename T1>\0Avoid casadi_ldl(const casadi_int* sp_a, const T1* a,\0A                const casadi_int* sp_lt, T1* lt, T1* d, const casadi_int* p, T1* w) {\0A  const casadi_int *lt_colind, *lt_row, *a_colind, *a_row;\0A  casadi_int n, r, c, c1, k, k2;\0A  // Extract sparsities\0A  n=sp_lt[1];\0A  lt_colind=sp_lt+2; lt_row=sp_lt+2+n+1;\0A  a_colind=sp_a+2; a_row=sp_a+2+n+1;\0A  // Clear w\0A  for (r=0; r<n; ++r) w[r] = 0;\0A  // Sparse copy of A to L and D\0A  for (c=0; c<n; ++c) {\0A    c1 = p[c];\0A    for (k=a_colind[c1]; k<a_colind[c1+1]; ++k) w[a_row[k]] = a[k];\0A    for (k=lt_colind[c]; k<lt_colind[c+1]; ++k) lt[k] = w[p[lt_row[k]]];\0A    d[c] = w[p[c]];\0A    for (k=a_colind[c1]; k<a_colind[c1+1]; ++k) w[a_row[k]] = 0;\0A  }\0A  // Loop over columns of L\0A  for (c=0; c<n; ++c) {\0A    for (k=lt_colind[c]; k<lt_colind[c+1]; ++k) {\0A      r = lt_row[k];\0A      // Calculate l(r,c) with r<c\0A      for (k2=lt_colind[r]; k2<lt_colind[r+1]; ++k2) {\0A        lt[k] -= lt[k2] * w[lt_row[k2]];\0A      }\0A      w[r] = lt[k];\0A      lt[k] /= d[r];\0A      // Update d(c)\0A      d[c] -= w[r]*lt[k];\0A    }\0A    // Clear w\0A    for (k=lt_colind[c]; k<lt_colind[c+1]; ++k) w[lt_row[k]] = 0;\0A  }\0A}\0A// SYMBOL \22ldl_trs\22\0A// Solve for (I+R) with R an optionally transposed strictly upper triangular matrix.\0Atemplate<typename T1>\0Avoid casadi_ldl_trs(const casadi_int* sp_r, const T1* nz_r, T1* x, casadi_int tr) {\0A  casadi_int ncol, c, k;\0A  const casadi_int *colind, *row;\0A  // Extract sparsity\0A  ncol=sp_r[1];\0A  colind=sp_r+2; row=sp_r+2+ncol+1;\0A  if (tr) {\0A    // Forward substitution\0A    for (c=0; c<ncol; ++c) {\0A      for (k=colind[c]; k<colind[c+1]; ++k) {\0A        x[c] -= nz_r[k]*x[row[k]];\0A      }\0A    }\0A  } else {\0A    // Backward substitution\0A    for (c=ncol-1; c>=0; --c) {\0A      for (k=colind[c+1]-1; k>=colind[c]; --k) {\0A        x[row[k]] -= nz_r[k]*x[c];\0A      }\0A    }\0A  }\0A}\0A// SYMBOL \22ldl_solve\22\0A// Linear solve using an LDL^T factorized linear system\0Atemplate<typename T1>\0Avoid casadi_ldl_solve(T1* x, casadi_int nrhs, const casadi_int* sp_lt, const T1* lt,\0A                      const T1* d, const casadi_int* p, T1* w) {\0A  casadi_int i, k;\0A  casadi_int n = sp_lt[1];\0A  for (k=0; k<nrhs; ++k) {\0A    // P' L D L' P x = b <=> x = P' L' \\ D \\ L \\ P b\0A    // Multiply by P\0A    for (i=0; i<n; ++i) w[i] = x[p[i]];\0A    //  Solve for L\0A    casadi_ldl_trs(sp_lt, lt, w, 1);\0A    // Divide by D\0A    for (i=0; i<n; ++i) w[i] /= d[i];\0A    // Solve for L'\0A    casadi_ldl_trs(sp_lt, lt, w, 0);\0A    // Multiply by P'\0A    for (i=0; i<n; ++i) x[p[i]] = w[i];\0A    // Next rhs\0A    x += n;\0A  }\0A}\0A\00", align 1
