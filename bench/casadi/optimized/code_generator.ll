@.str.22 = private unnamed_addr constant [1491 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22max_viol\22\0Atemplate<typename T1>\0AT1 casadi_max_viol(casadi_int n, const T1* x, const T1* lb, const T1* ub) {\0A  T1 r;\0A  casadi_int i;\0A  const T1 zero = 0;\0A  r = 0;\0A  for (i=0; i<n; ++i) {\0A    T1 x_i, lb_i, ub_i;\0A    x_i = x ? *x++ : zero;\0A    lb_i = lb ? *lb++ : zero;\0A    ub_i = ub ? *ub++ : zero;\0A    // C-REPLACE \22fmax\22 \22casadi_fmax\22\0A    r = fmax(r, fmax(x_i-ub_i, zero));\0A    r = fmax(r, fmax(lb_i-x_i, zero));\0A  }\0A  return r;\0A}\0A\00", align 1
