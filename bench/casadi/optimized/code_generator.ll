1]==0 ? 0 : *p_data;\0A    nnz = sp[ncol];\0A    casadi_fill(y, nnz, v);\0A  } else {\0A    casadi_int tr = 0;\0A    if (nrow!=p_nrow || ncol!=p_ncol) {\0A      tr = nrow==p_ncol && ncol==p_nrow && (nrow==1 || ncol==1);\0A      if (!tr) mexErrMsgIdAndTxt(\22Casadi:RuntimeError\22,\0A                                 \22\\\22from_mex\\\22 failed: Dimension mismatch. \22\0A                                 \22Expected %d-by-%d, got %d-by-%d instead.\22,\0A                                 nrow, ncol, p_nrow, p_ncol);\0A    }\0A    if (is_sparse) {\0A      if (tr) {\0A        for (c=0; c<ncol; ++c)\0A          for (k=colind[c]; k<colind[c+1]; ++k) w[row[k]+c*nrow]=0;\0A        for (c=0; c<p_ncol; ++c)\0A          for (k=Jc[c]; k<(casadi_int) Jc[c+1]; ++k) w[c+Ir[k]*p_ncol] = p_data[k];\0A        for (c=0; c<ncol; ++c)\0A          for (k=colind[c]; k<colind[c+1]; ++k) y[k] = w[row[k]+c*nrow];\0A      } else {\0A        for (c=0; c<ncol; ++c) {\0A          for (k=colind[c]; k<colind[c+1]; ++k) w[row[k]]=0;\0A          for (k=Jc[c]; k<(casadi_int) Jc[c+1]; ++k) w[Ir[k]]=p_data[k];\0A          for (k=colind[c]; k<colind[c+1]; ++k) y[k]=w[row[k]];\0A        }\0A      }\0A    } else {\0A      for (c=0; c<ncol; ++c) {\0A        for (k=colind[c]; k<colind[c+1]; ++k) {\0A          y[k] = p_data[row[k]+c*nrow];\0A        }\0A      }\0A    }\0A  }\0A  return y;\0A}\0A\00", align 1
