@.str.21 = private unnamed_addr constant [2118 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22low\22\0Atemplate<typename T1>\0Acasadi_int casadi_low(T1 x, const T1* grid, casadi_int ng, casadi_int lookup_mode) {\0A  switch (lookup_mode) {\0A    case 1:\0A      {\0A        T1 g0, dg;\0A        casadi_int ret;\0A        g0 = grid[0];\0A        dg = grid[ng-1]-g0;\0A        ret = (casadi_int) ((x-g0)*(ng-1)/dg); // NOLINT(readability/casting)\0A        if (ret<0) ret=0;\0A        if (ret>ng-2) ret=ng-2;\0A        return ret;\0A      }\0A    case 2:\0A      {\0A        casadi_int start, stop, pivot;\0A        // Quick return\0A        if (ng<2 || x<grid[1]) return 0;\0A        if (x>grid[ng-1]) return ng-2;\0A        start = 0;\0A        stop  = ng-1;\0A        while (1) {\0A          pivot = (stop+start)/2;\0A          if (x < grid[pivot]) {\0A            if (pivot==stop) return pivot;\0A            stop = pivot;\0A          } else {\0A            if (pivot==start) return pivot;\0A            start = pivot;\0A          }\0A        }\0A      }\0A    default: // linear\0A      {\0A        casadi_int i;\0A        for (i=0; i<ng-2; ++i) {\0A          if (x < grid[i+1]) break;\0A        }\0A        return i;\0A      }\0A  }\0A}\0A\00", align 1
