l_prob\22\0A// SYMBOL \22nlpsol_detect_bounds_data\22\0Atemplate<typename T1>\0Astruct casadi_nlpsol_detect_bounds_data {\0A  // Work vectors\0A  const T1** arg;\0A  T1** res;\0A  casadi_int* iw;\0A  T1* w;\0A  // Simple bounds g(x)=A(b)x+b(p);\0A  // a[i]*x[target_x[i]]+b[i]\0A  T1* a;\0A  T1* b;\0A  casadi_int* target_l;\0A  casadi_int* target_u;\0A  T1* lam_xl;\0A  T1* lam_xu;\0A};\0A// C-REPLACE \22casadi_nlpsol_detect_bounds_data<T1>\22 \22struct casadi_nlpsol_detect_bounds_data\22\0A// C-REPLACE \22casadi_oracle_data<T1>\22 \22struct casadi_oracle_data\22\0A// SYMBOL \22nlpsol_data\22\0Atemplate<typename T1>\0Astruct casadi_nlpsol_data {\0A  // Problem structure\0A  const casadi_nlpsol_prob<T1>* prob;\0A  casadi_oracle_data<T1>* oracle;\0A  // Variable bounds\0A  T1 *lbz, *ubz;\0A  // Current primal solution\0A  T1 *z;\0A  // Current dual solution\0A  T1 *lam;\0A  // Storage for f when null pointer passed\0A  T1 objective;\0A  // NLP data, pointers to arg (no allocations needed)\0A  const T1 *p, *lbx, *ubx, *lbg, *ubg, *x0, *lam_x0, *lam_g0;\0A  // NLP results, pointers to res (no allocations needed)\0A  T1 *f, *x, *g, *lam_x, *lam_g, *lam_p;\0A  casadi_nlpsol_detect_bounds_data<T1> detect_bounds;\0A};\0A// C-REPLACE \22casadi_nlpsol_data<T1>\22 \22struct casadi_nlpsol_data\22\0A// SYMBOL \22nlpsol_work\22\0Atemplate<typename T1>\0Avoid casadi_nlpsol_work(const casadi_nlpsol_prob<T1>* p, casadi_int* sz_arg, casadi_int* sz_res,\0A    casadi_int* sz_iw, casadi_int* sz_w) {\0A  // Reset sz_arg, sz_res\0A  *sz_arg = *sz_res = 0;\0A  // Reset sz_w, sz_iw\0A  *sz_w = *sz_iw = 0;\0A  *sz_w += p->nx + p->ng; // z\0A  *sz_w += p->nx + p->ng; // lbz\0A  *sz_w += p->nx + p->ng; // ubz\0A  *sz_w += p->nx + p->ng; // lam\0A  if (p->detect_bounds.ng) {\0A    *sz_arg += p->detect_bounds.sz_arg;\0A    *sz_res += p->detect_bounds.sz_res;\0A    *sz_iw += p->detect_bounds.sz_iw;\0A    *sz_w += p->detect_bounds.sz_w;\0A    *sz_w += p->detect_bounds.nb; // a;\0A    *sz_w += p->detect_bounds.nb; // b;\0A    *sz_iw += p->nx; // target_l\0A    *sz_iw += p->nx; // target_u\0A    *sz_w += p->nx; // lam_xl;\0A    *sz_w += p->nx; // lam_xu;\0A  }\0A}\0A// SYMBOL \22nlpsol_init\22\0Atemplate<typename T1>\0Avoid casadi_nlpsol_init(casadi_nlpsol_data<T1>* d, const T1*** arg, T1*** res,\0A    casadi_int** iw, T1** w) {\0A  // Local variables\0A  casadi_int nx, ng;\0A  const casadi_nlpsol_prob<T1>* p = d->prob;\0A  nx = p->nx;\0A  ng = p->ng;\0A  // Get matrix number of nonzeros\0A  d->z = *w; *w += nx + ng;\0A  d->lbz = *w; *w += nx + ng;\0A  d->ubz = *w; *w += nx + ng;\0A  d->lam = *w; *w += nx + ng;\0A  if (p->detect_bounds.ng) {\0A    d->detect_bounds.arg = *arg; *arg += p->detect_bounds.sz_arg;\0A    d->detect_bounds.res = *res; *res += p->detect_bounds.sz_res;\0A    d->detect_bounds.iw = *iw; *iw += p->detect_bounds.sz_iw;\0A    d->detect_bounds.w = *w; *w += p->detect_bounds.sz_w;\0A    d->detect_bounds.a = *w; *w += p->detect_bounds.nb;\0A    d->detect_bounds.b = *w; *w += p->detect_bounds.nb;\0A    d->detect_bounds.target_l = *iw; *iw += p->nx;\0A    d->detect_bounds.target_u = *iw; *iw += p->nx;\0A    d->detect_bounds.lam_xl = *w; *w += nx;\0A    d->detect_bounds.lam_xu = *w; *w += nx;\0A  }\0A}\0A// SYMBOL \22nlpsol_detect_bounds_before\22\0Atemplate<typename T1>\0Aint casadi_detect_bounds_before(casadi_nlpsol_data<T1>* d_nlp) {\0A  const casadi_nlpsol_prob<T1>* p_nlp = d_nlp->prob;\0A  casadi_nlpsol_detect_bounds_data<T1>* d_bounds = &d_nlp->detect_bounds;\0A  const casadi_nlpsol_detect_bounds_prob<T1>* p_bounds = &p_nlp->detect_bounds;\0A  casadi_int nx = p_nlp->nx;\0A  d_bounds->arg[0] = d_nlp->z;\0A  d_bounds->arg[1] = d_nlp->p;\0A  d_bounds->res[0] = d_bounds->a;\0A  d_bounds->res[1] = d_bounds->b;\0A  p_bounds->callback(d_bounds->arg, d_bounds->res,\0A    d_bounds->iw, d_bounds->w, p_bounds->callback_data);\0A  for (casadi_int i=0;i<p_bounds->nb;++i) {\0A    if (d_bounds->a[i]==0) {\0A      casadi_int k = p_bounds->target_g[i];\0A      if (d_nlp->lbg[k]>d_bounds->b[i]) return 1;\0A      if (d_nlp->ubg[k]<d_bounds->b[i]) return 1;\0A    }\0A  }\0A  T1* lbz = d_nlp->lbz+nx;\0A  T1* ubz = d_nlp->ubz+nx;\0A  T1* lam = d_nlp->lam+nx;\0A  for (casadi_int i=0;i<nx;++i) {\0A    d_bounds->lam_xl[i] = d_nlp->lam_x0 ? (d_nlp->lam_x0[i]<0)*d_nlp->lam_x0[i] : 0.;\0A    d_bounds->lam_xu[i] = d_nlp->lam_x0 ? (d_nlp->lam_x0[i]>0)*d_nlp->lam_x0[i] : 0.;\0A  }\0A  for (casadi_int i=0;i<nx;++i) {\0A    d_bounds->target_l[i] = i;\0A    d_bounds->target_u[i] = i;\0A  }\0A  // Update lbz/ubz\0A  casadi_int k=0;\0A  for (casadi_int i=0;i<p_bounds->ng;++i) {\0A    if (p_bounds->is_simple[i]) {\0A      // Update lbz/ubz\0A      T1 lb = (d_nlp->lbg[i]-d_bounds->b[k])/d_bounds->a[k];\0A      T1 ub = (d_nlp->ubg[i]-d_bounds->b[k])/d_bounds->a[k];\0A      if (d_bounds->a[k]<0) {\0A        T1 tmp = lb;\0A        lb = ub;\0A        ub = tmp;\0A      }\0A      casadi_int j = p_bounds->target_x[k];\0A      lb += d_nlp->z[j];\0A      ub += d_nlp->z[j];\0A      if (lb==d_nlp->lbz[j]) {\0A        if (d_nlp->lam_g0) d_bounds->lam_xl[j] += (d_nlp->lam_g0[i]<0)*d_nlp->lam_g0[i];\0A      } else if (lb>d_nlp->lbz[j]) {\0A        d_nlp->lbz[j] = lb;\0A        d_bounds->target_l[j] = nx+i;\0A        if (d_nlp->lam_g0) d_bounds->lam_xl[j] = (d_nlp->lam_g0[i]<0)*d_nlp->lam_g0[i];\0A      }\0A      if (ub==d_nlp->ubz[j]) {\0A        if (d_nlp->lam_g0) d_bounds->lam_xu[j] += (d_nlp->lam_g0[i]>0)*d_nlp->lam_g0[i];\0A      } else if (ub<d_nlp->ubz[j]) {\0A        d_nlp->ubz[j] = ub;\0A        d_bounds->target_u[j] = nx+i;\0A        if (d_nlp->lam_g0) d_bounds->lam_xu[j] = (d_nlp->lam_g0[i]>0)*d_nlp->lam_g0[i];\0A      }\0A      k++;\0A    } else {\0A      // Update lbz/ubz\0A      *lbz++ = d_nlp->lbg[i];\0A      *ubz++ = d_nlp->ubg[i];\0A      if (d_nlp->lam_g0) *lam++ = d_nlp->lam_g0[i];\0A    }\0A  }\0A  for (casadi_int i=0;i<nx;++i) {\0A    d_nlp->lam[i] = d_bounds->lam_xl[i]+d_bounds->lam_xu[i];\0A  }\0A  return 0;\0A}\0A// SYMBOL \22nlpsol_detect_bounds_after\22\0Atemplate<typename T1>\0Aint casadi_detect_bounds_after(casadi_nlpsol_data<T1>* d_nlp) {\0A  const casadi_nlpsol_prob<T1>* p_nlp = d_nlp->prob;\0A  casadi_nlpsol_detect_bounds_data<T1>* d_bounds = &d_nlp->detect_bounds;\0A  const casadi_nlpsol_detect_bounds_prob<T1>* p_bounds = &p_nlp->detect_bounds;\0A  casadi_int nx = p_nlp->nx;\0A  casadi_fill(d_nlp->lam_x, nx, 0.);\0A  casadi_fill(d_nlp->lam_g, p_bounds->ng, 0.);\0A  casadi_int k = 0;\0A  casadi_int k_normal = 0;\0A  for (casadi_int i=0;i<p_bounds->ng;++i) {\0A    if (p_bounds->is_simple[i]) {\0A      casadi_int j = p_bounds->target_x[k];\0A      if (d_nlp->g) {\0A        d_nlp->g[i] = d_bounds->a[k]*d_nlp->z[j]-d_bounds->b[k];\0A        if (d_nlp->x0) d_nlp->g[i] += d_nlp->x0[j];\0A      }\0A      k++;\0A    } else {\0A      if (d_nlp->g) d_nlp->g[i] = d_nlp->z[nx+k_normal];\0A      if (d_nlp->lam_g) d_nlp->lam_g[i] = d_nlp->lam[nx+k_normal];\0A      k_normal++;\0A    }\0A  }\0A  for (casadi_int i=0;i<nx;++i) {\0A    if (d_bounds->target_l[i]<nx) {\0A      if (d_nlp->lam_x) d_nlp->lam_x[i] += (d_nlp->lam[i]<0)*d_nlp->lam[i];\0A    } else {\0A      if (d_nlp->lam_g)\0A        d_nlp->lam_g[d_bounds->target_l[i]-nx] += (d_nlp->lam[i]<0)*d_nlp->lam[i];\0A    }\0A    if (d_bounds->target_u[i]<nx) {\0A      if (d_nlp->lam_x) d_nlp->lam_x[i] += (d_nlp->lam[i]>0)*d_nlp->lam[i];\0A    } else {\0A      if (d_nlp->lam_g)\0A        d_nlp->lam_g[d_bounds->target_u[i]-nx] += (d_nlp->lam[i]>0)*d_nlp->lam[i];\0A    }\0A  }\0A  k = 0;\0A  for (casadi_int i=0;i<p_bounds->ng;++i) {\0A    if (p_bounds->is_simple[i]) {\0A      if (d_nlp->lam_g) d_nlp->lam_g[i] /= d_bounds->a[k];\0A      k++;\0A    }\0A  }\0A  return 0;\0A}\0A\00", align 1
