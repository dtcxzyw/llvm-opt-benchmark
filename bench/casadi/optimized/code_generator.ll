@.str.57 = private unnamed_addr constant [2585 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22kkt\22\0Atemplate<typename T1>\0Avoid casadi_kkt(const casadi_int* sp_kkt, T1* nz_kkt,\0A    const casadi_int* sp_h, const T1* nz_h,\0A    const casadi_int* sp_a, const T1* nz_a,\0A    const T1* S, const T1* D, T1* w, casadi_int* iw) {\0A  // Local variables\0A  casadi_int i, k, j, nx, nz;\0A  const casadi_int *h_colind, *h_row, *a_colind, *a_row,\0A                   *kkt_colind, *kkt_row;\0A  // Extract sparsities\0A  a_row = (a_colind = sp_a + 2) + (nx = sp_a[1]) + 1;\0A  h_row = (h_colind = sp_h + 2) + nx + 1;\0A  kkt_row = (kkt_colind = sp_kkt + 2) + (nz = sp_kkt[1]) + 1;\0A  // Running indices for each row of A\0A  for (i = nx; i < nz; ++i) iw[i - nx] = kkt_colind[i];\0A  // Reset w to zero\0A  casadi_clear(w, nz);\0A  // Loop over columns of [H + D_x; A]\0A  for (i=0; i<nx; ++i) {\0A    // Copy scaled column of H to w\0A    for (k=h_colind[i]; k<h_colind[i+1]; ++k) {\0A      j = h_row[k];\0A      w[j] = nz_h[k] * S[i] * S[j];\0A    }\0A    // Copy scaled column of A to w\0A    for (k=a_colind[i]; k<a_colind[i+1]; ++k) {\0A      j = a_row[k] + nx;\0A      w[j] = nz_a[k] * S[i] * S[j];\0A    }\0A    // Add D_x to diagonal\0A    w[i] += D[i];\0A    // Copy column to KKT\0A    for (k=kkt_colind[i]; k<kkt_colind[i+1]; ++k) {\0A      j = kkt_row[k];\0A      nz_kkt[k] = w[j];\0A      if (j >= nx) nz_kkt[iw[j - nx]++] = w[j];\0A    }\0A    // Zero out w\0A    for (k=h_colind[i]; k<h_colind[i+1]; ++k) w[h_row[k]] = 0;\0A    for (k=a_colind[i]; k<a_colind[i+1]; ++k) w[a_row[k] + nx] = 0;\0A  }\0A  // Copy -D_g to diagonal\0A  for (i=nx; i<nz; ++i) {\0A    nz_kkt[iw[i - nx]++] = -D[i];\0A  }\0A}\0A\00", align 1
