@.str.40 = private unnamed_addr constant [3302 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22norm_inf_mul\22\0Atemplate<typename T1>\0AT1 casadi_norm_inf_mul(const T1* x, const casadi_int* sp_x, const T1* y, const casadi_int* sp_y, T1* dwork, casadi_int* iwork) { // NOLINT(whitespace/line_length)\0A  casadi_int nrow_x, ncol_x, ncol_y, i, jj, kk, nnz;\0A  const casadi_int *colind_x, *row_x, *colind_y, *row_y;\0A  casadi_int *mask, *next;\0A  T1 res = 0;\0A  // Get sparsities\0A  nrow_x = sp_x[0]; ncol_x = sp_x[1];\0A  colind_x = sp_x+2; row_x = sp_x + 2 + ncol_x+1;\0A  ncol_y = sp_y[1];\0A  colind_y = sp_y+2; row_y = sp_y + 2 + ncol_y+1;\0A  // Implementation inspired on Scipy's sparsetools/csr.h\0A  // method that uses O(n) temp storage\0A  mask = iwork + ncol_y+1;\0A  // Pass 1\0A  for (i=0; i<nrow_x; ++i) mask[i] = -1;\0A  iwork[0] = 0;\0A  nnz = 0;\0A  for (i=0; i<ncol_y; ++i) {\0A    casadi_int next_nnz;\0A    casadi_int row_nnz = 0;\0A    for (jj=colind_y[i]; jj < colind_y[i+1]; jj++) {\0A      casadi_int j = row_y[jj];\0A      for (kk=colind_x[j]; kk < colind_x[j+1]; kk++) {\0A        casadi_int k = row_x[kk];\0A        if (mask[k] != i) {\0A          mask[k] = i;\0A          row_nnz++;\0A        }\0A      }\0A    }\0A    next_nnz = nnz + row_nnz;\0A    nnz = next_nnz;\0A    iwork[i+1] = nnz;\0A  }\0A  // Pass 2\0A  next = iwork + ncol_y+1;\0A  for (i=0; i<nrow_x; ++i) next[i] = -1;\0A  T1* sums = dwork;\0A  for (i=0; i<nrow_x; ++i) sums[i] = 0;\0A  nnz = 0;\0A  iwork[0] = 0;\0A  for (i=0; i<ncol_y; ++i) {\0A    casadi_int head, length, jj_start, jj_end;\0A    head   = -2;\0A    length =  0;\0A    jj_start = colind_y[i];\0A    jj_end   = colind_y[i+1];\0A    for (jj=jj_start; jj<jj_end; ++jj) {\0A      casadi_int j, kk_start, kk_end;\0A      T1 v;\0A      j = row_y[jj];\0A      v = y[jj];\0A      kk_start = colind_x[j];\0A      kk_end   = colind_x[j+1];\0A      for (kk = kk_start; kk<kk_end; ++kk) {\0A        casadi_int k = row_x[kk];\0A        sums[k] += v*x[kk];\0A        if (next[k] == -1) {\0A          next[k] = head;\0A          head  = k;\0A          length++;\0A        }\0A      }\0A    }\0A    for (jj=0; jj<length; ++jj) {\0A      casadi_int temp;\0A      if (!is_zero(sums[head])) {\0A        T1 a = fabs(sums[head]);\0A        res = fmax(res, a);\0A        nnz++;\0A      }\0A      temp = head;\0A      head = next[head];\0A      next[temp] = -1; //clear arrays\0A      sums[temp] =  0;\0A    }\0A    iwork[i+1] = nnz;\0A  }\0A  return res;\0A}\0A\00", align 1
