@.str.16 = private unnamed_addr constant [1853 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22interpn\22\0Atemplate<typename T1>\0Avoid casadi_interpn(T1* res, casadi_int ndim, const T1* grid, const casadi_int* offset, const T1* values, const T1* x, const casadi_int* lookup_mode, casadi_int m, casadi_int* iw, T1* w) { // NOLINT(whitespace/line_length)\0A  // Work vectors\0A  T1* alpha;\0A  casadi_int *index, *corner;\0A  alpha = w; w += ndim;\0A  index = iw; iw += ndim;\0A  corner = iw; iw += ndim;\0A  // Left index and fraction of interval\0A  casadi_interpn_weights(ndim, grid, offset, x, alpha, index, lookup_mode);\0A  // Loop over all corners, add contribution to output\0A  casadi_clear_casadi_int(corner, ndim);\0A  casadi_clear(res, m);\0A  do {\0A    T1* coeff = 0;\0A    casadi_interpn_interpolate(res, ndim, offset, values,\0A      alpha, index, corner, coeff, m);\0A  } while (casadi_flip(corner, ndim));\0A}\0A\00", align 1
@casadi_interpn_str = hidden local_unnamed_addr global ptr @.str.16, align 8
@.str.17 = private unnamed_addr constant [2581 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22interpn_grad\22\0Atemplate<typename T1>\0Avoid casadi_interpn_grad(T1* grad, casadi_int ndim, const T1* grid, const casadi_int* offset, const T1* values, const T1* x, const casadi_int* lookup_mode, casadi_int m, casadi_int* iw, T1* w) { // NOLINT(whitespace/line_length)\0A  T1 *alpha, *coeff, *v;\0A  casadi_int *index, *corner;\0A  casadi_int i;\0A  // Quick return\0A  if (!grad) return;\0A  // Work vectors\0A  alpha = w; w += ndim;\0A  coeff = w; w += ndim;\0A  v = w; w+= m;\0A  index = iw; iw += ndim;\0A  corner = iw; iw += ndim;\0A  // Left index and fraction of interval\0A  casadi_interpn_weights(ndim, grid, offset, x, alpha, index, lookup_mode);\0A  // Loop over all corners, add contribution to output\0A  casadi_clear_casadi_int(corner, ndim);\0A  casadi_clear(grad, ndim*m);\0A  do {\0A    casadi_int i, j;\0A    // Get coefficients\0A    casadi_clear(v, m);\0A    casadi_interpn_interpolate(v, ndim, offset, values,\0A      alpha, index, corner, coeff, m);\0A    // Propagate to alpha\0A    for (i=ndim-1; i>=0; --i) {\0A      if (corner[i]) {\0A        for (j=0; j<m; ++j) {\0A          grad[i*m+j] += v[j]*coeff[i];\0A          v[j] *= alpha[i];\0A        }\0A      } else {\0A        for (j=0; j<m; ++j) {\0A          grad[i*m+j] -= v[j]*coeff[i];\0A          v[j] *= 1-alpha[i];\0A        }\0A      }\0A    }\0A  } while (casadi_flip(corner, ndim));\0A  // Propagate to x\0A  for (i=0; i<ndim; ++i) {\0A    casadi_int k, j;\0A    const T1* g;\0A    T1 delta;\0A    g = grid + offset[i];\0A    j = index[i];\0A    delta =  g[j+1]-g[j];\0A    for (k=0;k<m;++k) grad[k] /= delta;\0A    grad += m;\0A  }\0A}\0A\00", align 1
@casadi_interpn_grad_str = hidden local_unnamed_addr global ptr @.str.17, align 8
@.str.18 = private unnamed_addr constant [1773 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22interpn_interpolate\22\0Atemplate<typename T1>\0Avoid casadi_interpn_interpolate(T1* res, casadi_int ndim, const casadi_int* offset, const T1* values, const T1* alpha, const casadi_int* index, const casadi_int* corner, T1* coeff, casadi_int m) { // NOLINT(whitespace/line_length)\0A  T1 c;\0A  casadi_int ld, i;\0A  // Get weight and value for corner\0A  c=1;\0A  ld=1; // leading dimension\0A  for (i=0; i<ndim; ++i) {\0A    if (coeff) *coeff++ = c;\0A    if (corner[i]) {\0A      c *= alpha[i];\0A    } else {\0A      c *= 1-alpha[i];\0A    }\0A    values += (index[i]+corner[i])*ld*m;\0A    ld *= offset[i+1]-offset[i];\0A  }\0A  if (coeff) {\0A    for (i=0;i<m;++i) res[i] += values[i];\0A  } else {\0A    for (i=0;i<m;++i) res[i] += c*values[i];\0A  }\0A}\0A\00", align 1
@casadi_interpn_interpolate_str = hidden local_unnamed_addr global ptr @.str.18, align 8
@.str.19 = private unnamed_addr constant [1713 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22interpn_weights\22\0Atemplate<typename T1>\0Avoid casadi_interpn_weights(casadi_int ndim, const T1* grid, const casadi_int* offset, const T1* x, T1* alpha, casadi_int* index, const casadi_int* lookup_mode) { // NOLINT(whitespace/line_length)\0A  // Left index and fraction of interval\0A  casadi_int i;\0A  for (i=0; i<ndim; ++i) {\0A    casadi_int ng, j;\0A    T1 xi;\0A    const T1* g;\0A    // Grid point\0A    xi = x ? x[i] : 0;\0A    // Grid\0A    g = grid + offset[i];\0A    ng = offset[i+1]-offset[i];\0A    // Find left index\0A    j = index[i] = casadi_low(xi, g, ng, lookup_mode[i]);\0A    // Get interpolation/extrapolation alpha\0A    alpha[i] = (xi-g[j])/(g[j+1]-g[j]);\0A  }\0A}\0A\00", align 1
@casadi_interpn_weights_str = hidden local_unnamed_addr global ptr @.str.19, align 8
@.str.20 = private unnamed_addr constant [1905 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22kron\22\0Atemplate<typename T1>\0Avoid casadi_kron(const T1* a, const casadi_int* sp_a, const T1* b, const casadi_int* sp_b, T1* r) {\0A    casadi_int a_ncol, b_ncol, k;\0A    const casadi_int *a_colind, *b_colind;\0A    T1 a_v, b_v;\0A    k = 0;\0A    a_ncol = sp_a[1];\0A    a_colind = sp_a+2;\0A    b_ncol = sp_b[1];\0A    b_colind = sp_b+2;\0A    // Loop over the columns\0A    for (casadi_int a_cc=0; a_cc<a_ncol; ++a_cc) {\0A      // Loop over the columns\0A      for (casadi_int b_cc=0; b_cc<b_ncol; ++b_cc) {\0A        // Loop over existing nonzeros\0A        for (casadi_int a_el=a_colind[a_cc]; a_el<a_colind[a_cc+1]; ++a_el) {\0A          a_v = a[a_el];\0A          // Loop over existing nonzeros\0A          for (casadi_int b_el=b_colind[b_cc]; b_el<b_colind[b_cc+1]; ++b_el) {\0A            b_v = b[b_el];\0A            r[k++] = a_v*b_v;\0A          }\0A        }\0A      }\0A    }\0A}\0A\00", align 1
