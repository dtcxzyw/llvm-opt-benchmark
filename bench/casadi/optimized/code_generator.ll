@.str.15 = private unnamed_addr constant [1431 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22iamax\22\0Atemplate<typename T1>\0Acasadi_int casadi_iamax(casadi_int n, const T1* x, casadi_int inc_x) {\0A  casadi_int largest_index, i;\0A  T1 t, largest_value;\0A  largest_value = -1.0;\0A  largest_index = -1;\0A  for (i=0; i<n; ++i) {\0A    t = fabs(*x);\0A    x += inc_x;\0A    if (t>largest_value) {\0A      largest_value = t;\0A      largest_index = i;\0A    }\0A  }\0A  return largest_index;\0A}\0A\00", align 1
