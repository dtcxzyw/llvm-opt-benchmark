e, n_knots, n_b, L, start;\0A    boor = all_boor+boor_offset[k];\0A    degree = all_degree[k];\0A    knots = all_knots + offset[k];\0A    n_knots = offset[k+1]-offset[k];\0A    n_b = n_knots-degree-1;\0A    x = all_x[k];\0A    L = casadi_low(x, knots+degree, n_knots-2*degree, lookup_mode[k]);\0A    start = L;\0A    if (start>n_b-degree-1) start = n_b-degree-1;\0A    starts[k] = start;\0A    casadi_clear(boor, 2*degree+1);\0A    if (x>=knots[0] && x<=knots[n_knots-1]) {\0A      if (x==knots[1]) {\0A        casadi_fill(boor, degree+1, 1.0);\0A      } else if (x==knots[n_knots-1]) {\0A        boor[degree] = 1;\0A      } else if (knots[L+degree]==x) {\0A        boor[degree-1] = 1;\0A      } else {\0A        boor[degree] = 1;\0A      }\0A    }\0A    casadi_de_boor(x, knots+start, 2*degree+2, degree, boor);\0A    boor+= degree+1;\0A    n_iter*= degree+1;\0A    boor_offset[k+1] = boor_offset[k] + degree+1;\0A  }\0A  casadi_clear_casadi_int(index, n_dims);\0A  // Prepare cumulative product\0A  for (pivot=n_dims-1;pivot>=0;--pivot) {\0A    cumprod[pivot] = (*(all_boor+boor_offset[pivot]))*cumprod[pivot+1];\0A    coeff_offset[pivot] = starts[pivot]*strides[pivot]+coeff_offset[pivot+1];\0A  }\0A  for (k=0;k<n_iter;++k) {\0A    casadi_int pivot = 0;\0A    // accumulate result\0A    nz[nnz] = coeff_offset[0];\0A    val[nnz++] += cumprod[0];\0A    // Increment index\0A    index[0]++;\0A    // Handle index overflow\0A    {\0A      // increment next index (forward)\0A      while (index[pivot]==boor_offset[pivot+1]-boor_offset[pivot]) {\0A        index[pivot] = 0;\0A        if (pivot==n_dims-1) break;\0A        index[++pivot]++;\0A      }\0A      // update cumulative structures (reverse)\0A      while (pivot>0) {\0A        // Compute product\0A        cumprod[pivot] = (*(all_boor+boor_offset[pivot]+index[pivot]))*cumprod[pivot+1];\0A        // Compute offset\0A        coeff_offset[pivot] = (starts[pivot]+index[pivot])*strides[pivot]+coeff_offset[pivot+1];\0A        pivot--;\0A      }\0A    }\0A    // Compute product\0A    cumprod[0] = (*(all_boor+index[0]))*cumprod[1];\0A    // Compute offset\0A    coeff_offset[0] = starts[0]+index[0]+coeff_offset[1];\0A  }\0A  return nnz;\0A}\0A\00", align 1
