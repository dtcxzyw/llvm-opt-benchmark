@.str.42 = private unnamed_addr constant [1830 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22project\22\0Atemplate<typename T1>\0Avoid casadi_project(const T1* x, const casadi_int* sp_x, T1* y, const casadi_int* sp_y, T1* w) {\0A  // x and y should be distinct\0A  casadi_int ncol_x, ncol_y, i, el;\0A  const casadi_int *colind_x, *row_x, *colind_y, *row_y;\0A  ncol_x = sp_x[1];\0A  colind_x = sp_x+2; row_x = sp_x + 2 + ncol_x+1;\0A  ncol_y = sp_y[1];\0A  colind_y = sp_y+2; row_y = sp_y + 2 + ncol_y+1;\0A  // Loop over columns of x and y\0A  for (i=0; i<ncol_x; ++i) {\0A    // Zero out requested entries in y\0A    for (el=colind_y[i]; el<colind_y[i+1]; ++el) w[row_y[el]] = 0;\0A    // Set x entries\0A    for (el=colind_x[i]; el<colind_x[i+1]; ++el) w[row_x[el]] = x[el];\0A    // Retrieve requested entries in y\0A    for (el=colind_y[i]; el<colind_y[i+1]; ++el) y[el] = w[row_y[el]];\0A  }\0A}\0A\00", align 1
