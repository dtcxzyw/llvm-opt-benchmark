@.str.64 = private unnamed_addr constant [2093 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// C-REPLACE \22fmin\22 \22casadi_fmin\22\0A// C-REPLACE \22std::isinf\22 \22casadi_isinf\22\0A// SYMBOL \22bound_consistency\22\0Atemplate<typename T1>\0Avoid casadi_bound_consistency(casadi_int n, T1* x, T1* lam,\0A                                 const T1* lbx, const T1* ubx) {\0A    // Local variables\0A    casadi_int i;\0A    T1 lb, ub;\0A    // Loop over variables\0A    for (i=0; i<n; ++i) {\0A      // Get bounds\0A      lb = lbx ? lbx[i] : 0.;\0A      ub = ubx ? ubx[i] : 0.;\0A      // Make sure bounds are respected\0A      x[i] = fmin(fmax(x[i], lb), ub);\0A      // Adjust multipliers\0A      if (std::isinf(lb) && std::isinf(ub)) {\0A        // Both multipliers are infinite\0A        lam[i] = 0.;\0A      } else if (std::isinf(lb) || x[i] - lb > ub - x[i]) {\0A        // Infinite lower bound or closer to upper bound than lower bound\0A        lam[i] = fmax(0., lam[i]);\0A      } else if (std::isinf(ub) || x[i] - lb < ub - x[i]) {\0A        // Infinite upper bound or closer to lower bound than upper bound\0A        lam[i] = fmin(0., lam[i]);\0A      }\0A    }\0A}\0A\00", align 1
@casadi_bound_consistency_str = hidden local_unnamed_addr global ptr @.str.64, align 8
@.str.65 = private unnamed_addr constant [7739 x i8] c"// C-REPLACE \22fabs\22 \22casadi_fabs\22\0A// C-REPLACE \22sign\22 \22casadi_sign\22\0A//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22lsqr_sym_ortho\22\0Atemplate<typename T1>\0Avoid casadi_lsqr_sym_ortho(T1 a, T1 b, T1* cs, T1* sn, T1* rho) {\0A    T1 tau;\0A    if (b == 0) {\0A        *cs = sign(a);\0A        *sn = 0;\0A        *rho = fabs(a);\0A    } else if (a==0) {\0A        *cs = 0;\0A        *sn = sign(b);\0A        *rho = fabs(b);\0A    } else if (fabs(b)>fabs(a)) {\0A        tau = a/b;\0A        *sn = sign(b)/sqrt(1+tau*tau);\0A        *cs = (*sn)*tau;\0A        *rho = b/(*sn);\0A    } else {\0A        tau = b/a;\0A        *cs = sign(a)/sqrt(1+tau*tau);\0A        *sn = (*cs)*tau;\0A        *rho = a/(*cs);\0A    }\0A}\0A//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22lsqr_single_solve\22\0A// Ref: scipy\0Atemplate<typename T1>\0Aint casadi_lsqr_single_solve(const T1* A, T1* x, casadi_int tr, const casadi_int* sp, T1* w) {\0A    casadi_int m, n, i;\0A    T1 damp, atol, btol, conlim, ctol, anorm, acond, dampsq, ddnorm, res2, xnorm, xxnorm, z;\0A    T1 cs2, sn2, alpha, beta, rhobar, phibar, bnorm, rnorm, arnorm, rhobar1, cs1, sn1, psi;\0A    T1 cs, sn, rho, theta, phi, tau, t1, t2, n2dk, delta, gambar, rhs, zbar, gamma, res1;\0A    T1 r1sq, r1norm, test1, test2, test3, rtol;\0A    casadi_int iter_lim, itn, istop;\0A    T1 *u, *v, *xx, *ww, *dk;\0A    m = sp[0];\0A    n = sp[1];\0A    damp = 0;\0A    atol = 1e-15;\0A    btol = 1e-15;\0A    conlim = 1e8;\0A    iter_lim = 10000;\0A    itn = 0;\0A    istop = 0;\0A    ctol = 0;\0A    if (conlim > 0) ctol = 1/conlim;\0A    anorm = 0;\0A    acond = 0;\0A    dampsq = damp*damp;\0A    ddnorm = 0;\0A    res2 = 0;\0A    xnorm = 0;\0A    xxnorm = 0;\0A    z = 0;\0A    cs2 = -1;\0A    sn2 = 0;\0A    u = w;  w+= m; casadi_copy(x, m, u);\0A    v = w;  w+= n; casadi_clear(v, n);\0A    xx = w; w+= n; casadi_clear(xx, n);\0A    ww = w; w+= n; casadi_clear(v, n);\0A    dk = w; w+= n;\0A    alpha = 0;\0A    beta = casadi_norm_2(m, u);\0A    if (beta>0) {\0A      for (i=0;i<m;++i) u[i]*=1/beta;\0A      casadi_mv(A, sp, u, v, !tr);\0A      alpha = casadi_norm_2(n, v);\0A    }\0A    if (alpha>0) {\0A      for (i=0;i<n;++i) v[i]*=1/alpha;\0A      casadi_copy(v, n, ww);\0A    }\0A    rhobar = alpha;\0A    phibar = beta;\0A    bnorm = beta;\0A    rnorm = beta;\0A    arnorm = alpha * beta;\0A    if (arnorm==0.0) {\0A      casadi_clear(x, m);\0A      return 0;\0A    }\0A    while (itn<iter_lim) {\0A      itn++;\0A      for (i=0;i<m;++i) u[i]*=-alpha;\0A      casadi_mv(A, sp, v, u, tr);\0A      beta = casadi_norm_2(m, u);\0A      if (beta>0) {\0A        for (i=0;i<m;++i) u[i]*=1/beta;\0A        anorm = sqrt(anorm*anorm + alpha*alpha+beta*beta+damp*damp);\0A        for (i=0;i<n;++i) v[i]*=-beta;\0A        casadi_mv(A, sp, u, v, !tr);\0A        alpha = casadi_norm_2(n, v);\0A        if (alpha>0) for (i=0;i<n;++i) v[i]*=1/alpha;\0A      }\0A      rhobar1 = sqrt(rhobar*rhobar+damp*damp);\0A      cs1 = rhobar / rhobar1;\0A      sn1 = damp / rhobar1;\0A      psi = sn1 * phibar;\0A      phibar *= cs1;\0A      casadi_lsqr_sym_ortho(rhobar1, beta, &cs, &sn, &rho);\0A      theta = sn * alpha;\0A      rhobar = -cs * alpha;\0A      phi = cs * phibar;\0A      phibar *= sn;\0A      tau = sn * phi;\0A      t1 = phi / rho;\0A      t2 = -theta / rho;\0A      for (i=0;i<n;++i) dk[i]=ww[i]/rho;\0A      for (i=0; i<n; ++i) xx[i] += t1*ww[i];\0A      for (i=0; i<n; ++i) ww[i] = v[i] + t2*ww[i];\0A      n2dk = casadi_norm_2(n, dk);\0A      ddnorm += n2dk*n2dk;\0A      delta = sn2 * rho;\0A      gambar = -cs2 * rho;\0A      rhs = phi - delta * z;\0A      zbar = rhs / gambar;\0A      xnorm = sqrt(xxnorm + zbar*zbar);\0A      gamma = sqrt(gambar*gambar + theta*theta);\0A      cs2 = gambar / gamma;\0A      sn2 = theta / gamma;\0A      z = rhs / gamma;\0A      xxnorm += z*z;\0A      acond = anorm * sqrt(ddnorm);\0A      res1 = phibar*phibar;\0A      res2 += psi*psi;\0A      rnorm = sqrt(res1+res2);\0A      arnorm = alpha*fabs(tau);\0A      r1sq = rnorm*rnorm - dampsq * xxnorm;\0A      r1norm = sqrt(fabs(r1sq));\0A      if (r1sq < 0) r1norm = -r1norm;\0A      test1 = rnorm / bnorm;\0A      test2 = arnorm / (anorm * rnorm);\0A      test3 = 1 / acond;\0A      t1 = test1 / (1 + anorm * xnorm / bnorm);\0A      rtol = btol + atol * anorm * xnorm / bnorm;\0A      if (itn >= iter_lim) istop = 7;\0A      if (1 + test3 <= 1) istop = 6;\0A      if (1 + test2 <= 1) istop = 5;\0A      if (1 + t1 <= 1) istop = 4;\0A      if (test3 <= ctol) istop = 3;\0A      if (test2 <= atol) istop = 2;\0A      if (test1 <= rtol) istop = 1;\0A      if (istop != 0) break;\0A    }\0A    casadi_copy(xx, m, x);\0A    return 0;\0A}\0A//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22lsqr_solve\22\0Atemplate<typename T1>\0Aint casadi_lsqr_solve(const T1* A, T1* x, casadi_int nrhs, casadi_int tr,\0A        const casadi_int* sp, T1* w) {\0A    casadi_int i;\0A    for (i=0; i<nrhs;++i) {\0A      if (casadi_lsqr_single_solve(A, x+i*sp[1], tr, sp, w)) return 1;\0A    }\0A    return 0;\0A}\0A\00", align 1
