@.str.54 = private unnamed_addr constant [8985 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22house\22\0A// Householder reflection\0A// Ref: Chapter 5, Direct Methods for Sparse Linear Systems by Tim Davis\0Atemplate<typename T1>\0AT1 casadi_house(T1* v, T1* beta, casadi_int nv) {\0A  // Local variable\0A  casadi_int i;\0A  T1 v0, sigma, s, sigma_is_zero, v0_nonpos;\0A  // Calculate norm\0A  v0 = v[0]; // Save v0 (overwritten below)\0A  sigma=0;\0A  for (i=1; i<nv; ++i) sigma += v[i]*v[i];\0A  s = sqrt(v0*v0 + sigma); // s = norm(v)\0A  // Calculate consistently with symbolic datatypes (SXElem)\0A  sigma_is_zero = sigma==0;\0A  v0_nonpos = v0<=0;\0A  // C-REPLACE \22if_else\22 \22casadi_if_else\22\0A  v[0] = if_else(sigma_is_zero, 1,\0A                 if_else(v0_nonpos, v0-s, -sigma/(v0+s))); // NOLINT\0A  *beta = if_else(sigma_is_zero, 2*v0_nonpos, -1/(s*v[0])); // NOLINT\0A  return s;\0A}\0A// SYMBOL \22qr\22\0A// Numeric QR factorization\0A// Ref: Chapter 5, Direct Methods for Sparse Linear Systems by Tim Davis\0A// len[x] = nrow\0A// sp_v = [nrow, ncol, 0, 0, ...] len[3 + ncol + nnz_v]\0A// len[v] nnz_v\0A// sp_r = [nrow, ncol, 0, 0, ...] len[3 + ncol + nnz_r]\0A// len[r] nnz_r\0A// len[beta] ncol\0Atemplate<typename T1>\0Avoid casadi_qr(const casadi_int* sp_a, const T1* nz_a, T1* x,\0A               const casadi_int* sp_v, T1* nz_v, const casadi_int* sp_r, T1* nz_r, T1* beta,\0A               const casadi_int* prinv, const casadi_int* pc) {\0A   // Local variables\0A   casadi_int ncol, nrow, r, c, k, k1;\0A   T1 alpha;\0A   const casadi_int *a_colind, *a_row, *v_colind, *v_row, *r_colind, *r_row;\0A   // Extract sparsities\0A   ncol = sp_a[1];\0A   a_colind=sp_a+2; a_row=sp_a+2+ncol+1;\0A   nrow = sp_v[0];\0A   v_colind=sp_v+2; v_row=sp_v+2+ncol+1;\0A   r_colind=sp_r+2; r_row=sp_r+2+ncol+1;\0A   // Clear work vector\0A   for (r=0; r<nrow; ++r) x[r] = 0;\0A   // Loop over columns of R, A and V\0A   for (c=0; c<ncol; ++c) {\0A     // Copy (permuted) column of A to x\0A     for (k=a_colind[pc[c]]; k<a_colind[pc[c]+1]; ++k) x[prinv[a_row[k]]] = nz_a[k];\0A     // Use the equality R = (I-betan*vn*vn')*...*(I-beta1*v1*v1')*A to get\0A     // strictly upper triangular entries of R\0A     for (k=r_colind[c]; k<r_colind[c+1] && (r=r_row[k])<c; ++k) {\0A       // Calculate scalar factor alpha = beta(r)*dot(v(:,r), x)\0A       alpha = 0;\0A       for (k1=v_colind[r]; k1<v_colind[r+1]; ++k1) alpha += nz_v[k1]*x[v_row[k1]];\0A       alpha *= beta[r];\0A       // x -= alpha*v(:,r)\0A       for (k1=v_colind[r]; k1<v_colind[r+1]; ++k1) x[v_row[k1]] -= alpha*nz_v[k1];\0A       // Get r entry\0A       *nz_r++ = x[r];\0A       // Strictly upper triangular entries in x no longer needed\0A       x[r] = 0;\0A     }\0A     // Get V column\0A     for (k=v_colind[c]; k<v_colind[c+1]; ++k) {\0A       nz_v[k] = x[v_row[k]];\0A       // Lower triangular entries of x no longer needed\0A       x[v_row[k]] = 0;\0A     }\0A     // Get diagonal entry of R, normalize V column\0A     *nz_r++ = casadi_house(nz_v + v_colind[c], beta + c, v_colind[c+1] - v_colind[c]);\0A   }\0A }\0A// SYMBOL \22qr_mv\22\0A// Multiply QR Q matrix from the right with a vector, with Q represented\0A// by the Householder vectors V and beta\0A// x = Q*x or x = Q'*x\0A// with Q = (I-beta(1)*v(:,1)*v(:,1)')*...*(I-beta(n)*v(:,n)*v(:,n)')\0A// len[x] >= nrow_ext\0Atemplate<typename T1>\0Avoid casadi_qr_mv(const casadi_int* sp_v, const T1* v, const T1* beta, T1* x,\0A                  casadi_int tr) {\0A  // Local variables\0A  casadi_int ncol, c, c1, k;\0A  T1 alpha;\0A  const casadi_int *colind, *row;\0A  // Extract sparsity\0A  ncol=sp_v[1];\0A  colind=sp_v+2; row=sp_v+2+ncol+1;\0A  // Loop over vectors\0A  for (c1=0; c1<ncol; ++c1) {\0A    // Forward order for transpose, otherwise backwards\0A    c = tr ? c1 : ncol-1-c1;\0A    // Calculate scalar factor alpha = beta(c)*dot(v(:,c), x)\0A    alpha=0;\0A    for (k=colind[c]; k<colind[c+1]; ++k) alpha += v[k]*x[row[k]];\0A    alpha *= beta[c];\0A    // x -= alpha*v(:,c)\0A    for (k=colind[c]; k<colind[c+1]; ++k) x[row[k]] -= alpha*v[k];\0A  }\0A}\0A// SYMBOL \22qr_trs\22\0A// Solve for an (optionally transposed) upper triangular matrix R\0Atemplate<typename T1>\0Avoid casadi_qr_trs(const casadi_int* sp_r, const T1* nz_r, T1* x, casadi_int tr) {\0A  // Local variables\0A  casadi_int ncol, r, c, k;\0A  const casadi_int *colind, *row;\0A  // Extract sparsity\0A  ncol=sp_r[1];\0A  colind=sp_r+2; row=sp_r+2+ncol+1;\0A  if (tr) {\0A    // Forward substitution\0A    for (c=0; c<ncol; ++c) {\0A      for (k=colind[c]; k<colind[c+1]; ++k) {\0A        r = row[k];\0A        if (r==c) {\0A          x[c] /= nz_r[k];\0A        } else {\0A          x[c] -= nz_r[k]*x[r];\0A        }\0A      }\0A    }\0A  } else {\0A    // Backward substitution\0A    for (c=ncol-1; c>=0; --c) {\0A      for (k=colind[c+1]-1; k>=colind[c]; --k) {\0A        r=row[k];\0A        if (r==c) {\0A          x[r] /= nz_r[k];\0A        } else {\0A          x[r] -= nz_r[k]*x[c];\0A        }\0A      }\0A    }\0A  }\0A}\0A// SYMBOL \22qr_solve\22\0A// Solve a factorized linear system\0A// len[w] >= max(ncol, nrow_ext)\0Atemplate<typename T1>\0Avoid casadi_qr_solve(T1* x, casadi_int nrhs, casadi_int tr,\0A                     const casadi_int* sp_v, const T1* v, const casadi_int* sp_r, const T1* r,\0A                     const T1* beta, const casadi_int* prinv, const casadi_int* pc, T1* w) {\0A  casadi_int k, c, nrow_ext, ncol;\0A  nrow_ext = sp_v[0]; ncol = sp_v[1];\0A  for (k=0; k<nrhs; ++k) {\0A    if (tr) {\0A      // (PR' Q R PC)' x = PC' R' Q' PR x = b <-> x = PR' Q R' \\ PC b\0A      // Multiply by PC\0A      for (c=0; c<ncol; ++c) w[c] = x[pc[c]];\0A      //  Solve for R'\0A      casadi_qr_trs(sp_r, r, w, 1);\0A      // Multiply by Q\0A      casadi_qr_mv(sp_v, v, beta, w, 0);\0A      // Multiply by PR'\0A      for (c=0; c<ncol; ++c) x[c] = w[prinv[c]];\0A    } else {\0A      //PR' Q R PC x = b <-> x = PC' R \\ Q' PR b\0A      // Multiply with PR\0A      for (c=0; c<nrow_ext; ++c) w[c] = 0;\0A      for (c=0; c<ncol; ++c) w[prinv[c]] = x[c];\0A      // Multiply with Q'\0A      casadi_qr_mv(sp_v, v, beta, w, 1);\0A      //  Solve for R\0A      casadi_qr_trs(sp_r, r, w, 0);\0A      // Multiply with PC'\0A      for (c=0; c<ncol; ++c) x[pc[c]] = w[c];\0A    }\0A    x += ncol;\0A  }\0A}\0A// SYMBOL \22qr_singular\22\0A// Check if QR factorization corresponds to a singular matrix\0Atemplate<typename T1>\0Acasadi_int casadi_qr_singular(T1* rmin, casadi_int* irmin, const T1* nz_r,\0A                             const casadi_int* sp_r, const casadi_int* pc, T1 eps) {\0A  // Local variables\0A  T1 rd, rd_min;\0A  casadi_int ncol, c, nullity;\0A  const casadi_int* r_colind;\0A  // Nullity\0A  nullity = 0;\0A  // Extract sparsity\0A  ncol = sp_r[1];\0A  r_colind = sp_r + 2;\0A  // Find the smallest diagonal entry\0A  for (c=0; c<ncol; ++c) {\0A    rd = fabs(nz_r[r_colind[c+1]-1]);\0A    // Increase nullity if smaller than eps\0A    if (rd<eps) nullity++;\0A    // Check if smallest so far\0A    if (c==0 || rd < rd_min) {\0A      rd_min = rd;\0A      if (rmin) *rmin = rd;\0A      if (irmin) *irmin = pc[c];\0A    }\0A  }\0A  // Return number of zero-ish eigenvalues\0A  return nullity;\0A}\0A// SYMBOL \22qr_colcomb\22\0A// Get a vector v such that A*v = 0 and |v| == 1\0Atemplate<typename T1>\0Avoid casadi_qr_colcomb(T1* v, const T1* nz_r, const casadi_int* sp_r,\0A                       const casadi_int* pc, T1 eps, casadi_int ind) {\0A  // Local variables\0A  casadi_int ncol, r, c, k;\0A  const casadi_int *r_colind, *r_row;\0A  // Extract sparsity\0A  ncol = sp_r[1];\0A  r_colind = sp_r + 2;\0A  r_row = r_colind + ncol + 1;\0A  // Find the ind-th diagonal which is smaller than eps, overwrite ind with c\0A  for (c=0; c<ncol; ++c) {\0A    if (fabs(nz_r[r_colind[c+1]-1])<eps && 0==ind--) {\0A      ind = c;\0A      break;\0A    }\0A  }\0A  // Reset w\0A  casadi_clear(v, ncol);\0A  v[pc[ind]] = 1.;\0A  // Copy ind-th column to v\0A  for (k=r_colind[ind]; k<r_colind[ind+1]-1; ++k) {\0A    v[pc[r_row[k]]] = -nz_r[k];\0A  }\0A  // Backward substitution\0A  for (c=ind-1; c>=0; --c) {\0A    for (k=r_colind[c+1]-1; k>=r_colind[c]; --k) {\0A      r=r_row[k];\0A      if (r==c) {\0A        if (fabs(nz_r[k])<eps) {\0A          v[pc[r]] = 0;\0A        } else {\0A          v[pc[r]] /= nz_r[k];\0A        }\0A      } else {\0A        v[pc[r]] -= nz_r[k]*v[pc[c]];\0A      }\0A    }\0A  }\0A  // Normalize v\0A  casadi_scal(ncol, 1./sqrt(casadi_dot(ncol, v, v)), v);\0A}\0A\00", align 1
