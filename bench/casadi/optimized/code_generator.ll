@.str.76 = private unnamed_addr constant [4955 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22blazing_printvec\22\0Atemplate<typename T1>\0Avoid casadi_blazing_printvec(const simde__m256d* e) {\0A  double elements[4];\0A  simde_mm256_storeu_pd(elements, *e);\0A  printf(\22mm256d: <%.4f %.4f %.4f %.4f>\\n\22, elements[0], elements[1], elements[2], elements[3]);\0A}\0A// SYMBOL \22blazing_de_boor\22\0Atemplate<typename T1>\0Avoid casadi_blazing_de_boor(T1 x, const T1* knots, simde__m256d* boor_d0, simde__m256d* boor_d1, simde__m256d* boor_d2, const simde__m256d* boor_d3) { // NOLINT(whitespace/line_length)\0A  simde__m256d x_ = simde_mm256_set1_pd(x);\0A  simde__m256d zero = simde_mm256_set1_pd(0.0);\0A  simde__m256d mask_end = simde_mm256_set_pd(0.0, -1.0, -1.0, -1.0);\0A  // shift one up\0A  simde__m256d boor_d3i_1 = simde_mm256_permute4x64_pd(*boor_d3, SIMDE_MM_SHUFFLE(3, 3, 2, 1));\0A  boor_d3i_1 = simde_mm256_blendv_pd(zero, boor_d3i_1, mask_end);\0A  simde__m256d knotsi = simde_mm256_loadu_pd(knots);\0A  simde__m256d knotsi_1 = simde_mm256_loadu_pd(knots+1);\0A  simde__m256d knotsi_2 = simde_mm256_loadu_pd(knots+2);\0A  simde__m256d knotsi_3 = simde_mm256_loadu_pd(knots+3);\0A  simde__m256d knotsi_4 = simde_mm256_loadu_pd(knots+4);\0A  simde__m256d bottom = simde_mm256_sub_pd(knotsi_1, knotsi); // bottom = knots[i + 1] - knots[i];\0A  simde__m256d bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ); // if (bottom)\0A  // (x - knots[i]) / bottom;\0A  simde__m256d r = simde_mm256_div_pd(simde_mm256_sub_pd(x_, knotsi), bottom);\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d2 = simde_mm256_mul_pd(r, *boor_d3);\0A  *boor_d2 = simde_mm256_blendv_pd(*boor_d2, zero, bottom_mask);\0A  bottom = simde_mm256_sub_pd(knotsi_2, knotsi_1); // bottom = knots[i + 2] - knots[i + 1];\0A  bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ);\0A  r = simde_mm256_div_pd(simde_mm256_sub_pd(knotsi_2, x_), bottom); // (knots[i + 2] - x) / bottom\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d2 = simde_mm256_fmadd_pd(r, boor_d3i_1, *boor_d2);\0A  // shift one up\0A  simde__m256d boor_d2i_1 = simde_mm256_permute4x64_pd(*boor_d2, SIMDE_MM_SHUFFLE(3, 3, 2, 1));\0A  boor_d2i_1 = simde_mm256_blendv_pd(zero, boor_d2i_1, mask_end);\0A  bottom = simde_mm256_sub_pd(knotsi_2, knotsi); // bottom = knots[i + 2] - knots[i];\0A  bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ); // if (bottom)\0A  r = simde_mm256_div_pd(simde_mm256_sub_pd(x_, knotsi), bottom); // (x - knots[i]) / bottom;\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d1 = simde_mm256_mul_pd(r, *boor_d2);\0A  *boor_d1 = simde_mm256_blendv_pd(*boor_d1, zero, bottom_mask);\0A  bottom = simde_mm256_sub_pd(knotsi_3, knotsi_1); // bottom = knots[i + 3] - knots[i + 1];\0A  bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ);\0A  r = simde_mm256_div_pd(simde_mm256_sub_pd(knotsi_3, x_), bottom);  // (knots[i + 3] - x) / bottom\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d1 = simde_mm256_fmadd_pd(r, boor_d2i_1, *boor_d1);\0A  // shift one up\0A  simde__m256d boor_d1i_1 = simde_mm256_permute4x64_pd(*boor_d1, SIMDE_MM_SHUFFLE(3, 3, 2, 1));\0A  boor_d1i_1 = simde_mm256_blendv_pd(zero, boor_d1i_1, mask_end);\0A  bottom = simde_mm256_sub_pd(knotsi_3, knotsi); // bottom = knots[i + 3] - knots[i];\0A  bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ); // if (bottom)\0A  r = simde_mm256_div_pd(simde_mm256_sub_pd(x_, knotsi), bottom); // (x - knots[i]) / bottom;\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d0 = simde_mm256_mul_pd(r, *boor_d1);\0A  *boor_d0 = simde_mm256_blendv_pd(*boor_d0, zero, bottom_mask);\0A  bottom = simde_mm256_sub_pd(knotsi_4, knotsi_1); // bottom = knots[i + 4] - knots[i + 1];\0A  bottom_mask = simde_mm256_cmp_pd(bottom, zero, SIMDE_CMP_EQ_OQ);\0A  r = simde_mm256_div_pd(simde_mm256_sub_pd(knotsi_4, x_), bottom);  // (knots[i + 4] - x) / bottom\0A  r = simde_mm256_blendv_pd(r, zero, bottom_mask);\0A  *boor_d0 = simde_mm256_fmadd_pd(r, boor_d1i_1, *boor_d0);\0A}\0A\00", align 1
