@.str.51 = private unnamed_addr constant [11104 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// C-REPLACE \22std::numeric_limits<T1>::quiet_NaN()\22 \22NAN\22\0A// C-REPLACE \22fmax\22 \22casadi_fmax\22\0A// SYMBOL \22forward_diff\22\0Atemplate<typename T1>\0Avoid casadi_forward_diff(const T1** yk, T1* J, T1 h, casadi_int n_y) {\0A  // Local variables\0A  casadi_int i;\0A  const double *yf, *yc;\0A  T1 hinv;\0A  // Inverse of step size\0A  hinv = 1. / h;\0A  // Get stencil\0A  yc = yk[0];\0A  yf = yk[1];\0A  // Calculate FD approximation\0A  for (i = 0; i < n_y; ++i) J[i] = hinv * (yf[i] - yc[i]);\0A}\0A// SYMBOL \22central_diff\22\0Atemplate<typename T1>\0Avoid casadi_central_diff(const T1** yk, T1* J, T1 h, casadi_int n_y) {\0A  // Local variables\0A  casadi_int i;\0A  const T1 *yf, *yc, *yb;\0A  T1 hinv;\0A  // Inverse of step size\0A  hinv = 1. / h;\0A  // Get stencil\0A  yb = yk[0];\0A  yc = yk[1];\0A  yf = yk[2];\0A  // Set u and stencils to zero (also supresses warnings)\0A  for (i = 0; i < n_y; ++i) {\0A    if (isfinite(yb[i])) {\0A      if (isfinite(yf[i])) {\0A        // Both forward and backward allowed\0A        J[i] = 0.5 * hinv * (yf[i] - yb[i]);\0A      } else {\0A        // Backward but not forward allowed\0A        J[i] = hinv * (yc[i] - yb[i]);\0A      }\0A    } else {\0A      if (isfinite(yf[i])) {\0A        // Forward but not backward allowed\0A        J[i] = hinv * (yf[i] - yc[i]);\0A      } else {\0A        // Neither forward nor backward possible\0A        J[i] = std::numeric_limits<T1>::quiet_NaN();\0A      }\0A    }\0A  }\0A}\0A// SYMBOL \22central_diff_err\22\0Atemplate<typename T1>\0AT1 casadi_central_diff_err(const T1** yk, T1 h, casadi_int n_y, casadi_int i,\0A    T1 abstol, T1 reltol) {\0A  // Local variables\0A  const T1 *yf, *yc, *yb;\0A  T1 err_trunc, err_round;\0A  // Get stencil\0A  yb = yk[0];\0A  yc = yk[1];\0A  yf = yk[2];\0A  // Only consider points where both forward and backward allowed\0A  if (isfinite(yb[i]) && isfinite(yf[i])) {\0A    // Truncation error\0A    err_trunc = yf[i] - 2*yc[i] + yb[i];\0A    // Roundoff error\0A    err_round = reltol / h * fmax(fabs(yf[i] - yc[i]), fabs(yc[i] - yb[i])) + abstol;\0A    // Error quotient estimate\0A    return err_trunc / err_round;\0A  } else {\0A    // Cannot be calculated\0A    return std::numeric_limits<T1>::quiet_NaN();;\0A  }\0A}\0A// SYMBOL \22smoothing_diff_weights\22\0Atemplate<typename T1>\0AT1 casadi_smoothing_diff_weights(casadi_int k, T1 yb, T1 yc, T1 yf, T1 *J) {\0A  // Calculate shifted finite difference approximation, weights\0A  if (k == 0) {\0A    // Backward shifted\0A    // 7.10 in Conte & Carl de Boor: Elementary Numerical Analysis (1972)\0A    // and 25.3.4 in Abramowitz and Stegun, Handbook of Mathematical Functions (1964)\0A    if (J) *J = 3 * yf - 4 * yc + yb;\0A    // Relative weight is 1\0A    return 1;\0A  } else if (k == 1) {\0A    // Central\0A    // We give this the relative weight 4 since if all weights are equal,\0A    // this would amount to a five point formula for the derivative\0A    // (yb2 - 8*yb + 8*yf - y_f2)/(12*h)\0A    // cf. 25.3.6 in Abramowitz and Stegun, Handbook of Mathematical Functions (1964)\0A    if (J) *J = yf - yb;\0A    // Relative weight is 4\0A    return 4;\0A  } else {\0A    // Forward shifted, cf. backward shifted above\0A    if (J) *J = -3 * yb + 4 * yc - yf;\0A    // Relative weight is 1\0A    return 1;\0A  }\0A}\0A// SYMBOL \22smoothing_diff\22\0Atemplate<typename T1>\0Avoid casadi_smoothing_diff(const T1** yk, T1* J, T1 h, casadi_int n_y, T1 smoothing) {\0A  // Stencil\0A  T1 yb, yc, yf;\0A  // Local variables\0A  T1 Jk, wk, sw, ui, sm;\0A  casadi_int i, k;\0A  // Set stencils to zero (also supresses warnings)\0A  yf = yc = yb = 0;\0A  for (i = 0; i < n_y; ++i) {\0A    // Reset derivative estimate, sum of weights, error estimate\0A    J[i] = sw = ui = 0;\0A    // For backward shifted, central and forward shifted\0A    for (k = 0; k < 3; ++k) {\0A      // Get stencil\0A      yb = yk[k][i];\0A      yc = yk[k + 1][i];\0A      yf = yk[k + 2][i];\0A      // No contribuation if any value is infinite\0A      if (!isfinite(yb) || !isfinite(yc) || !isfinite(yf)) continue;\0A      // Calculate weights\0A      wk = casadi_smoothing_diff_weights(k, yb, yc, yf, &Jk);\0A      // Smoothness measure (second order derivative)\0A      sm = yf - 2*yc + yb;\0A      sm /= h*h;\0A      // Modify the weight according to smoothness\0A      wk /= sm*sm + smoothing;\0A      sw += wk;\0A      // Added weighted contribution to weight and error\0A      J[i] += wk * Jk;\0A    }\0A    // If sw is 0, no stencil worked\0A    if (sw == 0) {\0A      // Set component to 0, return -1\0A      J[i] = std::numeric_limits<T1>::quiet_NaN();\0A    } else {\0A      // Finalize estimate using the sum of weights and the step length\0A      J[i] /= 2*h*sw;\0A    }\0A  }\0A}\0A// SYMBOL \22smoothing_diff_err\22\0Atemplate<typename T1>\0AT1 casadi_smoothing_diff_err(const T1** yk, T1 h, casadi_int n_y, casadi_int i,\0A    T1 abstol, T1 reltol, T1 smoothing) {\0A  // Stencil\0A  T1 yb, yc, yf;\0A  // Local variables\0A  T1 wk, sw, ui, err_trunc, err_round, sm;\0A  casadi_int k;\0A  // Set stencils to zero (also supresses warnings)\0A  yf = yc = yb = 0;\0A  // Reset derivative estimate, sum of weights, error estimate\0A  sw = ui = 0;\0A  // For backward shifted, central and forward shifted\0A  for (k = 0; k < 3; ++k) {\0A    // Get stencil\0A    yb = yk[k][i];\0A    yc = yk[k + 1][i];\0A    yf = yk[k + 2][i];\0A    // No contribuation if any value is infinite\0A    if (!isfinite(yb) || !isfinite(yc) || !isfinite(yf)) continue;\0A    // Calculate weights\0A    wk = casadi_smoothing_diff_weights(k, yb, yc, yf, static_cast<T1*>(0));\0A    // Truncation error\0A    err_trunc = yf - 2*yc + yb;\0A    // Roundoff error\0A    err_round = reltol/h*fmax(fabs(yf - yc), fabs(yc - yb)) + abstol;\0A    // We use the second order derivative as a smoothness measure\0A    sm = err_trunc/(h*h);\0A    // Modify the weight according to smoothness\0A    wk /= sm*sm + smoothing;\0A    sw += wk;\0A    // Added weighted contribution to weight and error\0A    ui += wk * fabs(err_trunc / err_round);\0A  }\0A  // If sw is 0, no stencil worked\0A  if (sw == 0) {\0A    // Cannot be calculated\0A    return std::numeric_limits<T1>::quiet_NaN();;\0A  } else {\0A    // Finalize estimate using the sum of weights and the step length\0A    return ui / sw;\0A  }\0A}\0A// SYMBOL \22finite_diff_mem\22\0Atemplate<typename T1>\0Astruct casadi_finite_diff_mem {\0A  // Input precision\0A  T1 reltol;\0A  // Output precision\0A  T1 abstol;\0A  // Smoothness parameter\0A  // Smaller epsilon: More discontinuity rejecting\0A  // Larger epsilon: More accurate (higher order) if smooth\0A  T1 smoothing;\0A};\0A// C-REPLACE \22casadi_finite_diff_mem<T1>\22 \22struct casadi_finite_diff_mem\22\0A// SYMBOL \22forward_diff_old\22\0Atemplate<typename T1>\0AT1 casadi_forward_diff_old(T1** yk, T1* y0, T1* J,\0A    T1 h, casadi_int n_y, const casadi_finite_diff_mem<T1>* m) {\0A  casadi_int i;\0A  for (i=0; i<n_y; ++i) {\0A    J[i] = (yk[0][i]-y0[i])/h;\0A  }\0A  return -1;\0A}\0A// SYMBOL \22central_diff_old\22\0Atemplate<typename T1>\0AT1 casadi_central_diff_old(T1** yk, T1* y0, T1* J,\0A    T1 h, casadi_int n_y, const casadi_finite_diff_mem<T1>* m) {\0A  // Return value\0A  T1 u;\0A  // Stencil\0A  T1 yf, yc, yb;\0A  // Local variables\0A  T1 err_trunc, err_round;\0A  casadi_int i;\0A  // Set u and stencils to zero (also supresses warnings)\0A  yf = yc = yb = u = 0;\0A  for (i=0; i<n_y; ++i) {\0A    // Copy to local variables, return -1 if invalid entry\0A    if (!isfinite((yf=yk[1][i])) || !isfinite((yc=y0[i])) || !isfinite((yb=yk[0][i]))) {\0A      J[i] = std::numeric_limits<T1>::quiet_NaN();\0A      u = -1;\0A      continue;\0A    }\0A    // Central difference approximation\0A    J[i] = (yf - yb)/(2*h);\0A    // Truncation error\0A    err_trunc = yf - 2*yc + yb;\0A    // Roundoff error\0A    err_round = m->reltol/h*fmax(fabs(yf-yc), fabs(yc-yb)) + m->abstol;\0A    // Update error estimate\0A    if (u>=0) u = fmax(u, fabs(err_trunc/err_round));\0A  }\0A  return u;\0A}\0A// SYMBOL \22smoothing_diff_old\22\0Atemplate<typename T1>\0AT1 casadi_smoothing_diff_old(T1** yk, T1* y0, T1* J,\0A    T1 h, casadi_int n_y, const casadi_finite_diff_mem<T1>* m) {\0A  // Return value\0A  T1 u;\0A  // Stencil\0A  T1 yb, yc, yf;\0A  // Local variables\0A  T1 Jk, wk, sw, ui, err_trunc, err_round, sm;\0A  casadi_int i, k;\0A  // Set u and stencils to zero (also supresses warnings)\0A  yf = yc = yb = u = 0;\0A  for (i=0; i<n_y; ++i) {\0A    // Reset derivative estimate, sum of weights, error estimate\0A    J[i] = sw = ui = 0;\0A    // For backward shifted, central and forward shifted\0A    for (k=0; k<3; ++k) {\0A      // Calculate shifted finite difference approximation\0A      if (k==0) {\0A        // Backward shifted\0A        // 7.10 in Conte & Carl de Boor: Elementary Numerical Analysis (1972)\0A        // and 25.3.4 in Abramowitz and Stegun, Handbook of Mathematical Functions (1964)\0A        if (!isfinite((yc=yk[0][i]))) continue;\0A        if (!isfinite((yb=yk[1][i]))) continue;\0A        yf = y0[i];\0A        Jk = 3*yf - 4*yc + yb;\0A        wk = 1;\0A      } else if (k==1) {\0A        // Central\0A        // We give this the \22nominal weight\22 4 since if all weights are equal,\0A        // this would amount to a five point formula for the derivative\0A        // (yb2 - 8*yb + 8*yf - y_f2)/(12*h)\0A        // cf. 25.3.6 in Abramowitz and Stegun, Handbook of Mathematical Functions (1964)\0A        if (!isfinite((yf=yk[2][i]))) continue;\0A        if (!isfinite((yb=yc))) continue;\0A        yc = y0[i];\0A        Jk = yf-yb;\0A        wk = 4;\0A      } else {\0A        // Forward shifted\0A        if (!isfinite((yc=yf))) continue;\0A        if (!isfinite((yf=yk[3][i]))) continue;\0A        yb = y0[i];\0A        Jk = -3*yb + 4*yc - yf;\0A        wk = 1;\0A      }\0A      // Truncation error\0A      err_trunc = yf - 2*yc + yb;\0A      // Roundoff error\0A      err_round = m->reltol/h*fmax(fabs(yf-yc), fabs(yc-yb)) + m->abstol;\0A      // We use the second order derivative as a smoothness measure\0A      sm = err_trunc/(h*h);\0A      // Modify the weight according to smoothness\0A      wk /= sm*sm + m->smoothing;\0A      sw += wk;\0A      // Added weighted contribution to weight and error\0A      J[i] += wk * Jk;\0A      ui += wk * fabs(err_trunc/err_round);\0A    }\0A    // If sw is 0, no stencil worked\0A    if (sw==0) {\0A      // Set component to 0, return -1\0A      J[i] = std::numeric_limits<T1>::quiet_NaN();\0A      u = -1;\0A    } else {\0A      // Finalize estimate using the sum of weights and the step length\0A      J[i] /= 2*h*sw;\0A      if (u>=0) u = fmax(u, ui/sw);\0A    }\0A  }\0A  return u;\0A}\0A\00", align 1
