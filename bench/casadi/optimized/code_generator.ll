@.str.25 = private unnamed_addr constant [2873 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22mtimes\22\0Atemplate<typename T1>\0Avoid casadi_mtimes(const T1* x, const casadi_int* sp_x, const T1* y, const casadi_int* sp_y, T1* z, const casadi_int* sp_z, T1* w, casadi_int tr) { // NOLINT(whitespace/line_length)\0A  casadi_int ncol_x, ncol_y, ncol_z, cc;\0A  const casadi_int *colind_x, *row_x, *colind_y, *row_y, *colind_z, *row_z;\0A  // Get sparsities\0A  ncol_x = sp_x[1];\0A  colind_x = sp_x+2; row_x = sp_x + 2 + ncol_x+1;\0A  ncol_y = sp_y[1];\0A  colind_y = sp_y+2; row_y = sp_y + 2 + ncol_y+1;\0A  ncol_z = sp_z[1];\0A  colind_z = sp_z+2; row_z = sp_z + 2 + ncol_z+1;\0A  if (tr) {\0A    // Loop over the columns of y and z\0A    for (cc=0; cc<ncol_z; ++cc) {\0A      casadi_int kk;\0A      // Get the dense column of y\0A      for (kk=colind_y[cc]; kk<colind_y[cc+1]; ++kk) {\0A        w[row_y[kk]] = y[kk];\0A      }\0A      // Loop over the nonzeros of z\0A      for (kk=colind_z[cc]; kk<colind_z[cc+1]; ++kk) {\0A        casadi_int kk1;\0A        casadi_int rr = row_z[kk];\0A        // Loop over corresponding columns of x\0A        for (kk1=colind_x[rr]; kk1<colind_x[rr+1]; ++kk1) {\0A          z[kk] += x[kk1] * w[row_x[kk1]];\0A        }\0A      }\0A    }\0A  } else {\0A    // Loop over the columns of y and z\0A    for (cc=0; cc<ncol_y; ++cc) {\0A      casadi_int kk;\0A      // Get the dense column of z\0A      for (kk=colind_z[cc]; kk<colind_z[cc+1]; ++kk) {\0A        w[row_z[kk]] = z[kk];\0A      }\0A      // Loop over the nonzeros of y\0A      for (kk=colind_y[cc]; kk<colind_y[cc+1]; ++kk) {\0A        casadi_int kk1;\0A        casadi_int rr = row_y[kk];\0A        // Loop over corresponding columns of x\0A        for (kk1=colind_x[rr]; kk1<colind_x[rr+1]; ++kk1) {\0A          w[row_x[kk1]] += x[kk1]*y[kk];\0A        }\0A      }\0A      // Get the sparse column of z\0A      for (kk=colind_z[cc]; kk<colind_z[cc+1]; ++kk) {\0A        z[kk] = w[row_z[kk]];\0A      }\0A    }\0A  }\0A}\0A\00", align 1
