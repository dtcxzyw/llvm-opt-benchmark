@.str.17 = private unnamed_addr constant [2581 x i8] c"//\0A//    MIT No Attribution\0A//\0A//    Copyright (C) 2010-2023 Joel Andersson, Joris Gillis, Moritz Diehl, KU Leuven.\0A//\0A//    Permission is hereby granted, free of charge, to any person obtaining a copy of this\0A//    software and associated documentation files (the \22Software\22), to deal in the Software\0A//    without restriction, including without limitation the rights to use, copy, modify,\0A//    merge, publish, distribute, sublicense, and/or sell copies of the Software, and to\0A//    permit persons to whom the Software is furnished to do so.\0A//\0A//    THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,\0A//    INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A\0A//    PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT\0A//    HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A//    OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE\0A//    SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A//\0A// SYMBOL \22interpn_grad\22\0Atemplate<typename T1>\0Avoid casadi_interpn_grad(T1* grad, casadi_int ndim, const T1* grid, const casadi_int* offset, const T1* values, const T1* x, const casadi_int* lookup_mode, casadi_int m, casadi_int* iw, T1* w) { // NOLINT(whitespace/line_length)\0A  T1 *alpha, *coeff, *v;\0A  casadi_int *index, *corner;\0A  casadi_int i;\0A  // Quick return\0A  if (!grad) return;\0A  // Work vectors\0A  alpha = w; w += ndim;\0A  coeff = w; w += ndim;\0A  v = w; w+= m;\0A  index = iw; iw += ndim;\0A  corner = iw; iw += ndim;\0A  // Left index and fraction of interval\0A  casadi_interpn_weights(ndim, grid, offset, x, alpha, index, lookup_mode);\0A  // Loop over all corners, add contribution to output\0A  casadi_clear_casadi_int(corner, ndim);\0A  casadi_clear(grad, ndim*m);\0A  do {\0A    casadi_int i, j;\0A    // Get coefficients\0A    casadi_clear(v, m);\0A    casadi_interpn_interpolate(v, ndim, offset, values,\0A      alpha, index, corner, coeff, m);\0A    // Propagate to alpha\0A    for (i=ndim-1; i>=0; --i) {\0A      if (corner[i]) {\0A        for (j=0; j<m; ++j) {\0A          grad[i*m+j] += v[j]*coeff[i];\0A          v[j] *= alpha[i];\0A        }\0A      } else {\0A        for (j=0; j<m; ++j) {\0A          grad[i*m+j] -= v[j]*coeff[i];\0A          v[j] *= 1-alpha[i];\0A        }\0A      }\0A    }\0A  } while (casadi_flip(corner, ndim));\0A  // Propagate to x\0A  for (i=0; i<ndim; ++i) {\0A    casadi_int k, j;\0A    const T1* g;\0A    T1 delta;\0A    g = grid + offset[i];\0A    j = index[i];\0A    delta =  g[j+1]-g[j];\0A    for (k=0;k<m;++k) grad[k] /= delta;\0A    grad += m;\0A  }\0A}\0A\00", align 1
