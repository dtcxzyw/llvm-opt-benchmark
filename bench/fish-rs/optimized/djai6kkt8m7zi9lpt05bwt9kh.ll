0A            set fish_help_page \22language.html#expand\22\0A        case 'completion-*'\0A            set fish_help_page \22completions.html#$fish_help_item\22\0A        case 'tut-*'\0A            set fish_help_page \22tutorial.html#\22(string sub -s 5 -- $fish_help_item | string replace -a -- _ -)\0A        case tutorial\0A            set fish_help_page \22tutorial.html\22\0A        case releasenotes\0A            set fish_help_page relnotes.html\0A        case terminal-compatiblity\0A            set fish_help_page terminal-compatibility.html\0A        case completions\0A            set fish_help_page completions.html\0A        case commands\0A            set fish_help_page commands.html\0A        case faq\0A            set fish_help_page faq.html\0A        case fish-for-bash-users\0A            set fish_help_page fish_for_bash_users.html\0A        case custom-prompt\0A            set fish_help_page prompt.html\0A        case $faqpages\0A            set fish_help_page \22faq.html#$fish_help_item\22\0A        case $for_bash_pages\0A            set fish_help_page \22fish_for_bash_users.html#$fish_help_item\22\0A        case $langpages\0A            set fish_help_page \22language.html#$fish_help_item\22\0A        case $interactivepages\0A            set fish_help_page \22interactive.html#$fish_help_item\22\0A        case $tutpages\0A            set fish_help_page \22tutorial.html#$fish_help_item\22\0A        case (builtin -n) (__fish_print_commands)\0A            # If the docs aren't installed, __fish_print_commands won't print anything\0A            # Since we document all our builtins, check those at least.\0A            # The alternative is to create this list at build time.\0A            set fish_help_page \22cmds/$fish_help_item.html\22\0A        case ''\0A            set fish_help_page \22index.html\22\0A        case $intropages\0A            set fish_help_page \22index.html$fish_help_item\22\0A        case \22*\22\0A            printf (_ \22%s: no fish help topic '%s', try 'man %s'\\n\22) help $fish_help_item $fish_help_item\0A            return 1\0A    end\0A\0A    # In Crostini Chrome OS Linux, the default browser opens URLs in Chrome running outside the\0A    # linux VM. This browser does not have access to the Linux filesystem. This uses Garcon, see e.g.\0A    # https://chromium.googlesource.com/chromiumos/platform2/+/master/vm_tools/garcon/#opening-urls\0A    # https://source.chromium.org/search?q=garcon-url-handler\0A    string match -q '*garcon-url-handler*' $fish_browser[1]\0A    and set -l chromeos_linux_garcon\0A\0A    # Generate the online URL, with one dot in the version string (major.minor)\0A    set -l version_string (string match -rg '(\\d+\\.\\d+(?:b\\d+)?).*' -- $version)\0A    set -l ext_url https://fishshell.com/docs/$version_string/$fish_help_page\0A    set -l page_url\0A    if set -q __fish_help_dir[1]; and test -f $__fish_help_dir/index.html; and not set -lq chromeos_linux_garcon\0A        # Help is installed, use it\0A        set page_url file://$__fish_help_dir/$fish_help_page\0A\0A        # For Windows (Cygwin, msys2 and WSL), we need to convert the base\0A        # help dir to a Windows path before converting it to a file URL\0A        # but only if a Windows browser is being used\0A        if type -q cygpath\0A            and string match -qr '(cygstart|\\.exe)(\\s+|$)' $fish_browser[1]\0A            set page_url file://(cygpath -m $__fish_help_dir)/$fish_help_page\0A        else if type -q wslpath\0A            and string match -qr '\\.exe(\\s+|$)' $fish_browser[1]\0A            set page_url file://(wslpath -w $__fish_help_dir)/$fish_help_page\0A        end\0A    else\0A        set page_url $ext_url\0A        # We don't need a trampoline for a remote URL.\0A        set need_trampoline\0A    end\0A\0A    if not set -q fish_browser[1]\0A        printf (_ '%s: Could not find a web browser.\\n') help >&2\0A        printf (_ 'Please try `BROWSER=some_browser help`, `man fish-doc`, or `man fish-tutorial`.\\n\\n') >&2\0A        printf (_ 'Or open %s in your browser of choice.\\n') $ext_url >&2\0A        return 1\0A    end\0A\0A    if set -q need_trampoline[1]\0A        # If string replace doesn't replace anything, we don't actually need a\0A        # trampoline (they're only needed if there's a fragment in the path)\0A        if set -l clean_url (string match -re '#' $page_url)\0A            # Write a temporary file that will redirect where we want.\0A            set -q TMPDIR\0A            or set -l TMPDIR /tmp\0A            set -l tmpdir (mktemp -d $TMPDIR/help.XXXXXX)\0A            or return 1\0A            set -l tmpname $tmpdir/help.html\0A            echo '<meta http-equiv=\22refresh\22 content=\220;URL=\\''$clean_url'\\'\22 />' >$tmpname\0A            set page_url file://$tmpname\0A\0A            # For Windows (Cygwin, msys2 and WSL), we need to convert the base help dir to a Windows path\0A            # before converting it to a file URL, but only if a Windows browser is being used\0A            if type -q cygpath\0A                and string match -qr '(cygstart|\\.exe)(\\s+|$)' $fish_browser[1]\0A                set page_url file://(cygpath -m $tmpname)\0A            else if type -q wslpath\0A                and string match -qr '\\.exe(\\s+|$)' $fish_browser[1]\0A                set page_url file://(wslpath -w $tmpname)\0A            end\0A        end\0A    end\0A\0A    printf (_ 'help: Help is being displayed in %s.\\n') $fish_browser[1]\0A    # cmd.exe and powershell needs more coaxing.\0A    if string match -qr 'powershell\\.exe$|cmd\\.exe$' -- $fish_browser[1]\0A        # The space before the /c is to prevent msys2 from expanding it to a path\0A        $fish_browser \22 /c\22 start $page_url\0A    else if contains -- $fish_browser[1] $graphical_browsers\0A        /bin/sh -c '( \22$@\22 ) &' -- $fish_browser $page_url\0A    else\0A        $fish_browser $page_url\0A    end\0A\0A    # Show the online URL anyway in case we did not manage to open something successfully.\0A    # (we can't check because we need to background it)\0A    printf (_ 'help: If no help could be displayed, go to %s to view the documentation online.\\n') $ext_url\0Aend\0A", align 1
