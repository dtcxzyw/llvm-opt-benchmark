@anon.1d0b41a8d45d477c3029ec78f9b8b434.3440 = private unnamed_addr constant [6627 x i8] c"function fish_delta\0A    argparse h/help f/no-functions c/no-completions C/no-config d/no-diff n/new V/vendor= -- $argv\0A\0A    if set -q _flag_help\0A        __fish_print_help fish_delta\0A        return 0\0A    end\0A\0A    type -q diff\0A    or set -l _flag_d --no-diff\0A\0A    set -l vendormode default\0A    if set -ql _flag_vendor[1]\0A        if not contains -- $_flag_vendor[-1] default ignore user\0A            echo \22Wrong vendor mode '$_flag_vendor[-1]'.\22 >&2\0A            echo \22Valid values are: default, ignore, new\22 >&2\0A            return 2\0A        end\0A        set vendormode $_flag_vendor[-1]\0A    end\0A\0A    # TODO: Do we want to keep the vendor dirs in here?\0A    set -l default_function_path $__fish_data_dir/functions\0A    test \22$vendormode\22 = default && set -a default_function_path $__fish_vendor_functionsdirs\0A\0A    set -l default_complete_path $__fish_data_dir/completions\0A    test \22$vendormode\22 = default && set -a default_complete_path $__fish_vendor_completionsdirs\0A\0A    set -l default_conf_path\0A    test \22$vendormode\22 = default && set -a default_conf_path $__fish_vendor_confdirs\0A\0A    set -l user_function_path\0A    set -l user_complete_path\0A    set -l user_conf_path $__fish_config_dir/conf.d $__fish_sysconf_dir/conf.d\0A    test \22$vendormode\22 = user && set -a user_conf_path $__fish_vendor_confdirs\0A\0A    for dir in $fish_function_path\0A        if contains -- $vendormode ignore default\0A            contains -- $dir $__fish_vendor_functionsdirs\0A            and continue\0A        end\0A        contains -- $dir $default_function_path\0A        or set -a user_function_path $dir\0A    end\0A    for dir in $fish_complete_path\0A        if contains -- $vendormode ignore default\0A            contains -- $dir $__fish_vendor_completionsdirs\0A            and continue\0A        end\0A        # We don't care about generated completions.\0A        # They shouldn't be compared at all.\0A        contains -- $dir $default_complete_path $__fish_cache_dir/generated_completions\0A        or set -a user_complete_path $dir\0A    end\0A\0A    set -l vars\0A    not set -ql _flag_f[1]\0A    and set -a vars user_function_path default_function_path\0A    not set -ql _flag_c[1]\0A    and set -a vars user_complete_path default_complete_path\0A    not set -ql _flag_C[1]\0A    and set -a vars user_conf_path default_conf_path\0A\0A    if not set -q vars[1]\0A        echo No directories to check! >&2\0A        return 2\0A    end\0A\0A    set -l have_diff 0\0A\0A    if isatty stdout\0A        set -f colors \22$(set_color normal)\22 \22$(set_color brblue)\22 \22$(set_color bryellow)\22 \22$(set_color green)\22 \22$(set_color red)\22\0A        set -f pager (__fish_anypager)\0A        or set pager cat\0A\0A        if type -q less\0A            set -l lessopts isRF\0A            if test (less --version | string match -r 'less (\\d+)')[2] -lt 530 2>/dev/null\0A                set lessopts \22$lessopts\22X\0A            end\0A\0A            not set -qx LESS\0A            and set -xf LESS $lessopts\0A        end\0A    else\0A        set -f colors \22\22 \22\22 \22\22 \22\22 \22\22\0A        set -f pager cat # cannot use a builtin here\0A    end\0A\0A    begin\0A        while set -q vars[1]\0A            set -l user_var $$vars[1]\0A            set -l default_var $$vars[2]\0A            set -l all_changed 0\0A            # We count config files as \22changed\22 compared to /dev/null\0A            # because they are being run.\0A            test \22$vars[1]\22 = user_conf_path\0A            and set all_changed 1\0A            set -l dir\0A            test \22$vars[2]\22 = default_complete_path\0A            and set dir completions\0A            test \22$vars[2]\22 = default_function_path\0A            and set dir functions\0A            set -e vars[..2]\0A            set -l files (path filter -rf -- $user_var/$argv.fish)\0A            set -q argv[1]\0A            or set files (path filter -rf -- $user_var/*)\0A            set -q files[1]\0A            and set have_diff 1\0A\0A            for file in $files\0A                set -l bn (path basename -- $file)\0A                set -l def (path filter -rf -- $default_var/$bn)[1]\0A                or set -l def (set -q dir[1] && status get-file $dir/$bn >/dev/null && echo embedded)\0A                or begin\0A                    if test $all_changed = 0\0A                        set -ql _flag_n\0A                        and printf (_ \22%sNew%s: %s\\n\22) $colors[2] $colors[1] $file\0A                        continue\0A                    else\0A                        set def /dev/null\0A                    end\0A                end\0A\0A                if type -q diff\0A                    # We execute diff twice - once to figure out if it's changed,\0A                    # so we can get nicer output.\0A                    #\0A                    if test \22$def\22 = embedded\0A                        if not status get-file $dir/$bn | diff -q -- $file - >/dev/null 2>&1\0A                            printf (_ \22%sChanged%s: %s\\n\22) $colors[3] $colors[1] $file\0A                            not set -ql _flag_d[1]\0A                            and status get-file $dir/$bn | diff -u -- - $file\0A                            continue\0A                        end\0A                    else\0A                        if not diff -q -- $file $def >/dev/null 2>&1\0A                            printf (_ \22%sChanged%s: %s\\n\22) $colors[3] $colors[1] $file\0A                            not set -ql _flag_d[1]\0A                            and diff -u -- $def $file\0A                            continue\0A                        end\0A                    end\0A                    printf (_ \22%sUnmodified%s: %s\\n\22) $colors[4] $colors[1] $file\0A                else\0A                    # Without diff, we can't really tell if the contents are the same.\0A                    printf (_ \22%sPossibly changed%s: %s\\n\22) $colors[3] $colors[1] $file\0A                end\0A            end\0A        end\0A        # config.fish is special - it's a single file, not a directory,\0A        # and it's not precedenced - *both* ~/.config/fish/config.fish and /etc/fish/config.fish\0A        # are executed.\0A        if not set -ql _flag_C[1]; and begin\0A                not set -q argv[1]\0A                or contains -- config $argv\0A            end\0A            for file in (path filter -rf -- $__fish_sysconf_dir/config.fish $__fish_config_dir/config.fish)\0A                # We count these as \22changed\22 so they show up.\0A                printf (_ \22%sChanged%s: %s\\n\22) $colors[3] $colors[1] $file\0A                not set -ql _flag_d[1]\0A                and diff -u -- /dev/null $file\0A            end\0A        end\0A        # Instead of using diff's --color=always, just do the coloring ourselves.\0A    end | string replace -r -- '^(-.*)$' \22$colors[5]\\$1$colors[1]\22 |\0A        string replace -r -- '^(\\+.*)$' \22$colors[4]\\$1$colors[1]\22 |\0A        $pager\0A\0A    return $have_diff\0Aend\0A", align 1
