@anon.1d0b41a8d45d477c3029ec78f9b8b434.2038 = private unnamed_addr constant [1710 x i8] c"#\0A# Command specific completions for the m4 command.\0A# These completions where generated from the commands\0A# man page by the make_completions.py script, but may\0A# have been hand edited since.\0A#\0A\0Acomplete -c m4 -l help -d 'Display this help and exit'\0Acomplete -c m4 -l version -d 'Output version information and exit'\0Acomplete -c m4 -s E -l fatal-warnings -d 'Once: warnings become errors, twice: stop execution at first error'\0Acomplete -c m4 -s i -l interactive -d 'Unbuffer output, ignore interrupts'\0Acomplete -c m4 -s P -l prefix-builtins -d 'Force a \\'m4_\\' prefix to all builtins'\0Acomplete -c m4 -s Q -l quiet -l silent -d 'Suppress some warnings for builtins'\0Acomplete -c m4 -l warn-macro-sequence -d 'Warn if macro definition matches REGEXP, default \\$\\({[^}]*}\\|[0-9][0-9]+\\)'\0Acomplete -c m4 -s D -l define -d 'Define NAME as having VALUE, or empty'\0Acomplete -c m4 -s I -l include -d 'Append DIRECTORY to include path'\0Acomplete -c m4 -s s -l synclines -d 'Generate \\'#line NUM \22FILE\22\\' lines'\0Acomplete -c m4 -s U -l undefine -d 'Undefine NAME'\0Acomplete -c m4 -s G -l traditional -d 'Suppress all GNU extensions'\0Acomplete -c m4 -s H -l hashsize -d 'Set symbol lookup hash table size [509]'\0Acomplete -c m4 -s L -l nesting-limit -d 'Change artificial nesting limit [1024]'\0Acomplete -c m4 -s F -l freeze-state -d 'Produce a frozen state on FILE at end'\0Acomplete -c m4 -s R -l reload-state -d 'Reload a frozen state from FILE at start'\0Acomplete -c m4 -s d -l debug -d 'Set debug level (no FLAGS implies \\'aeq\\')'\0Acomplete -c m4 -l debugfile -d 'Redirect debug and trace output'\0Acomplete -c m4 -s l -l arglength -d 'Restrict macro tracing size'\0Acomplete -c m4 -s t -l trace -d 'Trace NAME when it is defined'\0A", align 1
