@anon.1d0b41a8d45d477c3029ec78f9b8b434.2668 = private unnamed_addr constant [1090 x i8] c"function __fish_complete_su_env_whitelist\0A    env | string match -v -e -r '^(?:HOME|SHELL|USER|LOGNAME|PATH)=' | string replace -r '([^=]+)=(.*)' '$1\\t$2'\0Aend\0A\0Acomplete -c su -x -a \22(__fish_complete_users)\22\0A\0Acomplete -c su -s l -l login -d \22Make login shell\22\0Acomplete -c su -s c -l command -d \22Pass command to shell\22 -xa \22(complete -C '')\22\0Acomplete -c su -s f -l fast -d \22Pass -f to the shell\22\0Acomplete -c su -s g -l group -x -a \22(__fish_complete_groups)\22 -d \22Specify the primary group\22\0Acomplete -c su -s G -l supp-group -x -a \22(__fish_complete_groups)\22 -d \22Specify a supplemental group\22\0Acomplete -c su -s m -s p -l preserve_environment -d \22Preserve environment\22\0Acomplete -c su -s P -l pty -d \22Create pseudo-terminal for the session\22\0Acomplete -c su -s s -l shell -x -a \22(cat /etc/shells)\22 -d \22Run the specified shell\22\0Acomplete -c su -s w -l whitelist-environment -x -a \22(__fish_complete_list , __fish_complete_su_env_whitelist)\22 -d \22Don't reset these environment variables\22\0Acomplete -c su -s h -l help -d \22Display help and exit\22\0Acomplete -c su -s V -l version -d \22Display version and exit\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2669 = private unnamed_addr constant [21 x i8] c"completions/subl.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2670 = private unnamed_addr constant [1847 x i8] c"# Sublime Text build 3142\0A\0A# Usage: subl [arguments] [files]         edit the given files\0A#    or: subl [arguments] [directories]   open the given directories\0A#    or: subl [arguments] -               edit stdin\0A\0A# Arguments:\0A#   --project <project>: Load the given project\0A#   --command <command>: Run the given command\0A#   -n or --new-window:  Open a new window\0A#   -a or --add:         Add folders to the current window\0A#   -w or --wait:        Wait for the files to be closed before returning\0A#   -b or --background:  Don't activate the application\0A#   -s or --stay:        Keep the application activated after closing the file\0A#   -h or --help:        Show help (this message) and exit\0A#   -v or --version:     Show version and exit\0A\0A# --wait is implied if reading from stdin. Use --stay to not switch back\0A# to the terminal when a file is closed (only relevant if waiting for a file).\0A\0A# Filenames may be given a :line or :line:column suffix to open at a specific\0A# location.\0A\0Acomplete -c subl --long-option project --require-parameter -d \22Load the given project\22\0Acomplete -c subl --long-option command --require-parameter -d \22Run the given command\22\0Acomplete -c subl --short-option n --long-option new-window -d \22Open a new window\22\0Acomplete -c subl --short-option a --long-option add --require-parameter -d \22Add folders to the current window\22\0Acomplete -c subl --short-option w --long-option wait -d \22Wait for the files to be closed before returning\22\0Acomplete -c subl --short-option b --long-option background -d \22Don't activate the application\22\0Acomplete -c subl --short-option s --long-option stay -d \22Keep the application activated after closing the file\22\0Acomplete -c subl --short-option h --long-option help --exclusive -d \22Show help and exit\22\0Acomplete -c subl --short-option v --long-option version --exclusive -d \22Show version and exit\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2671 = private unnamed_addr constant [21 x i8] c"completions/sudo.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2672 = private unnamed_addr constant [3662 x i8] c"#\0A# Completion for sudo\0A#\0A\0Afunction __fish_sudo_print_remaining_args\0A    set -l tokens (commandline -xpc | string escape) (commandline -ct)\0A    set -e tokens[1]\0A    # These are all the options mentioned in the man page for Todd Miller's \22sudo.ws\22 sudo (in that order).\0A    # If any other implementation has different options, this should be harmless, since they shouldn't be used anyway.\0A    set -l opts A/askpass b/background C/close-from= E/preserve-env='?'\0A    # Note that \22-h\22 is both \22--host\22 (which takes an option) and \22--help\22 (which doesn't).\0A    # But `-h` as `--help` only counts when it's the only argument (`sudo -h`),\0A    # so any argument completion after that should take it as \22--host\22.\0A    set -a opts e/edit g/group= H/set-home h/host= 1-help\0A    set -a opts i/login K/remove-timestamp k/reset-timestamp l/list n/non-interactive\0A    set -a opts P/preserve-groups p/prompt= S/stdin s/shell U/other-user=\0A    set -a opts u/user= T/command-timeout= V/version v/validate\0A    argparse -s $opts -- $tokens 2>/dev/null\0A    # The remaining argv is the subcommand with all its options, which is what\0A    # we want.\0A    if test -n \22$argv\22\0A        and not string match -qr '^-' $argv[1]\0A        string join0 -- $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_sudo_no_subcommand\0A    not __fish_sudo_print_remaining_args >/dev/null\0Aend\0A\0Afunction __fish_complete_sudo_subcommand\0A    set -l args (__fish_sudo_print_remaining_args | string split0)\0A    set -lx -a PATH /usr/local/sbin /sbin /usr/sbin\0A    __fish_complete_subcommand --commandline $args\0Aend\0A\0A# All these options should be valid for GNU and OSX sudo\0Acomplete -c sudo -n __fish_no_arguments -s h -d \22Display help and exit\22\0Acomplete -c sudo -n __fish_no_arguments -s V -d \22Display version information and exit\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s A -d \22Ask for password via the askpass or \\$SSH_ASKPASS program\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s C -d \22Close all file descriptors greater or equal to the given number\22 -xa \220 1 2 255\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s E -d \22Preserve environment\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s H -d \22Set home\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s K -d \22Remove the credential timestamp entirely\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s P -d \22Preserve group vector\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s S -d \22Read password from stdin\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s b -d \22Run command in the background\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s e -rF -d Edit\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s g -a \22(__fish_complete_groups)\22 -x -d \22Run command as group\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s i -d \22Run a login shell\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s k -d \22Reset or ignore the credential timestamp\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s l -d \22List the allowed and forbidden commands for the given user\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s n -d \22Do not prompt for a password - if one is needed, fail\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s p -d \22Specify a custom password prompt\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s s -d \22Run the given command in a shell\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s u -a \22(__fish_complete_users)\22 -x -d \22Run command as user\22\0Acomplete -c sudo -n __fish_sudo_no_subcommand -s v -n __fish_no_arguments -d \22Validate the credentials, extending timeout\22\0A\0A# Complete the command we are executed under sudo\0Acomplete -c sudo -x -n 'not __fish_seen_argument -s e' -a \22(__fish_complete_sudo_subcommand)\22\0A", align 1
