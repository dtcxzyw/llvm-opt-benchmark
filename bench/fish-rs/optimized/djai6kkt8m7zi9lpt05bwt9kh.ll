@anon.1d0b41a8d45d477c3029ec78f9b8b434.3581 = private unnamed_addr constant [522 x i8] c"# name: Simple\0A\0Afunction fish_prompt\0A    # This is a simple prompt. It looks like\0A    # alfa@nobby /path/to/dir $\0A    # with the path shortened and colored\0A    # and a \22#\22 instead of a \22$\22 when run as root.\0A    set -l symbol ' $ '\0A    set -l color $fish_color_cwd\0A    if fish_is_root_user\0A        set symbol ' # '\0A        set -q fish_color_cwd_root\0A        and set color $fish_color_cwd_root\0A    end\0A\0A    echo -n $USER@$hostname\0A\0A    set_color $color\0A    echo -n (prompt_pwd)\0A    set_color normal\0A\0A    echo -n $symbol\0Aend\0A", align 1
