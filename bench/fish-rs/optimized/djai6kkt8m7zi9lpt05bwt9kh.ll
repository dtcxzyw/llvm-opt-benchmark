@anon.1d0b41a8d45d477c3029ec78f9b8b434.2082 = private unnamed_addr constant [27589 x i8] c"# Completions for the meson build system (http://mesonbuild.com/)\0A\0Afunction __fish_meson_needs_command\0A    set -l cmd (commandline -xpc)\0A    set -e cmd[1]\0A    argparse -s v/version -- $cmd 2>/dev/null\0A    or return 0\0A    not set -q argv[1]\0Aend\0A\0Afunction __fish_meson_using_command\0A    set -l cmd (commandline -xpc)\0A    set -e cmd[1]\0A    test (count $cmd) -eq 0\0A    and return 1\0A    contains -- $cmd[1] $argv\0A    and return 0\0Aend\0A\0Afunction __fish_meson_builddir\0A    # Consider the value of -C option to detect the build directory\0A    set -l cmd (commandline -xpc)\0A    argparse -i 'C=' -- $cmd\0A    if set -q _flag_C\0A        echo $_flag_C\0A    else\0A        echo .\0A    end\0Aend\0A\0Afunction __fish_meson_targets\0A    set -l python (__fish_anypython); or return\0A    meson introspect --targets (__fish_meson_builddir) | $python -S -c 'import json, sys\0Adata = json.load(sys.stdin)\0Atargets = set()\0Afor target in data:\0A    targets.add(target[\22name\22])\0Afor name in targets:\0A    print(name)' 2>/dev/null\0Aend\0A\0Afunction __fish_meson_subprojects\0A    set -l python (__fish_anypython); or return\0A    meson introspect --projectinfo (__fish_meson_builddir) | $python -S -c 'import json, sys\0Adata = json.load(sys.stdin)\0Afor subproject in data[\22subprojects\22]:\0A    print(subproject[\22name\22])' 2>/dev/null\0Aend\0A\0Afunction __fish_meson_tests\0A    # --list option shows suites in a short form, e.g. if a test \22gvariant\22\0A    # is present both in \22glib:glib\22 and \22glib:slow\22 suites, it will be shown\0A    # in a list as \22glib:glib+slow / gvariant\22. So, just filter out the first\0A    # part and list all of the test names.\0A    meson test -C (__fish_meson_builddir) --no-rebuild --list | string split -r -f1 ' / '\0Aend\0A\0Afunction __fish_meson_test_suites\0A    set -l python (__fish_anypython); or return\0A    meson introspect --tests (__fish_meson_builddir) | $python -S -c 'import json, sys\0Adata = json.load(sys.stdin)\0Asuites = set()\0Afor test in data:\0A    suites.update(test[\22suite\22])\0Afor name in suites:\0A    print(name)' 2>/dev/null\0Aend\0A\0Afunction __fish_meson_help_commands\0A    meson help --help | string match -g -r '^ *{(.*)}' | string split ,\0Aend\0A\0A# Each meson command and subcommand has -h/--help option\0Acomplete -c meson -s h -l help -d 'Show help'\0A\0A# In order to prevent directory completions from being mixed in with subcommand completions,\0A# we need to use -kxa instead of -xa and make sure we do the directory completions first.\0A# In order for subcommands to be sorted alphabetically, we need to make sure that we compose\0A# them in the reverse alphabetical order and use -kxa there as well.\0A\0A# This is to support the implicit setup/configure mode, deprecated upstream but not yet removed.\0Acomplete -c meson -n __fish_meson_needs_command -kxa '(__fish_complete_directories)'\0A\0A### wrap\0Aset -l wrap_cmds list search install update info status promote update-db\0Acomplete -c meson -n __fish_meson_needs_command -kxa wrap -d 'Manage WrapDB dependencies'\0Acomplete -c meson -n \22__fish_meson_using_command wrap; and not __fish_seen_subcommand_from $wrap_cmds\22 -xa '\0Alist\\t\22Show all available projects\22\0Asearch\\t\22Search the db by name\22\0Ainstall\\t\22Install the specified project\22\0Aupdate\\t\22Update wrap files from WrapDB\22\0Ainfo\\t\22Show available versions of a project\22\0Astatus\\t\22Show installed and available versions of your projects\22\0Apromote\\t\22Bring a subsubproject up to the master project\22\0Aupdate-db\\t\22Update list of projects available in WrapDB\22\0A'\0Acomplete -c meson -n \22__fish_meson_using_command wrap; and __fish_seen_subcommand_from $wrap_cmds\22 -l allow-insecure -d 'Allow insecure server connections'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from update' -l force -d 'Update wraps that does not seems to come from WrapDB'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from update' -l sourcedir -xa '(__fish_complete_directories)' -d 'Source directory'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from update' -l types -x -d 'Comma-separated list of subproject types'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from update' -l num-processes -x -d 'How many parallel processes to use'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from update' -l allow-insecure -x -d 'Allow insecure server connections'\0Acomplete -c meson -n '__fish_meson_using_command wrap; and __fish_seen_subcommand_from promote' -xa '(__fish_complete_directories)' -d 'Project path'\0A\0A### test\0Acomplete -c meson -n __fish_meson_needs_command -kxa test -d 'Run tests for the project'\0A# TODO: meson allows to pass just \22testname\22 to run all tests with that name,\0A# or \22subprojname:testname\22 to run \22testname\22 from \22subprojname\22,\0A# or \22subprojname:\22 to run all tests defined by \22subprojname\22,\0A# but completion is only handled for the \22testname\22.\0Acomplete -c meson -n '__fish_meson_using_command test' -xa '(__fish_meson_tests)'\0Acomplete -c meson -n '__fish_meson_using_command test' -s h -l help -d 'Show help'\0Acomplete -c meson -n '__fish_meson_using_command test' -s C -xa '(__fish_complete_directories)' -d 'Directory to cd into before running'\0Acomplete -c meson -n '__fish_meson_using_command test' -l maxfail -x -d 'Number of failing tests before aborting the test run'\0Acomplete -c meson -n '__fish_meson_using_command test' -l repeat -x -d 'Number of times to run the tests'\0Acomplete -c meson -n '__fish_meson_using_command test' -l no-rebuild -d 'Do not rebuild before running tests'\0Acomplete -c meson -n '__fish_meson_using_command test' -l gdb -d 'Run test under gdb'\0Acomplete -c meson -n '__fish_meson_using_command test' -l gdb-path -r -d 'Run test under gdb'\0Acomplete -c meson -n '__fish_meson_using_command test' -l list -d 'List available tests'\0Acomplete -c meson -n '__fish_meson_using_command test' -l wrapper -r -d 'Wrapper to run tests with (e.g. valgrind)'\0Acomplete -c meson -n '__fish_meson_using_command test' -l suite -xa '(__fish_meson_test_suites)' -d 'Only run tests belonging to the given suite'\0Acomplete -c meson -n '__fish_meson_using_command test' -l no-suite -xa '(__fish_meson_test_suites)' -d 'Do not run tests belonging to the given suite'\0Acomplete -c meson -n '__fish_meson_using_command test' -l no-stdsplit -d 'Do not split stderr and stdout in test logs'\0Acomplete -c meson -n '__fish_meson_using_command test' -l print-errorlogs -d 'Print logs of failing tests'\0Acomplete -c meson -n '__fish_meson_using_command test' -l benchmark -d 'Run benchmarks instead of tests'\0Acomplete -c meson -n '__fish_meson_using_command test' -l logbase -x -d 'Base name for log file'\0Acomplete -c meson -n '__fish_meson_using_command test' -l num-processes -x -d 'How many parallel processes to use'\0Acomplete -c meson -n '__fish_meson_using_command test' -s v -l verbose -d 'Do not redirect stdout and stderr'\0Acomplete -c meson -n '__fish_meson_using_command test' -s q -l quiet -d 'Produce less output to the terminal'\0Acomplete -c meson -n '__fish_meson_using_command test' -s t -l timeout-multiplier -x -d 'Multiplier for test timeout'\0Acomplete -c meson -n '__fish_meson_using_command test' -l setup -x -d 'Which test setup to use'\0Acomplete -c meson -n '__fish_meson_using_command test' -l test-args -x -d 'Arguments to pass to the test(s)'\0A\0A### subprojects\0Aset -l subprojects_cmds update checkout download foreach purge packagefiles\0Acomplete -c meson -n __fish_meson_needs_command -kxa subprojects -d 'Manage subprojects'\0Acomplete -c meson -n \22__fish_meson_using_command subprojects; and not __fish_seen_subcommand_from $subprojects_cmds\22 -xa '\0Aupdate\\t\22Update all subprojects\22\0Acheckout\\t\22Checkout a branch (git only)\22\0Adownload\\t\22Ensure subprojects are fetched\22\0Aforeach\\t\22Execute a command in each subproject\22\0Apurge\\t\22Remove all wrap-based subproject artifacts\22\0Apackagefiles\\t\22Manage the packagefiles overlay\22\0A'\0Acomplete -c meson -n \22__fish_meson_using_command subprojects; and __fish_seen_subcommand_from $subprojects_cmds\22 -l sourcedir -xa '(__fish_complete_directories)' -d 'Path to source directory'\0Acomplete -c meson -n \22__fish_meson_using_command subprojects; and __fish_seen_subcommand_from $subprojects_cmds\22 -l types -xa 'file git hg svn' -d 'Comma-separated list of subproject types'\0Acomplete -c meson -n \22__fish_meson_using_command subprojects; and __fish_seen_subcommand_from $subprojects_cmds\22 -l num-processes -x -d 'How many parallel processes to use'\0Acomplete -c meson -n \22__fish_meson_using_command subprojects; and __fish_seen_subcommand_from $subprojects_cmds\22 -l allow-insecure -x -d 'Allow insecure server connections'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from update' -l reset -d 'Checkout wrap\\'s revision and hard reset to that commit'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from checkout' -s b -d 'Create a new branch'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from purge' -l include-cache -d 'Remove the package cache as well'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from purge' -l confirm -d 'Confirm the removal of subproject artifacts'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from packagefiles' -l apply -d 'Apply packagefiles to the subproject'\0Acomplete -c meson -n '__fish_meson_using_command subprojects; and __fish_seen_subcommand_from packagefiles' -l save -d 'Save packagefiles from the subproject'\0A\0A### setup\0Acomplete -c meson -n __fish_meson_needs_command -kxa setup -d 'Configure a build directory'\0A# All of the setup options are also exposed to the global scope\0A# Use -k here for one of the cases to make sure directories come after any other top-level completions\0Acomplete -c meson -n '__fish_meson_using_command setup' -xa '(__fish_complete_directories)'\0A# A lot of options are shared for \22setup\22 and \22configure\22 commands\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l prefix -xa '(__fish_complete_directories)' -d 'Installation prefix'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l bindir -xa '(__fish_complete_directories)' -d 'Executable directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l datadir -xa '(__fish_complete_directories)' -d 'Data file directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l includedir -xa '(__fish_complete_directories)' -d 'Header file directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l infodir -xa '(__fish_complete_directories)' -d 'Info page directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l libdir -xa '(__fish_complete_directories)' -d 'Library directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l licensedir -xa '(__fish_complete_directories)' -d 'Licenses directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l libexecdir -xa '(__fish_complete_directories)' -d 'Library executable directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l localedir -xa '(__fish_complete_directories)' -d 'Locale data directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l localstatedir -xa '(__fish_complete_directories)' -d 'Localstate data directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l mandir -xa '(__fish_complete_directories)' -d 'Manual page directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l sbindir -xa '(__fish_complete_directories)' -d 'System executable directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l sharedstatedir -xa '(__fish_complete_directories)' -d 'Architecture-independent data directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l sysconfdir -xa '(__fish_complete_directories)' -d 'Sysconf data directory'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l auto-features -xa 'enabled disabled auto' -d 'Override value of all \22auto\22 features'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l backend -xa 'ninja vs vs2010 vs2012 vs2013 vs2015 vs2017 vs2019 vs2022 xcode' -d 'Backend to use'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l buildtype -xa 'plain debug debugoptimized release minsize custom' -d 'Build type to use'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l debug -d 'Enable debug symbols and other info'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l default-library -xa 'shared static both' -d 'Default library type'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l errorlogs -d 'Print the logs from failing tests'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l install-umask -x -d 'Default umask to apply on permissions of installed files'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l layout -xa 'mirror flat' -d 'Build directory layout'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l optimization -xa 'plain 0 g 1 2 3 s' -d 'Optimization level'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l prefer-static -d 'Try static linking before shared linking'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l stdsplit -d 'Split stdout and stderr in test logs'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l strip -d 'Strip targets on install'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l unity -xa 'on off subprojects' -d 'Unity build'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l unity-size -x -d 'Unity block size'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l warnlevel -xa '0 1 2 3 everything' -d 'Compiler warning level to use'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l werror -d 'Treat warnings as errors'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l wrap-mode -xa 'default nofallback nodownload forcefallback nopromote' -d 'Wrap mode'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup configure' -l force-fallback-for -x -d 'Force fallback for those subprojects'\0Acomplete -c meson -n '__fish_meson_needs_command || __fish_meson_using_command setup config