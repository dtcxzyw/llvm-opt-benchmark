@anon.1d0b41a8d45d477c3029ec78f9b8b434.1164 = private unnamed_addr constant [7100 x i8] c"# AS - the portable GNU assembler\0A# See: https://www.gnu.org/software/binutils\0A\0Acomplete -c as -o ac -d 'Omit false conditionals'\0Acomplete -c as -o ad -d 'Omit debugging directives'\0Acomplete -c as -o ag -d 'Include general information'\0Acomplete -c as -o ah -d 'Include high-level source'\0Acomplete -c as -o al -d 'Include assembly'\0Acomplete -c as -o am -d 'Include macro expansions'\0Acomplete -c as -o an -d 'Omit forms processing'\0Acomplete -c as -o as -d 'Include symbols'\0A\0Acomplete -c as -l alternate -d 'Initially turn on alternate macro syntax'\0Acomplete -c as -l compress-debug-sections -a 'none zlib zlib-gnu zlib-gabi' -x -d 'Compress DWARF debug sections using zlib'\0Acomplete -c as -l nocompress-debug-sections -d 'Don\\'t compress DWARF debug sections'\0Acomplete -c as -s D -d 'Produce assembler debugging messages'\0Acomplete -c as -l debug-prefix-map -x -d 'Remap debug information'\0Acomplete -c as -l defsym -x -d 'Redefine symbols'\0Acomplete -c as -l execstack -d 'Require executable stack for this object'\0Acomplete -c as -l noexecstack -d 'Don\\'t require executable stack for this object'\0Acomplete -c as -l size-check -a 'error\\tDefault warning' -x -d 'ELF .size directive check'\0Acomplete -c as -l elf-stt-common -a 'yes no' -d 'Generate ELF common symbols with STT_COMMON type'\0Acomplete -c as -l sectname-subst -d 'Enable section name substitution sequences'\0Acomplete -c as -s f -d 'Skip whitespace and comment preprocessing'\0Acomplete -c as -l gen-debug -s g -d 'Generate debugging information'\0Acomplete -c as -l gstabs -d 'Generate STABS debugging information'\0Acomplete -c as -l 'gstabs+' -d 'Generate STABS debug info with GNU extensions'\0Acomplete -c as -l gdwarf-2 -d 'Generate DWARF2 debugging information'\0Acomplete -c as -l gdwarf-sections -d 'Generate per-function section names for DWARF line information'\0Acomplete -c as -l hash-size -x