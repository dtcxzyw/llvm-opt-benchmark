@anon.1d0b41a8d45d477c3029ec78f9b8b434.3452 = private unnamed_addr constant [328 x i8] c"# To know if the user is root. Used by several prompts to display something\0A# else if the user is root.\0A\0Afunction fish_is_root_user --description \22Check if the user is root\22\0A    if test \22$EUID\22 = 0 2>/dev/null\0A        return 0\0A    end\0A\0A    if contains -- $USER root toor Administrator\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A", align 1
