@anon.1d0b41a8d45d477c3029ec78f9b8b434.1436 = private unnamed_addr constant [4759 x i8] c"# Current as of cwebp 1.0.3.\0A\0Aset -l preset_opts '\0A    default\\t\0A    photo\\t\0A    picture\\t\0A    drawing\\t\0A    icon\\t\0A    text\\t\0A'\0A\0Aset -l z_opts '\0A    0\\tfastest\0A    1\\t\0A    2\\t\0A    3\\t\0A    4\\t\0A    5\\t\0A    6\\t\0A    7\\t\0A    8\\t\0A    9\\tslowest\0A'\0A\0Aset -l m_opts '\0A    0\\tfastest\0A    1\\t\0A    2\\t\0A    3\\t\0A    4\\tdefault\0A    5\\t\0A    6\\tslowest\0A'\0A\0Aset -l segments_opts '\0A    1\\t\0A    2\\t\0A    3\\t\0A    4\\tdefault\0A'\0A\0Aset -l sharpness_opts '\0A    0\\tmost sharp; default\0A    1\\t\0A    2\\t\0A    3\\t\0A    4\\t\0A    5\\t\0A    6\\t\0A    7\\tleast sharp\0A'\0A\0Aset -l alpha_method_opts '\0A    0\\t\0A    1\\tdefault\0A'\0A\0Aset -l alpha_filter_opts '\0A    none\\t\0A    fast\\tdefault\0A    best\\t\0A'\0A\0Aset -l metadata_opts '\0A    all\\t\0A    none\\tdefault\0A    exif\\t\0A    icc\\t\0A    xmp\\t\0A'\0A\0Afunction __fish_cwebp_is_first_arg_or_its_value -a arg -d 'Like __fish_is_first_arg, but also returns true for the second token after a given parameter'\0A    set -l tokens (commandline -cx)\0A\0A    switch (count $tokens)\0A        case 1\0A            return 0\0A        case 2\0A            if test \22$tokens[2]\22 = \22$arg\22\0A                return 0\0A            end\0A            return 1\0A        case '*'\0A            return 1\0A    end\0Aend\0A\0Acomplete -c cwebp -f -o h -o help -d 'Help (short)'\0Acomplete -c cwebp -f -o H -o longhelp -l help -d 'Help (long)'\0A\0Acomplete -c cwebp -x -o q -d 'Quality (float; 0\E2\80\A6100; default: 75)'\0Acomplete -c cwebp -x -o alpha_q -d 'Transparency-compression quality (integer 0\E2\80\A6100; default: 100)'\0A\0Acomplete -c cwebp -x -n '__fish_cwebp_is_first_arg_or_its_value -preset' -o preset -a $preset_opts -d 'Preset setting'\0A\0Acomplete -c cwebp -x -o z -a \22$z_opts\22 -d 'Lossless preset of level'\0Acomplete -c cwebp -x -o m -a \22$m_opts\22 -d 'Compression method'\0Acomplete -c cwebp -x -o segments -a \22$segments_opts\22 -d 'Number of segments to use'\0Acomplete -c cwebp -x -o size -d 'Target size (in bytes)'\0Acomplete -c cwebp -x -o psnr -d 'Target PSNR (in dB; typically: 42)'\0A\0Acomplete -c cwebp -x -o s -d 'Input size (width x height) for YUV'\0Acomplete -c cwebp -x -o sns -d 'Spatial noise shaping (integer 0\E2\80\A6100; default: 50)'\0Acomplete -c cwebp -x -o f -d 'Filter strength (integer 0\E2\80\A6100; default: 60)'\0Acomplete -c cwebp -x -o sharpness -a \22$sharpness_opts\22 -d 'Filter sharpness'\0Acomplete -c cwebp -o strong -d 'Use strong filter'\0Acomplete -c cwebp -o simple -d 'Use simple filter'\0Acomplete -c cwebp -o sharp_yuv -d 'Use sharper (and slower) RGB->YUV conversion'\0Acomplete -c cwebp -x -o partition_limit -d 'Limit quality to fit 512k limit on first partition (0:no degradation\E2\80\A6100:full degradation)'\0Acomplete -c cwebp -x -o pass -a '(seq 0 10)' -d 'Analysis pass number'\0Acomplete -c cwebp -x -o crop -d 'Crop picture with <x> <y> <v> <h> rectangle'\0Acomplete -c cwebp -x -o resize -d 'Resize picture to <w> <h> after any cropping'\0Acomplete -c cwebp -o mt -d 'Use multi-threading if available'\0Acomplete -c cwebp -o low_memory -d 'Reduce memory usage (slows encoding)'\0Acomplete -c cwebp -x -o map -d 'Print map of extra info'\0Acomplete -c cwebp -o print_psnr -d 'Print averaged PSNR distortion'\0Acomplete -c cwebp -o print_ssim -d 'Print averaged SSIM distortion'\0Acomplete -c cwebp -o print_lsim -d 'Print local-similarity distortion'\0Acomplete -c cwebp -r -o d -k -a '(__fish_complete_suffix .pgm)' -d 'Dump compressed output to given PGM file'\0Acomplete -c cwebp -x -o alpha_method -a \22$alpha_method_opts\22 -d 'Transparency-compression method'\0Acomplete -c cwebp -x -o alpha_filter -a \22$alpha_filter_opts\22 -k -d 'Predictive filtering for alpha plane'\0Acomplete -c cwebp -x -o exact -d 'Preserve RGB values in transparent area'\0Acomplete -c cwebp -x -o blend_alpha -d 'Blend colors against background color (e.g. 0xc0e0d0)'\0Acomplete -c cwebp -o noalpha -d 'Discard any transparency information'\0Acomplete -c cwebp -o lossless -d 'Encode image losslessly'\0Acomplete -c cwebp -x -o near_lossless -d 'Use near-lossless image preprocessing (integer 0\E2\80\A6100:off; default: 100)'\0Acomplete -c cwebp -x -o hint -a 'photo picture graph' -d 'Specify image-characteristics hint'\0A\0Acomplete -c cwebp -x -o metadata -a \22$metadata_opts\22 -k -d 'Comma-separated list of metadata to copy, if present'\0A\0Acomplete -c cwebp -o short -d 'Condense printed messages'\0Acomplete -c cwebp -o quiet -d 'Don\\'t print anything'\0Acomplete -c cwebp -o version -d 'Print version number and exit'\0Acomplete -c cwebp -o noasm -d 'Disable all assembly optimizations'\0Acomplete -c cwebp -o v -d 'Be verbose (print encoding/decoding times)'\0Acomplete -c cwebp -o progress -d 'Report encoding progress'\0A\0Acomplete -c cwebp -o jpeg_like -d 'Roughly match expected JPEG size'\0Acomplete -c cwebp -o af -d 'Auto-adjust filter strength'\0Acomplete -c cwebp -x -o pre -d 'Pre-processing filter (integer)'\0A\0Acomplete -c cwebp -r -o o -k -a '(__fish_complete_suffix .webp)' -d 'Output to file'\0A", align 1
