@anon.1d0b41a8d45d477c3029ec78f9b8b434.2656 = private unnamed_addr constant [1394 x i8] c"if stat --version 2>/dev/null >/dev/null # GNU\0A    complete -c stat -s L -l dereference -d 'follow links'\0A    complete -c stat -s f -l file-system -d 'display file system status instead of file status'\0A    complete -c stat -s c -l format -x -d 'use the specified FORMAT, with implicit newline'\0A    complete -c stat -l printf -x -d 'use specified FORMAT, with backslash escapes and no implicit trailing newline'\0A    complete -c stat -s t -l terse -d 'print the information in terse form'\0A    complete -c stat -l help -d 'display this help and exit'\0A    complete -c stat -l version -d 'output version information and exit'\0Aelse # OS X\0A    complete -c stat -s F -d \22Display content type symbols similar to ls(1)\22\0A    complete -c stat -s f -d \22Display information using specified FORMAT\22 -r\0A    complete -c stat -s L -d \22Use stat(2) instead of lsstat(2)\22\0A    complete -c stat -s l -d \22Display output in ls -lT format\22\0A    complete -c stat -s n -d \22Don't force a newline to appear at end of each piece of output\22\0A    complete -c stat -s q -d \22Suppress failure messages\22\0A    complete -c stat -s r -d \22Display raw information\22\0A    complete -c stat -s s -d \22Display informationin ``shell output'' suitable for initialising variables\22\0A    complete -c stat -s t -d \22Display timestamps using specified FORMAT\22 -r\0A    complete -c stat -s x -d \22Verbose information, similar to some Linux distributions\22\0Aend\0A", align 1
