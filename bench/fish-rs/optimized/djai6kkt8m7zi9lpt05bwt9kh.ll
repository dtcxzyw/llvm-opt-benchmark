@anon.1d0b41a8d45d477c3029ec78f9b8b434.1938 = private unnamed_addr constant [377 x i8] c"function __fish_list_loaded_klds\0A    set -l klds (kldstat | string match -r '\\b\\S+.ko$')\0A    for kld in $klds\0A        if set -l description (__fish_whatis (string replace '.ko' '' -- $kld) \22kernel module\22)\0A            printf '%s\\t%s\\n' $kld $description\0A        else\0A            printf '%s\\n' $kld\0A        end\0A    end\0Aend\0A\0Acomplete -c kldunload -xa '(__fish_list_loaded_klds)'\0A", align 1
