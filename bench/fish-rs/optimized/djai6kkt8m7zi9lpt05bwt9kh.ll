@anon.1d0b41a8d45d477c3029ec78f9b8b434.1238 = private unnamed_addr constant [2439 x i8] c"function __bower_cmds\0A    echo -en \22cache\\tManage bower cache\0Ahelp\\tDisplay help information about Bower\0Ahome\\tOpens a package homepage into your favorite browser\0Ainfo\\tInfo of a particular package\0Ainit\\tInteractively create a bower.json file\0Ainstall\\tInstall a package locally\0Alink\\tSymlink a package folder\0Alist\\tList local packages - and possible updates\0Alogin\\tAuthenticate with GitHub and store credentials\0Alookup\\tLook up a single package URL by name\0Aprune\\tRemoves local extraneous packages\0Aregister\\tRegister a package\0Asearch\\tSearch for packages by name\0Aupdate\\tUpdate a local package\0Auninstall\\tRemove a local package\0Aunregister\\tRemove a package from the registry\0Aversion\\tBump a package version\0A\22\0Aend\0A\0Afunction __bower_args\0A    echo -en \22-f\\tMakes various commands more forceful\0A--force\\tMakes various commands more forceful\0A-j\\tOutput consumable JSON\0A--json\\tOutput consumable JSON\0A-l\\tWhat level of logs to report\0A--loglevel\\tWhat level of logs to report\0A-o\\tDo not hit the network\0A--offline\\tDo not hit the network\0A-q\\tOnly output important information\0A--quiet\\tOnly output important information\0A-s\\tDo not output anything, besides errors\0A--silent\\tDo not output anything, besides errors\0A-V\\tMakes output more verbose\0A--verbose\\tMakes output more verbose\0A--allow-root\\tAllows running commands as root\0A-v\\tOutput Bower version\0A--version\\tOutput Bower version\0A--no-color\\tDisable colors\22\0Aend\0A\0Afunction __bower_matching_pkgs\0A    bower search (commandline -ct) | string match -r \22\\S+[^\\s]\22 | string match -v Search\0Aend\0A\0A# Output of `bower list` is a) slow, b) convoluted. Use `python` or `jq` instead.\0Afunction __bower_list_installed\0A    if not test -e bower.json\0A        return 1\0A    end\0A\0A    if set -l python (__fish_anypython)\0A        # Warning: That weird indentation is necessary, because python.\0A        $python -S -c 'import json, sys; data = json.load(sys.stdin);\0Afor k,v in data[\22dependencies\22].items(): print(k + \22\\t\22 + v[:18])' <bower.json 2>/dev/null\0A        return\0A    end\0A\0A    if not type -q jq\0A        return 1\0A    end\0A\0A    jq -r '.dependencies | to_entries[] | .key' bower.json\0Aend\0A\0Acomplete -c bower -n \22__fish_is_nth_token 1\22 -x -a '(__bower_cmds)'\0Acomplete -c bower -n __fish_should_complete_switches -x -a '(__bower_args)'\0Acomplete -c bower -n \22__fish_seen_subcommand_from install\22 -x -a '(__bower_matching_pkgs)'\0Acomplete -c bower -n \22__fish_seen_subcommand_from uninstall\22 -x -a '(__bower_list_installed)'\0A", align 1
