@anon.1d0b41a8d45d477c3029ec78f9b8b434.1974 = private unnamed_addr constant [7733 x i8] c"# Completions for simonw/llm\0A\0Aset -l subcmds prompt aliases chat collections embed embed-models embed-multi install keys logs models openai plugins similar templates uninstall\0Afunction __fish_llm_subcmds\0A    printf \22%s\\t%s\\n\22 prompt \22Execute a prompt\22 \\\0A        aliases \22Manage model aliases\22 \\\0A        chat \22Hold chat with model\22 \\\0A        collections \22View/manage embedding collections\22 \\\0A        embed \22Embed text and get/store result\22 \\\0A        embed-models \22Manage available embedding models\22 \\\0A        embed-multi \22Store embeddings for multiple strings\22 \\\0A        install \22Install PyPI packages into llm env\22 \\\0A        keys \22Manage stored API keys\22 \\\0A        logs \22Explore logged prompts/responses\22 \\\0A        models \22Manage available models\22 \\\0A        openai \22Work with OpenAI API directly\22 \\\0A        plugins \22List installed plugins\22 \\\0A        similar \22Return top-N similar IDs for collection\22 \\\0A        templates \22Manage stored prompt templates\22 \\\0A        uninstall \22Uninstall Python packages from llm env\22\0Aend\0A\0Acomplete -c llm -n __fish_is_first_token -xa \22(__fish_llm_subcmds)\22\0A\0A# This applies to the base command only\0Acomplete -c llm -n \22not __fish_seen_subcommand_from $subcmds\22 -l version -d \22Show version info\22\0A# This applies to the base command or any subcommands\0Acomplete -c llm -l help -d \22Show command usage info\22 -x\0A\0Afunction __fish_llm_models\0A    llm models |\0A        string replace -r '^[^:\\\\n]+: (\\\\S+)(?: \\\\(aliases: )?((?:[^),\\\\s]+,?)?+.*?)\\\\)?$' '$1 $2' |\0A        string split ' ' -n |\0A        string trim -c ','\0Aend\0A\0Afunction __fish_embedding_models\0A    llm models |\0A        string replace -r '^[^:\\\\n]+: (\\\\S+)(?: \\\\(aliases: )?((?:[^),\\\\s]+,?)?+.*?)\\\\)?$' '$1 $2' |\0A        string split ' ' -n |\0A        string trim -c ','\0Aend\0A\0A# The default subcommand is 'prompt'\0Aset -l condition \22not __fish_seen_subcommand_from $subcmds || __fish_seen_subcommand_from prompt\22\0Acomplete -c llm -n $condition -s s -l system -d \22System prompt to use\22 -r\0Acomplete -c llm -n $condition -s m -l model -d \22Model to use\22 -xa \22(__fish_llm_models)\22\0Acomplete -c llm -n $condition -s a -l attachment -d \22Attachment to use\22 -ra-\0Acomplete -c llm -n $condition -l at -d \22Attachment type\22 -r\0Acomplete -c llm -n $condition -l attachment-type -d \22Attachment type\22 -r\0Acomplete -c llm -n $condition -s n -l no-log -d \22Don't log to db\22 -x\0Acomplete -c llm -n $condition -s l -l log -d \22Log prompt/reply to db\22 -x\0Acomplete -c llm -n $condition -s c -l continue -d \22Continue most recent conversation\22 -x\0Acomplete -c llm -n $condition -l key -d \22API key to use\22 -r\0Acomplete -c llm -n $condition -l save -d \22Save prompt as template with name\22 -x\0A\0A# llm aliases\0Aset -l condition \22__fish_seen_subcommand_from aliases\22\0Acomplete -c llm -n $condition -n '__fish_is_nth_token 2' -xa list -d \22List current aliases\22 -x\0Acomplete -c llm -n $condition -n '__fish_is_nth_token 2' -xa path -d \22Print path of llm's aliases.json\22 -x\0Acomplete -c llm -n $condition -n '__fish_is_nth_token 2' -xa remove -d \22Remove an llm alias\22 -r\0Acomplete -c llm -n $condition -n '__fish_is_nth_token 2' -xa set -d \22Set an alias for a model\22 -r\0Acomplete -c llm -n $condition -n '__fish_is_nth_token 4' -xa \22(__fish_llm_models)\22 -d \22Alias target model\22\0A\0A# llm chat\0Aset -l condition \22__fish_seen_subcommand_from chat\22\0Acomplete -c llm -n $condition -s s -l system -d \22System prompt to use\22 -r\0Acomplete -c llm -n $condition -s m -l model -d \22Model to use\22 -xa \22(__fish_llm_models)\22\0Acomplete -c llm -n $condition -l cid -d \22Continue conversation with given id\22 -x\0Acomplete -c llm -n $condition -l conversation -d \22Continue conversation with given id\22 -x\0Acomplete -c llm -n $condition -s t -l template -d \22Template to use\22 -x\0Acomplete -c llm -n $condition -s p -l param -d \22Set template parameter to value\22 -x\0Acomplete -c llm -n $condition -s o -l option -d \22Set key/value option for model\22 -x\0Acomplete -c llm -n $condition -l no-stream -d \22Do not stream output\22 -x\0Acomplete -c llm -n $condition -l key -d \22API key to use\22 -x\0A\0A# llm collections\0Aset -l condition \22__fish_seen_subcommand_from collections\22\0Acomplete -c llm -n $condition -xa list -d \22List collections\22 -x\0Acomplete -c llm -n $condition -xa delete -d \22Delete specified collection\22 -x\0Acomplete -c llm -n $condition -xa path -d \22Print path to embeddings database\22 -x\0A\0A# llm embed\0Aset -l condition \22__fish_seen_subcommand_from embed\22\0Acomplete -c llm -n $condition -s i -l input -d \22File to embed\22 -r\0Acomplete -c llm -n $condition -s m -l model -d \22Model to use\22 -xa \22(__fish_embedding_models)\22\0Acomplete -c llm -n $condition -l store -d \22Store the text itself in the db\22 -x\0Acomplete -c llm -n $condition -s d -l database -d \22Path to db to use\22 -r\0Acomplete -c llm -n $condition -s c -l content -d \22Text content to embed\22 -x\0Acomplete -c llm -n $condition -l binary -d \22Treat input as binary\22 -x\0Acomplete -c llm -n $condition -l metadata -d \22JSON object metadata to store\22 -x\0Acomplete -c llm -n $condition -s f -l format -d \22Output format\22 -xa \22json blob base64 hex\22\0A\0A# llm embed-models\0Aset -l condition \22__fish_seen_subcommand_from embed-models\22\0Acomplete -c llm -n $condition -xa list -d \22List available embedding models\22 -x\0Acomplete -c llm -n $condition -xa default -d \22Show or set default embedding model\22 -x\0A\0A# llm embed-multi\0Aset -l condition \22__fish_seen_subcommand_from embed-multi\22\0Acomplete -c llm -n $condition -l format -xa \22json csv tsv nl\22 -d \22Format of input (default: aut