@anon.1d0b41a8d45d477c3029ec78f9b8b434.1322 = private unnamed_addr constant [3964 x i8] c"# Completions for the JPEG XL Reference Software (https://gitlab.com/wg1/jpeg-xl)\0A\0Acomplete -c cjxl -s V -l version -d \22Print version number\22\0Acomplete -c cjxl -l quiet -d \22Be more silent\22\0Acomplete -c cjxl -l container -d \22Encode using container format\22\0Acomplete -x -c cjxl -l print_profile -a \220 1\22 -d \22Print timing information\22\0Acomplete -x -c cjxl -s d -l distance -a \22\0A    0.0\\t'Mathematically lossless'\0A    1.0\\t'Visually lossless'\0A    \22 -d \22Butteraugli distance\22\0Acomplete -x -c cjxl -l target_size -d \22Target file size (based on bytes)\22\0Acomplete -x -c cjxl -l target_bpp -d \22Target file size (based on BPP)\22\0Acomplete -x -c cjxl -s q -l quality -a \22\0A    (seq 0 99)\0A    100\\t'Mathematically lossless'\0A    \22 -d \22Quality setting\22\0Acomplete -x -c cjxl -s s -l speed -a \22\0A    3\\tFastest falcon\\tFastest\0A    4 cheetah\0A    5 hare\0A    6 wombat\0A    7\\tDefault squirrel\\tDefault\0A    8 kitten\0A    9\\tSlowest tortoise\\tSlowest\0A    \22 -d \22Encoder speed setting\22\0Acomplete -c cjxl -s p -l progressive -d \22Enable progressive decoding\22\0Acomplete -c cjxl -l middleout -d \22Put center groups first in the file\22\0Acomplete -c cjxl -l progressive_ac -d \22Use the progressive mode for AC\22\0Acomplete -c cjxl -l qprogressive_ac -d \22Use the progressive mode for AC\22\0Acomplete -x -c cjxl -l progressive_dc -d \22Use progressive mode for DC\22\0Acomplete -c cjxl -s m -l modular -d \22Use the modular mode\22\0Acomplete -c cjxl -l use_new_heuristics -d \22Use new encoder heuristics\22\0Acomplete -c cjxl -s j -l jpeg_transcode -d \22Do lossy transcode of input JPEG file\22\0Acomplete -x -c cjxl -l num_threads -d \22Number of worker threads\22\0Acomplete -x -c cjxl -l num_reps -d \22How many times to compress\22\0Acomplete -x -c cjxl -l noise -a \22\0A    0\\tEnable\0A    1\\tDisable\0A    \22 -d \22Force noise generation\22\0Acomplete -x -c cjxl -l dots -a \22\0A    0\\tEnable\0A    1\\tDisable\0A    \22 -d \22Force dots generation\22\0Acomplete -x -c cjxl -l patches -a \22\0A    0\\tEnable\0A    1\\tDisable\0A    \22 -d \22Force patches generation\22\0Acomplete -x -c cjxl -l resampling -a \221 2 4 8\22 -d \22Subsample all color channels\22\0Acomplete -x -c cjxl -l epf -d \22Edge preserving filter level\22\0Acomplete -x -c cjxl -l gaborish -a \220 1\22 -d \22Force disable gaborish\22\0Acomplete -x -c cjxl -l intensity_target -d \22Intensity target of monitor in nits\22\0Acomplete -x -c cjxl -l saliency_num_progressive_steps\0Acomplete -x -c cjxl -l saliency_map_filename\0Acomplete -x -c cjxl -l saliency_threshold\0Acomplete -x -c cjxl -s x -l dec-hints\0Acomplete -x -c cjxl -l override_bitdepth -a \22\0A    0\\t'Use from image'\0A    (seq 1 32)\\tOverride\0A    \22 -d \22Store the given bit depth in the metadata\22\0Acomplete -x -c cjxl -s c -l colortransform -a \22\0A    0\\tXYB\0A    1\\tNone\0A    2\\tYCbCr\22\0Acomplete -x -c cjxl -s Q -l mquality -d \22Lossy quality\22\0Acomplete -x -c cjxl -s I -l iterations -d \22Fraction of pixels used to learn MA trees\22\0Acomplete -x -c cjxl -s C -l colorspace -a \22\0A    0\\tRGB\0A    1\\tYCoCg\0A    (seq 2 37)\\tRCT\0A    \22 -d \22Color transform\22\0Acomplete -x -c cjxl -s g -l group-size -d \22Set group size\22\0Acomplete -x -c cjxl -s P -l predictor -a \22\0A    0\\tZero\0A    1\\tLeft\0A    2\\tTop\0A    3\\tAverage0\0A    4\\tSelect\0A    5\\tGradient\0A    6\\tWeighted\0A    7\\tTopRight\0A    8\\tTopLeft\0A    9\\tLeftLeft\0A    10\\tAverage1\0A    11\\tAverage2\0A    12\\tAverage3\0A    13\\t'TopTop predictive average'\0A    14\\t'Mix Gradient and Weighted'\0A    15\\t'Mix everything'\0A    \22 -d \22Predictor to use\22\0Acomplete -x -c cjxl -s E -l extra-properties -d \22Number of extra MA tree properties\22\0Acomplete -x -c cjxl -s N -l near-lossless -d \22Apply near-lossless preprocessing\22\0Acomplete -x -c cjxl -l palette -d \22Use a palette\22\0Acomplete -c cjxl -l lossy-palette -d \22Quantize to a lossy palette\22\0Acomplete -x -c cjxl -s X -l pre-compact -d \22Compact channels (globally)\22\0Acomplete -x -c cjxl -s Y -l post-compact -d \22Compact channels (per-group)\22\0Acomplete -x -c cjxl -s R -l responsive -a \22\0A    0\\tFalse\0A    1\\tTrue\0A    \22 -d \22Do squeeze transform\22\0Acomplete -c cjxl -s v -l verbose -d \22Verbose output\22\0Acomplete -c cjxl -s h -l help -d \22Print help message\22\0A", align 1
