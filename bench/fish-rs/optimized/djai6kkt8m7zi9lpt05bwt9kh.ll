@anon.1d0b41a8d45d477c3029ec78f9b8b434.2684 = private unnamed_addr constant [2251 x i8] c"# Only GNU and BSD sysctl seem to know \22-h\22, so others should exit non-zero\0Aif sysctl -h >/dev/null 2>/dev/null\0A    # Print sysctl keys and values, separated by a tab\0A    function __fish_sysctl_values\0A        sysctl -a 2>/dev/null | string replace -a \22 = \22 \\t\0A    end\0A\0A    complete -c sysctl -a '(__fish_sysctl_values)' -f\0A\0A    complete -c sysctl -s n -l values -d 'Only print values'\0A    complete -c sysctl -s e -l ignore -d 'Ignore errors about unknown keys'\0A    complete -c sysctl -s N -l names -d 'Only print names'\0A    complete -c sysctl -s q -l quiet -d 'Be quiet when setting values'\0A    complete -c sysctl -s w -l write -d 'Write value'\0A    complete -c sysctl -s p -l load -d 'Load in sysctl settings from the file specified or /etc/sysctl'\0A    complete -c sysctl -s a -l all -d 'Display all values currently available'\0A    complete -c sysctl -l deprecated -d 'Include deprecated parameters too'\0A    complete -c sysctl -s b -l binary -d 'Print value without new line'\0A    complete -c sysctl -l system -d 'Load settings from all system configuration files'\0A    complete -c sysctl -s r -l pattern -d 'Only apply settings that match pattern'\0A    # Don't include these as they don't do anything\0A    # complete -c sysctl -s A -d 'Alias of -a'\0A    # complete -c sysctl -s d -d 'Alias of -h'\0A    # complete -c sysctl -s f -d 'Alias of -p'\0A    # complete -c sysctl -s X -d 'Alias of -a'\0A    # complete -c sysctl -s o -d 'Does nothing, exists for BSD compatibility'\0A    # complete -c sysctl -s x -d 'Does nothing, exists for BSD compatibility'\0A    complete -c sysctl -s h -l help -d 'Display help text and exit.'\0A    complete -c sysctl -s V -l version -d 'Display version information and exit.'\0Aelse\0A    # OSX sysctl\0A    function __fish_sysctl_values\0A        sysctl -a 2>/dev/null | string replace -a \22:\22 \\t\0A    end\0A\0A    complete -c sysctl -a '(__fish_sysctl_values)' -f\0A    complete -c sysctl -s a -d 'Display all non-opaque values currently available'\0A    complete -c sysctl -s A -d 'Display all MIB variables'\0A    complete -c sysctl -s b -d 'Output values in a binary format'\0A    complete -c sysctl -s n -d 'Show only values, not names'\0A    complete -c sysctl -s w -d 'Set values'\0A    complete -c sysctl -s X -d 'Like -A, but prints a hex dump'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2685 = private unnamed_addr constant [26 x i8] c"completions/systemctl.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2686 = private unnamed_addr constant [7891 x i8] c"set -l systemd_version (systemctl --version | string match \22systemd*\22 | string replace -r \22\\D*(\\d+)\\D.*\22  '$1')\0Aset -l commands list-units list-sockets start stop reload restart try-restart reload-or-restart reload-or-try-restart \\\0A    isolate kill is-active is-failed status show get-cgroup-attr set-cgroup-attr unset-cgroup-attr set-cgroup help \\\0A    reset-failed list-unit-files enable disable is-enabled reenable preset mask unmask link load list-jobs cancel dump \\\0A    list-dependencies snapshot delete daemon-reload daemon-reexec show-environment set-environment unset-environment \\\0A    default rescue emergency halt poweroff reboot kexec exit suspend hibernate hybrid-sleep switch-root list-timers \\\0A    set-property import-environment get-default list-automounts is-system-running try-reload-or-restart freeze \\\0A    thaw mount-image bind clean\0Aif test $systemd_version -gt 208 2>/dev/null\0A    set commands $commands cat\0A    if test $systemd_version -gt 217 2>/dev/null\0A        set commands $commands edit\0A    end\0Aend\0Aset -l types services sockets mounts service_paths targets automounts timers\0A\0Afunction __fish_systemd_properties\0A    # We need to call the main systemd binary (the thing that is run as PID1).\0A    # Unfortunately, it's usually not in $PATH.\0A    if test -f /usr/lib/systemd/systemd\0A        /usr/lib/systemd/systemd --dump-configuration-items | string replace -rf '(.+)=(.+)$' '$1\\t$2'\0A    else if test -f /lib/systemd/systemd # Debian has not merged /lib and /usr/lib\0A        /lib/systemd/systemd --dump-configuration-items | string replace -rf '(.+)=(.+)$' '$1\\t$2'\0A    end\0Aend\0A\0A# All systemctl commands\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a \22$commands\22\0A\0A#### Units commands\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a start -d 'Start one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a stop -d 'Stop one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a restart -d 'Restart one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a reload-or-restart -d 'Reload units if supported or restart them'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a try-reload-or-restart -d 'Reload units if supported or restart them, if running'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a status -d 'Runtime status about one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a enable -d 'Enable one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a disable -d 'Disable one or more units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a isolate -d 'Start a unit and dependencies and disable all others'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a set-default -d 'Set the default target to boot into'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a get-default -d 'Show the default target to boot into'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a set-property -d 'Sets one or more properties of a unit'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a list-automounts -d 'List automount units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a is-system-running -d 'Return if system is running/starting/degraded'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a freeze -d 'Freeze units with the cgroup freezer'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a thaw -d 'Unfreeze frozen units'\0Acomplete -f -c systemctl -n \22not __fish_seen_subcommand_from $commands\22 -a clean -d 'Remove config/state/logs for the given units'\0A\0A# Command completion done via argparse.\0Acomplete -c systemctl -a '(__fish_systemctl)' -f\0A\0A# These \22--x=help\22 outputs always have lines like \22Available unit types:\22. We use the fact that they end in a \22:\22 to filter them out.\0Acomplete -f -c systemctl -s t -l type -d 'List of unit types' -xa '(systemctl --type=help --no-legend --no-pager | string match -v \22*:\22)'\0Acomplete -f -c systemctl -l state -d 'List of unit states' -xa '(systemctl --state=help --no-legend --no-pager | string match -v \22*:\22)'\0Acomplete -f -c systemctl -s p -l property -a '(__fish_systemd_properties)'\0Acomplete -f -c systemctl -s a -l all -d 'Show all units or properties'\0Acomplete -f -c systemctl -s r -l recursive -d 'Show also units of local containers'\0Acomplete -f -c systemctl -l reverse -d 'Show reverse dependencies between units'\0Acomplete -f -c systemctl -l after -d 'Show units ordered before specified unit' -n \22__fish_seen_subcommand_from list-dependencies\22\0Acomplete -f -c systemctl -l before -d 'Show units ordered after specified unit' -n \22__fish_seen_subcommand_from list-dependencies\22\0Acomplete -f -c systemctl -s l -l full -d 'Do not ellipsize anything'\0Acomplete -f -c systemctl -l show-types -d 'Show the type of the socket'\0Acomplete -f -c systemctl -l job-mode -d 'How to deal with queued jobs' -xa 'fail replace replace-irreversibly isolate ignore-dependencies ignore-requirements flush'\0Acomplete -f -c systemctl -s i -l ignore-inhibitors -d 'Ignore inhibitor locks on shutdown or sleep'\0Acomplete -f -c systemctl -s q -l quiet -d 'Suppress output to STDOUT'\0Acomplete -f -c systemctl -l no-block -d 'Do not wait for the requested operation to finish'\0Acomplete -f -c systemctl -l no-legend -d 'Do not print header and footer'\0A# system and user/global are mutually exclusive\0Acomplete -f -c systemctl -l user -d 'Talk to the service manager of the calling user' -n \22not __fish_contains_opt system\22\0Acomplete -f -c systemctl -l system -d 'Talk to the service manager of the system.' -n \22not __fish_contains_opt system global\22\0Acomplete -c systemctl -l failed -d 'List units in failed state'\0Acomplete -f -c systemctl -l global -d 'Enable or disable for all users' -n \22not __fish_contains_opt system\22\0Acomplete -f -c systemctl -l no-wall -d 'Do not send wall message before halt'\0Acomplete -f -c systemctl -l no-reload -d 'Do not reload daemon configuration'\0Acomplete -f -c systemctl -l no-ask-password -d 'Disable asking for password'\0Acomplete -f -c systemctl -l kill-who -d 'Send signal to which process' -xa 'main control all'\0Acomplete -f -c systemctl -s s -l signal -d 'Which signal to send' -xa 'SIGTERM SIGINT SIGSTOP SIGKILL SIGHUP SIGCONT'\0Acomplete -f -c systemctl -s f -l force -d 'Overwrite conflicting existing symlinks'\0A# --root needs a path\0Acomplete -r -c systemctl -l root -d 'Use alternative root path'\0Acomplete -f -c systemctl -l runtime -d 'Make changes only temporarily'\0Acomplete -f -r -c systemctl -s n -l lines -d 'Number of journal lines to show' -a \22(seq 1 1000)\22\0Acomplete -f -c systemctl -s o -l output -d 'Control journal formatting' -xa 'short short-monotonic verbose export json json-pretty json-sse cat'\0Acomplete -f -c systemctl -l plain -d 'list-dependencies flat, not as tree'\0Acomplete -f -c systemctl -s H -l host -d 'Execute the operation on a remote host' -a \22(__fish_print_hostnames)\22\0Acomplete -x -c systemctl -s M -l machine -d 'Execute operation on a VM or container' -a \22(__fish_systemd_machines)\22\0Acomplete -f -c systemctl -s h -l help -d 'Print a short help and exit'\0Acomplete -f -c systemctl -l version -d 'Print a short version and exit'\0Acomplete -f -c systemctl -l no-pager -d 'Do not pipe output into a pager'\0A\0A# New options since systemd 220\0Aif test $systemd_version -gt 219 2>/dev/null\0A    complete -f -c systemctl -l firmware-setup -n \22__fish_seen_subcommand_from reboot\22 -d \22Reboot to EFI setup\22\0A    complete -f -c systemctl -l now -n \22__fish_seen_subcommand_from enable\22 -d \22Also start unit\22\0A    complete -f -c systemctl -l now -n \22__fish_seen_subcommand_from disable mask\22 -d \22Also stop unit\22\0Aend\0A", align 1
