@anon.1d0b41a8d45d477c3029ec78f9b8b434.3504 = private unnamed_addr constant [1070 x i8] c"function nextd --description \22Move forward in the directory history\22\0A    set -l options h/help l/list\0A    argparse -n nextd --max-args=1 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help nextd\0A        return 0\0A    end\0A\0A    set -l times 1\0A    if set -q argv[1]\0A        if test $argv[1] -ge 0 2>/dev/null\0A            set times $argv[1]\0A        else\0A            printf (_ \22%s: The number of positions to skip must be a non-negative integer\\n\22) nextd >&2\0A            return 1\0A        end\0A    end\0A\0A    # Traverse history\0A    set -l code 1\0A    for i in (seq $times)\0A        # Try one step backward\0A        if __fish_move_last dirnext dirprev\0A            # We consider it a success if we were able to do at least 1 step\0A            # (low expectations are the key to happiness ;)\0A            set code 0\0A        else\0A            break\0A        end\0A    end\0A\0A    # Show history if needed\0A    if set -q _flag_list\0A        dirh\0A    end\0A\0A    # Set direction for 'cd -'\0A    test $code = 0\0A    and set -g __fish_cd_direction prev\0A\0A    return $code\0Aend\0A", align 1
