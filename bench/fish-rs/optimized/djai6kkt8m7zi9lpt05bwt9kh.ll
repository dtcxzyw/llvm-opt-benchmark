@anon.1d0b41a8d45d477c3029ec78f9b8b434.1380 = private unnamed_addr constant [4557 x i8] c"function __fish_parse_configure\0A    if test (count $argv) -ne 1\0A        echo \22Usage: parse_configure path/to/configure\22 1>&2\0A        return 1\0A    end\0A\0A    # `complete` parses `./configure` as `configure` so we have to handle all paths, not just ./\0A    if not test -x $argv[1]\0A        printf \22Cannot find or execute '%s'\\n\22 $argv[1] 1>&2\0A        return 1\0A    end\0A\0A    # Must support output along the lines of\0A    #  -h, --help              display this help and exit\0A    #      --help=short        display options specific to this package\0A    #      --help=recursive    display the short help of all the included packages\0A    #  -V, --version           display version information and exit\0A    #  -q, --quiet, --silent   do not print `checking ...' messages\0A\0A    set -l next_line\0A    set -l line\0A    set -l buffer\0A    # Just fish's `./configure --help` takes ~350ms to run, before parsing\0A    # The following chain attempts to extract the help message:\0A    cat $argv[1] | tr \\n \\u0e | sed -n 's/.*Report the --help message\\(.*\\?\\)ac_status.*/\\1/; s/ac_status.*//p' | tr \\u0e \\n |\0A        while test -n \22$next_line\22 || read -lL next_line\0A            # In autoconfigure scripts, the first column wraps at 26 chars\0A            # echo next_line: $next_line\0A            # echo old_line: $line\0A            if test -z \22$line\22\0A                set line $next_line\0A                set next_line \22\22 # mark it as consumed\0A                continue\0A            else if string match -qr '^(   |\\t){2,}[^-]\\S*' -- $next_line\0A                # echo \22continuation line found. Old value of line: \22 \\\22$line\\\22\0A                set line \22$line \22(string trim $next_line)\0A                set next_line \22\22 # mark it as consumed\0A                continue\0A            end\0A\0A            # echo line: $line\0A\0A            # Search for one or more strings starting with `-` separated by commas\0A            if string replace -fr '^\\s+(-.*?)\\s+([^\\s\\-].*)' '$1\\n$2' -- $line | read -lL opts description\0A                for opt in (string split -n , -- $opts | string trim)\0A\0A                    if string match -qr -- '--[a-z_0-9-]+=\\[.*\\]' $opt\0A                        # --option=[OPTIONAL_VALUE]\0A                        string replace -r -- '(--[a-z_0-9-]+)=.*' '$1' $opt | read opt\0A                    else if string match -qr -- '--[a-z_0-9-]+\\[=.*\\]' $opt\0A                        # --option[=OPTIONAL_VALUE]\0A                        string replace -r -- '(--[a-z_0-9-]+)\\[=.*' '$1' $opt | read opt\0A                    else if string match -qr -- '--[a-z_0-9-]+=[A-Z]+' $opt\0A                        # --option=CLASS_OF_VALUE (eg FILE or DIR)\0A                        string replace -r -- '(--[a-z_0-9-]+)=.*' '$1' $opt | read opt\0A                    else if string match -qr -- '--[a-z_0-9-]+=\\S+' $opt\0A                        # --option=literal_value, leave as-is\0A                    else if string match -qr -- '--[a-z_0-9-]+$' $opt\0A                        # long option, leave as-is\0A                    else if string match -qr -- '-[^-]$' $opt\0A                        # short option, leave as-is\0A                    else\0A                        continue\0A                    end\0A\0A                    echo \22$opt\22\\t\22$description\22 # parsed by `complete` as value and description\0A                end\0A            end\0A\0A            set line \22\22\0A        end\0Aend\0A\0Acomplete -c configure -s h -l help -x -a \22short recursive\22 -d \22Display help and exit\22\0Acomplete -c configure -s V -l version -d \22Display version and exit\22\0Acomplete -c configure -s q -l quiet -d \22Quiet mode\22\0Acomplete -c configure -l cache-file -f -d \22Cache test results in specified file\22\0Acomplete -c configure -s C -l config-cache -d \22Cache test results in file config.cache\22\0Acomplete -c configure -s n -l no-create -d \22Do not create output files\22\0Acomplete -c configure -l srcdir -d \22Set source directory\22 -a \22(__fish_complete_directories)\22 -x\0Acomplete -c configure -l prefix -d \22Architecture-independent install directory\22 -a \22(__fish_complete_directories)\22 -x\0Acomplete -c configure -l exec-prefix -d \22Architecture-dependent install directory\22 -a \22(__fish_complete_directories)\22 -x\0Acomplete -c configure -l build -d \22Configure for building on BUILD\22 -x\0Acomplete -c configure -l host -d \22Cross-compile to build programs to run on HOST\22 -x\0Acomplete -c configure -l target -d \22Configure for building compilers for TARGET\22 -x\0A\0A# use autoconf's --help to generate completions:\0Acomplete -c configure -a '(for tok in (commandline -xpc)\0A    if string match -q \22*configure\22 -- $tok\0A        __fish_parse_configure $tok\0A        break\0A    end\0Aend)'\0A", align 1
