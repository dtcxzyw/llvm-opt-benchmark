@anon.1d0b41a8d45d477c3029ec78f9b8b434.2056 = private unnamed_addr constant [2720 x i8] c"# Subcommands\0Acomplete -f -n __fish_use_subcommand -c mariner -a complete -d \22Print bash completion command\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a config -d \22Show or update configuration\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a details -d \22Show details about torrent with given ID\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a download -d \22Download torrent with given ID\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a help -d \22Print detailed help for another command\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a magnet -d \22Copy magnet link with given ID to clipboard\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a open -d \22Open torrent in the default torrent application\22\0Acomplete -f -n __fish_use_subcommand -c mariner -a search -d \22Search for torrents\22\0A\0A# Global options\0Acomplete -f -n __fish_use_subcommand -c mariner -l version -d \22Show program's version number and exit\22\0Acomplete -f -n __fish_use_subcommand -c mariner -s v -l verbose -d \22Increase verbosity of output. Can be repeated\22\0Acomplete -f -n __fish_use_subcommand -c mariner -s q -l quiet -d \22Suppress output except warnings and errors\22\0Acomplete -f -n __fish_use_subcommand -c mariner -s h -l help -d \22Show help message and exit\22\0Acomplete -f -n __fish_use_subcommand -c mariner -l debug -d \22Show tracebacks on errors\22\0Acomplete -r -n __fish_use_subcommand -c mariner -l log-file -d \22Specify a file to log output. Default ~/.local/share/mariner/mariner.log\22\0Acomplete -r -n __fish_use_subcommand -c mariner -l config-file -d \22Path to config file. Default ~/.config/mariner/config.yaml\22\0A\0A# Config options\0Acomplete -f -n \22__fish_seen_subcommand_from config\22 -c mariner -s s -l show -d \22Show the configuration\22\0A\0A# Download options\0Acomplete -r -n \22__fish_seen_subcommand_from download\22 -c mariner -s p -l path -d \22Path to download torrent files to\22\0A\0A# Search options\0Acomplete -f -n \22__fish_seen_subcommand_from search\22 -c mariner -s a -l all -d \22Search all available trackers\22\0Acomplete -f -n \22__fish_seen_subcommand_from search\22 -c mariner -s A -l anime -d \22Search trackers with anime content only\22\0Acomplete -f -n \22__fish_seen_subcommand_from search\22 -c mariner -s f -l filter -a \22anime legal\22 -d \22Filter trackers that should be searched\22\0Acomplete -f -n \22__fish_seen_subcommand_from search\22 -c mariner -s L -l legal -d \22Search trackers with legal content only\22\0Acomplete -x -n \22__fish_seen_subcommand_from search\22 -c mariner -s l -l limit -d \22Limit the number of results shown. Default is 50\22\0Acomplete -f -n \22__fish_seen_subcommand_from search\22 -c mariner -s n -l newest -d \22Sort results by newest\22\0Acomplete -x -n \22__fish_seen_subcommand_from search\22 -c mariner -s t -l trackers -d \22Trackers that should be searched\22\0A", align 1
