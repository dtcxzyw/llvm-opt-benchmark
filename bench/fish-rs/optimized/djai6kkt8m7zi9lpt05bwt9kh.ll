@anon.1d0b41a8d45d477c3029ec78f9b8b434.3387 = private unnamed_addr constant [28 x i8] c"functions/__fish_whatis.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3388 = private unnamed_addr constant [499 x i8] c"# uses `whatis` if available to describe a command\0A\0Afunction __fish_whatis\0A    set -l cmd $argv[1]\0A    set -l fallback\0A    if set -q argv[2]\0A        set fallback $argv[2]\0A    end\0A\0A    set -l description (whatis $cmd 2>/dev/null | string replace -r '.*? - ' '')[1]\0A    if string match -qr -- \22.\22 \22$description\22\0A        printf '%s\\n' $description\0A        return 0\0A    else if not string match -q -- \22$fallback\22 \22\22\0A        printf '%s\\n' $fallback\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3389 = private unnamed_addr constant [42 x i8] c"functions/__fish_whatis_current_token.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3390 = private unnamed_addr constant [900 x i8] c"# This function is typically bound to Alt-W, it is used to list man page entries\0A# for the command under the cursor.\0Afunction __fish_whatis_current_token -d \22Show man page entries or function description related to the token under the cursor\22\0A    set -l token (commandline -pt)\0A\0A    test -n \22$token\22\0A    or return\0A\0A    set -l desc \22$token: nothing appropriate.\22\0A\0A    set -l tokentype (type --type $token 2>/dev/null)\0A\0A    switch \22$tokentype\22\0A        case function\0A            set -l funcinfo (functions $token --details --verbose)\0A\0A            test $funcinfo[5] != n/a\0A            and set desc \22$token - $funcinfo[5]\22\0A\0A        case builtin\0A            set desc (__fish_print_help $token | awk \22/./ { getline; print; exit }\22 | string trim)\0A\0A        case file\0A            set -l tmpdesc (whatis $token 2>/dev/null)\0A            and set desc $tmpdesc\0A    end\0A\0A    __fish_echo string join \\n -- $desc\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3391 = private unnamed_addr constant [40 x i8] c"functions/__ssh_history_completions.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3392 = private unnamed_addr constant [190 x i8] c"function __ssh_history_completions -d \22Retrieve `user@host` entries from history\22\0A    history --prefix ssh --max=100 | string replace -rf '.* ([A-Za-z0-9._:-]+@[A-Za-z0-9._:-]+).*' '$1'\0Aend\0A", align 1
