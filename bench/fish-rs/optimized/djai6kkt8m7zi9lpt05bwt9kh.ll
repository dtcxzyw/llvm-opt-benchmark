e -xc gprof -s N -l no-time -d \22Do not propagate times for matching symbols\22\0Acomplete -xc gprof -s z -l display-unused-functions -d \22Mention unused functions in flat profile\22\0Acomplete -xc gprof -s d -l debug -d \22Specify debugging options\22\0Acomplete -xc gprof -s h -l help -d \22Display help and exit\22\0Acomplete -xc gprof -s v -l version -d \22Display version and exit\22\0Acomplete -xc gprof -s O -l file-format -x -a \22auto bsd 4.4bsd magic prof\22 -d \22Profile data format\22\0Acomplete -xc gprof -s s -l sum -d \22Print summary\22\0A", align 1
