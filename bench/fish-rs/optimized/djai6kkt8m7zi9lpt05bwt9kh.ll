@anon.1d0b41a8d45d477c3029ec78f9b8b434.3273 = private unnamed_addr constant [36 x i8] c"functions/__fish_print_commands.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3274 = private unnamed_addr constant [754 x i8] c"function __fish_print_commands --description \22Print a list of documented fish commands\22\0A    if set -q __fish_data_dir[1] && test -d $__fish_data_dir/man/man1/\0A        for file in $__fish_data_dir/man/man1/**.1*\0A            string replace -r '.*/' '' -- $file |\0A                string replace -r '.1(.gz)?$' '' |\0A                string match -rv '^fish-(?:changelog|completions|doc|tutorial|faq|for-bash-users|interactive|language|releasenotes|terminal-compatibility)$'\0A        end\0A    end\0A    status list-files man/man1/ 2>/dev/null |\0A        string replace -r '.*/' '' -- $file |\0A        string replace -r '.1(.gz)?$' '' |\0A        string match -rv '^fish-(?:changelog|completions|doc|tutorial|faq|for-bash-users|interactive|language|releasenotes)$'\0Aend\0A", align 1
