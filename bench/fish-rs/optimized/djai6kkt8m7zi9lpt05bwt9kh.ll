@anon.1d0b41a8d45d477c3029ec78f9b8b434.1464 = private unnamed_addr constant [1504 x i8] c"#\0A# Completions for df\0A#\0A\0A#\0A# Test if we are using GNU df\0A#\0A\0Aset -l is_gnu\0Adf --version >/dev/null 2>/dev/null; and set is_gnu --is-gnu\0A\0A__fish_gnu_complete -c df -s h -l human-readable -d \22Human readable sizes\22 $is_gnu\0A__fish_gnu_complete -c df -s i -l inodes -d \22List inode information\22 $is_gnu\0A__fish_gnu_complete -c df -s k -d \22Use 1kB block size\22 $is_gnu\0A__fish_gnu_complete -c df -s l -l local -d \22List only local file systems\22 $is_gnu\0A__fish_gnu_complete -c df -s P -l portability -d \22Use POSIX format\22 $is_gnu\0A__fish_gnu_complete -c df -s t -l type -r -d \22Show file systems of specified type\22 $is_gnu -x -a \22(__fish_print_filesystems)\22\0A\0Aif test -n \22$is_gnu\22\0A\0A    complete -c df -s a -l all -d \22Include empty file systems\22\0A    complete -c df -s B -l block-size -r -d \22Block size\22\0A    complete -c df -s H -l si -d \22Human readable sizes, powers of 1000\22\0A    complete -c df -l no-sync -d \22Do not sync before getting usage info\22\0A    complete -c df -l sync -d \22Sync before getting usage info\22\0A    complete -c df -s T -l print-type -d \22Print file system type\22\0A    complete -c df -s x -l exclude-type -d \22Excluded file system type\22 -r -x -a \22(__fish_print_filesystems)\22\0A    complete -c df -l help -d \22Display help and exit\22\0A    complete -c df -l version -d \22Display version and exit\22\0A\0Aelse\0A\0A    complete -c df -s a -d \22Show all file systems\22\0A    complete -c df -s g -d \22Show sizes in gigabytes\22\0A    complete -c df -s m -d \22Show sizes in megabytes\22\0A    complete -c df -s n -d \22Use cached statistics\22\0A\0Aend\0A", align 1
