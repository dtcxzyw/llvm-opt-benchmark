@anon.1d0b41a8d45d477c3029ec78f9b8b434.2662 = private unnamed_addr constant [5720 x i8] c"# Startup\0Acomplete -c strace -s E -l env -d 'Remove var from the inherited environment before passing it on to the command'\0Acomplete -c strace -s p -l attach -xa '(__fish_complete_pids)'\0Acomplete -c strace -s u -l user -xa '(__fish_complete_users)'\0Acomplete -c strace -l argv0 -d 'Set argv[0] of the command being executed to name'\0A\0A# Tracing\0Acomplete -c strace -s b -l detach-on -d 'Detach when the specified syscall is reached'\0Acomplete -c strace -s D -l daemonize -d 'Run tracer process as a grandchild, not as the parent of the tracee'\0Acomplete -c strace -o DD -d \22Run tracer process as tracee's grandchild in a separate process group.\22\0Acomplete -c strace -o DDD -d \22Run tracer process as tracee's grandchild in a separate session\22\0Acomplete -c strace -s f -l follow-forks\0Acomplete -c strace -l output-separately\0Acomplete -c strace -o ff -d 'Like --follow-forks --output-separately'\0Acomplete -c strace -s I -l interruptible -d 'When strace can be interrupted by signals'\0Acomplete -c strace -l syscall-limit -d 'Detach all tracees when LIMIT number of syscalls have been captured'\0Acomplete -c strace -l kill-on-exit -d 'Set PTRACE_O_EXITKILL ptrace option to all tracee processes'\0A\0A# General/Filtering/Tampering\0Acomplete -c strace -s e -l trace -d 'Set expression which modifies which events to trace'\0Acomplete -c strace -s e -l trace-fds -d 'Set expression which modifies which events to trace'\0Acomplete -c strace -s e -l signal -d 'Set expression which modifies which events to trace'\0Acomplete -c strace -s e -l status -d 'Set expression which modifies which events to trace'\0Acomplete -c strace -s P -l trace-path -d 'Trace only system calls accessing path'\0Acomplete -c strace -s z -l successful-only -d 'Print only syscalls that returned without an error code'\0Acomplete -c strace -s Z -l failed-only -d 'Print only syscalls that returned with an error code'\0A\0A# Output format\0Acomplete -c strace -s a -l columns -d 'Align output in columns'\0Acomplete -c strace -s e -l verbose -d 'Dereference structures for the specified set of system calls'\0Acomplete -c strace -l decode-pids -d 'Decode various information associated with process IDs'\0Acomplete -c strace -l silence -l silent -l quiet -d 'Suppress various information messages'\0Acomplete -c strace -l decode-fds -d 'Decode various information associated with file descriptors'\0Acomplete -c strace -l decode-pids -d 'Decode various information associated with process IDs'\0Acomplete -c strace -l kvm -d 'Print the exit reason of kvm vcpu'\0Acomplete -c strace -s i -l instruction-pointer -d 'Print the instruction pointer at the time of the system call'\0Acomplete -c strace -s n -l syscall-number -d 'Print the syscall number'\0Acomplete -c strace -s k -l stack-traces -d 'Print the execution stack trace of the traced processes after each system call'\0Acomplete -c strace -s o -l output -d 'Write the trace output to the file filename rather than to stderr'\0Acomplete -c strace -s A -l output-append-mode -d 'Open the file provided in the -o option in append mode'\0Acomplete -c strace -s q -l quiet\0Acomplete -c strace -o qq -l quiet\0Acomplete -c strace -o qqq -l quiet\0Acomplete -c strace -s r -l relative-timestamps -d 'Print a relative timestamp upon entry to each system call'\0Acomplete -c strace -s s -l string-limit -d 'Specify the maximum string size to print (the default is 32)'\0Acomplete -c strace -l absolute-timestamps -l timestamps -d 'Prefix each line of the trace with the wall clock time'\0Acomplete -c strace -s t -l absolute-timestamps -d 'Prefix each line of the trace with the wall clock time'\0Acomplete -c strace -o tt -l absolute-timestamps -d 'If given twice, the time printed will include the microseconds'\0Acomplete -c strace -o ttt -l absolute-timestamps\0Acomplete -c strace -s T -l syscall-times -d 'Show the time spent in system calls'\0Acomplete -c strace -s v -l no-abbrev -d 'Print unabbreviated versions of environment'\0Acomplete -c strace -l strings-in-hex -d 'Control usage of escape sequences with hexadecimal numbers in the printed strings'\0Acomplete -c strace -s x -d 'Print all non-ASCII strings in hex format'\0Acomplete -c strace -o xx -d 'Print all strings in hex format'\0Acomplete -c strace -s X -l const-print-style -d 'Set the format for printing of named constants and flags'\0Acomplete -c strace -o yy -l decode-fds -d 'Print all available information associated with file descriptors'\0Acomplete -c strace -s y -l decode-fds -d 'Print paths associated with file descriptor arguments and with the AT_FDCWD constant'\0Acomplete -c strace -l pidns-translation -l decode-pids -d \22print PIDs in strace's namespace\22\0Acomplete -c strace -s Y -l decode-pids -d 'Print command names for PIDs'\0A\0A# Statistics\0Acomplete -c strace -s c -l summary-only -d 'Suppress output and report summary on exit'\0Acomplete -c strace -s C -l summary -d 'Display output and report summary on exit'\0Acomplete -c strace -s O -l summary-syscall-overhead -d 'Set the overhead for tracing system calls to overhead'\0Acomplete -c strace -s S -l summary-sort-by -xa 'time time_total total_time calls count errors error name syscall syscall_name nothing none' -d 'Sort summary by the specified criterion'\0Acomplete -c strace -s U -l summary-columns -d 'Configure a set (and order) of columns being shown in the call summary'\0Acomplete -c strace -s w -l summary-wall-clock -d 'Summarise the time difference between the beginning and end of each system call'\0A\0A# Miscellaneous\0Acomplete -c strace -s d -l debug -d 'Debug output'\0Acomplete -c strace -l seccomp-bpf -d 'Try to enable use of seccomp-bpf'\0Acomplete -c strace -l tips -d 'Show strace tips, tricks, and tweaks before exit'\0Acomplete -c strace -s h -l help -d 'Print help and exit'\0Acomplete -c strace -s V -l version -d 'Print version and exit'\0A", align 1
