@anon.1d0b41a8d45d477c3029ec78f9b8b434.2182 = private unnamed_addr constant [3674 x i8] c"set -l cmds list start stop switch-to enable disable enable-all disable-all is-active is-enabled\0A\0A# Helper function that prints network profiles managed by netctl-auto.\0A# If no argument is given, it prints all profiles.\0A# Otherwise, it only prints the ones given as arguments witch are either:\0A#    - active\0A#    - disabled\0A#    - other (meaning enabled but not active)\0A#\0A# For example, if you only want the enabled profiles, call it with\0A# the arguments active and other.\0Afunction __fish_print_netctl-auto_profile\0A    set -l show_active false\0A    set -l show_disabled false\0A    set -l show_other false\0A\0A    for arg in $argv\0A        switch $arg\0A            case other\0A                set show_other true\0A            case disabled\0A                set show_disabled true\0A            case active\0A                set show_active true\0A        end\0A    end\0A\0A    if not count $argv >/dev/null\0A        set show_active true\0A        set show_disabled true\0A        set show_other true\0A    end\0A\0A    for line in (netctl-auto list)\0A        set -l profile (string sub -s 3 $line)\0A        if string match -q '\\**' -- $line\0A            if test $show_active = true\0A                printf \22%s\\t%s\\n\22 $profile \22Active profile\22\0A            end\0A        else if string match -q \22!*\22 -- $line\0A            if test $show_disabled = true\0A                printf \22%s\\t%s\\n\22 $profile \22Disabled profile\22\0A            end\0A        else\0A            if test $show_other = true\0A                printf \22%s\\t%s\\n\22 $profile Profile\0A            end\0A        end\0A    end\0Aend\0A\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -l help -d \22Show help\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -l version -d \22Show version\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a list -f -d \22List all available profiles for automatic selection\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a start -f -d \22Start automatic profile selection on interface\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a stop -f -d \22Stop automatic profile selection on interface\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a switch-to -f -d \22Switch to the given network profile\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a enable -f -d \22Enable network profile for automatic selection\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a disable -f -d \22Disable network profile for automatic selection\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a enable-all -f -d \22Enable all profiles for automatic selection\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a disable-all -f -d \22Disable all profiles for automatic selection\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a is-active -f -d \22Check whether specified profile is active\22\0Acomplete -c netctl-auto -n \22not __fish_seen_subcommand_from $cmds\22 -a is-enabled -f -d \22Check whether specified profile is enabled\22\0A\0Acomplete -c netctl-auto -n \22__fish_seen_subcommand_from switch-to\22 -f -a \22(__fish_print_netctl-auto_profile other disabled)\22 -d Profile\0Acomplete -c netctl-auto -n \22__fish_seen_subcommand_from enable\22 -f -a \22(__fish_print_netctl-auto_profile disabled)\22 -d Profile\0Acomplete -c netctl-auto -n \22__fish_seen_subcommand_from disable\22 -f -a \22(__fish_print_netctl-auto_profile active other)\22 -d Profile\0Acomplete -c netctl-auto -n \22__fish_seen_subcommand_from start stop\22 -f -a \22(__fish_print_interfaces)\22\0Acomplete -c netctl-auto -n \22__fish_seen_subcommand_from is-enabled is-active\22 -x -a \22(__fish_print_netctl-auto_profile active disabled other)\22\0A", align 1
