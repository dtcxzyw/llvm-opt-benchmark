n_subcommand_from $commands\22 -c fastboot -a getvar -d 'Display given bootloader variable'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a oem -d 'Execute OEM-specific command'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a flashing -d Lock/unlock\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a reboot -d 'Reboot device'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a update -d 'Flash all partitions from an update.zip package'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a erase -d 'Erase a flash partition'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a format -d 'Format a flash partition'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a devices -d 'List devices in bootloader'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a flash -d 'Flash given partition'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a help -d 'Show help message'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a stage -d 'Sends given file to stage for the next command'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a get_staged -d 'Writes data staged by the last command to a file'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a fetch -d 'Fetch a partition image from the device'\0Acomplete -f -n \22not __fish_seen_subcommand_from $commands\22 -c fastboot -a boot -d 'Download and boot kernel from RAM'\0A\0A# flash\0Acomplete -n '__fish_seen_subcommand_from flash' -c fastboot -f -k -a \22(__fish_fastboot_list_partition_or_file)\22\0Acomplete -n '__fish_seen_subcommand_from flash' -c fastboot -l skip-secondary -d 'Don\\'t flash secondary slots in flashall/update'\0Acomplete -n '__fish_seen_subcommand_from flash' -c fastboot -l