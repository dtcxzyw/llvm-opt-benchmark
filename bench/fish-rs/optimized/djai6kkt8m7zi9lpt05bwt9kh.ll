@anon.1d0b41a8d45d477c3029ec78f9b8b434.1336 = private unnamed_addr constant [3370 x i8] c"# ht Bob B@Clojurians Slack\0A# https://raw.githubusercontent.com/bobisageek/bb-scripts/main/clj-alils.clj\0A#\0A# Babashka code for listing all aliases and tools available from the current context\0A# based on :config-files from `clojure -Sdescribe`\0A\0Aset -l bb_helper '\0A(require \\'[babashka.fs :as fs])\0A\0A(def config (->> (with-out-str (babashka.tasks/clojure \22-Sdescribe\22))\0A                 clojure.edn/read-string))\0A\0A(defn configs []\0A  (reverse (:config-files config)))\0A\0A(defn aliases-from-config [path]\0A  (->> (clojure.edn/read-string (slurp path))\0A       :aliases\0A       keys\0A       (map name)\0A       sort))\0A\0A(defn installed-tools\0A  []\0A  (as-> config $\0A    (:config-dir $)\0A    (str $ \22/tools/\22)\0A    (fs/match $ \22regex:.*\\\\\\\\.edn\22)\0A    (map fs/file-name $)\0A    (map #(fs/strip-ext % {:ext \22edn\22}) $)))\0A\0A(defn aliases []\0A  (->> (configs)\0A       (mapcat aliases-from-config)\0A       dedupe))\0A\0A(run! println\0A      (case (first *command-line-args*)\0A        \22tools\22 (installed-tools)\0A        (aliases)))'\0A\0Afunction __fish_clj_aliases -V bb_helper\0A    command -q bb; or return\0A    bb -e \22$bb_helper\22\0Aend\0A\0Afunction __fish_clj_tools -V bb_helper\0A    command -q bb; or return\0A    bb -e \22$bb_helper\22 tools\0Aend\0A\0Acomplete -c clj -s X -x -r -k -a \22(__fish_complete_list : __fish_clj_aliases)\22 -d \22Use concatenated aliases to modify classpath or supply exec fn/args\22\0Acomplete -c clj -s A -x -r -k -a \22(__fish_complete_list : __fish_clj_aliases)\22 -d \22Use concatenated aliases to modify classpath\22\0Acomplete -c clj -s M -x -r -k -a \22(__fish_complete_list : __fish_clj_aliases)\22 -d \22Use concatenated aliases to modify classpath or supply main opts\22\0Acomplete -c clj -s T -x -r -k -a \22(__fish_complete_list : __fish_clj_tools)\22 -d \22Invoke tool by name or via aliases ala -X\22\0A\0Acomplete -c clj -f -o Sdeps -r -d \22Deps data to use as the last deps file to be merged\22\0Acomplete -c clj -f -o Spath -d \22Compute classpath and echo to stdout only\22\0Acomplete -c clj -f -o Spom -d \22Generate (or update) pom.xml with deps and paths\22\0Acomplete -c clj -f -o Stree -d \22Print dependency tree\22\0Acomplete -c clj -f -o Scp -r -d \22Do NOT compute or cache classpath, use this one instead\22\0Acomplete -c clj -f -o Srepro -d \22Ignore the ~/.clojure/deps.edn config file\22\0Acomplete -c clj -f -o Sforce -d \22Force recomputation of the classpath (don't use the cache)\22\0Acomplete -c clj -f -o Sverbose -d \22Print important path info to console\22\0Acomplete -c clj -f -o Sdescribe -d \22Print environment and command parsing info as data\22\0Acomplete -c clj -f -o Sthreads -d \22Set specific number of download threads\22\0Acomplete -c clj -f -o Strace -d \22Write a trace.edn file that traces deps expansion\22\0A\0Acomplete -c clj -k -f -s h -l help -d \22Show help\22\0Acomplete -c clj -f -s P -d \22Prepare deps - download libs, cache classpath, but don't exec\22\0Acomplete -c clj -s J -d \22Pass opt through in java_opts, ex: -J-Xmx512m\22\0Acomplete -c clj -s i -l init -r -d \22Load a file or resource\22\0Acomplete -c clj -f -s e -l eval -r -d \22Eval exprs in string; print non-nil values\22\0Acomplete -c clj -f -l report -d \22Report uncaught exception to \\\22file\\\22 (default), \\\22stderr\\\22, or \\\22none\\\22\22\0Acomplete -c clj -f -o version -l version -d \22Print the version to stdout and exit\22\0Acomplete -c clj -f -s m -l main -d \22Call the -main function from namespace w/args\22\0Acomplete -c clj -f -s r -l repl -d \22Run a repl\22\0Acomplete -c clj -r -d \22Run a script from a file or resource\22\0A", align 1
