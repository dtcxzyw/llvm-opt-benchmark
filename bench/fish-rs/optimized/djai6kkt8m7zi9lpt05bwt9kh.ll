@anon.1d0b41a8d45d477c3029ec78f9b8b434.2446 = private unnamed_addr constant [7631 x i8] c"# Completions for qubes-gpg-client.\0A# These completions are mostly taken from fish's completions for gpg.\0A#\0A# Functions to generate completion options through gpg invocations\0A# are not implemented for this tool, as they are incompatible with\0A# Qubes's qrexec authorization prompts for split GPG (even if this worked,\0A# the resulting behavior would be quite annoying)\0A#\0A# Completions for nearly all of qubes-gpg-client's command line options\0A# are implemented-- the few that are excluded are not intended for\0A# interactive usage or are poorly documented.\0A\0Acomplete -c qubes-gpg-client -s b -l detach-sign -d \22Make a detached signature\22\0Acomplete -c qubes-gpg-client -s a -l armor -d \22Create ASCII armored output\22\0Acomplete -c qubes-gpg-client -s c -l symmetric -d \22Encrypt with a symmetric cipher using a passphrase\22\0Acomplete -c qubes-gpg-client -l decrypt -d \22Decrypt specified file or stdin\22\0Acomplete -c qubes-gpg-client -s e -l encrypt -d \22Encrypt data\22\0Acomplete -c qubes-gpg-client -s k -l list-keys -d \22List all keys from the public keyrings, or just the ones given on the command line\22\0Acomplete -c qubes-gpg-client -s K -l list-secret-keys -d \22List all keys from the secret keyrings, or just the ones given on the command line\22\0Acomplete -c qubes-gpg-client -s n -l dry-run -d \22Don't make any changes (this is not completely implemented)\22\0Acomplete -c qubes-gpg-client -s o -l output -r -d \22Write output to specified file\22\0Acomplete -c qubes-gpg-client -s q -l quiet -d \22Quiet mode\22\0Acomplete -c qubes-gpg-client -s r -l recipient -x -d \22Encrypt for specified user id\22\0Acomplete -c qubes-gpg-client -s R -l hidden-recipient -x -d \22Encrypt for specified user id, but hide the keyid of the key\22\0Acomplete -c qubes-gpg-client -s s -l sign -d \22Make a signature\22\0Acomplete -c qubes-gpg-client -s t -l textmode -d \22Treat input files as text and store them in the OpenPGP canonical text form with standard 'CRLF' line endings\22\0Acomplete -c qubes-gpg-client -s u -l local-user -x -d \22Use specified key as the key to sign with\22\0Acomplete -c qubes-gpg-client -s v -l verbose -d \22Give more information during processing\22\0Acomplete -c qubes-gpg-client -l always-trust -d \22Skip key validation and assume that used keys are always valid\22\0Acomplete -c qubes-gpg-client -l batch -d \22Batch mode\22\0Acomplete -c qubes-gpg-client -l cert-digest-algo -x -d \22Use specified message digest algorithm when signing a key\22\0Acomplete -c qubes-gpg-client -l charset -l display-charset -xa \22 iso-8859-1 iso-8859-2 iso-8859-15 koi8-r utf-8 \22 -d \22Set the native character set\22\0Acomplete -c qubes-gpg-client -l cipher-algo -x -d \22Use specified cipher algorithm\22\0Acomplete -c qubes-gpg-client -l clearsign -d \22Make a clear text signature\22\0Acomplete -c qubes-gpg-client -l command-fd -x -d \22Read user input from specified file descriptor\22\0Acomplete -c qubes-gpg-client -l comment -x -d \22Use specified string as comment string\22\0Acomplete -c qubes-gpg-client -l compress-algo -x -d \22Use specified compression algorithm\22\0Acomplete -c qubes-gpg-client -l digest-algo -x -d \22Use specified message digest algorithm\22\0Acomplete -c qubes-gpg-client -l disable-cipher-algo -x -d \22Never allow the use of specified cipher algorithm\22\0Acomplete -c qubes-gpg-client -l disable-mdc -d \22Disable the use of the modification detection code\22\0Acomplete -c qubes-gpg-client -l disable-pubkey-algo -x -d \22Never allow the use of specified public key algorithm\22\0Acomplete -c qubes-gpg-client -l emit-version -d \22Include the version string in ASCII armored output\22\0Acomplete -c qubes-gpg-client -l export -x -d 'Export all or the given keys from all keyrings'\0Acomplete -c qubes-gpg-client -l fingerprint -d \22List all keys with their fingerprints\22\0Acomplete -c qubes-gpg-client -l fixed-list-mode -d \22Do not merge primary user ID/key in --with-colons listing mode and make timestamps UNIX time\22\0Acomplete -c qubes-gpg-client -l force-mdc -d \22Force the use of encryption with a modification detection code\22\0Acomplete -c qubes-gpg-client -l force-v3-sigs -d \22Force v3 signatures for signatures on data\22\0Acomplete -c qubes-gpg-client -l force-v4-certs -d \22Always use v4 key signatures even on v3 keys\22\0Acomplete -c qubes-gpg-client -l gnupg -d \22Use standard GnuPG behavior\22\0Acomplete -c qubes-gpg-client -l list-options -d \22Display various internal configuration parameters of GnuPG\22\0Acomplete -c qubes-gpg-client -l list-only -d \22Changes the behaviour of some commands. This is like --dry-run but different\22\0Acomplete -c qubes-gpg-client -l list-public-keys -x -d \22List all keys from the public keyrings, or just the ones given on the command line\22\0Acomplete -c qubes-gpg-client -l list-sigs -d \22Same as --list-keys, but the signatures are listed too\22\0Acomplete -c qubes-gpg-client -l max-output -x -d \22Sets a limit on the number of bytes that will be generated when processing a file\22\0Acomplete -c qubes-gpg-client -l no-comments -d \22Don't use a comment string\22\0Acomplete -c qubes-gpg-client -l no-emit-version -d \22Don't include the version string in ASCII armored output\22\0Acomplete -c qubes-gpg-client -l no-force-v3-sigs -d \22Do not force v3 signatures for signatures on data\22\0Acomplete -c qubes-gpg-client -l no-force-v4-certs -d \22Don't use v4 key signatures on v3 keys\22\0Acomplete -c qubes-gpg-client -l no-greeting -d \22Suppress the initial copyright message\22\0Acomplete -c qubes-gpg-client -l no-secmem-warning -d \22Suppress the warning about 'using insecure memory'\22\0Acomplete -c qubes-gpg-client -l no-tty -d \22Never write output to terminal\22\0Acomplete -c qubes-gpg-client -l no-verbose -d \22Reset verbose level to 0\22\0Acomplete -c qubes-gpg-client -l openpgp -d \22Reset all packet, cipher, and digest options to strict OpenPGP behavior\22\0Acomplete -c qubes-gpg-client -l personal-cipher-preferences -x -d \22Set the list of personal cipher preferences to the specified string\22\0Acomplete -c qubes-gpg-client -l personal-compress-preferences -x -d \22Set the list of personal compression preferences to the specified string\22\0Acomplete -c qubes-gpg-client -l personal-digest-preferences -x -d \22Set the list of personal digest preferences to the specified string\22\0Acomplete -c qubes-gpg-client -l s2k-cipher-algo -x -d \22Use specified cipher algorithm to protect secret keys\22\0Acomplete -c qubes-gpg-client -l s2k-digest-algo -x -d \22Use specified digest algorithm to mangle the passphrases\22\0Acomplete -c qubes-gpg-client -l s2k-count -x -d \22Specify how many times the passphrase mangling for symmetric encryption is repeated\22\0Acomplete -c qubes-gpg-client -l s2k-mode -xa \220\\t'Plain passphrase' 1\\t'Salted passphrase' 3\\t'Repeated salted mangling'\22 -d \22Selects how passphrases are mangled\22\0Acomplete -c qubes-gpg-client -l status-fd -x -d \22Write special status strings to the specified file descriptor\22\0Acomplete -c qubes-gpg-client -l store -d \22Store only (make a simple RFC1991 packet)\22\0Acomplete -c qubes-gpg-client -l trust-model -xa \22pgp classic direct always\22 -d \22Specify trust model\22\0Acomplete -c qubes-gpg-client -l use-agent -d \22Try to use the GnuPG-Agent\22\0Acomplete -c qubes-gpg-client -l verify -r -d \22Assume specified file or stdin is sigfile and verify it\22\0Acomplete -c qubes-gpg-client -l version -d \22Display version and supported algorithms, and exit\22\0Acomplete -c qubes-gpg-client -l with-colons -d \22Print key listings delimited by colons\22\0Acomplete -c qubes-gpg-client -l with-fingerprint -d \22Like --fingerprint but only change the output format\22\0Acomplete -c qubes-gpg-client -l with-keygrip -d \22Include the keygrip in the key listings\22\0A\0A# qubes-gpg-client-wrapper wraps qubes-gpg-client and qubes-gpg-import-key, but the latter needs no\0A# completions (only takes a file as an argument)\0Acomplete -c qubes-gpg-client-wrapper -w qubes-gpg-client\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2447 = private unnamed_addr constant [22 x i8] c"completions/quilt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2448 = private unnamed_addr constant [2916 x i8] c"# completions for quilt version 0.46 or similar\0Acomplete -c quilt -s h -d \22Show help\22\0Acomplete -c quilt -l version -d \22Show version\22\0Acomplete -c quilt -l quiltrc -r --no-file -d \22Give the config file to use\22\0Acomplete -c quilt -l trace -r --no-file -d \22Runs the command in bash trace mode (-x). For internal debugging\22\0A\0Acomplete -c quilt -a add -r -d \22Add file(s) to the topmost/named patch\22\0Acomplete -c quilt -a annotate -r -d \22Print an annotated listing of the given file\22\0Acomplete -c quilt -a applied -r -d \22Print a list of applied patches\22\0Acomplete -c quilt -a delete -r -d \22Remove the topmost/given patch from the series file\22\0Acomplete -c quilt -a diff -r -d \22Produces a diff of the given file(s) in the topmost/given patch\22\0Acomplete -c quilt -a edit -r -d \22Edit the given file(s) in $EDITOR\22\0Acomplete -c quilt -a files -r -d \22Lists files that the topmost/given patch changes\22\0Acomplete -c quilt -a fold -r -d \22Integrate the patch read from standard input into the topmost patch\22\0Acomplete -c quilt -a fork -r --no-file -d \22Fork the topmost patch\22\0Acomplete -c quilt -a graph -r --no-file -d \22Generates a dot directed graph of patch dependencies\22\0Acomplete -c quilt -a grep -r --no-file -d \22Grep through source files recursively\22\0Acomplete -c quilt -a header -r --no-file -d \22Print/change the header of the topmost/given patch\22\0Acomplete -c quilt -a import -r -d \22Import external patches\22\0Acomplete -c quilt -a mail -r -d \22Create mail messages from patches in the series file, stores/sends them\22\0Acomplete -c quilt -a new -r -d \22Creates new patch with the given name, inserts it after topmost patch\22\0Acomplete -c quilt -a next -r -d \22Prints name of patch after the topmost/given patch in the series file\22\0Acomplete -c quilt -a patches -r -d \22Print the list of patches that modify the given file\22\0Acomplete -c quilt -a pop -r -d \22Remove patch(es) from the stack of applied patches\22\0Acomplete -c quilt -a previous -r -d \22Prints name of patch before the topmost/given patch in the series file\22\0Acomplete -c quilt -a push -r -d \22Apply patch(es) from the series file\22\0Acomplete -c quilt -a refresh -r -d \22Refresh the given patch, or the topmost patch by default\22\0Acomplete -c quilt -a remove -r -d \22Remove one or more files from the topmost/named patch\22\0Acomplete -c quilt -a rename -r -d \22Rename the topmost/named patch\22\0Acomplete -c quilt -a series -r --no-file -d \22Print the names of all patches in the series file\22\0Acomplete -c quilt -a setup -r -d \22Initializes a source tree from an rpm spec or a quilt series file\22\0Acomplete -c quilt -a snapshot -r --no-file -d \22Take a snapshot of the current working state\22\0Acomplete -c quilt -a top -d \22Prints name of the topmost patch in the current stack of applied patches\22\0Acomplete -c quilt -a unapplied -r -d \22List patches not applied or patches that follow the patch in the series file\22\0Acomplete -c quilt -a upgrade -d \22Upgrade meta-data in a working tree to the current version of quilt\22\0A", align 1
