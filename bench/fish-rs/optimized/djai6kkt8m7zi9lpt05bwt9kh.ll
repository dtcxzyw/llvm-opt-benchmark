@anon.1d0b41a8d45d477c3029ec78f9b8b434.1566 = private unnamed_addr constant [1048 x i8] c"complete -c encfs -s i -l idle -d \22Unmount when idle for specified MINUTES\22\0Acomplete -c encfs -s f -d \22Run in the foreground\22\0Acomplete -c encfs -s v -l verbose -d \22Verbose messages when run foreground\22\0Acomplete -c encfs -s s -d \22Run in single threaded mode\22\0Acomplete -c encfs -s d -l fuse-debug -d \22Enables debugging within the FUSE library\22\0Acomplete -c encfs -l forcedecode -d \22Return data even from corrupted files\22\0Acomplete -c encfs -l public -d \22Make files public to all other users\22\0Acomplete -c encfs -l ondemand -d \22Mount the filesystem on-demand\22\0Acomplete -c encfs -l reverse -d \22Produce encrypted view of plain files\22\0Acomplete -c encfs -l standard -d \22Use standard options when creating filesystem\22\0Acomplete -c encfs -s o -d \22Pass on options to FUSE\22\0Acomplete -c encfs -l no-default-flags -d \22Don't use the default FUSE flags\22\0Acomplete -c encfs -l extpass -d \22Get password from an external program\22\0Acomplete -c encfs -s S -l stdinpass -d \22Read password from standard input\22\0Acomplete -c encfs -l anykey -d \22Turn off key validation checking\22\0A", align 1
