@anon.1d0b41a8d45d477c3029ec78f9b8b434.1252 = private unnamed_addr constant [4467 x i8] c"# Filter Completion\0Afunction __fish_btrbk_complete_filter\0A    btrbk list config --format col:h:snapshot_name,source_subvolume,target_url | string replace -r '([^ ]+)\\s+([^ ]+)\\s+([^ ]*)' '$1\\t$2 -> $3'\0Aend\0A\0A# options with arguments\0Acomplete -c btrbk -l format -x -d 'Change output format' -a \22table long raw\22\0Acomplete -c btrbk -l loglevel -s l -x -d 'Set logging level' -a \22error warn info debug trace\22\0Acomplete -c btrbk -l exclude -x -d 'Exclude configured sections' -a \22(__fish_btrbk_complete_filter)\22\0Acomplete -c btrbk -l override -x -d 'Globally override a configuration option'\0A\0A# options with file completion\0Acomplete -c btrbk -l config -r -s c -d 'Specify configuration file'\0Acomplete -c btrbk -l lockfile -r -d 'Create and check lockfile'\0A\0A# options without arguments\0Acomplete -c btrbk -l help -s h -d 'Display this help message'\0Acomplete -c btrbk -l version -d 'Display version information'\0Acomplete -c btrbk -l dry-run -s n -d 'Perform a trial run with no changes made'\0Acomplete -c btrbk -l preserve -s p -d 'Preserve all (do not delete anything)'\0Acomplete -c btrbk -l preserve-snapshots -d 'Preserve snapshots (do not delete snapshots)'\0Acomplete -c btrbk -l preserve-backups -d 'Preserve backups (do not delete backups)'\0Acomplete -c btrbk -l wipe -d 'Delete all but latest snapshots'\0Acomplete -c btrbk -l verbose -s v -d 'Be more verbose (increase logging level)'\0Acomplete -c btrbk -l quiet -s q -d 'Be quiet (do not print backup summary)'\0Acomplete -c btrbk -l table -s t -d 'Change output to table format'\0Acomplete -c btrbk -l long -s L -d 'Change output to long format'\0Acomplete -c btrbk -l print-schedule -s S -d 'Print scheduler details (for the \22run\22 command)'\0Acomplete -c btrbk -l progress -d 'Show progress bar on send-receive operation'\0A\0A# uncommon options from manpage\0Acomplete -c btrbk -l single-column -s 1 -d 'Print output as a single column'\0Acomplete -c btrbk -l pretty -d 'Print pretty table output with lowercase and underlined column headings'\0Acomplete -c btrbk -l raw -d 'Create raw targets for archive command'\0A\0A# subcommands\0Acomplete -c btrbk -f -n __fish_use_subcommand -a run -d 'Run snapshot and backup operations'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a dryrun -d 'Show what would be executed without running btrfs commands'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a snapshot -d 'Run snapshot operations only'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a resume -d 'Run backup operations and delete snapshots'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a prune -d 'Only delete snapshots and backups'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a archive -d 'Recursively copy all subvolumes (src -> dst)'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a clean -d 'Delete incomplete (garbled) backups'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a stats -d 'Print snapshot/backup statistics'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a usage -d 'Print filesystem usage'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a ls -d 'List all btrfs subvolumes below a given path'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a origin -d 'Print origin information for a subvolume'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a diff -d 'List file changes between related subvolumes'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a extents -d 'Calculate accurate disk space usage for a path'\0Acomplete -c btrbk -f -n __fish_use_subcommand -a list -d 'List snapshots and backups'\0A\0A# subsubcommands for \22list\22\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a all -d 'List all snapshots and backups'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a snapshots -d 'List snapshots only'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a backups -d 'List backups and correlated snapshots'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a latest -d 'List most recent snapshots and backups'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a config -d 'List configured source/snapshot/target relations'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a source -d 'List configured source/snapshot relations'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a volume -d 'List configured volume sections'\0Acomplete -c btrbk -n '__fish_seen_subcommand_from list' -f -a target -d 'List configured targets'\0A\0Acomplete -c btrbk -n '__fish_seen_subcommand_from run dryrun snapshot resume prune clean' -x -a '(__fish_btrbk_complete_filter)'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1253 = private unnamed_addr constant [22 x i8] c"completions/btrfs.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1254 = private unnamed_addr constant [41899 x i8] c"# Completions for btrfs-progs\0A\0A# Todo:\0A# - (Done) Detailed options per command\0A# - Simplified duplicate options completion with `for`\0A# - Simplified descriptions\0A\0A# Filter the completions per primary command\0Afunction __btrfs_commands\0A    if not set -q argv[1]\0A        return 1\0A    end\0A    set -l cmd (commandline -cp)\0A    if string match -qr -- \22btrfs\\s+$argv[1]\\s+\\S*\22 $cmd\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A# Filter the completions per command group\0Afunction __btrfs_command_groups\0A    if not set -q argv[1]\0A        return 1\0A    end\0A    set -l cmd (commandline -cp)\0A    if set -q argv[2]\0A        if string match -qr -- \22btrfs\\s+$argv[1]\\s+$argv[2]\\s+\\S*\22 $cmd\0A            return 0\0A        end\0A        return 1\0A    end\0A    if string match -qr -- \22btrfs\\s+$argv[1]\\s+\\S*\\$\22 $cmd\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Aset -l check '__btrfs_commands check'\0Aset -l restore '__btrfs_commands restore'\0Aset -l send '__btrfs_commands send'\0Aset -l receive '__btrfs_commands receive'\0Aset -l help '__btrfs_commands help'\0A\0Aset -l subvolume '__btrfs_command_groups subvolume'\0Aset -l filesystem '__btrfs_command_groups filesystem'\0Aset -l balance '__btrfs_command_groups balance'\0Aset -l device '__btrfs_command_groups device'\0Aset -l scrub '__btrfs_command_groups scrub'\0Aset -l rescue '__btrfs_command_groups rescue'\0Aset -l inspect_internal '__btrfs_command_groups inspect-internal'\0Aset -l property '__btrfs_command_groups property'\0Aset -l quota '__btrfs_command_groups quota'\0Aset -l qgroup '__btrfs_command_groups qgroup'\0Aset -l replace '__btrfs_command_groups replace'\0A\0A# Global command\0Acomplete -f -c btrfs -l help -d 'Display help information'\0A\0A# Primary command\0Acomplete -f -c btrfs -n __fish_is_first_arg -a check -d 'Check structural integrity of a filesystem (unmounted).'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a restore -d 'Try to restore files from a damaged filesystem (unmounted)'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a send -d 'Send the subvolume(s) to stdout.'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a receive -d 'Receive subvolumes from a stream'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a help -d 'Display help information'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a version -d 'Display btrfs-progs version'\0A\0A# Primary command groups\0Acomplete -f -c btrfs -n __fish_is_first_arg -a subvolume -d 'manage subvolumes: create, delete, list, etc'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a filesystem -d 'overall filesystem tasks and information'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a balance -d 'balance data across devices, or change block groups using filters'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a device -d 'manage and query devices in the filesystem'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a scrub -d 'verify checksums of data and metadata'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a rescue -d 'toolbox for specific rescue operations'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a inspect-internal -d 'query various internal information'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a property -d 'modify properties of filesystem objects'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a quota -d 'manage filesystem quota settings'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a qgroup -d 'manage quota groups'\0Acomplete -f -c btrfs -n __fish_is_first_arg -a replace -d 'replace a device in the filesystem'\0A\0A# btrfs check\0Acomplete -f -c btrfs -n $check -s s -l super -d 'Use this SUPERBLOCK copy'\0Acomplete -f -c btrfs -n $check -s b -l backup -d 'Use the first valid BACKUP root copy'\0Acomplete -f -c btrfs -n $check -s r -l tree-root -d 'Use the given bytenr for the TREE root'\0Acomplete -f -c btrfs -n $check -l chunk-root -d 'Use the given bytenr for the CHUNK-TREE root'\0Acomplete -f -c btrfs -n $check -l readonly -d 'Run in read-only mode'\0Acomplete -f -c btrfs -n $check -l repair -d 'Try to repair the filesystem'\0Acomplete -f -c btrfs -n $check -l force -d 'Skip mount checks, repair is not possible'\0Acomplete -f -c btrfs -n $check -l mode -d 'Allows choice of memory/IO trade-offs' -ra '{original,lowmem}'\0Acomplete -f -c btrfs -n $check -l init-csum-tree -d 'Create a new CRC tree (repair only)'\0Acomplete -f -c btrfs -n $check -l init-extent-tree -d 'Create a new extent tree (repair only)'\0Acomplete -f -c btrfs -n $check -l clear-space-cache -d 'clear space cache (repair only)' -ra '{v1,v2}'\0Acomplete -f -c btrfs -n $check -l check-data-csum -d 'Verify checksums of data blocks'\0Acomplete -f -c btrfs -n $check -s Q -l qgroup-report -d 'Print a report on qgroup consistency'\0Acomplete -f -c btrfs -n $check -s E -l subvol-extents -d 'Print subvolume extents and sharing state'\0Acomplete -f -c btrfs -n $check -s p -l progress -d 'Indicate progress'\0A\0A# btrfs restore\0Acomplete -f -c btrfs -n $restore -s s -l snapshots -d 'Get snapshots'\0Acomplete -f -c btrfs -n $restore -s x -l xattr -d 'Restore extended attributes'\0Acomplete -f -c btrfs -n $restore -s m -l metadata -d 'Restore owner, mode and times'\0Acomplete -f -c btrfs -n $restore -s S -l symlink -d 'Restore symbolic links'\0Acomplete -f -c btrfs -n $restore -s v -l verbose -d Verbose\0Acomplete -f -c btrfs -n $restore -s i -l ignore-errors -d 'Ignore errors'\0Acomplete -f -c btrfs -n $restore -s o -l overwrite -d Overwrite\0Acomplete -f -c btrfs -n $restore -s t -r -d 'Tree location'\0Acomplete -f -c btrfs -n $restore -s f -r -d 'Filesystem location'\0Acomplete -f -c btrfs -n $restore -s u -l super -r -d 'Super mirror'\0Acomplete -f -c btrfs -n $restore -s r -l root -r -d 'Root objectid'\0Acomplete -f -c btrfs -n $restore -s d -d 'Find dir'\0Acomplete -f -c btrfs -n $restore -s l -l list-roots -d 'List tree roots'\0Acomplete -f -c btrfs -n $restore -s D -l dry-run -d 'Only list files that would be recovered'\0Acomplete -f -c btrfs -n $restore -l path-regex -r -d 'Restore only filenames matching regex'\0Acomplete -f -c btrfs -n $restore -s c -d 'Ignore case (--path-regex only)'\0A\0A# btrfs send\0Acomplete -f -c btrfs -n $send -s e -d ''\0Acomplete -f -c btrfs -n $send -s p -r -d 'Send an incremental stream from <parent> to <subvol>'\0Acomplete -f -c btrfs -n $send -s c -r -d 'Use this snapshot as a clone source for an incremental send'\0Acomplete -f -c btrfs -n $send -s f -r -d 'Output is normally written to stdout'\0Acomplete -f -c btrfs -n $send -l no-data -d 'send in NO_FILE_DATA mode'\0Acomplete -f -c btrfs -n $send -s v -l verbose -d 'Enable verbose output to stderr'\0Acomplete -f -c btrfs -n $send -s q -l quiet -d 'Suppress all messages, except errors'\0Acomplete -f -c btrfs -n $send -l proto -a '0 1 2' -r -d 'Use send protocol version'\0Acomplete -f -c btrfs -n $send -l proto -l compressed-data -d 'Send compressed data directly'\0A\0A# btrfs receive\0Acomplete -f -c btrfs -n $receive -s v -d 'Increase verbosity about performed actions'\0Acomplete -f -c btrfs -n $receive -s q -l quiet -d 'Suppress all messages, except errors'\0Acomplete -f -c btrfs -n $receive -s f -r -d 'Read the stream from FILE instead of stdin'\0Acomplete -f -c btrfs -n $receive -s e -d 'Terminate after receiving an <end cmd> marker in the stream'\0Acomplete -f -c btrfs -n $receive -s C -l chroot -d 'Confine the process to <mount> using chroot'\0Acomplete -f -c btrfs -n $receive -s E -l max-errors -r -d 'Terminate when NUMBER errors occur'\0Acomplete -f -c btrfs -n $receive -s m -r -d 'The root mount point of the destination filesystem'\0Acomplete -f -c btrfs -n $receive -l force-decompress -r -d 'Always decompress data'\0Acomplete -f -c btrfs -n $receive -l dump -d 'Dump stream metadata'\0A\0A# btrfs help\0Acomplete -f -c btrfs -n $help -l full -d 'Display detailed help on every command'\0Acomplete -f -c btrfs -n $help -l bo