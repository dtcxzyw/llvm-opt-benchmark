@anon.1d0b41a8d45d477c3029ec78f9b8b434.2616 = private unnamed_addr constant [981 x i8] c"# Sublime Merge CLI tool\0A\0Acomplete -c smerge -s n -l new-window -d 'Open a new window'\0Acomplete -c smerge -l launch-or-new-window -d 'Open new window only if app is running'\0Acomplete -c smerge -s b -l background -d \22Don't activate the application\22\0Acomplete -c smerge -l safe-mode -d 'Launch in a sandboxed environment'\0Acomplete -c smerge -s h -l help -d 'Show help (this message) and exit'\0Acomplete -c smerge -s v -l version -d 'Show version and exit'\0Acomplete -c smerge -a search -x -d 'Search for commits in the current repository'\0Acomplete -c smerge -a blame -r -d 'Blame the given file in the current repo'\0Acomplete -c smerge -a log -r -d 'Show the file history in the current repo'\0Acomplete -c smerge -a mergetool -rF -d 'Open the merge tool for the given files'\0Acomplete -c smerge -l no-wait -d \22Don't wait for the application to close\22 -n '__fish_seen_subcommand_from mergetool'\0Acomplete -c smerge -s o -rF -d \22Merged output file\22 -n \22__fish_seen_subcommand_from mergetool\22\0A", align 1
