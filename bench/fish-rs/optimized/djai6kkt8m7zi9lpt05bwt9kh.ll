@anon.1d0b41a8d45d477c3029ec78f9b8b434.1488 = private unnamed_addr constant [1043 x i8] c"# Completions for the JPEG XL Reference Software (https://gitlab.com/wg1/jpeg-xl)\0A\0Acomplete -c djxl -s V -l version -d \22Print version number\22\0Acomplete -x -c djxl -l num_reps\0Acomplete -c djxl -l use_sjpeg -d \22Use sjpeg instead of libjpeg\22\0Acomplete -x -c djxl -l jpeg_quality -d \22JPEG output quality\22\0Acomplete -x -c djxl -l num_threads -d \22The number of threads to use\22\0Acomplete -x -c djxl -l print_profile -a \220 1\22 -d \22Print timing information\22\0Acomplete -x -c djxl -l print_info -a \220 1\22 -d \22Print AuxOut\22\0Acomplete -x -c djxl -l bits_per_sample\0Acomplete -x -c djxl -l color_space\0Acomplete -x -c djxl -s s -l downsampling -a \221 2 4 8 16\22 -d \22Maximum permissible downsampling factor\22\0Acomplete -c djxl -l allow_partial_files -d \22Allow decoding of truncated files\22\0Acomplete -c djxl -l allow_more_progressive_steps -d \22Allow decoding more progressive steps\22\0Acomplete -c djxl -s j -l jpeg -d \22Decode directly to JPEG\22\0Acomplete -c djxl -l print_read_bytes -d \22Print total number of decoded bytes\22\0Acomplete -c djxl -s h -l help -d \22Print help message\22\0A", align 1
