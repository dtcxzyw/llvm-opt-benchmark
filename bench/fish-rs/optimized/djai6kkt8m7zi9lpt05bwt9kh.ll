@anon.1d0b41a8d45d477c3029ec78f9b8b434.3214 = private unnamed_addr constant [305 x i8] c"set -l dir \22$(path dirname -- (status fish-path 2>/dev/null))\22\0A\0Aif command -v $dir/fish_indent >/dev/null\0A    function __fish_indent --wraps fish_indent --inherit-variable dir\0A        $dir/fish_indent $argv\0A    end\0Aelse\0A    function __fish_indent --wraps fish_indent\0A        fish_indent $argv\0A    end\0Aend\0A", align 1
