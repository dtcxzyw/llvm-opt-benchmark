@anon.1d0b41a8d45d477c3029ec78f9b8b434.3184 = private unnamed_addr constant [5220 x i8] c"function __fish_complete_zfs_rw_properties -d \22Completes with ZFS read-write properties\22\0A    set -l OS \22\22\0A    switch (uname)\0A        case Linux\0A            set OS Linux\0A        case Darwin\0A            set OS macOS\0A        case FreeBSD\0A            set OS FreeBSD\0A        case SunOS\0A            set OS SunOS\0A            # Others?\0A        case \22*\22\0A            set OS unknown\0A    end\0A    echo -e \22aclinherit\\tInheritance of ACL entries (discard, noallow, restricted, passthrough, passthrough-x)\22\0A    echo -e \22atime\\tUpdate access time on read (on, off)\22\0A    echo -e \22canmount\\tIs the dataset mountable (on, off, noauto)\22\0A    set -l additional_algs ''\0A    if contains -- $OS FreeBSD SunOS\0A        set additional_algs \22$additional_algs, noparity\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@sha512\22\0A        set additional_algs \22$additional_algs, sha512\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@skein\22\0A        set additional_algs \22$additional_algs, skein\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@edonr\22\0A        set additional_algs \22$additional_algs, edonr\22\0A    end\0A    echo -e \22checksum\\tData checksum (on, off, fletcher2, fletcher4, sha256$additional_algs)\22\0A    if __fish_is_zfs_feature_enabled \22feature@lz4_compress\22\0A        set additional_algs \22, lz4\22\0A    end\0A    echo -e \22compression\\tCompression algorithm (on, off, lzjb$additional_algs, gzip, gzip-[1-9], zle)\22\0A    set -e additional_algs\0A    echo -e \22copies\\tNumber of copies of data (1, 2, 3)\22\0A    echo -e \22dedup\\tDeduplication (on, off, verify, sha256[,verify])\22\0A    echo -e \22devices\\tAre contained device nodes openable (on, off)\22\0A    echo -e \22exec\\tCan contained executables be executed (on, off)\22\0A    echo -e \22filesystem_limit\\tMax number of filesystems and volumes (COUNT, none)\22\0A    echo -e \22mountpoint\\tMountpoint (PATH, none, legacy)\22\0A    echo -e \22primarycache\\tWhich data to cache in ARC (all, none, metadata)\22\0A    echo -e \22quota\\tMax size of dataset and children (SIZE, none)\22\0A    echo -e \22snapshot_limit\\tMax number of snapshots (COUNT, none)\22\0A    echo -e \22readonly\\tRead-only (on, off)\22\0A    echo -e \22recordsize\\tSuggest block size (SIZE)\22\0A    echo -e \22redundant_metadata\\tHow redundant are the metadata (all, most)\22\0A    echo -e \22refquota\\tMax space used by dataset itself (SIZE, none)\22\0A    echo -e \22refreservation\\tMin space guaranteed to dataset itself (SIZE, none)\22\0A    echo -e \22reservation\\tMin space guaranteed to dataset (SIZE, none)\22\0A    echo -e \22secondarycache\\tWhich data to cache in L2ARC (all, none, metadata)\22\0A    echo -e \22setuid\\tRespect set-UID bit (on, off)\22\0A    echo -e \22sharenfs\\tShare in NFS (on, off, OPTS)\22\0A    echo -e \22logbias\\tHint for handling of synchronous requests (latency, throughput)\22\0A    echo -e \22snapdir\\tHide .zfs directory (hidden, visible)\22\0A    echo -e \22sync\\tHandle of synchronous requests (standard, always, disabled)\22\0A    echo -e \22volsize\\tVolume logical size (SIZE)\22\0A\0A    # Autogenerate userquota@$USER list; only usernames are supported by the completion, but the zfs command supports more formats\0A    for user in (__fish_print_users)\0A        set -l tabAndBefore (echo -e \22userquota@$user\\t\22)\0A        printf \22%sMax usage by user %s\\n\22 $tabAndBefore $user\0A    end\0A    # Autogenerate groupquota@$USER list\0A    for group in (__fish_print_groups)\0A        set -l tabAndBefore (echo -e \22groupquota@$group\\t\22)\0A        printf \22%sMax usage by group %s\\n\22 $tabAndBefore $group\0A    end\0A    if test $OS = SunOS\0A        echo -e \22aclmode\\tHow is ACL modified by chmod (discard, groupmask, passthrough, restricted)\22\0A        echo -e \22mlslabel\\tCan the dataset be mounted in a zone with Trusted Extensions enabled (LABEL, none)\22\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22sharesmb\\tShare in Samba (on, off)\22\0A        echo -e \22shareiscsi\\tShare as an iSCSI target (on, off)\22\0A        echo -e \22version\\tOn-disk version of filesystem (1, 2, current)\22\0A        echo -e \22vscan\\tScan regular files for viruses on opening and closing (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A        echo -e \22zoned\\tManaged from a non-global zone (on, off)\22\0A    else if test $OS = Linux\0A        echo -e \22acltype\\tUse no ACL or POSIX ACL (noacl, posixacl)\22\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22relatime\\tSometimes update access time on read (on, off)\22\0A        echo -e \22shareiscsi\\tShare as an iSCSI target (on, off)\22\0A        echo -e \22sharesmb\\tShare in Samba (on, off)\22\0A        echo -e \22snapdev\\tHide volume snapshots (hidden, visible)\22\0A        echo -e \22version\\tOn-disk version of filesystem (1, 2, current)\22\0A        echo -e \22vscan\\tScan regular files for viruses on opening and closing (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A    else if test $OS = FreeBSD\0A        echo -e \22aclmode\\tHow is ACL modified by chmod (discard, groupmask, passthrough, restricted)\22\0A        echo -e \22volmode\\tHow to expose volumes to OS (default, geom, dev, none)\22\0A    end\0A    # User properties; the /dev/null redirection masks the possible \22no datasets available\22\0A    zfs list -o all 2>/dev/null | head -n 1 | string replace -a -r \22\\s+\22 \22\\n\22 | string match -e \22:\22 | string lower\0Aend\0A", align 1
