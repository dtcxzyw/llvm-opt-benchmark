@anon.1d0b41a8d45d477c3029ec78f9b8b434.2840 = private unnamed_addr constant [950 x i8] c"# plain vi (as bundled with SunOS 5.8)\0A# todo:\0A# -wn : Set the default window size to n\0A# +command : same as -c command\0A\0A# Check if vi is really vim\0Aif vi --version >/dev/null 2>/dev/null\0A    complete -c vi -w vim\0Aelse\0A    complete -c vi -s s -d 'Suppress all interactive user feedback'\0A    complete -c vi -s C -d 'Encrypt/decrypt text'\0A    complete -c vi -s l -d 'Set up for editing LISP programs'\0A    complete -c vi -s L -d 'List saved file names after crash'\0A    complete -c vi -s R -d 'Read-only mode'\0A    complete -c vi -s S -d 'Use linear search for tags if tag file not sorted'\0A    complete -c vi -s v -d 'Start in display editing state'\0A    complete -c vi -s V -d 'Verbose mode'\0A    complete -c vi -s x -d 'Encrypt/decrypt text'\0A    complete -c vi -r -s r -d 'Recover file after crash'\0A    complete -c vi -r -s t -d 'Edit the file containing a tag'\0A    complete -c vi -r -c t -d 'Begin editing by executing the specified  editor command'\0Aend\0A", align 1
