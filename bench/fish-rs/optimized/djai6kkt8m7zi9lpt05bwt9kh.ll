@anon.1d0b41a8d45d477c3029ec78f9b8b434.3124 = private unnamed_addr constant [950 x i8] c"# Helper function for contextual autocompletion of GPG key ids\0A\0Afunction __fish_complete_gpg_key_id -d 'Complete using gpg key ids' -a __fish_complete_gpg_command list_arg\0A    # Use user id as description\0A    set -l keyid\0A    set -q list_arg[1]; or set list_arg --list-keys\0A    $__fish_complete_gpg_command $list_arg --with-colons | while read -l garbage\0A        switch $garbage\0A            case \22uid*\22\0A                # Extract user ids (note: gpg escapes colons as '\\x3a')\0A                set -l __uid (string split \22:\22 -- $garbage)\0A                set -l uid (string replace -a '\\x3a' ':' -- $__uid[10])\0A                printf \22%s\\t%s\\n\22 $keyid $uid\0A                # NOTE key is preceded by \22sec\22 instead of \22pub\22 when listing secret keys\0A            case \22pub*\22 \22sec*\22\0A                # Extract key fingerprints (no subkeys)\0A                set -l __pub (string split \22:\22 -- $garbage)\0A                set keyid $__pub[5]\0A        end\0A    end\0Aend\0A", align 1
