@anon.1d0b41a8d45d477c3029ec78f9b8b434.1636 = private unnamed_addr constant [21900 x i8] c"function __fish_print_firewalld_zones --description \22Print list of predefined firewalld zones\22\0A    firewall-cmd --get-zones | string split \22 \22\0Aend\0A\0Afunction __fish_print_firewalld_policies --description \22Print list of predefined firewalld policies\22\0A    firewall-cmd --get-policies | string split \22 \22\0Aend\0A\0Afunction __fish_print_firewalld_services --description \22Print list of predefined firewalld services\22\0A    firewall-cmd --get-services | string split \22 \22\0Aend\0A\0Afunction __fish_print_firewalld_icmptypes --description \22Print list of ICMP types supported by firewalld\22\0A    firewall-cmd --get-icmptypes | string split \22 \22\0Aend\0A\0Afunction __fish_print_firewalld_helpers --description \22Print list of predefined firewalld helpers\22\0A    firewall-cmd --get-helpers | string split \22 \22\0Aend\0A\0Afunction __fish_print_firewalld_protocols --description \22Print list of protocols supported by firewalld\22\0A    string replace -f -r '^([[:alnum:]]\\S*).*' '$1' </etc/protocols\0Aend\0A\0Acomplete -c firewall-cmd -f\0A\0A# General Options\0Acomplete -c firewall-cmd -s h -l help -d \22Prints a short help text and exits\22\0Acomplete -c firewall-cmd -s V -l version -d \22Print the version string of firewalld\22\0Acomplete -c firewall-cmd -s q -l quiet -d \22Do not print status messages\22\0A\0A# Status Options\0Acomplete -c firewall-cmd -l state -d \22Check whether the firewalld daemon is active\22\0Acomplete -c firewall-cmd -l reload -d \22Reload firewall rules and keep state information\22\0Acomplete -c firewall-cmd -l complete-reload -d \22Reload firewall completely, even netfilter kernel modules\22\0Acomplete -c firewall-cmd -l runtime-to-permanent -d \22Save active runtime configuration and overwrite permanent configuration\22\0Acomplete -c firewall-cmd -l check-config -d \22Run checks on the permanent configuration\22\0A\0A# Log Denied Options\0Acomplete -c firewall-cmd -l get-log-denied -d \22Print the log denied setting\22\0Acomplete -c firewall-cmd -l set-log-denied -xa \22all unicast broadcast multicast off\22 -d \22Add logging rules right before reject and drop rules\22\0A\0A# Permanent Options\0Acomplete -c firewall-cmd -l permanent -d \22Set options permanently\22\0A\0A# Zone Options\0Acomplete -c firewall-cmd -l get-default-zone -d \22Print default zone for connections and interfaces\22\0Acomplete -c firewall-cmd -l set-default-zone -xa \22(__fish_print_firewalld_zones)\22 -d \22Set default zone for connections and interfaces\22\0Acomplete -c firewall-cmd -l get-active-zones -d \22Print currently active zones altogether with interfaces and sources\22\0Acomplete -c firewall-cmd -l get-zones -d \22Print predefined zones\22\0Acomplete -c firewall-cmd -l get-services -d \22Print predefined services\22\0Acomplete -c firewall-cmd -l get-icmptypes -d \22Print predefined icmptypes\22\0Acomplete -c firewall-cmd -l get-zone-of-interface -xa \22(__fish_print_interfaces)\22 -d \22Print the name of the zone the interface is bound to\22\0Acomplete -c firewall-cmd -l get-zone-of-source -x -d \22Print the name of the zone the source is bound to\22\0Acomplete -c firewall-cmd -l info-zone -xa \22(__fish_print_firewalld_zones)\22 -d \22Print information about the zone\22\0Acomplete -c firewall-cmd -l list-all-zones -d \22List everything added for or enabled in all zones\22\0Acomplete -c firewall-cmd -l new-zone -x -d \22Add a new permanent and empty zone\22\0Acomplete -c firewall-cmd -l new-zone-from-file -F -d \22Add a new permanent zone from a prepared zone file\22\0Acomplete -c firewall-cmd -l delete-zone -xa \22(__fish_print_firewalld_zones)\22 -d \22Delete an existing permanent zone\22\0Acomplete -c firewall-cmd -l load-zone-defaults -xa \22(__fish_print_firewalld_zones)\22 -d \22Load zone default settings\22\0Acomplete -c firewall-cmd -l path-zone -xa \22(__fish_print_firewalld_zones)\22 -d \22Print path of the zone configuration file\22\0A\0A# Policy Options\0Acomplete -c firewall-cmd -l get-policies -d \22Print predefined policies\22\0Acomplete -c firewall-cmd -l info-policy -xa \22(__fish_print_firewalld_policies)\22 -d \22Print information about the policy\22\0Acomplete -c firewall-cmd -l list-all-policies -d \22List everything added for or enabled in all policies\22\0Acomplete -c firewall-cmd -l new-policy -x -d \22Add a new permanent policy\22\0Acomplete -c firewall-cmd -l new-policy-from-file -F -d \22Add a new permanent policy from a prepared policy file\22\0Acomplete -c firewall-cmd -l path-policy -xa \22(__fish_print_firewalld_policies)\22 -d \22Print path of the policy configuration file\22\0Acomplete -c firewall-cmd -l delete-policy -xa \22(__fish_print_firewalld_policies)\22 -d \22Delete an existing permanent policy\22\0Acomplete -c firewall-cmd -l load-policy-defaults -xa \22(__fish_print_firewalld_policies)\22 -d \22Load the shipped defaults for a policy\22\0A\0A# Options to Adapt and Query Zones and Policies\0Acomplete -c firewall-cmd -l zone -xa \22(__fish_print_firewalld_zones)\22 -d \22Apply option to this zone\22\0Acomplete -c firewall-cmd -l policy -xa \22(__fish_print_firewalld_policies)\22 -d \22Apply option to this policy\22\0Acomplete -c firewall-cmd -l get-target -d \22Get the target\22\0Acomplete -c firewall-cmd -l set-target -xa \22default CONTINUE ACCEPT DROP REJECT\22 -d \22Set the target\22\0Acomplete -c firewall-cmd -l list-all -d \22List everything added for or enabled\22\0Acomplete -c firewall-cmd -l list-services -d \22List services added\22\0Acomplete -c firewall-cmd -l add-service -xa \22(__fish_print_firewalld_services)\22 -d \22Add a service\22\0Acomplete -c firewall-cmd -l remove-service -xa \22(__fish_print_firewalld_services)\22 -d \22Remove a service\22\0Acomplete -c firewall-cmd -l query-service -xa \22(__fish_print_firewalld_services)\22 -d \22Return whether service has been added\22\0Acomplete -c firewall-cmd -l list-ports -d \22List ports added\22\0Acomplete -c firewall-cmd -l list-protocols -d \22List protocols added\22\0Acomplete -c firewall-cmd -l list-source-ports -d \22List source ports added\22\0Acomplete -c firewall-cmd -l list-icmp-blocks -d \22List ICMPs type blocks added\22\0Acomplete -c firewall-cmd -l add-icmp-block -xa \22(__fish_print_firewalld_icmptypes)\22 -d \22Add an ICMP block for icmptype\22\0Acomplete -c firewall-cmd -l remove-icmp-block -xa \22(__fish_print_firewalld_icmptypes)\22 -d \22Remove the ICMP block for icmptype\22\0Acomplete -c firewall-cmd -l query-icmp-block -xa \22(__fish_print_firewalld_icmptypes)\22 -d \22Return whether an ICMP block for icmptype has been added\22\0Acomplete -c firewall-cmd -l list-forward-ports -d \22List IPv4 forward ports added\22\0Acomplete -c firewall-cmd -l add-forward-port -x -d \22Add the IPv4 forward port\22\0Acomplete -c firewall-cmd -l remove-forward-port -x -d \22Remove the IPv4 forward port\22\0Acomplete -c firewall-cmd -l query-forward-port -x -d \22Return whether the IPv4 forward port has been added\22\0Acomplete -c firewall-cmd -l add-masquerade -d \22Enable IPv4 masquerade\22\0Acomplete -c firewall-cmd -l remove-masquerade -d \22Disable IPv4 masquerade\22\0Acomplete -c firewall-cmd -l query-masquerade -d \22Return whether IPv4 masquerading has been enabled\22\0Acomplete -c firewall-cmd -l list-rich-rules -d \22List rich language rules added\22\0Acomplete -c firewall-cmd -l add-rich-rule -x -d \22Add rich language rule\22\0Acomplete -c firewall-cmd -l remove-rich-rule -x -d \22Remove rich language rule\22\0Acomplete -c firewall-cmd -l query-rich-rule -x -d \22Return whether the rich language rule has been added\22\0Acomplete -c firewall-cmd -l timeout -x -d \22The rule will be active for the specified amount of time\22\0A\0A# Options to Adapt and Query Zones\0Acomplete -c firewall-cmd -l add-icmp-block-inversion -d \22Enable ICMP block inversion\22\0Acomplete -c firewall-cmd -l remove-icmp-block-inversion -d \22Disable ICMP block inversion\22\0Acomplete -c firewall-cmd -l query-icmp-block-inversion -d \22Return whether ICMP block inversion is enabled\22\0Acomplete -c firewall-cmd -l add-forward -d \22Enable intra zone forwarding\22\0Acomplete -c firewall-cmd -l remove-forward -d \22Disable intra zone forwarding\22\0Acomplete -c firewall-cmd -l query-forward -d \22Return whether intra zone forwarding is enabled\22\0A\0A# Options to Adapt and Query Policies\0Acomplete -c firewall-cmd -l get-priority -d \22Get the priority\22\0Acomplete -c firewall-cmd -l set-priority -x -d \22Set the priority\22\0Acomplete -c firewall-cmd -l list-ingress-zones -d \22List ingress zones added\22\0Acomplete -c firewall-cmd -l add-ingress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Add an ingress zone\22\0Acomplete -c firewall-cmd -l remove-ingress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Remove an ingress zone\22\0Acomplete -c firewall-cmd -l query-ingress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Return whether zone has been added\22\0Acomplete -c firewall-cmd -l list-egress-zones -d \22List egress zones added\22\0Acomplete -c firewall-cmd -l add-egress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Add an egress zone\22\0Acomplete -c firewall-cmd -l remove-egress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Remove an egress zone\22\0Acomplete -c firewall-cmd -l query-egress-zone -xa \22(__fish_print_firewalld_zones) HOST ANY\22 -d \22Return whether zone has been added\22\0A\0A# Options to Handle Bindings of Interfaces\0Acomplete -c firewall-cmd -l list-interfaces -d \22List interfaces that are bound to zone\22\0Acomplete -c firewall-cmd -l add-interface -xa \22(__fish_print_interfaces)\22 -d \22Bind interface to zone\22\0Acomplete -c firewall-cmd -l change-interface -xa \22(__fish_print_interfaces)\22 -d \22Change to which zone interface is bound\22\0Acomplete -c firewall-cmd -l query-interface -