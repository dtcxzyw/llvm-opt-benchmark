@anon.1d0b41a8d45d477c3029ec78f9b8b434.2424 = private unnamed_addr constant [4324 x i8] c"# fish completion for pyenv\0A\0Afunction __fish_pyenv_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_pyenv_using_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_pyenv_executables\0A    pyenv exec --complete\0Aend\0A\0Afunction __fish_pyenv_installed_versions\0A    pyenv versions --bare\0Aend\0A\0Afunction __fish_pyenv_available_versions\0A    # Remove trailing spaces, otherwise completion options appear like\0A    # \22\\ \\ option\22\0A    pyenv install --list | sed \22s/^[[:space:]]*//\22\0Aend\0A\0Afunction __fish_pyenv_prefixes\0A    pyenv prefix --complete\0Aend\0A\0A### commands\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a commands -d 'List all available pyenv commands'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command commands' -a '--sh --no-sh'\0A\0A### completions\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a completions\0A\0A### exec\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a exec\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command exec' -a '(__fish_pyenv_executables)'\0A\0A### global\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a global -d 'Set or show the global Python version'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command global' -a '(__fish_pyenv_installed_versions)'\0A\0A### help\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a help\0A\0A### hooks\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a hooks -d 'List hook scripts for a given pyenv command'\0A\0A### init\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a init -d 'Configure the shell environment for pyenv'\0A\0A### install\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a install -d 'Install a Python version'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command install' -a '(__fish_pyenv_available_versions)'\0A\0A### local\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a local -d 'Set or show the local application-specific Python version'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command local' -a '(__fish_pyenv_installed_versions)'\0A\0A### prefix\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a prefix -d 'Display the directory where a Python version is installed'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command prefix' -a '(__fish_pyenv_prefixes)'\0A\0A### rehash\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a rehash -d 'Rehash pyenv shims (run this after installing executables)'\0A\0A### root\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a root -d 'Display the root directory where versions and shims are kept'\0A\0A### shell\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a shell -d 'Set or show the shell-specific Python version'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command shell' -a '--unset (__fish_pyenv_installed_versions)'\0A\0A### shims\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a shims -d 'List existing pyenv shims'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command shims' -a --short\0A\0A### version\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version -d 'Show the current Python version & how it was selected'\0A\0A### version-file\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version-file -d 'Detect the file that sets the current pyenv version'\0A\0A### version-file-read\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version-file-read\0A\0A### version-file-write\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version-file-write\0A\0A### version-name\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version-name -d 'Show the current Python version'\0A\0A### version-origin\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a version-origin -d 'Explain how the current Python version is set'\0A\0A### versions\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a versions -d 'List all Python versions known by pyenv'\0A\0A### whence\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a whence -d 'List all Python versions that contain the given executable'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command whence' -a --path\0A\0A### which\0Acomplete -f -c pyenv -n __fish_pyenv_needs_command -a which -d 'Show the full path for the given Python executable'\0Acomplete -f -c pyenv -n '__fish_pyenv_using_command which' -a '(__fish_pyenv_executables)'\0A", align 1
