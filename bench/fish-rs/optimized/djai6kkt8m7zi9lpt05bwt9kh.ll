@anon.1d0b41a8d45d477c3029ec78f9b8b434.2406 = private unnamed_addr constant [2833 x i8] c"complete -c psql --no-files -a '(__fish_complete_pg_database)'\0A\0A# General options:\0Acomplete -c psql -s d -l dbname -x -a '(__fish_complete_pg_database)' -d \22Database name to connect to\22\0Acomplete -c psql -s c -l command -d \22Run only single command (SQL or internal) and exit\22\0Acomplete -c psql -s f -l file -r -d \22Execute commands from file, then exit\22\0Acomplete -c psql -s l -l list -d \22List available databases, then exit\22\0Acomplete -c psql -s v -l set -l variable -x -d \22Set psql variable NAME to VALUE\22\0Acomplete -c psql -s X -l no-psqlrc -d \22Do not read startup file (~/.psqlrc)\22\0Acomplete -c psql -s 1 -l single-transaction -d \22Execute command file as a single transaction\22\0Acomplete -c psql -s '?' -l help -a \22options commands variables\22 -d \22Show this help, then exit\22\0Acomplete -c psql -l version -d \22Output version information, then exit\22\0A\0A# Input and output options:\0Acomplete -c psql -s a -l echo-all -d \22Echo all input from script\22\0Acomplete -c psql -s b -l echo-errors -d \22Echo failed commands\22\0Acomplete -c psql -s e -l echo-queries -d \22Echo commands sent to server\22\0Acomplete -c psql -s E -l echo-hidden -d \22Display queries that internal commands generate\22\0Acomplete -c psql -s L -l log-file -r -d \22Send session log to file\22\0Acomplete -c psql -s n -l no-readline -d \22Disable enhanced command line editing (readline)\22\0Acomplete -c psql -s o -l output -r -d \22Send query results to file (or |pipe)\22\0Acomplete -c psql -s q -l quiet -d \22Run quietly (no messages, only query output)\22\0Acomplete -c psql -s s -l single-step -d \22Single-step mode (confirm each query)\22\0Acomplete -c psql -s S -l single-line -d \22Single-line mode (end of line terminates SQL command)\22\0A\0A# Output format options:\0Acomplete -c psql -s A -l no-align -d \22Unaligned table output mode\22\0Acomplete -c psql -s H -l html -d \22HTML table output mode\22\0Acomplete -c psql -s P -l pset -d \22Set printing option VAR to ARG (see \\pset command)\22\0Acomplete -c psql -s t -l tuples-only -d \22Print rows only\22\0Acomplete -c psql -s T -l table-attr -d \22Set HTML table tag attributes (e.g., width, border)\22\0Acomplete -c psql -s x -l expanded -d \22Turn on expanded table output\22\0Acomplete -c psql -s F -l field-separator -x -d \22Set field separator (default: '|')\22\0Acomplete -c psql -s R -l record-separator -x -d \22Set record separator (default: newline)\22\0Acomplete -c psql -s 0 -l record-separator-zero -d \22Set record separator for unaligned output to zero byte\22\0A\0A# Connection options:\0Acomplete -c psql -s h -l host -x -a '(__fish_print_hostnames)' -d \22Database server host or socket directory\22\0Acomplete -c psql -s p -l port -x -d \22Database server port\22\0Acomplete -c psql -s U -l username -x -a '(__fish_complete_pg_user)' -d \22Database user name\22\0Acomplete -c psql -s w -l no-password -d \22Never prompt for password\22\0Acomplete -c psql -s W -l password -d \22Force password prompt (should happen automatically)\22\0A", align 1
