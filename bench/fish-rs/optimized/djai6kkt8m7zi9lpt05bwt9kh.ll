@anon.1d0b41a8d45d477c3029ec78f9b8b434.2974 = private unnamed_addr constant [4902 x i8] c"function __fish_print_xrandr_outputs --description 'Print xrandr outputs'\0A    xrandr | string replace -r --filter '^(\\S+)\\s+(.*)$' '$1\\t$2' | string match -v -e Screen\0Aend\0A\0Afunction __fish_print_xrandr_modes --description 'Print xrandr modes'\0A    set -l output\0A    xrandr | string match -v -r '^(Screen|\\s{4,})' | while read -l line\0A        switch $line\0A            case '  *'\0A                string trim $line | string replace -r '^(\\S+)\\s+(.*)$' \22\\$1\\t\\$2 [$output]\22\0A            case '*'\0A                set output (string match -r '^\\S+' $line)\0A        end\0A    end\0Aend\0A\0Acomplete -c xrandr -l verbose -d 'Be more verbose'\0Acomplete -c xrandr -l dryrun -d 'Make no changes'\0Acomplete -c xrandr -l nograb -d 'Apply modifications without grabbing the screen'\0Acomplete -c xrandr -o help -l help -d 'Print out a summary of the usage and exit'\0Acomplete -c xrandr -s v -l version -d 'Print out the RandR version reported by the X server and exit'\0Acomplete -c xrandr -s q -l query -d 'Display the current state of the system'\0Acomplete -c xrandr -s d -o display -l display -d 'Select X display to use' -x\0Acomplete -c xrandr -l screen -d 'Select which screen to manipulate' -x\0Acomplete -c xrandr -l q1 -d 'Use RandR version 1.1 protocol'\0Acomplete -c xrandr -l q12 -d 'Use RandR version 1.2 protocol'\0Acomplete -c xrandr -s s -l size -d 'Set the screen size (index or width x height)' -x\0Acomplete -c xrandr -s r -l rate -l refresh -d 'Set the refresh rate closest to the specified value' -x\0Acomplete -c xrandr -s o -l orientation -d 'Specify the orientation of the screen' -xa 'normal inverted left right'\0Acomplete -c xrandr -s x -d 'Reflect across the X axis'\0Acomplete -c xrandr -s y -d 'Reflect across the Y axis'\0Acomplete -c xrandr -l listmonitors -d 'Print all defined monitors'\0Acomplete -c xrandr -l listactivemonitors -d 'Print all active monitors'\0Acomplete -c xrandr -l setmonitor -d 'Define new monitor' -x\0Acomplete -c xrandr -l delmonitor -d 'Delete monitor' -x\0Acomplete -c xrandr -l listproviders -d 'Print all available providers'\0Acomplete -c xrandr -l setprovideroutputsource -d 'Set source for a given provider'\0Acomplete -c xrandr -l setprovideroffloadsink -d 'Set provider for a given sink'\0Acomplete -c xrandr -l noprimary -d \22Don't define a primary output\22\0Acomplete -c xrandr -l current -d 'Print current screen configuration'\0Acomplete -c xrandr -l panning -d 'Set panning parameters' -x\0Acomplete -c xrandr -l transform -d 'Set transformation matrix' -x\0Acomplete -c xrandr -l scale -d 'Set screen scale' -x\0Acomplete -c xrandr -l primary -d 'Set the output as primary'\0Acomplete -c xrandr -l filter -d 'Set scaling filter method' -xa 'bilinear nearest'\0Acomplete -c xrandr -l prop -l properties -d 'Display the contents of properties for each output'\0Acomplete -c xrandr -l fb -d 'Set screen size' -x\0Acomplete -c xrandr -l fbmm -d 'Set reported physical screen size' -x\0Acomplete -c xrandr -l dpi -d 'Set dpi to calculate reported physical screen size'\0Acomplete -c xrandr -l newmode -d 'Add new mode' -r\0Acomplete -c xrandr -l rmmode -d 'Removes a mode from the server' -xa '(__fish_print_xrandr_modes)'\0Acomplete -c xrandr -l addmode -d 'Add a mode to the set of valid modes for an output' -xa '(__fish_print_xrandr_outputs)'\0Acomplete -c xrandr -l delmode -d 'Remove a mode from the set of valid modes for an output' -xa '(__fish_print_xrandr_outputs)'\0Acomplete -c xrandr -l output -d 'Selects an output to reconfigure' -xa '(__fish_print_xrandr_outputs)'\0Acomplete -c xrandr -l auto -d 'Enable connected but disabled outputs'\0Acomplete -c xrandr -l mode -d 'This selects a mode' -xa '(__fish_print_xrandr_modes)'\0Acomplete -c xrandr -l preferred -d 'Select the same mode as --auto, but it do not automatically enable or disable the output'\0Acomplete -c xrandr -l pos -d 'Set output po