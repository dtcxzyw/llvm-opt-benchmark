@anon.1d0b41a8d45d477c3029ec78f9b8b434.1936 = private unnamed_addr constant [1969 x i8] c"# Completions for the FreeBSD `kldload` kernel module load utility\0Afunction __fish_list_kldload_options\0A    set -l klds (__fish_complete_suffix --complete=/boot/kernel/(commandline -ct) \22.ko\22 | string replace -r '.*/(.+)\\\\.ko' '$1')\0A    # Completing available klds is fast, but completing it with a call to __fish_whatis\0A    # is decidedly not. With 846 modules (FreeBSD 11.1), fish --profile 'complete -C\22kldload \22' returns the following:\0A    # 10671   11892698    > complete -C\22kldload \22\0A    # A 12 second completion delay is obviously out of the question, so don't provide a description unless there are\0A    # fewer than 50 results. (Update: now 200 after the switch to __kld_whatis.)\0A    # Additionally, we can halve the time by not shelling out to `whatis` if we know the man file for the kernel module\0A    # in question does not exist, since the paths are hardcoded.\0A    set -l kld_count (count $klds)\0A    if test $kld_count -le 200 -a $kld_count -gt 0\0A        # print name and description\0A        for kld in $klds\0A            printf '%s\\t%s\\n' $kld (test -f /usr/share/man/man4/$kld.4.gz;\0A\09\09\09\09and __kld_whatis $kld; or echo \22kernel module\22)[1]\0A        end\0A    else if test $kld_count -gt 0\0A        # print name only\0A        printf '%s\\n' $klds\0A    else\0A        # print name only (description won't exist since the kernel module isn't installed)\0A        __fish_complete_suffix .ko\0A    end\0Aend\0A\0A# This is up to 10-50x faster than using __fish_whatis but it could someday break.\0A# (zcat is part of the standard FreeBSD distribution.)\0A# Without this, we can't reasonably show descriptions for most completions within our time budget.\0Afunction __kld_whatis\0A    set -l kld $argv[1]\0A    set -l path /usr/share/man/man4/$kld.4.gz\0A    zcat $path | string replace -rf '\\.Nd \22?([^\22]+).*' '$1'\0Aend\0A\0A# Only attempt to match a local file if there isn't a match in /boot/kernel,\0A# as odds are that is the desired source.\0Acomplete -c kldload -xa '(__fish_list_kldload_options)'\0A", align 1
