@anon.1d0b41a8d45d477c3029ec78f9b8b434.2500 = private unnamed_addr constant [1552 x i8] c"#Completions for rm\0Aif rm --version >/dev/null 2>/dev/null # GNU\0A    complete -c rm -s d -l directory -d \22Unlink directories\22\0A    complete -c rm -s f -l force -d \22Never prompt for removal\22\0A    complete -c rm -s i -l interactive -d \22Prompt for removal\22\0A    complete -c rm -s I -d \22Prompt to remove >3 files\22\0A    complete -c rm -s r -l recursive -d \22Recursively remove subdirs\22\0A    complete -c rm -s R -d \22Recursively remove subdirs\22\0A    complete -c rm -s v -l verbose -d \22Explain what is done\22\0A    complete -c rm -s h -l help -d \22Display help\22\0A    complete -c rm -l version -d \22Display rm version\22\0Aelse\0A    set -l uname (uname -s)\0A    # solaris:   rm [-fi        ] file ...\0A    # openbsd:   rm [-fidPRrv   ] file ...\0A    # macos:     rm [-fidPRrvW  ] file ...\0A    # netbsd:    rm [-fidPRrvWx ] file ...\0A    # freebsd:   rm [-fidPRrvWxI] file ...\0A    # dragonfly: rm [-fidPRrvWxI] file ... \0A\0A    complete -c rm -s f -d \22Never prompt for removal\22\0A    complete -c rm -s i -d \22Prompt for removal\22\0A    test \22$uname\22 = SunOS\0A    and exit 0\0A    complete -c rm -s d -d \22Remove directories as well\22\0A    complete -c rm -s P -d \22Overwrite before removal\22\0A    complete -c rm -s R -s r -d \22Recursively remove subdirs\22\0A    complete -c rm -s v -d \22Explain what is done\22\0A    test \22$uname\22 = OpenBSD\0A    and exit 0\0A    complete -c rm -s W -d \22Undelete given filenames\22\0A    test \22$uname\22 = Darwin\0A    and exit 0\0A    complete -c rm -s x -d \22Don't traverse mount points\22\0A    test \22$uname\22 = NetBSD\0A    and exit 0\0A    complete -c rm -s I -d \22Prompt to remove >=3 files\22\0Aend\0A", align 1
