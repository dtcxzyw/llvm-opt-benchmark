@anon.1d0b41a8d45d477c3029ec78f9b8b434.2676 = private unnamed_addr constant [15445 x i8] c"function __fish_complete_svn_diff --description 'Complete \22svn diff\22 arguments'\0A    set -l cmdl (commandline -cxp | string escape)\0A    set -l diff diff\0A    set -l args\0A    while set -q cmdl[1]\0A        switch $cmdl[1]\0A            case --diff-cmd\0A                if set -q cmdl[2]\0A                    set diff $cmdl[2]\0A                    set -e cmd[2]\0A                end\0A\0A            case --extensions\0A                if set -q cmdl[2]\0A                    set args $cmdl[2]\0A                    set -e cmdl[2]\0A                end\0A        end\0A        set -e cmdl[1]\0A    end\0A    set -l token (commandline -cpt)\0A    complete -C\22$diff $args $token\22\0A\0Aend\0A\0Afunction _svn_cmpl_ -d 'Make a completion for a subcommand' --argument-names subcommand\0A    set -e argv[1]\0A    complete -c svn -n \22__fish_seen_subcommand_from $subcommand\22 $argv\0Aend\0A\0A#\0A# subcommands\0A#\0Aset -l add add\0Aset -l blame 'blame ann annotate praise'\0Aset -l cat cat\0Aset -l changelist 'cl changelist'\0Aset -l checkout 'co checkout'\0Aset -l cleanup cleanup\0Aset -l commit 'ci commit'\0Aset -l copy 'cp copy'\0Aset -l diff 'di diff'\0Aset -l export export\0Aset -l help '\\? h help'\0Aset -l import import\0Aset -l info info\0Aset -l list 'ls list'\0Aset -l lock lock\0Aset -l log log\0Aset -l merge merge\0Aset -l mergeinfo mergeinfo\0Aset -l mkdir mkdir\0Aset -l move 'mv move ren rename'\0Aset -l patch patch\0Aset -l propdel 'pd pdel propdel'\0Aset -l propedit 'pe pedit propedit'\0Aset -l propget 'pg pget propget'\0Aset -l proplist 'pl plist proplist'\0Aset -l propset 'ps pset propset'\0Aset -l relocate relocate\0Aset -l remove 'rm remove del delete'\0Aset -l resolve resolve\0Aset -l resolved resolved\0Aset -l revert revert\0Aset -l stat 'st stat status'\0Aset -l switch 'sw switch'\0Aset -l unlock unlock\0Aset -l update 'up update'\0Aset -l upgrade upgrade\0A\0Acomplete -c svn -n __fish_use_subcommand -x -a $add -d 'Put files under version control, scheduling them for addition in the next commit'\0Acomplete -c svn -n __fish_use_subcommand -x -a $blame -d 'Output the content of specified files or URLs with revision and author information in-line'\0Acomplete -c svn -n __fish_use_subcommand -x -a $cat -d 'Output the content of specified files or URLs'\0Acomplete -c svn -n __fish_use_subcommand -x -a $changelist -d 'Output the content of specified files or URLs with revision and author information in-line'\0Acomplete -c svn -n __fish_use_subcommand -x -a $checkout -d 'Check out a working copy from a repository'\0Acomplete -c svn -n __fish_use_subcommand -x -a $cleanup -d 'Recursively clean up the working copy, removing locks, resuming unfinished operations, etc'\0Acomplete -c svn -n __fish_use_subcommand -x -a $commit -d 'Send changes from your working copy to the repository'\0Acomplete -c svn -n __fish_use_subcommand -x -a $copy -d 'Duplicate something in working copy or repository, remembering history'\0Acomplete -c svn -n __fish_use_subcommand -x -a $diff -d 'Display the differences between two revisions or paths'\0Acomplete -c svn -n __fish_use_subcommand -x -a $export -d 'Create an unversioned copy of a tree'\0Acomplete -c svn -n __fish_use_subcommand -x -a $help -d 'Describe the usage of this program or its subcommands'\0Acomplete -c svn -n __fish_use_subcommand -x -a $import -d 'Commit an unversioned file or tree into the repository'\0Acomplete -c svn -n __fish_use_subcommand -x -a $info -d 'Display information about a local or remote item'\0Acomplete -c svn -n __fish_use_subcommand -x -a $list -d 'List directory entries in the repository'\0Acomplete -c svn -n __fish_use_subcommand -x -a $lock -d 'Lock working copy paths/URLs in the repo, so that no other user can commit changes to them'\0Acomplete -c svn -n __fish_use_subcommand -x -a $log -d 'Show the log messages for a set of revision(s) and/or file(s)'\0Acomplete -c svn -n __fish_use_subcommand -x -a $merge -d 'Apply the differences between two sources to a working copy path'\0Acomplete -c svn -n __fish_use_subcommand -x -a $mergeinfo -d 'Display information related to merges'\0Acomplete -c svn -n __fish_use_subcommand -x -a $mkdir -d 'Create a new directory under version control'\0Acomplete -c svn -n __fish_use_subcommand -x -a $move -d 'Move and/or rename something in working copy or repository'\0Acomplete -c svn -n __fish_use_subcommand -x -a $patch -d 'Apply a unidiff patch to the working copy'\0Acomplete -c svn -n __fish_use_subcommand -x -a $propdel -d 'Remove a property from files, dirs, or revisions'\0Acomplete -c svn -n __fish_use_subcommand -x -a $propedit -d 'Edit a property with an external editor'\0Acomplete -c svn -n __fish_use_subcommand -x -a $propget -d 'Print the value of a property on files, dirs, or revisions'\0Acomplete -c svn -n __fish_use_subcommand -x -a $proplist -d 'List all properties on files, dirs, or revisions'\0Acomplete -c svn -n __fish_use_subcommand -x -a $propset -d 'Set the value of a property on files, dirs, or revisions'\0Acomplete -c svn -n __fish_use_subcommand -x -a $relocate -d 'Rewrite working copy url metadata'\0Acomplete -c svn -n __fish_use_subcommand -x -a $remove -d 'Remove files and directories from version control'\0Acomplete -c svn -n __fish_use_subcommand -x -a $resolve -d 'Remove conflicts on working copy files or directories'\0Acomplete -c svn -n __fish_use_subcommand -x -a $resolved -d 'Remove \\'conflicted\\' state on working copy files or directories'\0Acomplete -c svn -n __fish_use_subcommand -x -a $revert -d 'Restore pristine working copy file (undo most local edits)'\0Acomplete -c svn -n __fish_use_subcommand -x -a $stat -d 'Print the status of working copy files and directories'\0Acomplete -c svn -n __fish_use_subcommand -x -a $switch -d 'Update the working copy to a different URL'\0Acomplete -c svn -n __fish_use_subcommand -x -a $unlock -d 'Unlock working copy paths or URLs'\0Acomplete -c svn -n __fish_use_subcommand -x -a $update -d 'Bring changes from the repository into the working copy'\0Acomplete -c svn -n __fish_use_subcommand -x -a $upgrade -d 'Upgrade the metadata storage format for a working copy'\0A\0A#\0A# Global commands\0A#\0Acomplete -c svn -n 'not __fish_use_subcommand' -l username -x -d 'Specify a username ARG'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l password -x -d 'Specify a password ARG'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l no-auth-cache -d 'Do not cache authentication tokens'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l non-interactive -d 'Do no interactive prompting'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l trust-server-cert -d 'Accept SSL server certificates from unknown authorities (only with --non-interactive)'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l config-dir -x -d 'Read user configuration files from directory ARG'\0Acomplete -c svn -n 'not __fish_use_subcommand' -l config-option -x -d 'Set user configuration option in the format: FILE:SECTION:OPTION=[VALUE]'\0A\0A#\0A# local commands\0A#\0Afor cmd in $commit $copy $import $lock $mkdir $move $propedit $remove\0A    if not test $cmd = lock\0A        _svn_cmpl_ $cmd -l editor-cmd -x -d 'Use ARG as external editor'\0A    end\0A    _svn_cmpl_ $cmd -l message -s m -d 'Specify log message'\0A    _svn_cmpl_ $cmd -l encoding -x -d 'Treat value as being in charset encoding ARG'\0A    _svn_cmpl_ $cmd -l file -s F -d 'Read log message from file'\0A    _svn_cmpl_ $cmd -l force-log -d 'Force validity of log message source'\0Aend\0A\0Afor cmd in $merge $resolve $switch $update\0A    _svn_cmpl_ $cmd -l accept -d 'Specify automatic conflict resolution source' -xa 'base working mine-conflict theirs-conflict mine-full theirs-full'\0Aend\0A\0Afor cmd in $add $changelist $checkout $commit $diff $export $import $info $list $log $merge $mergeinfo $propdel $propget $proplist $propset $resolve $resolved $revert $stat $switch $update\0A    _svn_cmpl_ $cmd -l depth -d 'Limit operation by depth' -xa 'empty files immediates infinity'\0Aend\0A\0Afor cmd in $add $changelist $checkout $commit $copy $delete $elog $export $import $merge $mkdir $move $patch $propdel $proplist $propset $resolve $resolved $revert $stat $switch $update $upgrade\0A    _svn_cmpl_ $cmd -l quiet -s q -d 'Print nothing, or only summary information'\0Aend\0A\0Afor cmd in $add $blame $checkout $delete $diff $export $import $lock $merge $move $propedit $propset $remove $switch $unlock $update\0A    _svn_cmpl_ $cmd -l force -d 'Force operation to run'\0Aend\0A\0Afor cmd in $add $changelist $commit $delete $info $lock $log $propset $resolve $resolved $revert $unlock\0A    _svn_cmpl_ $cmd -l targets -d 'Process contents of file ARG as additional args' -r\0Aend\0A\0Afor cmd in $changelist $commit $diff $info $propdel $propget $proplist $propset $revert $stat $update\0A    _svn_cmpl_ $cmd -l changelist -l cl -d 'Operate only on members of changelist' -r\0Aend\0A\0Afor cmd in $blame $diff $info $list $log $propget $proplist $stat\0A    _svn_cmpl_ $cmd -l xml -d 'Output in xml'\0Aend\0A\0Afor cmd in $commit $copy $delete $import $log $mkdir $move $propedit\0A    _svn_cmpl_ $cmd -l with-revprop -d 'Retrieve revision property' -x\0Aend\0A\0Afor cmd in $diff $log $merge\0A    _svn_cmpl_ $cmd -l change -s c -d 'The change made in revision ARG' -xa '(__fish_print_svn_rev)'\0Aend\0A\0Afor cmd in $blame $cat $checkout $copy $diff $export $info $list $log $merge $mergeinfo $move $propedit $propget $propdel $proplist $propset $switch $update\0A    _svn_cmpl_ $cmd -l revision -s r -d 'Which revision the target is first looked up' -xa '(__fish_print_svn_rev)'\0Aend\0A\0Afor cmd in $checkout $copy $export $relocate $stat $switch $update\0A    _svn_cmpl_ $cmd -l ignore-externals -d 'Ignore externals definitions'\0Aend\0A\0Afor cmd in $blame $list $log $propget $proplist $stat\0A    _svn_cmpl_ $cmd -l verbose -s v -d 'Print extra information'\0Aend\0A\0Afor cmd in $propdel $propedit $propget $proplist $propset\0A    _svn_cmpl_ $cmd -l revprop -d 'Operate on a revision property (use with -r)'\0Aend\0A\0Afor cmd in $add $copy $mkdir $move $update\0A    _svn_cmpl_ $cmd -l parents -d 'Add intermediate parents'\0Aend\0A\0Afor cmd in $blame $diff $log $merge\0A    _svn_cmpl_ $cmd -l extensions -s x -d 'Output 3 lines of unified context' -xa '-u --unified'\0A    _svn_cmpl_ $cmd -l extensions -s x -d 'Ignore changes in amount of whitespace' -xa '-b --ignore-space-change'\0A    _svn_cmpl_ $cmd -l extensions -s x -d 'Ignore all whitespace' -xa '-w --ignore-all-space'\0A    _svn_cmpl_ $cmd -l extensions -s x -d 'Ignore eol style' -xa '-w --ignore-eol-style'\0A    _svn_cmpl_ $cmd -l extensions -s x -d 'Show C function name' -xa '-p --show-c-function'\0A    _svn_cmpl_ $cmd -l extensions -n '__fish_seen_subcommand_from --diff-cmd' -xa '(__fish_complete_svn_diff)'\0Aend\0A\0Afor cmd in $cleanup $merge $switch $update\0A    _svn_cmpl_ $cmd -l diff3-cmd -d 'Use as merge command' -xa \22(complete -C '')\22\0Aend\0A\0Afor cmd in $blame $info $list $log $stat\0A    _svn_cmpl_ $cmd -l incremental -d 'Give output suitable for concatenation'\0Aend\0A\0Afor cmd in $add $import $stat\0A    _svn_cmpl_ $cmd -l no-ignore -d 'Disregard default and svn:ignore property ignores'\0Aend\0A\0Afor cmd in $merge $patch\0A    _svn_cmpl_ $cmd -l dry-run -d 'Try operation but make no changes'\0Aend\0A\0Afor cmd in $merge $switch\0A    _svn_cmpl_ $cmd -l ignore-ancestry -d 'Ignore ancestry when calculating merges'\0Aend\0A\0Afor cmd in $diff $log\0A    _svn_cmpl_ $cmd -l internal-diff -d 'Override diff-cmd specified in config file'\0A    _svn_cmpl_ $cmd -l diff-cmd -d 'Use external diff command' -xa \22(complete -C '')\22\0Aend\0A\0Afor cmd in $add $import\0A    _svn_cmpl_ $cmd -l no-auto-props -d 'Disable automatic properties'\0Aend\0A\0Afor cmd in $switch $update\0A    _svn_cmpl_ $cmd -l set-depth -d 'Set new working copy depth' -xa 'exclude empty files immediates infinity'\0Aend\0A\0Afor cmd in $blame $log\0A    _svn_cmpl_ $cmd -l use-merge-history -s g -d 'Use/display additional information from merge history'\0Aend\0A\0A#\0A# Individual commands\0A#\0A\0A#\0A# Completions for the 'checkout', 'co' subcommands\0A#\0A_svn_cmpl_ $checkout -xa 'http:// ftp:// svn+ssh:// svn+ssh://(__fish_print_hostnames)'\0A\0A#\0A# Completions for the 'changelist', 'cl' subcommands\0A#\0A_svn_cmpl_ $changelist -l remove -d 'Remove changelist association'\0A\0A#\0A# Completions for the 'commit', 'ci' subcommands\0A#\0A_svn_cmpl_ $commit -l keep-changelists -d 'don\\'t delete changelists after commit'\0A_svn_cmpl_ $commit -l no-unlock -d 'Don\\'t unlock the targets'\0A\0A#\0A# Completions for the 'remove', 'rm', 'delete', 'del' subcommands\0A#\0A_svn_cmpl_ $remove -l keep-local -x -d 'Keep path in working copy'\0A\0A#\0A# Completions for the 'diff', 'di' subcommands\0A#\0A_svn_cmpl_ $diff -l old -d 'Use ARG as the older target' -xa '(__fish_print_svn_rev)'\0A_svn_cmpl_ $diff -l new -d 'Use ARG as the newer target' -xa '(__fish_print_svn_rev)'\0A_svn_cmpl_ $diff -l no-diff-deleted -d 'Do not print differences for deleted files'\0A_svn_cmpl_ $diff -l notice-ancestry -d 'Notice ancestry when calculating differences'\0A_svn_cmpl_ $diff -l summarize -d 'Show a summary of the results'\0A_svn_cmpl_ $diff -l git -d 'Use git\\'s extended diff format'\0A_svn_cmpl_ $diff -l show-copies-as-adds -d 'Don\\'t diff copied or moved files with their source'\0A\0A#\0A# Completions for the 'export' subcommand\0A#\0A_svn_cmpl_ $export -l native-eol -x -d 'Use a different EOL marker than the standard'\0A\0A#\0A# Completions for the 'log' subcommand\0A#\0A_svn_cmpl_ $log -l stop-on-copy -d 'Do not cross copies while traversing history'\0A_svn_cmpl_ $log -l limit -s l -x -d 'Maximum number of log entries'\0A_svn_cmpl_ $log -l diff -d 'Produce diff output'\0A_svn_cmpl_ $log -l with-all-revprops -d 'Retrieve all revision properties'\0A_svn_cmpl_ $log -l with-no-revprops -d 'Retrieve no revision properties'\0A\0A#\0A# Completions for the 'merge' subcommand\0A#\0A_svn_cmpl_ $merge -l allow-mixed-variables -d 'Allow merge into mixed-revision working copy'\0A_svn_cmpl_ $merge -l record-only -d 'Merge only mergeinfo differences'\0A_svn_cmpl_ $merge -l reintegrate -d 'Merge a branch back into its parent branch'\0A\0A#\0A# Completions for the 'patch' subcommand\0A#\0A_svn_cmpl_ $patch -l reverse-diff -d 'Apply the unidiff in reverse'\0A_svn_cmpl_ $patch -l strip -x -d 'Number of leading path components to strip from paths'\0A\0A#\0A# Completions for the 'propget', 'pget', 'pg' subcommands\0A#\0A_svn_cmpl_ $propget -l strict -d 'Use strict semantics'\0A\0A#\0A# Complete pget, pset, pedit options with svn props\0A#\0Aset -l props svn:{ignore,keywords,executable,eol-style,mime-type,externals,need-lock}\0A_svn_cmpl_ $propget -a \22$props\22\0A_svn_cmpl_ $propedit -a \22$props\22\0A_svn_cmpl_ $propdel -a \22$props\22\0A_svn_cmpl_ $propset -a \22$props\22\0A\0A_svn_cmpl_ svn:eol-style -a \22native LF CR CRLF\22\0A_svn_cmpl_ svn:mime-type -a \22(__fish_print_xdg_mimetypes)\22\0A_svn_cmpl_ svn:keywords -a URL -d 'The URL for the head version of the object'\0A_svn_cmpl_ svn:keywords -a Author -d 'The last person to modify the file'\0A_svn_cmpl_ svn:keywords -a Date -d 'Last changed date'\0A_svn_cmpl_ svn:keywords -a Rev -d 'The last revision the object changed'\0A_svn_cmpl_ svn:keywords -a Id -d 'A compressed summary of all keywords'\0A\0A#\0A# Completions for the 'relocate' subcommand\0A#\0A_svn_cmpl_ $relocate -xa '( svn info | string match \22*URL:*\22 | string split -f2 \22 \22) http:// ftp:// svn+ssh:// svn+ssh://(__fish_print_hostnames)'\0A\0A#\0A# Completions for the 'switch', 'sw' subcommands\0A#\0A_svn_cmpl_ $switch -l relocate -d 'Relocate via URL-rewriting' -xa '( svn info | string match \22*URL:*\22 | string split -f2 \22 \22) http:// ftp:// svn+ssh:// svn+ssh://(__fish_print_hostnames)'\0A\0A#\0A# Completions for the 'status', 'st' subcommands\0A#\0A_svn_cmpl_ $stat -l show-updates -s u -d 'Display update information'\0A\0A#\0A# Completions for the 'update', 'up' subcommand\0A#\0A_svn_cmpl_ $update -l editor-cmd -x -d 'Use ARG as external editor'\0A\0Afunctions -e _svn_cmpl_\0A", align 1
