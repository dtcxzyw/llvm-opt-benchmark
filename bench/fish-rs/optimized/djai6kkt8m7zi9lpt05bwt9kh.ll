@anon.1d0b41a8d45d477c3029ec78f9b8b434.2510 = private unnamed_addr constant [45235 x i8] c"#\0A# completion for rpm-ostree\0A#\0A\0A# Subcommands for rpm-ostree\0Aset -l subcommands apply-live cancel cleanup compose db deploy initramfs initramfs-etc install kargs override rebase refresh-md reload remove reset rollback status uninstall update upgrade usroverlay\0A\0A# Options for rpm-ostree, most of them also apply to subcommands\0Aset -l options --version --quiet -q --help -h\0A\0A# subcommands that does not support --quiet\0Aset -l no_quiet apply-live container-encapsulate image usroverlay\0A\0A# subcommands that does not support --version\0Aset -l no_version apply-live container-encapsulate image\0A\0A# File completions also need to be disabled\0Acomplete -c rpm-ostree -f\0A\0A# All the options\0A# --help for all\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $options\22 -l help -xs h -d \22Show help options\22\0A\0A# --quiet for all\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from options $options $no_quiet\22 -l quiet -s q -d \22Print minimal informational messages\22\0A\0A# --version for all\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $options $no_version\22 -l version -d \22Print version info and exit\22\0A\0A# All the subcommands\0A# There is not --version or --quiet for apply-live\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands --version --quiet -q\22 -a apply-live -d \22Apply pending changes to booted deployment\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a cancel -d \22Cancel an active transaction\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a cleanup -d \22Clear cached/pending data\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a compose -d \22Commands to compose a tree\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a db -d \22Commands to query the RPM database\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a deploy -d \22Deploy a specific commit\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a initramfs -d \22Toggle local initramfs regeneration\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a initramfs-etc -d \22Add files to the initramfs\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a install -d \22Overlay additional packages\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a kargs -d \22Query or modify kernel arguments\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a override -d \22Manage base package overrides\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a rebase -d \22Switch to a different tree\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a refresh-md -d \22Generate rpm repo metadata\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a reload -d \22Reload configuration\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a reset -d \22Remove all mutations\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a rollback -d \22Revert to previously booted tree\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a status -d \22Get booted system version\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a uninstall -d \22Remove overlayed additional packages\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a remove -d \22Remove overlayed additional packages\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a upgrade -d \22Perform system upgrade\22\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands\22 -a update -d \22Alias for upgrade\22\0A# 2023-07-21: Any flag between rpm-ostree and usroverlay can cause Segmentation fault. https://github.com/coreos/rpm-ostree/issues/4508\0Acomplete -c rpm-ostree -n \22not __fish_seen_subcommand_from $subcommands -\22 -a usroverlay -d \22Apply transient overlayfs to /usr\22\0A\0A# apply-live\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from apply-live\22 -l target -d \22Target provided commit\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from apply-live\22 -l reset -d \22Reset back to booted commit\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from apply-live\22 -l allow-replacement -d \22Allow replacement of packages/files\22\0A\0A# cancel\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cancel\22 -l sysroot -r -d \22=SYSROOT Use system root\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cancel\22 -l peer -d \22Force peer-to-peer connection\22\0A\0A# cleanup\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l os -d \22=OSNAME Operate on provided OSNAME\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l base -s b -d \22Clear temporary files; will not change deployments\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l pending -s p -d \22Remove pending deployment\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l rollback -s r -d \22Remove rollback deployment\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l repomd -s m -d \22Delete cached rpm repo metadata\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l sysroot -r -d \22=SYSROOT Use system root\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from cleanup\22 -l peer -d \22Force peer-to-peer connection\22\0A\0A# compose\0A# All compose subcommands\0A# container-encapsulatedoes, image not have --quiet or --version\0Aset -l compose_subcommands commit container-encapsulate extensions image install postprocess tree\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands\22 -a commit -d \22Commit target path to an OSTree repo\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands --quiet -q --version\22 -a container-encapsulate -d \22Create Chunked Container image from OSTree Commit\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands\22 -a extensions -d \22Download Depsolved RPMs for Base OSTree\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands --quiet -q --version\22 -a image -d \22Create reproducible Chunked Image from Treefile\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands\22 -a install -r -d \22Install packages into a target path\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands\22 -a postprocess -d \22Final postprocessing on an installation root\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and not __fish_seen_subcommand_from $compose_subcommands\22 -a tree -d \22Process a treefile\22\0A\0A# compose commit\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and __fish_seen_subcommand_from commit\22 -l unified-core -d \22Use new unified core codepath\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and __fish_seen_subcommand_from commit\22 -l repo -s r -d \22=REPO Path to OSTree repo\22\0Acomplete -c rpm-ostree -n \22__fish_seen_subcommand_from compose; and __fish_seen_subcommand_from commit\22 -l layer-repo -d \22=REPO Path to OSTree repo for ostree-layers & ostree-override-layers\22\0Acom