@anon.1d0b41a8d45d477c3029ec78f9b8b434.2682 = private unnamed_addr constant [9908 x i8] c"### Auto-complete for sysbench (cross-platform and multi-threaded benchmark tool) ###\0A\0A### sub commands specification ###\0Acomplete -c sysbench -f -a \22run\\t'Run the test'\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -a \22\0A\09prepare\\t'Prepare and create test file'\0A\09cleanup\\t'Cleanup test files'\0A\09\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -a \22\0A\09prepare\\t'Prepare test table'\0A\09cleanup\\t'Cleanup test table'\0A\09\22\0A\0A### generic long options specification ###\0Acomplete -c sysbench -x -l num-threads -d 'The total number of worker threads to create (default: 1)'\0Acomplete -c sysbench -x -l max-requests -d 'Limit for total number of requests. 0 means unlimited (default: 10000)'\0Acomplete -c sysbench -x -l max-time -d 'Limit for total execution time in seconds. 0 means unlimited (default: 0)'\0Acomplete -c sysbench -x -l thread-stack-size -d 'Size of stack for each thread (default: 32K)'\0Acomplete -c sysbench -f -l init-rng -d 'Specifies if random numbers generator should be initialized from timer (default: off)' -a 'on off'\0Acomplete -c sysbench -x -l test -d 'Name of the test mode to run(required)' -a \22\0A\09cpu\\t'Benchmark cpu by calculating prime numbers'\0A\09threads\\t'Benchmark scheduler performance'\0A\09mutex\\t'Benchmark mutex implementation'\0A\09fileio\\t'Benchmark various file I/O workloads'\0A\09oltp\\t'Benchmark a real database performance'\0A\09\22\0Acomplete -c sysbench -f -l debug -d 'Print more debug info (default: off)' -a 'on off'\0Acomplete -c sysbench -f -l validate -d 'Perform validation of test results where possible (default: off)' -a 'on off'\0Acomplete -c sysbench -l help -d 'Print help on general syntax'\0Acomplete -c sysbench -l version -d 'Show version of program'\0Acomplete -c sysbench -x -l percentile -d 'A percentile rank of query execution times to count (default: 95)'\0Acomplete -c sysbench -f -l batch -d 'Dump current results periodically (default: off)' -a 'on off'\0Acomplete -c sysbench -x -l batch-delay -d 'Delay between batch dumps in seconds (default: 300)'\0A\0A### options for test=`cpu` mode ###\0Acomplete -c sysbench -n \22__fish_contains_opt test=cpu\22 -x -l cpu-max-prime -d 'Calculation of prime numbers up to the specified value'\0A\0A### options for test=`threads` mode ###\0Acomplete -c sysbench -n \22__fish_contains_opt test=threads\22 -x -l thread-yields -d 'Number of lock/yield/unlock loops to execute per each request (default: 1000)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=threads\22 -x -l thread-locks -d 'Number of mutexes to create (default: 8)'\0A\0A### options for test=`mutex` mode ###\0Acomplete -c sysbench -n \22__fish_contains_opt test=mutex\22 -x -l mutex-num -d 'Number of mutexes to create (default: 4096)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=mutex\22 -x -l memory-scope -d 'Specifies whether each thread uses a global or local allocation (default:global)' -a \22\0A\09local\\t'Allocate memory locally'\0A\09global\\t'Allocate memory globally'\0A\09\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=mutex\22 -x -l memory-total-size -d 'Total size of data to transfer (default: 100G)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=mutex\22 -x -l memory-oper -d 'Type of memory operations' -a 'read write'\0A\0A### options for test=`fileio` mode ###\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-num -d 'Number of files to create (default: 128)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-block-size -d 'Block size to use in all I/O operations (default: 16K)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-total-size -d 'Total size of files (default: 2G)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-test-mode -d 'Type of workload to produce' -a \22\0A\09seqwr\\t'Sequential write'\0A\09seqrewr\\t'Sequential rewrite'\0A\09seqrd\\t'Sequential read'\0A\09rndrd\\t'Random read'\0A\09rndwr\\t'Random write'\0A\09rndrw\\t'Random read/write'\0A\09\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-io-mode -d 'I/O mode (default: sync)' -a 'sync async fastmmap slowmmap'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-async-backlog -d 'Number of asynchronous operations to queue per thread (default: 128)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-extra-flags -d 'Additional flags to use with open(2)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-fsync-freq -d 'Do fsync() after this number of requests (default: 0)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -f -l file-fsync-all -d 'Do fsync() after each write operation (default: no)' -a 'yes no'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -f -l file-fsync-end -d 'Do fsync() at the end of the test (default: yes)' -a 'yes no'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-fsync-mode -d 'Method used for synchronization: fsync, fdatasync (default: fsync)' -a 'fsync fdatasync'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-merged-requests -d 'Upper limit of I/O requests merge (default: 0)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=fileio\22 -x -l file-rw-ratio -d 'reads/writes ratio for combined random read/write test (default: 1.5)'\0A\0A### options for test=`oltp` mode ###\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-test-mode -d 'Execution mode: simple, complex and nontrx(non-transactional)(default: complex)' -a \22\0A\09simple\\t'Simple'\0A\09complex\\t'Advanced transactional'\0A\09nontrx\\t'Non-transactional'\0A\09\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -f -l oltp-read-only -d 'Read-only mode. No UPDATE, DELETE or INSERT queries will be performed. (default: off)' -a 'on off'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-range-size -d 'Range size for range queries (default: 100)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-point-selects -d 'Number of point select queries in a single transaction (default: 10)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-simple-ranges -d 'Number of simple range queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-sum-ranges -d 'Number of SUM range queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-order-ranges -d 'Number of ORDER range queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-distinct-ranges -d 'Number of DISTINCT range queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-index-updates -d 'Number of index UPDATE queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-non-index-updates -d 'Number of non-index UPDATE queries in a single transaction (default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-nontrx-mode -d 'Type of queries for non-transactional execution mode (default: select)' -a 'select update_key update_nokey insert delete'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-connect-delay -d 'Time to sleep(in microseconds) after each connection to database (default: 10000)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-user-delay-min -d 'Minimum time to sleep(in microseconds) after each request (default: 0)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-user-delay-max -d 'Maximum time to sleep(in microseconds) after each request (default: 0)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-table-name -d 'Name of the test table (default: sbtest)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-table-size -d 'Number of rows in the test table (default: 10000)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l oltp-dist-type -d 'Distribution type of random numbers (default: special)' -a \22\0A\09uniform\\t'Uniform distribution'\0A\09gauss\\t'Gaussian distribution'\0A\09special\\t'Specified percent of numbers is generated in a specified percent of cases'\0A\09\22\0Acomplete -c sysbench -n \22__fish_contains_opt oltp-dist-type=special\22 -x -l oltp-dist-pct -d 'Percentage of values to be treated as \\'special\\'(default: 1)'\0Acomplete -c sysbench -n \22__fish_contains_opt oltp-dist-type=special\22 -x -l oltp-dist-res -d 'Percentage of cases when \\'special\\' values are generated (default: 75)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l db-ps-mode -d 'Use \22Prepared Statements\22 API if supported, otherwise - use clientside statements: disable, auto (default: auto)' -a 'disable auto'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-host -d 'MySQL server host (default: localhost)' -a \22(__fish_print_hostnames)\22\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-port -d 'MySQL server port (default: 3306)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -l mysql-socket -d 'Unix socket file to communicate with the MySQL server'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-user -d 'MySQL user (default: sbtest)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-password -d 'MySQL password'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-db -d 'MySQL database name (default: sbtest)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-table-engine -d 'Type of the test table to use' -a 'myisam innodb heap ndbcluster bdb maria falcon pbxt'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l mysql-ssl -d 'Use SSL connections. (default: no)' -a 'yes no'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -x -l myisam-max-rows -d 'MAX_ROWS option for MyISAM tables (required for big tables) (default: 1000000)'\0Acomplete -c sysbench -n \22__fish_contains_opt test=oltp\22 -l mysql-create-options -d 'Additional options passed to CREATE TABLE.'\0A", align 1
