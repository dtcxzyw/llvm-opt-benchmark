@anon.1d0b41a8d45d477c3029ec78f9b8b434.1670 = private unnamed_addr constant [31954 x i8] c"# fish completion for fossil\0A# http://www.fossil-scm.org/\0A\0Afunction __fish_fossil\0A    command fossil $argv 2>/dev/null\0Aend\0A\0Afunction __fish_fossil_needs_command\0A    test (count (commandline -pxc)) -eq 1\0Aend\0A\0Afunction __fish_fossil_command\0A    set -l cmd (commandline -pxc)\0A    test (count $cmd) -gt 1\0A    and contains -- $cmd[2] $argv\0Aend\0A\0Afunction __fish_fossil_subcommand\0A    set -l cmd (commandline -pxc)\0A    test (count $cmd) -eq 2\0A    and test $argv[1] = $cmd[2]\0Aend\0A\0Afunction __fish_fossil_subsubcommand\0A    set -l cmd (commandline -pxc)\0A    test (count $cmd) -ge 3\0A    and test $argv[1] = $cmd[2]\0A    and test $argv[2] = $cmd[3]\0Aend\0A\0Afunction __fish_fossil_subsubcommand_only\0A    set -l cmd (commandline -pxc)\0A    test (count $cmd) -eq 3\0A    and test $argv[1] = $cmd[2]\0A    and test $argv[2] = $cmd[3]\0Aend\0A\0Afunction __fish_fossil_subsubsubcommand_only\0A    set -l cmd (commandline -pxc)\0A    test (count $cmd) -eq 4\0A    and test $argv[1] = $cmd[2]\0A    and test $argv[2] = $cmd[3]\0A    and test $argv[3] = $cmd[4]\0Aend\0A\0A# add\0Acomplete -c fossil -n __fish_fossil_needs_command -a add -x -d 'Add files to checkout'\0Acomplete -c fossil -n '__fish_fossil_command add' -l case-sensitive -x -a 'yes no' -d 'Case insensitive file matching'\0Acomplete -c fossil -n '__fish_fossil_command add' -l dotfiles -d 'Include dotfiles'\0Acomplete -c fossil -n '__fish_fossil_command add' -l ignore -r -d 'Files to ignore'\0Acomplete -c fossil -n '__fish_fossil_command add' -l clean -r -d 'Files to ignore'\0Acomplete -c fossil -n '__fish_fossil_command add' -a '(__fish_fossil extra --rel-paths)' -x -d File\0A\0A# addremove\0Acomplete -c fossil -n __fish_fossil_needs_command -a addremove -f -d 'Remove and add files to checkout'\0Acomplete -c fossil -n '__fish_fossil_command addremove' -l case-sensitive -x -a 'yes no' -d 'Case