@anon.1d0b41a8d45d477c3029ec78f9b8b434.3484 = private unnamed_addr constant [1308 x i8] c"function funcsave --description \22Save the current definition of all specified functions to file\22\0A    set -l options q/quiet h/help d/directory=\0A    argparse -n funcsave $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help funcsave\0A        return 0\0A    end\0A\0A    set -l funcdir\0A    if set -q _flag_directory\0A        set funcdir $_flag_directory\0A    else\0A        set funcdir $__fish_config_dir/functions\0A    end\0A\0A    if not set -q argv[1]\0A        printf (_ \22%ls: Expected at least %d args, got only %d\\n\22) funcsave 1 0 >&2\0A        return 1\0A    end\0A\0A    if not mkdir -p $funcdir\0A        printf (_ \22%s: Could not create configuration directory '%s'\\n\22) funcsave $funcdir >&2\0A        return 1\0A    end\0A\0A    set -l retval 0\0A    for funcname in $argv\0A        set -l funcpath \22$funcdir/$funcname.fish\22\0A        if functions -q -- $funcname\0A            functions --no-details -- $funcname >$funcpath\0A            and set -q _flag_quiet || printf (_ \22%s: wrote %s\\n\22) funcsave $funcpath\0A        else if test -w $funcpath\0A            rm $funcpath\0A            and set -q _flag_quiet || printf (_ \22%s: removed %s\\n\22) funcsave $funcpath\0A        else\0A            printf (_ \22%s: Unknown function '%s'\\n\22) funcsave $funcname >&2\0A            set retval 1\0A        end\0A    end\0A\0A    return $retval\0Aend\0A", align 1
