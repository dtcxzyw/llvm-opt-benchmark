@anon.1d0b41a8d45d477c3029ec78f9b8b434.1928 = private unnamed_addr constant [961 x i8] c"__fish_make_completion_signals\0A\0Afor sig in $__kill_signals[-1..1]\0A    set -l number (string split ' ' $sig)[1]\0A    set -l name (string split ' ' $sig)[2]\0A    complete -c kill -o $number -d $name\0A    complete -c kill -o $name -d $number\0A    complete -c kill -k -s s -x -a \22$name\\t$number\22\0Aend\0A\0Acomplete -c kill -xa '(__fish_complete_pids)'\0A\0Aif kill -L >/dev/null 2>/dev/null\0A    complete -c kill -s s -l signal -d \22Signal to send\22\0A    complete -c kill -s l -l list -d \22List signal names\22\0A    complete -c kill -s L -l table -d \22List signal names and their #s\22\0A    complete -c kill -s a -l all -d \22Resolve PIDs from other users' too\22\0A    complete -c kill -s p -l pid -d \22Show resolved PID, don't send signal\22\0A    complete -c kill -s q -l queue -d \22Use sigqueue(2) rather than kill(2)\22\0A    complete -c kill -l verbose -d \22Print PIDs and signals sent\22\0Aelse # non-GNU\0A    complete -c kill -s s -d \22Signal to send\22\0A    complete -c kill -s l -d \22List signal names\22\0Aend\0A", align 1
