@anon.1d0b41a8d45d477c3029ec78f9b8b434.2658 = private unnamed_addr constant [6269 x i8] c"# Note that when a completion file is sourced a new block scope is created so `set -l` works.\0Aset -l __fish_status_all_commands \\\0A    basename \\\0A    buildinfo \\\0A    current-command \\\0A    current-commandline \\\0A    current-filename \\\0A    current-function \\\0A    current-line-number \\\0A    dirname \\\0A    features \\\0A    filename \\\0A    fish-path \\\0A    function \\\0A    get-file \\\0A    is-block \\\0A    is-breakpoint \\\0A    is-command-substitution \\\0A    is-full-job-control \\\0A    is-interactive \\\0A    is-interactive-job-control \\\0A    is-interactive-read \\\0A    is-login \\\0A    is-no-job-control \\\0A    job-control \\\0A    line-number \\\0A    list-files \\\0A    print-stack-trace \\\0A    stack-trace \\\0A    test-feature\0A\0A# These are the recognized flags.\0Acomplete -c status -s h -l help -d \22Display help and exit\22\0A\0A# The \22is-something\22 subcommands.\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-login -d \22Test if this is a login shell\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-interactive -d \22Test if this is an interactive shell\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-interactive-read -d \22Test if inside an interactive read builtin\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-command-substitution -d \22Test if a command substitution is currently evaluated\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-block -d \22Test if a code block is currently evaluated\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-breakpoint -d \22Test if a breakpoint is currently in effect\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-no-job-control -d \22Test if new jobs are never put under job control\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-interactive-job-control -d \22Test if only interactive new jobs are put under job control\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a is-full-job-control -d \22Test if all new jobs are put under job control\22\0A\0A# The subcommands that are not \22is-something\22 which don't change the fish state.\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a buildinfo -d \22Print information on how this version fish was built\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a current-command -d \22Print the name of the currently running command or function\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a current-commandline -d \22Print the currently running command with its arguments\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a current-filename -d \22Print the filename of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a filename -d \22Print the filename of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a basename -d \22Print the file name (without the path) of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a dirname -d \22Print the path (without the file name) of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a current-function -d \22Print the name of the current function\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a function -d \22Print the name of the current function\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a current-line-number -d \22Print the line number of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a line-number -d \22Print the line number of the currently running script\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a print-stack-trace -d \22Print a list of all function calls leading up to running the current command\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a stack-trace -d \22Print a list of all function calls leading up to running the current command\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a features -d \22List all feature flags\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a test-feature -d \22Test if a feature flag is enabled\22\0Acomplete -f -c status -n \22__fish_seen_subcommand_from test-feature\22 -a '(status features | sed \22s/[[:space:]]\\+[^[:space:]]*[[:space:]]\\+[^[:space:]]*/\\t/\22)'\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a fish-path -d \22Print the path to the current instance of fish\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a get-file -d \22Print an embedded file from the fish binary\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a list-files -d \22List embedded files contained in the fish binary\22\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a fish-path -d \22Print the path to the current instance of fish\22\0A\0A# The job-control command changes fish state.\0Acomplete -f -c status -n \22not __fish_seen_subcommand_from $__fish_status_all_commands\22 -a job-control -d \22Set which jobs are under job control\22\0Acomplete -f -c status -n \22__fish_seen_subcommand_from job-control\22 -a full -d \22Set all jobs under job control\22\0Acomplete -f -c status -n \22__fish_seen_subcommand_from job-control\22 -a interactive -d \22Set only interactive jobs under job control\22\0Acomplete -f -c status -n \22__fish_seen_subcommand_from job-control\22 -a none -d \22Set no jobs under job control\22\0A\0Acomplete -f -c status -n \22__fish_seen_subcommand_from get-file\22 -a '(status list-files 2>/dev/null)'\0Acomplete -f -c status -n \22__fish_seen_subcommand_from list-files\22 -a '(status list-files 2>/dev/null)'\0A", align 1
