@anon.1d0b41a8d45d477c3029ec78f9b8b434.2216 = private unnamed_addr constant [54048 x i8] c"# npm (https://npmjs.org) completions for Fish shell\0A# __fish_npm_needs_* and __fish_npm_using_* taken from:\0A# https://stackoverflow.com/questions/16657803/creating-autocomplete-script-with-sub-commands\0A# see also Fish's large set of completions for examples:\0A# https://github.com/fish-shell/fish-shell/tree/master/share/completions\0A\0A__fish_npm_helper\0Aset -l npm_install \22npm install --global\22\0A\0Afunction __fish_npm_needs_command\0A    set -l cmd (commandline -xpc)\0A\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __fish_npm_using_command\0A    set -l cmd (commandline -xpc)\0A\0A    if test (count $cmd) -gt 1\0A        if contains -- $cmd[2] $argv\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __fish_npm_needs_option\0A    switch (commandline -ct)\0A        case \22-*\22\0A            return 0\0A    end\0A    return 1\0Aend\0A\0A# list available npm scripts and their partial content\0Afunction __fish_parse_npm_run_completions\0A    while read -l name\0A        set -l trim 20\0A        read -l value\0A        set value (string sub -l $trim -- $value)\0A        printf \22%s\\t%s\\n\22 $name $value\0A    end\0Aend\0A\0Afunction __fish_npm_run\0A    # Complete `npm run` scripts\0A    # These are stored in package.json, which we need a tool to read.\0A    # python is very probably installed (we use it for other things!),\0A    # jq is slower but also a common tool,\0A    # npm is dog-slow and might check for updates online!\0A    if test -e package.json; and set -l python (__fish_anypython)\0A        # Warning: That weird indentation is necessary, because python.\0A        $python -S -c 'import json, sys; data = json.load(sys.stdin);\0Afor k,v in data[\22scripts\22].items(): print(k + \22\\t\22 + v[:18])' <package.json 2>/dev/null\0A    else if command -sq jq; and test -e package.json\0A        jq -r '.scripts | to_entries | map(\22\\(.key)\\t\\(.value | tostring | .[0:20])\22) | .[]' package.json\0A    else if command -sq npm\0A        # Like above, only try to call npm if there's a command by that name to facilitate aliases that call nvm.\0A        command npm run | string match -r -v '^[^ ]|^$' | string trim | __fish_parse_npm_run_completions\0A    end\0Aend\0A\0A# run\0Acomplete -f -c npm -n __fish_npm_needs_command -a 'run-script run' -d 'Run arbitrary package scripts'\0Afor c in run-script run rum urn\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -a \22(__fish_npm_run)\22\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -l if-present -d \22Don't error on nonexistent script\22\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -l ignore-scripts -d \22Don't run pre-, post- and life-cycle scripts\22\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -s script-shell -d 'The shell to use for scripts'\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -l foreground-scripts -d 'Run all build scripts in the foreground'\0Aend\0A\0A# access\0Aset -l access_commands 'list get set grant revoke'\0Acomplete -f -c npm -n __fish_npm_needs_command -a access -d 'Set access level on published packages'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n \22not __fish_seen_subcommand_from $access_commands\22 -a list -d 'List access info'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n \22not __fish_seen_subcommand_from $access_commands\22 -a get -d 'Get access level'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n \22not __fish_seen_subcommand_from $access_commands\22 -a grant -d 'Grant access to users'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n \22not __fish_seen_subcommand_from $access_commands\22 -a revoke -d 'Revoke access from users'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n \22not __fish_seen_subcommand_from $access_commands\22 -a set -d 'Set access level'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from list' -a 'packages collaborators'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from get' -a status\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from grant' -a 'read-only read-write'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from set' -a 'status=public status=private' -d 'Set package status'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from set' -a 'mfa=none mfa=publish mfa=automation' -d 'Set package MFA'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -n '__fish_seen_subcommand_from set' -a '2fa=none 2fa=publish 2fa=automation' -d 'Set package MFA'\0Acomplete -f -c npm -n '__fish_npm_using_command access' -l json -d 'Output JSON'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -l otp -d '2FA one-time password'\0Acomplete -x -c npm -n '__fish_npm_using_command access' -l registry -d 'Registry base URL'\0Acomplete -f -c npm -n '__fish_npm_using_command access' -s h -l help -d 'Display help'\0A\0A# adduser\0Acomplete -f -c npm -n __fish_npm_needs_command -a adduser -d 'Add a registry user account'\0Acomplete -f -c npm -n __fish_npm_needs_command -a login -d 'Login to a registry user account'\0Afor c in adduser add-user login\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l registry -d 'Registry base URL'\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l scope -d 'Log into a private repository'\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l auth-type -a 'legacy web' -d 'Authentication strategy'\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -s h -l help -d 'Display help'\0Aend\0A\0A# audit\0Acomplete -f -c npm -n __fish_npm_needs_command -a audit -d 'Run a security audit'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -a signatures -d 'Verify registry signatures'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -a fix -d 'Install compatible updates to vulnerable deps'\0Acomplete -x -c npm -n '__fish_npm_using_command audit' -l audit-level -a 'info low moderate high critical none' -d 'Audit level'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l dry-run -d 'Do not make any changes'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -s f -l force -d 'Removes various protections'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l json -d 'Output JSON'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l package-lock-only -d 'Only use package-lock.json, ignore node_modules'\0Acomplete -x -c npm -n '__fish_npm_using_command audit' -l omit -a 'dev optional peer' -d 'Omit dependency type'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l foreground-scripts -d 'Run all build scripts in the foreground'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l ignore-scripts -d \22Don't run pre-, post- and life-cycle scripts\22\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -l install-links -d 'Install file: protocol deps as regular deps'\0Acomplete -f -c npm -n '__fish_npm_using_command audit' -s h -l help -d 'Display help'\0A\0A# bugs\0Afor c in bugs issues\0A    complete -f -c npm -n __fish_npm_needs_command -a \22$c\22 -d 'Report bugs for a package in a web browser'\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l browser -d 'Set browser'\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l no-browser -d 'Print to stdout'\0A    complete -x -c npm -n \22__fish_npm_using_command $c\22 -l registry -d 'Registry base URL'\0A    complete -f -c npm -n \22__fish_npm_using_command $c\22 -s h -l help -d 'Display help'\0Aend\0A\0A# cache\0Acomplete -f -c npm -n __fish_npm_needs_command -a cache -d \22Manipulates package's cache\22\0Acomplete -f -c npm -n '__fish_npm_using_