s the data to the HTTP server in the Cookie header'\0Acomplete -c curl -l create-dirs -d 'Create dirs for -o/--output'\0Acomplete -c curl -l crlf -d '(FTP SMTP) Convert LF to CRLF in upload.  Useful for MVS (OS/390)'\0Acomplete -c curl -l crlfile -d '(TLS) Provide a file using PEM format with a Certificate Revocation List'\0Acomplete -c curl -l data-ascii -d '(HTTP) Alias for -d, --data'\0Acomplete -c curl -l data-binary -d '(HTTP) Post data exactly as specified with no processing'\0Acomplete -c curl -l data-raw -d '(HTTP) Post data like --data but without interpreting \22@\22'\0Acomplete -c curl -l data-urlencode -d '(HTTP) Post data URL-encoded'\0Acomplete -c curl -s d -l data -d '(HTTP) Sends the specified data in a POST request to the HTTP server'\0Acomplete -c curl -l delegation -d '(GSS/kerberos) Tell the server how much it can delegate for user creds' -xa '(\0Aprintf %s\\t%s\\n \\\0Anone \22Don\\'t allow any delegation\22 \\\0Apolicy \22Delegate only if the OK-AS-DELEGATE flag is set in the Kerberos service ticket\22 \\\0Aalways \22Allow the server to delegate\22)'\0Acomplete -c curl -l digest -d '(HTTP) Enables HTTP Digest authentication'\0Acomplete -c curl -l disable-eprt -d '(FTP) Don\\'t use EPRT and LPRT commands in active FTP'\0Acomplete -c curl -l disable-epsv -d '(FTP) Don\\'t use EPSV in passive FTP'\0Acomplete -c curl -s q -l disable -d 'Disable curlrc'\0Acomplete -c curl -l disallow-username-in-url -d '(HTTP) Exit if passed a url containing a username'\0Acomplete -c curl -l dns-interface -d '(DNS) Send outgoing DNS requests through <interface>'\0Acomplete -c curl -l dns-ipv4-addr -d '(DNS) Bind to <ip-address> when making IPv4 DNS requests'\0Acomplete -c curl -l dns-ipv6-addr -d '(DNS) Bind to <ip-address> when making IPv6 DNS requests'\0Acomplete -c curl -l dns-servers -d 'Set the list of DNS servers to use'\0Acomplete -c curl -l doh-url -d '(all) Specify which DNS-over-HTTPS (DOH) server to use to resolve hostnames'\0Acomplete -c curl -s D -l dum