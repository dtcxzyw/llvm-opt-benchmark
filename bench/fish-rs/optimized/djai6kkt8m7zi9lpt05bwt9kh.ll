@anon.1d0b41a8d45d477c3029ec78f9b8b434.3436 = private unnamed_addr constant [2841 x i8] c"function fish_default_key_bindings -d \22emacs-like key binds\22\0A    if contains -- -h $argv\0A        or contains -- --help $argv\0A        echo \22Sorry but this function doesn't support -h or --help\22\0A        return 1\0A    end\0A\0A    if not set -q argv[1]\0A        bind --erase --all --preset # clear earlier bindings, if any\0A        if test \22$fish_key_bindings\22 != fish_default_key_bindings\0A            __fish_change_key_bindings fish_default_key_bindings || return\0A            set fish_bind_mode default\0A        end\0A    end\0A\0A    # Silence warnings about unavailable keys. See #4431, 4188\0A    if not contains -- -s $argv\0A        set argv -s $argv\0A    end\0A\0A    # These are shell-specific bindings that we share with vi mode.\0A    __fish_shared_key_bindings $argv\0A    or return # protect against invalid $argv\0A\0A    bind --preset $argv right forward-char\0A    bind --preset $argv left backward-char\0A\0A    bind --preset $argv delete delete-char\0A    bind --preset $argv backspace backward-delete-char\0A    bind --preset $argv shift-backspace backward-delete-char\0A\0A    bind --preset $argv home beginning-of-line\0A    bind --preset $argv end end-of-line\0A\0A    bind --preset $argv ctrl-a beginning-of-line\0A    bind --preset $argv ctrl-e end-of-line\0A    bind --preset $argv ctrl-h backward-delete-char\0A    bind --preset $argv ctrl-p up-or-search\0A    bind --preset $argv ctrl-n down-or-search\0A    bind --preset $argv ctrl-f forward-char\0A    bind --preset $argv ctrl-b backward-char\0A    bind --preset $argv ctrl-t transpose-chars\0A    bind --preset $argv ctrl-g cancel\0A    bind --preset $argv ctrl-/ undo\0A    bind --preset $argv ctrl-_ undo # XTerm idiosyncracy, can get rid of this once we go full CSI u\0A    bind --preset $argv ctrl-z undo\0A    bind --preset $argv ctrl-shift-z redo\0A    bind --preset $argv alt-/ redo\0A    bind --pr