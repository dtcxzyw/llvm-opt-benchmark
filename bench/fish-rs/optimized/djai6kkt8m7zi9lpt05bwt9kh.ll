@anon.1d0b41a8d45d477c3029ec78f9b8b434.1232 = private unnamed_addr constant [11030 x i8] c"# bluetoothctl enables to manage bluetooth devices and controllers.\0A\0Aset -l cmds list show select devices paired-devices system-alias reset-alias power pairable discoverable discoverable-timeout agent default-agent advertise set-alias scan info pair cancel-pairing trust untrust block unblock remove connect disconnect scan.uuids scan.service scan.manufacturer scan.data scan.discoverable scan.discoverable-timeout scan.tx-power scan.name scan.appearance scan.duration scan.timeout scan.secondary scan.clear gatt.list-attributes gatt.select-attribute gatt.attribute-info gatt.read gatt.write gatt.acquire-write gatt.release-write gatt.acquire-notify gatt.release-notify gatt.notify gatt.clone gatt.register-application gatt.unregister-application gatt.register-service gatt.unregister-service gatt.register-includes gatt.unregister-includes gatt.register-characteristic gatt.unregister-characteristic gatt.register-descriptor gatt.unregister-descriptor advertise.uuids advertise.service advertise.manufacturer advertise.data advertise.discoverable advertise.discoverable-timeout advertise.tx-power advertise.name advertise.appearance advertise.duration advertise.timeout advertise.secondary advertise.clear\0A\0Afunction __fish_list_bluetoothctl_devices\0A    # Output of `bluetoothctl devices`:\0A    # Device 01:23:34:56:89:AB Name1\0A    # Device 01:23:34:56:89:AC Name2\0A    bluetoothctl devices 2>/dev/null | string replace -r \22^Device \22 \22\22 | string replace \22 \22 \\t\0Aend\0A\0Afunction __fish_list_bluetoothctl_controllers\0A    # Output of `bluetoothctl list`:\0A    # Controller 01:23:34:56:89:AB Name1 [default]\0A    # Controller 01:23:34:56:89:AC Name2\0A    bluetoothctl list 2>/dev/null | string replace -r \22^Controller \22 \22\22 | string replace \22 \22 \\t\0Aend\0A\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a list -d \22List available controllers\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a show -d \22Controller information\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a select -d \22Select default controller\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a devices -d \22List available devices\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a paired-devices -d \22List paired devices\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a system-alias -d \22Set controller alias\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a reset-alias -d \22Reset controller alias\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a power -d \22Set controller power\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a pairable -d \22Set controller pairable mode\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a discoverable -d \22Set controller discoverable mode\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a discoverable-timeout -d \22Set discoverable timeout\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a agent -d \22Enable/disable agent with given capability\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a default-agent -d \22Set agent as the default one\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a advertise -d \22Enable/disable advertising with given type\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a set-alias -d \22Set device alias\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a scan -d \22Scan for devices\22\0Acomplete -f -c bluetoothctl -n \22not __fish_seen_subcommand_from $cmds\22 -a info -d \22Device informat