@anon.1d0b41a8d45d477c3029ec78f9b8b434.1384 = private unnamed_addr constant [4756 x i8] c"function __fish_print_connman_services\0A    # connmanctl services follows this pattern (to be interpreted as a regex):\0A    # \22[\\* ][A ][ORacd ] service_name +identification_string\22\0A    # where [\\* ] indicates whether a service is a favorite\0A    # [A ] indicates whether a service is in autoconnect mode\0A    # [ORacd ] indicates the current status of the service: online, ready, association, configuration, disconnect or idle\0A    connmanctl services | string replace -r '.{4}(.*) +(.*)' '$2\\t$1'\0Aend\0A\0Afunction __fish_print_connman_technologies\0A    connmanctl technologies | string match '*Type*' | string replace -r '  Type = (.*)' '$1'\0Aend\0A\0Afunction __fish_print_connman_vpnconnections\0A    # formatting of the vpn connections:\0A    # \22  [RCF ] service_name +identification_string\22\0A    # where [RCF ] indicates the current status which can be: ready, configuration, failure or idle\0A    connmanctl vpnconnections | string replace -r '.{4}(.*) +(.*)' '$2\\t$1'\0Aend\0A\0A# connmanctl does not accept options before commands, so requiring the commands to be in second position is okay\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a state -d \22Shows if the system is online or offline\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a technologies -d \22Display technologies\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a clock -d \22Get System Clock Properties\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a enable -d \22Enables given technology or offline mode\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] enable\22 -a \22(__fish_print_connman_technologies) offline\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a disable -d \22Disables given technology or offline mode\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] disable\22 -a \22(__fish_print_connman_technologies) offline\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a tether -d \22Enable, disable tethering, set SSID and passphrase for wifi\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] tether\22 -a \22(__fish_print_connman_technologies)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 3; and contains -- (commandline -xpc)[2] tether\22 -a \22on off\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a services -d \22Display services\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] services\22 -a \22(__fish_print_connman_services)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a peers -d \22Display peers\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a scan -d \22Scans for new services for given technology\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] scan\22 -a \22(__fish_print_connman_technologies)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a connect -d \22Connect a given service or peer\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] connect\22 -a \22(__fish_print_connman_services)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a disconnect -d \22Disconnect a given service or peer\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] disconnect\22 -a \22(__fish_print_connman_services)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a config -d \22Set service configuration options\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] config\22 -a \22(__fish_print_connman_services)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a monitor -d \22Monitor signals from interfaces\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a vpnconnections -d \22Display VPN connections\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] vpnconnections\22 -a \22(__fish_print_connman_vpnconnections)\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a session -d \22Enable or disable a session\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -eq 2; and contains -- (commandline -xpc)[2] session\22 -a \22on off connect disconnect config\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a peer_service -d \22(Un)Register a Peer Service\22\0Acomplete -f -c connmanctl -n \22test (count (commandline -xpc)) -lt 2\22 -a help -d \22Show help\22\0A", align 1
