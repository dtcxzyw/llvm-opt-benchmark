@anon.1d0b41a8d45d477c3029ec78f9b8b434.2076 = private unnamed_addr constant [936 x i8] c"# completion for mdimport (macOS)\0A\0Acomplete -c mdimport -s g -r -d 'Import files using the listed plugin'\0Acomplete -c mdimport -s V -f -d 'Print timing information for this run'\0Acomplete -c mdimport -s A -f -d 'Print out the list of all of the attributes and exit'\0Acomplete -c mdimport -s X -f -d 'Print out the schema file and exit'\0Acomplete -c mdimport -s r -f -d 'Ask the server to reimport files for UTIs claimed by the listed plugin'\0Acomplete -c mdimport -s p -f -d 'Print out performance information gathered during the run'\0Acomplete -c mdimport -s L -f -d 'Print the list of installed importers and exit'\0Acomplete -c mdimport -s d -x -a '1 2 3 4' -d 'Print debugging information'\0Acomplete -c mdimport -s n -f -d 'Dont send the imported attributes to the data store'\0Acomplete -c mdimport -s w -x -d 'Wait for the specified interval between scanning files'\0Acomplete -c mdimport -s o -r -d 'Write the imported attributes to a file'\0A", align 1
