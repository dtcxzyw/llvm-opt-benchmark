@anon.1d0b41a8d45d477c3029ec78f9b8b434.2736 = private unnamed_addr constant [1629 x i8] c"# Written against `tokei --help`, version 10.0.1 compiled with support for CBOR, JSON, and YAML\0A\0Afunction __fish_tokei_supported_serializations\0A    # Expecting a line like:\0A    # tokei 10.0.1 compiled with serialization support: cbor, json, yaml\0A    command tokei --help | grep 'with serialization support' | string split --fields 2 : | string trim | string split ', '\0Aend\0A\0Acomplete -c tokei -s f -l files -d 'Print out statistics for individual files'\0Acomplete -c tokei -f -s h -l help -d 'Print help information'\0Acomplete -c tokei -l hidden -d 'Count hidden files, too'\0Acomplete -c tokei -f -s l -l languages -d 'Print out supported languages'\0Acomplete -c tokei -l no-ignore -d 'Don\E2\80\99t respect ignore files'\0Acomplete -c tokei -l no-ignore-parent -d 'Don\E2\80\99t respect ignore files in parent directories'\0Acomplete -c tokei -l no-ignore-vcs -d 'Don\E2\80\99t respect version-control ignore files'\0Acomplete -c tokei -f -s V -l version -d 'Print version information'\0Acomplete -c tokei -s v -l verbose -d 'Increase log output level'\0A\0A# Options\0Acomplete -c tokei -x -s c -l columns -d 'Set column width for terminal output'\0Acomplete -c tokei -x -s e -l exclude -d 'Ignore all files and directories containing this word'\0Acomplete -c tokei -r -s i -l input -d 'Gives statistics from a previous Tokei run'\0Acomplete -c tokei -x -s o -l output -a '(__fish_tokei_supported_serializations)' -d 'Choose output format'\0Acomplete -c tokei -x -s s -l sort -ka 'files lines code comments blanks' -d 'Sort languages based on column'\0Acomplete -c tokei -x -s t -l type -a '(command tokei --languages)' -d 'Filters output by language type, comma-separated'\0A", align 1
