@anon.1d0b41a8d45d477c3029ec78f9b8b434.1886 = private unnamed_addr constant [433 x i8] c"function __history_completions --argument-names limit\0A    if string match -q \22\22 -- \22$limit\22\0A        set limit 25\0A    end\0A\0A    set -l tokens (commandline --current-process --tokens-expanded)\0A    history --prefix (commandline) | string replace -r \\^$tokens[1]\\\\s\\* \22\22 | head -n$limit\0Aend\0A\0A# erase the stock autojump completions, which are no longer needed with this\0Acomplete -c j -e\0Acomplete -k -c j -a '(__history_completions 25)' -f\0A", align 1
