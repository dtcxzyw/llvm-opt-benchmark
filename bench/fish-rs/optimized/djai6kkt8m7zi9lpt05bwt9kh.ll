@anon.1d0b41a8d45d477c3029ec78f9b8b434.1978 = private unnamed_addr constant [1471 x i8] c"function __fish_print_console_keymaps\0A    # The path(s) used may differ by linux distribution, and are compiled into\0A    # loadkeys, which doesn't provide a way to check which paths are searched\0A    # or which keymaps it can find. localectl can list keymaps, but is part of\0A    # systemd, which we shouldn't depend on.\0A\0A    set -l dirs /usr/share/kbd/keymaps /usr/share/keymaps /usr/lib/kbd/keymaps /lib/kbd/keymaps /usr/src/linux/drivers\0A\0A    path filter -f $dirs/** | string replace -rf '.*/(.*)\\.k?map(|\\..*)$' '$1'\0Aend\0A\0Acomplete -fc loadkeys -a \22(__fish_print_console_keymaps)\22\0A\0Acomplete -c loadkeys -s C -l console -d \22Console device to use\22 -x -a \22(path filter --type=char /dev/tty*)\22\0Acomplete -c loadkeys -s a -l ascii -d \22Force conversion to ASCII\22\0Acomplete -c loadkeys -s b -l bkeymap -d \22Output binary keymap\22\0Acomplete -c loadkeys -s c -l clearcompose -d \22Clear kernel compose table\22\0Acomplete -c loadkeys -s d -l default -d \22Load default keymap\22\0Acomplete -c loadkeys -s m -l mktable -d \22Output a 'defkeymap.c'\22\0Acomplete -c loadkeys -s p -l parse -d \22Only search and parse keymap\22\0Acomplete -c loadkeys -s s -l clearstrings -d \22Clear kernel string table\22\0Acomplete -c loadkeys -s u -l unicode -d \22Force conversion to Unicode\22\0Acomplete -c loadkeys -s q -l quiet -d \22Suppress all normal output\22\0Acomplete -c loadkeys -s v -l verbose -d \22Be more verbose\22\0Acomplete -c loadkeys -s V -l version -d \22Print version number\22\0Acomplete -c loadkeys -s h -l help -d \22Print help\22\0A", align 1
