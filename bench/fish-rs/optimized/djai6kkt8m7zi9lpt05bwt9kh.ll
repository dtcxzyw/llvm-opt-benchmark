@anon.1d0b41a8d45d477c3029ec78f9b8b434.2910 = private unnamed_addr constant [4146 x i8] c"set -l commands status get-volume inspect set-default set-volume set-mute set-profile clear-default\0A\0Aif wpctl settings &>/dev/null\0A    set --append commands settings\0Aend\0A\0Afunction __wpctl_get_nodes -a section -a type\0A    set -l havesection\0A    set -l havetype\0A    wpctl status | while read -l line\0A        if set -q havesection[1]\0A            test -z \22$line\22; and break\0A            if set -q havetype[1]\0A                string match -rq '^\\s*\\\E2\94\82\\s*$' -- $line; and break\0A                printf '%s\\t%s\\n' (string match -r '\\d+' $line) (string match -rg '\\d+\\. ([^\\[]*)' $line)\0A            else\0A                string match -q \22*$type*\22 -- $line\0A                and set havetype 1\0A            end\0A        else\0A            string match -q \22$section*\22 -- $line\0A            and set havesection 1\0A        end\0A    end\0Aend\0A\0Afunction __wpctl_command_shape\0A    set -l shape $argv\0A    set -l command (commandline -pxc)\0A    set -e command[1] # Remove command name\0A\0A    # Remove flags as we won't count them with the shape\0A    set -l command (string match -v -- '-*' $command)\0A\0A    if test (count $command) != (count $shape)\0A        return 1\0A    end\0A\0A    while set -q command[1]\0A        string match -q -- $shape[1] $command[1]; or return 1\0A        set -e shape[1] command[1]\0A    end\0Aend\0A\0Afunction __wpctl_get_settings\0A    set -l wpctl_settings (wpctl settings 2>/dev/null| string collect)\0A    or return\0A\0A    string match --regex --all --quiet '\\- Name: (?<wpctl_settings_name>.*)\\n  Desc: (?<wpctl_settings_desc>.*)' $wpctl_settings\0A\0A    for i in (seq (count $wpctl_settings_name))\0A        set -l name $wpctl_settings_name[$i]\0A        set -l desc (string shorten --max 60 $wpctl_settings_desc[$i])\0A        echo $name\\t$desc\0A    end\0Aend\0A\0Acomplete -c wpctl -f\0A\0Acomplete -c wpctl -s h -l help -d \22Show help options\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from status\22 -s k -l nick -d \22Display device and node nicknames instead of descriptions\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from status\22 -s n -l name -d \22Display device and node names instead of descriptions\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from inspect\22 -s r -l referenced -d \22Show objects that are referenced in properties\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from inspect\22 -s a -l associated -d \22Show associated objects\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from set-volume\22 -s p -l pid -d \22Selects all nodes associated to the given PID\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from set-volume\22 -s l -l limit -d \22Limit volume to below this value\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from set-mute\22 -s p -l pid -d \22Selects all nodes associated to the given PID\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from settings\22 -s d -l delete -d \22Deletes the saved setting value\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from settings\22 -s s -l save -d \22Saves the setting value\22\0Acomplete -c wpctl -n \22__fish_seen_subcommand_from settings\22 -s r -l reset -d \22Resets the saved setting to its default value\22\0A\0Acomplete -c wpctl -n __wpctl_command_shape -a \22$commands\22\0Acomplete -c wpctl -n '__wpctl_command_shape \22*\22' -n \22__fish_seen_subcommand_from get-volume inspect set-volume set-mute set-profile\22 -a \22@DEFAULT_AUDIO_SOURCE@\22 -d \22Default Microphone\22\0Acomplete -c wpctl -n '__wpctl_command_shape \22*\22' -n \22__fish_seen_subcommand_from get-volume inspect set-volume set-mute set-profile\22 -a \22@DEFAULT_AUDIO_SINK@\22 -d \22Default Speakers\22\0Acomplete -c wpctl -n '__wpctl_command_shape \22*\22' -n \22__fish_seen_subcommand_from inspect set-profile\22 -a \22@DEFAULT_VIDEO_SOURCE@\22 -d \22Default Camera\22\0Acomplete -c wpctl -n '__wpctl_command_shape \22*\22' -n \22__fish_seen_subcommand_from get-volume inspect set-volume set-mute set-profile\22 -a \22(__wpctl_get_nodes Audio Sources) (__wpctl_get_nodes Audio Sinks)\22\0Acomplete -c wpctl -n '__wpctl_command_shape \22*\22' -n \22__fish_seen_subcommand_from inspect set-profile\22 -a \22(__wpctl_get_nodes Audio Sources) (__wpctl_get_nodes Audio Sinks) (__wpctl_get_nodes Video Source)\22\0Acomplete -c wpctl -n '__wpctl_command_shape set-mute \22*\22' -a \220 1 toggle\22\0Acomplete -c wpctl -n '__wpctl_command_shape settings' -a \22(__wpctl_get_settings)\22\0A", align 1
