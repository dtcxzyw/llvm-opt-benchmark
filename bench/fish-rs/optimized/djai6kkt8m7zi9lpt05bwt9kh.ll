@anon.1d0b41a8d45d477c3029ec78f9b8b434.1808 = private unnamed_addr constant [94840 x i8] c"# fish completion for hg\0A\0A# Mercurial has a global switch to specify the path to the repository on which\0A# to run the hg command (-R or --repository).  If that is on the commandline,\0A# this function echoes the given path and returns 0.  Otherwise, it returns 1.\0Afunction __fish_hg_get_repo\0A    set -l cmdline (commandline -p)\0A    if set -l match (string match -r -- \22(-R|--repository) +([^ ]+)\22 $cmdline)\0A        echo $match[3]\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0A# Mercurial also has a global switch to specify a directory to which to switch\0A# before running the command (--cwd).  If it is on the commandline, this\0A# function echoes the given path and returns 0.  Otherwise, it returns 1.\0Afunction __fish_hg_get_cwd\0A    set -l cmdline (commandline -p)\0A    if set -l match (string match -r -- \22--cwd +([^ ]+)\22 $cmdline)\0A        echo $match[2]\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_hg\0A    set -lx HGPLAIN 1\0A    if set -l repo (__fish_hg_get_repo)\0A        set argv $argv -R $repo\0A    end\0A    if set -l cwd (__fish_hg_get_cwd)\0A        set argv $argv --cwd $cwd\0A    end\0A    command hg $argv 2>/dev/null\0Aend\0A\0Afunction __fish_hg_commands\0A    set -l commands (__fish_hg debugcomplete)\0A    for command in $commands\0A        switch $command\0A            case add\0A                printf \22$command\\tadd the specified files on the next commit\\n\22\0A            case addremove\0A                printf \22$command\\tadd all new files, delete all missing files\\n\22\0A            case annotate\0A                printf \22$command\\tshow changeset information by line for each file\\n\22\0A            case archive\0A                printf \22$command\\tcreate an unversioned archive of a repository revision\\n\22\0A            case backout\0A                printf \22$command\\treverse effect of earlier changeset\\n\22\0A            case bisect\0A                printf \22$command\\tsubdivision search of changesets\\n\22\0A            case bookmarks\0A                printf \22$command\\tcreate a new bookmark or list existing bookmarks\\n\22\0A            case branch\0A                printf \22$command\\tset or show the current branch name\\n\22\0A            case branches\0A                printf \22$command\\tlist repository named branches\\n\22\0A            case bundle\0A                printf \22$command\\tcreate a bundle file\\n\22\0A            case cat\0A                printf \22$command\\toutput the current or given revision of files\\n\22\0A            case churn\0A                printf \22$command\\thistogram of changes to the repository\\n\22\0A            case clone\0A                printf \22$command\\tmake a copy of an existing repository\\n\22\0A            case commit\0A                printf \22$command\\tcommit the specified files or all outstanding changes\\n\22\0A            case config\0A                printf \22$command\\tshow combined config settings from all hgrc files\\n\22\0A            case convert\0A                printf \22$command\\tconvert a foreign SCM repository to a Mercurial one\\n\22\0A            case copy\0A                printf \22$command\\tmark files as copied for the next commit\\n\22\0A            case diff\0A                printf \22$command\\tdiff repository (or selected files)\\n\22\0A            case email\0A                printf \22$command\\tsend changesets by email\\n\22\0A            case export\0A                printf \22$command\\tdump the header and diffs for one or more changesets\\n\22\0A            case extdiff\0A                printf \22$command\\tuse external program to diff repository (or selected files)\\n\22\0A            case files\0A                printf \22$command\\tlist tracked files\\n\22\0A            case forget\0A                printf \22$command\\tforget the specified files on the next commit\\n\22\0A            case graft\0A                printf \22$command\\tcopy changes from other branches onto the current branch\\n\22\0A            case grep\0A                printf \22$command\\tsearch revision history for a pattern in specified files\\n\22\0A            case heads\0A                printf \22$command\\tshow branch heads\\n\22\0A            case help\0A                printf \22$command\\tshow help for a given topic or a help overview\\n\22\0A            case histedit\0A                printf \22$command\\tinteractively edit changeset history\\n\22\0A            case identify\0A                printf \22$command\\tidentify the working directory or specified revision\\n\22\0A            case import\0A                printf \22$command\\timport an ordered set of patches\\n\22\0A            case incoming\0A                printf \22$command\\tshow new changesets found in source\\n\22\0A            case init\0A                printf \22$command\\tcreate a new repository in the given directory\\n\22\0A            case locate\0A                printf \22$command\\tlocate files matching specific patterns\\n\22\0A            case log\0A                printf \22$command\\tshow revision history of entire repository or files\\n\22\0A            case manifest\0A                printf \22$command\\toutput the current or given revision of the project manifest\\n\22\0A            case merge\0A                printf \22$command\\tmerge another revision into working directory\\n\22\0A            case outgoing\0A                printf \22$command\\tshow changesets not found in the destination\\n\22\0A            case parents\0A                printf \22$command\\tshow the parents of the working directory or revision\\n\22\0A            case paths\0A                printf \22$command\\tshow aliases for remote repositories\\n\22\0A            case phase\0A                printf \22$command\\tset or show the current phase name\\n\22\0A            case pull\0A                printf \22$command\\tpull changes from the specified source\\n\22\0A            case push\0A                printf \22$command\\tpush changes to the specified destination\\n\22\0A            case qapplied\0A                printf \22$command\\tprint the patches already applied\\n\22\0A            case qclone\0A                printf \22$command\\tclone main and patch repository at same time\\n\22\0A            case qcommit\0A                # deprecated\0A            case qdelete\0A                printf \22$command\\tremove patches from queue\\n\22\0A            case qdiff\0A                printf \22$command\\tdiff of the current patch and subsequent modifications\\n\22\0A            case qfinish\0A                printf \22$command\\tmove applied patches into repository history\\n\22\0A            case qfold\0A                printf \22$command\\tfold the named patches into the current patch\\n\22\0A            case qgoto\0A                printf \22$command\\tpush or pop patches until named patch is at top of stack\\n\22\0A            case qguard\0A                printf \22$command\\t set or print guards for a patch\\n\22\0A            case qheader\0A                printf \22$command\\tprint the header of the topmost or specified patch\\n\22\0A            case qimport\0A                printf \22$command\\timport a patch or existing changeset\\n\22\0A            case qinit\0A                # deprecated\0A            case qnew\0A                printf \22$command\\tcreate a new patch\\n\22\0A            case qnext\0A                printf \22$command\\tprint the name of the next pushable patch\\n\22\0A            case qpop\0A                printf \22$command\\tpop the current patch off the stack\\n\22\0A            case qprev\0A                printf \22$command\\tprint the name of the preceding applied patch\\n\22\0A            case qpush\0A                printf \22$command\\tpush the next patch onto the stack\\n\22\0A            case qqueue\0A                printf \22$command\\tmanage multiple patch queues\\n\22\0A            case qrecord\0A                printf \22$command\\tinteractively record a new patch\\n\22\0A            case qrefresh\0A                printf \22$command\\tupdate the current patch\\n\22\0A            case qrename\0A                printf \22$command\\trename a patch\\n\22\0A            case qrestore\0A                # deprecated\0A            case qsave\0A                # deprecated\0A            case qselect\0A                printf \22$command\\tset or print guarded patches to push\\n\22\0A            case qseries\0A                printf \22$command\\tprint the entire series file\\n\22\0A            case qtop\0A                printf \22$command\\tprint the name of the current patch\\n\22\0A            case qunapplied\0A                printf \22$command\\tprint the patches not yet applied\\n\22\0A            case rebase\0A                printf \22$command\\tmove changeset (and descendants) to a different branch\\n\22\0A            case record\0A                printf \22$command\\tinteractively select changes to commit\\n\22\0A            case recover\0A                printf \22$command\\troll back an interrupted transaction\\n\22\0A            case remove\0A                printf \22$command\\tremove the specified files on the next commit\\n\22\0A            case rename\0A                printf \22$command\\trename files; equivalent of copy + remove\\n\22\0A            case resolve\0A                printf \22$command\\tredo merges or set/view the merge status of files\\n\22\0A            case revert\0A                printf \22$command\\trestore files to their checkout state\\n\22\0A            case rollback\0A                # deprecated\0A            case root\0A                printf \22$command\\tprint the root (top) of the current working directory\\n\22\0A            case serve\0A                printf \22$command\\tstart stand-alone webserver\\n\22\0A            case shelve\0A                printf \22$command\\tsave and set aside changes from the working directory\\n\22\0A            case status\0A                printf \22$command\\tshow changed files in the working directory\\n\22\0A            case strip\0A                printf \22$command\\tstrip changesets and all their descendants from the repository\\n\22\0A            case summary\0A                printf \22$command\\tsummarize working directory state\\n\22\0A            case tag\0A                printf \22$command\\tadd one or more tags for the current or given revision\\n\22\0A            case tags\0A                printf \22$command\\tlist repository tags\\n\22\0A            case tip\0A                # deprecated\0A            case unbundle\0A                printf \22$command\\tapply one or more bundle files\\n\22\0A            case unshelve\0A                printf \22$command\\trestore a shelved change to the working directory\\n\22\0A            case update\0A                printf \22$command\\tupdate working directory (or switch revisions)\\n\22\0A            case verify\0A                printf \22$command\\tverify the integrity of the repository\\n\22\0A            case version\0A                printf \22$command\\toutput version and copyright information\\n\22\0A            case view\0A                printf \22$command\\tstart interactive history viewer\\n\22\0A            case \22*\22\0A                printf \22$command\\n\22\0A        end\0A    end\0Aend\0A\0Afunction __fish_hg_labels\0A    if set -l labels (__fish_hg debuglabelcomplete)\0A        printf \22%s\\tlabel\\n\22 $labels\0A    else\0A        __fish_hg_branches\0A        __fish_hg_bookmarks\0A        for line in (__fish_hg tags)\0A            set -l parts (string split \22 \22 -m 1 $line)\0A            printf \22%s\\ttag\\n\22 $parts[1]\0A        end\0A    end\0Aend\0A\0Afunction __fish_hg_help_topics\0A    set -l commands (__fish_hg debugcomplete)\0A    printf \22%s\\tcommand\\n\22 $commands\0A    for line in (__fish_hg help | string match -re '^ [a-zA-Z]')\0A        set -l parts (string trim $line | string split \22 \22 -m 1)\0A        set -l topic $parts[1]\0A        if not contains $topic $commands\0A            printf \22%s\\thelp topic\\n\22 $topic\0A        end\0A    end\0Aend\0A\0Afunction __fish_hg_config_entries\0A    for line in (__fish_hg config)\0A        set -l parts (string split = -m 1 $line)\0A        printf \22%s\\tconfig entry\\n\22 $parts[1]\0A    end\0Aend\0A\0Afunction __fish_hg_patches\0A    printf \22%s\\tpatch\\n\22 (__fish_hg qseries)\0Aend\0A\0Afunction __fish_hg_patch_queues\0A    for line in (__fish_hg qqueue)\0A        set -l parts (string split \22(\22 -m 1 $line)\0A        set -l queue (string trim $parts[1])\0A        printf \22%s\\tpatch queue\\n\22 $queue\0A    end\0Aend\0A\0Afunction __fish_hg_status\0A    set -l token (commandline -ct)\0A    __fish_hg status -n $argv \22glob:$token**\22\0Aend\0A\0Afunction __fish_hg_locate\0A    __fish_hg locate $argv\0Aend\0A\0Afunction __fish_hg_bookmarks\0A    set -l bookmarks (__fish_hg bookmarks)\0A    if string match -q -- \22no bookmarks set\22 \22$bookmarks[1]\22\0A        return\0A    end\0A    for line in $bookmarks\0A        # Bookmarks can contain lots of different characters, including spaces,\0A        # but they can't contain colons.  So we use that to split the line.\0A        set -l parts (string sub -s 4 $line | string split \22:\22 -m 1)\0A        set -l parts (string split \22 \22 -r -m 1 $parts[1])\0A        set -l bookmark (string trim $parts[1])\0A        printf \22%s\\tbookmark\\n\22 $bookmark\0A    end\0Aend\0A\0Afunction __fish_hg_branches\0A    for line in (__fish_hg branches)\0A        # Like with bookmarks, branches can't contain colons, so we use that for\0A        # splitting.\0A        set -l parts (string split \22:\22 -m 1 $line)\0A        set -l parts (string split \22 \22 -r -m 1 $parts[1])\0A        set -l branch (string trim $parts[1])\0A        printf \22%s\\tbranch\\n\22 $branch\0A    end\0Aend\0A\0Afunction __fish_hg_merge_tools\0A    for tool in internal:dump internal:fail internal:forcedump internal:local internal:merge internal:merge-local internal:merge-other internal:merge3 internal:other internal:prompt internal:tagmerge internal:union\0A        printf \22$tool\\tmerge tool\\n\22\0A    end\0A    for line in (__fish_hg config merge-tools)\0A        set -l parts (string split \22.\22 -m 2 $line)\0A        printf \22%s\\tmerge tool\\n\22 $parts[2]\0A    end\0Aend\0A\0Afunction __fish_hg_sources\0A    for line in (__fish_hg paths)\0A        set -l parts (string split = $line)\0A        printf \22%s\\tsource\\n\22 (string trim $parts[1])\0A    end\0Aend\0A\0Afunction __fish_hg_shelves\0A    printf \22%s\\tshelve\\n\22 (__fish_hg shelve -ql)\0Aend\0A\0Afunction __fish_hg_mq_enabled\0A    if set -l line (__fish_hg config extensions.hgext.mq)\0A        set -l parts (string split \22=\22 -m 1 $line)\0A        not string match -r -q -- \22^!\22 $parts[2]\0A        return\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_hg_get_command\0A    set -l cmdline (commandline -pxc)\0A    set -e cmdline[1]\0A    set -l lasttoken \22\22\0A    for token in $cmdline\0A        # if the last token was a switch that takes an argument, we just skip\0A        # the current token\0A        if string match -r -q -- \22-R|--repository|--cwd|--config|--encoding|--encodingmode|--color|--pager\22 $lasttoken\0A            set lasttoken \22\22\0A            continue\0A        end\0A        # if the current token is a switch of any kind, we can skip it\0A        if string match -q -- \22-*\22 $token\0A            set lasttoken $token\0A            continue\0A        end\0A        # if we get to here, then we assume that the token is an hg command\0A        echo $token\0A        return 0\0A    end\0A    # no hg command was found\0A    return 1\0Aend\0A\0Afunction __fish_hg_using_command --argument-names cmd\0A    if set -l token (__fish_hg_get_command)\0A        string match -q -- $token $cmd\0A        return\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_hg_needs_command\0A    not __fish_hg_get_command >/dev/null\0Aend\0A\0A# global options\0Acomplete -c hg -s R -l repository -x -d \22repository root directory or name of overlay bundle file\22\0Acomplete -c hg -l cwd -x -a \22(__fish_complete_directories (commandline -ct))\22 -d \22change working directory\22\0Acomplete -c hg -s y -l noninteractive -d \22do not prompt, automatically pick the first choice for all prompts\22\0Acomplete -c hg -s q -l quiet -d \22suppress output\22\0Acomplete -c hg -s v -l verbose -d \22enable additional output\22\0Acomplete -c hg -l config -x -a \22(__fish_hg_config_entries)\22 -d \22set/override config option\22\0Acomplete -c hg -l debug -d \22enable debugging output\22\0Acomplete -c hg -l debugger -d \22start debugger\22\0Acomplete -c hg -l encoding -x -d \22set the charset encoding\22\0Acomplete -c hg -l encodingmode -x -d \22set the charset encoding mode\22\0Acomplete -c hg -l traceback -d \22always print a traceback on exception\22\0Acomplete -c hg -l time -d \22time how long the command takes\22\0Acomplete -c hg -l profile -d \22print command execution profile\22\0Acomplete -c hg -l version -d \22output version information and exit\22\0Acomplete -c hg -s h -l help -d \22display help and exit\22\0Acomplete -c hg -l hidden -d \22consider hidden changesets\22\0Acomplete -c hg -l color -x -a \22true false always auto never debug\22 -d \22when to colorize\22\0Acomplete -c hg -l pager -x -a \22true false always auto never\22 -d \22when to paginate\22\0A\0A# subcommands\0Acomplete -c hg -n __fish_hg_needs_command -x -a \22(__fish_hg_commands)\22\0A\0A# hg add\0Acomplete -c hg -n \22__fish_hg_using_command add\22 -f -a \22(__fish_hg_status -u)\22\0Acomplete -c hg -n \22__fish_hg_using_command add\22 -s I -l include -x -d \22include names matching the given patterns\22\0Acomplete -c hg -n \22__fish_hg_using_command add\22 -s X -l exclude -x -d \22exclude names matching the given patterns\22\0Acomplete -c hg -n \22__fish_hg_using_command add\22 -s S -l subrepos -d \22recurse into subrepositories\22\0Acomplete -c hg -n \22__fish_hg_using_command add\22 -s n -l dry-run -d \22do not perform actions, just print output\22\0Acomplete -c hg -n \22__fish_hg_using_command add; and __fish_hg_mq_enabled\22 -l mq -d \22operate on patch repository\22\0A\0A# hg addremove\0Afor cmd in addr addre addrem addremo addremov addremove\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -f -a \22(__fish_hg_status -ud)\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s s -l similarity -x -d \22guess renamed files by similarity (0<=s<=100)\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s S -l subrepos -d \22recurse into subrepositories\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s I -l include -x -d \22include names matching the given patterns\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s X -l exclude -x -d \22exclude names matching the given patterns\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s n -l dry-run -d \22do not perform actions, just print output\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd; and __fish_hg_mq_enabled\22 -l mq -d \22operate on patch repository\22\0Aend\0A\0A# hg annotate\0Afor cmd in an ann anno annot annota annotat annotate bl bla blam blame\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -x -a \22(__fish_hg_status -cmdr)\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s r -l rev -x -a \22(__fish_hg_labels)\22 -d \22annotate the specified revision\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -l no-follow -d \22don't follow copies and renames\22\0A    complete -c hg -n \22__fish_hg_using_command $cmd\22 -s a -l text -d \22treat all files a