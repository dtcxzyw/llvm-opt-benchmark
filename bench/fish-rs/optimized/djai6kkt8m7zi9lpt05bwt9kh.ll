omplete -c gem -n __fish_use_subcommand -xa uninstall -d \22Uninstall a gem from the local repository\22\0Acomplete -c gem -n __fish_use_subcommand -xa unpack -d \22Unpack an installed gem to the current directory\22\0Acomplete -c gem -n __fish_use_subcommand -xa update -d \22Update the named gem or all installed gems in the local repository\22\0A\0A#####\0A# Subcommand switches\0A\0A# common opts\0Aset -l common_opt -c gem -n 'not __fish_use_subcommand'\0Acomplete $common_opt -l source -d \22Use URL as the remote source for gems\22 -x\0Acomplete $common_opt -s p -l http-proxy -d \22Use the given HTTP proxy for remote operations\22 -x\0Acomplete $common_opt -l no-http-proxy -d \22Use no HTTP proxy for remote operations\22\0Acomplete $common_opt -s h -l help -d \22Get help on this command\22\0Acomplete $common_opt -s v -l verbose -d \22Set the verbose level of output\22\0Acomplete $common_opt -l config-file -d \22Use this config file instead of default\22 -x\0Acomplete $common_opt -l backtrace -d \22Show stack backtrace on errors\22\0Acomplete $common_opt -l debug -d \22Turn on Ruby debugging\22\0A\0A##\0A# cert\0Aset -l cert_opt -c gem -n 'contains cert (commandline -pxc)'\0Acomplete $cert_opt -s a -l add -d \22Add a trusted certificate\22 -x\0Acomplete $cert_opt -s l -l list -d \22List trusted certificates\22\0Acomplete $cert_opt -s r -l remove -d \22Remove trusted certificates containing STRING\22 -x\0Acomplete $cert_opt -s b -l build -d \22Build private key and self-signed certificate for EMAIL_ADDR\22 -x\0Acomplete $cert_opt -s C -l certificate -d \22Certificate for --sign command\22 -x\0Acomplete $cert_opt -s K -l private-key -d \22Private key for --sign command\22 -x\0Acomplete $cert_opt -s s -l sign -d \22Sign a certificate with my key and certificate\22 -x\0A\0A##\0A# check\0Aset -l check_opt -c gem -n 'contains check (commandline -pxc)'\0Acomplete $check_opt -s v -l verify -d \22Verify gem file against its internal checksum\22 -x\0Acomplete $check_opt -s a -l alien -d \22Report 'unmanaged' or rogue files in the gem repository\22\0Acomplete $check_opt -s t -l test -d \22Run unit tests for gem\22\0Acomplete $check_opt -s V -l version -d \22Specify version for which to run unit tests\22\0A\0A##\0A# cleanup\0Aset -l cleanup_opt -c gem -n 'contains cleanup (commandline -pxc)'\0Acomplete $cleanup_opt -s d -l dryrun -d \22Don't really cleanup\22\0A\0A##\0A# contents\0Aset -l contents_opt -c gem -n 'contains contents (commandline -pxc)'\0Acomplete $contents_opt -s l -l list -d \22List the files inside a Gem\22\0Acomplete $contents_opt -s V -l version -d \22Specify version for gem to view\22\0Acomplete $contents_opt -s s -l spec-dir -d \22Search for gems under specific paths\22 -x\0Acomplete $contents_opt -s v -l verbose -d \22Be verbose when showing status\22\0A\0A##\0A# dependency\0Aset -l dep_opt -c gem -n 'contains dependency (commandline -pxc)'\0Acomplete $dep_opt -s v -l version -d \22Specify version of gem to uninstall\22 -x\0Acomplete $dep_opt -s r -l reverse-dependencies -d \22Include reverse dependencies in the output\22\0Acomplete $dep_opt -l no-reverse-dependencies -d \22Don't include reverse dependencies in the output\22\0Acomplete $dep_opt -s p -l pipe -d \22Pipe Format (name --version ver)\22\0A\0A##\0A# environment\0Aset -l env_opt -c gem -n 'contains environment (commandline -pxc)'\0Acomplete $env_opt -xa \22packageversion\\t'display the package version' gemdir\\t'display the path where gems are installed' gempath\\t'display path used to search for gems' version\\t'display the gem format version' remotesources\\t'display the remote gem servers'\22\0A\0Aset -l fetch_opt -c gem -n 'contains fetch (commandline -pxc)'\0Acomplete $fetch_opt -s v -l version -d \22Specify version of gem to download\22 -x\0A\0A##\0A# help\0Aset -l help_opt -c gem -n 'contains help (commandline -pxc)'\0Acomplete $help_opt -xa \22commands\\t'list all gem commands' examples\\t'show some examples of usage' build cert check cleanup contents dependency environment help install list query rdoc search specification uninstall unpack update\22\0A\0A##\0A# install\0Aset -l install_opt -c gem -n 'contains install (commandline -pxc)'\0Acomplete $install_opt -s v -l version -d \22Specify version of gem to install\22 -x\0Acomplete $install_opt -s l -l local -d \22Restrict operations to the LOCAL domain (default)\22\0Acomplete $install_opt -s r -l remote -d \22Restrict operations to the REMOTE domain\22\0Acomplete $install_opt -s b -l both -d \22Allow LOCAL and REMOTE operations\22\0Acomplete $install_opt -s i -l install-dir -d \22Gem repository directory to get installed gems\22 -x\0Acomplete $install_opt -s i -l user-install -d \22Install in user's home directory instead of GEM_HOME.\22\0Acomplete $install_opt -s N -l no-document -d \22Disable documentation generation on install\22\0Acomplete $install_opt -l document -a '(__fish_append , rdoc ri)' -d \22Specify the documentation types you wish to generate\22\0Acomplete $install_opt -s f -l force -d \22Force gem to install, bypassing dependency checks\22\0Acomplete $install_opt -l no-force -d \22Don't force gem to install, bypassing dependency checks\22\0Acomplete $install_opt -s t -l test -d \22Run unit tests prior to installation\22\0Acomplete $install_opt -l no-test -d \22Don't run unit tests prior to installation\22\0Acomplete $install_opt -s w -l wrappers -d \22Use bin wrappers for executables\22\0Acomplete $install_opt -l no-wrappers -d \22Don't use bin wrappers for executables\22\0Acomplete $install_opt -s P -l trust-policy -d \22Specify gem trust policy\22 -x\0Acomplete $install_opt -l ignore-dependencies -d \22Do not install any required dependent gems\22\0Acomplete $install_opt -s y -l include-dependencies -d \22Unconditionally install the required dependent gems\22\0A\0A##\0A# list\0Aset -l list_opt -c gem -n 'contains list (commandline -pxc)'\0Acomplete $list_opt -s d -l details -d \22Display detailed information of gem(s)\22\0Acomplete $list_opt -l no-details -d \22Don't display detailed information of gem(s)\22\0Acomplete $list_opt -s l -l local -d \22Restrict operations to the LOCAL domain (default)\22\0Acomplete $list_opt -s r -l remote -d \22Restrict operations to the REMOTE domain\22\0Acomplete $list_opt -s b -l both -d \22Allow LOCAL and REMOTE operations\22\0A\0A##\0A# query\0Aset -l query_opt -c gem -n 'contains query (commandline -pxc)'\0Acomplete $query_opt -s n -l name-matches -d \22Name of gem(s) to query on matches the provided REGEXP\22 -x\0Acomplete $query_opt -s d -l details -d \22Display detailed information of gem(s)\22\0Acomplete $query_opt -l no-details -d \22Don't display detailed information of gem(s)\22\0Acomplete $query_opt -s l -l local -d \22Restrict operations to the LOCAL domain (default)\22\0Acomplete $query_opt -s r -l remote -d \22Restrict operations to the REMOTE domain\22\0Acomplete $query_opt -s b -l both -d \22Allow LOCAL and REMOTE operations\22\0A\0A##\0A# rdoc\0Aset -l rdoc_opt -c gem -n 'contains rdoc (commandline -pxc)'\0Acomplete $rdoc_opt -l all -d \22Generate RDoc/RI documentation for all installed gems\22\0Acomplete $rdoc_opt -l rdoc -d \22Include RDoc generated documents\22\0Acomplete $rdoc_opt -l no-rdoc -d \22Don't include RDoc generated documents\22\0Acomplete $rdoc_opt -l ri -d \22Include RI generated documents\22\0Acomplete $rdoc_opt -l no-ri -d \22Don't include RI generated documents\22\0Acomplete $rdoc_opt -s v -l version -d \22Specify version of gem to rdoc\22 -x\0A\0A##\0A# search\0Aset -l search_opt -c gem -n 'contains search (commandline -pxc)'\0Acomplete $search_opt -s d -l details -d \22Display detailed information of gem(s)\22\0Acomplete $search_opt -l no-details -d \22Don't display detailed information of gem(s)\22\0Acomplete $search_opt -s l -l local -d \22Restrict operations to the LOCAL domain (default)\22\0Acomplete $search_opt -s r -l remote -d \22Restrict operations to the REMOTE domain\22\0Acomplete $search_opt -s b -l both -d \22Allow LOCAL and REMOTE operations\22\0A\0A##\0A# specification\0Aset -l specification_opt -c gem -n 'contains specification (commandline -pxc)'\0Acomplete $specification_opt -s v -l version -d \22Specify version of gem to examine\22 -x\0Acomplete $specification_opt -s l -l local -d \22Restrict operations to the LOCAL domain (default)\22\0Acomplete $specification_opt -s r -l remote -d \22Restrict operations to the REMOTE domain\22\0Acomplete $specification_opt -s b -l both -d \22Allow LOCAL and REMOTE operations\22\0Acomplete $specification_opt -l all -d \22Output specifications for all versions of the gem\22\0A\0A##\0A# uninstall\0Aset -l uninstall_opt -c gem -n 'contains uninstall (commandline -pxc)'\0Acomplete $uninstall_opt -s a -l all -d \22Uninstall all matching versions\22\0Acomplete $uninstall_opt -l no-all -d \22Don't uninstall all matching versions\22\0Acomplete $uninstall_opt -s i -l ignore-dependencies -d \22Ignore dependency requirements while uninstalling\22\0Acomplete $uninstall_opt -l no-ignore-dependencies -d \22Don't ignore dependency requirements while uninstalling\22\0Acomplete $uninstall_opt -s x -l executables -d \22Uninstall applicable executables without confirmation\22\0Acomplete $uninstall_opt -l no-executables -d \22Don't uninstall applicable executables without confirmation\22\0Acomplete $uninstall_opt -s v -l version -d \22Specify version of gem to uninstall\22 -x\0A\0A##\0A# unpack\0Aset -l unpack_opt -c gem -n 'contains unpack (commandline -pxc)'\0Acomplete $unpack_opt -s v -l version -d \22Specify version of gem to unpack\22 -x\0A\0A##\0A# update\0Aset -l update_opt -c gem -n 'contains update (commandline -pxc)'\0Acomplete $update_opt -s i -l install-dir -d \22Gem repository directory to get installed gems\22\0Acomplete $update_opt -s N -l no-document -d \22Disable documentation generation on update\22\0Acomplete $update_opt -l document -a '(__fish_append , rdoc ri)' -d \22Specify the documentation types you wish to generate\22\0Acomplete $update_opt -s f -l force -d \22Force gem to install, bypassing dependency checks\22\0Acomplete $update_opt -l no-force -d \22Don't force gem to install, bypassing dependency checks\22\0Acomplete $update_opt -s t -l test -d \22Run unit tests prior to installation\22\0Acomplete $update_opt -l no-test -d \22Don't run unit tests prior to installation\22\0Acomplete $update_opt -s w -l wrappers -d \22Use bin wrappers for executables\22\0Acomplete $update_opt -l no-wrappers -d \22Don't use bin wrappers for executables\22\0Acomplete $update_opt -s P -l trust-policy -d \22Specify gem trust policy\22 -x\0Acomplete $update_opt -l ignore-dependencies -d \22Do not install any required dependent gems\22\0Acomplete $update_opt -s y -l include-dependencies -d \22Unconditionally install the required dependent gems\22\0Acomplete $update_opt -l system -d \22Update the RubyGems system software\22\0A", align 1
