@anon.1d0b41a8d45d477c3029ec78f9b8b434.2280 = private unnamed_addr constant [1291 x i8] c"# Pulseaudio's pacmd\0A# This covers the most useful commands\0Aset -l commands (pacmd help 2>/dev/null | string match -r '^ +[-\\w]+' | string trim)\0Acomplete -f -c pacmd\0Acomplete -f -c pacmd -w pactl\0A\0A# These descriptions are a bit wordy and unnecessary\0A# Sample: set-source-port Change the port of a source (args: index|name, port-name)\0A# Or: list-source-outputs List source outputs\0Acomplete -f -c pacmd -n \22not __fish_seen_subcommand_from $commands\22 -a \22(pacmd help 2>/dev/null | string match ' *' | string trim | string replace -r '\\s+' '\\t')\22\0A\0A# Since we wrapped pactl, we can also use functions defined there\0Acomplete -f -c pacmd -n \22__fish_seen_subcommand_from describe-module\22 -a '(__fish_pa_complete_type modules)'\0Acomplete -f -c pacmd -n \22__fish_seen_subcommand_from kill-client\22 -a '(__fish_pa_complete_type clients | string match -r \22^[0-9].*\22)' # match because this only takes an index\0A\0Afor t in client sink-input source-output\0A    complete -f -c pacmd -n \22__fish_seen_subcommand_from kill-$t\22 -a '(__fish_pa_complete_type '$t's | string match -r \22^[0-9].*\22)' # match because this only takes an index\0Aend\0A\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from suspend\22 -a '0 false off' -d Resume\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from suspend\22 -a '1 true on' -d Suspend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2281 = private unnamed_addr constant [22 x i8] c"completions/pactl.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2282 = private unnamed_addr constant [7196 x i8] c"# The control program for pulseaudio\0A# See not just pactl(1) but also pulse-cli-syntax(1)\0A# Note: Streams are called \22sink-input\22 (for playback) and \22source-output\22 (for recording)\0A\0A# TODO: Moar commands\0A# set-port-latency-offset set-sink-formats\0A\0A# These are the actual commands for pactl - we complete only these, and then the cmd commands in that completion\0Aset -l ctlcommands stat info list exit {upload,play,remove}-sample {load,unload}-module \\\0A    move-{sink-input,source-output} suspend-{sink,source} set-{card-profile,default-sink,sink-port,source-port,port-latency-offset} \\\0A    set-{sink,source,sink-input,source-output}-{volume,mute} set-sink-formats subscribe\0A\0A# HACK: This is the list of commands from pacmd - used so we can use complete -w there\0Aif command -sq pacmd\0A    set commands (pacmd help 2>/dev/null | string match -r '^ +[-\\w]+' | string trim)\0Aelse\0A    set commands $ctlcommands\0Aend\0A\0Afunction __fish_pa_complete_type\0A    # Print a completion candidate for the object type (like \22card\22 or \22sink\22),\0A    # with a description.\0A    # Pa allows both a numerical index and a name\0A    pactl list short $argv | string replace -rf '(\\d+)\\s+(\\S+)(\\s+.*)?' '$2\\t$1$3\\n$1\\t$2$3'\0Aend\0A\0Afunction __fish_pa_print_type\0A    # Print just the object, without description\0A    __fish_pa_complete_type $argv | string replace -r '\\t.*' ''\0Aend\0A\0Afunction __fish_pa_list_ports\0A    # Yes, this is localized\0A    env LC_ALL=C pactl list cards 2>/dev/null | sed -n -e '/Ports:/,$p' | string match -r '^\\t\\t\\w.*$' | string replace -r '\\s+([-+\\w:]+): (\\w.+)' '$1\\t$2'\0Aend\0A\0Afunction __fish_pa_list_profiles\0A    env LC_ALL=C pactl list cards 2>/dev/null | sed -n -e '/Profiles:/,/Active Profile/p' | string match -r '\\t\\t.*' | string replace -r '\\s+([-+\\w:]+): (\\w.+)' '$1\\t$2'\0Aend\0A\0A# This is needed to filter out loaded modules\0Afunction __fish_pa_complete_unloaded_modules\0A    if command -sq pulseaudio\0A        # We need to get just the module names\0A        set -l loaded (__fish_pa_print_type modules | string replace -r '^\\w*\\t([-\\w]+).*' '$1')\0A        pulseaudio --dump-modules | while read -l name description\0A            # This is a potential source of slowness, but on my system it's instantaneous\0A            # with 73 modules\0A            if not contains -- $name $loaded\0A                printf \22%s\\t%s\\n\22 $name $description\0A            end\0A        end\0A    end\0Aend\0A\0Acomplete -f -c pactl\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a \22$ctlcommands\22\0A\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a stat -d 'Show statistics about memory usage'\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a info -d 'Show info about the daemon'\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a list -d 'Show all loaded things of the specified type'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from list\22 -a \22modules sinks sources sink-inputs source-outputs clients samples cards\22\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from list\22 -a short -d \22Show shorter output\22\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a exit -d 'Ask the daemon to exit'\0A\0Acomplete -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a upload-sample -d 'Upload a file to the sample cache'\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a play-sample -d 'Play a sample from the cache'\0Acomplete -f -c pactl -n \22not __fish_seen_subcommand_from $commands\22 -a remove-sample -d 'Remove a sample from the cache'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from play-sample remove-sample\22 -a '(__fish_pa_complete_type samples)'\0A\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from unload-module\22 -a '(__fish_pa_complete_type modules)'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from load-module\22 -a '(__fish_pa_complete_unloaded_modules)'\0A\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from move-sink-input; and not __fish_seen_subcommand_from (__fish_pa_print_type sink-inputs)\22 \\\0A    -a '(__fish_pa_complete_type sink-inputs)'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from move-sink-input; and __fish_seen_subcommand_from (__fish_pa_print_type sink-inputs)\22 \\\0A    -a '(__fish_pa_complete_type sinks)'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from move-source-output; and not __fish_seen_subcommand_from (__fish_pa_print_type source-outputs)\22 \\\0A    -a '(__fish_pa_complete_type source-outputs)'\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from move-source-output; and __fish_seen_subcommand_from (__fish_pa_print_type source-outputs)\22 \\\0A    -a '(__fish_pa_complete_type sources)'\0A\0A# Suspend\0Afor t in source sink\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from suspend-$t; and not __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(__fish_pa_complete_type \22$t\22s)\22\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from suspend-$t; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a '0 false off' -d Resume\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from suspend-$t; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a '1 true on' -d Suspend\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-port; and not __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(__fish_pa_complete_type \22$t\22s)\22\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-port; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(__fish_pa_list_ports)\22\0Aend\0A\0A# Volume and mute\0Afor t in source sink source-output sink-input\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-volume; and not __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(__fish_pa_complete_type \22$t\22s)\22\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-volume; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(seq 0 100)%\22\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-mute; and not __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \22(__fish_pa_complete_type \22$t\22s)\22\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-mute; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \221 true on\22 -d Muted\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-mute; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a \220 false off\22 -d Unmuted\0A    complete -f -c pactl -n \22__fish_seen_subcommand_from set-$t-mute; and __fish_seen_subcommand_from (__fish_pa_print_type \22$t\22s)\22 \\\0A        -a toggle\0Aend\0A\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from set-card-profile; and not __fish_seen_subcommand_from (__fish_pa_print_type cards)\22 \\\0A    -a \22(__fish_pa_complete_type cards)\22\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from set-card-profile; and __fish_seen_subcommand_from (__fish_pa_print_type cards)\22 \\\0A    -a \22(__fish_pa_list_profiles)\22\0A\0Acomplete -f -c pactl -n \22__fish_seen_subcommand_from set-default-sink\22 -a \22(__fish_pa_complete_type sinks)\22\0A\0Acomplete -f -c pactl -l version -d 'Print a short version and exit'\0Acomplete -f -c pactl -s h -l help -d 'Print help text and exit'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2283 = private unnamed_addr constant [24 x i8] c"completions/pactree.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2284 = private unnamed_addr constant [808 x i8] c"complete -c pactree -xa \22(__fish_print_pacman_packages --installed)\22\0Acomplete -c pactree -s b -l dbpath -d 'Set an alternate database location' -xa '(__fish_complete_directories)'\0Acomplete -c pactree -s c -l color -d 'Colorize output'\0Acomplete -c pactree -s d -l depth -d 'Limit the depth of recursion' -x\0Acomplete -c pactree -s g -l graph -d 'Generate output for graphviz\\'s dot'\0Acomplete -c pactree -s h -l help -d 'Display this help message'\0Acomplete -c pactree -s l -l linear -d 'Enable linear output'\0Acomplete -c pactree -s r -l reverse -d 'Show reverse dependencies'\0Acomplete -c pactree -s s -l sync -d 'Search sync DBs instead of local'\0Acomplete -c pactree -s u -l unique -d 'Show dependencies with no duplicates (implies -l)'\0Acomplete -c pactree -l config -d 'Set an alternate configuration file' -r\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2285 = private unnamed_addr constant [23 x i8] c"completions/pandoc.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2286 = private unnamed_addr constant [5556 x i8] c"# Pandoc completions written by David Sanson\0A# Copyright (c) 2018 David Sanson\0A# Licensed under the GNU General Public License version 2\0A\0Aset -l informats (pandoc --list-input-formats)\0Aset -l outformats (pandoc --list-output-formats)\0Aset -l highlight_styles (pandoc --list-highlight-styles)\0Aset -l datadir $HOME/.pandoc\0A\0A# Only suggest installed engines\0Aset -l pdfengines\0Afor engine in pdflatex lualatex xelatex latexmk tectonic wkhtmltopdf weasyprint pagedjs-cli prince context pdfroff\0A    if type -q $engine\0A        set pdfengines $pdfengines $engine\0A    end\0Aend\0A\0A# options that take no arguments\0Acomplete -c pandoc -s p -l preserve-tabs\0Acomplete -c pandoc -l file-scope\0Acomplete -c pandoc -s s -l standalone\0Acomplete -c pandoc -l strip-comments\0Acomplete -c pandoc -l toc -l table-of-contents\0Acomplete -c pandoc -l no-highlight\0Acomplete -c pandoc -l self-contained\0Acomplete -c pandoc -l html-q-tags\0Acomplete -c pandoc -l ascii\0Acomplete -c pandoc -l reference-links\0Acomplete -c pandoc -l atx-headers\0Acomplete -c pandoc -s N -l number-sections\0Acomplete -c pandoc -l listings\0Acomplete -c pandoc -s i -l incremental\0Acomplete -c pandoc -l section-divs\0Acomplete -c pandoc -l natbib -l biblatex\0Acomplete -c pandoc -l dump-args\0Acomplete -c pandoc -l ignore-args\0Acomplete -c pandoc -l verbose\0Acomplete -c pandoc -l quiet\0Acomplete -c pandoc -l fail-if-warnings\0Acomplete -c pandoc -l bash-completion\0Acomplete -c pandoc -l list-input-formats\0Acomplete -c pandoc -l list-output-formats\0Acomplete -c pandoc -l list-extensions\0Acomplete -c pandoc -l list-highlight-languages\0Acomplete -c pandoc -l list-highlight-styles\0Acomplete -c pandoc -s v -l version\0Acomplete -c pandoc -s h -l help\0A\0A# options that complete URLs\0Acomplete -c pandoc -x -l mathml -l webtex -l mathjax -l katex\0Acomplete -c pandoc -x -l katex-stylesheet -s m -l latexmathml\0Acomplete -c pandoc -x -l asciimathml -l mimetex -l jsmath -l gladtex\0Acomplete -c pandoc -x -s c -l css\0A\0A# options that use informats and outformats\0Acomplete -c pandoc -x -s f -s r -l from -l read -a \22$informats\22\0Acomplete -c pandoc -x -s t -s w -l to -l write -a \22$outformats\22\0Acomplete -c pandoc -x -s D -l print-default-template -a \22$outformats\22\0A\0A# TODO: add support for enabling and disabling extensions using the +/- switches\0A\0A# options that take directories\0Acomplete -c pandoc -x -l data-dir -a \22(__fish_complete_directories (commandline -ct) \22\22)\22\0Acomplete -c pandoc -x -l extract-media -a \22(__fish_complete_directories (commandline -ct) \22\22)\22\0A\0A# options that take files\0Acomplete -c pandoc -r -s o -l output\0Acomplete -c pandoc -r -s F -l filter\0Acomplete -c pandoc -r -l template\0Acomplete -c pandoc -r -l syntax-definition\0Acomplete -c pandoc -r -s H -l include-in-header\0Acomplete -c pandoc -r -s B -l include-before-body\0Acomplete -c pandoc -r -s A -l include-after-body\0Acomplete -c pandoc -r -l abbreviations\0Acomplete -c pandoc -r -l log\0Acomplete -c pandoc -r -l epub-cover-image\0Acomplete -c pandoc -r -l epub-metadata\0Acomplete -c pandoc -r -l epub-embed-font\0Acomplete -c pandoc -r -l citation-abbreviations\0A\0A# options that take files filtered by extension\0A\0Acomplete -c pandoc -r -f -l print-highlight-style -k -a \22(__fish_complete_suffix 'theme' )\22\0Acomplete -c pandoc -r -f -l highlight_style -k -a \22(__fish_complete_suffix 'theme' )\22\0Acomplete -c pandoc -r -f -l csl -k -a \22(__fish_complete_suffix 'csl'   )\22\0Acomplete -c pandoc -r -f -l reference-file -k -a \22(__fish_complete_suffix 'odt' 'docx')\22\0Acomplete -c pandoc -r -f -l bibliography -k -a \22(__fish_complete_suffix 'bib' 'bibtex' 'copac' 'json' 'yaml' 'enl' 'xml' 'wos' 'medline' 'mods' 'ria')\22\0Acomplete -c pandoc -r -f -l lua-filter -k -a \22(__fish_complete_suffix 'lua')\22\0A\0A# options that take files in DATADIR\0Acomplete -c pandoc -r -s F -l filter -a \22(find $datadir/filters -type f 2>/dev/null | string replace -- '$datadir/filters/' '')\22\0Acomplete -c pandoc -r -l template -a \22(find $datadir/templates -type f 2>/dev/null | string replace -- '$datadir/templates/' '')\22\0Acomplete -c pandoc -r -f -l lua-filter -a \22(find $datadir -type f 2>/dev/null | string match -r '.lua\\$' | string replace -- '$datadir/' '')\22\0A\0A# options that require arguments which cannot be autocompleted\0Acomplete -c pandoc -x -l indented-code-classes\0Acomplete -c pandoc -x -s M -l metadata\0Acomplete -c pandoc -x -s V -l variable\0Acomplete -c pandoc -x -l dpi\0Acomplete -c pandoc -x -l columns\0Acomplete -c pandoc -r -l resource-path\0Acomplete -c pandoc -x -l request-header\0Acomplete -c pandoc -x -l number-offset\0Acomplete -c pandoc -x -l id-prefix\0Acomplete -c pandoc -x -s T -l title-prefix\0Acomplete -c pandoc -x -l epub-subdirectory\0Acomplete -c pandoc -x -l pdf-engine-opt\0A\0A# options that take their own arguments\0A\0Acomplete -c pandoc -x -l default-image-extension -a 'jpg png pdf svg gif'\0Acomplete -c pandoc -x -l base-header-level -a \221 2 3 4 5\22\0Acomplete -c pandoc -x -l toc-depth -l slide-level -l epub-chapter-level -a \221 2 3 4 5 6\22\0Acomplete -c pandoc -x -l tab-stop -a \221 2 3 4 5 6 7 8\22\0Acomplete -c pandoc -x -l track-changes -a \22accept reject all\22\0Acomplete -c pandoc -x -l print-default-data-file -a \22reference.odt reference.docx\22\0Acomplete -c pandoc -x -l print-highlight-style -l highlight-style -a \22$highlight_styles\22\0Acomplete -c pandoc -x -l eol -a \22crlf lf native\22\0Acomplete -c pandoc -x -l wrap -a \22auto none preserve\22\0Acomplete -c pandoc -x -l reference-location -a \22block section document\22\0Acomplete -c pandoc -x -l top-level-division -a \22default section chapter part\22\0Acomplete -c pandoc -x -l email-obfuscation -a \22none javascript references\22\0Acomplete -c pandoc -x -l pdf-engine -a \22$pdfengines\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2287 = private unnamed_addr constant [23 x i8] c"completions/passwd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2288 = private unnamed_addr constant [2711 x i8] c"# Completions for passwd\0A\0Afunction __fish_passwd_darwin_infosystem\0A    echo -e \22PAM\\tPluggable Authentication Module\22\0A    echo -e \22opendirectory\\tOpen Directory-compatible system\22\0A    echo -e \22file\\tLocal flat-file\22\0A    echo -e \22nis\\tRemote NIS server\22\0Aend\0A\0Aif passwd --help >/dev/null 2>&1\0A    complete -c passwd -n '__fish_contains_opt -s S status' -s a -l all -f -d \22Display password state for all users\22\0A    complete -c passwd -s d -l delete -f -d \22Delete user password\22\0A    complete -c passwd -s e -l expire -f -d \22Immediately obsolete user password\22\0A    complete -c passwd -s h -l help -f -d \22Display help and exit\22\0A    complete -c passwd -s i -l inactive -x -d \22Schedule account inactivation after password expiration\22\0A    complete -c passwd -s k -l keep-tokens -f -d \22Wait tokens expiration before changing password\22\0A    complete -c passwd -s l -l lock -f -d \22Lock password\22\0A    complete -c passwd -s n -l mindays -x -d \22Define minimum delay between password changes\22\0A    complete -c passwd -s q -l quiet -f -d \22Be quiet\22\0A    complete -c passwd -s r -l repository -r -d \22Update given repository\22\0A    complete -c passwd -s R -l root -r -d \22Use given directory as working directory\22\0A    complete -c passwd -s S -l status -f -d \22Display account status\22\0A    complete -c passwd -s u -l unlock -f -d \22Unlock password\22\0A    complete -c passwd -s w -l warndays -x -d \22Define warning period before mandatory password change\22\0A    complete -c passwd -s w -l warndays -x -d \22Define maximum period of password validity\22\0A    complete -c passwd -n '__fish_not_contain_opt -s A all' -f -a '(__fish_complete_users)' -d \22Account to be altered\22\0Aelse # Not Linux, so let's see what it is, with the ugly uname\0A    set -l os_type (uname)\0A    switch $os_type\0A        case Darwin # macOS family\0A            complete -c passwd -f -a '(__fish_complete_users)' -d \22Account to be altered\22\0A            complete -c passwd -x -s i -a '(__fish_passwd_darwin_infosystem)' -d \22Directory system to apply the update to\22\0A            complete -c passwd -x -s l -d \22Location to be updated on chosen directory system\22\0A            complete -c passwd -x -s u -d \22User name to use on chosen directory system\22\0A        case FreeBSD\0A            complete -c passwd -f -s l -d \22Update locally, not in Kerberos\22\0A            complete -c passwd -f -a '(__fish_complete_users)' -d \22Account to be altered\22\0A    end\0A    # This is common to Darwin, FreeBSD and OpenBSD, and is even the only possible completion under OpenBSD\0A    # This is separated from Linux completions, because the Linux one is useless with -A / --all,\0A    # whereas -A / --all does not exist under *BSD\0A    complete -c passwd -f -a '(__fish_complete_users)' -d \22Account to be altered\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2289 = private unnamed_addr constant [22 x i8] c"completions/patch.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2290 = private unnamed_addr constant [3281 x i8] c"#\0A# Completions for GNU patch\0A# TODO: POSIX patch\0A#\0A\0A\0A# No effect on POSIX systems that don't use O_BINARY/O_TEXT\0Auname -s | string match -q CYGWIN\\*\0Aand complete -c patch -l binary -d \22Read & write data in binary mode\22\0A\0Acomplete -c patch -s b -l backup -d \22Back up the original contents of each file\22\0Acomplete -c patch -l backup-if-mismatch -d \22Back up files if patch doesn't match exactly\22\0Acomplete -c patch -l no-backup-if-mismatch -d \22Don't back up for mismatching patches\22\0Acomplete -c patch -s B -l prefix -x -d \22Prepend PREFIX to backup filenames\22\0Acomplete -c patch -s c -l context -d \22Interpret patch as context diff\22\0Acomplete -c patch -s d -l directory -xa '(__fish_complete_directories (commandline -ct))' -d \22Change directory to DIR first\22\0Acomplete -c patch -s D -l ifdef -x -d \22Make merged if-then-else output using NAME\22\0Acomplete -c patch -l dry-run -d \22Don't change files; just print what would happen\22\0Acomplete -c patch -s e -l ed -d \22Interpret patch as an 'ed' script\22\0Acomplete -c patch -s E -l remove-empty-files -d \22Remove output files empty after patching\22\0Acomplete -c patch -s f -l force -d \22Like -t, but ignore bad-Prereq patches, assume unreversed\22\0Acomplete -c patch -s F -l fuzz -x -d \22Number of LINES for inexact 'fuzzy' matching\22 -a \22(seq 0 9){\\tfuzz lines}\22\0Acomplete -c patch -s g -l get -x -d \22Get files from RCS etc. if positive; ask if negative\22 -a '(seq -1 1){\\t\\n}'\0Acomplete -c patch -l help -f -d \22Display help\22\0Acomplete -c patch -s i -l input -x -d \22Read patch from FILE instead of stdin\22 -k -a \22( __fish_complete_suffix .patch .diff)\22\0Acomplete -c patch -s l -l ignore-whitespace -d \22Ignore whitespace changes between patch & input\22\0Acomplete -c patch -s n -l normal -d \22Interpret patch as normal diff\22\0Acomplete -c patch -s N -l forward -d \22Ignore patches that seem reversed or already applied\22\0Acomplete -c patch -s o -l output -r -d \22Output patched files to FILE\22\0Acomplete -c patch -s p -l strip -x -d \22Strip NUM path components from filenames\22 -a \22(seq 0 9){\\t\\n}\22\0Acomplete -c patch -l posix -d \22Conform to the POSIX standard\22\0Acomplete -c patch -l quoting-style -x -d \22Output file names using quoting style\22 -a \22literal shell shell-always c escape\22\0Acomplete -c patch -s r -l reject-file -r -d \22Output rejects to FILE\22\0Acomplete -c patch -s R -l reverse -d \22Assume patches were created with old/new files swapped\22\0Acomplete -c patch -s s -l silent -l quiet -d \22Work silently unless an error occurs\22\0Acomplete -c patch -s t -l batch -d \22Ask no questions; skip bad-Prereq patches; assume reversed\22\0Acomplete -c patch -s T -l set-time -d \22Set times of patched files assuming diff uses local time\22\0Acomplete -c patch -s u -l unified -d \22Interpret patch file as a unified diff\22\0Acomplete -c patch -s v -l version -d \22Display version\22\0Acomplete -c patch -s V -l version-control -x -d \22Use method to determine backup file names\22 -a \22simple numbered existing\22\0Acomplete -c patch -l verbose -d \22Output extra information about work being done\22\0Acomplete -c patch -s x -l debug -x -d \22Set internal debugging flags\22\0Acomplete -c patch -s Y -l basename-prefix -x -d \22Prepend PREFIX to backup file basenames\22\0Acomplete -c patch -s z -l suffix -x -d \22Append SUFFIX to backup file name\22\0Acomplete -c patch -s Z -l set-utc -d \22Set times of patched files assuming diff uses UTC\22\0A", align 1
