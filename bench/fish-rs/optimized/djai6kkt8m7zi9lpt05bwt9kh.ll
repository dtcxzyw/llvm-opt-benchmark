@anon.1d0b41a8d45d477c3029ec78f9b8b434.1632 = private unnamed_addr constant [3096 x i8] c"# X11 options\0Acomplete -c firefox -l display -r -d \22X display to use\22\0Acomplete -c firefox -l sync -d \22Make X calls synchronous\22\0Acomplete -c firefox -l g-fatal-warnings -d \22Make all warnings fatal\22\0A\0A# Firefox options\0Acomplete -c firefox -s h -l help -d \22Print this message\22\0Acomplete -c firefox -s v -l version -d \22Print Firefox version\22\0Acomplete -c firefox -l full-version -d \22Print Firefox version, build and platform build ids\22\0Acomplete -c firefox -s P -r -d \22Start this profile\22 -fa '(string replace -rf \22^Name=(.*)\22 \\'$1\\' < ~/.mozilla/firefox/profiles.ini)'\0Acomplete -c firefox -l profile -r -d \22Start with profile at <path>\22\0Acomplete -c firefox -l migration -d \22Start with migration wizard\22\0Acomplete -c firefox -l ProfileManager -d \22Start with ProfileManager\22\0Acomplete -c firefox -l no-remote -d \22Do not accept or send remote commands implies --new-instance\22\0Acomplete -c firefox -l new-instance -d \22Open new instance, not a new window in running instance\22\0Acomplete -c firefox -l safe-mode -d \22Disables extensions and themes for this session\22\0Acomplete -c firefox -l allow-downgrade -d \22Allows downgrading a profile\22\0Acomplete -c firefox -l MOZ_LOG -rf -d \22Treated as MOZ_LOG=<modules> environment variable, overrides it\22\0Acomplete -c firefox -l MOZ_LOG_FILE -r -d \22Treated as MOZ_LOG_FILE=<file> environment variable, overrides it\22\0Acomplete -c firefox -l headless -d \22Run without a GUI\22\0Acomplete -c firefox -l jsdebugger -d \22Open the Browser Toolbox\22\0Acomplete -c firefox -l wait-for-jsdebugger -d \22Spin event loop until JS debugger connects\22\0Acomplete -c firefox -l start-debugger-server -d \22Start the devtools server on a TCP port or Unix domain socket path\22\0Acomplete -c firefox -l browser -d \22Open a browser window\22\0Acomplete -c firefox -l new-window -r -d \22Open <url> in a new window\22\0Acomplete -c firefox -l new-tab -r -d \22Open <url> in a new tab\22\0Acomplete -c firefox -l private-window -r -d \22Open <url> in a new private window\22\0Acomplete -c firefox -l preferences -d \22Open Preferences dialog\22\0Acomplete -c firefox -l screenshot -d \22Save screenshot to <path> or in working directory\22\0Acomplete -c firefox -rf -l window-size -d \22Width and optionally height of screenshot\22\0Acomplete -c firefox -l search -r -d \22Search <term> with your default search engine\22\0Acomplete -c firefox -l setDefaultBrowser -d \22Set this app as the default browser\22\0Acomplete -c firefox -l first-startup -d \22Run post-install actions before opening a new window\22\0Acomplete -c firefox -l kiosk -d \22Start the browser in kiosk mode\22\0Acomplete -c firefox -l disable-pinch -d \22Disable touch-screen and touch-pad pinch gestures\22\0Acomplete -c firefox -l jsconsole -d \22Open the Browser Console\22\0Acomplete -c firefox -l devtools -d \22Open DevTools on initial load\22\0Acomplete -c firefox -l marionette -d \22Enable remote control server\22\0Acomplete -c firefox -f -l remote-debugging-port -d \22Start the Firefox Remote Agent\22\0Acomplete -c firefox -f -l remote-allow-hosts -r -d \22Values of the Host header to allow for incoming requests\22\0Acomplete -c firefox -f -l remote-allow-origins -r -d \22Values of the Origin header to allow for incoming requests\22\0A", align 1
