@anon.1d0b41a8d45d477c3029ec78f9b8b434.1278 = private unnamed_addr constant [1636 x i8] c"# Caddy is a general-purpose HTTP/2 web server that serves HTTPS by default.\0A# https://caddyserver.com\0A\0Acomplete -c caddy -o agree -d \22Agree to the CA's Subscriber Agreement\22\0Acomplete -c caddy -x -o ca -d \22URL to certificate authority's ACME server directory\22\0Acomplete -c caddy -x -o catimeout -d \22Default ACME CA HTTP timeout\22\0Acomplete -c caddy -r -o conf -a stdin -d \22Caddyfile to load\22\0Acomplete -c caddy -x -o cpu -d \22CPU cap\22\0Acomplete -c caddy -o disable-http-challenge -d \22Disable the ACME HTTP challenge\22\0Acomplete -c caddy -o disable-tls-sni-challenge -d \22Disable the ACME TLS-SNI challenge\22\0Acomplete -c caddy -x -o email -d \22Default ACME CA account email address\22\0Acomplete -c caddy -x -o grace -d \22Maximum duration of graceful shutdown\22\0Acomplete -c caddy -x -o host -d \22Default host\22\0Acomplete -c caddy -x -o http-port -d \22Default port to use for HTTP\22\0Acomplete -c caddy -o http2 -d \22Use HTTP/2\22\0Acomplete -c caddy -x -o https-port -d \22Default port to use for HTTPS\22\0Acomplete -c caddy -r -o log -d \22Process log file\22\0Acomplete -c caddy -r -o pidfile -d \22Path to write pid file\22\0Acomplete -c caddy -o plugins -d \22List installed plugins\22\0Acomplete -c caddy -x -o port -d \22Default port\22\0Acomplete -c caddy -o quic -d \22Use experimental QUIC\22\0Acomplete -c caddy -o quiet -d \22Quiet mode (no initialization output)\22\0Acomplete -c caddy -x -o revoke -d \22Hostname for which to revoke the certificate\22\0Acomplete -c caddy -r -o root -d \22Root path of default site\22\0Acomplete -c caddy -x -o type -d \22Type of server to run\22\0Acomplete -c caddy -o validate -d \22Parse the Caddyfile but do not start the server\22\0Acomplete -c caddy -o version -d \22Show version\22\0A", align 1
