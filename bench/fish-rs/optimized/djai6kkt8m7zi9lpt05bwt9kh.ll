@anon.1d0b41a8d45d477c3029ec78f9b8b434.1980 = private unnamed_addr constant [2440 x i8] c"# Completion for systemd's localectl\0Aset -l commands status set-locale list-locales set-keymap list-keymaps set-x11-keymap list-x11-keymap-{models,layouts,variants,options}\0A\0Acomplete -c localectl -f\0Afor cmd in $commands\0A    complete -c localectl -n \22not __fish_seen_subcommand_from $commands\22 -a $cmd\0Aend\0Aset -l localevars LANG LC_MESSAGES LC_{CTYPE,NUMERIC,TIME,COLLATE,MONETARY,MESSAGES,PAPER,NAME,ADDRESS,TELEPHONE,MEASUREMENT,IDENTIFICATION,ALL}\0Aset -l locales $localevars=(localectl list-locales 2>/dev/null)\0A\0Afunction __fish_localectl_layout\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    set -e cmd[1]\0A    for l in (localectl list-x11-keymap-layouts)\0A        if contains -- $l $cmd\0A            echo $l\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-locale\22 -a \22$locales\22\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-keymap\22 -a \22(localectl list-keymaps)\22\0A# set-x11-keymap takes layout model variant option... (i.e. multiple options)\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-x11-keymap; and not __fish_seen_subcommand_from (localectl list-x11-keymap-layouts)\22 -a \22(localectl list-x11-keymap-layouts)\22\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-x11-keymap; and __fish_seen_subcommand_from (localectl list-x11-keymap-layouts); and not __fish_seen_subcommand_from (localectl list-x11-keymap-models)\22 -a \22(localectl list-x11-keymap-models)\22\0A# Only complete variants for the current layout\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-x11-keymap; and __fish_seen_subcommand_from (localectl list-x11-keymap-models); and not __fish_seen_subcommand_from (localectl list-x11-keymap-variants)\22 -a \22(localectl list-x11-keymap-variants (__fish_localectl_layout))\22\0Acomplete -c localectl -n \22__fish_seen_subcommand_from set-x11-keymap; and __fish_seen_subcommand_from (localectl list-x11-keymap-variants)\22 -a \22(localectl list-x11-keymap-options)\22\0Acomplete -c localectl -l no-ask-password -d \22Don't ask for password\22\0Acomplete -c localectl -l no-convert -d \22Don't convert keymap from console to X11 and vice-versa\22\0Acomplete -c localectl -s H -l host -d 'Execute the operation on a remote host'\0Acomplete -c localectl -s h -l help -d 'Print a short help text and exit'\0Acomplete -c localectl -l version -d 'Print a short version string and exit'\0Acomplete -c localectl -l no-pager -d 'Do not pipe output into a pager'\0A", align 1
