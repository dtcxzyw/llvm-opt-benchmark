@anon.1d0b41a8d45d477c3029ec78f9b8b434.3577 = private unnamed_addr constant [609 x i8] c"# name: Simple Pythonista\0A# author: davbo\0A\0Afunction fish_prompt\0A    if not set -q VIRTUAL_ENV_DISABLE_PROMPT\0A        set -g VIRTUAL_ENV_DISABLE_PROMPT true\0A    end\0A    set_color yellow\0A    printf '%s' $USER\0A    set_color normal\0A    printf ' at '\0A\0A    set_color magenta\0A    echo -n (prompt_hostname)\0A    set_color normal\0A    printf ' in '\0A\0A    set_color $fish_color_cwd\0A    printf '%s' (prompt_pwd)\0A    set_color normal\0A\0A    # Line 2\0A    echo\0A    if test -n \22$VIRTUAL_ENV\22\0A        printf \22(%s) \22 (set_color blue)(path basename $VIRTUAL_ENV)(set_color normal)\0A    end\0A    printf '\E2\86\AA '\0A    set_color normal\0Aend\0A", align 1
