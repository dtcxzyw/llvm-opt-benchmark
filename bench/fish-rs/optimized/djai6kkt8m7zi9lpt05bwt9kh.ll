@anon.1d0b41a8d45d477c3029ec78f9b8b434.2548 = private unnamed_addr constant [11539 x i8] c"set -l subcmds \\\0A    show \\\0A    update \\\0A    default \\\0A    toolchain \\\0A    target \\\0A    component \\\0A    override \\\0A    run \\\0A    which \\\0A    doc \\\0A    man \\\0A    self \\\0A    set \\\0A    # \22completions\22 \\\0A    help\0A\0Aset -l rustup_show \\\0A    active-toolchain \\\0A    home \\\0A    profile \\\0A    help\0A\0A# rustup does not really expose a mechanism of retrieving a list of all valid components without the archs appended\0A# Just print the list of installable x86_64-unknown-linux-gnu components for everyone\0Afunction __rustup_components\0A    rustup component list | string match -r \22\\S+\22 | string replace -rf -- \22-x86_64-unknown-linux-gnu.*\22 \22\22 | sort -u\0Aend\0A\0Afunction __rustup_installed_components\0A    # If the user has supplied `--toolchain foo`, use it to filter the list\0A    set -l toolchain (commandline -j | string replace -rf \22.*\\s--toolchain\\s+(\\S+)\\s.*\22 '$1')\0A    set -l toolchain_filter\0A    if string match -qr . -- $toolchain\0A        set toolchain_filter \22--toolchain $toolchain\22\0A    end\0A\0A    rustup component list --installed $toolchain_filter | string replace -r -- (printf -- \22-%s\\n\22 (__rustup_targets) | string join \22|\22) \22\22 | sort -u\0A\0Aend\0A\0Afunction __rustup_installable_components\0A    comm -2 -3 (__rustup_components | psub -F) (__rustup_installed_components | psub -F)\0Aend\0A\0A# All *valid* target triples, retrieved from source\0Afunction __rustup_triples\0A    # The list below must be kept sorted alphabetically\0A    printf \22%s\\n\22 \\\0A        aarch64-apple-ios \\\0A        aarch64-linux-android \\\0A        aarch64-pc-windows-msvc \\\0A        aarch64-unknown-cloudabi \\\0A        aarch64-unknown-fuchsia \\\0A        aarch64-unknown-linux-gnu \\\0A        aarch64-unknown-linux-musl \\\0A        aarch64-unknown-redox \\\0A        armebv7r-none-eabi \\\0A        armebv7r-none-eabihf \\\0A        arm-linux-androideabi \\\0A        arm-unknown-linux-gnueabi \\\0A        arm-unknown-linux-gnueabihf \\\0A        arm-unknown-linux-musleabi \\\0A        arm-unknown-linux-musleabihf \\\0A        armv5te-unknown-linux-gnueabi \\\0A        armv5te-unknown-linux-musleabi \\\0A        armv7-apple-ios \\\0A        armv7-linux-androideabi \\\0A        armv7r-none-eabi \\\0A        armv7r-none-eabihf \\\0A        armv7s-apple-ios \\\0A        armv7-unknown-cloudabi-eabihf \\\0A        armv7-unknown-linux-gnueabi \\\0A        armv7-unknown-linux-gnueabihf \\\0A        armv7-unknown-linux-musleabi \\\0A        armv7-unknown-linux-musleabihf \\\0A        asmjs-unknown-emscripten \\\0A        i386-apple-ios \\\0A        i586-pc-windows-msvc \\\0A        i586-unknown-linux-gnu \\\0A        i586-unknown-linux-musl \\\0A        i686-apple-darwin \\\0A        i686-linux-android \\\0A        i686-pc-windows-gnu \\\0A        i686-pc-windows-msvc \\\0A        i686-unknown-cloudabi \\\0A        i686-unknown-freebsd \\\0A        i686-unknown-haiku \\\0A        i686-unknown-linux-gnu \\\0A        i686-unknown-linux-musl \\\0A        i686-unknown-netbsd \\\0A        le32-unknown-nacl \\\0A        mips64el-unknown-linux-gnuabi64 \\\0A        mips64-unknown-linux-gnuabi64 \\\0A        mipsel-unknown-linux-gnu \\\0A        mipsel-unknown-linux-musl \\\0A        mipsel-unknown-linux-uclibc \\\0A        mipsisa32r6el-unknown-linux-gnu \\\0A        mipsisa32r6-unknown-linux-gnu \\\0A        mipsisa64r6el-unknown-linux-gnuabi64 \\\0A        mipsisa64r6-unknown-linux-gnuabi64 \\\0A        mips-unknown-linux-gnu \\\0A        mips-unknown-linux-musl \\\0A        mips-unknown-linux-uclibc \\\0A        msp430-none-elf \\\0A        nvptx64-nvidia-cuda \\\0A        powerpc64le-unknown-linux-gnu \\\0A        powerpc64-unknown-linux-gnu \\\0A        powerpc-unknown-linux-gnu \\\0A        powerpc-unknown-linux-gnuspe \\\0A        riscv32imac-unknown-none-elf \\\0A        riscv32imc-unknown-none-elf \\\0A        riscv32i-unknown-none-elf \\\0A        riscv64gc-unknown-none-elf \\\0A        riscv64imac-unknown-none-elf \\\0A        s390x-unknown-linux-gnu \\\0A        sparc64-unknown-linux-gnu \\\0A        sparc64-unknown-netbsd \\\0A        sparc-unknown-linux-gnu \\\0A        sparcv9-sun-solaris \\\0A        thumbv6m-none-eabi \\\0A        thumbv7em-none-eabi \\\0A        thumbv7em-none-eabihf \\\0A        thumbv7m-none-eabi \\\0A        thumbv7neon-linux-androideabi \\\0A        thumbv7neon-unknown-linux-gnueabihf \\\0A        \22thumbv8m.base-none-eabi\22 \\\0A        \22thumbv8m.main-none-eabi\22 \\\0A        \22thumbv8m.main-none-eabihf\22 \\\0A        wasm32-unknown-emscripten \\\0A        wasm32-unknown-unknown \\\0A        x86_64-apple-darwin \\\0A        x86_64-apple-ios \\\0A        x86_64-fortanix-unknown-sgx \\\0A        x86_64-linux-android \\\0A        x86_64-pc-solaris \\\0A        x86_64-pc-windows-gnu \\\0A        x86_64-pc-windows-msvc \\\0A        x86_64-rumprun-netbsd \\\0A        x86_64-sun-solaris \\\0A        x86_64-unknown-bitrig \\\0A        x86_64-unknown-cloudabi \\\0A        x86_64-unknown-dragonfly \\\0A        x86_64-unknown-freebsd \\\0A        x86_64-unknown-fuchsia \\\0A        x86_64-unknown-haiku \\\0A        x86_64-unknown-linux-gnu \\\0A        x86_64-unknown-linux-gnux32 \\\0A        x86_64-unknown-linux-musl \\\0A        x86_64-unknown-netbsd \\\0A        x86_64-unknown-openbsd \\\0A        x86_64-unknown-redox\0Aend\0A\0A# Given n arguments, return the longest suffix common to all\0Afunction __rustup_common_suffix\0A    if test (count $argv) -le 1\0A        return\0A    end\0A\0A    set -l index -1\0A    set -l min_length 65335\0A    for arg in $argv\0A        if test (string length \22$arg\22) -lt $min_length\0A            set min_length (string length \22$arg\22)\0A        end\0A    end\0A\0A    set -l length 1\0A    set -l suffix\0A    set -l done 0\0A    while test $done -eq 0 -a $length -le $min_length\0A        set -l match (string match -r -- \22.{$length}\\$\22 \22$argv[1]\22)\0A        for arg in $argv[2..-1]\0A            set -l value (string match -r -- \22.{$length}\\$\22 \22$arg\22)\0A            if test \22$value\22 = \22$match\22\0A                continue\0A            else if string match -qr -- . \22$suffix\22\0A                set done 1\0A                break\0A            else\0A                # No common suffix\0A                return 1\0A            end\0A        end\0A        set suffix \22$match\22\0A        set length (math $length + 1)\0A    end\0A\0A    printf \22%s\\n\22 \22$suffix\22\0Aend\0A\0A# Strip result of __rustup_common_suffix\0Afunction __rustup_strip_common_suffix\0A    set -l suffix (__rustup_common_suffix $argv)\0A    printf \22%s\\n\22 $argv | string replace -r -- (string escape --style=regex -- \22$suffix\22)\\$ \22\22\0Aend\0A\0A# Strip result of __rustup_common_suffix, but require suffix to begin at a literal -\0Afunction __rustup_strip_common_suffix_strict\0A    set -l suffix (__rustup_common_suffix $argv | string match -r -- \22-.*\22)\0A    printf \22%s\\n\22 $argv | string replace -r -- (string escape --style=regex -- \22$suffix\22)\\$ \22\22\0Aend\0A\0Afunction __rustup_all_toolchains\0A    set -l __rustup_channels beta stable nightly\0A    printf \22%s\\n\22 $__rustup_channels\0A    printf \22%s\\n\22 $__rustup_channels-(__rustup_triples)\0Aend\0A\0A# All valid toolchains excluding installed\0Afunction __rustup_installable_toolchains\0A    comm -2 -3 (__rustup_all_toolchains | psub -F) (printf \22%s\\n\22 $__rustup_toolchains | psub -F) \\\0A        # Ignore warnings about lists not being in sorted order, as we are aware of their contents\0A        2>/dev/null\0Aend\0A\0Afunction __rustup_targets\0A    rustup target list | string replace -rf \22^(\\S+).*\22 '$1'\0Aend\0A\0Afunction __rustup_installed_targets\0A    rustup target list | string replace -rf \22^(\\S+) \\(installed\\)\22 '$1'\0Aend\0A\0A# All valid targets excluding installed\0Afunction __rustup_installable_targets\0A    rustup target list | string match -rv '\\(installed\\)$'\0Aend\0A\0A# Trim trailing attributes, e.g. \22rust-whatever (default)\22 -> \22rust-whatever\22\0Aset -l __rustup_toolchains (rustup toolchain list | string replace -r \22\\s+.*\22 '')\0A# By default, the long name of a toolchain is used (e.g. nightly-x86_64-unknown-linux-gnu),\0A# but a shorter version can be used if it is unambiguous.\0Aset -l __rustup_toolchains_short (__rustup_strip_common_suffix_strict $__rustup_toolchains)\0A\0Aset -l rustup_profiles minimal default complete\0A\0Acomplete -c rustup -n __fish_should_complete_switches -s v -l verbose\0Acomplete -c rustup -n __fish_should_complete_switches -s h -l help\0Acomplete -c rustup -n __fish_should_complete_switches -s V -l version\0A\0Acomplete -c rustup -n \22__fish_is_nth_token 1\22 -xa \22$subcmds\22\0A\0Acomplete -c rustup -n \22__fish_prev_arg_in default\22 -xa \22$__rustup_toolchains_short $__rustup_toolchains\22\0Acomplete -c rustup -n \22__fish_prev_arg_in toolchain\22 -xa \22add install list remove uninstall link help\22\0Acomplete -c rustup -n \22__fish_prev_arg_in target\22 -xa \22list add install remove uninstall help\22\0Acomplete -c rustup -n \22__fish_prev_arg_in component\22 -xa \22list add install remove uninstall help\22\0Acomplete -c rustup -n \22__fish_prev_arg_in override\22 -xa \22list set unset help\22\0Acomplete -c rustup -n \22__fish_prev_arg_in run\22 -xa \22$__rustup_toolchains_short $__rustup_toolchains\22\0Acomplete -c rustup -n \22__fish_prev_arg_in self\22 -xa \22update remove uninstall upgrade-data help\22\0Acomplete -c rustup -n \22__fish_prev_arg_in set\22 -xa \22default-host profile help\22\0A\0Acomplete -c rustup -n \22__fish_seen_subcommand_from toolchain; and __fish_prev_arg_in remove uninstall\22 \\\0A    -xa \22$__rustup_toolchains $__rustup_toolchains_short\22\0Acomplete -c rustup -n \22__fish_seen_subcomman