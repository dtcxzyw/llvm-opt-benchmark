@anon.1d0b41a8d45d477c3029ec78f9b8b434.1272 = private unnamed_addr constant [9384 x i8] c"# NOTE: Fish helper functions are your best friend here!\0A# see https://github.com/fish-shell/fish-shell/blob/master/share/functions/__fish_seen_subcommand_from.fish\0A# and https://github.com/fish-shell/fish-shell/blob/master/share/functions/__fish_use_subcommand.fish\0A\0A# help commands\0Acomplete -f -c bzr -n __fish_use_subcommand -a help -d 'Show help'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a topics -d 'List all help topics'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a commands -d 'List all commands'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a formats -d 'Help about supported formats'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a current-formats -d 'Help about current supported formats'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a revisionspec -d 'How to specify revisions in bzr'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from help' -a bugs -d 'Show bug tracker settings in bzr'\0A# TODO: Add help about specific commands generating the output\0A\0A# init command\0Acomplete -f -c bzr -n __fish_use_subcommand -a init -d 'Makes this directory a versioned branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from init' -l create-prefix -d 'Create the path leading up to the branch if it does not already exists'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from init' -l no-tree -d 'Create a branch without a working tree'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from init' -l append-revisions-only -d 'Never change revnos or the existing log. Append revisions to it only'\0A# TODO: Add init using path directory\0A\0A# branch command\0Acomplete -f -c bzr -n __fish_use_subcommand -a branch -d 'Make a copy of another branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l use-existing-dir -d 'Proceed even if directory exits'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l stacked -d 'Create a stacked branch referring to the source branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l standalone -d 'Do not use a shared repository, even if available'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l switch -d 'Switch the checkout in the current directory to the new branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l hardlink -d 'Hard-link working tree files where possible'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l bind -d 'Bind new branch to from location'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from branch' -l no-tree -d 'Create a branch without a working-tree'\0A# TODO: Add source/destination branch or directory\0A\0A# add command\0Acomplete -f -c bzr -n __fish_use_subcommand -a add -d 'Make files or directories versioned'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from add' -l no-recurse -s N -d 'Don\\'t recursively add the contents of directories'\0A\0A# ignore command\0Acomplete -f -c bzr -n __fish_use_subcommand -a ignore -d 'Ignore a file or pattern'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from ignore' -l default-rules -d 'Display the default ignore rules that bzr uses'\0A\0A# mv command\0Acomplete -f -c bzr -n __fish_use_subcommand -a mv -d 'Move or rename a versioned file'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from mv' -l auto -d 'Automatically guess renames'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from mv' -l after -d 'Move only the bzr identifier of the file, because the file has already been moved'\0A\0A# status command\0Acomplete -f -c bzr -n __fish_use_subcommand -a status -d 'Summarize changes in working copy'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from status' -l short -s S -d 'Use short status indicators'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from status' -l versioned -s V -d 'Only show versioned files'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from status' -l no-pending -d 'Don\\'t show pending merges'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from status' -l no-classify -d 'Do not mark object type using indicator'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from status' -l show-ids -d 'Show internal object ids'\0A\0A# diff command\0Acomplete -f -c bzr -n __fish_use_subcommand -a diff -d 'Show detailed diffs'\0A# TODO: Add file diff options\0A\0A# merge command\0Acomplete -f -c bzr -n __fish_use_subcommand -a merge -d 'Pull in changes from another branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l pull -d 'If destination is already merged, pull rather than merging'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l remember -d 'Remember the specified location as a default'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l force -d 'Merge even if the destination tree has uncommitted changes'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l reprocess -d 'Reprocess to reduce spurious conflicts'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l uncommitted -d 'Apply uncommitted changes from a working copy, instead of branch changes'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l show-base -d 'Show base revision text in conflicts'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l preview -d 'Instead of merging, show a diff of the merge'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l interactive -s i -d 'Select changes interactively'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l directory -s d -d 'Branch to merge into, rather than the one containing the working directory'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l change -s c -d 'Select changes introduced by the specified revision'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from merge' -l revision -s r -d 'Select changes introduced by the specified revision'\0A\0A# commit command\0Acomplete -f -c bzr -n __fish_use_subcommand -a commit -d 'Save some or all changes'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l show-diff -s p -d 'When no message is supplied, show diff along with status summary in message editor'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l file -s F -d 'Take commit message from this file'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l exclude -s x -d 'Do not consider changes made to a given path'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l message -s m -d 'Description of the new revision'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l author -d 'Set the author\\'s name, if it\\'s different from the committer'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l commit-time -d 'Manually set a commit time using commit date format'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l unchanged -d 'Commit even if nothing has changed'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l fixes -d 'Mark a bug as being fixed by this revision'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l strict -d 'Refuse to commit if there are unknown files in the working tree'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l lossy -d 'When committing to a foreign vcs do not push data that can not be natively represented'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from commit' -l local -d 'Perform a local commit in a bound branch (pushed to master on normal commit)'\0A\0A# send command\0Acomplete -f -c bzr -n __fish_use_subcommand -a send -d 'Send changes via email'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l body -d 'Body for the email'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l remember -d 'Remember submit and public branch'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l mail-to -d 'Mail the request to this address'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l format -d 'Use the specified output format'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l no-bundle -d 'Do not include a bundle in the merge directive'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l strict -d 'Refuse to send if there are uncommitted changes in the working tree'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from send' -l no-patch -d 'Do not include a preview patch in the merge directive'\0A\0A# log command\0Acomplete -f -c bzr -n __fish_use_subcommand -a log -d 'Show history of changes'\0A\0A# check command\0Acomplete -f -c bzr -n __fish_use_subcommand -a check -d 'Validate storage'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from check' -l tree -d 'Check the working tree related to the current directory'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from check' -l repo -d 'Check the repository related to the current directory'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from check' -l branch -d 'Check the branch related to the current directory'\0A\0A# Common long/short options \0Aset -l $cmds init branch add ignore mv status diff merge commit send log check\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from $cmds' -l usage -d 'Show usage message and options'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from $cmds' -s h -l help -d 'Show help message'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from $cmds' -s q -l quiet -d 'Only displays errors and warnings'\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from $cmds' -s v -l verbose -d 'Display more information'\0A\0A# Commands with dry-run option\0Acomplete -f -c bzr -n '__fish_seen_subcommand_from add mv' -l dry-run -d 'Show what would be done'\0A", align 1
