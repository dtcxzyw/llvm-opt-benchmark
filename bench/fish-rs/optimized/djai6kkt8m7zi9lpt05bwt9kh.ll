r if there's a meaningful difference between \22target pane\22 and \22destination pane\22, but tmux makes the distinction\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $swapp\22 -xs t --keep-order -a '(__fish_tmux_panes)' -d 'destination pane'\0A\0A## commands with window flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $linkw $movew $swapw\22 \\\0A    --keep-order -a '(__fish_tmux_windows)' -xs s -d 'source window'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $breakp $linkw $movew $neww $swapw\22 \\\0A    --keep-order -a '(__fish_tmux_windows)' -xs t -d 'destination window'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $killw $lastp $nextl $prevl $renamew\22 \\\0A    --keep-order -a '(__fish_tmux_windows)' -xs t -d 'target window'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $resizew $reswpawnw $rotatew $selectw $unlinkw\22 \\\0A    --keep-order -a '(__fish_tmux_windows)' -xs t -d 'target window'\0A\0A## commands with session flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $lastw $lsw $next $prev\22 -xs t -a '(__fish_tmux_sessions)' -d 'target session'\0A\0A## commands with the -F format flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $breakp $lsp $lsw $neww $chooseclient $choosetree\22 -xs F -d 'format string'\0A\0A## commands with -s/-t flags that are not panes/sessions/windows  (nice completion not yet implemented)\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $displayp\22 -xs t -d 'target client'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $lsp\22 -xs t -d target\0A\0A#commands that take shell commands\0Acomplete -c tmux -x -n \22__fish_seen_subcommand_from $neww $pipep $respawnp $respawnw $splitw\22 \\\0A    -a '(__fish_complete_subcommand --fcs-skip=2)'\0A\0A# Common boolean flags. TODO: -P for \22print info\22, -Z for \22zoom\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $breakp $joinp $linkw $neww $movew $splitw $swapp $swapp\22 -xs d -d 'do not activate'\0A\0Aset -l