@anon.1d0b41a8d45d477c3029ec78f9b8b434.3534 = private unnamed_addr constant [5536 x i8] c"# Support the usual (i.e., bash compatible) `umask` UI. This reports or modifies the magic global\0A# `umask` variable which is monitored by the fish process.\0A\0A# This table is indexed by the base umask value to be modified. Each digit represents the new umask\0A# value when the permissions to add are applied to the base umask value.\0Aset __fish_umask_add_table 0101010 2002200 2103210 4440000 4541010 6442200 6543210\0A\0Afunction __fish_umask_add\0A    set -l mask_digit $argv[1]\0A    set -l to_add $argv[2]\0A\0A    set -l mask_table 0000000\0A    if test $mask_digit -gt 0\0A        set mask_table $__fish_umask_add_table[$mask_digit]\0A    end\0A    set -l new_vals (string split '' $mask_table)\0A    echo $new_vals[$to_add]\0Aend\0A\0A# This table is indexed by the base umask value to be modified. Each digit represents the new umask\0A# value when the permissions to remove are applied to the base umask value.\0Aset __fish_umask_remove_table 1335577 3236767 3337777 5674567 5775577 7676767 7777777\0A\0Afunction __fish_umask_remove\0A    set -l mask_digit $argv[1]\0A    set -l to_remove $argv[2]\0A\0A    set -l mask_table 1234567\0A    if test $mask_digit -gt 0\0A        set mask_table $__fish_umask_remove_table[$mask_digit]\0A    end\0A    set -l new_vals (string split '' $mask_table)\0A    echo $new_vals[$to_remove]\0Aend\0A\0A# This returns the mask corresponding to allowing the permissions to allow. In other words it\0A# returns the inverse of the mask passed in.\0Aset __fish_umask_set_table 6 5 4 3 2 1 0\0Afunction __fish_umask_set\0A    set -l to_set $argv[1]\0A    if test $to_set -eq 0\0A        echo 7\0A        return\0A    end\0A    echo $__fish_umask_set_table[$to_set]\0Aend\0A\0A# Given a umask string, possibly in symbolic mode, return an octal value with leading zeros.\0A# This function expects to be called with a single value.\0Afunction __fish_umask_parse\0A    # Test if already a valid octal mask. If so pad it with zeros and return it.\0A    # Note that umask values are always base 8 so they don't require a leading zero.\0A    if string match -qr '^0?[0-7]{1,3}$' -- $argv\0A        string sub -s -4 0000$argv\0A        return 0\0A    end\0A\0A    # Test if argument is a valid symbolic mask. Note that the basic pattern allows one illegal\0A    # pattern: who and perms without a mode such as \22urw\22. We test for that below after using the\0A    # pattern to split the rights then testing for that invalid combination.\0A    set -l basic_pattern '([ugoa]*)([=+-]?)([rwx]*)'\0A    if not string match -qr \22^$basic_pattern(,$basic_pattern)*\\$\22 -- $argv\0A        printf (_ \22%s: Invalid mask '%s'\\n\22) umask $argv >&2\0A        return 1\0A    end\0A\0A    # Split umask into individual digits. We erase the first one because it should always be zero.\0A    set -l res (string split '' $umask)\0A    set -e res[1]\0A\0A    for rights in (string split , $argv)\0A        set -l match (string match -r \22^$basic_pattern\\$\22 $rights)\0A        set -l scope $match[2]\0A        set -l mode $match[3]\0A        set -l perms $match[4]\0A        if test -n \22$scope\22 -a -z \22$mode\22\0A            printf (_ \22%s: Invalid mask '%s'\\n\22) umask $argv >&2\0A            return 1\0A        end\0A        if test -z \22$scope\22\0A            set scope a\0A        end\0A        if test -z \22$mode\22\0A            set mode =\0A        end\0A\0A        set -l scopes_to_modify\0A        string match -q '*u*' $scope\0A        and set scopes_to_modify 1\0A        string match -q '*g*' $scope\0A        and set -a scopes_to_modify 2\0A        string match -q '*o*' $scope\0A        and set -a scopes_to_modify 3\0A        string match -q '*a*' $scope\0A        and set scopes_to_modify 1 2 3\0A\0A        set -l val 0\0A        if string match -q '*r*' $perms\0A            set val 4\0A        end\0A        if string match -q '*w*' $perms\0A            set val (math $val + 2)\0A        end\0A        if string match -q '*x*' $perms\0A            set val (math $val + 1)\0A        end\0A\0A        for j in $scopes_to_modify\0A            switch $mode\0A                case '='\0A                    set res[$j] (__fish_umask_set $val)\0A\0A                case '+'\0A                    set res[$j] (__fish_umask_add $res[$j] $val)\0A\0A                case -\0A                    set res[$j] (__fish_umask_remove $res[$j] $val)\0A            end\0A        end\0A    end\0A\0A    echo 0$res[1]$res[2]$res[3]\0A    return 0\0Aend\0A\0Afunction __fish_umask_print_symbolic\0A    set -l val\0A    set -l res \22\22\0A    set -l letter a u g o\0A\0A    for i in 2 3 4\0A        set res $res,$letter[$i]=\0A        set val (echo $umask|cut -c $i)\0A\0A        if contains $val 0 1 2 3\0A            set res {$res}r\0A        end\0A\0A        if contains $val 0 1 4 5\0A            set res {$res}w\0A        end\0A\0A        if contains $val 0 2 4 6\0A            set res {$res}x\0A        end\0A\0A    end\0A\0A    echo (string split -m 1 '' -- $res)[2]\0Aend\0A\0Afunction umask --description \22Set default file permission mask\22\0A    set -l options h/help p/as-command S/symbolic\0A    argparse -n umask $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help umask\0A        return 0\0A    end\0A\0A    switch (count $argv)\0A        case 0\0A            set -q umask\0A            or set -g umask 113\0A\0A            if set -q _flag_as_command\0A                echo umask $umask\0A            else if set -q _flag_symbolic\0A                __fish_umask_print_symbolic $umask\0A            else\0A                echo $umask\0A            end\0A\0A        case 1\0A            if set -l parsed (__fish_umask_parse $argv)\0A                set -g umask $parsed\0A                return 0\0A            end\0A            return 1\0A\0A        case '*'\0A            printf (_ '%s: Too many arguments\\n') umask >&2\0A            return 1\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3535 = private unnamed_addr constant [27 x i8] c"functions/up-or-search.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3536 = private unnamed_addr constant [764 x i8] c"# Depending on cursor position and current mode, either search backward or move up one line\22\0Afunction up-or-search -d \22Search back or move cursor up 1 line\22\0A    # If we are already in search mode, continue\0A    if commandline --search-mode\0A        commandline -f history-search-backward\0A        return\0A    end\0A\0A    # If we are navigating the pager, then up always navigates\0A    if commandline --paging-mode\0A        commandline -f up-line\0A        return\0A    end\0A\0A    # We are not already in search mode.\0A    # If we are on the top line, start search mode,\0A    # otherwise move up\0A    set -l lineno (commandline -L)\0A\0A    switch $lineno\0A        case 1\0A            commandline -f history-search-backward\0A\0A        case '*'\0A            commandline -f up-line\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3537 = private unnamed_addr constant [20 x i8] c"functions/vared.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3538 = private unnamed_addr constant [2176 x i8] c"#\0A# This is a neat function, stolen from zsh. It allows you to edit the\0A# value of a variable interactively.\0A#\0A\0Afunction vared --description \22Edit variable value\22\0A    if test (count $argv) = 1\0A        switch $argv\0A\0A            case -h --h --he --hel --help\0A                __fish_print_help vared\0A                return 0\0A\0A            case '-*'\0A                printf (_ \22%s: Unknown option %s\\n\22) vared $argv >&2\0A                return 1\0A\0A            case '*'\0A                if test (count $$argv ) -lt 2\0A                    # Try to avoid using local variables in this function, otherwise they can't be edited.\0A                    # https://github.com/fish-shell/fish-shell/issues/8836\0A                    # However we need to use one local, as you can't read directly into an index (like vared PATH[4]).\0A                    set -l __fish_vared_temp_value\0A\0A                    # The command substitution in this line controls the scope.\0A                    # If variable already exists, do not add any switches, so we don't change\0A                    # scoping or export rules. But if it does not exist, we make the variable\0A                    # global, so that it will not die when this function dies.\0A\0A                    read -p 'set_color green; echo '$argv'; set_color normal; echo \22> \22' \\\0A                        (if not set -q $argv; echo -g; end) \\\0A                        -c \22$$argv\22 \\\0A                        __fish_vared_temp_value\0A                    if test -n \22$$argv\22\0A                        set $argv $__fish_vared_temp_value\0A                    else\0A                        set -g $argv $__fish_vared_temp_value\0A                    end\0A                else\0A                    printf (_ '%s: %s is an array variable. Use %svared%s %s[n]%s to edit the n:th element of %s\\n') vared $argv (set_color $fish_color_command; echo) (set_color $fish_color_normal; echo) $argv (set_color normal; echo) $argv >&2\0A                end\0A        end\0A    else\0A        printf (_ '%s: Expected exactly one argument, got %s.\\n\\nSynopsis:\\n\\t%svared%s VARIABLE\\n') vared (count $argv) (set_color $fish_color_command; echo) (set_color $fish_color_normal; echo) >&2\0A    end\0Aend\0A", align 1
