@anon.1d0b41a8d45d477c3029ec78f9b8b434.2108 = private unnamed_addr constant [933 x i8] c"if mktemp --version >/dev/null 2>/dev/null # GNU\0A    complete -c mktemp -s d -l directory -d 'create a directory, not a file'\0A    complete -c mktemp -s u -l dry-run -d 'do not create anything; merely print a name (unsafe)'\0A    complete -c mktemp -s q -l quiet -d 'suppress diagnostics about file/dir-creation failure'\0A    complete -c mktemp -l suffix -r -d 'append SUFF to TEMPLATE'\0A    complete -c mktemp -l tmpdir -d 'interpret TEMPLATE relative to DIR'\0A    complete -c mktemp -l help -d 'display this help and exit'\0A    complete -c mktemp -l version -d 'output version information and exit'\0Aelse # OS X\0A    complete -c mktemp -s d -d 'create a directory, not a file'\0A    complete -c mktemp -s q -d 'suppress diagnostics about file/dir-creation failure'\0A    complete -c mktemp -s t -r -d 'generate a template using PREFIX and TMPDIR (if set)'\0A    complete -c mktemp -s u -d 'file will be unlinked before mktemp exits (unsafe)'\0Aend\0A", align 1
