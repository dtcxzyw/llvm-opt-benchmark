@anon.1d0b41a8d45d477c3029ec78f9b8b434.3410 = private unnamed_addr constant [855 x i8] c"function dirh --description \22Print the current directory history (the prev and next lists)\22\0A    set -l options h/help\0A    argparse -n dirh --max-args=0 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help dirh\0A        return 0\0A    end\0A\0A    set -l dirc (count $dirprev)\0A    if test $dirc -gt 0\0A        set -l dirprev_rev $dirprev[-1..1]\0A        # This can't be (seq $dirc -1 1) because of BSD.\0A        set -l dirnum (seq 1 $dirc)\0A        for i in $dirnum[-1..1]\0A            printf '%2d) %s\\n' $i $dirprev_rev[$i]\0A        end\0A    end\0A\0A    echo (set_color $fish_color_history_current)'   ' $PWD(set_color normal)\0A\0A    set -l dirc (count $dirnext)\0A    if test $dirc -gt 0\0A        set -l dirnext_rev $dirnext[-1..1]\0A        for i in (seq $dirc)\0A            printf '%2d) %s\\n' $i $dirnext_rev[$i]\0A        end\0A    end\0A    echo\0Aend\0A", align 1
