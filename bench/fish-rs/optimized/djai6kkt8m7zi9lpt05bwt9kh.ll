_from $subcommands\22 -a next -d \22Start playing next song on queue\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a pause -d \22Pause playing\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a play -d \22Start playing song-number specified\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a prev -d \22Start playing previous song\22\0A\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a random -d \22Toggle random mode if state (on or off) is not specified\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a repeat -d \22Toggle repeat mode if state (on or off) is not specified\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a replaygain -d \22Set replay gain mode\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a single -d \22Toggle single mode if state (on or off) is not specified\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a seek -d \22Seek by hour, minute or seconds\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a seekthrough -d \22Seek relative to current position\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a stop -d \22Stop playing\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a toggle -d \22Toggle between play and pause\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a add -d \22Add a song from music database to queue\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a insert -d \22Add a song from music database to queue after current song\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a clear -d \22Empty queue\22\0Acomplete -c mpc -n \22not __fish_seen_subcommand_from $subcommands\22 -a crop -d \22Remove all songs except for currently playing song\22\0Acomplete -c mpc -n \22n