@anon.1d0b41a8d45d477c3029ec78f9b8b434.3100 = private unnamed_addr constant [497 x i8] c"function __fish_complete_atool_archive_contents --description 'List archive contents'\0A    set -l cmd (commandline -cxp)\0A    set -e cmd[1]\0A    set -l file\0A    for arg in $cmd\0A        switch $arg\0A            case '-*'\0A            case '*'\0A                if test -f $arg\0A                    set file $arg\0A                    break\0A                end\0A        end\0A    end\0A    if not set -q file[1]\0A        return\0A    end\0A    als $file -qq | sed -r 's/^\\s*[0-9]+\\s+[0-9-]+\\s+[0-9:]+\\s+(.*)$/\\1/'\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3101 = private unnamed_addr constant [41 x i8] c"functions/__fish_complete_bittorrent.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3102 = private unnamed_addr constant [2784 x i8] c"# Bittorrent commands\0A\0Afunction __fish_complete_bittorrent\0A    complete -c $argv -l max_uploads -x --description \22Maximum uploads at once\22\0A    complete -c $argv -l keepalive_interval -x --description \22Number of seconds between keepalives\22\0A    complete -c $argv -l download_slice_size -x --description \22Bytes per request\22\0A    complete -c $argv -l request_backlog -x --description \22Requests per pipe\22\0A    complete -c $argv -l max_message_length -x --description \22Maximum length prefix encoding\22\0A    complete -c $argv -l ip --description \22IP to report to the tracker\22 -x -a \22(__fish_print_addresses)\22\0A    complete -c $argv -l minport --description \22Minimum port to listen to\22\0A    complete -c $argv -l maxport --description \22Maximum port to listen to\22\0A    complete -c $argv -l responsefile -r --description \22File for server response\22\0A    complete -c $argv -l url -x --description \22URL to get file from\22\0A    complete -c $argv -l saveas -r --description \22Local file target\22\0A    complete -c $argv -l timeout -x --description \22Time to close inactive socket\22\0A    complete -c $argv -l timeout_check_interval -x --description \22Time between checking timeouts\22\0A    complete -c $argv -l max_slice_length -x --description \22Maximum outgoing slice length\22\0A    complete -c $argv -l max_rate_period -x --description \22Maximum time to guess rate\22\0A    complete -c $argv -l bind -x --description \22IP to bind to locally\22 -a \22(__fish_print_addresses --all)\22\0A    complete -c $argv -l display_interval -x --description \22Time between screen updates\22\0A    complete -c $argv -l rerequest_interval -x --description \22Time to wait between requesting more peers\22\0A    complete -c $argv -l min_peers -x --description \22Minimum number of peers to not do requesting\22\0A    complete -c $argv -l http_timeout -x --description \22Number of seconds before assuming http timeout\22\0A    complete -c $argv -l max_initiate -x --description \22Number of peers at which to stop initiating new connections\22\0A    complete -c $argv -l max_allow_in -x --description \22Maximum number of connections to allow\22\0A    complete -c $argv -l check_hashes -x --description \22Whether to check hashes on disk\22\0A    complete -c $argv -l max_upload_rate -x --description \22Maximum kB/s to upload at\22\0A    complete -c $argv -l snub_time -x --description \22Seconds to wait for data to come in before assuming choking\22\0A    complete -c $argv -l spew -x --description \22Whether to display diagnostic info\22\0A    complete -c $argv -l rarest_first_cutoff -x --description \22Number of downloads at which to switch from random to rarest first\22\0A    complete -c $argv -l min_uploads -x --description \22Number of uploads to fill out to with optimistic unchokes\22\0A    complete -c $argv -l report_hash_failiures -x --description \22Whether to inform the user that hash failures occur\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3103 = private unnamed_addr constant [42 x i8] c"functions/__fish_complete_blockdevice.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3104 = private unnamed_addr constant [330 x i8] c"# Helper function for completions that need to enumerate block devices.\0Afunction __fish_complete_blockdevice\0A    set -l cmd (commandline -ct)\0A    test -z \22$cmd\22\0A    and set cmd /dev/\0A    for f in $cmd*\0A        test -b $f\0A        and printf \22%s\\t%s\\n\22 $f \22Block device\22\0A        test -d $f\0A        and printf \22%s\\n\22 $f/\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3105 = private unnamed_addr constant [33 x i8] c"functions/__fish_complete_cd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3106 = private unnamed_addr constant [1745 x i8] c"# This function only emits completions that might result from matches against $CDPATH. We rely on\0A# the core file name completion logic to include all other possible matches.\0Afunction __fish_complete_cd -d \22Completions for the cd command\22\0A    set -q CDPATH[1]\0A    or return 0 # no CDPATH so rely solely on the core file name completions\0A\0A    set -l token (commandline -ct)\0A    if string match -qr '^\\.{0,2}/.*' -- $token\0A        # Absolute path or explicitly relative to the current directory. Rely on the builtin file\0A        # name completions since we no longer exclude them from the `cd` argument completion.\0A        return\0A    end\0A\0A    # Relative path. Check $CDPATH and use that as the description for any possible matches.\0A    # We deliberately exclude the `.` path because the core file name completion logic will include\0A    # it when presenting possible matches.\0A    set -l cdpath (string match -v '.' -- $CDPATH)\0A\0A    # Remove the CWD if it is in CDPATH since, again, the core file name completion logic will\0A    # handle it.\0A    set -l cdpath (string match -v -- $PWD $cdpath)\0A    set -q cdpath[1]\0A    or return 0\0A\0A    # TODO: There's a subtlety regarding descriptions - if $cdpath[1]/foo and $cdpath[2]/foo\0A    # exist, we print both but want the first description to win - this currently works, but\0A    # is not guaranteed.\0A    for cdpath in $cdpath\0A        # Replace $HOME with \22~\22.\0A        set -l desc (string replace -r -- \22^$HOME\22 \22~\22 \22$cdpath\22)\0A        # This assumes the CDPATH component itself is cd-able.\0A        for d in $cdpath/$token*/\0A            # Remove the cdpath component again.\0A            test -x $d\0A            and printf \22%s\\tCDPATH %s\\n\22 (string replace -r \22^$cdpath/\22 \22\22 -- $d) $desc\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3107 = private unnamed_addr constant [36 x i8] c"functions/__fish_complete_clang.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3108 = private unnamed_addr constant [907 x i8] c"# This function is compatible with clang, clang++, and variations thereof, and is shared\0A# by clang.fish and clang++.fish.\0A# We dynamically query the head at `(commandline -x)[1]` to get the correct completions.\0Afunction __fish_complete_clang\0A    # If the result is for a value, clang only prints the value, so completions\0A    # for `-std=` print `c++11` and not `-std=c++11` like we need. See #4174.\0A    set -l prefix (commandline -ct | string replace -fr -- '^(.*=)[^=]*' '$1')\0A\0A    # Don't hard-code the name of the clang binary\0A    set -l clang (commandline -xp)[1]\0A    # first get the completions from clang, with the prefix separated from the value by a comma\0A    $clang --autocomplete=(commandline -ct | string unescape | string replace -- \22$prefix\22 \22$prefix,\22) 2>/dev/null |\0A        # and put it in a format that fish understands\0A        string replace -r -- '^([^ ]+)\\s*(.*)' \22$prefix\\$1\\t\\$2\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3109 = private unnamed_addr constant [38 x i8] c"functions/__fish_complete_command.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3110 = private unnamed_addr constant [399 x i8] c"function __fish_complete_command --description 'Complete using all available commands'\0A    set -l ctoken \22$(commandline -ct)\22\0A    switch $ctoken\0A        case '*=*'\0A            set ctoken (string split \22=\22 -- $ctoken)\0A            complete -C \22$ctoken[2]\22\0A        case '-*' # do not try to complete options as commands\0A            return\0A        case '*'\0A            complete -C \22$ctoken\22\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3111 = private unnamed_addr constant [46 x i8] c"functions/__fish_complete_convert_options.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3112 = private unnamed_addr constant [651 x i8] c"function __fish_complete_convert_options --description 'Complete Convert options' --argument-names what\0A    switch $what\0A        case format Format\0A            convert -list Format | sed '1,/----/d; /^$/,$d; /^$/d; s/^\\s*\\([a-zA-Z0-9-]\\+\\)\\**\\s*\\S\\+\\s\\+\\\\(\\S\\+\\)\\s\\+\\(.\\+\\S\\)\\s*$/\\1\\t\\2 \\3/'\0A        case color Color\0A            convert -list color | awk '{ print $1\22\\t\22$2\22 \22$3} ' | sed '1,/----/d'\0A        case family\0A            convert -list Font | sed '/family/!d; s/^\\s*.\\+: //' | sort -u\0A        case font Font\0A            convert -list Font | sed '/Font/!d; s/^\\s*.\\+: //' | sort -u\0A        case '*'\0A            convert -list $what\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3113 = private unnamed_addr constant [42 x i8] c"functions/__fish_complete_directories.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3114 = private unnamed_addr constant [1241 x i8] c"#\0A# Find directories that complete $argv[1], output them as completions\0A# with description $argv[2] if defined, otherwise use 'Directory'.\0A# If no arguments are provided, attempts to complete current commandline token.\0A#\0Afunction __fish_complete_directories -d \22Complete directory prefixes\22 --argument-names comp desc\0A    if not set -q desc[1]\0A        set desc Directory\0A    end\0A\0A    if not set -q comp[1]\0A        # No token given, so we use the current commandline token.\0A        # If we have a --name=val option, we need to remove it,\0A        # or the complete -C below would keep it, and then whatever complete\0A        # called us would add it again (assuming it's in the current token)\0A        set comp (commandline -ct | string replace -r -- '^-[^=]*=' '' $comp)\0A    end\0A\0A    # HACK: We call into the file completions by using an empty command\0A    # If we used e.g. `ls`, we'd run the risk of completing its options or another kind of argument.\0A    # But since we default to file completions, if something doesn't have another completion...\0A    # (really this should have an actual complete option)\0A    set -l dirs (complete -C\22'' $comp\22 | string match -r '.*/$')\0A\0A    if set -q dirs[1]\0A        printf \22%s\\n\22 $dirs\\t\22$desc\22\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3115 = private unnamed_addr constant [39 x i8] c"functions/__fish_complete_docutils.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3116 = private unnamed_addr constant [10099 x i8] c"function __fish_complete_docutils -d \22Completions for Docutils common options\22 -a cmd\0A    complete -x -c $cmd -k -a \22(__fish_complete_suffix .rst .txt)\22\0A\0A    # General Docutils Options\0A    complete -c $cmd -l title -d \22Specify the docs title\22\0A    complete -c $cmd -s g -l generator -d \22Include a generator credit\22\0A    complete -c $cmd -l no-generator -d \22Don't include a generator credit\22\0A    complete -c $cmd -s d -l date -d \22Include the date at the end of the docs\22\0A    complete -c $cmd -s t -l time -d \22Include the time and date\22\0A    complete -c $cmd -l no-datestamp -d \22Don't include a datestamp\22\0A    complete -c $cmd -s s -l source-link -d \22Include a source link\22\0A    complete -c $cmd -l source-url -d \22Use URL for a source link\22\0A    complete -c $cmd -l no-source-link -d \22Don't include a source link\22\0A    complete -c $cmd -l toc-entry-backlinks -d \22Link from section headers to TOC entries\22\0A    complete -c $cmd -l toc-top-backlinks -d \22Link from section headers to the top of the TOC\22\0A    complete -c $cmd -l no-toc-backlinks -d \22Disable backlinks to the TOC\22\0A    complete -c $cmd -l footnote-backlinks -d \22Link from footnotes/citations to references\22\0A    complete -c $cmd -l no-footnote-backlinks -d \22Disable backlinks from footnotes/citations\22\0A    complete -c $cmd -l section-numbering -d \22Enable section numbering\22\0A    complete -c $cmd -l no-section-numbering -d \22Disable section numbering\22\0A    complete -c $cmd -l strip-comments -d \22Remove comment elements\22\0A    complete -c $cmd -l leave-comments -d \22Leave comment elements\22\0A    complete -c $cmd -l strip-elements-with-class -d \22Remove all elements with classes\22\0A    complete -c $cmd -l strip-class -d \22Remove all classes attributes\22\0A    complete -x -c $cmd -s r -l report -a \22info warning error severe none 1 2 3 4 5\22 -d \22Report system messages\22\0A    complete -c $cmd -s v -l verbose -d \22Report all system messages\22\0A    complete -c $cmd -s q -l quiet -d \22Report no system messages\22\0A    complete -x -c $cmd -l halt -a \22info warning error severe none 1 2 3 4 5\22 -d \22Halt execution at system messages\22\0A    complete -c $cmd -l strict -d \22Halt at the slightest problem\22\0A    complete -x -c $cmd -l exit-status -a \22info warning error severe none 1 2 3 4 5\22 -d \22Enable a non-zero exit status\22\0A    complete -c $cmd -l debug -d \22Enable debug output\22\0A    complete -c $cmd -l no-debug -d \22Disable debug output\22\0A    complete -c $cmd -l warnings -d \22File to output system messages\22\0A    complete -c $cmd -l traceback -d \22Enable Python tracebacks\22\0A    complete -c $cmd -l no-traceback -d \22Disable Python tracebacks\22\0A    complete -c $cmd -s i -l input-encoding -d \22Encoding of input text\22\0A    complete -x -c $cmd -l input-encoding-error-handler -a \22strict ignore replace\22 -d \22Error handler\22\0A    complete -c $cmd -s o -l output-encoding -d \22Encoding for output\22\0A    complete -x -c $cmd -l output-encoding-error-handler -a \22strict ignore replace xmlcharrefreplace backslashreplace\22 -d \22Error handler\22\0A    complete -c $cmd -s e -l error-encoding -d \22Encoding for error output\22\0A    complete -x -c $cmd -l error-encoding-error-handler -d \22Error handler\22\0A    complete -c $cmd -s l -l language -d \22Specify the language\22\0A    complete -c $cmd -l record-dependencies -d \22File to write output file dependencies\22\0A    complete -c $cmd -l config -d \22File to read configs\22\0A    complete -c $cmd -s V -l version -d \22Show version number\22\0A    complete -c $cmd -s h -l help -d \22Show help message\22\0A\0A    # reStructuredText Parser Options\0A    complete -c $cmd -l pep-references -d \22Link to standalone PEP refs\22\0A    complete -c $cmd -l pep-base-url -d \22Base URL for PEP refs\22\0A    complete -c $cmd -l pep-file-url-template -d \22Template for PEP file part of URL\22\0A    complete -c $cmd -l rfc-references -d \22Link to standalone RFC refs\22\0A    complete -c $cmd -l rfc-base-url -d \22Base URL for RFC refs\22\0A    complete -c $cmd -l tab-width -d \22Specify tab width\22\0A    complete -c $cmd -l trim-footnote-reference-space -d \22Remove spaces before footnote refs\22\0A    complete -c $cmd -l leave-footnote-reference-space -d \22Leave spaces before footnote refs\22\0A    complete -c $cmd -l no-file-insertion -d \22Disable directives to insert file\22\0A    complete -c $cmd -l file-insertion-enabled -d \22Enable directives to insert file\22\0A    complete -c $cmd -l no-raw -d \22Disable the 'raw' directives\22\0A    complete -c $cmd -l raw-enabled -d \22Enable the 'raw' directives\22\0A    complete -x -c $cmd -l syntax-highlight -a \22long short none\22 -d \22Token name set for Pygments\22\0A    complete -x -c $cmd -l smart-quotes -a \22yes no alt\22 -d \22Change straight quotation marks\22\0A    complete -c $cmd -l smartquotes-locales -d \22'smart quotes' for the language\22\0A    complete -c $cmd -l word-level-inline-markup -d \22Inline markup at word level\22\0A    complete -c $cmd -l character-level-inline-markup -d \22Inline markup at character level\22\0Aend\0A\0Afunction __fish_complete_docutils_standalone_reader -d \22Completions for Docutils standalone reader options\22 -a cmd\0A    # Standalone Reader\0A    complete -c $cmd -l no-doc-title -d \22Disable the docs title\22\0A    complete -c $cmd -l no-doc-info -d \22Disable the docs info\22\0A    complete -c $cmd -l section-subtitles -d \22Enable section subtitles\22\0A    complete -c $cmd -l no-section-subtitles -d \22Disable section subtitles\22\0Aend\0A\0Afunction __fish_complete_docutils_html -d \22Completions for Docutils HTML options\22 -a cmd\0A    # HTML-Specific Options\0A    complete -c $cmd -l template -d \22Specify the template\22\0A    complete -c $cmd -l stylesheet -d \22List of stylesheet URLs\22\0A    complete -c $cmd -l stylesheet-path -d \22List of stylesheet paths\22\0A    complete -c $cmd -l embed-stylesheet -d \22Embed the stylesheets\22\0A    complete -c $cmd -l link-stylesheet -d \22Link to the stylesheets\22\0A    complete -c $cmd -l stylesheet-dirs -d \22List of directories where stylesheets are found\22\0A    complete -x -c $cmd -l initial-header-level -a \221 2 3 4 5 6\22 -d \22Specify the initial header level\22\0A\0A    if test $cmd != rst2html5\0A        complete -c $cmd -l field-name-limit -d \22Specify the limit for field names\22\0A        complete -c $cmd -l option-limit -d \22Specify the limit for options\22\0A    end\0A\0A    complete -x -c $cmd -l footnote-references -a \22superscript brackets\22 -d \22Format for footnote refs\22\0A    complete -x -c $cmd -l attribution -a \22dash parens none\22 -d \22Format for block quote attr\22\0A    complete -c $cmd -l compact-lists -d \22Enable compact lists\22\0A    complete -c $cmd -l no-compact-lists -d \22Disable compact lists\22\0A    complete -c $cmd -l compact-field-lists -d \22Enable compact field lists\22\0A    complete -c $cmd -l no-compact-field-lists -d \22Disable compact field lists\22\0A\0A    if test $cmd = rst2html5\0A        complete -x -c $cmd -l table-style -a \22borderless booktabs align-left align-center align-right colwidths-auto\22 -d \22Specify table style\22\0A    else\0A        complete -x -c $cmd -l table-style -a borderless -d \22Specify table style\22\0A    end\0A\0A    complete -x -c $cmd -l math-output -a \22MathML HTML MathJax LaTeX\22 -d \22Math output format\22\0A\0A    if test $cmd = rst2html5\0A        complete -c $cmd -l xml-declaration -d \22Prepend an XML declaration\22\0A    end\0A\0A    complete -c $cmd -l no-xml-declaration -d \22Omit the XML declaration\22\0A    complete -c $cmd -l cloak-email-addresses -d \22Obfuscate email addresses\22\0Aend\0A\0Afunction __fish_complete_docutils_latex -d \22Completions for Docutils LaTeX options\22 -a cmd\0A    # LaTeX-Specific Options\0A    complete -c $cmd -l documentclass -d \22Specify LaTeX documentclass\22\0A    complete -c $cmd -l documentoptions -d \22Specify docs options\22\0A    complete -x -c $cmd -l footnote-references -a \22superscript brackets\22 -d \22Format for footnote refs\22\0A    complete -x -c $cmd -l use-latex-citations -d \22Use \\cite command for citations\22\0A    complete -x -c $cmd -l figure-citations -d \22Use figure floats for citations\22\0A    complete -x -c $cmd -l attribution -a \22dash parens none\22 -d \22Format for block quote attr\22\0A    complete -c $cmd -l stylesheet -d \22Specify LaTeX packages/stylesheets\22\0A    complete -c $cmd -l stylesheet-path -d \22List of LaTeX packages/stylesheets\22\0A    complete -c $cmd -l link-stylesheet -d \22Link to the stylesheets\22\0A    complete -c $cmd -l embed-stylesheet -d \22Embed the stylesheets\22\0A    complete -c $cmd -l stylesheet-dirs -d \22List of directories where stylesheets are found\22\0A    complete -c $cmd -l latex-preamble -d \22Customization the preamble\22\0A    complete -c $cmd -l template -d \22Specify the template\22\0A    complete -c $cmd -l use-latex-toc -d \22TOC by LaTeX\22\0A    complete -c $cmd -l use-docutils-toc -d \22TOC by Docutils\22\0A    complete -c $cmd -l use-part-section -d \22Add parts on top of the section hierarchy\22\0A    complete -c $cmd -l use-docutils-docinfo -d \22Use Docutils docinfo\22\0A    complete -c $cmd -l use-latex-docinfo -d \22Use LaTeX docinfo\22\0A    complete -c $cmd -l topic-abstract -d \22Typeset abstract as topic\22\0A    complete -c $cmd -l use-latex-abstract -d \22Use LaTeX abstract\22\0A    complete -c $cmd -l hyperlink-color -d \22Specify color of hyperlinks\22\0A    complete -c $cmd -l hyperref-options -d \22Additional options to the 'hyperref' package\22\0A    complete -c $cmd -l compound-enumerators -d \22Enable compound enumerators\22\0A    complete -c $cmd -l no-compound-enumerators -d \22Disable compound enumerators\22\0A    complete -c $cmd -l section-prefix-for-enumerators -d \22Enable section prefixes\22\0A    complete -c $cmd -l no-section-prefix-for-enumerators -d \22Disable section prefixes\22\0A    complete -c $cmd -l section-enumerator-separator -d \22Set the section enumerator separator\22\0A    complete -c $cmd -l literal-block-env -d \22Specify env for literal-blocks\22\0A    complete -c $cmd -l use-verbatim-when-possible -d \22Use 'verbatim' for literal-blocks\22\0A    complete -x -c $cmd -l table-style -a \22standard booktabs borderless\22 -d \22Table style\22\0A    complete -x -c $cmd -l graphicx-option -a \22dvips pdftex auto\22 -d \22LaTeX graphicx package option\22\0A\0A    if test $cmd = rst2latex\0A        complete -x -c $cmd -l font-encoding -a \22T1 OT1 LGR,T1\22 -d \22LaTeX font encoding\22\0A    end\0A\0A    complete -c $cmd -l reference-label -d \22Puts the refs label\22\0A    complete -c $cmd -l use-bibtex -d \22Style and database for bibtex\22\0A    complete -c $cmd -l docutils-footnotes -d \22Footnotes by Docutils\22\0Aend\0A", align 1
