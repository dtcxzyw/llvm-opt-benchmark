@anon.1d0b41a8d45d477c3029ec78f9b8b434.2154 = private unnamed_addr constant [2659 x i8] c"set -l uname (uname -s)\0A\0A## GNU mv\0Aif mv --version >/dev/null 2>/dev/null\0A    # --backup requires an argument, -b does not accept an argument\0A    complete -c mv -l backup -r -d \22Backup each existing destination file\22 \\\0A        -x -ka \22none\\t'Never make backups'\0A                     off\\t'Never make backups'\0A                     numbered\\t'Make numbered backups'\0A                     t\\t'Make numbered backups'\0A                     existing\\t'Numbered backups if any exist, else simple'\0A                     nil\\t'Numbered backups if any exist, else simple'\0A                     simple\\t'Make simple backups'\0A                     never\\t'Make simple backups'\22\0A    complete -c mv -s b -d \22Backup each existing destination file\22\0A    complete -c mv -s f -l force -d \22Don't prompt to overwrite\22\0A    complete -c mv -s i -l interactive -d \22Prompt to overwrite\22\0A    complete -c mv -s n -l no-clobber -d \22Don't overwrite existing\22\0A    # --reply has been deprecated for over a decade, and now GNU mv does not accept this option.\0A    # Better to use -f instead of --reply=yes.\0A    #   complete -c mv -l reply -x -a \22yes no query\22 -d \22Answer for overwrite questions\22\0A    complete -c mv -l strip-trailing-slashes -d \22Remove trailing '/' from source args\22\0A    complete -c mv -s S -l suffix -x -d \22Override default backup suffix\22\0A    complete -c mv -s t -l target-directory -d \22Move all source args into DIR\22 \\\0A        -x -a \22(__fish_complete_directories (commandline -ct) 'Directory')\22\0A    complete -c mv -s T -l no-target-directory -d \22Treat DEST as a normal file\22\0A    complete -c mv -s u -l update -d \22Don't overwrite newer\22\0A    complete -c mv -s v -l verbose -d \22Print filenames as it goes\22\0A    test \22$uname\22 = Linux\0A    and complete -c mv -s Z -l context -d \22Set SELinux context to default\22\0A\0A    complete -c mv -l help -d \22Print help and exit\22\0A    complete -c mv -l version -d \22Print version and exit\22\0A    ## BSD-ish mv\0Aelse #[posix][ext]\0A    # freebsd:   mv [-fi][nvh] src dst\0A    # dragonfly: mv [-fi][nvh] src dst\0A    # macos:     mv [-fi][nv ] src dst\0A    # netbsd:    mv [-fi][ v ] src dst\0A    # openbsd:   mv [-fi][ v ] src dst\0A    # solaris:   mv [-fi][   ] src dst\0A\0A    # POSIX options\0A    complete -c mv -s f -d \22Don't prompt to overwrite\22\0A    complete -c mv -s i -d \22Prompt to overwrite existing\22\0A\0A    test uname = SunOS # -fi\0A    and exit 0\0A\0A    # Extensions\0A    complete -c mv -s v -d \22Print filenames as it goes\22\0A\0A    contains \22$uname\22 NetBSD OpenBSD # -fiv\0A    and exit 0\0A\0A    complete -c mv -s n -d \22Don't overwrite existing\22\0A\0A    test \22$uname\22 = Darwin # -fivn\0A    and exit 0\0A\0A    complete -c mv -s h -d \22Don't follow target if it links to a dir\22\0Aend\0A", align 1
