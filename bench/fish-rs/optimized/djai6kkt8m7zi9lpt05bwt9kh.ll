@anon.1d0b41a8d45d477c3029ec78f9b8b434.2932 = private unnamed_addr constant [1927 x i8] c"# Completions for xbps-install\0A# Author: Allen Sobot <chilledfrogs@disroot.org>\0A\0Aset -l progname xbps-install\0A\0Aset -l listall \22(__fish_print_xbps_packages)\22\0A\0Acomplete -c $progname -f\0Acomplete -c $progname -a \22$listall\22\0A\0Acomplete -c $progname -s A -d 'Install as a dependency'\0Acomplete -c $progname -s C -d 'Use this XBPS configuration directory.' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s c -d 'Use this cache directory to store binary packages' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s d -d 'Enable extra debugging shown to stderr'\0Acomplete -c $progname -s D -d 'Only download packages to the cache'\0Acomplete -c $progname -s f -d 'Force downgrade/reinstall package (pass twice to reinstall config files as well)'\0Acomplete -c $progname -s h -d 'Show the help message'\0Acomplete -c $progname -s I -d 'Ignore detected file conflicts in a transaction'\0Acomplete -c $progname -s i -d 'Ignore repositories defined in configuration files'\0Acomplete -c $progname -s M -d 'For remote repositories, the data is fetched and stored in memory'\0Acomplete -c $progname -s n -d 'Dry-run mode.  Show what actions would be done but don\\'t do anything'\0Acomplete -c $progname -s R -d 'Enable repository mode' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -l repository -d 'Append the specified repository to the top of the list' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s r -d 'Use this target root directory' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s S -d 'Synchronize remote repository index files'\0Acomplete -c $progname -s U -d 'Don\\'t configure packages'\0Acomplete -c $progname -s u -d 'Performs a full system upgrade (except for packages on hold)'\0Acomplete -c $progname -s v -d 'Enables verbose messages'\0Acomplete -c $progname -s y -d 'Assume yes to all questions and avoid interactive questions'\0Acomplete -c $progname -s V -d 'Show the version information'\0A", align 1
