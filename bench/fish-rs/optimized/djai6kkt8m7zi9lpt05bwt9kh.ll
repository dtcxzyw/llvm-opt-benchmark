@anon.1d0b41a8d45d477c3029ec78f9b8b434.2914 = private unnamed_addr constant [1131 x i8] c"function __fish_complete_wvdial_peers --description 'Complete wvdial peers' --argument-names cfgfiles\0A    set -q cfgfiles[1]\0A    or set -l cfgfiles /etc/wvdial.conf ~/.wvdialrc\0A\0A    # test if there is an alternative config file specified\0A    set -l store_next\0A    for opt in (commandline -cpx)\0A        if set -q store_next[1]\0A            set store_next\0A            set cfgfiles $opt\0A            continue\0A        end\0A\0A        switch $opt\0A            case -C --config\0A                set store_next true\0A            case '--config=*'\0A                set cfgfiles (string replace '--config=' '' -- $opt)\0A        end\0A    end\0A\0A    for file in (path filter -rf -- $cfgfiles)\0A        string match -r '\\[Dialer' <$file | string replace -r '\\[Dialer (.+)\\]' '$1'\0A    end | path sort -u | string match -v Defaults\0A\0Aend\0A\0Acomplete -c wvdial -xa \22(__fish_complete_wvdial_peers)\22 -d \22wvdial connections\22\0Acomplete -c wvdial -s c -l chat -d 'Run wvdial as chat replacement from within pppd'\0Acomplete -c wvdial -s C -l config -r -d 'Run wvdial with alternative config file'\0Acomplete -c wvdial -s n -l no-syslog -d 'Don\\'t output debug information'\0A", align 1
