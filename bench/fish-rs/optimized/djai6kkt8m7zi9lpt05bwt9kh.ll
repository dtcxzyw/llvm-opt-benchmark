@anon.1d0b41a8d45d477c3029ec78f9b8b434.2276 = private unnamed_addr constant [9544 x i8] c"# Completions for pacman\0A# Author: Giorgio Lando <patroclo7@gmail.com>\0A# Updated by maxfl, SanskritFritz, faho, f1u77y, akiirui\0A\0Aset -l progname pacman\0A\0Aset -l listinstalled \22(__fish_print_pacman_packages --installed)\22\0A# This might be an issue if another package manager is also installed (e.g. for containers)\0Aset -l listall \22(__fish_print_pacman_packages)\22\0Aset -l listrepos \22(__fish_print_pacman_repos)\22\0Aset -l listgroups \22(pacman -Sg)\\t'Package Group'\22\0A# Theoretically, pacman reads packages in all formats that libarchive supports\0A# In practice, it's going to be tar.xz, tar.gz, tar.zst, or just pkg.tar (uncompressed pkg)\0Aset -l listfiles '(__fish_complete_suffix pkg.tar.zst pkg.tar.xz pkg.tar.gz pkg.tar)'\0A\0Aset -l noopt 'not __fish_contains_opt -s S -s D -s Q -s R -s U -s T -s F database query sync remove upgrade deptest files'\0Aset -l database '__fish_contains_opt -s D database'\0Aset -l query '__fish_contains_opt -s Q query'\0Aset -l queryfile '__fish_contains_opt -s p file'\0Aset -l remove '__fish_contains_opt -s R remove'\0Aset -l sync '__fish_contains_opt -s S sync'\0Aset -l upgrade '__fish_contains_opt -s U upgrade'\0Aset -l files '__fish_contains_opt -s F files'\0A\0Acomplete -c $progname -e\0Acomplete -c $progname -f\0A# HACK: We only need these two to coerce fish to stop file completion and complete options\0Acomplete -c $progname -n \22$noopt\22 -a -D -d \22Modify the package database\22\0Acomplete -c $progname -n \22$noopt\22 -a -Q -d \22Query the package database\22\0A\0A# Primary operations\0Acomplete -c $progname -s D -f -l database -n \22$noopt\22 -d 'Modify the package database'\0Acomplete -c $progname -s Q -f -l query -n \22$noopt\22 -d 'Query the package database'\0Acomplete -c $progname -s R -f -l remove -n \22$noopt\22 -d 'Remove packages from the system'\0Acomplete -c $progname -s S -f -l sync -n \22$noopt\22 -d 'Synchronize packages'\0Acomplete -c $progname -s T -f -l deptest -n \22$noopt\22 -d 'Check dependencies'\0Acomplete -c $progname -s U -l upgrade -n \22$noopt\22 -d 'Upgrade or add a local package'\0Acomplete -c $progname -s F -f -l files -n \22$noopt\22 -d 'Query the files database'\0Acomplete -c $progname -s V -f -l version -d 'Display version and exit'\0Acomplete -c $progname -s h -f -l help -d 'Display help'\0A\0A# General options\0A# Only offer these once a command has been given so they get prominent display\0Acomplete -c $progname -n \22not $noopt\22 -s b -l dbpath -d 'Alternate database location' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -n \22not $noopt\22 -s r -l root -d 'Alternate installation root' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -n \22not $noopt\22 -s v -l verbose -d 'Output more status messages' -f\0Acomplete -c $progname -n \22not $noopt\22 -l arch -d 'Alternate architecture' -f\0Acomplete -c $progname -n \22not $noopt\22 -l cachedir -d 'Alternate package cache location' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -n \22not $noopt\22 -l color -d 'Colorize the output' -fa '{auto,always,never}'\0Acomplete -c $progname -n \22not $noopt\22 -l config -d 'Alternate config file' -rF\0Acomplete -c $progname -n \22not $noopt\22 -l confirm -d 'Always ask for confirmation' -f\0Acomplete -c $progname -n \22not $noopt\22 -l debug -d 'Display debug messages' -f\0Acomplete -c $progname -n \22not $noopt\22 -l disable-download-timeout -d 'Use relaxed timeouts for download' -f\0Acomplete -c $progname -n \22not $noopt\22 -l gpgdir -d 'Alternate home directory for GnuPG' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -n \22not $noopt\22 -l hookdir -d 'Alternate hook location' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -n \22not $noopt\22 -l logfile -d 'Alternate log file'\0Acomplete -c $progname -n \22not $noopt\22 -l noconfirm -d 'Bypass any confirmation' -f\0Acomplete -c $progname -n \22not $noopt\22 -l sysroot -d 'Operate on a mounted guest system (root-only)' -xa \22(__fish_complete_directories)\22\0A\0A# File, query, sync options (files, query, sync)\0Afor condition in files query sync\0A    complete -c $progname -n \22$$condition\22 -s q -l quiet -d 'Show less information' -f\0Aend\0A\0A# Transaction options (sync, remove, upgrade)\0Afor condition in sync remove upgrade\0A    complete -c $progname -n \22$$condition\22 -s d -l nodeps -d 'Skip [all] dependency checks' -f\0A    complete -c $progname -n \22$$condition\22 -s p -l print -d 'Dry run, only print targets' -f\0A    complete -c $progname -n \22$$condition\22 -l assume-installed -d 'Add a virtual package to satisfy dependencies' -f\0A    complete -c $progname -n \22$$condition\22 -l dbonly -d 'Modify database entry only' -f\0A    complete -c $progname -n \22$$condition\22 -l noprogressbar -d 'Do not display progress bar' -f\0A    complete -c $progname -n \22$$condition\22 -l noscriptlet -d 'Do not execute install script' -f\0A    complete -c $progname -n \22$$condition\22 -l print-format -d 'Specify printf-like format' -x\0Aend\0A\0A# File and query options (files, query)\0Afor condition in files query\0A    complete -c $progname -n \22$$condition\22 -s l -l list -d 'List the files owned by PACKAGE' -f\0Aend\0A\0A# File and sync options (files, sync)\0Afor condition in files sync\0A    complete -c $progname -n \22$$condition\22 -s y -l refresh -d 'Download fresh package databases [force]' -f\0Aend\0A\0A# Query and sync options (query, sync)\0Afor condition in query sync\0A    complete -c $progname -n \22$$condition\22 -s g -l groups -d 'Display members of [all] package GROUP' -xa \22$listgroups\22\0Aend\0A\0A# Sync and upgrade options (sync, upgrade)\0Afor condition in sync upgrade\0A    complete -c $progname -n \22$$condition\22 -l asdeps -d 'Install packages as non-explicitly installed' -f\0A    complete -c $progname -n \22$$condition\22 -l asexplicit -d 'Install packages as explicitly installed' -f\0A    complete -c $progname -n \22$$condition\22 -l ignore -d 'Ignore a package upgrade (can be used more than once)' -xa \22$listall\22\0A    complete -c $progname -n \22$$condition\22 -l ignoregroup -d 'Ignore a group upgrade (can be used more than once)' -xa \22$listgroups\22\0A    complete -c $progname -n \22$$condition\22 -l needed -d 'Do not reinstall up to date packages' -f\0A    complete -c $progname -n \22$$condition\22 -l overwrite -d 'Overwrite conflicting files (can be used more than once)' -rF\0Aend\0A\0A# Database options\0Aset -l has_db_opt '__fish_contains_opt asdeps asexplicit check -s k'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -s k -l check -d 'Check database validity'\0Acomplete -c $progname -n \22$database\22 -s q -l quiet -d 'Suppress output of success messages' -f\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -l asdeps -d 'Mark PACKAGE as dependency' -x\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -l asexplicit -d 'Mark PACKAGE as explicitly installed' -x\0Acomplete -c $progname -n \22$has_db_opt; and $database\22 -xa \22$listinstalled\22\0A\0A# File options - since pacman 5\0Acomplete -c $progname -n \22$files\22 -s x -l regex -d 'Interpret each query as a regular expression' -f\0Acomplete -c $progname -n \22$files\22 -l machinereadable -d 'Print each match in a machine readable output format' -f\0Acomplete -c $progname -n \22$files\22 -d Package -xa \22$listall\22\0A\0A# Query options\0Acomplete -c $progname -n \22$query\22 -s c -l changelog -d 'View the change log of PACKAGE' -f\0Acomplete -c $progname -n \22$query\22 -s d -l deps -d 'List only non-explicit packages (dependencies)' -f\0Acomplete -c $progname -n \22$query\22 -s e -l explicit -d 'List only explicitly installed packages' -f\0Acomplete -c $progname -n \22$query\22 -s i -l info -d 'View PACKAGE [backup files] information' -f\0Acomplete -c $progname -n \22$query\22 -s k -l check -d 'Check that PACKAGE files exist' -f\0Acomplete -c $progname -n \22$query\22 -s m -l foreign -d 'List installed packages not found in sync database' -f\0Acomplete -c $progname -n \22$query\22 -s n -l native -d 'list installed packages only found in sync database' -f\0Acomplete -c $progname -n \22$query\22 -s o -l owns -d 'Query the package that owns FILE' -rF\0Acomplete -c $progname -n \22$query\22 -s p -l file -d 'Query a package file instead of the database' -rF\0Acomplete -c $progname -n \22$query\22 -s s -l search -d 'Search locally-installed packages for regexp' -f\0Acomplete -c $progname -n \22$query\22 -s t -l unrequired -d 'List only unrequired packages [and optdepends]' -f\0Acomplete -c $progname -n \22$query\22 -s u -l upgrades -d 'List only out-of-date packages' -f\0Acomplete -c $progname -n \22$query\22 -n \22not $queryfile\22 -d 'Installed package' -xa \22$listinstalled\22\0Acomplete -c $progname -n \22$query\22 -n \22$queryfile\22 -d 'Package file' -k -xa \22$listfiles\22\0A\0A# Remove options\0Acomplete -c $progname -n \22$remove\22 -s c -l cascade -d 'Also remove packages depending on PACKAGE' -f\0Acomplete -c $progname -n \22$remove\22 -s n -l nosave -d 'Ignore file backup designations' -f\0Acomplete -c $progname -n \22$remove\22 -s s -l recursive -d 'Also remove dependencies of PACKAGE' -f\0Acomplete -c $progname -n \22$remove\22 -s u -l unneeded -d 'Only remove targets not required by PACKAGE' -f\0Acomplete -c $progname -n \22$remove\22 -d 'Installed package' -xa \22$listinstalled\22\0A\0A# Sync options\0Acomplete -c $progname -n \22$sync\22 -s c -l clean -d 'Remove [all] packages from cache' -f\0Acomplete -c $progname -n \22$sync\22 -s i -l info -d 'View PACKAGE [extended] information' -f\0Acomplete -c $progname -n \22$sync\22 -s l -l list -d 'List all packages in REPOSITORY' -xa \22$listrepos\22\0Acomplete -c $progname -n \22$sync\22 -s s -l search -d 'Search remote repositories for regexp' -f\0Acomplete -c $progname -n \22$sync\22 -s u -l sysupgrade -d 'Upgrade all packages that are out of date'\0Acomplete -c $progname -n \22$sync\22 -s w -l downloadonly -d 'Only download the target packages'\0Acomplete -c $progname -n \22$sync\22 -xa \22$listall $listgroups\22\0A\0A# Upgrade options\0Acomplete -c $progname -n \22$upgrade\22 -k -xa \22$listfiles\22 -d 'Package file'\0A", align 1
