@anon.1d0b41a8d45d477c3029ec78f9b8b434.2214 = private unnamed_addr constant [1164 x i8] c"set -l c complete -c notify-send\0A\0A$c -f # Disable file completion\0A\0A# notify-send [OPTION\E2\80\A6] <SUMMARY> [BODY] - create a notification\0A\0Aset -l urgency_levels\0A\0A$c -s u -l urgency -d \22urgency level\22 -x -a 'low normal critical'\0A$c -s t -l expire-time -x -d \22timeout in milliseconds at which to expire the notification\22\0A$c -s a -l app-name -x -d \22app name for the icon\22\0A$c -s i -l icon -x -d \22icon filename or stock icon to display\22\0A$c -s i -l icon -x -a \22(__fish_complete_freedesktop_icons)\22\0A$c -s c -l category -x -d \22notification category\22\0A$c -s e -l transient -d \22create a transient notification\22\0A$c -s h -l hint -x -d \22extra data to pass, format: `TYPE:NAME:VALUE`, valid types: boolean, int, double, string, byte and variant\22\0A$c -s p -l print-id -d \22print the notification ID\22\0A$c -s r -l replace-id -x -d \22ID of the notification to replace\22\0A$c -s w -l wait -d \22wait for the notification to be closed before exciting\22\0A$c -s A -l action -x -d \22clickable actions to display to the user. implies --wait, can be set multiple times, example: --action=save='Save Screenshot?'\22\0A\0A$c -s '?' -l help -d \22print help information\22\0A$c -s v -l version -d \22print program version\22\0A", align 1
