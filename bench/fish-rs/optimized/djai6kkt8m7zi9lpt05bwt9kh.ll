@anon.1d0b41a8d45d477c3029ec78f9b8b434.1722 = private unnamed_addr constant [2932 x i8] c"complete -f -c git -a subtree -d 'Manage git subtrees'\0A# Git subtree common completions\0Acomplete -f -c git -n '__fish_git_using_command subtree' -s q -l quiet -d 'Suppress output'\0Acomplete -f -c git -n '__fish_git_using_command subtree' -s d -l debug -d 'Debug output'\0Acomplete -f -c git -n '__fish_git_using_command subtree' -s P -l path -d 'Path to the subtree'\0A\0A# Git subtree subcommands\0Acomplete -f -c git -n '__fish_git_using_command subtree' -a add -d \22Add a new subtree to the repository\22\0Acomplete -f -c git -n '__fish_git_using_command subtree' -a merge -d \22Merge changes from a subtree into the repository\22\0Acomplete -f -c git -n '__fish_git_using_command subtree' -a split -d \22Extract a subtree from the repository\22\0Acomplete -f -c git -n '__fish_git_using_command subtree' -a pull -d \22Fetch and integrate changes from a remote subtree\22\0Acomplete -f -c git -n '__fish_git_using_command subtree' -a push -d \22Push changes to a remote subtree\22\0A\0A# Completions for push and split subcommands\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split' -l annotate -d 'Annotate the commit'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split' -s b -l branch -d 'Branch to split'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split' -l ignore-joins -d 'Ignore joins during history reconstruction'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split' -l onto -d 'Specify the commit ID to start history reconstruction'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split' -l rejoin -d 'Merge the synthetic history back into the main project'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split; and __fish_contains_opt rejoin' -l squash -d 'Merge subtree changes as a single commit'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split; and __fish_contains_opt rejoin' -l no-squash -d 'Do not merge subtree changes as a single commit'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from push split; and __fish_contains_opt rejoin' -s m -l message -d 'Use the given message as the commit message for the merge commit'\0A\0A# Completion for add and merge subcommands\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from add merge' -l squash -d 'Merge subtree changes as a single commit'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from add merge' -l no-squash -d 'Do not merge subtree changes as a single commit'\0Acomplete -f -c git -n '__fish_git_using_command subtree; and __fish_seen_subcommand_from add merge' -s m -l message -d 'Use the given message as the commit message for the merge commit'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1723 = private unnamed_addr constant [20 x i8] c"completions/git.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1724 = private unnamed_addr constant [206216 x i8] c"# fish completion for git\0A\0A# Use this instead of calling git directly; it passes the commands that are\0A# already present on the commandline to git. This is relevant for --work-tree etc, see issue #6219.\0Afunction __fish_git\0A    set -l saved_args $argv\0A    set -l global_args\0A    set -l cmd (commandline -xpc)\0A    # We assume that git is the first command until we have a better awareness of subcommands, see #2705.\0A    set -e cmd[1]\0A    if argparse -s (__fish_git_global_optspecs) -- $cmd 2>/dev/null\0A        # All arguments that were parsed by argparse are global git options.\0A        set -l num_global_args (math (count $cmd) - (count $argv))\0A        if test $num_global_args -ne 0\0A            set global_args $cmd[1..$num_global_args]\0A        end\0A    end\0A    # Using 'command git' to avoid interactions for aliases from git to (e.g.) hub\0A    command git $global_args $saved_args 2>/dev/null\0Aend\0A\0A# Print an optspec for argparse to handle git's options that are independent of any subcommand.\0Afunction __fish_git_global_optspecs\0A    string join \\n v-version h/help C= c=+ 'e-exec-path=?' H-html-path M-man-path I-info-path p/paginate \\\0A        P/no-pager o-no-replace-objects b-bare G-git-dir= W-work-tree= N-namespace= S-super-prefix= \\\0A        l-literal-pathspecs g-glob-pathspecs O-noglob-pathspecs i-icase-pathspecs\0Aend\0A\0Afunction __fish_git_commits\0A    # Complete commits with their subject line as the description\0A    # This allows filtering by subject with the new pager!\0A    # Because even subject lines can be quite long,\0A    # trim them (abbrev'd hash+tab+subject) to 73 characters\0A    #\0A    # Hashes we just truncate ourselves to 10 characters, without disambiguating.\0A    # That technically means that sometimes we don't give usable SHAs,\0A    # but according to https://stackoverflow.com/a/37403152/3150338,\0A    # that happens for 3 commits out of 600k.\0A    # For fish, at the time of writing, out of 12200 commits, 7 commits need 8 characters.\0A    # And since this takes about 1/3rd of the time that disambiguating takes...\0A    __fish_git log --no-show-signature --pretty=tformat:\22%H\22\\t\22%<(64,trunc)%s\22 --all --max-count=1000 2>/dev/null \\\0A        | string replace -r '^([0-9a-f]{10})[0-9a-f]*\\t(.*)' '$1\\t$2'\0Aend\0A\0Afunction __fish_git_recent_commits\0A    # Like __fish_git_commits, but not on all branches and limited to\0A    # the last 50 commits. Used for fixup, where only the current branch\0A    # and the latest commits make sense.\0A    __fish_git log --no-show-signature --pretty=tformat:\22%h\22\\t\22%<(64,trunc)%s\22 --max-count=50 $argv 2>/dev/null\0Aend\0A\0Afunction __fish_git_branches\0A    # This is much faster than using `git branch` and avoids dealing with localized \22detached HEAD\22 messages.\0A    # We intentionally only sort local branches by recency. See discussion in #9248.\0A    __fish_git for-each-ref --format='%(refname:strip=2)%09Local Branch' --sort=-committerdate refs/heads/ 2>/dev/null\0A    __fish_git for-each-ref --format='%(refname:strip=2)%09Remote Branch' refs/remotes/ 2>/dev/null\0Aend\0A\0Afunction __fish_git_submodules\0A    __fish_git submodule 2>/dev/null \\\0A        | string replace -r '^.[^ ]+ ([^ ]+).*$' '$1'\0Aend\0A\0Afunction __fish_git_local_branches\0A    __fish_git for-each-ref --format='%(refname:strip=2)%09Local Branch' --sort=-committerdate refs/heads/ 2>/dev/null\0Aend\0A\0Afunction __fish_git_unique_remote_branches\0A    # `git checkout` accepts remote branches without the remote part\0A    # if they are unambiguous.\0A    # E.g. if only alice has a \22frobulate\22 branch\0A    # `git checkout frobulate` is equivalent to `git checkout -b frobulate --track alice/frobulate`.\0A    __fish_git for-each-ref --format=\22%(refname:strip=3)\22 \\\0A        --sort=\22refname:strip=3\22 \\\0A        \22refs/remotes/*/$match*\22 \22refs/remotes/*/*/**\22 2>/dev/null | uniq -u\0Aend\0A\0Afunction __fish_git_tags\0A    __fish_git tag --sort=-creatordate 2>/dev/null\0Aend\0A\0Afunction __fish_git_heads\0A    set -l gitdir (__fish_git rev-parse --git-dir 2>/dev/null)\0A    or return # No git dir, no need to even test.\0A    for head in HEAD FETCH_HEAD ORIG_HEAD MERGE_HEAD\0A        if test -f $gitdir/$head\0A            echo $head\0A        end\0A    end\0Aend\0A\0Afunction __fish_git_refs\0A    __fish_git_branches\0A    __fish_git_tags\0A    __fish_git_heads\0Aend\0A\0Afunction __fish_git_remotes\0A    # Example of output parsed:\0A    # \22remote.upstream.url git@github.com:fish-shell/fish-shell.git\22 -> \22upstream\\tgit@github.com:fish-shell/fish-shell.git\22\0A    __fish_git config --get-regexp 'remote\\.[a-z]+\\.url' | string replace -rf 'remote\\.(.*)\\.url (.*)' '$1\\t$2'\0Aend\0A\0Afunction __fish_git_files\0A    # A function to show various kinds of files git knows about,\0A    # by parsing `git status --porcelain`.\0A    #\0A    # This accepts arguments to denote the kind of files:\0A    # - added: Staged added files (unstaged adds are untracked)\0A    # - copied\0A    # - deleted\0A    # - deleted-staged\0A    # - ignored\0A    # - modified: Files that have been modified (but aren't staged)\0A    # - modified-staged: Staged modified files\0A    # - renamed\0A    # - untracked\0A    # and as a convenience \22all-staged\22\0A    # to get _all_ kinds of staged files.\0A\0A    # Save the repo root to remove it from the path later.\0A    set -l root (__fish_git rev-parse --show-toplevel --is-bare-repository 2>/dev/null)\0A    or return\0A\0A    # Skip bare repositories.\0A    test \22$root[2]\22 = true\0A    and return\0A    or set -e root[2]\0A\0A    # Cache the translated descriptions so we don't have to get it\0A    # once per file.\0A    contains -- all-staged $argv; and set -l all_staged\0A    contains -- unmerged $argv; and set -l unmerged\0A    and set -l unmerged_desc \22Unmerged File\22\0A    contains -- added $argv; or set -ql all_staged; and set -l added\0A    and set -l added_desc \22Added file\22\0A    contains -- modified $argv; and set -l modified\0A    and set -l modified_desc \22Modified file\22\0A    contains -- untracked $argv; and set -l untracked\0A    and set -l untracked_desc \22Untracked file\22\0A    contains -- modified-staged $argv; or set -ql all_staged; and set -l modified_staged\0A    and set -l staged_modified_desc \22Staged modified file\22\0A    contains -- modified-staged-deleted $argv; or set -ql modified_staged; and set -l modified_staged_deleted\0A    and set -l modified_staged_deleted_desc \22Staged modified and deleted file\22\0A    contains -- deleted $argv; and set -l deleted\0A    and set -l deleted_desc \22Deleted file\22\0A    contains -- deleted-staged $argv; or set -ql all_staged; and set -l deleted_staged\0A    and set -l staged_deleted_desc \22Staged deleted file\22\0A    contains -- ignored $argv; and set -l ignored\0A    and set -l ignored_desc \22Ignored file\22\0A    contains -- renamed $argv; and set -l renamed\0A    and set -l renamed_desc \22Renamed file\22\0A    contains -- copied $argv; and set -l copied\0A    and set -l copied_desc \22Copied file\22\0A\0A    # git status --porcelain gives us all the info we need, in a format we don't.\0A    # The v2 format has better documentation and doesn't use \22 \22 to denote anything,\0A    # but it's only been added in git 2.11.0, which was released November 2016.\0A\0A    # Also, we ignore submodules because they aren't useful as arguments (generally),\0A    # and they slow things down quite significantly.\0A    # E.g. `git reset $submodule` won't do anything (not even print an error).\0A    # --ignore-submodules=all was added in git 1.7.2, released July 2010.\0A    #\0A    set -l status_opt --ignore-submodules=all\0A\0A    # If we aren't looking for ignored files, let git status skip them.\0A    # (don't use --ignored=no because that was only added in git 2.16, from Jan 2018.\0A    set -q ignored; and set -a status_opt --ignored\0A\0A    # We need to set status.relativePaths to true because the porcelain v2 format still honors that,\0A    # and core.quotePath to false so characters > 0x80 (i.e. non-ASCII) aren't considered special.\0A    # We explicitly enable globs so we can use that to match the current token.\0A    set -l git_opt -c status.relativePaths -c core.quotePath=\0A\0A    # If the token starts with `./`, we need to prepend that\0A    string match -q './*' -- (commandline -ct)\0A    and set -l rel ./\0A    or set -l rel\0A\0A    # If the token starts with `:`, it's from the repo root\0A    string match -q ':*' -- (commandline -ct)\0A    and set -l colon 1\0A    or set -l colon\0A\0A    # We pick the v2 format if we can, because it shows relative filenames (if used without \22-z\22).\0A    # We fall back on the v1 format by reading git's _version_, because trying v2 first is too slow.\0A    set -l ver (__fish_git --version | string replace -rf 'git version (\\d+)\\.(\\d+)\\.?.*' '$1\\n$2')\0A    # Version >= 2.11.* has the v2 format.\0A    if test \22$ver[1]\22 -gt 2 2>/dev/null; or test \22$ver[1]\22 -eq 2 -a \22$ver[2]\22 -ge 11 2>/dev/null\0A        set -l stats (__fish_git $git_opt status --porcelain=2 -uno $status_opt)\0A        if set -ql untracked\0A            # Fast path for untracked files - it is extremely easy to get a lot of these,\0A            # so we handle them separately.\0A            set -l files (__fish_git $git_opt ls-files -o --exclude-standard)\0A            printf \22$rel%s\\n\22 $files\\t$untracked_desc\0A            if set -ql colon[1]\0A                or set files (string match '../*' -- $files)\0A                set files (path resolve -- $files | string replace -- \22$root/\22 \22:/:\22)\0A                and printf '%s\\n' $files\\t$untracked_desc\0A            end\0A        end\0A        printf %s\\n $stats | while read -la -d ' ' line\0A            set -l file\0A            set -l desc\0A            # The basic status format is \22XY\22, where X is \22our\22 state (meaning the staging area),\0A            # and \22Y\22 is \22their\22 state.\0A            # A \22.\22 means it's unmodified.\0A            switch \22$line[1..2]\22\0A                case 'u *'\0A                    # Unmerged\0A                    # \22Unmerged entries have the following format; the first character is a \22u\22 to distinguish from ordinary changed entries.\22\0A                    # \22u <xy> <sub> <m1> <m2> <m3> <mW> <h1> <h2> <h3> <path>\22\0A                    # This is first to distinguish it from normal modifications et al.\0A                    set -ql unmerged\0A                    and set file \22$line[11..-1]\22\0A                    and set desc $unmerged_desc\0A                case '2 .R*' '2 R.*'\0A                    # Renamed/Copied\0A                    # From the docs: \22Renamed or copied entries have the following format:\22\0A                    # \222 <XY> <sub> <mH> <mI> <mW> <hH> <hI> <X><score> <path><sep><origPath>\22\0A                    # Since <sep> is \\t, we can't really parse it unambiguously.\0A                    # The \22-z\22 format would be great here!\0A                    set -ql renamed\0A                    and set file (string replace -r '\\t[^\\t]*' '' -- \22$line[10..-1]\22)\0A                    and set desc $renamed_desc\0A                case '2 RM*' '2 RT*'\0A                    # Staged as renamed, with unstaged modifications (issue #6031)\0A                    set -ql renamed\0A                    or set -ql modified\0A                    and set file (string replace -r '\\t[^\\t]*' '' -- \22$line[10..-1]\22)\0A                    set -ql renamed\0A                    and set desc $renamed_desc\0A                    set -ql modified\0A                    and set --append desc $modified_desc\0A                case '2 RD*'\0A                    # Staged as renamed, but deleted in the worktree\0A                    set -ql renamed\0A                    or set -ql deleted\0A                    and set file (string replace -r '\\t[^\\t]*' '' -- \22$line[10..-1]\22)\0A                    set -ql renamed\0A                    and set desc $renamed_desc\0A                    set -ql deleted\0A                    and set --append desc $deleted_desc\0A                case '2 .C*' '2 C.*'\0A                    set -ql copied\0A                    and set file (string replace -r '\\t[^\\t].*' '' -- \22$line[10..-1]\22)\0A                    and set desc $copied_desc\0A                case '1 A.*'\0A                    # Additions are only shown here if they are staged.\0A                    # Otherwise it's an untracked file.\0A                    set -ql added\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $added_desc\0A                case '1 AD*'\0A                    # Added files that were since deleted\0A                    if set -ql added\0A                        set file \22$line[9..-1]\22\0A                        set desc $added_desc\0A                    else if set -ql deleted\0A                        set file \22$line[9..-1]\22\0A                        set desc $deleted_desc\0A                    end\0A                case \221 AM*\22 \221 AT*\22\0A                    # Added files with additional modifications\0A                    # (\22T\22 is type-changed. As of git 2.33 this appears to be undocumented.\0A                    # it happens when e.g. a file is replaced with a symlink.\0A                    # For our purposes it's the same as modified)\0A                    if set -ql added\0A                        set file \22$line[9..-1]\22\0A                        set desc $added_desc\0A                    else if set -ql modified\0A                        set file \22$line[9..-1]\22\0A                        set desc $modified_desc\0A                    end\0A                case '1 .A*'\0A                    # Files added with git add --intent-to-add.\0A                    set -ql untracked\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $untracked_desc\0A                case '1 .M*' '1 .T*'\0A                    # Modified\0A                    # From the docs: \22Ordinary changed entries have the following format:\22\0A                    # \221 <XY> <sub> <mH> <mI> <mW> <hH> <hI> <path>\22\0A                    # Since <path> can contain spaces, print from element 9 onwards\0A                    set -ql modified\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $modified_desc\0A                case '1 MD*' '1 TD*'\0A                    set -ql modified_staged_deleted\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $modified_staged_deleted_desc\0A                case '1 M.*' '1 T.*'\0A                    # If the character is first (\22M.\22), then that means it's \22our\22 change,\0A                    # which means it is staged.\0A                    # This is useless for many commands - e.g. `checkout` won't do anything with this.\0A                    # So it needs to be requested explicitly.\0A                    set -ql modified_staged\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $staged_modified_desc\0A                case '1 MM*' '1 MT*' '1 TM*' '1 TT*'\0A                    # Staged-modified with unstaged modifications\0A                    # These need to be offered for both kinds of modified.\0A                    if set -ql modified\0A                        set file \22$line[9..-1]\22\0A                        set desc $modified_desc\0A                    else if set -ql modified_staged\0A                        set file \22$line[9..-1]\22\0A                        set desc $staged_modified_desc\0A                    end\0A                case '1 .D*'\0A                    set -ql deleted\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $deleted_desc\0A                case '1 D.*'\0A                    # TODO: The docs are unclear on this.\0A                    # There is both X unmodified and Y either M or D (\22not updated\22)\0A                    # and Y is D and X is unmodified or [MARC] (\22deleted in work tree\22).\0A                    # For our purposes, we assume this is a staged deletion.\0A                    set -ql deleted_staged\0A                    and set file \22$line[9..-1]\22\0A                    and set desc $staged_deleted_desc\0A                case '! *'\0A                    # Ignored\0A                    # \22! <path>\22 - print from element 2 on.\0A                    set -ql ignored\0A                    and set file \22$line[2..-1]\22\0A                    and set desc $ignored_desc\0A            end\0A            # Only try printing if the file was selected.\0A            if set -q file[1]\0A                # Without \22-z\22, git sometimes _quotes_ filenames.\0A                # It adds quotes around it _and_ escapes the character.\0A                # e.g. `\22a\\\\b\22`.\0A                # We just remove the quotes and hope it works out.\0A                # If this contains newlines or tabs,\0A                # there is nothing we can do, but that's a general issue with scripted completions.\0A                set file (string trim -c \\\22 -- $file)\0A                # The (possibly relative) filename.\0A                printf \22$rel%s\\n\22 \22$file\22\\t$desc\0A                # Now from repo root.\0A                # Only do this if the filename isn't a simple child,\0A                # or the current token starts with \22:\22\0A                if set -ql colon[1]; or string match -q '../*' -- $file\0A                    set -l fromroot (path resolve -- $file 2>/dev/null)\0A                    # `:` starts pathspec \22magic\22, and the second `:` terminates it.\0A                    # `/` is the magic letter for \22from repo root\22.\0A                    # If we didn't terminate it we'd have to escape any special chars\0A                    # (non-alphanumeric, glob or regex special characters, in whatever dialect git uses)\0A                    and set fromroot (string replace -- \22$root/\22 \22:/:\22 \22$fromroot\22)\0A                    and printf '%s\\n' \22$fromroot\22\\t$desc\0A                end\0A            end\0A        end\0A    else\0A        # v1 format logic\0A        # This is pretty terrible and requires us to do a lot of weird work.\0A\0A        # A literal \22?\22 for use in `case`.\0A        set -l q '\\\\?'\0A        if status test-feature qmark-noglob\0A            set q '?'\0A        end\0A        # Whether we need to use the next line - some entries have two lines.\0A        set -l use_next\0A\0A        # We need to compute relative paths on our own, which is slow.\0A        # Pre-remove the root at least, so we have fewer components to deal with.\0A        set -l _pwd_list (string replace \22$root/\22 \22\22 -- $PWD/ | string split /)\0A        test -z \22$_pwd_list[-1]\22; and set -e _pwd_list[-1]\0A        # Cache the previous relative path because these are sorted, so we can reuse it\0A        # often for files in the same directory.\0A        set -l previous\0A        # Note that we can't use space as a delimiter between status and filename, because\0A        # the status can contain spaces - \22 M\22 is different from \22M \22.\0A        __fish_git $git_opt status --porcelain -z $status_opt \\\0A            | while read -lz -d' ' line\0A            set -l desc\0A            # The entire line is the \22from\22 from a rename.\0A            if set -q use_next[1]\0A                if contains -- $use_next $argv\0A                    set -l var \22$use_next\22_desc\0A                    set desc $$var\0A                    set -e use_next[1]\0A                else\0A                    set -e use_next[1]\0A                    continue\0A                end\0A            end\0A\0A            # The format is two characters for status, then a space and then\0A            # up to a NUL for the filename.\0A            #\0A            set -l stat (string sub -l 2 -- $line)\0A            # The basic status format is \22XY\22, where X is \22our\22 state (meaning the staging area),\0A            # and \22Y\22 is \22their\22 state (meaning the work tree).\0A            # A \22 \22 means it's unmodified.\0A            #\0A            # Be careful about the ordering here!\0A            switch \22$stat\22\0A                case DD AU UD UA DU AA UU\0A                    # Unmerged\0A                    set -ql unmerged\0A                    and set desc $unmerged_desc\0A                case 'R ' RM RD\0A                    # Renamed/Copied\0A                    # These have the \22from\22 name as the next batch.\0A                    # TODO: Do we care about the new name?\0A                    set use_next renamed\0A                    continue\0A                case 'C ' CM CD\0A                    set use_next copied\0A                    continue\0A                case AM\0A                    if set -ql added\0A                        set file \22$line[9..-1]\22\0A                        set desc $added_desc\0A                    else if set -ql modified\0A                        set file \22$line[9..-1]\22\0A                        set desc $modified_desc\0A                    end\0A                case AD\0A                    if set -ql added\0A                        set file \22$line[9..-1]\22\0A                        set desc $added_desc\0A                    else if set -ql deleted\0A                        set file \22$line[9..-1]\22\0A                        set desc $deleted_desc\0A                    end\0A                case 'A '\0A                    # Additions are only shown here if they are staged.\0A                    # Otherwise it's an untracked file.\0A                    set -ql added\0A                    and set desc $added_desc\0A                case '*M'\0A                    # Modified\0A                    set -ql modified\0A                    and set desc $modified_desc\0A                case 'M*'\0A                    # If the character is first (\22M \22), then that means it's \22our\22 change,\0A                    # which means it is staged.\0A                    # This is useless for many commands - e.g. `checkout` won't do anything with this.\0A                    # So it needs to be requested explicitly.\0A                    set -ql modified_staged\0A                    and set desc $staged_modified_desc\0A                case '*D'\0A                    set -ql deleted\0A                    and set desc $deleted_desc\0A                case 'D*'\0A                    # TODO: The docs are unclear on this.\0A                    # There is both X unmodified and Y either M or D (\22not updated\22)\0A                    # and Y is D and X is unmodified or [MARC] (\22deleted in work tree\22).\0A                    # For our purposes, we assume this is a staged deletion.\0A                    set -ql deleted_staged\0A                    and set desc $staged_deleted_desc\0A                case \22$q$q\22\0A                    # Untracked\0A                    set -ql untracked\0A                    and set desc $untracked_desc\0A                case '!!'\0A                    # Ignored\0A                    set -ql ignored\0A                    and set desc $ignored_desc\0A            end\0A            if set -q desc[1]\0A                # Again: \22XY filename\22, so the filename starts on character 4.\0A                set -l relfile (string sub -s 4 -- $line)\0A\0A                set -l file\0A                # Computing relative path by hand.\0A                set -l abs (string split / -- $relfile)\0A                # If it's in the same directory, we just need to change the filename.\0A                if test \22$abs[1..-2]\22 = \22$previous[1..-2]\22\0A                    # If we didn't have a previous file, and the current file is in the current directory,\0A                    # this would error out.\0A                    #\0A                    # See #5728.\0A                    set -q previous[1]\0A                    and set previous[-1] $abs[-1]\0A                    or set previous $abs\0A                else\0A                    set -l pwd_list $_pwd_list\0A                    # Remove common prefix\0A                    while test \22$pwd_list[1]\22 = \22$abs[1]\22\0A                        set -e pwd_list[1]\0A                        set -e abs[1]\0A                    end\0A                    # Go a dir up for every entry left in pwd_list, then into $abs\0A                    set previous (string replace -r '.*' '..' -- $pwd_list) $abs\0A                end\0A                set -a file (string join / -- $previous)\0A\0A                # The filename with \22:/:\22 prepended.\0A                if set -ql colon[1]; or string match -q '../*' -- $file\0A                    set file (string replace -- \22$root/\22 \22:/:\22 \22$root/$relfile\22)\0A                end\0A\0A                if test \22$root/$relfile\22 -ef \22$relfile\22\0A                    and not set -ql colon[1]\0A                    set file $relfile\0A                end\0A\0A                printf '%s\\n' $file\\t$desc\0A            end\0A        end\0A    end\0Aend\0A\0A# Lists files included in the index of a commit, branch, or tag (not necessarily HEAD)\0Afunction __fish_git_rev_files\0A    set -l rev $argv[1]\0A    set -l path $argv[2]\0A\0A    # Strip any partial files from the path before handing it to `git show`\0A    set -l path (string replace -r -- '(.*/|).*' '$1' $path)\0A\0A    # List files in $rev's index, skipping the \22tree ...\22 header, but appending\0A    # the parent path, which git does not include in the output (and fish requires)\0A    string join \\n -- $path(__fish_git show $rev:$path | sed '1,2d')\0Aend\0A\0A# Provides __fish_git_rev_files completions for the current token\0Afunction __fish_git_complete_rev_files\0A    set -l split (string split -m 1 \22:\22 -- (commandline -xt))\0A    set -l rev $split[1]\0A    set -l path $split[2]\0A\0A    printf \22$rev:%s\\n\22 (__fish_git_rev_files $rev $path)\0Aend\0A\0A# Determines whether we can/should complete with __fish_git_rev_files\0Afunction __fish_git_needs_rev_files\0A    # git (as of 2.20) accepts the rev:path syntax for a number of subcommands,\0A    # but then doesn't emit the expected (or any?) output, e.g. `git log master:foo`\0A    #\0A    # This definitely works with `git show` to retrieve a copy of a file as it exists\0A    # in the index of revision $rev, it should be updated to include others as they\0A    # are identified.\0A    __fish_git_using_command show; and string match -r \22^[^-].*:\22 -- (commandline -xt)\0Aend\0A\0Afunction __fish_git_ranges\0A    set -l both (commandline -xt | string replace -r '\\.{2,3}' \\n\\$0\\n)\0A    set -l from $both[1]\0A    set -l dots $both[2]\0A    # If we didn't need to split (or there's nothing _to_ split), complete only the first part\0A    # Note that status here is from `string replace` because `set` doesn't alter it\0A    if test -z \22$from\22 -o $status -gt 0\0A        if commandline -ct | string match -q '*..*'\0A            # The cursor is right of a .. range operator, make sure to include them first.\0A            __fish_git_refs | string replace -r '' \22$dots\22\0A        else\0A            __fish_git_refs | string replace \\t \22$dots\22\\t\0A        end\0A        return 0\0A    end\0A\0A    set -l from_refs\0A    if commandline -ct | string match -q '*..*'\0A        # If the cursor is right of a .. range operator, only complete the right part.\0A        set from_refs $from\0A    else\0A        set from_refs (__fish_git_refs | string match -e \22$from\22 | string replace -r \\t'.*$' '')\0A    end\0A\0A    set -l to $both[3]\0A    # Remove description from the from-ref, not the to-ref.\0A    for from_ref in $from_refs\0A        for to_ref in (__fish_git_refs | string match \22*$to*\22) # if $to is empty, this correctly matches everything\0A            printf \22%s%s%s\\n\22 $from_ref $dots $to_ref\0A        end\0A    end\0Aend\0A\0Afunction __fish_git_needs_command\0A    # Figure out if the current invocation already has a command.\0A    #\0A    # This is called hundreds of times and the argparse is kinda slow,\0A    # so we cache it as long as the commandline doesn't change.\0A    set -l cmdline \22$(commandline -c)\22\0A    if set -q __fish_git_cmdline; and test \22$cmdline\22 = \22$__fish_git_cmdline\22\0A        if set -q __fish_git_cmd[1]\0A            echo -- $__fish_git_cmd\0A            return 1\0A        end\0A        return 0\0A    end\0A    set -g __fish_git_cmdline $cmdline\0A\0A    set -l cmd (commandline -xpc)\0A    set -e cmd[1]\0A    argparse -s (__fish_git_global_optspecs) -- $cmd 2>/dev/null\0A    or return 0\0A    # These flags function as commands, effectively.\0A    set -q _flag_version; and return 1\0A    set -q _flag_html_path; and return 1\0A    set -q _flag_man_path; and return 1\0A    set -q _flag_info_path; and return 1\0A    if set -q argv[1]\0A        # Also print the command, so this can be used to figure out what it is.\0A        set -g __fish_git_cmd $argv[1]\0A        echo $argv[1]\0A        return 1\0A    end\0A    set -g __fish_git_cmd\0A    return 0\0Aend\0A\0Afunction __fish_git_config_keys\0A    # Print already defined config values first\0A    # Config keys may span multiple lines, so parse using null char\0A    # With -z, key and value are separated by space, not \22=\22\0A    __fish_git config -lz | while read -lz key value\0A        # Print only first line of value(with an ellipsis) if multiline\0A        printf '%s\\t%s\\n' $key (string shorten -N -- $value)\0A    end\0A    # Print all recognized config keys; duplicates are not shown twice by fish\0A    printf '%s\\n' (__fish_git help --config)[1..-2] # Last line is a footer; ignore it\0Aend\0A\0A# HACK: Aliases\0A# Git allows aliases, so we need to see what command the current command-token corresponds to\0A# (so we can complete e.g. `lg` like `log`).\0A# Checking `git config` for a lot of aliases can be quite slow if it is called\0A# for every possible command.\0A# Ideally, we'd `complete --wraps` this, but that is not currently possible, as is\0A# using `complete -C` like\0A# complete -c git -n '__fish_git_using_command lg' -a '(complete -C\22git log \22)'\0A#\0A# So instead, we store the aliases in global variables, named after the alias, containing the command.\0A# This is because alias:command is an n:1 mapping (an alias can only have one corresponding command,\0A#                                                  but a command can be aliased multiple times)\0A\0A# Approximately duplicates the logic from https://github.com/git/git/blob/d486ca60a51c9cb1fe068803c3f540724e95e83a/contrib/completion/git-completion.bash#L1130\0A# The bash script also finds aliases that reference other aliases via a loop but we handle that separately\0Afunction __fish_git_aliased_command\0A    for word in (string split ' ' -- $argv)\0A        switch $word\0A            case !gitk gitk\0A                echo gitk\0A                return\0A                # Adding \22 to the list\0A            case '!*' '-*' '*=*' git '()' '{' : '\\'*' '\22*'\0A                continue\0A            case '*'\0A                echo $word\0A                return\0A        end\0A    end\0Aend\0A\0Agit config -z --get-regexp 'alias\\..*' | while read -lz alias cmdline\0A    set -l command (__fish_git_aliased_command $cmdline)\0A    string match -q --regex '\\w+' -- $command; or continue\0A    # Git aliases can contain chars that variable names can't - escape them.\0A    set -l alias (string replace 'alias.' '' -- $alias | string escape --style=var)\0A    set -g __fish_git_alias_$alias $command $cmdline\0A    set --append -g __fish_git_aliases $alias\0Aend\0A\0A# Resolve aliases that call another alias\0Afor alias in $__fish_git_aliases\0A    set -l handled $alias\0A\0A    while true\0A        set -l alias_varname __fish_git_alias_$alias\0A        set -l aliased_command $$alias_varname[1][1]\0A        set -l aliased_escaped (string escape --style=var -- $aliased_command)\0A        set -l aliased_varname __fish_git_alias_$aliased_escaped\0A        set -q $aliased_varname\0A        or break\0A\0A        # stop infinite recursion\0A        contains $aliased_escaped $handled\0A        and break\0A\0A        # expand alias in cmdline\0A        set -l aliased_cmdline $$alias_varname[1][2]\0A        set -l aliased_cmdline (string replace \22 $aliased_command \22 \22 $$aliased_varname[1][2..-1] \22 -- \22 $aliased_cmdline \22)\0A        set -g $alias_varname $$aliased_varname[1][1] (string trim \22$aliased_cmdline\22)\0A        set --append handled $aliased_escaped\0A    end\0Aend\0A\0Afunction __fish_git_using_command\0A    set -l cmd (__fish_git_needs_command)\0A    test -z \22$cmd\22\0A    and return 1\0A    contains -- $cmd $argv\0A    and return 0\0A\0A    # Check aliases.\0A    set -l varname __fish_git_alias_(string escape --style=var -- $cmd)\0A    set -q $varname\0A    and contains -- $$varname[1][1] $argv\0A    and return 0\0A    return 1\0Aend\0A\0Afunction __fish_git_contains_opt\0A    # Check if an option has been given\0A    # First check the commandline normally\0A    __fish_contains_opt $argv\0A    and return\0A\0A    # Now check the alias\0A    argparse s= -- $argv\0A    set -l cmd (__fish_git_needs_command)\0A    set -l varname __fish_git_alias_(string escape --style=var -- $cmd)\0A    if set -q $varname\0A        echo -- $$varname | read -lat toks\0A        set toks (string replace -r '(-.*)=.*' '' -- $toks)\0A        for i in $argv\0A            if contains -- --$i $toks\0A                return 0\0A            end\0A        end\0A\0A        for i in $_flag_s\0A            if string match -qr -- \22^-$i|^-[^-]*$i\22 $toks\0A                return 0\0A            end\0A        end\0A    end\0A\0A    return 1\0Aend\0Afunction __fish_git_stash_using_command\0A    set -l cmd (commandline -xpc)\0A    __fish_git_using_command stash\0A    or return 2\0A    # The word after the stash command _must_ be the subcommand\0A    set cmd $cmd[(contains -i -- \22stash\22 $cmd)..-1]\0A    set -e cmd[1]\0A    set -q cmd[1]\0A    or return 1\0A    contains -- $cmd[1] $argv\0A    and return 0\0A    return 1\0Aend\0A\0Afunction __fish_git_stash_not_using_subcommand\0A    set -l cmd (commandline -xpc)\0A    __fish_git_using_command stash\0A    or return 2\0A    set cmd $cmd[(contains -i -- \22stash\22 $cmd)..-1]\0A    set -q cmd[2]\0A    and return 1\0A    return 0\0Aend\0A\0Afunction __fish_git_complete_worktrees\0A    __fish_git worktree list --porcelain | string replace --regex --filter '^worktree\\s*' ''\0Aend\0A\0Afunction __fish_git_complete_stashes\0A    __fish_git stash list --format=%gd:%gs 2>/dev/null | string replace \22:\22 \\t\0Aend\0A\0Afunction __fish_git_aliases\0A    __fish_git config -z --get-regexp '^alias\\.' 2>/dev/null | while read -lz key value\0A        begin\0A            set -l name (string replace -r '^.*\\.' '' -- $key)\0A            set -l val (string shorten --no-newline -m 36 -- $value)\0A            printf \22%s\\t%s\\n\22 $name \22alias: $val\22\0A        end\0A    end\0Aend\0A\0Afunction __fish_git_custom_commands\0A    # complete all commands starting with git-\0A    # however, a few builtin commands are placed into $PATH by git because\0A    # they're used by the ssh transport. We could filter them out by checking\0A    # if any of these completion results match the name of the builtin git commands,\0A    # but it's simpler just to blacklist these names. They're unlikely to change,\0A    # and the failure mode is we accidentally complete a plumbing command.\0A    for name in (string replace -r \22^.*/git-([^/]*)\22 '$1' $PATH/git-*)\0A        switch $name\0A            case cvsserver receive-pack shell upload-archive upload-pack\0A                # skip these\0A            case \\*\0A                echo $name\0A        end\0A    end\0Aend\0A\0A# Suggest branches for the specified remote - returns 1 if no known remote is specified\0Afunction __fish_git_branch_for_remote\0A    set -l remotes (__fish_git remote 2>/dev/null)\0A    set -l remote\0A    set -l cmd (commandline -xpc)\0A    for r in $remotes\0A        if contains -- $r $cmd\0A            set remote $r\0A            break\0A        end\0A    end\0A    set -q remote[1]\0A    or return 1\0A    __fish_git_branches | string replace -f -- \22$remote/\22 ''\0Aend\0A\0A# Return 0 if the current token is a possible commit-hash with at least 3 characters\0Afunction __fish_git_possible_commithash\0A    set -q argv[1]\0A    and set -l token $argv[1]\0A    or set -l token (commandline -ct)\0A    if string match -qr '^[0-9a-fA-F]{3,}$' -- $token\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_git_reflog\0A    __fish_git reflog --no-decorate 2>/dev/null | string replace -r '[0-9a-f]* (.+@\\{[0-9]+\\}): (.*)$' '$1\\t$2'\0Aend\0A\0Afunction __fish_git_help_all_concepts\0A    git help -g | string match -e -r '^   \\w+' | while read -l concept desc\0A        printf \22%s\\tConcept: %s\\n\22 $concept (string trim $desc)\0A    end\0Aend\0A\0Afunction __fish_git_diff_opt -a option\0A    switch $option\0A        case diff-algorithm\0A            printf \22%b\22 \22\0Adefault\\tBasic greedy diff algorithm\0Amyers\\tBasic greedy diff algorithm\0Aminimal\\tMake smallest diff possible\0Apatience\\tPatience diff algorithm\0Ahistogram\\tPatience algorithm with low-occurrence common elements\22\0A        case diff-filter\0A            printf \22%b\22 \22\0AA\\tAdded files\0AC\\tCopied files\0AD\\tDeleted files\0AM\\tModified files\0AR\\tRenamed files\0AT\\tType changed files\0AU\\tUnmerged files\0AX\\tUnknown files\0AB\\tBroken pairing files\22\0A        case dirstat\0A            printf \22%b\22 \22\0Achanges\\tCount lines that have been removed from the source / added to the destination\0Alines\\tRegular line-based diff analysis\0Afiles\\tCount the number of files changed\0Acumulative\\tCount changes in a child directory for the parent directory as well\22\0A        case ignore-submodules\0A            printf \22%b\22 \22\0Anone\\tUntracked/modified files\0Auntracked\\tNot considered dirty when they only contain untracked content\0Adirty\\tIgnore all changes to the work tree of submodules\0Aall\\tHide all changes to submodules (default)\22\0A        case submodule\0A            printf \22%b\22 \22\0Ashort\\tShow the name of the commits at the beginning and end of the range\0Alog\\tList the commits in the range\0Adiff\\tShow an inline diff of the changes\22\0A        case ws-error-highlight\0A            printf \22%b\22 \22\0Acontext\\tcontext lines of the diff\0Aold\\told lines of the diff\0Anew\\tnew lines of the diff\0Anone\\treset previous values\0Adefault\\treset the list to 'new'\0Aall\\tShorthand for 'old,new,context'\22\0A    end\0Aend\0A\0Afunction __fish_git_show_opt -a option\0A    switch $option\0A        case format pretty\0A            printf \22%b\22 \22\0Aoneline\\t<sha1> <title line>\0Ashort\\t<sha1> / <author> / <title line>\0Amedium\\t<sha1> / <author> / <author date> / <title> / <commit msg>\0Afull\\t<sha1> / <author> / <committer> / <title> / <commit msg>\0Afuller\\t<sha1> / <author> / <author date> / <committer> / <committer date> / <title> / <commit msg>\0Areference\\t<abbrev-hash> (<title-line>, <short-author-date>)\0Aemail\\t<sha1> <date> / <author> / <author date> / <title> / <commit msg>\0Amboxrd\\tLike email, but lines in the commit message starting with \\\22From \\\22 are quoted with \\\22>\\\22\0Araw\\tShow the entire commit exactly as stored in the commit object\0Aformat:\\tSpecify which information to show\0A\22\0A            __fish_git config -z --get-regexp '^pretty\\.' 2>/dev/null | while read -lz key value\0A                set -l name (string replace -r '^.*?\\.' '' -- $key)\0A                printf \22%s\\t%s\\n\22 $name $value\0A            end\0A    end\0Aend\0A\0Afunction __fish_git_is_rebasing\0A    test -e (__fish_git rev-parse --absolute-git-dir)/rebase-merge\0Aend\0A\0Afunction __fish_git_filters\0A    printf \22%s\\n\22 \\\0A        blob:none\\t\22omits all blobs\22 \\\0A        blob:limit=\\t\22omits blobs by size\22 \\\0A        object:type={tag,commit,tree,blob}\\t\22omit object which are not of the requested type\22 \\\0A        sparse:oid=\\t\22omit blobs not required for a sparse checkout\22 \\\0A        tree:\\t\22omits all blobs and trees\22\0Aend\0A\0A# general options\0Acomplete git -f -l help -s h -d 'Display manual of a Git command'\0Acomplete git -f -n __fish_git_needs_command -l version -s v -d 'display git version'\0Acomplete git -x -n __fish_git_needs_command -s C -a '(__fish_complete_directories)' -d 'run as if started in dir'\0Acomplete git -x -n __fish_git_needs_command -s c -a '(__fish_git config -l 2>/dev/null | string replace = \\t)' -d 'set config option (conf-key=val)'\0Acomplete git -x -n __fish_git_needs_command -l config-env -a '(__fish_git config -l 2>/dev/null | string replace = \\t)' -d 'like -c but environment var (conf-key=ENVVAR)'\0Acomplete git -x -n __fish_git_needs_command -l exec-path -a '(__fish_complete_directories)' -d 'get or set the path to git'\0Acomplete git -f -n __fish_git_needs_command -l html-path -d 'print html docs path'\0Acomplete git -f -n __fish_git_needs_command -l man-path -d 'print man pages path'\0Acomplete git -f -n __fish_git_needs_command -l info-path -d 'print info docs path'\0Acomplete git -f -n __fish_git_needs_command -s p -l paginate -d 'pipe output into pager'\0Acomplete git -f -n __fish_git_needs_command -s P -l no-pager -d 'don\\'t pipe output into pager'\0Acomplete git -r -n __