@anon.1d0b41a8d45d477c3029ec78f9b8b434.2666 = private unnamed_addr constant [7636 x i8] c"# Completion for builtin string\0A# This follows a strict command-then-options approach, so we can just test the number of tokens\0Acomplete -f -c string\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -le 2\22 -s h -l help -d \22Display help and exit\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22not contains -- (commandline -xpc)[2] escape collect pad\22 -s q -l quiet -d \22Do not print output\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a lower\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a upper\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a length\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] length\22 -s V -l visible -d \22Use the visible width, excluding escape sequences\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a sub\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] sub\22 -s s -l start -xa \22(seq 1 10)\22 -d \22Specify start index\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] sub\22 -s e -l end -xa \22(seq 1 10)\22 -d \22Specify end index\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] sub\22 -s l -l length -xa \22(seq 1 10)\22 -d \22Specify substring length\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a split\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a split0\0Acomplete -x -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr split0\\?\\$ -- (commandline -xpc)[2]' -s m -l max -a \22(seq 1 10)\22 -d \22Specify maximum number of splits\22\0Acomplete -x -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr split0\\?\\$ -- (commandline -xpc)[2]' -s f -l fields -a \22(seq 1 10)\22 -d \22Specify fields\22\0Acomplete -f -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr split0\\?\\$ -- (commandline -xpc)[2]' -s r -l right -d \22Split right-to-left\22\0Acomplete -f -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr split0\\?\\$ -- (commandline -xpc)[2]' -s n -l no-empty -d \22Empty results excluded\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a collect\0Acomplete -f -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr collect\\$ -- (commandline -xpc)[2]' -s N -l no-trim-newlines -d \22Don't trim trailing newlines\22\0Acomplete -f -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'string match -qr collect\\$ -- (commandline -xpc)[2]' -s a -l allow-empty -d \22Always print empty argument\22\0A\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a join\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a join0\0Acomplete -f -c string -n 'test (count (commandline -xpc)) -ge 2' -n 'contains -- (commandline -xpc)[2] join' -s n -l no-empty -d \22Empty strings excluded\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a trim\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] trim\22 -s l -l left -d \22Trim only leading chars\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] trim\22 -s r -l right -d \22Trim only trailing chars\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] trim\22 -s c -l chars -d \22Specify the chars to trim (default: whitespace)\22 -x\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a escape\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a unescape\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] escape; or contains -- (commandline -xpc)[2] unescape\22 -s n -l no-quoted -d \22Escape with \\\\ instead of quotes\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] escape; or contains -- (commandline -xpc)[2] unescape\22 -l style -d \22Specify escaping style\22 -xa \22\0A(printf '%s\\t%s\\n' script 'For use in scripts' \\\0A var 'For use as a variable name' \\\0A regex 'For string match -r, string replace -r' \\\0A url 'For use as a URL')\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a match\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match\22 -s n -l index -d \22Report index, length of match\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match\22 -s v -l invert -d \22Report only non-matches\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match\22 -s e -l entire -d \22Show entire matching lines\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match\22 -s g -l groups-only -d \22Only report capturing groups\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a replace\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] replace\22 -s f -l filter -d \22Report only actual replacements\22\0A# All replace options are also valid for match\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match replace\22 -s a -l all -d \22Report every match\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match replace\22 -s i -l ignore-case -d \22Case insensitive\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] match replace\22 -s r -l regex -d \22Use regex instead of globs\22\0A\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a repeat\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] repeat\22 -s n -l count -xa \22(seq 1 10)\22 -d \22Repetition count\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] repeat\22 -s m -l max -xa \22(seq 1 10)\22 -d \22Maximum number of printed chars\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] repeat\22 -s N -l no-newline -d \22Remove newline\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a pad\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] pad\22 -s r -l right -d \22Pad right instead of left\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] pad\22 -s c -l char -x -d \22Character to use for padding\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] pad\22 -s w -l width -x -d \22Integer width of the result, default is maximum width of inputs\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -lt 2\22 -a shorten\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] shorten\22 -s l -l left -d \22Remove from the left on\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] shorten\22 -s c -l char -x -d \22Characters to use as ellipsis\22\0Acomplete -x -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] shorten\22 -s m -l max -x -d \22Integer width of the result, default is minimum non-zero width of inputs\22\0Acomplete -f -c string -n \22test (count (commandline -xpc)) -ge 2\22 -n \22contains -- (commandline -xpc)[2] shorten\22 -s N -l no-newline -d \22Only keep one line of each input\22\0A", align 1
