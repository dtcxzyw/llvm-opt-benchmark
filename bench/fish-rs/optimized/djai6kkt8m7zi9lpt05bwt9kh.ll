@anon.1d0b41a8d45d477c3029ec78f9b8b434.2184 = private unnamed_addr constant [2000 x i8] c"set -l cmds list store restore stop-all start stop restart switch-to status enable disable reenable is-enabled edit\0A\0Afunction __fish_netctl_get_profiles\0A    command netctl list | string trim -l -c ' *'\\t\0Aend\0A\0Acomplete -f -c netctl -l help -d 'Display help'\0Acomplete -f -c netctl -l version -d 'Display version'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a list -d 'List available profiles'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a store -d 'Save which profiles are active'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a restore -d 'Load saved profiles'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a stop-all -d 'Stops all profiles'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a start -d 'Start a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a stop -d 'Stop a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a restart -d 'Restart a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a switch-to -d 'Switch to a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a status -d 'Show runtime status of a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a enable -d 'Enable the systemd unit for a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a disable -d 'Disable the systemd unit for a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a reenable -d 'Reenable the systemd unit for a profile'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a is-enabled -d 'Check whether the unit is enabled'\0Acomplete -f -c netctl -n \22not __fish_seen_subcommand_from $cmds\22 -a edit -d 'Open the specified profile in an editor'\0Acomplete -f -c netctl -n \22__fish_seen_subcommand_from start stop restart switch-to status enable disable reenable is-enabled edit\22 -a '(__fish_netctl_get_profiles)' -d Profile\0A", align 1
