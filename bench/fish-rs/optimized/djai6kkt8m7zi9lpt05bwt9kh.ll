@anon.1d0b41a8d45d477c3029ec78f9b8b434.1714 = private unnamed_addr constant [1742 x i8] c"complete -c gimp -s h -l help -d 'show help'\0Acomplete -c gimp -l help-all -d 'show help with advanced options'\0Acomplete -c gimp -l help-gtk -d 'show help with GTK+ options'\0Acomplete -c gimp -l help-gegl -d 'show help with GEGL options'\0Acomplete -c gimp -s v -l version -d 'show version'\0Acomplete -c gimp -l license -d 'show license'\0A\0Acomplete -c gimp -l verbose -d 'show verbosely'\0Acomplete -c gimp -s n -l new-instance -d 'open new instance'\0Acomplete -c gimp -s a -l as-new -d 'open with new images'\0A\0Acomplete -c gimp -s i -l no-interface -d 'hide UI'\0Acomplete -c gimp -s d -l no-data -d 'do not load patterns, gradients, palettes, and brushes'\0Acomplete -c gimp -s f -l no-fonts -d 'do not load fonts'\0Acomplete -c gimp -s s -l no-splash -d 'hide splash screen'\0Acomplete -c gimp -l no-shm -d 'do not use shared memory'\0Acomplete -c gimp -l no-cpu-accel -d 'do not use CPU acceleration'\0A\0Acomplete -c gimp -l display -d 'open with X display' -r\0Acomplete -c gimp -l session -d 'open with alternative sessionrc' -r\0Acomplete -c gimp -s g -l gimprc -d 'open with alternative gimprc' -r\0Acomplete -c gimp -l system-gimprc -d 'open with alternative system gimprc' -r\0Acomplete -c gimp -l dump-gimprc -d 'show gimprc'\0Acomplete -c gimp -l console-messages -d 'show messages on the console'\0Acomplete -c gimp -l debug-handlers -d 'enable debug handlers'\0Acomplete -c gimp -l stack-trace-mode -d 'whether generate stack-trace in case of fatal signals' -a 'never query always' -x\0Acomplete -c gimp -l pdb-compat-mode -d 'whether PDB provides aliases for deprecated functions' -a 'off on warn' -x\0Acomplete -c gimp -l batch-interpreter -d 'run procedure to use to process batch events' -r\0Acomplete -c gimp -s b -l batch -d 'run command non-interactively' -a - -r\0A", align 1
