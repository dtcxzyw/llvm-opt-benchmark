@anon.1d0b41a8d45d477c3029ec78f9b8b434.3408 = private unnamed_addr constant [193 x i8] c"# Use colours in diff output, if supported\0Aif command -vq diff; and command diff --color=auto /dev/null{,} >/dev/null 2>&1\0A    function diff\0A        command diff --color=auto $argv\0A    end\0Aend\0A", align 1
