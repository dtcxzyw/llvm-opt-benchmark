@anon.1d0b41a8d45d477c3029ec78f9b8b434.2292 = private unnamed_addr constant [4203 x i8] c"# Completion for builtin path\0A# This follows a strict command-then-options approach, so we can just test the number of tokens\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -le 2\22 -s h -l help -d \22Display help and exit\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a basename -d 'Give basename for given paths'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a dirname -d 'Give dirname for given paths'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a extension -d 'Give extension for given paths'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a change-extension -d 'Change extension for given paths'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a mtime -d 'Show modification time'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a normalize -d 'Normalize given paths (remove ./, resolve ../ against other components..)'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a resolve -d 'Normalize given paths and resolve symlinks'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a filter -d 'Print paths that match a filter'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a is -d 'Return true if any path matched a filter'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -lt 2\22 -a sort -d 'Sort paths'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2\22 -s q -l quiet -d \22Only return status, no output\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2\22 -s z -l null-in -d \22Handle NULL-delimited input\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2\22 -s Z -l null-out -d \22Print NULL-delimited output\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] basename\22 -s E -l no-extension -d \22Remove the extension\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s v -l invert -d \22Invert meaning of filters\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s t -l type -d \22Filter by type\22 -x -a '(__fish_append , file link dir block char fifo socket)'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s f -d \22Filter files\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s d -d \22Filter directories\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s l -d \22Filter symlinks\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s p -l perm -d \22Filter by permission\22 -x -a '(__fish_append , read write exec suid sgid user group)'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s r -d \22Filter readable paths\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s w -d \22Filter writable paths\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] filter is\22 -s x -d \22Filter executable paths\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] mtime\22 -s R -l relative -d \22Show seconds since the modification time\22\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] sort\22 \\\0A    -l key -x -a 'basename\\t\22Sort only by basename\22 dirname\\t\22Sort only by dirname\22 path\\t\22Sort by full path\22'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] sort\22 -s u -l unique -d 'Only leave the first of each run with the same key'\0Acomplete -f -c path -n \22test (count (commandline -xpc)) -ge 2; and contains -- (commandline -xpc)[2] sort\22 -s r -l reverse -d 'Reverse the order'\0A\0A# Turn on file completions again.\0A# match takes a glob as first arg, expand takes only globs.\0A# We still want files completed then!\0Acomplete -F -c path -n \22test (count (commandline -xpc)) -ge 2\22\0A", align 1
