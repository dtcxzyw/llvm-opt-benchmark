@anon.1d0b41a8d45d477c3029ec78f9b8b434.1656 = private unnamed_addr constant [4561 x i8] c"# Completions for flatpak, an \22Application deployment framework for desktop apps\22\0A\0Afunction __fish_flatpak_subcommands\0A    printf \22%s\\n\22 \\\0A        build-bundle\\t\22Create a bundle file from a build directory\22 \\\0A        build-commit-from\\t\22Create new commit based on existing ref\22 \\\0A        build-export\\t\22Export a build dir to a repository\22 \\\0A        build-finish\\t\22Finish a build dir for export\22 \\\0A        build-import-bundle\\t\22Import a bundle file\22 \\\0A        build-init\\t\22Initialize a directory for building\22 \\\0A        build-sign\\t\22Sign an application or runtime\22 \\\0A        build-update-repo\\t\22Update the summary file in a repository\22 \\\0A        build\\t\22Run a build command inside the build dir\22 \\\0A        config\\t\22Configure flatpak\22 \\\0A        create-usb\\t\22Put applications or runtimes onto removable media\22 \\\0A        document-export\\t\22Grant an application access to a specific file\22 \\\0A        document-info\\t\22Show information about a specific file\22 \\\0A        document-unexport\\t\22Revoke access to a specific file\22 \\\0A        documents\\t\22List exported files\22 \\\0A        enter\\t\22Enter the namespace of a running application\22 \\\0A        history\\t\22Show history\22 \\\0A        info\\t\22Show info for installed app or runtime\22 \\\0A        install\\t\22Install an application or runtime from a remote\22 \\\0A        kill\\t\22Stop a running application\22 \\\0A        list\\t\22List installed apps and/or runtimes\22 \\\0A        make-current\\t\22Specify default version to run\22 \\\0A        mask\\t\22Mask out updates and automatic installation\22 \\\0A        override\\t\22Override permissions for an application\22 \\\0A        permission-remove\\t\22Remove item from permission store\22 \\\0A        permission-reset\\t\22Reset app permissions\22 \\\0A        permission-set\\t\22Set permissions\22 \\\0A        permission-show\\t\22Show app permissions\22 \\\0A        permissions\\t\22List permissions\22 \\\0A        ps\\t\22Enumerate running applications\22 \\\0A        remote-add\\t\22Add a new remote repository (by URL)\22 \\\0A        remote-delete\\t\22Delete a configured remote\22 \\\0A        remote-info\\t\22Show information about a remote app or runtime\22 \\\0A        remote-ls\\t\22List contents of a configured remote\22 \\\0A        remote-modify\\t\22Modify properties of a configured remote\22 \\\0A        remotes\\t\22List all configured remotes\22 \\\0A        repair\\t\22Repair flatpak installation\22 \\\0A        repo\\t\22Show information about a repo\22 \\\0A        run\\t\22Run an application\22 \\\0A        search\\t\22Search for remote apps/runtimes\22 \\\0A        uninstall\\t\22Uninstall an installed application or runtime\22 \\\0A        update\\t\22Update an installed application or runtime\22\0Aend\0Acomplete -c flatpak -n __fish_is_first_token -xa \22(__fish_flatpak_subcommands)\22\0A\0A# A flatpak bug on some systems seems to cause it to assume output is a tty and always emit pretty-formatted output, with\0A# a variable number of spaces for alignment, trailing CR, and ANSI formatting sequences (see #10514).\0A#\0A# This wrapper function is akin to `flatpak $argv[1] $argv[2..]` but sanitizes the output to make it completion-friendly.\0Afunction __fish_flatpak\0A    # We can't rely on the first line being the headers because modern flatpak will omit it when running in a \22subshell\22.\0A    # Based off our invocations, we expect the first column of actual output to never contain a capitalized letter\0A    # (unlike the header row).\0A    flatpak $argv | string replace -rf '^([^A-Z].*?)(?: +|\\t)(.*?)\\s*$' '$1\\t$2'\0Aend\0A\0Afunction __fish_print_flatpak_packages\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A    set -l cache_file $xdg_cache_home/flatpak\0A    if test -f $cache_file\0A        cat $cache_file\0A        set -l age (path mtime -R -- $cache_file)\0A        set -l max_age 250\0A        if test $age -lt $max_age\0A            return\0A        end\0A    end\0A    __fish_cache_put $cache_file\0A    __fish_flatpak remote-ls --columns=application,name >$cache_file &\0A    return 0\0Aend\0A\0Acomplete -f -c flatpak -n \22__fish_seen_subcommand_from run\22 -a \22(__fish_flatpak list --app --columns=application,name)\22\0Acomplete -f -c flatpak -n \22__fish_seen_subcommand_from info uninstall\22 -a \22(__fish_flatpak list --columns=application,name)\22\0Acomplete -f -c flatpak -n \22__fish_seen_subcommand_from enter kill\22 -a \22(__fish_flatpak ps --columns=instance,application)\22\0Acomplete -f -c flatpak -n \22__fish_seen_subcommand_from remote-info remote-ls remote-modify remote-delete\22 -a \22(__fish_flatpak remotes --columns=name,title)\22\0A\0Acomplete -c flatpak -n '__fish_seen_subcommand_from install' -xa \22(__fish_print_flatpak_packages)\22\0A\0A# Plenty of the other stuff is too free-form to complete (e.g. remote-add).\0Acomplete -f -c flatpak -s h -l help\0A", align 1
