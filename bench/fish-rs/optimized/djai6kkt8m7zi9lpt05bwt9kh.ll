@anon.1d0b41a8d45d477c3029ec78f9b8b434.2436 = private unnamed_addr constant [951 x i8] c"function __fish_qdbus_complete\0A    argparse system 'bus=' literal help -- (commandline --cut-at-cursor --tokens-expanded) 2>/dev/null\0A    or return\0A    if set -q _flag_help\0A        return\0A    end\0A    set -l qdbus_flags $_flag_system\0A    if set -q _flag_bus\0A        set -a qdbus_flags --bus $_flag_bus\0A    end\0A    set argc (count $argv)\0A    if test $argc -le 3\0A        # avoid completion of property value\0A        qdbus $qdbus_flags $argv[2] $argv[3] | string replace --regex '^(?<kind>property\\ (read)?(write)?|signal|method( Q_NOREPLY)?) (?<type>(\\{.+\\})|([^\\ ]+)) (?<name>[^\\(]+)(?<arguments>\\(.+?\\))?' '$name\\t$kind $type $arguments' | string trim\0A    end\0Aend\0A\0Acomplete -c qdbus -f\0A\0Acomplete -c qdbus -l system -d 'connect to the system bus'\0Acomplete -c qdbus -l bus -r -d 'connect to a custom bus'\0Acomplete -c qdbus -l literal -d 'print replies literally'\0Acomplete -c qdbus -l help -d 'print usage'\0A\0Acomplete -c qdbus -a '(__fish_qdbus_complete)'\0A", align 1
