@anon.1d0b41a8d45d477c3029ec78f9b8b434.2428 = private unnamed_addr constant [3969 x i8] c"# This function adjusts for options with arguments (-X, -W, etc.), ensures completions stop when a script/module is set (-c, -m, file, -)\0Afunction __fish_python_no_arg\0A    set -l num 1\0A    set -l tokens (commandline -pxc)\0A    set -l has_arg_list -X -W --check-hash-based-pycs\0A    if contains -- - $tokens\0A        set num (math $num - 1)\0A    end\0A    for has_arg in $has_arg_list\0A        if contains -- $has_arg $tokens\0A            set num (math $num + 1)\0A        end\0A    end\0A    if test (__fish_number_of_cmd_args_wo_opts) -gt $num\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Acomplete -c python -n __fish_python_no_arg -s B -d 'Don\\'t write .py[co] files on import'\0Acomplete -c python -n __fish_python_no_arg -s c -x -d \22Execute argument as command\22\0Acomplete -c python -n __fish_python_no_arg -l check-hash-based-pycs -a \22default always never\22 -d \22Control validation behaviour of pyc files\22\0Acomplete -c python -n __fish_python_no_arg -s d -d \22Debug on\22\0Acomplete -c python -n __fish_python_no_arg -s E -d \22Ignore all PYTHON* env vars\22\0Acomplete -c python -n __fish_python_no_arg -s h -s '?' -l help -d \22Display help and exit\22\0Acomplete -c python -n __fish_python_no_arg -s i -d \22Interactive mode after executing commands\22\0Acomplete -c python -n __fish_python_no_arg -s m -d 'Run library module as a script (terminates option list)' -xa '(python -c \22import pkgutil; print(\\'\\n\\'.join([p[1] for p in pkgutil.iter_modules()]))\22)'\0Acomplete -c python -n __fish_python_no_arg -s O -d \22Enable optimizations\22\0Acomplete -c python -n __fish_python_no_arg -o OO -d \22Remove doc-strings in addition to the -O optimizations\22\0Acomplete -c python -n __fish_python_no_arg -s s -d 'Don\\'t add user site directory to sys.path'\0Acomplete -c python -n __fish_python_no_arg -s S -d \22Disable import of site module\22\0Acomplete -c python -n __fish_python_no_arg -s u -d \22Unbuffered input and output\22\0Acomplete -c python -n __fish_python_no_arg -s v -d \22Verbose mode\22\0Acomplete -c python -n __fish_python_no_arg -o vv -d \22Even more verbose mode\22\0Acomplete -c python -n __fish_python_no_arg -s V -l version -d \22Display version and exit\22\0Acomplete -c python -n __fish_python_no_arg -s W -x -d \22Warning control\22 -a \22ignore default all module once error\22\0Acomplete -c python -n __fish_python_no_arg -s x -d 'Skip first line of source, allowing use of non-Unix forms of #!cmd'\0Acomplete -c python -n __fish_python_no_arg -f -k -a \22(__fish_complete_suffix .py)\22\0Acomplete -c python -n __fish_python_no_arg -f -a - -d 'Read program from stdin'\0A\0A# Version-specific completions\0A# We have to detect this at runtime because pyenv etc can change\0A# what `python` refers to.\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s2\22' -s 3 -d 'Warn about Python 3.x incompatibilities that 2to3 cannot trivially fix'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s2\22' -s t -d \22Warn on mixed tabs and spaces\22\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s2\22' -s Q -x -a \22old new warn warnall\22 -d \22Division control\22\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -s q -d 'Don\\'t print version and copyright messages on interactive startup'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -s X -x -d 'Set implementation-specific option'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -s b -d 'Warn when comparing bytes with str or int'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -o bb -d 'Error when comparing bytes with str or int'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -s R -d 'Turn on hash randomization'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -s I -d 'Run in isolated mode'\0Acomplete -c python -n 'python -V 2>&1 | string match -rq \22^.*\\s3\22 && __fish_python_no_arg' -o VV -d 'Print further version info'\0A", align 1
