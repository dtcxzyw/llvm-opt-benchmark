@anon.1d0b41a8d45d477c3029ec78f9b8b434.3056 = private unnamed_addr constant [28315 x i8] c"# Fish completions for the ZFS `zpool` command\0A#\0A# Possible improvements:\0A# - Whenever possible, propose designation of vdevs using their GUID.\0A# - For eligible commands, with arguments of different types, only propose second type completions\0A#   after the first have been selected; for instance, only propose pool members for offline command.\0A# - This has been written mainly from manpages, which are known to be out-of-sync with the real\0A#   feature set; some discrepancies have been addressed, but it is highly likely that others still\0A#   lie.\0A\0Aset -l OS \22\22\0Aset -l freebsd_version \22\22\0Aswitch (uname)\0A    case Linux\0A        set OS Linux\0A    case Darwin\0A        set OS macOS\0A    case FreeBSD\0A        set OS FreeBSD\0A        set freebsd_version (uname -U)\0A    case SunOS\0A        set OS SunOS\0A        # Others?\0A    case \22*\22\0A        set OS unknown\0Aend\0A\0A# Certain functionality is exclusive to platforms using OpenZFS. This used to be just Linux, but it\0A# now includes FreeBSD 13 and above.\0Aif not type -q __fish_is_openzfs\0A    function __fish_is_openzfs --inherit-variable freebsd_version --inherit-variable OS\0A        test $OS = Linux || test $OS = FreeBSD -a $freebsd_version -gt 1300000\0A    end\0Aend\0A\0A# Does the current invocation need a command?\0Afunction __fish_zpool_needs_command\0A    not __fish_seen_subcommand_from \\? add attach clear create destroy detach events get history import iostat labelclear list offline online reguid reopen remove replace scrub set split status upgrade\0Aend\0A\0Afunction __fish_zpool_using_command # zpool command whose completions are looked for\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1 # The token can only be 'zpool', so skip\0A        return 2\0A    end\0A    if test $cmd[2] = $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_zpool_list_used_vdevs -a pool\0A    # See discussion and variants discussed at\0A    # https://github.com/fish-shell/fish-shell/pull/5743#pullrequestreview-217432149\0A    zpool list -Hv $pool | string replace -rf \22^\\t([^\\t]+).*\22 '$1' | string match -rv '^(spare|log|cache|mirror|raidz.?)'\0Aend\0A\0Afunction __fish_zpool_list_available_vdevs -V OS\0A    if test $OS = Linux\0A        find /dev -type b | string replace /dev/ ''\0A    else if test $OS = FreeBSD\0A        sysctl -an kern.disks | string split ' '\0A    else if test $OS = SunOS\0A        find /dev/dsk -type b | string replace /dev/ ''\0A    end\0Aend\0A\0Afunction __fish_zpool_complete_vdevs\0A    # As this function is to be called for completions only when necessary, we don't need to verify\0A    # that it is relevant for the specified command; this is to be decided by calling, or not, the\0A    # current function for command completions.\0A    # We can display the physical devices, as they are relevant whereas we are in a vdev definition\0A    # or not. Many operations need this list of vdevs winnowed down to some precondition (mostly\0A    # \22vdevs associated with pool\22 or \22vdevs not associated with pool\22) but it's not really feasible\0A    # to do that here as the situations are highly subcommand-dependent and this function is\0A    # structured to operate backwards only analyzing the subcommand at the very end. Long story\0A    # short, that vdev filtering will need to happen at the call site, at least currently.\0A    __fish_zpool_list_available_vdevs\0A\0A    # First, reverse token list to analyze it from the end\0A    set -l tokens 0\0A    for i in (commandline -cx)[-1..1]\0A        switch $i\0A            case spare log cache # At least 1 item expected\0A                if test $tokens -ge 1\0A                    __fish_zpool_list_vdev_types\0A                end\0A                return\0A            case mirror raidz raidz1 # At least 2 items expected\0A                if test $tokens -ge 2\0A                    __fish_zpool_list_vdev_types\0A                end\0A                return\0A            case raidz2 # At least 3 items expected\0A                if test $tokens -ge 3\0A                    __fish_zpool_list_vdev_types\0A                end\0A                return\0A            case raidz3 # At least 4 items expected\0A                if test $tokens -ge 4\0A                    __fish_zpool_list_vdev_types\0A                end\0A                return\0A                # Here, we accept any possible zpool command; this way, the developer will not have\0A                # to augment or reduce the list when adding the current function to or removing it\0A                # from the completions for the said command.\0A            case \\? add attach clear create destroy detach events get history import iostat labelclear list offline online reguid reopen remove replace scrub set split status upgrade\0A                __fish_zpool_list_vdev_types\0A                return\0A            case \22\22 # Au cas o\C3\B9\0A                echo \22\22 >/dev/null\0A            case \22-*\22 \22*=*\22 \22*,*\22\0A                # The token is an option or an option argument; as no option uses a vdev as its\0A                # argument, we can abandon commandline parsing.\0A                __fish_zpool_list_vdev_types\0A                return\0A        end\0A        set tokens (math $tokens+1)\0A    end\0Aend\0A\0Afunction __fish_zpool_list_get_fields\0A    echo -e \22name\\tPool full name\22\0A    echo -e \22property\\tProperty\22\0A    echo -e \22value\\tProperty value\22\0A    echo -e \22source\\tProperty value origin\22\0Aend\0A\0Afunction __fish_zpool_list_vdev_types\0A    echo -e \22mirror\\tMirror of at least two devices\22\0A    echo -e \22raidz\\tZFS RAID-5 variant, single parity\22\0A    echo -e \22raidz1\\tZFS RAID-5 variant, single parity\22\0A    echo -e \22raidz2\\tZFS RAID-5 variant, double parity\22\0A    echo -e \22raidz3\\tZFS RAID-5 variant, triple parity\22\0A    echo -e \22spare\\tPseudo vdev for pool hot spares\22\0A    echo -e \22log\\tSLOG device\22\0A    echo -e \22cache\\tL2ARC device\22\0Aend\0A\0Afunction __fish_zpool_list_ro_properties -V OS\0A    echo -e \22alloc\\tPhysically allocated space\22\0A    if contains -- $OS SunOS Linux\0A        echo -e \22available\\tAvailable space\22\0A        echo -e \22avail\\tAvailable space\22\0A    end\0A    if test $OS = SunOS\0A        echo -e \22bootsize\\tSystem boot partition size\22\0A    end\0A    echo -e \22capacity\\tUsage percentage of pool\22\0A    echo -e \22dedupratio\\tDeduplication ratio\22\0A    echo -e \22expandsize\\tAmount of uninitialized space within the pool\22\0A    echo -e \22fragmentation\\tFragmentation percentage of pool\22\0A    echo -e \22free\\tFree pool space\22\0A    echo -e \22freeing\\tRemaining pool space to be freed\22\0A    echo -e \22guid\\tPool GUID\22\0A    echo -e \22health\\tCurrent pool health\22\0A    echo -e \22size\\tTotal pool space\22\0A    echo -e \22used\\tUsed pool space\22\0A    # Unsupported features\0A    zpool list -o all | head -n1 | string replace -ra ' +' '\\n' | string lower | string match -r unsupported\0Aend\0A\0Afunction __fish_zpool_list_device_properties\0A    echo -e \22ashift\\tPool sector size exponent (COUNT)\22\0Aend\0A\0Afunction __fish_zpool_list_writeonce_properties\0A    echo -e \22altroot\\tAlternate root directory (PATH)\22\0Aend\0A\0Afunction __fish_zpool_list_importtime_properties\0A    echo -e \22altroot\\tAlternate root directory (PATH)\22\0A    echo -e \22readonly\\tImport pool in read-only mode (on, off)\22\0A    echo -e \22rdonly\\tImport pool in read-only mode (on, off)\22\0Aend\0A\0Afunction __fish_zpool_list_rw_properties\0A    echo -e \22autoexpand\\tAutomatic pool expansion on LUN growing (on, off)\22\0A    echo -e \22expand\\tAutomatic pool expansion on LUN growing (on, off)\22\0A    echo -e \22autoreplace\\tAutomatic use of replacement device (on, off)\22\0A    echo -e \22replace\\tAutomatic use of replacement device (on, off)\22\0A    echo -e \22bootfs\\tDefault bootable dataset (POOL/DATASET)\22\0A    echo -e \22cachefile\\tPool configuration cache (PATH, none, '')\22\0A    echo -e \22comment\\tComment about the pool (COMMENT)\22\0A    echo -e \22dedupditto\\tThreshold for writing a ditto copy of deduplicated blocks (COUNT)\22\0A    echo -e \22delegation\\tAllow rights delegation on the pool (on, off)\22\0A    echo -e \22failmode\\tBehavior in case of catastrophic pool failure (wait, continue, panic)\22\0A    echo -e \22listsnaps\\tDisplay snapshots even if 'zfs list' does not use '-t' (on, off)\22\0A    echo -e \22version\\tOn-disk version of pool (VERSION)\22\0A    # Feature properties\0A    zpool list -o all | string replace -ra ' +' '\\n' | string lower | string replace -rf '^feature@(.*)' '$1'\0Aend\0A\0Acomplete -c zpool -f -n __fish_zpool_needs_command -s '?' -d 'Display a help message'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a add -d 'Add new virtual devices to pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a attach -d 'Attach virtual device to a pool device'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a clear -d 'Clear devices errors in pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a create -d 'Create a new storage pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a destroy -d 'Destroy a storage pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a detach -d 'Detach virtual device from a mirroring pool'\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n __fish_zpool_needs_command -a events -d 'Display pool event log'\0Aend\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a export -d 'Export a pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a get -d 'Get one or several pool properties'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a history -d 'Display pool command history'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a import -d 'List importable pools, or import some'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a iostat -d 'Display pool I/O stats'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a labelclear -d 'Remove ZFS label information from the specified device'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a list -d 'List pools with health status and space usage'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a offline -d 'Take the specified devices offline'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a online -d 'Bring the specified devices back online'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a reguid -d 'Reset pool GUID'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a remove -d 'Remove virtual devices from pool'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a reopen -d 'Reopen pool devices'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a replace -d 'Replace a pool virtual device'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a scrub -d 'Start or stop scrubbing'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a set -d 'Set a pool property'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a split -d 'Create a pool by splitting an existing mirror one'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a status -d 'Display detailed pool health status'\0Acomplete -c zpool -f -n __fish_zpool_needs_command -a upgrade -d 'List upgradeable pools, or upgrade one'\0A\0A# add completions\0Acomplete -c zpool -f -n '__fish_zpool_using_command add' -s f -d 'Force use of virtual device'\0Acomplete -c zpool -f -n '__fish_zpool_using_command add' -s n -d 'Dry run: only display resulting configuration'\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n '__fish_zpool_using_command add' -s g -d 'Display virtual device GUID instead of device name'\0A    complete -c zpool -f -n '__fish_zpool_using_command add' -s L -d 'Resolve device path symbolic links'\0A    complete -c zpool -f -n '__fish_zpool_using_command add' -s P -d 'Display device full path'\0A    complete -c zpool -x -n '__fish_zpool_using_command add' -s o -d 'Pool property' -a '(__fish_zpool_list_device_properties)'\0Aend\0Acomplete -c zpool -x -n '__fish_zpool_using_command add; and __fish_is_nth_token 2' -d 'Pool to add virtual device(s) to' -a '(__fish_complete_zfs_pools)'\0A# complete -c zpool -x -n '__fish_zpool_using_command add; and not __fish_prev_arg_in add' -d 'Virtual device to add' -a '(__fish_zpool_complete_vdevs)'\0A# Exclude devices already part of this pool, and devices already in any other pool unless\0A# `zpool add -f` was used.\0Acomplete -c zpool -x -n '__fish_zpool_using_command add; and not __fish_prev_arg_in add' -k -d 'Virtual device to add' -a '(__fish_zpool_complete_vdevs | string match -vr (__fish_zpool_list_used_vdevs (__fish_seen_argument -s f && __fish_nth_token 2) | string escape --style regex | string replace -r \\'(.*)\\' \\'^$1\\\\\\\\\\\\$\\' | string join \22|\22))' # the insane number of backslashes is unfortunate\0A\0A# attach completions\0Acomplete -c zpool -f -n '__fish_zpool_using_command attach' -s f -d 'Force use of virtual device'\0Aif __fish_is_openzfs\0A    complete -c zpool -x -n '__fish_zpool_using_command attach' -s o -d 'Pool property' -a '(__fish_zpool_list_device_properties)'\0Aend\0A# The ideal behavior for attach is as follows:\0A# - zpool attach [should list only pools]\0A# - zpool attach <tank> [should list only devices already part of pool]\0A# - zpool attach <tank> <da1> [should list only devices not already part of a/the pool]\0Acomplete -c zpool -x -n '__fish_zpool_using_command attach; and __fish_is_nth_token 2' -d 'Pool to attach virtual device to' -a '(__fish_complete_zfs_pools)'\0Acomplete -c zpool -x -n '__fish_zpool_using_command attach; and __fish_is_nth_token 3' -d 'Existing pool device to attach to' -a '(__fish_zpool_list_used_vdevs (__fish_nth_token 2))'\0A# Generate a list of devices in the system modulo devices already part of an online zpool.\0A# These latter can be forcefully added, so we only exclude them if we don't introspect the presence\0A# of a `-f` argument to `zpool attach` (but still exclude any devices already part of the same pool\0A# that we're attaching to, \22obviously\22).\0Acomplete -c zpool -x -n '__fish_zpool_using_command attach; and __fish_is_nth_token 4' -d 'Device to be attached' -a '(__fish_zpool_list_available_vdevs | string match -vr (__fish_zpool_list_used_vdevs (__fish_seen_argument -s f && __fish_nth_token 2) | string escape --style regex | string replace -r \\'(.*)\\' \\'^$1\\\\\\\\\\\\$\\' | string join \22|\22))' # the insane number of backslashes is unfortunate\0A\0A# clear completions\0Aif test $OS = FreeBSD\0A    complete -c zpool -f -n '__fish_zpool_using_command clear' -s F -d 'Initiate recovery mode'\0A    complete -c zpool -f -n '__fish_zpool_using_command clear; and __fish_contains_opt -s F' -s n -d 'Dry run: only determine if the recovery is possible, without attempting it'\0Aend\0Acomplete -c zpool -x -n '__fish_zpool_using_command clear' -d 'Pool to clear errors on' -a '(__fish_complete_zfs_pools)'\0Acomplete -c zpool -f -n '__fish_zpool_using_command clear' -d 'Virtual device to operate on' -a '(__fish_zpool_list_used_vdevs)'\0A\0A# create completions\0Aif test $OS = SunOS\0A    complete -c zpool -f -n '__fish_zpool_using_command create' -s B -d 'Create whole disk pool with EFI System partition to support booting system with UEFI firmware'\0Aelse\0A    complete -c zpool -f -n '__fish_zpool_using_command create' -s f -d 'Force use of virtual device'\0Aend\0Acomplete -c zpool -f -n '__fish_zpool_using_command create' -s n -d 'Dry run, only display resulting configuration'\0Acomplete -c zpool -f -n '__fish_zpool_using_command create' -s d -d 'Do not enable any feature on the new pool'\0Acomplete -c zpool -x -n '__fish_zpool_using_command create' -s o -d 'Pool property' -a '(__fish_zpool_list_writeonce_properties; __fish_zpool_list_rw_properties)'\0Acomplete -c zpool -x -n '__fish_zpool_using_command create' -s O -d 'Root filesystem property' -a '(__fish_complete_zfs_ro_properties; __fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties)'\0Acomplete -c zpool -r -n '__fish_zpool_using_command create' -s R -d 'Equivalent to \22-o cachefile=none,altroot=ROOT\22'\0Acomplete -c zpool -x -n '__fish_zpool_using_command create' -s m -d 'Root filesystem mountpoint' -a 'legacy none'\0Aif __fish_is_openzfs\0A    complete -c zpool -x -n '__fish_zpool_using_command create' -s t -d 'Set a different in-core pool name'\0Aend\0Acomplete -c zpool -x -n '__fish_zpool_using_command create' -d 'Virtual device to add' -a '(__fish_zpool_complete_vdevs)'\0A\0A# destroy completions\0Acomplete -c zpool -f -n '__fish_zpool_using_command destroy' -s f -d 'Force unmounting of all contained datasets'\0Acomplete -c zpool -x -n '__fish_zpool_using_command destroy' -d 'Pool to destroy' -a '(__fish_complete_zfs_pools)'\0A\0A# detach completions\0Acomplete -c zpool -x -n '__fish_zpool_using_command clear' -d 'Pool to detach device from' -a '(__fish_complete_zfs_pools)'\0Acomplete -c zpool -x -n '__fish_zpool_using_command clear' -d 'Physical device to detach' -a '(__fish_zpool_list_used_vdevs)'\0A\0A# events completions\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n '__fish_zpool_using_command events' -s v -d 'Print verbose event information'\0A    complete -c zpool -f -n '__fish_zpool_using_command events' -s H -d 'Print output in a machine-parsable format'\0A    complete -c zpool -f -n '__fish_zpool_using_command events' -s f -d 'Output appended data as the log grows'\0A    complete -c zpool -f -n '__fish_zpool_using_command events' -s c -d 'Clear all previous events'\0A    complete -c zpool -f -n '__fish_zpool_using_command events' -d 'Pool to read events from' -a '(__fish_complete_zfs_pools)'\0Aend\0A\0A# export completions\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n '__fish_zpool_using_command export' -s a -d 'Export all pools'\0Aend\0Acomplete -c zpool -f -n '__fish_zpool_using_command export' -s f -d 'Force unmounting of all contained datasets'\0Acomplete -c zpool -x -n '__fish_zpool_using_command export' -d 'Pool to export' -a '(__fish_complete_zfs_pools)'\0A\0A# get completions\0Acomplete -c zpool -f -n '__fish_zpool_using_command get' -s p -d 'Print parsable (exact) values for numbers'\0Acomplete -c zpool -f -n '__fish_zpool_using_command get' -s H -d 'Print output in a machine-parsable format'\0Aif contains -- $OS FreeBSD SunOS\0A    complete -c zpool -x -n '__fish_zpool_using_command get' -s o -d 'Fields to display' -a '(__fish_append , (__fish_zpool_list_get_fields))'\0Aend\0Acomplete -c zpool -x -n '__fish_zpool_using_command get' -d 'Properties to get' -a '(__fish_append , (__fish_zpool_list_importtime_properties; __fish_zpool_list_rw_properties; __fish_zpool_list_writeonce_properties; __fish_zpool_list_ro_properties; __fish_zpool_list_device_properties; echo -e \22all\\tAll properties\22))'\0Acomplete -c zpool -x -n '__fish_zpool_using_command get' -d 'Pool to get properties of' -a '(__fish_complete_zfs_pools)'\0A\0A# history completions\0Acomplete -c zpool -f -n '__fish_zpool_using_command history' -s i -d 'Also display internal events'\0Acomplete -c zpool -f -n '__fish_zpool_using_command history' -s l -d 'Display log records using long format'\0Acomplete -c zpool -f -n '__fish_zpool_using_command history' -d 'Pool to get command history of' -a '(__fish_complete_zfs_pools)'\0A\0A# import completions\0Acomplete -c zpool -r -n '__fish_zpool_using_command import; and __fish_not_contain_opt -s d' -s c -d 'Read configuration from specified cache file'\0Acomplete -c zpool -r -n '__fish_zpool_using_command import; and __fish_not_contain_opt -s c' -s d -d 'Search for devices or files in specified directory'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s D -d 'List or import destroyed pools only (requires -f for importation)'\0Acomplete -c zpool -x -n '__fish_zpool_using_command import' -s o -d 'Mount properties for contained datasets' -a '(__fish_append , (__fish_complete_zfs_mountpoint_properties))'\0Acomplete -c zpool -x -n '__fish_zpool_using_command import' -s o -d 'Properties of the imported pool' -a '(__fish_complete_zfs_mountpoint_properties; __fish_zpool_list_importtime_properties; __fish_zpool_list_rw_properties)'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s f -d 'Force import'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s F -d 'Recovery mode'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s a -d 'Search for and import all pools found'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s m -d 'Ignore missing log device (risk of loss of last changes)'\0Acomplete -c zpool -r -n '__fish_zpool_using_command import' -s R -d 'Equivalent to \22-o cachefile=none,altroot=ROOT\22'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import' -s N -d 'Do not mount contained filesystems'\0Acomplete -c zpool -f -n '__fish_zpool_using_command import; and __fish_contains_opt -s F' -s n -d 'Dry run: only determine if the recovery is possible, without attempting it'\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n '__fish_zpool_using_command import; and __fish_contains_opt -s F' -s X -d 'Roll back to a previous TXG (hazardous)'\0A    complete -c zpool -r -n '__fish_zpool_using_command import' -s T -d 'TXG to roll back to (implies -FX)'\0A    complete -c zpool -f -n '__fish_zpool_using_command import' -s t -d 'Specify, as the last argument, a temporary pool name'\0Aend\0Acomplete -c zpool -f -n '__fish_zpool_using_command import; and __fish_not_contain_opt -s a' -d 'Pool to import' -a '(__fish_complete_zfs_pools)'\0A\0A# iostat completions\0Acomplete -c zpool -x -n '__fish_zpool_using_command iostat' -s T -d 'Display a timestamp using specified format'\0Aif __fish_is_openzfs\0A    complete -c zpool -f -n '