@anon.1d0b41a8d45d477c3029ec78f9b8b434.2572 = private unnamed_addr constant [740 x i8] c"complete -c scrot -s h -l help -d 'Display help and exit'\0Acomplete -c scrot -s v -l version -d 'Display version information and exit'\0Acomplete -c scrot -s b -l border -d 'When selecting a window, grab wm border too'\0Acomplete -c scrot -s c -l count -d 'Display a countdown when used with delay'\0Acomplete -c scrot -s d -l delay -d 'Wait NUMBER of seconds before taking a shot'\0Acomplete -c scrot -s e -l exec -d 'Execute APPLICATION on the saved image'\0Acomplete -c scrot -s q -l quality -d 'Image quality [1-100]'\0Acomplete -c scrot -s m -l multidisp -d 'Grab shot from multiple heads'\0Acomplete -c scrot -s s -l select -d 'Select a window or rectangle with the mouse'\0Acomplete -c scrot -s t -l thumb -d 'Generate thumbnail PERCENT of original'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2573 = private unnamed_addr constant [23 x i8] c"completions/scrypt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2574 = private unnamed_addr constant [1852 x i8] c"# Completions for the scrypt encryption utility\0A\0Acomplete -x -c scrypt -n __fish_use_subcommand -a enc -d \22Encrypt file\22\0Acomplete -x -c scrypt -n __fish_use_subcommand -a dec -d \22Decrypt file\22\0Acomplete -x -c scrypt -n __fish_use_subcommand -a info -d \22Print information about the encryption parameters\22\0A\0Acomplete -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s f -d \22Force the operation to proceed\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -l logN -a \22(seq 10 40)\22 -d \22Set the work parameter N\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s M -d \22Use at most the specified bytes of RAM\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s m -d \22Use at most the specified fraction of the available RAM\22\0Acomplete -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s P -d \22Deprecated synonym for `--passphrase dev:stdin-once`\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s p -a \22(seq 1 32)\22 -d \22Set the work parameter p\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -l passphrase -a \22\0A    dev:tty-stdin\\t'Read from /dev/tty, or stdin if fails (default)'\0A    dev:stdin-once\\t'Read from stdin'\0A    dev:tty-once\\t'Read from /dev/tty'\0A    env:(set -xn)\\t'Read from the environment variable'\0A    file:(__fish_complete_path)\\t'Read from the file'\0A    \22 -d \22Read the passphrase using the specified method\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s r -a \22(seq 1 32)\22 -d \22Set the work parameter r\22\0Acomplete -x -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s t -d \22Use at most the specified seconds of CPU time\22\0Acomplete -c scrypt -n \22__fish_seen_subcommand_from enc dec\22 -s v -d \22Print encryption parameters and memory/CPU limits\22\0Acomplete -x -c scrypt -n \22not __fish_seen_subcommand_from enc dec info\22 -l version -d \22Print version\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2575 = private unnamed_addr constant [21 x i8] c"completions/scss.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2576 = private unnamed_addr constant [5655 x i8] c"# Usage: scss [options] [INPUT] [OUTPUT]\0A\0A# Description:\0A#   Converts SCSS or Sass files to CSS.\0A\0A# Common Options:\0A#     -I, --load-path PATH             Specify a Sass import path.\0Acomplete -c scss -s I -l load-path -r -d \22Specify a Sass import path\22\0A#     -r, --require LIB                Require a Ruby library before running Sass.\0Acomplete -c scss -s r -l require -r -d \22Require a Ruby library before running Sass\22\0A#         --compass                    Make Compass imports available and load project configuration.\0Acomplete -c scss -l compass -d \22Enable Compass imports and load project configuration\22\0A#     -t, --style NAME                 Output style. Can be nested (default), compact, compressed, or expanded.\0Acomplete -c scss -s t -l style -x -a \22nested compact compressed expanded\22 -d \22Output style\22\0A#     -?, -h, --help                   Show this help message.\0Acomplete -c scss -s '?' -s h -l help -f -d \22Show help message\22\0A#     -v, --version                    Print the Sass version.\0Acomplete -c scss -s v -l version -f -d \22Print the Sass version\22\0A\0A# Watching and Updating:\0A#         --watch                      Watch files or directories for changes.\0A#                                      The location of the generated CSS can be set using a colon:\0A#                                        scss --watch input.scss:output.css\0A#                                        scss --watch input-dir:output-dir\0Acomplete -c scss -l watch -d \22Watch files or directories for changes\22\0A#         --poll                       Check for file changes manually, rather than relying on the OS.\0A#                                      Only meaningful for --watch.\0Acomplete -c scss -l poll -d \22Check for file changes manually, don't rely on OS\22\0A#         --update                     Compile files or directories to CSS.\0A#                                      Locations are set like --watch.\0Acomplete -c scss -l update -d \22Compile files or directories to CSS\22\0A#     -f, --force                      Recompile every Sass file, even if the CSS file is newer.\0A#                                      Only meaningful for --update.\0Acomplete -c scss -s f -l force -d \22Recompile every Sass file, even if the CSS file is newer\22\0A#         --stop-on-error              If a file fails to compile, exit immediately.\0A#                                      Only meaningful for --watch and --update.\0Acomplete -c scss -l stop-on-error -d \22If a file fails to compile, exit immediately\22\0A\0A# Input and Output:\0A#         --sass                       Use the indented Sass syntax.\0Acomplete -c scss -l sass -d \22Use the indented Sass syntax\22\0A#         --sourcemap=TYPE             How to link generated output to the source files.\0A#                                        auto (default): relative paths where possible, file URIs elsewhere\0A#                                        file: always absolute file URIs\0A#                                        inline: include the source text in the sourcemap\0A#                                        none: no sourcemaps\0Acomplete -c scss -l sourcemap -x -d \22How to link generated output to the source files\22 -a \\\0A    \22auto\\t'(default) relative paths where possible, file URIs elsewhere'\0Afile\\t'always absolute file URIs'\0Ainline\\t'include the source text in the sourcemap'\0Anone\\t'no sourcemaps'\22\0A#     -s, --stdin                      Read input from standard input instead of an input file.\0A#                                      This is the default if no input file is specified.\0Acomplete -c scss -s s -l stdin -d \22Read input from standard input instead of an input file\22\0A#     -E, --default-encoding ENCODING  Specify the default encoding for input files.\0Acomplete -c scss -s E -l default-encoding -x -d \22Specify the default encoding for input files\22\0A#         --unix-newlines              Use Unix-style newlines in written files.\0A#                                      Always true on Unix.\0Acomplete -c scss -l unix-newlines -d \22Use Unix-style newlines in written files\22\0A#     -g, --debug-info                 Emit output that can be used by the FireSass Firebug plugin.\0Acomplete -c scss -s g -l debug-info -d \22Emit output that can be used by the FireSass Firebug plugin\22\0A#     -l, --line-numbers               Emit comments in the generated CSS indicating the corresponding source line.\0A#         --line-comments\0Acomplete -c scss -s l -l line-numbers -l line-comments -d \22Indicate corresponding source line with comments\22\0A\0A# Miscellaneous:\0A#     -i, --interactive                Run an interactive SassScript shell.\0Acomplete -c scss -s i -l interactive -d \22Run an interactive SassScript shell\22\0A#     -c, --check                      Just check syntax, don't evaluate.\0Acomplete -c scss -s c -l check -d \22Just check syntax, don't evaluate\22\0A#         --precision NUMBER_OF_DIGITS How many digits of precision to use when outputting decimal numbers.\0A#                                      Defaults to 5.\0Acomplete -c scss -l precision -x -d \22Set precision when outputting decimal numbers\22\0A#         --cache-location PATH        The path to save parsed Sass files. Defaults to .sass-cache.\0Acomplete -c scss -l cache-location -r -d \22The path to save parsed Sass files\22\0A#     -C, --no-cache                   Don't cache parsed Sass files.\0Acomplete -c scss -s C -l no-cache -d \22Don't cache parsed Sass files\22\0A#         --trace                      Show a full Ruby stack trace on error.\0Acomplete -c scss -l trace -d \22Show a full Ruby stack trace on error\22\0A#     -q, --quiet                      Silence warnings and status messages during compilation.\0Acomplete -c scss -s q -l quiet -d \22Silence warnings and status messages during compilation\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2577 = private unnamed_addr constant [20 x i8] c"completions/sed.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2578 = private unnamed_addr constant [1307 x i8] c"#\0A# Completions for sed\0A#\0A\0A# Test if we are using GNU sed\0A\0Aset -l is_gnu\0Ased --version >/dev/null 2>/dev/null; and set is_gnu --is-gnu\0A\0A# Shared ls switches\0A\0A__fish_gnu_complete -c sed -s n -l quiet -d \22Silent mode\22 $is_gnu\0A__fish_gnu_complete -c sed -s e -l expression -x -d \22Evaluate expression\22 $is_gnu\0A__fish_gnu_complete -c sed -s f -l file -r -d \22Evaluate file\22 $is_gnu\0A__fish_gnu_complete -c sed -s i -l in-place -d \22Edit files in place\22 $is_gnu\0A\0Aif test -n \22$is_gnu\22\0A\0A    # GNU specific features\0A\0A    complete -c sed -l silent -d \22Silent mode\22\0A    complete -c sed -s l -l line-length -x -d \22Specify line-length\22\0A    complete -c sed -l posix -d \22Disable all GNU extensions\22\0A    complete -c sed -s r -l regexp-extended -d \22Use extended regexp\22\0A    complete -c sed -s s -l separate -d \22Consider files as separate\22\0A    complete -c sed -s u -l unbuffered -d \22Use minimal IO buffers\22\0A    complete -c sed -l help -d \22Display help and exit\22\0A    complete -c sed -s V -l version -d \22Display version and exit\22\0A\0Aelse\0A\0A    # If not a GNU system, assume we have standard BSD ls features instead\0A\0A    complete -c sed -s E -d \22Use extended regexp\22\0A    complete -c sed -s a -d \22Delay opening files until a command containing the related 'w' function is applied\22\0A    complete -c sed -s l -d \22Use line buffering\22\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2579 = private unnamed_addr constant [20 x i8] c"completions/seq.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2580 = private unnamed_addr constant [676 x i8] c"if seq --version 2>/dev/null >/dev/null #GNU\0A    complete -c seq -s f -l format -d 'Use printf style floating-point FORMAT'\0A    complete -c seq -s s -l separator -d 'Use STRING to separate numbers'\0A    complete -c seq -s w -l equal-width -d 'Equalize width with leading zeroes'\0A    complete -c seq -l help -d 'Display this help'\0A    complete -c seq -l version -d 'Output version information'\0Aelse #OS X\0A    complete -c seq -s f -d 'Use printf style floating-point FORMAT'\0A    complete -c seq -s s -d 'Use STRING to separate numbers'\0A    complete -c seq -s w -d 'Equalize width with leading zeroes'\0A    complete -c seq -s t -d 'Use STRING to terminate sequence of numbers'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2581 = private unnamed_addr constant [22 x i8] c"completions/serve.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2582 = private unnamed_addr constant [585 x i8] c"# See: https://github.com/zeit/serve\0A\0Acomplete -x -c serve -l help -s h -d \22Shows help message\22\0Acomplete -x -c serve -l version -s v -d \22Displays the current version of serve\22\0Acomplete -x -c serve -l listen -s l -d \22Specify a URI endpoint on which to listen\22\0Acomplete -x -c serve -l debug -s d -d \22Show debugging information\22\0Acomplete -x -c serve -l single -s s -d \22Rewrite all not-found requests to `index.html`\22\0Acomplete -x -c serve -l config -s c -d \22Specify custom path to `serve.json`\22\0Acomplete -x -c serve -l no-clipboard -s n -d \22Do not copy the local address to the clipboard\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2583 = private unnamed_addr constant [24 x i8] c"completions/service.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2584 = private unnamed_addr constant [1466 x i8] c"# First argument is the names of the service, i.e. a file in /etc/init.d\0Acomplete -c service -n \22__fish_is_nth_token 1\22 -xa \22(__fish_print_service_names)\22 -d Service\0A\0A# as found in __fish_print_service_names.fish\0Aif test -d /run/systemd/system # Systemd systems\0A    complete -c service -n 'not __fish_is_nth_token 1' -xa \22start stop restart status enable disable\22\0Aelse if command -sq rc-service # OpenRC (Gentoo)\0A    complete -c service -n 'not __fish_is_nth_token 1' -xa \22start stop restart\22\0Aelse if test -d /etc/init.d # SysV on Debian and other linuxen\0A    complete -c service -n 'not __fish_is_nth_token 1' -xa \22start stop --full-restart\22\0Aelse # FreeBSD\0A    # Use the output of `service -v foo` to retrieve the list of service-specific verbs\0A    complete -c service -n 'not __fish_is_nth_token 1' -xa \22(__fish_complete_freebsd_service_actions)\22\0Aend\0A\0Afunction __fish_complete_freebsd_service_actions\0A    # Use the output of `service -v foo` to retrieve the list of service-specific verbs\0A    # Output takes the form \22[prefix1 prefix2 ..](cmd1 cmd2 cmd3)\22 where any combination\0A    # of zero or one prefixe(s) and any one command is a valid verb.\0A    set -l service_name (commandline --tokens-expanded --cut-at-cursor)[-1]\0A    set -l results (service $service_name -v 2>| string match -r '\\\\[(.*)\\\\]\\\\((.*)\\\\)')\0A    set -l prefixes \22\22 (string split '|' -- $results[2])\0A    set -l commands (string split '|' -- $results[3])\0A    printf '%s\\n' $prefixes$commands\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2585 = private unnamed_addr constant [20 x i8] c"completions/set.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2586 = private unnamed_addr constant [7628 x i8] c"#\0A# Completions for the 'set' builtin\0A#\0A\0A#\0A# Various helper functions\0A#\0A\0Afunction __fish_set_is_color -a foreground background -d 'Test if We are specifying a color value for the prompt'\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        switch $i\0A            case fish_color_search_match fish_color_selection fish_pager_color_selected_background\0A                $background\0A                return\0A            case 'fish_color_*' 'fish_pager_color_*'\0A                $foreground\0A                return\0A\0A            case '-*'\0A\0A            case '*'\0A                return 1\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_set_is_locale -d 'Test if We are specifying a locale value for the prompt'\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        switch $i\0A\0A            case LANG LC_ALL LC_COLLATE LC_CTYPE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME\0A                return 0\0A\0A            case '-*'\0A                continue\0A\0A            case '*'\0A                return 1\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_complete_special_vars\0A    printf \22%s\\t%s\\n\22 \\\0A        PATH \22list of dirs to look for commands in\22 \\\0A        CDPATH \22list of dirs under which that cd searches\22 \\\0A        FISH_DEBUG \22list of enabled debug categories\22 \\\0A        FISH_DEBUG_OUTPUT \22debug output path\22 \\\0A        umask \22current file creation mask\22 \\\0A        fish_ambiguous_width \22affects computed width of east asian chars\22 \\\0A        fish_autosuggestion_enabled \22set to 0 to turn autosuggestions off\22 \\\0A        fish_cursor_end_mode \22set to 'inclusive' to disallow moving the cursor beyond the command line end\22 \\\0A        fish_cursor_selection_mode \22set to 'inclusive' if selections should include the cursor\22 \\\0A        fish_emoji_width \22cols wide fish assumes emoji render as\22 \\\0A        fish_escape_delay_ms \22How long fish waits to distinguish escape and alt\22 \\\0A        fish_greeting \22The message to display at start (also a function)\22 \\\0A        fish_handle_reflow \22if fish should repaint prompt when the term resizes\22 \\\0A        fish_history \22The session id to store history under\22 \\\0A        fish_key_bindings \22name of function that sets binds\22 \\\0A        fish_term24bit \22set to 0 to use the color palette instead of true-colors\22 \\\0A        fish_term256 \22set to 0 to use the 16-color palette instead of 256\22 \\\0A        fish_trace \22Enables execution tracing (if set to non-empty value)\22 \\\0A        fish_transient_prompt \22set to 1 to re-run prompts before pushing them to scrollback\22 \\\0A        fish_user_paths \22A list of dirs to prepend to PATH\22\0A\0Aend\0A\0A#\0A# Completions\0A#\0A\0A# Regular switches, set only accepts these before the variable name,\0A# so we need to test using \22__fish_is_nth_token 1\22\0A\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s e -l erase -d \22Erase variable\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s x -l export -d \22Export variable to subprocess\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s u -l unexport -d \22Do not export variable to subprocess\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s f -l function -d \22Make variable function-scoped\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s g -l global -d \22Make variable scope global\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s l -l local -d \22Make variable scope local\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s L -l long -d 'Do not truncate long lines'\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s U -l universal -d \22Share variable persistently across sessions\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s q -l query -d \22Test if variable is defined\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s h -l help -d \22Display help and exit\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s n -l names -d \22List the names of the variables, but not their value\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s a -l append -d \22Append value to a list\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s p -l prepend -d \22Prepend value to a list\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -s S -l show -d \22Show variable\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -l path -d \22Make variable as a path variable\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -l unpath -d \22Make variable not as a path variable\22\0Acomplete -c set -n \22__fish_is_nth_token 1\22 -l no-event -d \22Don't emit an event\22\0A\0A#TODO: add CPP code to generate list of read-only variables and exclude them from the following completions\0A\0A# Complete using preexisting variable names\0Aset -l maybe_filter_private_vars '\0A    string match (\0A        if string match -qr -- \22^_\22 \22$(commandline -t)\22: then\0A            echo \22*\22\0A        else\0A            echo -rv\0A            echo \22^__\22\0A        end\0A    )'\0A# We do not *filter* these by the given scope because you might want to set e.g. a global to shadow a universal.\0Acomplete -c set -n '__fish_is_nth_token 1; and not __fish_seen_argument -s e -l erase' -x -a \22(set -U | $maybe_filter_private_vars | string replace ' ' \\t'Universal Variable: ')\22\0Acomplete -c set -n '__fish_is_nth_token 1; and not __fish_seen_argument -s e -l erase' -x -a \22(set -g | $maybe_filter_private_vars | string replace -r '^((?:history|fish_killring) ).*' '$1' | string replace ' ' \\t'Global Variable: ')\22\0Acomplete -c set -n '__fish_is_nth_token 1; and not __fish_seen_argument -s e -l erase' -x -a \22(set -l | $maybe_filter_private_vars | string replace ' ' \\t'Local Variable: ')\22\0A# Complete some fish configuration variables even if they aren't set.\0Acomplete -c set -n '__fish_is_nth_token 1; and not __fish_seen_argument -s e -l erase' -x -a \22(__fish_complete_special_vars)\22\0A\0A# Complete using preexisting variable names for `set --erase`\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and not __fish_seen_argument -s l -s U -s g -l local -l global -l Universal' -f -a \22(set -U | string replace ' ' \\tUniversal\\ Variable:\\ )\22\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and not __fish_seen_argument -s l -s U -s g -l local -l global -l Universal' -f -a \22(set -g | string replace ' ' \\tGlobal\\ Variable:\\ )\22\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and not __fish_seen_argument -s l -s U -s g -l local -l global -l Universal' -f -a \22(set -l | string replace ' ' \\tLocal\\ Variable:\\ )\22\0A# Complete scope-specific variables for `set --erase`\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and __fish_seen_argument -s U -l universal' -f -a \22(set -U | string replace ' ' \\t'Universal Variable: ')\22\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and __fish_seen_argument -s g -l global' -f -a \22(set -g | string replace ' ' \\t'Global Variable: ')\22\0Acomplete -c set -n '__fish_seen_argument -s e -l erase; and __fish_seen_argument -s l -l local' -f -a \22(set -l | string replace ' ' \\t'Local Variable: ')\22\0A\0A# Color completions\0Acomplete -c set -n '__fish_set_is_color true false' -x -a '(set_color --print-colors)' -d 'text color'\0Acomplete -c set -n '__fish_set_is_color false true' -a '--background=(set_color --print-colors)'\0Acomplete -c set -n '__fish_set_is_color false true' -a '--underline-color=(set_color --print-colors)'\0Acomplete -c set -n '__fish_set_is_color true false' -a --bold -x\0Acomplete -c set -n '__fish_set_is_color true false' -a --dim -x\0Acomplete -c set -n '__fish_set_is_color true false' -a --italics -x\0Acomplete -c set -n '__fish_set_is_color true true' -a --reverse -x\0Acomplete -c set -n '__fish_set_is_color true false' -a --underline -x\0Acomplete -c set -n '__fish_set_is_color true false' -a--underline={double,curly,dotted,dashed} -x\0A\0A# Locale completions\0Acomplete -c set -n '__fish_set_is_locale; and not __fish_seen_argument -s e -l erase' -x -a '(command -sq locale; and locale -a)' -d Locale\0A", align 1
