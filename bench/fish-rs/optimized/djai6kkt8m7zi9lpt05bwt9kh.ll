@anon.1d0b41a8d45d477c3029ec78f9b8b434.1454 = private unnamed_addr constant [4886 x i8] c"complete -c dd -xa '(__fish_complete_dd)'\0Acomplete -c dd -d 'display help and exit' -xa --help\0Acomplete -c dd -d 'output version information and exit' -xa --version\0A\0Afunction __fish_complete_dd -d 'Complete dd operands'\0A    # set operand_string as a local variable containing the current command-line token.\0A    set -l operand_string (commandline -t)\0A\0A    switch $operand_string\0A        case 'if=*' 'of=*'\0A            string replace = ' ' -- $operand_string | read -l operand value\0A\0A            # Use normal file completions.\0A            printf \22$operand=%s\\n\22 (complete -C \22__fish_command_without_completions $value\22)\0A\0A        case 'iflag=*' 'oflag=*'\0A            string replace = ' ' -- $operand_string | read -l operand complete\0A            string match -q '*,' -- $complete\0A            or set complete ''\0A\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22append\22 \22append mode (makes sense only for output; conv=notrunc suggested)\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22direct\22 \22use direct I/O for data\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22directory\22 \22fail unless a directory\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22dsync\22 \22use synchronized I/O for data\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22sync\22 \22use synchronized I/O for data and metadata\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22fullblock\22 \22accumulate full blocks of input (iflag only)\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22nonblock\22 \22use non-blocking I/O\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22noatime\22 \22do not update access time\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22nocache\22 \22discard cached data\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22noctty\22 \22do not assign controlling terminal from file\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22nofollow\22 \22do not follow symbolic links\22\0A\0A        case 'conv=*'\0A            string replace = ' ' -- $operand_string | read -l operand complete\0A            string match -q '*,' -- $complete\0A            or set complete ''\0A\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22ascii\22 \22from EBCDIC to ASCII\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22ebcdic\22 \22from ASCII to EBCDIC\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22ibm\22 \22from ASCII to alternate EBCDIC\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22block\22 \22pad newline-terminated records with spaces to cbs-size\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22unblock\22 \22replace trailing spaces in cbs-size records with newline\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22lcase\22 \22change upper case to lower case\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22ucase\22 \22change lower case to upper case\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22swab\22 \22swap every pair of input bytes\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22sync\22 \22pad every input block with NULs to ibs-size; with block or ublock use spaces\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22excl\22 \22fail if the output file already exists\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22nocreat\22 \22do not create the output file\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22notrunc\22 \22do not truncate the output file\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22noerror\22 \22continue after read errors\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22fdatasync\22 \22physically write output file data before finishing\22\0A            printf \22%s\\t%s\\n\22 \22$operand=$complete\22\22fsync\22 \22physically write output file data and metadata before finishing\22\0A\0A        case 'status=*'\0A            printf \22%s\\t%s\\n\22 status=noxfer \22suppress final transfer statistics\22\0A            printf \22%s\\t%s\\n\22 status=none \22suppress everything but errors\22\0A            printf \22%s\\t%s\\n\22 status=progress \22show periodic transfer statistics\22\0A\0A        case '*'\0A            printf \22%s=\\t%s\\n\22 bs \22read and write up to BYTES bytes at a time\22\0A            printf \22%s=\\t%s\\n\22 cbs \22convert BYTES bytes at a time\22\0A            printf \22%s=\\t%s\\n\22 conv \22convert the file as per the comma separated symbol list\22\0A            printf \22%s=\\t%s\\n\22 count \22copy only BLOCKS input blocks\22\0A            printf \22%s=\\t%s\\n\22 ibs \22read up to BYTES bytes at a time (default 512)\22\0A            printf \22%s=\\t%s\\n\22 if \22read from FILE instead of stdin\22\0A            printf \22%s=\\t%s\\n\22 iflag \22read as per the comma separated symbol list\22\0A            printf \22%s=\\t%s\\n\22 obs \22write BYTES bytes at a time (default 512)\22\0A            printf \22%s=\\t%s\\n\22 of \22write to FILE instead of stdout\22\0A            printf \22%s=\\t%s\\n\22 oflag \22write as per the comma separated symbol list\22\0A            printf \22%s=\\t%s\\n\22 seek \22skip BLOCKS obs-sized blocks at the start of output\22\0A            printf \22%s=\\t%s\\n\22 skip \22skip BLOCKS ibs-sized blocks at the start of input\22\0A            printf \22%s=\\t%s\\n\22 status \22set the level of information to print to stderr\22\0A    end\0Aend\0A", align 1
