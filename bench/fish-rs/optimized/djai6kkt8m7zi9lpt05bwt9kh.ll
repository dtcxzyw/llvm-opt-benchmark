@anon.1d0b41a8d45d477c3029ec78f9b8b434.3178 = private unnamed_addr constant [1089 x i8] c"function __fish_complete_zfs_mountpoint_properties -d \22Completes with ZFS mountpoint properties\22\0A    set -l OS \22\22\0A    switch (uname)\0A        case Linux\0A            set OS Linux\0A        case Darwin\0A            set OS macOS\0A        case FreeBSD\0A            set OS FreeBSD\0A        case SunOS\0A            set OS SunOS\0A            # Others?\0A        case \22*\22\0A            set OS unknown\0A    end\0A    echo -e \22atime\\tUpdate access time on read (on, off)\22\0A    echo -e \22devices\\tAre contained device nodes openable (on, off)\22\0A    echo -e \22exec\\tCan contained executables be executed (on, off)\22\0A    echo -e \22readonly\\tRead-only (on, off)\22\0A    echo -e \22setuid\\tRespect set-UID bit (on, off)\22\0A    if test $OS = SunOS\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A    else if test $OS = Linux\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22relatime\\tSometimes update access time on read (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A    end\0Aend\0A", align 1
