@anon.1d0b41a8d45d477c3029ec78f9b8b434.2450 = private unnamed_addr constant [2213 x i8] c"complete -c rakudo -n __fish_is_first_token -F -a - -d 'Read program source from STDIN or start REPL if a TTY'\0Acomplete -c rakudo -s c -d 'Check syntax only. Runs BEGIN and CHECK blocks'\0Acomplete -c rakudo -l doc -d 'Extract documentation and print it as text'\0Acomplete -c rakudo -s e -x -d 'One line of program, strict is enabled by default'\0Acomplete -c rakudo -s h -l help -x -d 'Display help text'\0Acomplete -c rakudo -s n -d 'Run program once for each line of input'\0Acomplete -c rakudo -s p -d 'Same as -n, but also print $_ at the end of lines'\0Acomplete -c rakudo -s I -r -d 'Add the path to the module search path'\0Acomplete -c rakudo -s M -r -d 'Load the module prior to running the program'\0Acomplete -c rakudo -l target -x -k -a 'start parse syntaxcheck ast optimize mast mbc moar' -d 'Specify compilation stage to emit'\0Acomplete -c rakudo -l optimize -x -d 'use the given level of optimization, pass 0..3' -a '0 1 2 3'\0Acomplete -c rakudo -s o -l output -r -d 'Specify name of output file'\0Acomplete -c rakudo -s v -x -l version -d 'Display version information'\0Acomplete -c rakudo -s V -x -d 'Print configuration summary'\0Acomplete -c rakudo -l rakudo-home -r -d 'Override the path of the Rakudo runtime files'\0Acomplete -c rakudo -l stagestats -d 'Display time spent in the compilation stages'\0Acomplete -c rakudo -l repl-mode -x -d 'Specify the REPL mode' -a 'interactive\\t\22Start the default interactive REPL\22 non-interactive\\t\22STDIN is read entirely and evaluated as if it were a program\22'\0Acomplete -c rakudo -l profile -r -d 'Write profile information to a file. Extension controls format'\0Acomplete -c rakudo -l profile-compile -r -d 'Write compile-time profile information to a file. Extension controls format'\0Acomplete -c rakudo -l profile-kind -x -d 'Choose the type of profile to generate' -a 'instrumented\\t\22Performance measurements\22 heap\\t\22Record heap snapshots at every garbage collection run\22'\0Acomplete -c rakudo -l profile-stage -f -d 'Write profile information for the given compilation stage to a file'\0Acomplete -c rakudo -l debug-port -x -d 'Listen for incoming debugger connections'\0Acomplete -c rakudo -l tracing -f -d 'Output a line to stderr on every interpreter instr, if enabled in MoarVM'\0A", align 1
