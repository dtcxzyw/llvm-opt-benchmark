@anon.1d0b41a8d45d477c3029ec78f9b8b434.3488 = private unnamed_addr constant [15414 x i8] c"function help --description 'Show help for the fish shell'\0A    set -l options h/help\0A    argparse -n help $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help help\0A        return 0\0A    end\0A\0A    set -l fish_help_item $argv[1]\0A    if test (count $argv) -gt 1\0A        if string match -q string $argv[1]\0A            set fish_help_item (string join '-' $argv[1] $argv[2])\0A        else\0A            echo \22help: Expected at most 1 args, got 2\22 >&2\0A            return 1\0A        end\0A    end\0A\0A    # Find a suitable browser for viewing the help pages.\0A    # The first thing we try is $fish_help_browser.\0A    set -l fish_browser $fish_help_browser\0A\0A    # A list of graphical browsers we know about.\0A    set -l graphical_browsers htmlview x-www-browser firefox galeon mozilla xdg-open\0A    set -a graphical_browsers konqueror epiphany opera netscape rekonq google-chrome chromium-browser\0A\0A    # On mac we may have to write a temporary file that redirects to the desired\0A    # help page, since `open` will drop fragments from file URIs (issue #4480).\0A    set -l need_trampoline\0A\0A    if not set -q fish_browser[1]\0A        if set -q BROWSER\0A            # User has manually set a preferred browser, so we respect that\0A            echo $BROWSER | read -at fish_browser\0A            if not type -q $fish_browser[1]\0A                printf (_ 'help: %s is not a valid command: %s\\n') '$fish_browser' \22$fish_browser\22\0A                return 2\0A            end\0A        else\0A            # No browser set up, inferring.\0A            # We check a bunch and use the last we find.\0A\0A            # Check for a text-based browser.\0A            for i in htmlview www-browser links elinks lynx w3m\0A                if type -q -f $i\0A                    set fish_browser $i\0A                    break\0A                end\0A            end\0A\0A            # If we are in a graphical environment, check if there is a graphical\0A            # browser to use instead.\0A            set -f is_graphical 0\0A            if test -n \22$DISPLAY\22 -a \\( \22$XAUTHORITY\22 = \22$HOME/.Xauthority\22 -o -z \22$XAUTHORITY\22 \\)\0A                set is_graphical 1\0A                for i in $graphical_browsers\0A                    if type -q -f $i\0A                        set fish_browser $i\0A                        break\0A                    end\0A                end\0A            end\0A\0A            # If we're SSH'd into a desktop installation, don't use a regular browser unless X is being forwarded\0A            if not set -q SSH_CLIENT || test $is_graphical -eq 1\0A                # We use the macOS open, but not otherwise.\0A                # On Debian, there is an open command that's a symlink to openvt.\0A                if uname | string match -q Darwin && command -sq open\0A                    set fish_browser open\0A                    # The open command needs a trampoline because the macOS version can't handle #-fragments.\0A                    set need_trampoline 1\0A                end\0A\0A                # If the OS appears to be Windows (graphical), try to use cygstart\0A                if type -q cygstart\0A                    set fish_browser cygstart\0A                else if type -q xdg-open\0A                    # If xdg-open is available, just use that\0A                    set fish_browser xdg-open\0A                end\0A\0A                # Try to find cmd.exe via $PATH or one of the paths that it's often at.\0A                #\0A                # We use this instead of xdg-open because that's useless without a backend\0A                # like wsl-open which we'll check in a minute.\0A                if test -f /proc/version\0A                    and string match -riq 'Microsoft|WSL|MSYS|MINGW' </proc/version\0A                    and set -l cmd (command -s powershell.exe cmd.exe /mnt/c/Windows/System32/cmd.exe)\0A                    # Use the first of these.\0A                    set fish_browser $cmd[1]\0A                end\0A\0A                if type -q wsl-open\0A                    set fish_browser wsl-open\0A                end\0A            end\0A        end\0A    else\0A        if not type -q $fish_browser[1]\0A            printf (_ 'help: %s is not a valid command: %s\\n') '$fish_help_browser' \22$fish_browser\22\0A            return 2\0A        end\0A    end\0A\0A    # In Cygwin, start the user-specified browser using cygstart,\0A    # only if a Windows browser is to be used.\0A    if type -q cygstart\0A        if test \22$fish_browser\22 != cygstart\0A            and set -q fish_browser[1]\0A            and not command -sq $fish_browser[1]\0A            # Escaped quotes are necessary to work with spaces in the path\0A            # when the command is finally eval'd.\0A            set fish_browser cygstart $fish_browser\0A        else\0A            set need_trampoline 1\0A        end\0A    end\0A\0A    # HACK: Hardcode all section titles for each page.\0A    # This could possibly be automated.\0A    set -l intropages introduction where-to-go installation starting-and-exiting default-shell uninstalling shebang-line configuration examples resources other-help-pages\0A    set -l for_bash_pages arithmetic-expansion bash-command-substitutions blocks-and-loops builtins-and-other-commands command-substitutions fish-for-bash-users heredocs process-substitution prompts quoting special-variables string-manipulation subshells test-test variables wildcards-globs\0A    set -l faqpages faq-ssh-interactive faq-unicode faq-uninstalling frequently-asked-questions how-can-i-use-as-a-shortcut-for-cd how-do-i-change-the-greeting-message how-do-i-check-whether-a-variable-is-defined how-do-i-check-whether-a-variable-is-not-empty how-do-i-customize-my-syntax-highlighting-colors how-do-i-get-the-exit-status-of-a-command how-do-i-ma