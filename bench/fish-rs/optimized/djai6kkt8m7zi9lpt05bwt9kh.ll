@anon.1d0b41a8d45d477c3029ec78f9b8b434.1634 = private unnamed_addr constant [2854 x i8] c"function __fish_firejail_profiles\0A    path basename -- /etc/firejail/*.profile ~/.config/firejail/*.profile\0Aend\0A\0Afunction __fish_firejail_complete_sandboxes\0A    firejail --list | string replace -rf -- '([^:]+):([^:]+):([^:]+):(.*)' '$1\\t$3: $4 ($2)\\n$3\\t$1: $4 ($2)'\0Aend\0A\0Acomplete -c firejail -f\0Acomplete -c firejail -l help -d 'Show help and exit'\0Acomplete -c firejail -l version -d 'Show version and exit'\0Acomplete -c firejail -l debug -d 'Print debug info'\0Acomplete -c firejail -l debug-blacklists -d 'Debug blacklisting'\0Acomplete -c firejail -l debug-whitelists -d 'Debug whitelisting'\0Acomplete -c firejail -l debug-caps -d 'Print known capabilities and exit'\0Acomplete -c firejail -l debug-errnos -d 'Print known error numbers and exit'\0Acomplete -c firejail -l debug-private-lib -d 'Debug --private-lib'\0Acomplete -c firejail -l debug-protocols -d 'Print known protocols and exit'\0Acomplete -c firejail -l debug-syscalls -d 'Print known syscalls and exit'\0Acomplete -c firejail -l debug-syscalls32 -d 'Print known 32-bit syscalls and exit'\0Acomplete -c firejail -l list -d 'List all sandboxes'\0Acomplete -c firejail -l tree -d 'Print a tree of all sandboxes'\0Acomplete -c firejail -l top -d 'Monitor sandboxes (like `top`)'\0Acomplete -c firejail -l shutdown -d 'Show help and exit'\0A\0A# Profiles\0A# Note: firejail's option parsing is weird and *requires* the --foo=bar form\0A# So we don't use -r\0Acomplete -c firejail -l profiles -d 'Load a custom security profile' -a '(__fish_firejail_profiles)'\0A\0A# Sandboxes\0Acomplete -c firejail -l join -d 'Join existing sandbox' -a '(__fish_firejail_complete_sandboxes)'\0A\0A# Files\0Acomplete -c firejail -l hosts-file -d 'Show help and exit' -a '(__fish_firejail_profiles)'\0A\0A# directory\0Acomplete -c firejail -l chroot -d 'Chroot into this directory' -a '(__fish_complete_directories)'\0Acomplete -c firejail -l tmpfs -d 'Mount tmpfs into sandbox' -a '(__fish_complete_directories)'\0Acomplete -c firejail -l blacklist -d 'Blacklist dir or file' -F\0Acomplete -c firejail -l noblacklist -d 'Disable blacklist for dir or file' -F\0Acomplete -c firejail -l whitelist -d 'Whitelist dir or file' -F\0Acomplete -c firejail -l nowhitelist -d 'Disable whitelist for dir or file' -F\0Acomplete -c firejail -l read-only -d 'Set dir or file read-only' -F\0Acomplete -c firejail -l read-write -d 'Set dir or file read-write' -F\0A# TODO: Comma-separated (\22/etc/foo,/usr/etc/foo\22 bind-mounts /etc/foo on /usr/etc/foo)\0Acomplete -c firejail -l bind -d 'Bind-mount file on top of another' -F\0Acomplete -c firejail -l private -d 'Mount temporary home directories and delete on exit' -F\0Acomplete -c firejail -l netfilter -d 'Enable firewall given by this file' -F\0A\0A# Interfaces\0Acomplete -c firejail -l net -d 'Enable network namespace connected to this interface' -a '(__fish_print_interfaces)'\0A\0A# Commands\0Acomplete -c firejail -a '(__fish_complete_subcommand)'\0A", align 1
