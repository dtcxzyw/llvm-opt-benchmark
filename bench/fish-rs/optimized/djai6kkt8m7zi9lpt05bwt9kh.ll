@anon.1d0b41a8d45d477c3029ec78f9b8b434.1320 = private unnamed_addr constant [746 x i8] c"#\0A# Completions for the chsh command\0A#\0A\0A# This grep tries to match nonempty lines that do not start with hash\0Acomplete -c chsh -s s -l shell -x -a \22(string match -r '^[^#].*' < /etc/shells)\22 -d \22Specify your login shell\22\0Acomplete -c chsh -s u -l help -d \22Display help and exit\09\22\0Acomplete -c chsh -s v -l version -d \22Display version and exit\22\0Acomplete -x -c chsh -a \22(__fish_complete_users)\22\0A\0A# util-linux's chsh also has a \22-l\22/\22--list-shells\22 option.\0A# While both FreeBSD and macOS also have \22-l\22, it means something different and probably uninteresting.\0Aif set -l chshversion (chsh --version 2>/dev/null); and string match -qr '.*util-linux.*' -- $chshversion\0A    complete -f -c chsh -s l -l list-shells -d \22List available shells and exit\22\0Aend\0A", align 1
