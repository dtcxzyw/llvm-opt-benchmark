@anon.1d0b41a8d45d477c3029ec78f9b8b434.3454 = private unnamed_addr constant [526 x i8] c"function fish_jj_prompt\0A    # If jj isn't installed, there's nothing we can do\0A    # Return 1 so the calling prompt can deal with it\0A    if not command -sq jj\0A        return 1\0A    end\0A    set -l info \22$(\0A        jj log 2>/dev/null --no-graph --ignore-working-copy --color=always --revisions @ \\\0A            --template '\0A                separate(\22 \22,\0A                    if(conflict, label(\22conflict\22, \22\C3\97\22)),\0A                )\0A            '\0A    )\22\0A    or return 1\0A    if test -n \22$info\22\0A        printf ' %s' $info\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3455 = private unnamed_addr constant [31 x i8] c"functions/fish_job_summary.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3456 = private unnamed_addr constant [2619 x i8] c"function fish_job_summary -a job_id is_foreground cmd_line signal_or_end_name signal_desc proc_pid proc_name\0A    # job_id: ID of the job that stopped/terminated/ended.\0A    # is_foreground: 1 if the job was running in the foreground, 0 otherwise.\0A    # cmd_line: The command line of the job.\0A    # signal_or_end_name: If terminated by signal, the name of the signal (e.g. SIGTERM).\0A    #   If ended, the string \22ENDED\22. If stopped, the string \22STOPPED\22.\0A    # signal_desc: A description of the signal (e.g. \22Polite quite request\22).\0A    #   Not provided if the job stopped or ended without a signal.\0A    # If the job has more than one process:\0A    # proc_pid: the pid of the process affected.\0A    # proc_name: the name of that process.\0A    # If the job has only one process, these two arguments will not be provided.\0A\0A    # Print nothing if we get SIGINT in the foreground process group, to avoid spamming\0A    # obvious stuff on the console (#1119). If we get SIGINT for the foreground\0A    # process, assume the user typed ^C and can see it working. It's possible they\0A    # didn't, and the signal was delivered via pkill, etc., but the SIGINT/SIGTERM\0A    # distinction is precisely to allow INT to be from a UI\0A    # and TERM to be programmatic, so this assumption is keeping with the design of\0A    # signals. If echoctl is on, then the terminal will have written ^C to the console.\0A    # If off, it won't have. We don't echo ^C either way, so as to respect the user's\0A    # preference.\0A    if test \22$signal_or_end_name\22 = SIGINT; and test $is_foreground -eq 1\0A        return\0A    end\0A\0A    set -l max_cmd_len 32\0A    set cmd_line (string shorten -m$max_cmd_len -- $cmd_line | string collect)\0A\0A    set -l message\0A    switch $signal_or_end_name\0A        case STOPPED\0A            set message (printf ( _ \22fish: Job %s, '%s' has stopped\\n\22 ) $job_id $cmd_line)\0A        case ENDED\0A            set message (printf ( _ \22fish: Job %s, '%s' has ended\\n\22 ) $job_id $cmd_line)\0A        case 'SIG*'\0A            if test -n \22$proc_pid\22\0A                set message (printf ( _ \22fish: Process %s, '%s' from job %s, '%s' terminated by signal %s (%s)\\n\22 ) \\\0A                    $proc_pid $proc_name $job_id $cmd_line $signal_or_end_name $signal_desc)\0A            else\0A                set message (printf ( _ \22fish: Job %s, '%s' terminated by signal %s (%s)\\n\22 ) \\\0A                    $job_id $cmd_line $signal_or_end_name $signal_desc)\0A            end\0A    end\0A\0A    if test $is_foreground -eq 0; and test $signal_or_end_name != STOPPED\0A        __fish_echo string join \\n -- $message\0A    else\0A        string join >&2 \\n -- $message\0A    end\0Aend\0A", align 1
