 -c $__fish_complete_gpg_command -l no-ask-sig-expire -d \22Do not prompt for an expiration time\22\0A\0A    complete -c $__fish_complete_gpg_command -l ask-cert-expire -d \22Prompt for an expiration time\22\0A    complete -c $__fish_complete_gpg_command -l no-ask-cert-expire -d \22Do not prompt for an expiration time\22\0A\0A    complete -c $__fish_complete_gpg_command -l try-all-secrets -d \22Don't look at the key ID as stored in the message but try all secret keys in turn to find the right decryption key\22\0A    complete -c $__fish_complete_gpg_command -l enable-special-filenames -d \22Enable a mode in which filenames of the form -&n, where n is a non-negative decimal number, refer to the file descriptor n and not to a file with that name\22\0A\0A    complete -c $__fish_complete_gpg_command -l group -x -d \22Sets up a named group, which is similar to aliases in email programs\22\0A    complete -c $__fish_complete_gpg_command -l ungroup -d \22Remove a given entry from the --group list\22\0A    complete -c $__fish_complete_gpg_command -l no-groups -d \22Remove all entries from the --group list\22\0A\0A    complete -c $__fish_complete_gpg_command -l preserve-permissions -d \22Don't change the permissions of a secret keyring back to user read/write only\22\0A\0A    complete -c $__fish_complete_gpg_command -l personal-cipher-preferences -x -d \22Set the list of personal cipher preferences to the specified string\22\0A    complete -c $__fish_complete_gpg_command -l personal-digest-preferences -x -d \22Set the list of personal digest preferences to the specified string\22\0A    complete -c $__fish_complete_gpg_command -l personal-compress-preferences -x -d \22Set the list of personal compression preferences to the specified string\22\0A\0A    complete -c $__fish_complete_gpg_command -l default-preference-list -x -d \22Set the list of default preferences to the specified string\22\0A\0A    complete -c $__fish_complete_gpg_command -l openpgp -x -d \22Use strict OpenPGP b