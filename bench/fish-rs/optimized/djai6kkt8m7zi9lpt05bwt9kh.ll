@anon.1d0b41a8d45d477c3029ec78f9b8b434.3180 = private unnamed_addr constant [142 x i8] c"function __fish_complete_zfs_pools -d \22Completes with available ZFS pools\22\0A    zpool list -o name,comment -H | string replace -a \\t'-' ''\0Aend\0A", align 1
