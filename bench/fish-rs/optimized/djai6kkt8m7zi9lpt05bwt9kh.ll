@anon.1d0b41a8d45d477c3029ec78f9b8b434.1142 = private unnamed_addr constant [6224 x i8] c"# Completions for the `apt` command\0A\0A# macOS has a /usr/bin/apt that is something else entirely:\0A# (apt - Returns the path to a Java home directory from the current user's settings)\0Aif [ \22$(uname -s)\22 = Darwin -a \22$(command -s apt)\22 = /usr/bin/apt ]\0A    exit 1\0Aend\0A\0Aset -l all_subcmds update upgrade full-upgrade search list install show remove edit-sources purge changelog autoremove depends rdepends\0Aset -l pkg_subcmds install upgrade full-upgrade show search purge changelog policy depends rdepends autoremove\0Aset -l installed_pkg_subcmds remove\0Aset -l handle_file_pkg_subcmds install\0A\0Afunction __fish_apt_subcommand -V all_subcmds\0A    set -l subcommand $argv[1]\0A    set -e argv[1]\0A    complete -f -c apt -n __fish_is_first_token -a $subcommand $argv\0Aend\0A\0Afunction __fish_apt_option\0A    set -l subcommand $argv[1]\0A    set -e argv[1]\0A    complete -f -c apt -n \22__fish_seen_subcommand_from $subcommand\22 $argv\0Aend\0A\0Afunction __fish_apt_list_repos\0A    # A single `string` invocation can't read from multiple files and so we use `cat`\0A    # but /etc/apt/sources.list.d/ may or may not contain any files so using a fish\0A    # wildcard glob may complain loudly if no files match the pattern so we use `find`.\0A    # The trailing `sort -u` is largely decorative.\0A    cat (find /etc/apt/sources.list /etc/apt/sources.list.d/ -name \22*.list\22) | string replace -rf '^\\s*deb *(?:\\[.*?\\])? (?:[^ ]+) +([^ ]+) .*' '$1' | sort -u\0Aend\0A\0Acomplete -c apt -f\0A\0A# We use -k to keep PWD directories (from the .deb completion) after packages, so we need to sort the packages\0Acomplete -k -c apt -n \22__fish_seen_subcommand_from $handle_file_pkg_subcmds\22 -kxa '(__fish_complete_suffix .deb)'\0Acomplete -k -c apt -n \22__fish_seen_subcommand_from $pkg_subcmds\22 -kxa '(__fish_print_apt_packages | sort)'\0Acomplete -c apt -n \22__fish_seen_subcommand_from $installed_pkg_subcmds\22 -kxa '(__fish_print_apt_packages --installed | sort)'\0A\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l no-install-recommends -d 'Do not install recommended packages'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l no-install-suggests -d 'Do not install suggested packages'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s d -l download-only -d 'Download Only'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s f -l fix-broken -d 'Correct broken dependencies'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s m -l fix-missing -d 'Ignore missing packages'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l no-download -d 'Disable downloading packages'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s q -l quiet -d 'Quiet mode'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s s -l simulate -l just-print -l dry-run -l recon -l no-act -d 'Perform a simulation'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -s y -l yes -l assume-yes -d 'Automatic yes to prompts'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l assume-no -d 'Automatic no to prompts'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l install-recommends -d 'Install recommended packages'\0Acomplete -c apt -n \22__fish_seen_subcommand_from install\22 -l install-suggests -d 'Install suggested packages'\0A# This advanced flag is the safest way to upgrade packages that otherwise would have been kept back\0Acomplete -c apt -n \22__fish_seen_subcommand_from upgrade\22 -l with-new-pkgs\0A\0A# Support flags\0Acomplete -f -c apt -s h -l help -d 'Display help'\0Acomplete -f -c apt -s v -l version -d 'Display version and exit'\0A\0A# General options\0Acomplete -x -c apt -s o -l option -d 'Set a configuration option'\0Acomplete -r -c apt -s c -l config-file -d 'Configuration file'\0Acomplete -x -c apt -s t -d 'Install from specific repository' -x -a '(__fish_apt_list_repos)'\0A\0A# List\0A__fish_apt_subcommand list -d 'List packages'\0A__fish_apt_option list -l installed -d 'Installed packages'\0A__fish_apt_option list -l manual-installed -d 'Manually installed packages'\0A__fish_apt_option list -l upgradable -d 'Upgradable packages'\0A__fish_apt_option list -s a -l all-versions -d 'Show all versions of any package'\0A__fish_apt_option list -s v -l verbose -d 'Verbose output'\0A\0A# Search\0A__fish_apt_subcommand search -r -d 'Search for packages'\0A\0A# Show\0A__fish_apt_subcommand show -r -d 'Show package information'\0A\0A# Showsrc\0A__fish_apt_subcommand showsrc -r -d 'Show source package information'\0A\0A# Source\0A__fish_apt_subcommand source -r -d 'Download source package'\0A\0A# Install\0A__fish_apt_subcommand install -r -d 'Install packages'\0A__fish_apt_option install -l reinstall -d 'Reinstall package'\0A\0A# Reinstall\0A__fish_apt_subcommand reinstall -r -d 'Reinstall packages'\0A\0A# Remove\0A__fish_apt_subcommand remove -x -d 'Remove packages'\0A\0A# Edit sources\0A__fish_apt_subcommand edit-sources -d 'Edit sources list'\0A\0A# Update\0A__fish_apt_subcommand update -x -d 'Update package list'\0A\0A# Upgrade\0A__fish_apt_subcommand upgrade -r -d 'Upgrade packages'\0A\0A# Full Upgrade\0A__fish_apt_subcommand full-upgrade -r -d 'Upgrade packages, removing others when needed'\0A__fish_apt_subcommand dist-upgrade -r -d 'Upgrade packages, removing others when needed'\0A\0A# Purge\0A__fish_apt_subcommand purge -x -d 'Remove packages and delete their config files'\0A\0A# Changelog\0A__fish_apt_subcommand changelog -r -d 'Download and display package changelog'\0A\0A# Autoremove\0A__fish_apt_subcommand autoremove -d 'Remove packages no longer needed as dependencies'\0A\0A# Autoremove\0A__fish_apt_subcommand autopurge -d 'Remove packages no longer needed as dependencies and delete their config files'\0A\0A# Clean\0A__fish_apt_subcommand clean -d 'Remove downloaded packages from cache'\0A\0A# Autoclean\0A__fish_apt_subcommand autoclean -d 'Remove obsolete packages from cache'\0A\0A# Policy\0A__fish_apt_subcommand policy -x -d 'Display source or package priorities'\0A\0A# Depends\0A__fish_apt_subcommand depends -r -d 'List package dependencies'\0A\0A# Rdepends\0A__fish_apt_subcommand rdepends -r -d 'List package reverse dependencies'\0A\0A# Download\0A__fish_apt_subcommand download -x -d 'Download packages'\0A\0A# Build-dep\0A__fish_apt_subcommand build-dep -x -d 'Install packages needed to build the given package'\0A\0A# Help\0A__fish_apt_subcommand help -d 'Print help page'\0A\0Afunctions -e __fish_apt_subcommand __fish_apt_option\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1143 = private unnamed_addr constant [25 x i8] c"completions/aptitude.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1144 = private unnamed_addr constant [5405 x i8] c"#completion for aptitude\0A\0Afunction __fish_apt_no_subcommand -d 'Test if aptitude has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i autoclean clean forget-new keep-all update safe-upgrade changelog full-upgrade download forbid-version hold install keep markauto purge reinstall remove show unhold unmarkauto search help\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_apt_use_package -d 'Test if aptitude command should have packages as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i changelog full-upgrade download forbid-version hold install keep-all markauto purge reinstall remove show unhold unmarkauto\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Acomplete -c aptitude -n __fish_apt_use_package -a '(__fish_print_apt_packages)' -d Package\0A\0Acomplete -c aptitude -s h -l help -d 'Display a brief help message. Identical to the help action'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a autoclean -d 'Remove any cached packages which can no longer be downloaded'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a clean -d 'Remove all downloaded .deb files from the package cache directory'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a forget-new -d 'Forget all internal information about what packages are \\'new\\''\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a keep-all -d 'Cancel all scheduled actions on all packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a update -d 'Update the list of available packages from the apt sources'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a safe-upgrade -d 'Upgrade installed packages to their most recent version'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a changelog -d 'Download and displays the Debian changelog for the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a full-upgrade -d 'Upgrade, removing or installing packages as necessary'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a download -d 'Download the packages to the current directory'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a forbid-version -d 'Forbid the upgrade to a particular version'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a hold -d 'Ignore the packages by future upgrade commands'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a install -d 'Install the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a keep -d 'Cancel any scheduled actions on the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a markauto -d 'Mark packages as automatically installed'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a purge -d 'Remove and delete all associated configuration and data files'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a reinstall -d 'Reinstall the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a remove -d 'Remove the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a show -d 'Display detailed information about the packages'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a unhold -d 'Consider the packages by future upgrade commands'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a unmarkauto -d 'Mark packages as manually installed'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a search -d 'Search for packages matching one of the patterns'\0Acomplete -f -n __fish_apt_no_subcommand -c aptitude -a help -d 'Display brief summary of the available commands and options'\0A\0Acomplete -c aptitude -s D -l show-deps -d 'Show explanations of automatic installations and removals'\0Acomplete -c aptitude -s d -l download-only -d 'Download Only'\0Acomplete -c aptitude -s f -l fix-broken -d 'Correct broken dependencies'\0Acomplete -c aptitude -l purge-unused -d 'Purge packages that are not required by any installed package'\0Acomplete -c aptitude -s P -l prompt -d 'Always display a prompt'\0Acomplete -c aptitude -s R -l without-recommends -d 'Do not treat recommendations as dependencies'\0Acomplete -c aptitude -s r -l with-recommends -d 'Treat recommendations as dependencies'\0Acomplete -c aptitude -s s -l simulate -d 'Don\\'t perform the actions. Just show them'\0Acomplete -c aptitude -l schedule-only -d 'Schedule operations to be performed in the future'\0Acomplete -c aptitude -s q -l quiet -d 'Suppress incremental progress indicators'\0Acomplete -c aptitude -s V -l show-versions -d 'Show which versions of packages will be installed'\0Acomplete -c aptitude -s v -l verbose -d 'Display extra information'\0Acomplete -c aptitude -l version -d 'Display the version of aptitude and compile information'\0Acomplete -c aptitude -l visual-preview -d 'Start up the visual interface and display its preview screen'\0Acomplete -c aptitude -s y -l assume-yes -d 'Assume the answer yes for all question prompts'\0Acomplete -c aptitude -s Z -d 'Show how much disk space will be used or freed'\0Acomplete -r -c aptitude -s F -l display-format -d 'Specify the format to be used by the search command'\0Acomplete -r -c aptitude -s t -l target-release -d 'Set the release from which packages should be installed'\0Acomplete -r -c aptitude -s O -l sort -d 'Specify the order for the output from the search command'\0Acomplete -r -c aptitude -s o -d 'Set a configuration file option directly'\0Acomplete -r -c aptitude -s w -l width -d 'Specify the display width for the output from the search command'\0A", align 1
