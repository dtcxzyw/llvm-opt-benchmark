@anon.1d0b41a8d45d477c3029ec78f9b8b434.2102 = private unnamed_addr constant [2141 x i8] c"# Archlinux's mkinitcpio (https://projects.archlinux.org/mkinitcpio.git/)\0A\0Afunction __fish_mkinitcpio_complete_hooks\0A    mkinitcpio -L | string match -r '^[a-z].*$' | string split \\t | string match -r '.+' | string replace -ra '[\C2\B9\C2\B2\C2\B3]' '\\tdeprecated'\0Aend\0A\0Acomplete -c mkinitcpio -s A -l addhooks -d 'Add the additional hooks to the image' -a \22(__fish_mkinitcpio_complete_hooks)\22 -f\0Acomplete -c mkinitcpio -s c -l config -d 'Use config file to generate the ramdisk'\0Acomplete -c mkinitcpio -s d -l generatedir -d 'Set directory as the location where the initramfs is built'\0Acomplete -c mkinitcpio -s g -l generate -d 'Generate a CPIO image as filename'\0Acomplete -c mkinitcpio -s H -l hookhelp -d 'Output help for a hook' -a \22(__fish_mkinitcpio_complete_hooks)\22 -f\0Acomplete -c mkinitcpio -s h -l help -d 'Output a short overview of available command-line switches' -f\0Acomplete -c mkinitcpio -s k -l kernel -d 'Use kernelversion, instead of the current running kernel' -a \22(string match -v '*extramodules*' -- /usr/lib/modules/* | string replace -r '.*/' '')\22 -f\0Acomplete -c mkinitcpio -s L -l listhooks -d 'List all available hooks' -f\0Acomplete -c mkinitcpio -s M -l automods -d 'Display modules found via autodetection' -f\0Acomplete -c mkinitcpio -s n -l nocolor -d 'Disable color output' -f\0Acomplete -c mkinitcpio -s P -l allpresets -d 'Process all presets contained in /etc/mkinitcpio.d' -f\0Acomplete -c mkinitcpio -s p -l preset -d 'Build initramfs image(s) according to specified preset'\0Acomplete -c mkinitcpio -s r -l moduleroot -d 'Specifies the root directory to find modules in'\0Acomplete -c mkinitcpio -s S -l skiphooks -d 'Skip hooks when generating the image' -a \22(__fish_mkinitcpio_complete_hooks)\22 -f\0Acomplete -c mkinitcpio -s s -l save -d 'Saves the build directory for the initial ramdisk'\0Acomplete -c mkinitcpio -s t -l builddir -d 'Use tmpdir as the temporary build directory instead of /tmp'\0Acomplete -c mkinitcpio -s V -l version -d 'Display version information'\0Acomplete -c mkinitcpio -s v -l verbose -d 'Verbose output'\0Acomplete -c mkinitcpio -s z -l compress -d 'Override the compression method with the compress program'\0A", align 1
