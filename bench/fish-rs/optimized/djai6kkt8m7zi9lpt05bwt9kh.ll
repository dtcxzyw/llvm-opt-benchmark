@anon.1d0b41a8d45d477c3029ec78f9b8b434.1200 = private unnamed_addr constant [5700 x i8] c"# These are very much incomplete completions for the aws-cli suite.\0A# In addition to a complete list of services, the `aws s3` completions are mostly complete\0A# (and are the primary reason this file exists). The automatically generated completions\0A# for `aws` via `fish_update_completions` are pretty useless due to non-standard formatting.\0A\0Afunction __s3_is_maybe_bucket\0A    commandline -ct | string match -qr -- '^(|s|s3|s3:?/?/?[^/]*)$'\0Aend\0A\0Afunction __s3_is_bucket\0A    commandline -ct | string match -q -r -- '^s3:/?/?[^/]*$'\0Aend\0A\0Afunction __s3_is_remote_path\0A    commandline -ct | string match -q -r -- \22^s3://.+/.*\22\0Aend\0A\0Afunction __s3_ls_buckets\0A    aws s3 ls | string replace -rf '.* (\\S+)$' 's3://$1/'\0Aend\0A\0Afunction __s3_ls_dir\0A    set -l dir (commandline -ct | string replace -rf '(s3://.*/).*' '$1')\0A    printf \22$dir%s\\n\22 (aws s3 ls $dir 2>/dev/null | string replace -fr '^(:?\\S+ +\\S+ +\\S+ |^.*PRE )(.*)' '$2')\0Aend\0A\0A# Determines whether the first non-switch argument to `aws s3` was in $argv\0A# This accounts for things like `aws --debug s3 foo ... s3://...`\0Afunction __s3_cmd_in\0A    set -l is_s3 0\0A    set -l tokens (commandline -cx)\0A    for token in $tokens[2..-1]\0A        # Ignore switches everywhere\0A        if string match -qr -- \22^--\22 $token\0A            continue\0A        end\0A\0A        # Check if `aws` command is `s3`\0A        if test $is_s3 -eq 0\0A            if string match -q -- s3 $token\0A                set is_s3 1\0A                continue\0A            else\0A                return 1\0A            end\0A        end\0A\0A        # Check if `aws s3` sub-sub-command is in $argv\0A        if contains $token $argv\0A            return 0\0A        else\0A            return 1\0A        end\0A    end\0A\0A    return 1\0Aend\0A\0A# S3 completions\0Acomplete -c aws -n \22__fish_prev_arg_in s3\22 -xa \22cp mv rm help sync ls mb mv presign rb website\22\0A\0A# When completing a remote path, complete the bucket name first, then based off\0A# the bucket name, we can complete the path itself.\0A\0A# Commands that take only remote parameters (cannot operate on local files).\0Acomplete -c aws -n \22__s3_is_maybe_bucket && __s3_cmd_in ls rb rm\22 -xa \22(__s3_ls_buckets)\22\0A# Commands that can operate on local or remote files. To prevent the shell\0A# locking up unnecessarily, only complete if no argument was specified or if the\0A# argument being specified could be an S3 path.\0Acomplete -c aws -n \22__s3_is_maybe_bucket && __s3_cmd_in mv cp presign mb sync\22 -a \22(__s3_ls_buckets)\22\0A\0A# Complete the paths themselves\0Acomplete -c aws -n __s3_is_remote_path -xa \22(__s3_ls_dir)\22\0Acomplete -c aws -n __s3_is_bucket -xa \22(__s3_ls_buckets)\22\0A\0A# This list is extracted from the output of `aws help`, which can't be ingested directly,\0A# as it emits considerable ANSI output and other terminal control characters.\0Aset -l aws_services \\\0A    acm \\\0A    acm-pca \\\0A    alexaforbusiness \\\0A    amplify \\\0A    apigateway \\\0A    apigatewaymanagementapi \\\0A    apigatewayv2 \\\0A    application-autoscaling \\\0A    appmesh \\\0A    appstream \\\0A    appsync \\\0A    athena \\\0A    autoscaling \\\0A    autoscaling-plans \\\0A    backup \\\0A    batch \\\0A    budgets \\\0A    ce \\\0A    chime \\\0A    cloud9 \\\0A    clouddirectory \\\0A    cloudformation \\\0A    cloudfront \\\0A    cloudhsm \\\0A    cloudhsmv2 \\\0A    cloudsearch \\\0A    cloudsearchdomain \\\0A    cloudtrail \\\0A    cloudwatch \\\0A    codebuild \\\0A    codecommit \\\0A    codepipeline \\\0A    codestar \\\0A    cognito-identity \\\0A    cognito-idp \\\0A    cognito-sync \\\0A    comprehend \\\0A    comprehendmedical \\\0A    configservice \\\0A    configure \\\0A    connect \\\0A    cur \\\0A    datapipeline \\\0A    datasync \\\0A    dax \\\0A    deploy \\\0A    devicefarm \\\0A    directconnect \\\0A    discovery \\\0A    dlm \\\0A    dms \\\0A    docdb \\\0A    ds \\\0A    dynamodb \\\0A    dynamodbstreams \\\0A    ec2 \\\0A    ecr \\\0A    ecs \\\0A    efs \\\0A    eks \\\0A    elasticache \\\0A    elasticbeanstalk \\\0A    elastictranscoder \\\0A    elb \\\0A    elbv2 \\\0A    emr \\\0A    es \\\0A    events \\\0A    firehose \\\0A    fms \\\0A    fsx \\\0A    gamelift \\\0A    glacier \\\0A    globalaccelerator \\\0A    glue \\\0A    greengrass \\\0A    guardduty \\\0A    health \\\0A    help \\\0A    history \\\0A    iam \\\0A    importexport \\\0A    inspector \\\0A    iot \\\0A    iot-data \\\0A    iot-jobs-data \\\0A    iot1click-devices \\\0A    iot1click-projects \\\0A    iotanalytics \\\0A    kafka \\\0A    kinesis \\\0A    kinesis-video-archived-media \\\0A    kinesis-video-media \\\0A    kinesisanalytics \\\0A    kinesisanalyticsv2 \\\0A    kinesisvideo \\\0A    kms \\\0A    lambda \\\0A    lex-models \\\0A    lex-runtime \\\0A    license-manager \\\0A    lightsail \\\0A    logs \\\0A    machinelearning \\\0A    macie \\\0A    marketplace-entitlement \\\0A    marketplacecommerceanalytics \\\0A    mediaconnect \\\0A    mediaconvert \\\0A    medialive \\\0A    mediapackage \\\0A    mediastore \\\0A    mediastore-data \\\0A    mediatailor \\\0A    meteringmarketplace \\\0A    mgh \\\0A    mobile \\\0A    mq \\\0A    mturk \\\0A    neptune \\\0A    opsworks \\\0A    opsworks-cm \\\0A    organizations \\\0A    pi \\\0A    pinpoint \\\0A    pinpoint-email \\\0A    pinpoint-sms-voice \\\0A    polly \\\0A    pricing \\\0A    quicksight \\\0A    ram \\\0A    rds \\\0A    rds-data \\\0A    redshift \\\0A    rekognition \\\0A    resource-groups \\\0A    resourcegroupstaggingapi \\\0A    robomaker \\\0A    route53 \\\0A    route53domains \\\0A    route53resolver \\\0A    s3 \\\0A    s3api \\\0A    s3control \\\0A    sagemaker \\\0A    sagemaker-runtime \\\0A    sdb \\\0A    secretsmanager \\\0A    securityhub \\\0A    serverlessrepo \\\0A    servicecatalog \\\0A    servicediscovery \\\0A    ses \\\0A    shield \\\0A    signer \\\0A    sms \\\0A    snowball \\\0A    sns \\\0A    sqs \\\0A    ssm \\\0A    stepfunctions \\\0A    storagegateway \\\0A    sts \\\0A    support \\\0A    swf \\\0A    textract \\\0A    transcribe \\\0A    transfer \\\0A    translate \\\0A    waf \\\0A    waf-regional \\\0A    workdocs \\\0A    worklink \\\0A    workmail \\\0A    workspaces \\\0A    xray\0A\0Acomplete -c aws -n \22__fish_is_nth_token 1\22 -xa \22$aws_services\22\0A", align 1
