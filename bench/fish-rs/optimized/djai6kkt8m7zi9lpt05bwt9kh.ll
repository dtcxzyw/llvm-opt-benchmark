@anon.1d0b41a8d45d477c3029ec78f9b8b434.1084 = private unnamed_addr constant [4418 x i8] c"# Apache Ant (1.9.5) completion for Fish Shell.\0A\0Afunction __fish_complete_ant_targets -d \22Print list of targets from build.xml and imported files\22\0A    function __get_buildfile -d \22Get a buildfile that will be used by ant\22\0A        set -l tokens $argv # tokens from 'commandline -xpc'\0A        set -l prev $tokens[1]\0A        set -l buildfile \22build.xml\22\0A        for token in $argv[2..-1]\0A            switch $prev\0A                case -buildfile -file -f\0A                    set buildfile echo $token\0A            end\0A            set prev $token\0A        end\0A        # return last one\0A        echo $buildfile\0A    end\0A    function __parse_ant_targets_from_projecthelp -d \22Parse ant targets from projecthelp\22\0A        set -l buildfile $argv[1] # full path to buildfile\0A        set -l targets (ant -p -debug -f $buildfile 2> /dev/null | string match -r '^\\s[[:graph:]].*$')\0A        for target in $targets\0A            # Use [[:graph:]] and [[:print:]] to ignore ANSI escape code\0A            set -l tokens (string match -r '^\\s([[:graph:]]+)(?:\\s+([[:print:]]+))?' \22$target\22)\0A            if test (count $tokens) -ge 3\0A                echo $tokens[2]\\t$tokens[3]\0A            else if test (count $tokens) -ge 2\0A                echo $tokens[2]\0A            end\0A        end\0A    end\0A    function __get_ant_targets_from_projecthelp -d \22Get ant targets from projecthelp\22\0A        set -l buildfile $argv[1] # full path to buildfile\0A\0A        set -l xdg_cache_home $XDG_CACHE_HOME[1]\0A        if test -z \22$xdg_cache_home\22\0A            set xdg_cache_home $HOME/.cache\0A        end\0A\0A        set -l cache_dir $xdg_cache_home/fish/ant_completions\0A        mkdir -p $cache_dir\0A\0A        set -l cache_file $cache_dir/(__fish_md5 -s $buildfile)\0A        if test ! -s \22$cache_file\22\0A            # generate cache file if empty\0A            __parse_ant_targets_from_projecthelp $buildfile >$cache_file\0A        end\0A\0A        cat $cache_file\0A    end\0A\0A    set -l tokens $argv\0A    set -l buildfile (__get_buildfile $tokens | path filter)\0A    or return 1 # return nothing if buildfile does not exist\0A\0A    __get_ant_targets_from_projecthelp $buildfile\0Aend\0A\0A# completion for ant targets\0Acomplete -x -c ant -a \22(__fish_complete_ant_targets (commandline -xpc))\22\0A\0A# Script Options:\0Acomplete -f -c ant -l help -l h -d 'print help message and ant help'\0Acomplete -f -c ant -l noconfig -d 'suppress sourcing of configuration files'\0Acomplete -f -c ant -l usejikes -d 'enable use of jikes by default'\0Acomplete -f -c ant -l execdebug -d 'print ant exec line generated by this launch script'\0A# Options:\0Acomplete -f -c ant -o help -s h -d 'print help message'\0Acomplete -f -c ant -o projecthelp -s p -d 'print project help information'\0Acomplete -f -c ant -o version -d 'print the version information'\0Acomplete -f -c ant -o diagnostics -d 'print diagnostic information'\0Acomplete -f -c ant -o quiet -s q -d 'be extra quiet'\0Acomplete -f -c ant -o silent -s S -d 'print nothing but task outputs and build failures'\0Acomplete -f -c ant -o verbose -s v -d 'be extra verbose'\0Acomplete -f -c ant -o debug -s d -d 'print debugging information'\0Acomplete -f -c ant -o emacs -s e -d 'produce logging information without adornments'\0Acomplete -f -c ant -o noinput -d 'do not allow interactive input'\0Acomplete -f -c ant -s D -d 'use value for given property like -D<property>=<value>'\0Acomplete -f -c ant -o keep-going -s k -d 'execute all targets that do not depend on failed target(s)'\0Acomplete -f -c ant -o nouserlib -d 'Run ant without using jar files from ${user.home}/.ant/lib'\0Acomplete -f -c ant -o noclasspath -d 'Run ant without using CLASSPATH'\0Acomplete -f -c ant -o autoproxy -d 'Java1.5+: use the OS proxy settings'\0Acomplete -r -c ant -o lib -d 'specifies a path to search for jars and classes'\0Acomplete -r -c ant -o logfile -s l -d 'use given file for log'\0Acomplete -r -c ant -o logger -d 'the class which is to perform logging'\0Acomplete -r -c ant -o listener -d 'add an instance of class as a project listener'\0Acomplete -r -c ant -o buildfile -o file -s f -d 'use given buildfile'\0Acomplete -r -c ant -o propertyfile -d 'load properties from file, -D properties takes precedence'\0Acomplete -r -c ant -o inputhandler -d 'the class which will handle input requests'\0Acomplete -r -c ant -o find -s s -d 'search for buildfile towards the root and use it'\0Acomplete -r -c ant -o nice -d 'A niceness value for the main thread'\0Acomplete -r -c ant -o main -d 'override Ant\\'s normal entry point'\0A", align 1
