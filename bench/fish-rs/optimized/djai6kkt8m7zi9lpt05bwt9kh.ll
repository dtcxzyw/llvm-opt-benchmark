@anon.1d0b41a8d45d477c3029ec78f9b8b434.3186 = private unnamed_addr constant [1503 x i8] c"function __fish_complete_zfs_write_once_properties -d \22Completes with ZFS properties which can only be written at filesystem creation, and only be read thereafter\22\0A    set -l OS \22\22\0A    switch (uname)\0A        case Linux\0A            set OS Linux\0A        case Darwin\0A            set OS macOS\0A        case FreeBSD\0A            set OS FreeBSD\0A        case SunOS\0A            set OS SunOS\0A            # Others?\0A        case \22*\22\0A            set OS unknown\0A    end\0A    echo -e \22normalization\\tUnicode normalization (none, formC, formD, formKC, formKD)\22\0A    echo -e \22utf8only\\tReject non-UTF-8-compliant filenames (on, off)\22\0A    if test $OS = Linux\0A        echo -e \22overlay\\tAllow overlay mount (on, off)\22\0A        if command -sq sestatus # SELinux is enabled\0A            echo -e \22context\\tSELinux context for the child filesystem\22\0A            echo -e \22fscontext\\tSELinux context for the filesystem being mounted\22\0A            echo -e \22defcontext\\tSELinux context for unlabeled files\22\0A            echo -e \22rootcontext\\tSELinux context for the root inode of the filesystem\22\0A        end\0A        echo -e \22casesensitivity\\tCase sensitivity (sensitive, insensitive)\22\0A    else\0A        echo -e \22casesensitivity\\tCase sensitivity (sensitive, insensitive, mixed)\22\0A    end\0A    if __fish_is_openzfs\0A        echo -e \22keylocation\\tSpecify key location/type\22\0A        echo -e \22pbkdf2iters\\tNumber of PBKDF2 iterations\22\0A        echo -e \22keyformat\\tSpecify key format\22\0A        echo -e \22encryption\\tEncryption of dataset\22\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3187 = private unnamed_addr constant [40 x i8] c"functions/__fish_concat_completions.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3188 = private unnamed_addr constant [2032 x i8] c"# This function is intended to be used to generate completions in `-a \22(...)\22` calls for arguments that take 1..n values\0A# separated by commas and we dynamically or statically generated a list of n values that must be combined and permuted\0A# in order to appease both the `complete` machinery and the target application.\0A#\0A# TODO: Make this work with completions that have their description appended after a \\t\0A\0Afunction __fish_concat_completions -d \22Generate completions that are specified as comma-separated values from stdin source\22\0A    type -q awk || return\0A\0A    set -l token (commandline -ct)\0A    # We want to filter out suggestions the user has already entered.\0A    set -l extant (string split -- ',' $token)\0A    set -l filter (printf '^%s$\\n' (printf '%s\\n' $extant | string escape --style=regex) | string join '|')\0A    # Work around the insanity of trying to read from stdin within a function. Note that we can't place the\0A    # `read` call in between () to capture the output because that breaks its connection to stdin.\0A    while read -l line\0A        echo $line\0A    end | string match -er '.' | string match -rv -- $filter | string replace -r '^' -- (string replace -rf -- '^(.+),.*$' '$1,' $token; or echo \22\22)\0A\0A    return\0A    # Verified compatible with bsd awk and gnu awk\0A    awk '\0A        {\0A            lines[NR-1] = $0\0A        }\0A        END {\0A            n = NR\0A            for (k = 1; k <= n; k++) {\0A                generate_permutations(lines, n, k)\0A            }\0A        }\0A        function generate_permutations(arr, total_len, perm_len, prefix, _i, _swap) {\0A            if (perm_len == 0) {\0A                print prefix\0A                return\0A            }\0A            for (_i = 0; _i < total_len; _i++) {\0A                _swap = arr[total_len-1]; arr[total_len-1] = arr[_i]; arr[_i] = _swap\0A                generate_permutations(arr, total_len-1, perm_len-1, prefix arr[total_len-1] (perm_len == 1 ? \22\22 : \22,\22))\0A                arr[_i] = arr[total_len-1]; arr[total_len-1] = _swap\0A            }\0A        }\0A    '\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3189 = private unnamed_addr constant [40 x i8] c"functions/__fish_config_interactive.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3190 = private unnamed_addr constant [8725 x i8] c"#\0A# Initializations that should only be performed when entering interactive mode.\0A#\0A# This function is called by the __fish_on_interactive function, which is defined in config.fish.\0A#\0Afunction __fish_config_interactive -d \22Initializations that should be performed when entering interactive mode\22\0A    # For one-off upgrades of the fish version\0A    if not set -q __fish_initialized\0A        set -U __fish_initialized 0\0A    end\0A\0A    set -g __fish_active_key_bindings\0A\0A    # usage: __init_uvar VARIABLE VALUES...\0A    function __init_uvar -d \22Sets a universal variable if it's not already set\22\0A        if not set --query $argv[1]\0A            set --universal $argv\0A        end\0A    end\0A\0A    # If we are starting up for the first time, set various defaults.\0A    if test $__fish_initialized -lt 3400\0A        # Create empty configuration directores if they do not already exist\0A        test -e $__fish_config_dir/completions/ -a -e $__fish_config_dir/conf.d/ -a -e $__fish_config_dir/functions/ ||\0A            mkdir -p $__fish_config_dir/{completions, conf.d, functions}\0A\0A        # Create config.fish with some boilerplate if it does not exist\0A        test -e $__fish_config_dir/config.fish || echo \22\\\0Aif status is-interactive\0A    # Commands to run in interactive sessions can go here\0Aend\22 >$__fish_config_dir/config.fish\0A\0A        echo yes | fish_config theme save \22fish default\22\0A        set -Ue fish_color_keyword fish_color_option\0A    end\0A    if test $__fish_initialized -lt 3800 && test \22$fish_color_search_match[1]\22 = bryellow\0A        set --universal fish_color_search_match[1] white\0A    end\0A\0A    #\0A    # Generate man page completions if not present.\0A    #\0A    # Don't do this if we're being invoked as part of running unit tests.\0A    if not set -q FISH_UNIT_TESTS_RUNNING\0A        # Check if our manpage completion script exists because some distros split it out.\0A        # (#7183)\0A        set -l script $__fish_data_dir/tools/create_manpage_completions.py\0A        if not test -d $__fish_cache_dir/generated_completions; and test -e \22$script\22\0A            # Generating completions from man pages needs python (see issue #3588).\0A\0A            # We cannot simply do `fish_update_completions &` because it is a function.\0A            # We cannot do `eval` since it is a function.\0A            # We don't want to call `fish -c` since that is unnecessary and sources config.fish again.\0A            # Hence we'll call python directly.\0A            # c_m_p.py should work with any python version.\0A            set -l update_args -B $__fish_data_dir/tools/create_manpage_completions.py --manpath --cleanup-in $__fish_user_data_dir/generated_completions --cleanup-in $__fish_cache_dir/generated_completions\0A            if set -l python (__fish_anypython)\0A                # Run python directly in the background and swallow all output\0A                # Orphan the job so that it continues to run in case of an early exit (#6269)\0A                /bin/sh -c '( \22$@\22 ) >/dev/null 2>&1 &' -- $python $update_args\0A            end\0A        end\0A    end\0A\0A    #\0A    # Print a greeting.\0A    # The default just prints a variable of the same name.\0A    #\0A    # NOTE: This status check is necessary to not print the greeting when `read`ing in scripts. See #7080.\0A    if status --is-interactive\0A        and functions -q fish_greeting\0A        fish_greeting\0A    end\0A\0A    #\0A    # Completions for SysV startup scripts. These aren't bound to any\0A    # specific command, so they can't be autoloaded.\0A    #\0A    if test -d /etc/init.d\0A        complete -x -p \22/etc/init.d/*\22 -a start --description 'Start service'\0A        complete -x -p \22/etc/init.d/*\22 -a stop --description 'Stop service'\0A        complete -x -p \22/etc/init.d/*\22 -a status --description 'Print service status'\0A        complete -x -p \22/etc/init.d/*\22 -a restart --description 'Stop and then start service'\0A        complete -x -p \22/etc/init.d/*\22 -a reload --description 'Reload service configuration'\0A    end\0A\0A    #\0A    # Only a few builtins take filenames; initialize the rest with no file completions\0A    #\0A    complete -c(builtin -n | string match -rv '(\\.|:|source|cd|contains|count|echo|exec|fish_indent|printf|random|realpath|set|\\\\[|test|for)') --no-files\0A\0A    # Reload key bindings when binding variable change\0A    function __fish_reload_key_bindings -d \22Reload key bindings when binding variable change\22 --on-variable fish_key_bindings\0A        # Make sure some key bindings are set\0A        __init_uvar fish_key_bindings fish_default_key_bindings\0A\0A        # Do nothing if the key bindings didn't actually change.\0A        # This could be because the variable was set to the existing value\0A        # or because it was a local variable.\0A        # If fish_key_bindings is empty on the first run, we still need to set the defaults.\0A        if test \22$fish_key_bindings\22 = \22$__fish_active_key_bindings\22 -a -n \22$fish_key_bindings\22\0A            return\0A        end\0A        # Check if fish_key_bindings is a valid function.\0A        # If not, either keep the previous bindings (if any) or revert to default.\0A        # Also print an error so the user knows.\0A        if not functions -q \22$fish_key_bindings\22\0A            echo \22There is no fish_key_bindings function called: '$fish_key_bindings'\22 >&2\0A            # We need to see if this is a defined function, otherwise we'd be in an endless loop.\0A            if functions -q $__fish_active_key_bindings\0A                echo \22Keeping $__fish_active_key_bindings\22 >&2\0A                # Set the variable to the old value so this error doesn't happen again.\0A                set fish_key_bindings $__fish_active_key_bindings\0A                return 1\0A            else if functions -q fish_default_key_bindings\0A                echo \22Reverting to default bindings\22 >&2\0A                set fish_key_bindings fish_default_key_bindings\0A                # Return because we are called again\0A                return 0\0A            else\0A                # If we can't even find the default bindings, something is broken.\0A                # Without it, we would eventually run into the stack size limit, but that'd print hundreds of duplicate lines\0A                # so we should give up earlier.\0A                echo \22Cannot find fish_default_key_bindings, falling back to very simple bindings.\22 >&2\0A                echo \22Most likely something is wrong with your installation.\22 >&2\0A                return 0\0A            end\0A        end\0A        set -g __fish_active_key_bindings \22$fish_key_bindings\22\0A        set -g fish_bind_mode default\0A        # Redirect stderr per #1155\0A        $fish_key_bindings 2>/dev/null\0A        # Load user key bindings if they are defined\0A        if functions --query fish_user_key_bindings >/dev/null\0A            fish_user_key_bindings 2>/dev/null\0A        end\0A    end\0A\0A    # Load key bindings\0A    __fish_reload_key_bindings\0A\0A    # Detect whether the terminal reflows on its own\0A    # If it does we shouldn't do it.\0A    # Allow $fish_handle_reflow to override it.\0A    if not set -q fish_handle_reflow\0A        # VTE reflows the text itself, so us doing it inevitably races against it.\0A        # Guidance from the VTE developers is to let them repaint.\0A        if set -q VTE_VERSION\0A            # Same for these terminals\0A            or string match -q -- 'alacritty*' $TERM\0A            or test \22$TERM_PROGRAM\22 = WezTerm\0A            set -g fish_handle_reflow 0\0A        else if set -q KONSOLE_VERSION\0A            and test \22$KONSOLE_VERSION\22 -ge 210400 2>/dev/null\0A            # Konsole since version 21.04(.00)\0A            # Note that this is optional, but since we have no way of detecting it\0A            # we go with the default, which is true.\0A            set -g fish_handle_reflow 0\0A        else\0A            set -g fish_handle_reflow 1\0A        end\0A    end\0A\0A    function __fish_winch_handler --on-signal WINCH -d \22Repaint screen when window changes size\22\0A        if test \22$fish_handle_reflow\22 = 1 2>/dev/null\0A            commandline -f repaint >/dev/null 2>/dev/null\0A        end\0A    end\0A\0A    # Notify terminals when $PWD changes via OSC 7 (issue #906).\0A    function __fish_update_cwd_osc --on-variable PWD --description 'Notify terminals when $PWD changes'\0A        set -l host $hostname\0A        if set -q KONSOLE_VERSION\0A            set host ''\0A        end\0A        if [ \22$TERM\22 = dumb ]\0A            return\0A        end\0A        printf \\e\\]7\\;file://%s%s\\a $host (string escape --style=url -- $PWD)\0A    end\0A    __fish_update_cwd_osc # Run once because we might have already inherited a PWD from an old tab\0A\0A    # Bump this whenever some code below needs to run once when upgrading to a new version.\0A    # The universal variable __fish_initialized is initialized in share/config.fish.\0A    set __fish_initialized 3800\0A\0A    functions -e __fish_config_interactive\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3191 = private unnamed_addr constant [34 x i8] c"functions/__fish_contains_opt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3192 = private unnamed_addr constant [1077 x i8] c"function __fish_contains_opt -d \22Checks if a specific option has been given in the current commandline\22\0A    set -l next_short\0A    set -l short_opt\0A    set -l long_opt\0A\0A    for i in $argv\0A        if test -n \22$next_short\22\0A            set next_short\0A            set -a short_opt $i\0A        else\0A            switch $i\0A                case -s\0A                    set next_short 1\0A                case '-*'\0A                    echo __fish_contains_opt: Unknown option $i >&2\0A                    return 1\0A                case '*'\0A                    set -a long_opt $i\0A            end\0A        end\0A    end\0A\0A    for i in $short_opt\0A        if test -z \22$i\22\0A            continue\0A        end\0A\0A        if string match -qr -- \22^-$i|^-[^-]*$i\22 (commandline -cpx)\0A            return 0\0A        end\0A\0A        if string match -qr -- \22^-$i|^-[^-]*$i\22 (commandline -ct)\0A            return 0\0A        end\0A    end\0A\0A    for i in $long_opt\0A        if test -z \22$i\22\0A            continue\0A        end\0A\0A        if contains -- --$i (commandline -cpx)\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3193 = private unnamed_addr constant [35 x i8] c"functions/__fish_crux_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3194 = private unnamed_addr constant [184 x i8] c"# a function to obtain a list of installed packages with CRUX pkgutils\0Afunction __fish_crux_packages -d 'Obtain a list of installed packages'\0A    pkginfo -i | string split -f1 ' '\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3195 = private unnamed_addr constant [36 x i8] c"functions/__fish_cursor_konsole.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3196 = private unnamed_addr constant [314 x i8] c"function __fish_cursor_konsole -d 'Set cursor (konsole)'\0A    set -l shape $argv[1]\0A    switch \22$shape\22\0A        case block\0A            echo -en '\\e]50;CursorShape=0\\x7'\0A        case underscore\0A            echo -en '\\e]50;CursorShape=2\\x7'\0A        case line\0A            echo -en '\\e]50;CursorShape=1\\x7'\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3197 = private unnamed_addr constant [34 x i8] c"functions/__fish_cursor_xterm.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3198 = private unnamed_addr constant [408 x i8] c"function __fish_cursor_xterm -d 'Set cursor (xterm)'\0A    set -l shape $argv[1]\0A\0A    switch \22$shape\22\0A        case block\0A            set shape 2\0A        case underscore\0A            set shape 4\0A        case line\0A            set shape 6\0A        case '*'\0A            # Unknown shape\0A            return\0A    end\0A    if contains blink $argv\0A        set shape (math $shape - 1)\0A    end\0A    echo -en \22\\e[$shape q\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3199 = private unnamed_addr constant [38 x i8] c"functions/__fish_describe_command.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3200 = private unnamed_addr constant [757 x i8] c"#\0A# This function is used internally by the fish command completion code\0A#\0A\0A# Perform this check once at startup rather than on each invocation\0Aif not type -q apropos\0A    function __fish_describe_command\0A    end\0A    exit\0Aend\0A\0Afunction __fish_describe_command -d \22Command used to find descriptions for commands\22\0A    # $argv will be inserted directly into the awk regex, so it must be escaped\0A    set -l argv_regex (string escape --style=regex -- \22$argv\22)\0A    __fish_apropos ^$argv 2>/dev/null | awk -v FS=\22 +- +\22 '{\0A\09\09split($1, names, \22, \22);\0A\09\09for (name in names)\0A\09\09\09if (names[name] ~ /^'\22$argv_regex\22'.* *\\([18]\\)/ ) {\0A\09\09\09\09sub( \22( |\\t)*\\\\\\([18]\\\\\\)\22, \22\22, names[name] );\0A\09\09\09\09sub( \22 \\\\\\[.*\\\\\\]\22, \22\22, names[name] );\0A\09\09\09\09print names[name] \22\\t\22 $2;\0A\09\09\09}\0A\09}'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3201 = private unnamed_addr constant [26 x i8] c"functions/__fish_echo.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3202 = private unnamed_addr constant [392 x i8] c"function __fish_echo --description 'run the given command after the current commandline and redraw the prompt'\0A    set -l line (commandline --line)\0A    string >&2 repeat -N \\n --count=(math (commandline | count) - $line + 1)\0A    $argv >&2\0A    string >&2 repeat -N \\n --count=(math (count (fish_prompt)) - 1)\0A    string >&2 repeat -N \\n --count=(math $line - 1)\0A    commandline -f repaint\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3203 = private unnamed_addr constant [47 x i8] c"functions/__fish_edit_command_if_at_cursor.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3204 = private unnamed_addr constant [751 x i8] c"function __fish_edit_command_if_at_cursor --description 'If cursor is at the command token, edit the command source file'\0A    set -l tokens (commandline -xpc)\0A    set -l command\0A    if not set -q tokens[1]\0A        set command (commandline -xp)[1]\0A    else if test (count $tokens) = 1 && test -z \22$(commandline -t)\22\0A        set command $tokens[1]\0A    end\0A\0A    set -q command[1]\0A    or return 1\0A    set -l command_path (command -v -- $command)\0A    or return 1\0A    test -w $command_path\0A    or return 1\0A    string match -q 'text/*' (file --brief --mime-type -L -- $command_path)\0A    or return 1\0A\0A    set -l editor (__fish_anyeditor)\0A    or return 0 # We already printed a warning, so tell the caller to finish.\0A    $editor $command_path\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3205 = private unnamed_addr constant [33 x i8] c"functions/__fish_first_token.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3206 = private unnamed_addr constant [291 x i8] c"# Retrieves the first non-switch argument from the command line buffer\0Afunction __fish_first_token\0A    set -l tokens (commandline -cx)\0A    set -e tokens[1]\0A    set -l tokens (string replace -r --filter '^([^-].*)' '$1' -- $tokens)\0A    if set -q tokens[1]\0A        echo $tokens[1]\0A    end\0Aend\0A", align 1
