r add a local package'\0Acomplete -c $progname -s F -f -l files -n $noopt -d 'Query the files database'\0Acomplete -c $progname -s V -f -l version -d 'Display version and exit'\0Acomplete -c $progname -s h -f -l help -d 'Display help'\0A# pacaur operations\0Acomplete -c $progname -n $noopt -s s -l search -d \22(AUR) Search for packages\22\0Acomplete -c $progname -n $noopt -s i -l info -d \22(AUR) Show info for packages\22\0Acomplete -c $progname -n $noopt -s m -l makepkg -d \22(AUR) Clone the packages' build files and build them\22\0Acomplete -c $progname -n $noopt -s y -l sync -d \22(AUR) Clone build files, build and install packages\22\0Acomplete -c $progname -n $noopt -s k -l check -d \22(AUR) Check foreign packages for updates\22\0Acomplete -c $progname -n $noopt -s u -l update -d \22(AUR) Update foreign packages\22\0Acomplete -c $progname -n \22$noopt; and not __fish_contains_opt -s d download\22 -s d -l download -d \22(AUR) Clone the packages' build files\22\0Acomplete -c $progname -n \22$noopt; and __fish_contains_opt -s d download\22 -s d -l download -d \22Download dependencies recursively\22\0A\0A# General options\0A# Only offer these once a command has been given so they get prominent display\0Acomplete -c $progname -n $noopt -s b -l dbpath -d 'Alternative database location' -xa '(__fish_complete_directories)'\0Acomplete -c $progname -n $hasopt -s r -l root -d 'Alternative installation root'\0Acomplete -c $progname -n $hasopt -s v -l verbose -d 'Output more status messages'\0Acomplete -c $progname -n $hasopt -l arch -d 'Alternate architecture' -f\0Acomplete -c $progname -n $hasopt -l cachedir -d 'Alternative package cache location'\0Acomplete -c $progname -n $hasopt -l config -d 'Alternate config file'\0Acomplete -c $progname -n $hasopt -l debug -d 'Display debug messages' -f\0Acomplete -c $progname -n $hasopt -l gpgdir -d 'GPG directory to verify signatures'\0Acomplete -c $progname -n $hasopt -l hookdir -d 'Hook file directory'\0Acomplete -c $progname -n $hasopt -l logfile -d 'Specify alternative log file'\0Acomplete -c $progname -n $hasopt -l noconfirm -d 'Bypass any question' -f\0A# General options (pacaur only)\0Acomplete -c $progname -n $hasopt -s a -l aur -d 'Apply only for AUR targets'\0Acomplete -c $progname -n $hasopt -s r -l repo -d 'Apply only for specified repo'\0Acomplete -c $progname -n $hasopt -s r -l edit -d 'Edit build files'\0Acomplete -c $progname -n $hasopt -l noedit -d 'Do not edit build files'\0Acomplete -c $progname -n $hasopt -l rebuild -d 'Always rebuild packages'\0Acomplete -c $progname -n $hasopt -l silent -d 'Redirect output to the log in the clone directory'\0Acomplete -c $progname -n $hasopt -l domain -x -d 'Point at a domain other than the default aur.archlinux.org'\0Acomplete -c $progname -n $hasopt -l devel -d 'Use devel packages'\0Acomplete -c $progname -n $hasopt -l ignore-ood -d 'Ignore all results marked as out of date'\0Acomplete -c $progname -n $hasopt -l no-ignore-ood -d 'Do not ignore all results marked as out of date'\0Acomplete -c $progname -n $hasopt -l sort -d 'Sort ascending by key' -xa \22name votes popularity\22\0Acomplete -c $progname -n $hasopt -l rsort -d 'Sort descending by key' -xa \22name votes popularity\22\0Acomplete -c $progname -n $hasopt -l by -d 'Search by field' -xa \22name name-desc maintainer\22\0A\0A# Transaction options (sync, remove, upgrade)\0Afor condition in sync remove upgrade\0A    complete -c $progname -n $$condition -s d -l nodeps -d 'Skip [all] dependency checks' -f\0A    complete -c $progname -n $$condition -l dbonly -d 'Modify database entry only' -f\0A    complete -c $progname -n $$condition -l noprogressbar -d 'Do not display progress bar' -f\0A    complete -c $progname -n $$condition -l noscriptlet -d 'Do not execute install script' -f\0A    complete -c $progname -n $$condition -s p -l print -d 'Dry run, only print targets' -f\0A    complete -c $progname -n $$condition -l print-format -x -d 'Specify printf-like format' -f\0Aend\0A\0A# Database and upgrade options (database, sync, upgrade)\0Afor condition in database sync upgrade\0A    complete -c $progname -n $$condition -l asdeps -d 'Mark PACKAGE as dependency' -f\0A    complete -c $progname -n $$condition -l asexplicit -d 'Mark PACKAGE as explicitly installed' -f\0Aend\0A\0A# Upgrade options (sync, upgrade)\0Afor condition in sync upgrade\0A    complete -c $progname -n $$condition -l force -d 'Bypass file conflict checks' -f\0A    complete -c $progname -n $$condition -l ignore -d 'Ignore upgrade of PACKAGE' -xa \22$listinstalled\22 -f\0A    complete -c $progname -n $$condition -l ignoregroup -d 'Ignore upgrade of GROUP' -xa \22$listgroups\22 -f\0A    complete -c $progname -n $$condition -l needed -d 'Do not reinstall up-to-date targets' -f\0A    complete -c $progname -n $$condition -l recursive -d 'Recursively reinstall all dependencies' -f\0Aend\0A\0A# Query and sync options\0Afor condition in query sync\0A    complete -c $progname -n $$condition -s g -l groups -d 'Display all packages in GROUP' -xa \22$listgroups\22 -f\0A    complete -c $progname -n $$condition -s i -l info -d 'Display information on PACKAGE' -f\0A    complete -c $progname -n $$condition -s q -l quiet -d 'Show less information' -f\0A    complete -c $progname -n $$condition -s s -l search -r -d 'Search packages for regexp' -f\0Aend\0A\0A# Query options\0Acomplete -c $progname -n $query -s c -l changelog -d 'View the change log of PACKAGE' -f\0Acomplete -c $progname -n $query -s d -l deps -d 'List only non-explicit packages (dependencies)' -f\0Acomplete -c $progname -n $query -s e -l explicit -d 'List only explicitly installed packages' -f\0Acomplete -c $progname -n $query -s k -l check -d 'Check if all files owned by PACKAGE are present' -f\0Acomplete -c $progname -n $query -s l -l list -d 'List all files owned by PACKAGE' -f\0Acomplete -c $progname -n $query -s m -l foreign -d 'List all packages not in the database' -f\0Acomplete -c $progname -n $query -s o -l owns -r -d 'Search for the package that owns FILE' -xa '' -f\0Acomplete -c $progname -n $query -s p -l file -d 'Apply the query to a package file, not package' -xa '' -f\0Acomplete -c $progname -n $query -s t -l unrequired -d 'List only unrequired packages' -f\0Acomplete -c $progname -n $query -s u -l upgrades -d 'List only out-of-date packages' -f\0Acomplete -c $progname -n \22$query\22 -d 'Installed package' -xa $listinstalled -f\0A\0A# Remove options\0Acomplete -c $progname -n $remove -s c -l cascade -d 'Also remove packages depending on PACKAGE' -f\0Acomplete -c $progname -n $remove -s n -l nosave -d 'Ignore file backup designations' -f\0Acomplete -c $progname -n $remove -s s -l recursive -d 'Also remove dependencies of PACKAGE' -f\0Acomplete -c $progname -n $remove -s u -l unneeded -d 'Only remove targets not required by PACKAGE' -f\0Acomplete -c $progname -n \22$remove\22 -d 'Installed package' -xa $listinstalled -f\0A\0A# Sync options\0Acomplete -c $progname -n $sync -s c -l clean -d 'Remove [all] packages from cache'\0Acomplete -c $progname -n $sync -s l -l list -xa \22$listrepos\22 -d 'List all packages in REPOSITORY'\0Acomplete -c $progname -n \22$sync; and not __fish_contains_opt -s u sysupgrade\22 -s u -l sysupgrade -d 'Upgrade all packages that are out of date'\0Acomplete -c $progname -n \22$sync; and __fish_contains_opt -s u sysupgrade\22 -s u -l sysupgrade -d 'Also downgrade packages'\0Acomplete -c $progname -n $sync -s w -l downloadonly -d 'Only download the target packages'\0Acomplete -c $progname -n $sync -s y -l refresh -d 'Download fresh copy of the package list'\0Acomplete -c $progname -n \22$sync\22 -xa \22$listall $listgroups\22\0A\0A# Database options\0Aset -l has_db_opt '__fish_contains_opt asdeps asexplicit'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -xa --asdeps -d 'Mark PACKAGE as dependency'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -xa --asexplicit -d 'Mark PACKAGE as explicitly installed'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -s k -l check -d 'Check database validity'\0Acomplete -c $progname -n \22$has_db_opt; and $database\22 -xa \22$listinstalled\22\0A\0A# File options - since pacman 5\0Aset -l has_file_opt '__fish_contains_opt list search -s l -s s'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa --list -d 'List files owned by given packages'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa -l -d 'List files owned by given packages'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa --search -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa -s -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files\22 -s y -l refresh -d 'Refresh the files database' -f\0Acomplete -c $progname -n \22$files\22 -s l -l list -d 'List files owned by given packages' -xa $listall\0Acomplete -c $progname -n \22$files\22 -s s -l search -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files\22 -s o -l owns -d 'Search for packages that include the given files'\0Acomplete -c $progname -n \22$files\22 -s q -l quiet -d 'Show less information' -f\0Acomplete -c $progname -n \22$files\22 -l machinereadable -d 'Show in machine readable format' -f\0A\0A# Upgrade options\0A# Theoretically, pacman reads packages in all formats that libarchive supports\0A# In practice, it's going to be tar.xz or tar.gz or tar.zst\0Acomplete -c $progname -n \22$upgrade\22 -k -xa '(__fish_complete_suffix pkg.tar.zst pkg.tar.xz pkg.tar.gz)' -d 'Package file'\0A", align 1
