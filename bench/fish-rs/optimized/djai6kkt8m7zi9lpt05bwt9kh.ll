@anon.1d0b41a8d45d477c3029ec78f9b8b434.2902 = private unnamed_addr constant [1028 x i8] c"# Wireshark - Interactively dump and analyze network traffic\0A\0A__fish_complete_wireshark wireshark\0A\0Acomplete -c wireshark -l display -d 'Specifies the X display to use' -x\0Acomplete -c wireshark -l fullscreen -d 'Start Wireshark in full screen' -x\0Acomplete -c wireshark -s g -d 'After reading in a capture file using th e-r flag, go to the given packet number' -x\0Acomplete -c wireshark -s H -d 'Hide the capture info dialog during live packet capture'\0Acomplete -c wireshark -s j -d 'When no exact match is found by a -J filter, select the first package before'\0Acomplete -c wireshark -s J -d 'Jump to packet matching filter (display filter syntax)' -x\0Acomplete -c wireshark -s k -d 'Start the capture session immediately'\0Acomplete -c wireshark -s l -d 'Turn on automatic scrolling'\0Acomplete -c wireshark -s m -d 'Set the font name used for most text' -x\0Acomplete -c wireshark -s P -d 'Override a configuration or data path' -x # TODO\0Acomplete -c wireshark -s S -d 'Automatically update the packet display as packets are coming in'\0A", align 1
