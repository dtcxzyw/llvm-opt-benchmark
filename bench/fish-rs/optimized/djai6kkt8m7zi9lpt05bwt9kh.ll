@anon.1d0b41a8d45d477c3029ec78f9b8b434.2934 = private unnamed_addr constant [1049 x i8] c"# Completions for xbps-pkgdb\0A# Author: Allen Sobot <chilledfrogs@disroot.org>\0A\0Aset -l progname xbps-pkgdb\0Aset -l modes auto manual hold unhold repolock repounlock\0A\0Acomplete -c $progname -f\0A\0Acomplete -c $progname -s a -d 'Process all registered packages, regardless of its state.'\0Acomplete -c $progname -s C -d 'Specifies a path to the XBPS configuration directory.' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s d -d 'Enables extra debugging shown to stderr.'\0Acomplete -c $progname -s h -d 'Show the help message.'\0Acomplete -c $progname -s m -d 'Set mode of PKGNAME' -xa \22$modes\22\0Acomplete -c $progname -n \22__fish_seen_subcommand_from $modes\22 -xa \22(__fish_print_xbps_packages -i)\22\0Acomplete -c $progname -s r -d 'Specifies a full path for the target root directory.' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s u -d 'Updates the pkgdb format to the latest version making the necessary conversions.'\0Acomplete -c $progname -s v -d 'Enables verbose messages.'\0Acomplete -c $progname -s V -d 'Show the version information.'\0A", align 1
