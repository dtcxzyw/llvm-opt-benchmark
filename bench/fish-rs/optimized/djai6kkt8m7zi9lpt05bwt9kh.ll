@anon.1d0b41a8d45d477c3029ec78f9b8b434.1720 = private unnamed_addr constant [1432 x i8] c"# Completions for git-sizer\0A\0Acomplete -f -c git-sizer -l help -d \22Display help for Git Sizer\22\0Acomplete -f -c git-sizer -s v -l verbose -d \22Report all statistics\22\0Acomplete -x -c git-sizer -l threshold -d \22Minimum level of concern\22\0Acomplete -f -c git-sizer -l critical -d \22Only report critical statistics\22\0Acomplete -x -c git-sizer -l names -d \22How to display names of large objects\22 -a \22\0A\09none\\t'Omit footnotes entirely'\0A\09hash\\t'Only show SHA-1s'\0A\09full\\t'Show full names'\0A\22\0Acomplete -f -c git-sizer -s j -l json -d \22Output results in JSON format\22\0Acomplete -x -c git-sizer -l json-version -d \22JSON format version to use\22 -a \221 2\22\0Acomplete -f -c git-sizer -l progress -d \22Report progress to stderr\22\0Acomplete -f -c git-sizer -l no-progress -d \22Don't report progress to stderr\22\0Acomplete -f -c git-sizer -l version -d \22Output git-sizer version\22\0Acomplete -x -c git-sizer -l branches -d \22Process branches\22\0Acomplete -x -c git-sizer -l tags -d \22Process tags\22\0Acomplete -x -c git-sizer -l remotes -d \22Process remote refs\22\0Acomplete -x -c git-sizer -l include -d \22Process refs with specified PREFIX\22\0Acomplete -x -c git-sizer -l exclude -d \22Don't process refs with specified PREFIX\22\0Acomplete -x -c git-sizer -l include-regexp -d \22Process refs matching specified regex\22\0Acomplete -x -c git-sizer -l exclude-regexp -d \22Don't process refs matching specified regex\22\0Acomplete -f -c git-sizer -l show-refs -d \22Show refs which are being included/excluded\22\0A", align 1
