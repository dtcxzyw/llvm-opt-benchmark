@anon.1d0b41a8d45d477c3029ec78f9b8b434.2250 = private unnamed_addr constant [1514 x i8] c"# openocd is a utility for programming microcontrollers, especially popular with\0A# developers targeting ARM devices. It has a number of pre-installed configuration\0A# scripts to control its connection behavior which are in its installation directory\0A# and may be specified at the command line via relative paths as if you were cd'd\0A# into that directory.\0A\0A# Retrieve the likely compile-time PREFIX for openocd based off of where the binary\0A# is located. e.g. if openocd is /usr/local/bin/openocd return /usr/local\0Afunction __fish_openocd_prefix\0A    string replace /bin/openocd \22\22 (command -s openocd)\0Aend\0A\0A# The results of this function are as if __fish_complete_suffix were called\0A# while cd'd into the openocd scripts directory\0Afunction __fish_complete_openocd_path\0A    __fish_complete_suffix --prefix=(__fish_openocd_prefix)/share/openocd/scripts \22$argv[1]\22\0Aend\0A\0Acomplete -c openocd -f # at no point does openocd take arbitrary arguments\0Acomplete -c openocd -s h -l help -d \22display help\22\0Acomplete -c openocd -s v -l version -d \22display version info\22\0Acomplete -c openocd -s f -l file -k -xa '(__fish_complete_openocd_path .cfg)'\0Acomplete -c openocd -s d -l debug -d \22run under debug level 3\22\0Acomplete -c openocd -s d -l debug -d \22run under debug level n\22 -xa '(seq 1 9)'\0Acomplete -c openocd -s l -l log_output -d \22redirect output to file\22 -r\0Acomplete -c openocd -s c -l command -d \22run command\22\0Acomplete -c openocd -s s -l search -d \22search path for config files and scripts\22 -xa '(__fish_complete_directories)'\0A", align 1
