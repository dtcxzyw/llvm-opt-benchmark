@anon.1d0b41a8d45d477c3029ec78f9b8b434.1156 = private unnamed_addr constant [2849 x i8] c"function __fish_argparse_exclusive_args --description 'Helper function to list unused options'\0A    set --local all_tokens (commandline --tokens-expanded)\0A    set --erase all_tokens[1]\0A    set --local current_token (commandline --current-token)\0A\0A    if set --local index (contains --index -- '--' $all_tokens)\0A        set index (math $index - 1)\0A    else\0A        set index (count $all_tokens)\0A    end\0A\0A    set --local specifications\0A    while test $index -gt 0\0A        and set -l tok $all_tokens[$index]\0A        and not string match --quiet -- '-*' $tok\0A\0A        if string match --quiet '*,*' $tok\0A            set index (math $index - 1)\0A            continue\0A        end\0A\0A        set -l opt (string replace --regex '=.*' '' $tok)\0A\0A        if string match --quiet '*/*' $opt\0A            set --append specifications (string split '/' $opt)\0A        else if string match --quiet '*#*' $opt\0A            set --append specifications (string split '#' $opt)\0A        else\0A            set --append specifications $opt\0A        end\0A        set index (math $index - 1)\0A    end\0A\0A    if string match --quiet -- '-x*' $current_token\0A        set current_token (string replace --regex -- '^-x' '' $current_token)\0A    end\0A\0A    if test $index -gt 1\0A        and string match --regex --quiet -- '^(-x|--exclusive)$' $all_tokens[(math $index - 1)]\0A        and not test -z $current_token\0A        set --erase specifications[(count $specifications)]\0A    end\0A\0A    set --local used_options (string split -- ',' $current_token)\0A    set --local unused_specifications\0A\0A    for item in $specifications\0A        if not contains -- $item $used_options\0A            set --append unused_specifications $item\0A        end\0A    end\0A\0A    string join \\n $unused_specifications\0Aend\0A\0Acomplete --command argparse --no-files\0A\0Acomplete --command argparse --short-option h --long-option help --description 'Show help'\0A\0Acomplete --command argparse --short-option n --long-option name --require-parameter --no-files \\\0A    --arguments '(functions --all | string replace \22, \22 \22\\n\22)' --description 'Use function name'\0Acomplete --command argparse --short-option x --long-option exclusive --no-files --require-parameter \\\0A    --arguments '(__fish_append \22,\22 (__fish_argparse_exclusive_args))' \\\0A    --description 'Specify mutually exclusive options'\0Acomplete --command argparse --short-option N --long-option min-args --no-files --require-parameter \\\0A    --description 'Specify minimum non-option argument count'\0Acomplete --command argparse --short-option X --long-option max-args --no-files --require-parameter \\\0A    --description 'Specify maximum non-option argument count'\0Acomplete --command argparse --short-option i --long-option ignore-unknown \\\0A    --description 'Ignore unknown options'\0Acomplete --command argparse --short-option s --long-option stop-nonopt \\\0A    --description 'Exit on subcommand'\0A", align 1
