@anon.1d0b41a8d45d477c3029ec78f9b8b434.2418 = private unnamed_addr constant [2350 x i8] c"# pv - Pipe Viewer - is a terminal-based tool for monitoring the progress of\0A# data through a pipeline.\0A# See: http://www.ivarch.com/programs/pv.shtml\0A\0Acomplete -c pv -l progress -s p -d 'Turn progress bar on'\0Acomplete -c pv -l timer -s t -d 'Show timer'\0Acomplete -c pv -l eta -s e -d 'Show estimated time left'\0Acomplete -c pv -l fineta -s I -d 'Show estimated time of arrival'\0Acomplete -c pv -l rate -s r -d 'Show rate counter'\0Acomplete -c pv -l average-rate -s a -d 'Show average rate'\0Acomplete -c pv -l bytes -s b -d 'Show total byte counter'\0Acomplete -c pv -l buffer-percent -s T -d 'Show transfer buffer percentage'\0Acomplete -c pv -l last-written -s A -d 'Show the last NUM bytes written'\0Acomplete -c pv -l format -s F -x -d 'Set output format'\0Acomplete -c pv -l numeric -s n -d 'Numeric output'\0Acomplete -c pv -l quiet -s q -d 'No output'\0Acomplete -c pv -l wait -s W -d 'Wait for first byte before showing progress'\0Acomplete -x -c pv -l delay-start -s D -d 'Wait given time (in secs) before showing progress'\0Acomplete -x -c pv -l size -s s -d 'Set total number of bytes to be transferred'\0Acomplete -c pv -l line-mode -s l -d 'Count lines instead of bytes'\0Acomplete -c pv -l null -s 0 -d 'Count null-terminated lines'\0Acomplete -x -c pv -l interval -s i -d 'Wait given time (in secs) between updates'\0Acomplete -x -c pv -l width -s w -d 'Set terminal width'\0Acomplete -x -c pv -l height -s H -d 'Set terminal height'\0Acomplete -x -c pv -l name -l N -d 'Prefix output with given name'\0Acomplete -c pv -l force -s f -d 'Force output'\0Acomplete -c pv -l cursor -s c -d 'Use cursor positioning escape sequence instead of \\r'\0Acomplete -x -c pv -l rate-limit -s L -d 'Limit transfer rate'\0Acomplete -x -c pv -l buffer-size -s B -d 'Use transfer buffer size (in bytes)'\0Acomplete -c pv -l no-splice -s C -d 'Don\\'t use slice'\0Acomplete -c pv -l skip-errors -s E -d 'Ignore read errors'\0Acomplete -c pv -l stop-at-size -s S -d 'Stop transfer after given number of bytes'\0Acomplete -x -c pv -l watchfd -s d -d 'Watch file given description from given process (PID:FD)'\0Acomplete -x -c pv -l remote -s R -d 'Change a running pv\\'s options' -a '(__fish_complete_pids | string match \\*\\tpv\\*)'\0Acomplete -x -c pv -l pidfile -s P -d 'Save pv PID in given file'\0Acomplete -c pv -l help -s h -d 'Show help and exit'\0Acomplete -c pv -l version -s V -d 'Show version and exit'\0A", align 1
