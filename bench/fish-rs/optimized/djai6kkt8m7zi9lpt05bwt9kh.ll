@anon.1d0b41a8d45d477c3029ec78f9b8b434.1934 = private unnamed_addr constant [9507 x i8] c"# Fish Shell command-line completions for Test Kitchen\0A\0Afunction __fish_kitchen_no_command -d 'Test if kitchen has yet to be given the main command'\0A    set -l cmd (commandline -xpc)\0A    test (count $cmd) -eq 1\0Aend\0A\0Afunction __fish_kitchen_using_command\0A    set -l cmd (commandline -xpc)\0A    set -q cmd[2]; and test \22$argv[1]\22 = $cmd[2]\0Aend\0A\0Afunction __fish_kitchen_list\0A    command kitchen list --bare\0Aend\0A\0A# help commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a help -d \22Describe available commands or one specific command\22\0A\0A# help help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a help -d \22Describe available commands or one specific command\22\0A\0A# list commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a list -d \22Lists one or more instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command list' -s b -l bare -d \22List the name of each instance only, one per line\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command list' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# list help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a list -d \22Lists one or more instances\22\0A\0A# list instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command list' -a '(__fish_kitchen_list)'\0A\0A# diagnose commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a diagnose -d \22Show computed diagnostic configuration\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command diagnose' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command diagnose' -l loader -d \22Include data loader diagnostics\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command diagnose' -l instances -d \22Include instances diagnostics\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command diagnose' -l all -d \22Include all diagnostics\22\0A\0A# diagnose help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a diagnose -d \22Show computed diagnostic configuration\22\0A\0A# diagnose instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command diagnose' -a '(__fish_kitchen_list)'\0A\0A# create commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a create -d \22Change instance state to create. Start one or more instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command create' -s c -l concurrency -d \22Run concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command create' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# create help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a create -d \22Change instance state to create. Start one or more instances\22\0A\0A# create instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command create' -a '(__fish_kitchen_list)'\0A\0A# converge commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a converge -d \22Change instance state to converge. Use a provisioner to configure one or more instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command converge' -s c -l concurrency -d \22Run converge concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command converge' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# converge help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a converge -d \22Change instance state to converge. Use a provisioner to configure one or more instances\22\0A\0A# converge instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command converge' -a '(__fish_kitchen_list)'\0A\0A# setup commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a setup -d \22Change instance state to setup. Prepare to run automated tests. Install busser\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command setup' -s c -l concurrency -d \22Run concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command setup' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# setup help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a setup -d \22Change instance state to setup. Prepare to run automated tests. Install busser\22\0A\0A# setup instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command setup' -a '(__fish_kitchen_list)'\0A\0A# verify commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a verify -d \22Change instance state to verify. Run automated tests\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command verify' -s c -l concurrency -d \22Run concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command verify' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# verify help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a verify -d \22Change instance state to verify. Run automated tests\22\0A\0A# verify instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command verify' -a '(__fish_kitchen_list)'\0A\0A# destroy commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a destroy -d \22Change instance state to destroy. Delete all information for one or more instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command destroy' -s c -l concurrency -d \22Run concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command destroy' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# destroy help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a destroy -d \22Change instance state to destroy. Delete all information for one or more instances\22\0A\0A# destroy instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command destroy' -a '(__fish_kitchen_list)'\0A\0A# test commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a test -d \22Test (destroy, create, converge, setup, verify and destroy) one or more instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command test' -s c -l concurrency -d \22Run concurrently, give number for max instances\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command test' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command test' -s d -l destroy -d \22Destroy strategy to use after testing (passing, always, never).\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command test' -l auto_init -d \22Invoke init command if .kitchen.yml is missing\22\0A\0A# test help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a test -d \22Test (destroy, create, converge, setup, verify and destroy) one or more instances\22\0A\0A# test instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command test' -a '(__fish_kitchen_list)'\0A\0A# login commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a login -d \22Log in to one instance\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command login' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0A\0A# login help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a login -d \22Log in to one instance\22\0A\0A# login instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command login' -a '(__fish_kitchen_list)'\0A\0A# exec commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a exec -d \22Execute command on one or more instance\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command exec' -s l -l log_level -d \22Set the log level (debug, info, warn, error, fatal)\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command exec' -s c -l command -d \22execute via ssh\22\0A\0A# exec help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a exec -d \22Execute command on one or more instance\22\0A\0A# exec instance-based commands\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command exec' -a '(__fish_kitchen_list)'\0A\0A# version commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a version -d \22Print Kitchen's version information\22\0A\0A# version help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a version -d \22Print Kitchen's version information\22\0A\0A# sink commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a sink -d \22Show the Kitchen sink!\22\0A\0A# sink help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a sink -d \22Show the Kitchen sink!\22\0A\0A# console commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a console -d \22Kitchen Console!\22\0A\0A# console help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a console -d \22Kitchen Console!\22\0A\0A# init commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_command -a init -d \22Adds some configuration to your cookbook so Kitchen can rock\22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command init' -s D -l driver -d \22One or more Kitchen Driver gems to be installed or added to a Gemfile \22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command init' -s P -l provisioner -d \22The default Kitchen Provisioner to use \22\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command init' -l create_gemfile -d \22Whether or not to create a Gemfile if one does not exist. Default: false \22\0A\0A# init help\0Acomplete -c kitchen -f -n '__fish_kitchen_using_command help' -a init -d \22Add some configuration to your cookbook\22\0A\0A# driver commands\0Acomplete -c kitchen -f -n __fish_kitchen_no_co