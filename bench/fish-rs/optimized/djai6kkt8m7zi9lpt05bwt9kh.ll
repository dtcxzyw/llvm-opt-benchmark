@anon.1d0b41a8d45d477c3029ec78f9b8b434.2096 = private unnamed_addr constant [2083 x i8] c"# mkdosfs is a tool to create MS-DOS filesystems.\0A# See: https://github.com/dosfstools/dosfstools\0A\0Acomplete -c mkdosfs -s a -d 'Disable alignment'\0Acomplete -c mkdosfs -s A -d 'Use Atari variation'\0Acomplete -c mkdosfs -s b -x -d 'Select location of backup sector'\0Acomplete -c mkdosfs -s c -d 'Check for bad blocks'\0Acomplete -c mkdosfs -s C -d 'Create file given as device'\0Acomplete -c mkdosfs -s D -x -d 'Specify drive number' -a '0x80\\tHard\\ disk 0x00\\tFloppy\\ disk'\0Acomplete -c mkdosfs -s f -x -d 'Specify number of FATs' -a '1\\t 2\\tDefault 3\\t 4\\t'\0Acomplete -c mkdosfs -s F -x -d 'Specify FAT size' -a '12 16 32'\0Acomplete -c mkdosfs -s h -x -d 'Specify number of hidden sectors'\0Acomplete -c mkdosfs -s i -x -d 'Specify volume ID'\0Acomplete -c mkdosfs -s I -d 'Force to use entire disk'\0Acomplete -c mkdosfs -s l -r -d 'Read bad blocks list from given file'\0Acomplete -c mkdosfs -s m -r -d 'Specify file containing non bootable message' -a '-\\tStdin'\0Acomplete -c mkdosfs -s M -x -d 'Specify media type' -a '\0A    0xf0\\t2.88MB3.5-inch,\\ 2-sided,\\ 36-sector\0A    0xf0\\t1.44MB\\ 3.5-inch,\\ 2-sided,\\ 18-sector\0A    0xf9\\t720KB\\ 3.5-inch,\\ 2-sided,\\ 9-sector\0A    0xf9\\t1.2MB\\ 5.25-inch,\\ 2-sided,\\ 15-sector\0A    0xfd\\t360KB\\ 5.25-inch,\\ 2-sided,\\ 9-sector\0A    0xff\\t320KB\\ 5.25-inch,\\ 2-sided,\\ 8-sector\0A    0xfc\\t180KB\\ 5.25-inch,\\ 1-sided,\\ 9-sector\0A    0xfe\\t160KB\\ 5.25-inch,\\ 1-sided,\\ 8-sector\0A    0xf8\\tFixed\\ disk\0A'\0Acomplete -c mkdosfs -s n -x -d 'Specify volume name'\0Acomplete -c mkdosfs -s r -x -d 'Specify number of entries available in root directory' -a '112\\tFloppy\\ default 224\\tFloppy\\ default 512\\tHard\\ disks\\ default'\0Acomplete -c mkdosfs -s R -x -d 'Specify number of reserved sectors'\0Acomplete -c mkdosfs -s s -x -d 'Specify number of sector per cluster' -a '1 2 4 8 16 32 64 128'\0Acomplete -c mkdosfs -s S -x -d 'Specify number of bytes per logical sector' -a '512 1024 2048 4096 8192 16384 32768'\0Acomplete -c mkdosfs -s v -d 'Verbose mode'\0Acomplete -c mkdosfs -l invariant -d 'Use constants for randomly generated data'\0Acomplete -c mkdosfs -l help -d 'Show help and exit'\0A", align 1
