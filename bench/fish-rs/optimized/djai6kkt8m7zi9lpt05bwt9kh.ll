@anon.1d0b41a8d45d477c3029ec78f9b8b434.3402 = private unnamed_addr constant [1370 x i8] c"#\0A# Wrap the builtin cd command to maintain directory history.\0A#\0Afunction cd --description \22Change directory\22\0A    set -l MAX_DIR_HIST 25\0A\0A    if set -q argv[2]; and begin\0A            set -q argv[3]\0A            or not test \22$argv[1]\22 = --\0A        end\0A        printf \22%s\\n\22 (_ \22Too many args for cd command\22) >&2\0A        return 1\0A    end\0A\0A    # Skip history in subshells.\0A    if status --is-command-substitution\0A        builtin cd $argv\0A        return $status\0A    end\0A\0A    # Avoid set completions.\0A    set -l previous $PWD\0A\0A    if test \22$argv\22 = -\0A        if test \22$__fish_cd_direction\22 = next\0A            nextd\0A        else\0A            prevd\0A        end\0A        return $status\0A    end\0A\0A    builtin cd $argv\0A    set -l cd_status $status\0A\0A    if test $cd_status -eq 0 -a \22$PWD\22 != \22$previous\22\0A        set -q dirprev\0A        or set -l dirprev\0A        set -q dirprev[$MAX_DIR_HIST]\0A        and set -e dirprev[1]\0A\0A        # If dirprev, dirnext, __fish_cd_direction\0A        # are set as universal variables, honor their scope.\0A\0A        set -U -q dirprev\0A        and set -U -a dirprev $previous\0A        or set -g -a dirprev $previous\0A\0A        set -U -q dirnext\0A        and set -U -e dirnext\0A        or set -e dirnext\0A\0A        set -U -q __fish_cd_direction\0A        and set -U __fish_cd_direction prev\0A        or set -g __fish_cd_direction prev\0A    end\0A\0A    return $cd_status\0Aend\0A", align 1
