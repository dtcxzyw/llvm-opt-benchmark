@anon.1d0b41a8d45d477c3029ec78f9b8b434.2830 = private unnamed_addr constant [6093 x i8] c"# Completions for vagrant, a vm/container management thing.\0A# Docs are at https://www.vagrantup.com/docs/cli/.\0A#\0A# Apparently options can only come after commands, with the exception of \22-v\22 and \22-h\22, which are effectively commands.\0Aset -l commands box cloud connect destroy \\\0A    docker-{exec,logs,run} \\\0A    global-status halt help init list-commands login \\\0A    package plugin provision push rdp reload resume \\\0A    rsync rsync-auto share snapshot ssh ssh-config \\\0A    status suspend up version \\\0A    port powershell winrm{,-config}\0A\0Aset -l box_commands add help list outdated prune remove repackage update\0Aset -l cloud_commands auth box search provider publish version\0Aset -l plugin_commands install license list uninstall update\0Aset -l snapshot_commands delete list pop push restore save\0A\0Afunction __fish_print_vagrant_state\0A    # Find a .vagrant file/directory above $PWD\0A    set -l root\0A    set -l dir (pwd -P)\0A    while test $dir != /\0A        if test -d $dir.vagrant -o -f $dir.vagrant\0A            echo $dir.vagrant\0A            return 0\0A        end\0A        # Go up one directory\0A        set dir (string replace -r '[^/]*/?$' '' $dir)\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_vagrant_machines\0A    if set -l state (__fish_print_vagrant_state)\0A        test -d \22$state\22; or return\0A        set -l machines $state/machines/*\0A        string replace -- $state/machines/ '' $machines\0A    end\0Aend\0A\0Afunction __fish_vagrant_boxes\0A    set -l vhome $VAGRANT_HOME/boxes\0A    set -q vhome[1]; or set vhome ~/.vagrant.d/boxes\0A    set -l boxes $vhome/*\0A    string replace -- $vhome/ '' $boxes | string replace -- -VAGRANTSLASH- /\0Aend\0A\0Afunction __fish_vagrant_need_command -V commands\0A    argparse -s h/help v/version -- (commandline -xpc)[2..-1] 2>/dev/null\0A    or return\0A    if set -q _flag_help[1]; or set -q _flag_help[1]\0A        return 1\0A    end\0A    if set -q argv[1]\0A        echo $argv\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_vagrant_using_command\0A    set -l cmd (__fish_vagrant_need_command)\0A    contains -- $cmd[1] $argv\0Aend\0A\0Afunction __fish_vagrant_box_need_command\0A    set -l cmd (__fish_vagrant_need_command)\0A    test \22$cmd[1]\22 = box 2>/dev/null\0A    or return 1\0A    set -e cmd[1]\0A\0A    # Not all of these are valid for all subcommands, but that's not important here.\0A    # Yes, none of these have a short version.\0A    set -l opts b-box-version= c-cacert= C-capath= 1-cert= 2-clean f-force i-insecure p-provider=\0A    set -a opts 3-checksum= 4-checksum-type= n-name=\0A    set -a opts g-global d-dry-run a-all B-box\0A    argparse -s $opts -- $cmd 2>/dev/null\0A    or return 1\0A    if set -q argv[1]\0A        echo $argv\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_vagrant_cloud_need_command\0A    set -l cmd (__fish_vagrant_need_command)\0A    test \22$cmd[1]\22 = cloud 2>/dev/null\0A    or return 1\0A    set -e cmd[1]\0A\0A    set -l opts c-check l-logout t-token d-description= s-short-description= p-private b-box-version=\0A    set -a opts f-force r-release u-url v-version-description= P-page= S-short= o-order= L-limit= 1-sort-by=\0A    argparse -s $opts -- $cmd 2>/dev/null\0A    or return 1\0A    if set -q argv[1]\0A        echo $argv\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa box -d 'Manage boxes: installation, removal, etc.'\0Acomplete -c vagrant -n \22__fish_vagrant_using_command box; and __fish_vagrant_box_need_command\22 -fa \22$box_commands\22\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa cloud -d 'Manage Vagrant Cloud'\0Acomplete -c vagrant -n \22__fish_vagrant_using_command cloud; and __fish_vagrant_cloud_need_command\22 -fa \22$cloud_commands\22\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa connect\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa destroy -d 'Stop and delete all traces of the vagrant machine'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa docker-exec\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa docker-logs\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa docker-run\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa global-status -d 'Show status Vagrant environments for this user'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa halt -d 'Stop a machine'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa help -d 'Show help for a subcommand'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa init -d 'Initialize a new Vagrant env by creating a Vagrantfile'\0Acomplete -c vagrant -n \22__fish_vagrant_using_command init\22 -fa '(__fish_vagrant_boxes)'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa list-commands\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa login\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa package -d 'Package a running vagrant environment into a box'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa plugin -d 'Manages plugins: install, uninstall, update, etc.'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa provision\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa push\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa rdp\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa reload\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa resume\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa rsync\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa rsync-auto\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa share\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa snapshot\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa ssh -d 'Connect to a machine via SSH'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa ssh-config -d 'Print ssh config to connect to machine'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa status -d 'Print status of a machine'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa suspend -d 'Suspend a machine'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa up -d 'Start and provision the environment'\0Acomplete -c vagrant -n \22__fish_vagrant_using_command up\22 -fa '(__fish_vagrant_machines)'\0Acomplete -c vagrant -n __fish_vagrant_need_command -fa version -d 'Print current and latest version'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2831 = private unnamed_addr constant [25 x i8] c"completions/valgrind.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2832 = private unnamed_addr constant [6091 x i8] c"# Don't go invoking valgrind unless it is installed\0A\0Aset -l skin tool\0Aif valgrind --version 2>/dev/null | string match -qr -- '-2\\.[012]\\.'\0A    # In older versions of Valgrind, the skin selection option was\0A    # '--skin'\0A    # But someone decided that it would be fun to change this to\0A    # '--tool' for no good reason\0A    set skin skin\0Aend\0A\0Acomplete -xc valgrind -l $skin -d Skin -a \22\0A\09memcheck\\tHeavyweight\\ memory\\ checker\0A\09cachegrind\\tCache-miss\\ profiler\0A\09addrcheck\\tLightweight\\ memory\\ checker\0A\09helgrind\\tData-race\\ detector\0A\09massif\\tHeap\\ profiler\0A\22\0A\0Afunction __fish_valgrind_skin --argument-names tool -V skin\0A    set -l cmd (commandline -cpx)\0A    # Quote $cmd so the tokens are separated with a space\0A    if string match -qr -- \22--$skin(=| )$tool\22 \22$cmd\22\0A        return 0\0A    end\0A    # memcheck is the default tool/skin\0A    test $tool = memcheck\0A    and not string match -- $skin $cmd\0Aend\0A\0Acomplete -c valgrind -l help -d \22Display help and exit\22\0Acomplete -c valgrind -l help-debug -d \22Display help and debug options\22\0Acomplete -c valgrind -l version -d \22Display version and exit\22\0Acomplete -c valgrind -s q -l quiet -d \22Quiet mode\22\0Acomplete -c valgrind -s v -l verbose -d \22Verbose mode\22\0Acomplete -xc valgrind -l trace-children -d \22Valgrind-ise children\22 -a \22yes no\22\0Acomplete -xc valgrind -l track-fds -d \22Track file descriptors\22 -a \22yes no\22\0Acomplete -xc valgrind -l log-fd -d \22Log to file descriptor\22 -a \220 1 2 3 4 5 6 7 8 9\22\0Acomplete -rc valgrind -l log-file -d \22Log to file\22\0Acomplete -xc valgrind -l logsocket -d \22Log to socket\22\0Acomplete -c valgrind -l demangle -xd \22Demangle C++ names\22 -a \22yes no\22\0Acomplete -xc valgrind -l num-callers -d \22Callers in stack trace\22\0Acomplete -xc valgrind -l error-limit -d \22Stop showing errors if too many\22 -a \22yes no\22\0Acomplete -xc valgrind -l show-below-main -d \22Continue trace below main()\22 -a \22yes no\22\0Acomplete -rc valgrind -l suppressions -d \22Suppress errors from file\22\0Acomplete -c valgrind -l gen-suppressions -d \22Print suppressions for detected errors\22\0Acomplete -xc valgrind -l db-attach -d \22Start debugger on error\22 -a \22yes no\22\0Acomplete -rc valgrind -l db-command -d \22Debugger command\22\0Acomplete -xc valgrind -l input-fd -d \22File descriptor for input\22 -a \220 1 2 3 4 5 6 7 8 9\22\0A\0A# Memcheck-specific options\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l leak-check -d \22Check for memory leaks\22 -a \22no\\tDon\\'t\\ check\\ for\\ memory\\ leaks summary\\t'Show a leak summary' full\\t'Describe memory leaks in detail'\22\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l show-reachable -d \22Show reachable leaked memory\22 -a \22yes\\t'Show reachable leaked memory' no\\t'Do not show reachable leaked memory'\22\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l leak-resolution -d \22Determines how willingly Memcheck considers different backtraces to be the same\22 -a \22low\\t'Two entries need to match' med\\t'Four entries need to match' high\\t'All entries need to match'\22\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l freelist-vol -d \22Set size of freed memory pool\22\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l partial-loads-ok -d 'How to handle loads of words that are partially addressable' -a 'yes\\t\22Do not emit errors on partial loads\22 no\\t\22Emit errors on partial loads\22'\0Acomplete -n \22__fish_valgrind_skin memcheck\22 -xc valgrind -l avoid-strlen-errors -d 'Whether to skip error reporting for the strlen function' -a 'yes no'\0A\0A# Addrcheck-specific options\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l leak-check -d \22Check for memory leaks\22 -a \22no\\t'Do not check for memory leaks' summary\\t'Show a leak summary' full\\t'Describe memory leaks in detail'\22\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l show-reachable -d \22Show reachable leaked memory\22 -a \22yes\\t'Show reachable leaked memory' no\\t'Do not show reachable leaked memory'\22\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l leak-resolution -d \22Determines how willingly Addrcheck considers different backtraces to be the same\22 -a \22low\\t'Two entries need to match' med\\t'Four entries need to match' high\\t'All entries need to match'\22\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l freelist-vol -d \22Set size of freed memory pool\22\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l partial-loads-ok -d 'How to handle loads of words that are partially addressable' -a 'yes\\t\22Do not emit errors on partial loads\22 no\\t\22Emit errors on partial loads\22'\0Acomplete -n \22__fish_valgrind_skin addrcheck\22 -xc valgrind -l avoid-strlen-errors -d 'Whether to skip error reporting for the strlen function' -a 'yes no'\0A\0A# Cachegrind-specific options\0Acomplete -n \22__fish_valgrind_skin cachegrind\22 -xc valgrind -l I1 -d \22Type of L1 instruction cache\22\0Acomplete -n \22__fish_valgrind_skin cachegrind\22 -xc valgrind -l D1 -d \22Type of L1 data cache\22\0Acomplete -n \22__fish_valgrind_skin cachegrind\22 -xc valgrind -l L2 -d \22Type of L2 cache\22\0A\0Afunction __fish_print_function_prototypes -d \22Prints the names of all function prototypes found in the headers in the current directory\22\0A    set -l headers *.h *.hh *.hpp *.hxx\0A    if set -q headers[1]\0A        sed -n \22s/^\\(.*[^[a-zA-Z_0-9]\\|\\)\\([a-zA-Z_][a-zA-Z_0-9]*\\) *(.*);.*\\$/\\2/p\22 $headers\0A    end\0Aend\0A\0A# Massif-specific options\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -l alloc-fn -d \22Specify a function that allocates memory\22 -x -a \22(__fish_print_function_prototypes)\22\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -x -l heap -d 'Profile heap usage' -a 'yes\\t\22Profile heap usage\22 no\\t\22Do not profile heap usage\22'\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -x -l heap-admin -d \22The number of bytes of heap overhead per allocation\22\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -x -l stacks -d \22Profile stack usage\22 -a 'yes\\t\22Profile stack usage\22 no\\t\22Do not profile stack usage\22'\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -x -l depth -d \22Depth of call chain\22\0Acomplete -c valgrind -n \22__fish_valgrind_skin massif\22 -x -l format -d \22Profiling output format\22 -a \22html\\t'Produce html output' text\\t'Produce text output'\22\0A", align 1
