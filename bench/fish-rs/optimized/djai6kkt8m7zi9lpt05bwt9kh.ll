@anon.1d0b41a8d45d477c3029ec78f9b8b434.3136 = private unnamed_addr constant [2157 x i8] c"function __fish_complete_lpr -d 'Complete lpr common options' --argument-names cmd\0A    complete -c $cmd -s E -d 'Forces encryption when connecting to the server'\0A    complete -c $cmd -s U -d 'Specifies an alternate username' -xa '(__fish_complete_users)'\0A\0A    switch $cmd\0A        case lpr lpq lprm\0A            complete -c $cmd -s P -d 'Specifies an alternate printer or class name' -xa '(__fish_print_lpr_printers)'\0A    end\0A\0A    switch $cmd\0A        case lpq cancel\0A            complete -c $cmd -s a -d 'Apply command to all printers'\0A    end\0A\0A    switch $cmd\0A        case lpq cancel lpmove lpstat lprm lpoptions lp reject accept cupsaccept cupsreject cupsenable cupsdisable\0A            complete -c $cmd -s h -d 'Specifies an alternate server' -xa '(__fish_print_hostnames)'\0A    end\0A\0A    switch $cmd\0A        case lp lpr\0A            complete -c $cmd -s m -d 'Send an email on job completion'\0A\0A            complete -c $cmd -s o -xa landscape -d 'Landscape mode'\0A            complete -c $cmd -s o -xa \22media=a4 media=letter media=legal\22 -d 'Media size'\0A            complete -c $cmd -s o -xa page-ranges= -d 'Page ranges'\0A            complete -c $cmd -s o -xa orientation-requested= -d 'Choose orientation (4-landscape)'\0A            complete -c $cmd -s o -xa 'sides-one-sided two-sided-long-edge two-sided-short-edge' -d 'Choose between one/two sided modes'\0A            complete -c $cmd -s o -xa fitplot -d 'Scale the print file to fit on the page'\0A            complete -c $cmd -s o -xa 'number-up=2 number-up=4 number-up=6 number-up=9' -d 'Print multiple document pages on each output page'\0A            complete -c $cmd -s o -xa 'scaling=' -d 'Scale image files to use up to number percent of the page'\0A            complete -c $cmd -s o -xa 'cpi=' -d 'Set the number of characters per inch to use'\0A            complete -c $cmd -s o -xa 'lpi=' -d 'Set the number of lines per inch to use'\0A            complete -c $cmd -s o -xa 'page-bottom= page-left= page-right= page-top=' -d 'Set the page margins when printing text files'\0A            # this must be last\0A            complete -c $cmd -s o -d 'Sets a job option' -xa '(__fish_complete_lpr_option)'\0A    end\0Aend\0A", align 1
