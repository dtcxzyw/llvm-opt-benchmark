@anon.1d0b41a8d45d477c3029ec78f9b8b434.1494 = private unnamed_addr constant [2648 x i8] c"complete -c dmesg -f -d 'Display system message buffer'\0A\0Aswitch (uname -s)\0A    #\0A    # Solaris\0A    #\0A    case SunOS\0A        exit 1 # no options, we are done\0A        #\0A        # Loonix dmesg\0A        #\0A    case Linux\0A        set -l levels '( __fish_append , emerg alert crit err warn notice info debug)'\0A        complete -c dmesg -s C -l clear -f -d'Clear kernel ring buffer'\0A        complete -c dmesg -s c -l read-clear -f -d'Read & clear all msgs'\0A        complete -c dmesg -s D -l console-off -f -d'Disable writing to console'\0A        complete -c dmesg -s d -l show-delta -f -d'Show timestamp deltas'\0A        complete -c dmesg -s E -l console-on -f -d'Enable writing to console'\0A        complete -c dmesg -s F -l file -r -d'Use file instead of log buffer'\0A        complete -c dmesg -s f -l facility -x -d'Only print for given facilities' -a '( __fish_append , kern user mail daemon auth syslog lpr news)'\0A        complete -c dmesg -s h -l help -f -d'Display help'\0A        complete -c dmesg -s k -l kernel -f -d'Print kernel messages'\0A        complete -c dmesg -s l -l level -x -d'Restrict output to given levels' -a $levels\0A        complete -c dmesg -s n -l console-level -x -d'Adjust threshold to print to console' -a $levels\0A        complete -c dmesg -s r -l raw -f -d'Print raw message buffer'\0A        complete -c dmesg -s s -l buffer-size -x -d'Buffer size to query kernel'\0A        complete -c dmesg -s T -l ctime -f -d'Human-readable timestamps'\0A        complete -c dmesg -s t -l notime -f -d'Don\\'t print timestamps'\0A        complete -c dmesg -s u -l userspace -f -d'Print userspace messages'\0A        complete -c dmesg -s V -l version -f -d'Show dmesg version'\0A        complete -c dmesg -s w -l follow -f -d'Wait for new messages'\0A        complete -c dmesg -s W -l follow-new -f -d'Wait and print only new messages'\0A        complete -c dmesg -s x -l decode -f -d'Decode facility & level numbers'\0A        exit 0 # done\0A        #\0A        # unique options specific BSDs have\0A        #\0A    case NetBSD\0A        complete -c dmesg -s d -f -d'show timestamp deltas'\0A        complete -c dmesg -s T -f -d'human-readable timestamps'\0A        complete -c dmesg -s t -f -d'don\\'t print timestamps'\0A    case OpenBSD\0A        complete -c dmesg -s S -f -d'display console message buffer-size'\0A    case FreeBSD DragonFly\0A        complete -c dmesg -s a -f -d'print all data in the message buffer'\0A        complete -c dmesg -s c -f -d'clear kernel buffer after printing'\0Aend\0A\0A#\0A# common BSD dmesg options (macOS only does these two)\0A#\0Acomplete -c dmesg -s M -r -d'get namelist values from given core'\0Acomplete -c dmesg -s N -r -d'get namelist from given kernel'\0A", align 1
