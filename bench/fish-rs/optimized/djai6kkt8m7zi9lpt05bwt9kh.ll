@anon.1d0b41a8d45d477c3029ec78f9b8b434.3120 = private unnamed_addr constant [3134 x i8] c"function __fish_complete_ftp -d 'Complete ftp, pftp' --argument-names ftp\0A    # Common across all ftp implementations\0A    complete -c $ftp -xa \22(__fish_print_hostnames)\22 -d Hostname\0A    complete -c $ftp -s 4 -d 'Use IPv4 only'\0A    complete -c $ftp -s 6 -d 'Use IPv6 only'\0A    complete -c $ftp -s A -d 'Use active mode for data transfers'\0A    complete -c $ftp -s d -d 'Enable debugging'\0A    complete -c $ftp -s e -d 'Disable command editing and history support'\0A    complete -c $ftp -s g -d 'Disable file name globbing'\0A    complete -c $ftp -s i -d 'Disable interactive prompting during multiple file transfers.'\0A    complete -c $ftp -s p -d 'Use passive mode for data transfers'\0A    complete -c $ftp -s t -d 'Enable packet tracing'\0A    complete -c $ftp -s n -d 'Disable autologin'\0A\0A    switch (uname -s)\0A        case FreeBSD NetBSD OpenBSD\0A            complete -c $ftp -s o -d \22Set output for auto-fetched files\22\0A            complete -c $ftp -s a -d \22Anonymous login\22\0A            complete -c $ftp -s P -d 'Set port number' -x\0A            complete -c $ftp -s r -d 'Time between retry attempts' -x\0A            complete -c $ftp -s s -d 'Local address to bind to' -xa \22(__fish_print_addresses)\22\0A    end\0A\0A    switch (uname -s)\0A        case FreeBSD NetBSD Linux\0A            complete -c $ftp -s N -d \22Specify netrc file\22 -r\0A            complete -c $ftp -s v -d 'Enable verbose and progress meter'\0A    end\0A\0A    switch (uname -s)\0A        case FreeBSD NetBSD\0A            complete -c $ftp -s f -d \22Force cache reload\22\0A            complete -c $ftp -s q -d \22Seconds to wait before quitting stalled connection\22 -x\0A            complete -c $ftp -s R -d 'Restart all non-proxied auto-fetches'\0A            complete -c $ftp -s T -d 'Set max transfer rate' -x\0A            complete -c $ftp -s u -d 'Upload file to URL' -r\0A            complete -c $ftp -s V -d 'Disable verbose and progress meter'\0A    end\0A\0A    switch (uname -s)\0A        case NetBSD\0A            complete -c $ftp -s x -d \22Set buffer size\22 -x\0A        case OpenBSD\0A            complete -c $ftp -s N -d \22Set command name for error reports\22 -x\0A            complete -c $ftp -s V -d \22Disable verbose\22\0A            complete -c $ftp -s v -d \22Enable verbose\22\0A            complete -c $ftp -s M -d \22Disable progress meter\22\0A            complete -c $ftp -s m -d \22Enable progress meter\22\0A            complete -c $ftp -s C -d \22Continue a previously interrupted file transfer\22\0A            complete -c $ftp -s c -d \22Netscape-like cookiejar file\22 -r\0A            complete -c $ftp -s D -d \22Short title for start of progress meter\22 -x\0A            complete -c $ftp -s E -d \22Disable EPSC/EPRT command on IPv4 connections\22\0A            complete -c $ftp -s k -d \22Keepalive interval in seconds\22 -x\0A            complete -c $ftp -s S -d \22SSL/TLS options\22\0A            complete -c $ftp -s U -d \22Set useragent\22 -x\0A            complete -c $ftp -s w -d \22Time to wait before aborting slow connections\22 -x\0A        case Linux\0A            complete -c $ftp -s V -d \22Print version\22\0A            complete -c $ftp -l prompt -d \22Print a prompt even if not on a tty\22\0A            complete -c $ftp -s '?' -l help -d \22Print help\22\0A    end\0Aend\0A", align 1
