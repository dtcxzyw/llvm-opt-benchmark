-all-config -d 'Dump full configuration tree'\0Acomplete -c gphoto2 -l get-config -r -d 'Get configuration value'\0Acomplete -c gphoto2 -l set-config -r -d 'Set configuration value or index in choices'\0Acomplete -c gphoto2 -l set-config-index -r -d 'Set configuration value index in choices'\0Acomplete -c gphoto2 -l set-config-value -r -d 'Set configuration value'\0A\0A#Capture an image from or on the camera\0Acomplete -c gphoto2 -l wait-event -d 'Wait for event(s) from camera'\0Acomplete -c gphoto2 -l wait-event-and-download -d 'Wait for event(s) from the camera and download new images'\0Acomplete -c gphoto2 -l capture-preview -d 'Capture a quick preview'\0Acomplete -c gphoto2 -s B -l bulb -r -d 'Set bulb exposure time in seconds'\0Acomplete -c gphoto2 -s F -l frames -r -d 'Set number of frames to capture (default=infinite)'\0Acomplete -c gphoto2 -s I -l interval -r -d 'Set capture interval in seconds'\0Acomplete -c gphoto2 -l reset-interval -d 'Reset capture interval on signal (default=no)'\0Acomplete -c gphoto2 -l capture-image -d 'Capture an image'\0Acomplete -c gphoto2 -l capture-image-and-download -d 'Capture an image and download it'\0Acomplete -c gphoto2 -l capture-movie -d 'Capture a movie'\0Acomplete -c gphoto2 -l capture-sound -d 'Capture an audio clip'\0Acomplete -c gphoto2 -l capture-tethered -d 'Wait for shutter release on the camera and download'\0A\0A#Downloading, uploading and manipulating files\0Acomplete -c gphoto2 -s l -l list-folders -d 'List folders in folder'\0Acomplete -c gphoto2 -s L -l list-files -d 'List files in folder'\0Acomplete -c gphoto2 -s m -l mkdir -r -d 'Create a directory'\0Acomplete -c gphoto2 -s r -l rmdir -r -d 'Remove a directory'\0Acomplete -c gphoto2 -s n -l num-files -d 'Display number of files'\0Acomplete -c gphoto2 -s p -l get-file -r -d 'Get files given in range'\0Acomplete -c gphoto2 -s P -l get-all-files -d 'Get all files from folder'\0Acomplete -c gphoto2 -s t -l get-thumbnail -r -d 'Get thumbnails given in range'\0Acomplete -c gphoto2 -s T -l get-all-thumbnails -d 'Get all thumbnails from folder'\0Acomplete -c gphoto2 -l get-metadata -r -d 'Get metadata given in range'\0Acomplete -c gphoto2 -l get-all-metadata -d 'Get all metadata from folder'\0Acomplete -c gphoto2 -l upload-metadata -r -d 'Upload metadata for file'\0Acomplete -c gphoto2 -l get-raw-data -r -d 'Get raw data given in range'\0Acomplete -c gphoto2 -l get-all-raw-data -d 'Get all raw data from folder'\0Acomplete -c gphoto2 -l get-audio-data -r -d 'Get audio data given in range'\0Acomplete -c gphoto2 -l get-all-audio-data -d 'Get all audio data from folder'\0Acomplete -c gphoto2 -s d -l delete-file -r -d 'Delete files given in range'\0Acomplete -c gphoto2 -s D -l delete-all-files -d 'Delete all files in folder (--no-recurse by default)'\0Acomplete -c gphoto2 -s u -l upload-file -r -d 'Upload a file to camera'\0Acomplete -c gphoto2 -l filename -r -d 'Specify a filename or filename pattern'\0Acomplete -c gphoto2 -s f -l folder -r -d 'Specify camera folder (default=\22/\22)'\0Acomplete -c gphoto2 -s R -l recurse -d 'Recursion (default for download)'\0Acomplete -c gphoto2 -l no-recurse -d 'No recursion (default for deletion)'\0Acomplete -c gphoto2 -l new -d 'Process new files only'\0Acomplete -c gphoto2 -l force-overwrite -d 'Overwrite files without asking'\0A", align 1
