@anon.1d0b41a8d45d477c3029ec78f9b8b434.3222 = private unnamed_addr constant [285 x i8] c"function __fish_is_nth_token --description 'Test if current token is the Nth (ignoring command and switches/flags)' --argument-names n\0A    set -l tokens (commandline -pxc)\0A    set -l tokens (string replace -r --filter '^([^-].*)' '$1' -- $tokens)\0A    test (count $tokens) -eq \22$n\22\0Aend\0A", align 1
