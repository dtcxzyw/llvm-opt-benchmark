@anon.1d0b41a8d45d477c3029ec78f9b8b434.1712 = private unnamed_addr constant [389 x i8] c"# gh, at least as of version 1.17.5, does not write errors to stderr, causing\0A# `checks/completions.fish` to fail if the `gh-completion` module is missing.\0A# It also does not exit with a non-zero error code, making this harder than it needs to be :(\0Aset completion \22$(gh completion --shell fish 2>/dev/null)\22\0Astring match -rq '^Error' -- $completion && return -1\0Aecho $completion | source\0A", align 1
