@anon.1d0b41a8d45d477c3029ec78f9b8b434.3182 = private unnamed_addr constant [2329 x i8] c"function __fish_complete_zfs_ro_properties -d \22Completes with ZFS read-only properties\22\0A    echo -e \22available\\tAvailable space\22\0A    echo -e \22avail\\tAvailable space\22\0A    echo -e \22compressratio\\tAchieved compression ratio\22\0A    echo -e \22creation\\tDataset creation time\22\0A    echo -e \22clones\\tSnapshot clones\22\0A    echo -e \22defer_destroy\\tMarked for deferred destruction\22\0A    echo -e \22filesystem_count\\tTotal lower-level filesystems and volumes\22\0A    echo -e \22logicalreferenced\\tLogical total space\22\0A    echo -e \22lrefer\\tLogical total space\22\0A    echo -e \22logicalused\\tLogical used space\22\0A    echo -e \22lused\\tLogical used space\22\0A    echo -e \22mounted\\tIs currently mounted?\22\0A    echo -e \22origin\\tSource snapshot\22\0A    if __fish_is_zfs_feature_enabled \22feature@extensible_dataset\22\0A        echo -e \22receive_resume_token\\tToken for interrupted reception resumption\22\0A    end\0A    echo -e \22referenced\\tTotal space\22\0A    echo -e \22refer\\tTotal space\22\0A    echo -e \22refcompressratio\\tAchieved compression ratio of referenced space\22\0A    echo -e \22snapshot_count\\tTotal lower-level snapshots\22\0A    echo -e \22type\\tDataset type\22\0A    echo -e \22used\\tSpace used by dataset and children\22\0A    echo -e \22usedbychildren\\tSpace used by children datasets\22\0A    echo -e \22usedbydataset\\tSpace used by dataset itself\22\0A    echo -e \22usedbyrefreservation\\tSpace used by refreservation\22\0A    echo -e \22usedbysnapshots\\tSpace used by dataset snapshots\22\0A    echo -e \22userrefs\\tHolds count\22\0A    echo -e \22volblocksize\\tVolume block size\22\0A    echo -e \22written\\tReferenced data written since previous snapshot\22\0A    # Autogenerate userused@$USER list; only usernames are supported by the completion, but the zfs command supports more formats\0A    for user in (__fish_print_users)\0A        set -l tabAndBefore (echo -e \22userused@$user\\t\22)\0A        printf \22%sDataset space use by user %s\\n\22 $tabAndBefore $user\0A    end\0A    # Autogenerate groupused@$USER list\0A    for group in (__fish_print_groups)\0A        set -l tabAndBefore (echo -e \22groupused@$group\\t\22)\0A        printf \22%sDataset space use by group %s\\n\22 $tabAndBefore $group\0A    end\0A    # Autogenerate written@$SNAPSHOT list\0A    for snapshot in (__fish_print_zfs_snapshots)\0A        set -l tabAndBefore (echo -e \22written@$snapshot\\t\22)\0A        printf \22%sReferenced data written since snapshot %s\\n\22 $tabAndBefore $snapshot\0A    end\0Aend\0A", align 1
