@anon.1d0b41a8d45d477c3029ec78f9b8b434.2186 = private unnamed_addr constant [1218 x i8] c"function __fish_complete_nethack\0A    set -l roles Archeologist Barbarian Cave{man,woman} Healer Knight Monk \\\0A        Priest{,ess} Rogue Ranger Samurai Tourist Valkyrie Wizard\0A\0A    set -l races Human Elf Dwarf Gnome Orc\0A\0A    for r in $$argv[1]\0A        printf \22%s\\t%s\\n\22 (string sub -l 3 $r) $r\0A    end\0Aend\0A\0Acomplete -c nethack -s d -ra \22(__fish_complete_directories)\22 -d 'Specify a playground directory'\0Acomplete -c nethack -s n -d 'Suppress printing any news from the game administrator'\0Acomplete -c nethack -s p -x -a \22(__fish_complete_nethack roles)\22 -d 'Specify profession'\0Acomplete -c nethack -s r -x -a \22(__fish_complete_nethack races)\22 -d 'Specify race'\0Acomplete -c nethack -s D -d 'Start in debugging (wizard) mode'\0Acomplete -c nethack -s X -d 'Start in discovery mode'\0Acomplete -c nethack -s u -x -d 'Specify player name'\0Acomplete -c nethack -o dec -d 'Use DEC graphics'\0Acomplete -c nethack -o ibm -d 'Use IBM graphics'\0Acomplete -c nethack -l version -d 'Show version information'\0Acomplete -c nethack -l version:paste -d 'Show version information & copy it to paste buffer'\0Acomplete -c nethack -s s -d 'Print the list of your scores'\0Acomplete -c nethack -s v -d 'Print all versions present in the score file'\0A", align 1
