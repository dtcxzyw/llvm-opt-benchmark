@anon.1d0b41a8d45d477c3029ec78f9b8b434.1042 = private unnamed_addr constant [5330 x i8] c"# Searching\0Acomplete -c ack -s i -l ignore-case -d 'Ignore case'\0Acomplete -c ack -l smart-case -d 'Ignore case when pattern contains no uppercase'\0Acomplete -c ack -l nosmart-case -l no-smart-case -d 'Don\\'t ignore case'\0Acomplete -c ack -s v -l invert-match -d 'Invert match'\0Acomplete -c ack -s w -l word-regexp -d 'Match only whole words'\0Acomplete -c ack -s Q -l literal -d 'Quote all metacharacters'\0A\0A# Search output\0Acomplete -c ack -l lines -d 'Only print line(s) NUM of each file'\0Acomplete -c ack -s l -l files-with-matches -d 'Only print filenames containing matches'\0Acomplete -c ack -s L -l files-without-matches -d 'Only print filenames with no matches'\0Acomplete -c ack -l output -d 'Output the evaluation of Perl expression for each line'\0Acomplete -c ack -s o -d 'Output the part of line matching pattern'\0Acomplete -c ack -l passthru -d 'Print all lines'\0Acomplete -c ack -l match -d 'Specify pattern explicitly'\0Acomplete -c ack -s m -l max-count -d 'Stop searching in each file after NUM matches'\0Acomplete -c ack -s 1 -d 'Stop searching after first match'\0Acomplete -c ack -s H -l with-filename -d 'Print the filename for each match'\0Acomplete -c ack -s h -l no-filename -d 'Suppress the prefixing filename on output'\0Acomplete -c ack -s c -l count -d 'Show number of lines matching per file'\0Acomplete -c ack -l column -d 'Show column number of first match'\0Acomplete -c ack -l nocolumn -l no-column -d 'Don\\'t show column number of first match'\0Acomplete -c ack -x -s A -l after-context -d 'Print NUM lines of trailing context'\0Acomplete -c ack -x -s B -l before-context -d 'Print NUM lines of leading context'\0Acomplete -c ack -x -s C -l context -d 'Print NUM lines of context'\0Acomplete -c ack -l print0 -d 'Print null byte as separator between filenames'\0Acomplete -c ack -s s -d 'Suppress error messages about file errors'\0A\0A# File presentation\0Acomplete -c ack -l pager -d 'Pipes all ack output through command'\0Acomplete -c ack -l nopager -l no-pager -d 'Do not send output through a pager'\0Acomplete -c ack -l heading -d 'Prints a filename heading above file\\'s results'\0Acomplete -c ack -l noheading -l no-heading -d 'Don\\'t print a filename heading above file\\'s results'\0Acomplete -c ack -l break -d 'Print a break between results'\0Acomplete -c ack -l nobreak -l no-break -d 'Don\\'t print a break between results'\0Acomplete -c ack -l group -d 'Filename heading and line break between results'\0Acomplete -c ack -l nogroup -l no-group -d 'No filename heading and no line breaks between results'\0Acomplete -c ack -l color -d 'Highlight the matching text'\0Acomplete -c ack -l nocolor -l no-color -l nocolour -l no-colour -d 'Don\\'t highlight the matching text'\0Acomplete -c ack -l color-filename -d 'Set the color for filenames'\0Acomplete -c ack -l color-match -d 'Set the color for matches'\0Acomplete -c ack -l color-lineno -d 'Set the color for line numbers'\0Acomplete -c ack -l flush -d 'Flush output immediately'\0A\0A# File finding\0Acomplete -c ack -s f -d 'Only print the files selected'\0Acomplete -c ack -s g -d 'Only select files matching pattern'\0Acomplete -c ack -l sort-files -d 'Sort the found files lexically'\0Acomplete -c ack -l show-types -d 'Show which types each file has'\0Acomplete -c ack -l files-from -d 'Read the list of files to search from file'\0Acomplete -c ack -s x -d 'Read the list of files to search from STDIN'\0A\0A# File inclusion/exclusion\0Acomplete -c ack -l ignore-dir -l ignore-directory -d 'Ignore directory'\0Acomplete -c ack -l noignore-dir -l no-ignore-dir -l noignore-directory -l no-ignore-directory -d 'Don\\'t ignore directory'\0Acomplete -c ack -l ignore-file -d 'Add filter for ignoring files'\0Acomplete -c ack -s r -s R -l recurse -d 'Recurse into subdirectories'\0Acomplete -c ack -s n -l no-recurse -d 'No descending into subdirectories'\0Acomplete -c ack -l follow -d 'Follow symlinks'\0Acomplete -c ack -l nofollow -l no-follow -d 'Don\\'t follow symlinks'\0Acomplete -c ack -s k -l known-types -d 'Include only recognized files'\0Acomplete -c ack -l type -d 'Include only X files'\0A\0A# File type specification\0Acomplete -c ack -l type-set -d 'Replaces definition of type'\0Acomplete -c ack -l type-add -d 'Specify definition of type'\0Acomplete -c ack -l type-del -d 'Removes all filters associated with type'\0A\0A# Miscellaneous\0Acomplete -c ack -l noenv -l no-env -d 'Ignores environment variables and ackrc files'\0Acomplete -c ack -l ackrc -d 'Specifies location of ackrc file'\0Acomplete -c ack -l ignore-ack-defaults -d 'Ignore default definitions ack includes'\0Acomplete -c ack -l create-ackrc -d 'Outputs default ackrc'\0Acomplete -c ack -s \\? -l help -d 'Shows help'\0Acomplete -c ack -l help-types -d 'Shows all known types'\0Acomplete -c ack -l dump -d 'Dump information on which options are loaded'\0Acomplete -c ack -l filter -d 'Forces ack to treat input as a pipe'\0Acomplete -c ack -l nofilter -l no-filter -d 'Forces ack to treat input as tty'\0Acomplete -c ack -l man -d 'Shows man page'\0Acomplete -c ack -l version -d 'Displays version and copyright'\0Acomplete -c ack -l thpppt -d 'Bill the Cat'\0Acomplete -c ack -l bar -d 'The warning admiral'\0A\0A# File types\0Aif type ack >/dev/null\0A    for type in (ack --dump 2>/dev/null | perl -lne 'print $1 if /^\\s+--type-add=([^:]+)/' | uniq)\0A        complete -c ack -l $type -d \22Allow $type file type\22\0A        complete -c ack -l no$type -l no-$type -d \22Don't allow $type file type\22\0A    end\0Aend\0A", align 1
