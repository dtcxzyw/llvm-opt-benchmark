@anon.1d0b41a8d45d477c3029ec78f9b8b434.3412 = private unnamed_addr constant [464 x i8] c"function dirs --description 'Print directory stack'\0A    set -l options h/help c\0A    argparse -n dirs --max-args=0 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help dirs\0A        return 0\0A    end\0A\0A    if set -q _flag_c\0A        # Clear directory stack.\0A        set -e -g dirstack\0A        return 0\0A    end\0A\0A    # Replace $HOME with ~.\0A    string replace -r '^'\22$HOME\22'($|/)' '~$1' -- $PWD $dirstack | string join \22 \22\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3413 = private unnamed_addr constant [29 x i8] c"functions/down-or-search.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3414 = private unnamed_addr constant [732 x i8] c"function down-or-search -d \22search forward or move down 1 line\22\0A    # If we are already in search mode, continue\0A    if commandline --search-mode\0A        commandline -f history-search-forward\0A        return\0A    end\0A\0A    # If we are navigating the pager, then up always navigates\0A    if commandline --paging-mode\0A        commandline -f down-line\0A        return\0A    end\0A\0A    # We are not already in search mode.\0A    # If we are on the bottom line, start search mode,\0A    # otherwise move down\0A    set -l lineno (commandline -L)\0A    set -l line_count (count (commandline))\0A\0A    switch $lineno\0A        case $line_count\0A            commandline -f history-search-forward\0A\0A        case '*'\0A            commandline -f down-line\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3415 = private unnamed_addr constant [34 x i8] c"functions/edit_command_buffer.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3416 = private unnamed_addr constant [4640 x i8] c"function edit_command_buffer --description 'Edit the command buffer in an external editor'\0A    set -l f (mktemp)\0A    or return 1\0A    if set -q f[1]\0A        command mv $f $f.fish\0A        set f $f.fish\0A    else\0A        # We should never execute this block but better to be paranoid.\0A        if set -q TMPDIR\0A            set f $TMPDIR/fish.$fish_pid.fish\0A        else\0A            set f /tmp/fish.$fish_pid.fish\0A        end\0A        command touch $f\0A        or return 1\0A    end\0A\0A    set -l editor (__fish_anyeditor)\0A    or return 1\0A\0A    set -l indented_lines (commandline -b | __fish_indent --only-indent)\0A    string join -- \\n $indented_lines >$f\0A    set -l offset (commandline --cursor)\0A    # compute cursor line/column\0A    set -l lines (commandline)\\n\0A    set -l line 1\0A    while test $offset -ge (string length -- $lines[1])\0A        set offset (math $offset - (string length -- $lines[1]))\0A        set line (math $line + 1)\0A        set -e lines[1]\0A    end\0A    set -l indent 1 + (string length -- $indented_lines[$line]) - (string length -- $lines[1])\0A    set -l col (math $offset + 1 + $indent)\0A\0A    set -l editor_basename (string match -r '[^/]+$' -- $editor[1])\0A    set -l wrapped_commands\0A    for wrap_target in (complete -- $editor_basename | string replace -rf '^complete [^/]+ --wraps (.+)$' '$1')\0A        set -l tmp\0A        string unescape -- $wrap_target | read -at tmp\0A        set -a wrapped_commands $tmp[1]\0A    end\0A    set -l found false\0A    set -l cursor_from_editor\0A    for editor_command in $editor_basename $wrapped_commands\0A        switch $editor_command\0A            case vi vim nvim\0A                if test $editor_command = vi && not set -l vi_version \22$(vi --version 2>/dev/null)\22\0A                    if printf %s $vi_version | grep -q BusyBox\0A                        break\0A                    end\0A                    set -a editor +{$line} $f\0A                    set found true\0A                    break\0A                end\0A                set cursor_from_editor (mktemp)\0A                set -a editor +$line \22+norm! $col|\22 $f \\\0A                    '+au VimLeave * ++once call writefile([printf(\22%s %s %s\22, shellescape(bufname()), line(\22.\22), col(\22.\22))], \22'$cursor_from_editor'\22)'\0A            case emacs emacsclient gedit\0A                set -a editor +$line:$col $f\0A            case kak\0A                set cursor_from_editor (mktemp)\0A                set -a editor +$line:$col $f -e \22\0A                        hook -always -once global ClientClose %val{client} %{\0A                            echo -to-file $cursor_from_editor -quoting shell \\\0A                                %val{buffile} %val{cursor_line} %val{cursor_column}\0A                        }\0A                    \22\0A            case nano\0A                set -a editor +$line,$col $f\0A            case joe ee\0A                set -a editor +$line $f\0A            case code code-oss\0A                set -a editor --goto $f:$line:$col --wait\0A            case subl\0A                set -a editor $f:$line:$col --wait\0A            case micro\0A                set -a editor $f +$line:$col\0A            case helix hx\0A                set -a editor $f:$line:$col\0A            case '*'\0A                continue\0A        end\0A        set found true\0A        break\0A    end\0A    if not $found\0A        set -a editor $f\0A    end\0A\0A    $editor\0A\0A    set -l raw_lines (command cat $f)\0A    set -l unindented_lines (string join -- \\n $raw_lines | __fish_indent --only-unindent)\0A\0A    # Here we're checking the exit status of the editor.\0A    if test $status -eq 0 -a -s $f\0A        # Set the command to the output of the edited command and move the cursor to the\0A        # end of the edited command.\0A        commandline -r -- $unindented_lines\0A        commandline -C 999999\0A    else\0A        echo\0A        echo (_ \22Ignoring the output of your editor since its exit status was non-zero\22)\0A        echo (_ \22or the file was empty\22)\0A    end\0A    if set -q cursor_from_editor[1]\0A        eval set -l pos \22$(cat $cursor_from_editor)\22\0A        if set -q pos[1] && test $pos[1] = $f\0A            set -l line $pos[2]\0A            set -l indent (math (string length -- \22$raw_lines[$line]\22) - (string length -- \22$unindented_lines[$line]\22))\0A            set -l column (math $pos[3] - $indent)\0A            if not commandline --line $line 2>/dev/null\0A                commandline -f end-of-buffer\0A            else\0A                commandline --column $column 2>/dev/null || commandline -f end-of-line\0A            end\0A        end\0A        command rm $cursor_from_editor\0A    end\0A    command rm $f\0A    # We've probably opened something that messed with the screen.\0A    # A repaint seems in order.\0A    commandline -f repaint\0Aend\0A", align 1
