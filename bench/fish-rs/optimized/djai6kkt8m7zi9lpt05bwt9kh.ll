@anon.1d0b41a8d45d477c3029ec78f9b8b434.1092 = private unnamed_addr constant [14830 x i8] c"# Returns exit code of 0 if apm hasn't received a command yet, e.g. `config`\0Afunction __fish_apm_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    else if test (count $cmd) -gt 1\0A        for c in $cmd[2..-1]\0A            switch $c\0A                # Exclude options that are allowed to appear before command\0A                case --color --no-color help\0A                    continue\0A                case '*'\0A                    return 1\0A            end\0A        end\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A# Returns exit code of 0 if any command (argv[1..-1]) appears once, ignores flags.\0Afunction __fish_apm_using_command\0A    set -l commands $argv\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        set -l command_seen_once 1\0A        for c in $cmd[2..-1]\0A            switch $c\0A                case '-*'\0A                    continue\0A                case $commands\0A                    # If the command is seen more than once then return 1\0A                    if test $command_seen_once -eq 1\0A                        set command_seen_once 0\0A                    else\0A                        return 1\0A                    end\0A                case '*'\0A                    if test $command_seen_once -eq 0\0A                        return 0\0A                    else\0A                        return 1\0A                    end\0A            end\0A        end\0A        return $command_seen_once\0A    end\0A    return 1\0Aend\0A\0A# Check if `commandline` contains a set of subcommands\0Afunction __fish_apm_includes_subcommand\0A    set -l cmd (commandline -xpc)\0A    for subcommand in $argv\0A        if contains $subcommand $cmd\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0A# Lists all apm config items\0Afunction __fish_apm_config_items\0A    apm config list | string match -r -v \22^\\s*;|^\\s*\\$\22 | string replace \22\\w*=\\w*\22 \\t\0Aend\0A\0A# Lists all installed atom packages\0Afunction __fish_apm_list_packages\0A    apm list -b\0Aend\0A\0Aif apm -h 2>| string match -q \22*Atom Package Manager*\22\0A    # Completions for Atom Package Manager\0A\0A    ##################\0A    # global options #\0A    ##################\0A\0A    # help\0A    complete -f -c apm -n __fish_apm_needs_command -s h -l help -d \22Display help\22\0A    complete -f -c apm -n __fish_apm_needs_command -a help -d \22Display help\22\0A    complete -f -c apm -n '__fish_apm_using_command clean config dedupe deinstall delete dev develop docs erase featured home init install link linked links list ln lns login ls open outdated publish rebuild rebuild-module-cache remove rm search show star starred stars test uninstall unlink unpublish unstar update upgrade view' -s h -l help -d 'Display help'\0A\0A    # version\0A    complete -f -c apm -n __fish_apm_needs_command -s v -l version -d \22Display version\22\0A\0A    # color\0A    complete -f -c apm -n __fish_apm_needs_command -l color -d \22Enable colored output\22\0A    complete -f -c apm -n __fish_apm_needs_command -l no-color -d \22Disable colored output\22\0A\0A    ############\0A    # commands #\0A    ############\0A\0A    # clean\0A    complete -f -c apm -n __fish_apm_needs_command -a clean -d \22Deletes packages in node_modules not referenced\0Aas dependency in package.json\22\0A\0A    # config\0A    set -l config_subcommands \22get set edit delete list\22\0A    complete -f -c apm -n __fish_apm_needs_command -a config -d \22Modify or list configuration items\22\0A    complete -x -c apm -n \22__fish_apm_using_command config; and not __fish_apm_includes_subcommand $config_subcommands\22 -a set -d 'Set config item'\0A    complete -x -c apm -n \22__fish_apm_using_command config; and not __fish_apm_includes_subcommand $config_subcommands\22 -a get -d 'Get config item'\0A    complete -x -c apm -n \22__fish_apm_using_command config; and not __fish_apm_includes_subcommand $config_subcommands\22 -a delete -d 'Delete config item'\0A    complete -x -c apm -n \22__fish_apm_using_command config; and not __fish_apm_includes_subcommand $config_subcommands\22 -a list -d 'List config items'\0A    complete -x -c apm -n \22__fish_apm_using_command config; and not __fish_apm_includes_subcommand $config_subcommands\22 -a edit -d 'Edit config items'\0A    complete -x -c apm -n '__fish_apm_using_command config set get delete; and __fish_apm_includes_subcommand set get delete' -a '(__fish_apm_config_items)'\0A\0A    # dedupe\0A    complete -f -c apm -n __fish_apm_needs_command -a dedupe -d \22Reduce duplication in node_modules in current directory\22\0A\0A    # deinstall & delete & erase & remove & rm & uninstall\0A    set -l uninstall_commands \22deinstall delete erase remove rm uninstall\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $uninstall_commands -d \22Delete installed package(s) from ~/.atom/packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $uninstall_commands\22 -a '(__fish_apm_list_packages)'\0A    complete -f -c apm -n \22__fish_apm_using_command $uninstall_commands\22 -l hard -d \22Unlink package from ~/.atom/packages and ~/.atom/dev/packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $uninstall_commands\22 -s d -l dev -d \22Unlink package from ~/.atom/dev/packages\22\0A\0A    # dev(elop)\0A    set -l dev_commands \22dev develop\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $dev_commands -d \22Clone install dependencies and link a package for development\22\0A    complete -f -c apm -n \22__fish_apm_using_command $dev_commands\22 -a '(__fish_apm_list_packages)'\0A\0A    # docs & home & open\0A    set -l open_commands \22docs home open\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $open_commands -d \22Open a package's homepage in the default browser\22\0A    complete -f -c apm -n \22__fish_apm_using_command $open_commands\22 -s p -l print -d \22Print URL instead of opening\22\0A    complete -f -c apm -n \22__fish_apm_using_command $open_commands\22 -a '(__fish_apm_list_packages)'\0A\0A    # featured\0A    complete -f -c apm -n __fish_apm_needs_command -a featured -d \22List Atom packages and themes currently featured in the\0Aatom.io registry\22\0A    complete -f -c apm -n '__fish_apm_using_command featured' -l json -d \22Output featured packages as JSON array\22\0A    complete -f -c apm -n '__fish_apm_using_command featured' -s t -l themes -d \22Only list themes\22\0A    complete -x -c apm -n '__fish_apm_using_command featured' -s c -l compatible -d \22Only list packages/themes compatible with specified Atom version\22\0A\0A    # init\0A    complete -f -c apm -n __fish_apm_needs_command -a init -d \22Generates code scaffolding for theme or package\22\0A    complete -r -c apm -n '__fish_apm_using_command init' -l template -d \22Path to the package or theme template\22\0A    complete -x -c apm -n '__fish_apm_using_command init' -s p -l package -d \22Generates a basic package\22\0A    complete -x -c apm -n '__fish_apm_using_command init' -s t -l theme -d \22Generates a basic theme\22\0A    complete -x -c apm -n '__fish_apm_using_command init' -s l -l language -d \22Generates a basic language package\22\0A    complete -r -c apm -n '__fish_apm_using_command init' -s c -l convert -d \22Convert TextMate bundle/theme\22\0A\0A    # install\0A    complete -f -c apm -n __fish_apm_needs_command -a install -d \22Install Atom package to ~/.atom/packages/<package_name>\22\0A    complete -f -c apm -n '__fish_apm_using_command install' -l check -d \22Check native build tools are installed\22\0A    complete -f -c apm -n '__fish_apm_using_command install' -l verbose -d \22Show verbose debug information\22\0A    complete -r -c apm -n '__fish_apm_using_command install' -l packages-file -d \22Specify text file containing packages to install\22\0A    complete -f -c apm -n '__fish_apm_using_command install' -l production -d \22Do not install dev dependencies\22\0A    complete -x -c apm -n '__fish_apm_using_command install' -s c -l compatible -d \22Only install packages/themes compatible with specified Atom version\22\0A    complete -f -c apm -n '__fish_apm_using_command install' -s s -l silent -d \22Set npm log level to silent\22\0A    complete -f -c apm -n '__fish_apm_using_command install' -s q -l quiet -d \22Set npm log level to quiet\22\0A\0A    # link & ln\0A    set -l link_commands \22link ln\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $link_commands -d \22Create a symlink for the package in ~/.atom/packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $link_commands\22 -s d -l dev -d \22Link to ~/.atom/dev/packages\22\0A\0A    # linked & links & lns\0A    set -l linked_commands \22linked links lns\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $linked_commands -d \22List all symlinked packages in ~/.atom/packages and\0A~/.atom/dev/packages\22\0A\0A    # list & ls\0A    set -l list_commands \22list ls\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $list_commands -d \22List all installed and bundled packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s b -l bare -d \22Print packages one per line with no formatting\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s d -l dev -d \22Include dev packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s i -l installed -d \22Only list installed packages/themes\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s j -l json -d \22Output all packages as a JSON object\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s l -l links -d \22Include linked packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s t -l themes -d \22Only list themes\22\0A    complete -f -c apm -n \22__fish_apm_using_command $list_commands\22 -s p -l packages -d \22Only list packages\22\0A\0A    # login\0A    complete -f -c apm -n __fish_apm_needs_command -a login -d \22Save Atom API token to keychain\22\0A    complete -x -c apm -n \22__fish_apm_using_command login\22 -l token -d \22Specify API token\22\0A\0A    # outdated & upgrade & update\0A    set -l upgrade_commands \22outdated upgrade update\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $upgrade_commands -d \22Upgrade out of date packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $upgrade_commands\22 -l json -d \22Output outdated packages as JSON array\22\0A    complete -x -c apm -n \22__fish_apm_using_command $upgrade_commands\22 -l compatible -d \22Only install packages/themes compatible with specified Atom version\22\0A    complete -f -c apm -n \22__fish_apm_using_command $upgrade_commands\22 -l verbose -d \22Show verbose debug information\22\0A    complete -f -c apm -n \22__fish_apm_using_command $upgrade_commands\22 -s c -l confirm -d \22Confirm before installing updates\22\0A    complete -f -c apm -n \22__fish_apm_using_command $upgrade_commands\22 -s l -l list -d \22List but don't install the outdated packages\22\0A\0A    # publish\0A    set -l publish_subcommands \22major minor patch build\22\0A    complete -f -c apm -n __fish_apm_needs_command -a publish -d \22Publish new version of package in current working directory\22\0A    complete -f -c apm -n \22__fish_apm_using_command publish; and not __fish_apm_includes_subcommand $publish_subcommands\22 -a $publish_subcommands -d \22Semantic version category for new version\22\0A    complete -x -c apm -n '__fish_apm_using_command publish' -s t -l tag -d \22Specify a tag to publish\22\0A    complete -x -c apm -n '__fish_apm_using_command publish' -s r -l rename -d \22Specify a new name for the package\22\0A\0A    # rebuild\0A    complete -f -c apm -n __fish_apm_needs_command -a rebuild -d \22Rebuild modules installed in node_modules in current working directory\22\0A\0A    # rebuild-module-cache\0A    complete -f -c apm -n __fish_apm_needs_command -a rebuild-module-cache -d \22Rebuild module cache for installed packages\22\0A\0A    # search\0A    complete -f -c apm -n __fish_apm_needs_command -a search -d \22Search for Atom packages/themes in the atom.io registry\22\0A    complete -f -c apm -n '__fish_apm_using_command search' -l json -d \22Output matching packages as JSON array\22\0A    complete -f -c apm -n '__fish_apm_using_command search' -s p -l packages -d \22Search only non-theme packages\22\0A    complete -f -c apm -n '__fish_apm_using_command search' -s t -l themes -d \22Search only themes\22\0A\0A    # show & view\0A    set -l show_commands \22show view\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $show_commands -d \22View information about package/theme in the atom.io registry\22\0A    complete -f -c apm -n \22__fish_apm_using_command $show_commands\22 -l json -d \22Output as JSON array\22\0A    complete -x -c apm -n \22__fish_apm_using_command $show_commands\22 -l compatible -d \22Show latest version compatible with specified Atom version\22\0A\0A    # star\0A    complete -f -c apm -n __fish_apm_needs_command -a star -d \22Star the given packages on https://atom.io\22\0A    complete -f -c apm -n '__fish_apm_using_command star' -l installed -d \22Star all packages in ~/.atom/packages\22\0A\0A    # starred & stars\0A    set -l stars_commands \22starred stars\22\0A    complete -f -c apm -n __fish_apm_needs_command -a $stars_commands -d \22List or install starred Atom packages and themes\22\0A    complete -f -c apm -n \22__fish_apm_using_command $stars_commands\22 -l json -d \22Output packages as JSON array\22\0A    complete -f -c apm -n \22__fish_apm_using_command $stars_commands\22 -s i -l install -d \22Install the starred packages\22\0A    complete -f -c apm -n \22__fish_apm_using_command $stars_commands\22 -s t -l themes -d \22