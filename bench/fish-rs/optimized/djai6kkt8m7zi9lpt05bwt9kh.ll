@anon.1d0b41a8d45d477c3029ec78f9b8b434.2748 = private unnamed_addr constant [2504 x i8] c"function __fish_toxenvs\0A    echo ALL\0A    tox --listenvs-all 2>/dev/null\0Aend\0A\0Acomplete -c tox -l version -d \22Report version information to stdout\22\0Acomplete -c tox -s h -l help -d \22Show help about options\22\0Acomplete -c tox -l help-ini -l hi -d \22Show help about ini-names\22\0Acomplete -c tox -s v -l verbose -d \22Increase verbosity of reporting output\22\0Acomplete -c tox -s q -l quiet -d \22Progressively silence reporting output\22\0Acomplete -c tox -l showconfig -d \22Show live configuration\22\0Acomplete -c tox -s l -l listenvs -d \22Show list of test environments\22\0Acomplete -c tox -s a -l listenvs-all -d \22Show list of all defined environments\22\0Acomplete -c tox -s c -F -r -d \22Config file name or directory with 'tox.ini' file\22\0Acomplete -c tox -s e -f -r -a \22(__fish_toxenvs)\22 -d \22Work against specified environments\22\0Acomplete -c tox -l devenv -F -r -d \22Sets up a development environment at ENVIDR\22\0Acomplete -c tox -l notest -d \22Skip invoking test commands\22\0Acomplete -c tox -l sdistonly -d \22Only perform the sdist packaging activity\22\0Acomplete -c tox -l skip-pkg-install -d \22Skip package installation for this run\22\0Acomplete -c tox -s p -l parallel -f -r -d \22Run tox environments in parallel\22\0Acomplete -c tox -s o -l parallel-live -d \22Connect to stdout while running environments\22\0Acomplete -c tox -l installpkg -F -r -d \22Use specified package for installation into venv, instead of creating an sdist\22\0Acomplete -c tox -l develop -d \22Install package in the venv using 'setup.py develop' via 'pip -e .'\22\0Acomplete -c tox -s i -l index-url -r -d \22Set indexserver url\22\0Acomplete -c tox -l pre -d \22Install pre-releases and development versions of dependencies\22\0Acomplete -c tox -s r -l recreate -d \22Force recreation of virtual environments\22\0Acomplete -c tox -l result-json -r -d \22Write commands and results to this JSON file\22\0Acomplete -c tox -l discover -r -d \22For python discovery first try the python executables under these paths\22\0Acomplete -c tox -l hashseed -r -d \22Set PYTHONHASHSEED to SEED before running commands\22\0Acomplete -c tox -l force-dep -r -d \22Force dependency version\22\0Acomplete -c tox -l sitepackages -d \22Override sitepackages setting to True in all envs\22\0Acomplete -c tox -l alwayscopy -d \22Override alwayscopy setting to True in all envs\22\0Acomplete -c tox -l no-provision -d \22Do not perform provision but write JSON metadata to this file\22\0Acomplete -c tox -s s -l skip-missing-interpreters -f -r -a \22config true false\22 -d \22Don't fail tests for missing interpreters\22\0Acomplete -c tox -l workdir -r -d \22Tox working directory\22\0A", align 1
