@anon.1d0b41a8d45d477c3029ec78f9b8b434.2310 = private unnamed_addr constant [2976 x i8] c"# TODO: Whether the expensive operations\0A# done by the module detection really needs to be done every time the completion is invoked is\0A# unclear. See issue #3856.\0Aset -l unicode 'commandline | string match -qr -- \22-[a-zA-Z]*C[a-zA-Z]*\\$\22'\0Aset -l noopt 'commandline | not string match -qr -- \22-[a-zA-Z]*C[a-zA-Z]*\\$\22'\0Aset -l modules \22(find (perl -lE'print for @INC') -name '*.pm' -printf '%P\\n' 2>/dev/null \\\0A                    | sed -e 's,/,::,g; s,\\.pm\\$,,' | sort -u)\22\0Acomplete -c perl -s 0 -n $noopt -d 'Specify record separator'\0Acomplete -c perl -s a -n $noopt -d 'Turn on autosplit mode'\0Acomplete -c perl -s c -n $noopt -d 'Check syntax'\0Acomplete -c perl -s C -n $noopt -d 'Control Unicode features'\0Acomplete -c perl -s Ca -n $unicode -d 'Debug UTF-8 cache'\0Acomplete -c perl -s CA -n $unicode -d 'ARGV uses UTF-8'\0Acomplete -c perl -s CD -n $unicode -d 'Opened filehandles are UTF-8'\0Acomplete -c perl -s CE -n $unicode -d 'STDERR is UTF-8'\0Acomplete -c perl -s Ci -n $unicode -d 'Filehandles that are read are UTF-8'\0Acomplete -c perl -s CI -n $unicode -d 'STDIN is UTF-8'\0Acomplete -c perl -s CL -n $unicode -d 'Enable Unicode conditionally'\0Acomplete -c perl -s Co -n $unicode -d 'Filehandles written to are UTF-8'\0Acomplete -c perl -s CO -n $unicode -d 'STDOUT is UTF-8'\0Acomplete -c perl -s CS -n $unicode -d 'STDOUT, STDIN, and STDERR are UTF-8'\0Acomplete -c perl -s d -n $noopt -d Debugger\0Acomplete -c perl -s dt -n 'commandline | string match -qr \22d\\$\22' -d 'Debugger, with threads'\0Acomplete -c perl -s D -n $noopt -x -d 'Debug option'\0Acomplete -c perl -s e -n $noopt -x -d 'Execute command'\0Acomplete -c perl -s E -n $noopt -x -d 'Execute command, enable optional features'\0Acomplete -c perl -s f -n $noopt -d 'Disable sitecustomize.pl'\0Acomplete -c perl -s F -n $noopt -x -d 'Set regexp used to split input'\0Acomplete -c perl -s h -n $noopt -d 'Show help and exit'\0Acomplete -c perl -s i -n $noopt -x -d 'Edit files in-place'\0Acomplete -c perl -s I -n $noopt -r -d 'Include path'\0Acomplete -c perl -s l -n $noopt -d 'Automatic line ending processing'\0Acomplete -c perl -s m -n $noopt -x -d 'Require module' -a $modules\0Acomplete -c perl -s M -n $noopt -x -d 'Use module' -a $modules\0Acomplete -c perl -s n -n $noopt -d 'Loop script'\0Acomplete -c perl -s p -n $noopt -d 'Loop script, print $_'\0Acomplete -c perl -s s -n $noopt -d 'Define custom switches'\0Acomplete -c perl -s S -n $noopt -d 'Search $PATH for script'\0Acomplete -c perl -s t -n $noopt -d 'Taint checking, but only with warnings'\0Acomplete -c perl -s T -n $noopt -d 'Taint checking'\0Acomplete -c perl -s u -n $noopt -d 'Dump core'\0Acomplete -c perl -s U -n $noopt -d 'Unsafe mode'\0Acomplete -c perl -s v -n $noopt -d 'Display version and exit'\0Acomplete -c perl -s V -n $noopt -d 'Display configuration and exit'\0Acomplete -c perl -s w -n $noopt -d 'Show warnings'\0Acomplete -c perl -s W -n $noopt -d 'Force warnings'\0Acomplete -c perl -s X -n $noopt -d 'Disable warnings'\0Acomplete -c perl -s x -n $noopt -r -d 'Extract script'\0A", align 1
