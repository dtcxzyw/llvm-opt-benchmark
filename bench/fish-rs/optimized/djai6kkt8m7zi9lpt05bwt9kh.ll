@anon.1d0b41a8d45d477c3029ec78f9b8b434.2054 = private unnamed_addr constant [2196 x i8] c"complete -xc man -a \22(__fish_complete_man)\22\0A\0Acomplete -xc man -n 'not __fish_complete_man' -a 1 -d 'Program section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 2 -d 'Syscall section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 3 -d 'Library section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 4 -d 'Device section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 5 -d 'File format section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 6 -d 'Games section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 7 -d 'Misc section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 8 -d 'Admin section'\0Acomplete -xc man -n 'not __fish_complete_man' -a 9 -d 'Kernel section'\0Acomplete -xc man -n 'not __fish_complete_man' -a tcl -d 'Tcl section'\0Acomplete -xc man -n 'not __fish_complete_man' -a n -d 'New section'\0Acomplete -xc man -n 'not __fish_complete_man' -a l -d 'Local section'\0Acomplete -xc man -n 'not __fish_complete_man' -a p\0Acomplete -xc man -n 'not __fish_complete_man' -a o -d 'Old section'\0A\0Acomplete -rc man -s C -d \22Configuration file\22\0Acomplete -xc man -s M -a \22(__fish_complete_directories (commandline -ct))\22 -d Manpath\0Acomplete -rc man -s P -d Pager\0Acomplete -xc man -s S -d \22Manual sections\22\0Acomplete -c man -s a -d \22Display all matches\22\0Acomplete -c man -s c -d \22Always reformat\22\0Acomplete -c man -s d -d Debug\0Acomplete -c man -s D -d \22Debug and run\22\0Acomplete -c man -s f -d \22Show whatis information\22\0Acomplete -c man -s F -l preformat -d \22Format only\22\0Acomplete -c man -s h -d \22Display help and exit\22\0Acomplete -c man -s k -d \22Show apropos information\22\0Acomplete -c man -s K -d \22Search in all man pages\22\0Acomplete -xc man -s m -d \22Set system\22\0Acomplete -xc man -s p -d Preprocessors\0Acomplete -c man -s t -d \22Format for printing\22\0Acomplete -c man -s w -l path -d \22Only print locations\22\0Acomplete -c man -s W -d \22Only print locations\22\0A\0Acomplete -c man -n 'string match -q -- \22*/*\22 (commandline -t | string collect)' --force-files\0Aif command -q man\0A    # We have a conditionally-defined man function,\0A    # so we need to check for existence here.\0A    if echo | MANPAGER=cat command man -l - &>/dev/null\0A        complete -c man -s l -l local-file -d \22Local file\22 -r\0A    end\0Aend\0A", align 1
