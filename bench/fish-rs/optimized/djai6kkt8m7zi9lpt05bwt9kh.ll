@anon.1d0b41a8d45d477c3029ec78f9b8b434.2486 = private unnamed_addr constant [4957 x i8] c"# abort if `rename` is not installed\0Acommand -sq rename; or return\0A\0Aset -l rename_version (rename --version 2>/dev/null)\0Aset -l version_status $status\0A\0Aif string match -q \22*util-linux*\22 $rename_version[1]\0A    # util-linux version\0A    # https://www.mankier.com/1/rename\0A    complete -c rename -s s -l symlink -d 'Rename symlink target(s)'\0A    complete -c rename -s v -l verbose -n '! __fish_seen_argument -s n -l no-act' -d 'Show which files were renamed'\0A    complete -c rename -s v -l verbose -n '__fish_seen_argument -s n -l no-act' -d 'Show which files would be renamed'\0A    complete -c rename -s n -l no-act -d 'Make no changes'\0A    complete -c rename -s a -l all -d 'Replace all occurrences'\0A    complete -c rename -s l -l last -d 'Replace only the last occurrence'\0A    complete -c rename -s o -l no-overwrite -n '! __fish_seen_argument -s s -l symlink' -d \22Don't overwrite existing files\22\0A    complete -c rename -s o -l no-overwrite -n '__fish_seen_argument -s s -l symlink' -d \22Don't overwrite symlink targets\22\0A    complete -c rename -s i -l interactive -d 'Ask before overwriting'\0A    complete -c rename -s h -l help -d 'Print help text and exit'\0A    complete -c rename -s V -l version -d 'Print version and exit'\0Aelse if string match -q \22*File::Rename*\22 $rename_version[1]\0A    # Perl library version\0A    # https://metacpan.org/release/File-Rename\0A    complete -c rename -s v -l verbose -d 'Print renamed files'\0A    complete -c rename -s 0 -l null -d 'Split on NUL when reading from stdin'\0A    complete -c rename -s n -l nono -d 'Only show what would be renamed'\0A    complete -c rename -s f -l force -d 'Overwrite existing files'\0A    complete -c rename -l path -l fullpath -n '! __fish_seen_argument -s d -l filename -l nopath -l nofullpath' -d 'Rename any directory component'\0A    complete -c rename -s d -l filename -l nopath -l nofullpath -n '! __fish_seen_argument -l path -l fullpath' -d 'Rename only filename component'\0A    complete -c rename -s h -l help -d 'Print synopsis and options'\0A    complete -c rename -s m -l man -d 'Print manual page'\0A    complete -c rename -s V -l version -d 'Show version number'\0A    complete -c rename -s u -l unicode -d 'Treat filenames as Unicode strings'\0A    complete -c rename -s e -x -d 'Perl expression'\0A    complete -c rename -s E -x -d 'Perl statement'\0Aelse if test \22$version_status\22 = 2\0A    # `brew install rename`\0A    # http://plasmasturm.org/code/rename\0A    complete -c rename -s h -l help -d 'See a synopsis'\0A    complete -c rename -l man -d 'Browse the manpage'\0A    complete -c rename -s 0 -l null -d 'Split on NUL bytes'\0A    complete -c rename -s f -l force -d 'Rename over existing files'\0A    complete -c rename -s g -l glob -d 'Glob filename arguments'\0A    complete -c rename -s i -l interactive -d 'Confirm every action'\0A    complete -c rename -s k -l backwards -l reverse-order -d 'Process last file first'\0A    complete -c rename -s l -l symlink -n '! __fish_seen_argument -s L -l hardlink' -d 'Symlink instead of renaming'\0A    complete -c rename -s L -l hardlink -n '! __fish_seen_argument -s l -l symlink' -d 'Hardlink instead of renaming'\0A    complete -c rename -s M -l use -x -d 'Like perl -M'\0A    complete -c rename -s n -l dry-run -l just-print -d 'Only show what would be renamed'\0A    complete -c rename -s N -l counter-format -x -a '01 001 0001' -d 'Format and set $N per template'\0A    complete -c rename -s p -l mkpath -l make-dirs -d 'Create non-existent dirs'\0A    complete -c rename -l stdin -l no-stdin -d 'Always/never read list of files from STDIN'\0A    complete -c rename -s T -l transcode -x -d 'Transcode filenames'\0A    complete -c rename -s v -l verbose -d 'Print more information'\0A    complete -c rename -s a -l append -x -d 'Append STRING to each filename'\0A    complete -c rename -s A -l prepend -x -d 'Prepend STRING to each filename'\0A    complete -c rename -s c -l lower-case -d 'Convert to all lowercase'\0A    complete -c rename -s C -l upper-case -d 'Convert to all uppercase'\0A    complete -c rename -s e -l expr -x -d 'Perl expression'\0A    complete -c rename -s P -l pipe -d 'Pass filenames to external command'\0A    complete -c rename -s s -l subst -x -d 'Simple text substitution'\0A    complete -c rename -s S -l subst-all -x -d 'Like -s, but substitutes all matches'\0A    complete -c rename -s x -l remove-extension -d 'Remove extension'\0A    complete -c rename -s X -l keep-extension -d 'Save and remove extension'\0A    complete -c rename -s z -l sanitize -d 'Shortcut for --nows --noctrl --nometa --trim'\0A    complete -c rename -l camelcase -d 'Capitalise each word in the filename'\0A    complete -c rename -l urlesc -d 'Decode URL-escaped filenames'\0A    complete -c rename -l nows -d 'Replace all whitespace with underscores'\0A    complete -c rename -l rews -d 'Replace all underscores with whitespace'\0A    complete -c rename -l noctrl -d 'Replace all control chars with underscores'\0A    complete -c rename -l nometa -d 'Replace all shell meta-chars with underscores'\0Aend\0A", align 1
