a(128, 128, 128, 0.4);\0A    color: #fff;\0A}\0A\0A.save_button:hover,\0A.customize_theme_button:hover,\0A.generic_button:hover {\0A    border-color: rgba(171, 171, 171, 0.9);\0A}\0A\0A.button_highlight {\0A    background-color: rgba(128, 128, 128, 0.6);\0A}\0A\0A.prompt_save_button {\0A    background-color: #333;\0A    border: solid #525252 1px;\0A    color: #ffffff;\0A    margin: 2px 20px 25px; /* top right bottom left */\0A    font-size: 12pt;\0A}\0A\0A.prompt_demo_text {\0A    white-space: pre;\0A    line-height: 170%;\0A    padding: 4px 12px;\0A    font-size: 14pt;\0A    top: 0px;\0A    bottom: 0px;\0A    vertical-align: middle;\0A    display: table-cell;\0A    height: 72px; /* this is really the min height */\0A}\0A\0A.prompt_function {\0A    display: block;\0A    border: 1px solid #555;\0A    background-color: #181818;\0A    margin: 5px 20px 5px;\0A    border-radius: 5;\0A}\0A\0A.prompt_function_text {\0A    white-space: pre-wrap;\0A    padding: 15px 3px;\0A    width: 100%;\0A    height: 25%;\0A    overflow: auto;\0A}\0A\0A.external_link_img {\0A    width: 16px;\0A    height: 16px;\0A    vertical-align: text-top;\0A    margin-left: 10px;\0A}\0A\0A.paginator {\0A    display: inline-block;\0A    vertical-align: bottom;\0A    margin-right: 15px;\0A    position: relative;\0A    bottom: 2px;\0A}\0A\0A.paginator td {\0A    padding: 0 8px;\0A}\0A\0A.paginator .desc {\0A    min-width: 55px;\0A}\0A\0A.paginator .prev button,\0A.paginator .next button {\0A    font-size: 11pt;\0A}\0A\0A@media screen and (max-width: 1000px) {\0A    /* On small screens remove the margins to leave more for the actual content */\0A    body {\0A        width: 100%;\0A        margin: 0 0 0 0;\0A    }\0A\0A    #ancestor {\0A        width: 100%;\0A    }\0A\0A    #parent {\0A        margin-top: 0;\0A    }\0A    #tab_contents {\0A        margin-bottom: 0;\0A    }\0A}\0A\0A@media (prefers-color-scheme: dark) {\0A    body {\0A        background: linear-gradient(to top, #1f1f3f 0%,#051f3a 100%);\0A 