@anon.1d0b41a8d45d477c3029ec78f9b8b434.2568 = private unnamed_addr constant [3059 x i8] c"# Load completions shared by various ssh tools like ssh, scp and sftp.\0A__fish_complete_ssh scp\0A\0A# Helper functions to simplify the completions.\0Afunction __scp2ssh_port_number\0A    # There is a silly inconsistency between the ssh and scp commands regarding the short flag name\0A    # for specifying the TCP port number. This function deals with that by extracting the port\0A    # number if present.\0A    set -l port (commandline -c | string match -r -- ' -P ?(\\d+)\\b')\0A    and echo $port[2]\0Aend\0A\0Afunction __scp_remote_target\0A    set -l target (commandline -ct | string match -r -- '(.*):')\0A    and echo $target[2]\0Aend\0A\0Afunction __scp_remote_path_prefix\0A    set -l path_prefix (commandline -ct | string match -r -- ':(.*)')\0A    and echo $path_prefix[2]\0Aend\0A\0Afunction __fish_no_scp_remote_specified\0A    set -l tokens (commandline -t)\0A    # can't use `for token in tokens[1..-2]` due to https://github.com/fish-shell/fish-shell/issues/4897\0A    set -e tokens[-1]\0A    for token in $tokens # ignoring current token\0A        if string match -e @ -- $token\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0A#\0A# scp specific completions\0A#\0A\0A# Inherit user/host completions from ssh\0Acomplete -c scp -d Remote -n \22__fish_no_scp_remote_specified; and not string match -e -- : (commandline -ct)\22 -a \22(complete -C'ssh ' | string replace -r '\\t.*' ':')\22\0A\0A# Local path\0Acomplete -c scp -d \22Local Path\22 -n \22not string match @ -- (commandline -ct)\22\0A\0A# Remote path\0A# Get the list of remote files from the scp target.\0Acomplete -c scp -d \22Remote Path\22 -f -n \22commandline -ct | string match -e ':'\22 -a '\0A    (__scp_remote_target):(\0A        if not set -q __fish_scp_sftp\0A            set -l tmp (mktemp)\0A            if scp -P(__scp2ssh_port_number) -o \22BatchMode yes\22 -q -O $tmp (__scp_remote_target):/dev/null\0A                set -g __fish_scp_sftp true\0A            else\0A                set -g __fish_scp_sftp false\0A            end\0A            rm $tmp\0A        end\0A        if $__fish_scp_sftp\0A            command ssh -p(__scp2ssh_port_number) -o \22BatchMode yes\22 (__scp_remote_target) command\\ ls\\ -dp\\ (__scp_remote_path_prefix)\\* 2>/dev/null\0A        else\0A            command ssh -p(__scp2ssh_port_number) -o \22BatchMode yes\22 (__scp_remote_target) command\\ ls\\ -dp\\ (__scp_remote_path_prefix | string unescape)\\* 2>/dev/null |\0A            string escape -n\0A        end\0A    )\0A'\0A\0Acomplete -c scp -s 3 -d \22Copies between two remote hosts are transferred through the local host\22\0Acomplete -c scp -s B -d \22Batch mode\22\0Acomplete -c scp -s D -x -d \22Connect directly to a local SFTP server\22\0Acomplete -c scp -s l -x -d \22Bandwidth limit\22\0Acomplete -c scp -s O -d \22Use original SCP protocol instead of SFTP\22\0Acomplete -c scp -s P -x -d Port\0Acomplete -c scp -s p -d \22Preserves modification times, access times, and modes from the original file\22\0Acomplete -c scp -s R -d \22Copies between two remote hosts are performed by executing scp on the origin host\22\0Acomplete -c scp -s r -d \22Recursively copy\22\0Acomplete -c scp -s S -d \22Encryption program\22\0Acomplete -c scp -s T -d \22Disable strict filename checking\22\0A", align 1
