sh_use_subcommand -a reselectdist -d \22Modify reselection distance\22\0A\0A## NTP sources\0Acomplete -f -c chronyc -n __fish_use_subcommand -a activity -d \22Check how many NTP sources are online/offline\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a ntpdata -d \22Show info about last valid measurement\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a add\0Acomplete -f -c chronyc -n \22__fish_seen_subcommand_from add\22 -a peer -d \22Add new NTP peer\22\0Acomplete -f -c chronyc -n \22__fish_seen_subcommand_from add\22 -a server -d \22Add new NTP server\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a delete -d \22Remove server/peer\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a burst -d \22Start rapid set of measurements\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a maxdelay -d \22Modify max valid sample delay\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a maxdelaydevratio -d \22Modify max valid delay/deviation ratio\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a maxdelayratio -d \22Modify max valid delay/min ratio\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a maxpoll -d \22Modify max polling interval\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a minpoll -d \22Modify min polling interval\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a minstratum -d \22Modify min stratum\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a offline -d \22Set sources in subnet to offline status\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a online -d \22Set sources in subnet to online status\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a onoffline -d \22Set all sources to online/offline status according to network config\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a polltarget -d \22Modify poll target\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a refresh -d \22Refresh IP address\22\0A\0A## Manual time input\0Acomplete -f -c chronyc -n __fish_use_subcommand -a