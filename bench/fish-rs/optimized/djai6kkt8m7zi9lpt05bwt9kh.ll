@anon.1d0b41a8d45d477c3029ec78f9b8b434.3490 = private unnamed_addr constant [8900 x i8] c"#\0A# Wrap the builtin history command to provide additional functionality.\0A#\0Afunction history --description \22display or manipulate interactive command history\22\0A    set -l cmd history\0A    set -l options --exclusive 'c,e,p' --exclusive 'S,D,M,V,X'\0A    set -a options h/help c/contains e/exact p/prefix\0A    set -a options C/case-sensitive R/reverse z/null 't/show-time=?' 'n#max'\0A    # The following options are deprecated and will be removed in the next major release.\0A    # Note that they do not have usable short flags.\0A    set -a options S-search D-delete M-merge V-save X-clear\0A    argparse -n $cmd $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help history\0A        return 0\0A    end\0A\0A    set -l hist_cmd\0A    set -l show_time\0A    set -l max_count\0A    set -l search_mode\0A    set -q _flag_max\0A    set max_count -n$_flag_max\0A\0A    set -q _flag_with_time\0A    and set -l _flag_show_time $_flag_with_time\0A    if set -q _flag_show_time[1]\0A        set show_time --show-time=$_flag_show_time\0A    else if set -q _flag_show_time\0A        set show_time --show-time\0A    end\0A\0A    set -q _flag_prefix\0A    and set -l search_mode --prefix\0A    set -q _flag_contains\0A    and set -l search_mode --contains\0A    set -q _flag_exact\0A    and set -l search_mode --exact\0A\0A    if set -q _flag_delete\0A        set hist_cmd delete\0A    else if set -q _flag_save\0A        set hist_cmd save\0A    else if set -q _flag_clear\0A        set hist_cmd clear\0A    else if set -q _flag_search\0A        set hist_cmd search\0A    else if set -q _flag_merge\0A        set hist_cmd merge\0A    else if set -q _flag_clear-session\0A        set hist_cmd clear-session\0A    end\0A\0A    # If a history command has not already been specified check the first non-flag argument for a\0A    # command. This allows the flags to appear before or after the subcommand.\0A    if not set -q hist_cmd[1]\0A        and set -q argv[1]\0A        if contains $argv[1] search delete merge save clear clear-session append\0A            set hist_cmd $argv[1]\0A            set -e argv[1]\0A        end\0A    end\0A\0A    if not set -q hist_cmd[1]\0A        set hist_cmd search # default to \22search\22 if the user didn't specify a subcommand\0A    end\0A\0A    switch $hist_cmd\0A        case search # search the interactive command history\0A            if isatty stdout\0A                set -l pager (__fish_anypager)\0A                and isatty stdout\0A                or set pager cat\0A\0A                # If the user hasn't preconfigured less with the $LESS environment variable,\0A                # we do so to have it behave like cat if output fits on one screen.\0A                if not set -qx LESS\0A                    set -fx LESS --quit-if-one-screen\0A                    # Also set --no-init for less < v530, see #8157.\0A                    if type -q less; and test (less --version | string match -r 'less (\\d+)')[2] -lt 530 2>/dev/null\0A                        set LESS $LESS --no-init\0A                    end\0A                end\0A                not set -qx LV # ask the pager lv not to strip colors\0A                and set -fx LV -c\0A\0A                builtin history search $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv | $pager\0A            else\0A                builtin history search $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv\0A            end\0A\0A        case delete # interactively delete history\0A            set -l searchterm $argv\0A            if not set -q argv[1]\0A                read -P\22Search term: \22 searchterm\0A            end\0A\0A            if test \22$search_mode\22 = --exact\0A                builtin history delete $search_mode $_flag_case_sensitive -- $searchterm\0A                builtin history save\0A                return\0A            end\0A\0A            # TODO: Fix this so that requesting history entries with a timestamp works:\0A            #   set -l found_items (builtin history search $search_mode $show_time -- $argv)\0A            set -l found_items\0A            set found_items (builtin history search $search_mode $_flag_case_sensitive --null -- $searchterm | string split0)\0A            if set -q found_items[1]\0A                set -l found_items_count (count $found_items)\0A                for i in (seq $found_items_count)\0A                    printf \22[%s] %s\\n\22 $i $found_items[$i]\0A                end\0A                echo\0A                echo \22Enter nothing to cancel the delete, or\22\0A                echo \22Enter one or more of the entry IDs or ranges like '5..12', separated by a space.\22\0A                echo \22For example '7 10..15 35 788..812'.\22\0A                echo \22Enter 'all' to delete all the matching entries.\22\0A                echo\0A                read --local --prompt \22echo 'Delete which entries? '\22 choice\0A                echo ''\0A\0A                if test -z \22$choice\22\0A                    printf \22Cancelling the delete!\\n\22\0A                    return\0A                end\0A\0A                if test \22$choice\22 = all\0A                    printf \22Deleting all matching entries!\\n\22\0A                    for item in $found_items\0A                        builtin history delete --exact --case-sensitive -- $item\0A                    end\0A                    builtin history save\0A                    return\0A                end\0A\0A                set -l choices\0A                for i in (string split \22 \22 -- $choice)\0A                    # Expand ranges like 577..580\0A                    if set -l inds (string match -rg '^([1-9][0-9]*)\\.\\.([1-9][0-9]*)' -- $i)\0A                        if test $inds[1] -gt $found_items_count\0A                            or test $inds[1] -gt $inds[2]\0A                            printf (_ \22Ignoring invalid history entry ID \\\22%s\\\22\\n\22) $i\0A                            continue\0A                        end\0A\0A                        set -l indexes (seq $inds[1] 1 $inds[2])\0A                        if set -q indexes[1]\0A                            set -a choices $indexes\0A                        end\0A                        continue\0A                    end\0A\0A                    if string match -qr '^[1-9][0-9]*$' -- $i\0A                        and test $i -le $found_items_count\0A                        set -a choices $i\0A                    else\0A                        printf (_ \22Ignoring invalid history entry ID \\\22%s\\\22\\n\22) $i\0A                        continue\0A                    end\0A                end\0A\0A                if not set -q choices[1]\0A                    return 1\0A                end\0A\0A                set choices (path sort -u -- $choices)\0A\0A                echo Deleting choices: $choices\0A                for x in $choices\0A                    printf \22Deleting history entry %s: \\\22%s\\\22\\n\22 $x $found_items[$x]\0A                    builtin history delete --exact --case-sensitive -- \22$found_items[$x]\22\0A                end\0A                builtin history save\0A            end\0A\0A        case save # save our interactive command history to the persistent history\0A            builtin history save $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv\0A        case merge # merge the persistent interactive command history with our history\0A            builtin history merge $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv\0A        case clear # clear the interactive command history\0A            if test -n \22$search_mode\22\0A                or set -q show_time[1]\0A                printf (_ \22%ls: %ls: subcommand takes no options\\n\22) history $hist_cmd >&2\0A                return 1\0A            end\0A            if set -q argv[1]\0A                printf (_ \22%ls: %ls: expected %d arguments; got %d\\n\22) history $hist_cmd 0 (count $argv) >&2\0A                return 1\0A            end\0A\0A            printf (_ \22If you enter 'yes' your entire interactive command history will be erased\\n\22)\0A            read --local --prompt \22echo 'Are you sure you want to clear history? (yes/no) '\22 choice\0A            if test \22$choice\22 = yes\0A                builtin history clear $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv\0A                and printf (_ \22Command history cleared!\\n\22)\0A            else\0A                printf (_ \22You did not say 'yes' so I will not clear your command history\\n\22)\0A            end\0A        case clear-session # clears only session\0A            builtin history clear-session $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $argv\0A            and printf (_ \22Command history for session cleared!\\n\22)\0A        case append\0A            set -l newitem $argv\0A            if not set -q argv[1]\0A                read -P \22Command: \22 newitem\0A            end\0A\0A            builtin history append $search_mode $show_time $max_count $_flag_case_sensitive $_flag_reverse $_flag_null -- $newitem\0A        case '*'\0A            printf \22%ls: unexpected subcommand '%ls'\\n\22 $cmd $hist_cmd\0A            return 2\0A    end\0Aend\0A", align 1
