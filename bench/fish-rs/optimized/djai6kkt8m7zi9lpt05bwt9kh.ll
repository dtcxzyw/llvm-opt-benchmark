_fish_composer_using_command suggests' -l no-dev -d 'Exclude suggestions from require-dev packages'\0A\0A# update\0Acomplete -f -c composer -n '__fish_composer_using_command update' -a \22(__fish_composer_required_packages)\22\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l prefer-source -d 'Forces installation from package sources when possible, including VCS information'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l prefer-dist -d 'Forces installation from package dist even for dev versions'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l dry-run -d 'Outputs the operations but will not execute anything (implicitly enables --verbose)'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l dev -d 'Enables installation of require-dev packages (enabled by default, only present for BC)'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-dev -d 'Disables installation of require-dev packages'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l lock -d 'Only updates the lock file hash to suppress warning about the lock file being out of date'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-custom-installers -d 'DEPRECATED: Use no-plugins instead'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-autoloader -d 'Skips autoloader generation'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-scripts -d 'Skips the execution of all scripts defined in composer.json file'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-progress -d 'Do not output download progress'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l no-suggest -d 'Do not show package suggestions'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l with-dependencies -d 'Add deps of whitelisted packages to whitelist, except those defined in root package'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l with-all-dependencies -d 'Add deps of whitelisted packages to whitelist, including those defined in root package'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -s v -l verbose -d 'Shows more details including new commits pulled in when updating packages'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -s o -l optimize-autoloader -d 'Optimize autoloader during autoloader dump'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -s a -l classmap-authoritative -d 'Autoload classes from the classmap only. Implicitly enables `--optimize-autoloader`'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l apcu-autoloader -d 'Use APCu to cache found/not-found classes'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l ignore-platform-reqs -d 'Ignore platform requirements (php & ext- packages)'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l prefer-stable -d 'Prefer stable versions of dependencies'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l prefer-lowest -d 'Prefer lowest versions of dependencies'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -s i -l interactive -d 'Interactive interface with autocompletion to select the packages to update'\0Acomplete -f -c composer -n '__fish_composer_using_command update' -l root-reqs -d 'Restricts the update to your first degree dependencies'\0A\0A# validate\0Acomplete -f -c composer -n '__fish_composer_using_command validate' -l no-check-all -d 'Do not validate requires for overly strict/loose constraints'\0Acomplete -f -c composer -n '__fish_composer_using_command validate' -l no-check-lock -d 'Do not check if lock file is up to date'\0Acomplete -f -c composer -n '__fish_composer_using_command validate' -l no-check-publish -d 'Do not check for publish errors'\0Acomplete -f -c composer -n '__fish_composer_using_command validate' -l with-dependencies -d 'Also validate the composer.json of all installed dependencies'\0Acomplete -f -c composer -n '__fish_composer_using_command validate' -l strict -d 'Return a non-zero exit code for warnings as well as errors'\0A\0A# why\0Acomplete -f -c composer -n '__fish_composer_using_command why' -a \22(__fish_composer_installed_packages)\22\0A\0A# why-not\0Acomplete -f -c composer -n '__fish_composer_using_command why-not' -a \22(__fish_composer_installed_packages)\22\0A\0A# global options\0Acomplete -c composer -n __fish_composer_needs_command -s h -l help -d 'Displays composer\\'s help'\0Acomplete -c composer -n __fish_composer_needs_command -s q -l quiet -d 'Do not output any message'\0Acomplete -c composer -n __fish_composer_needs_command -s v -l verbose -d 'Verbose mode (pass multiple times for even verboser mode)'\0Acomplete -c composer -n __fish_composer_needs_command -s V -l version -d 'Display composer\\'s application version'\0Acomplete -c composer -n __fish_composer_needs_command -l ansi -d 'Force ANSI output'\0Acomplete -c composer -n __fish_composer_needs_command -l no-ansi -d 'Disable ANSI output'\0Acomplete -c composer -n __fish_composer_needs_command -s n -l no-interaction -d 'Do not ask any interactive question'\0Acomplete -c composer -n __fish_composer_needs_command -l profile -d 'Display timing and memory usage information'\0Acomplete -c composer -n __fish_composer_needs_command -l no-plugins -d 'Whether to disable plugins'\0Acomplete -c composer -n __fish_composer_needs_command -s d -l working-dir -d 'If specified, use the given directory as working directory'\0Acomplete -c composer -n __fish_composer_needs_command -l no-cache -d 'Prevent use of the cache'\0A", align 1
