@anon.1d0b41a8d45d477c3029ec78f9b8b434.1400 = private unnamed_addr constant [6488 x i8] c"# excluding help\0Aset -l subcommands frequency-info frequency-set idle-info idle-set set info monitor\0A\0A# disable file completion\0Acomplete -fc cpupower\0A\0A# common switches\0Acomplete -c cpupower -s h -l help -d \22Show supported commands and general usage\22\0Acomplete -c cpupower -s c -l cpu -x -a all -d \22Only show or set values for specific cores\22 # im not gonna write completion for the cpu bit mask stuff thingy\0A\0A# complete subcommands\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a help -d \22Show manpage for subcommands\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a frequency-info -d \22Retrieve cpufreq kernel information\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a frequency-set -d \22Modify cpufreq settings\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a idle-info -d \22Retrieve cpu idle kernel information\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a idle-set -d \22Set cpu idle state specific kernel options\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a set -d \22Set processor power related kernel or hardware config\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a info -d \22Show processor power related kernel or hardware config\22\0Acomplete -c cpupower -n \22not __fish_seen_subcommand_from $subcommands help\22 -a monitor -d \22Report processor frequency and idle statistics\22\0A\0A# complete other subcommands after 'help', but only once\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from help && not __fish_seen_subcommand_from $subcommands\22 -x -a \22frequency-info frequency-set idle-info idle-set set info monitor\22\0A\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s e -l debug -d \22Prints out debug information\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s f -l freq -d \22Get frequency the CPU currently runs at, according to the cpufreq core\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s w -l hwfreq -d \22Get frequency the CPU currently runs at, by reading it from hardware\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s l -l hwlimits -d \22Determine the minimum and maximum CPU frequency allowed\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s d -l driver -d \22Determines the used cpufreq kernel driver\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s p -l policy -d \22Gets the currently used cpufreq policy\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s g -l governors -d \22Determines available cpufreq governors\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s s -l stats -d \22Shows cpufreq statistics if available\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s y -l latency -d \22Determines the maximum latency on CPU frequency changes\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s o -l proc -d \22Prints out information like the old /proc/cpufreq\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s m -l human -d \22human-readable output for the -f, -w, -s and -y parameters\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s n -l no-rounding -d \22Output frequencies and latencies without rounding off values\22\0A# according to the manual, both of these have the short switch '-a', but -a seems to behave as the letter\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -l related-cpus -a \22Determines which CPUs run at the same hardware frequency\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-info\22 -s a -l affected-cpus -a \22Determines which CPUs need to have their frequency coordinated by software\22\0A\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-set\22 -s d -l min -x -d \22new minimum CPU frequency the governor may select\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-set\22 -s u -l max -x -d \22new maximum CPU frequency the governor may select\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-set\22 -s g -l governor -x -a \22(string split ' ' < /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)\22 -d \22new cpufreq governor\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-set\22 -s f -l freq -x -d \22specific frequency to be set. Requires userspace governor to be available and loaded\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from frequency-set\22 -s r -l related -d \22modify all hardware-related CPUs at the same time\22\0A\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from idle-info\22 -s f -l silent -d \22Only print a summary of all available C-states in the system\22\0A\0Aset -l idlestates (LC_ALL=C cpupower idle-info | string replace -f 'Available idle states: ' '')\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from idle-set\22 -s d -l disable -x -a \22$idlestates\22 -d \22Disable a specific processor sleep state\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from idle-set\22 -s e -l enable -x -a \22$idlestates\22 -d \22Enable a specific processor sleep state\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from idle-set\22 -s D -l disable-by-latency -x -d \22Disable all idle states with a equal or higher latency than <LATENCY>\22\0Acomplete -c cpupower -n \22__fish_seen_subcommand_from idle-set\22 -s E -l enable-all -d \22Enable all idle states if not enabled already\22\0A\0Acomplete -c cpupower -n \22__fish_seen_subcommand