@anon.1d0b41a8d45d477c3029ec78f9b8b434.2814 = private unnamed_addr constant [890 x i8] c"# Completions for the eix tool's update-eix command\0A# http://dev.croup.de/proj/eix and http://sourceforge.net/projects/eix/\0A\0A# Author: Tassilo Horn <tassilo@member.fsf.org>\0A\0A##########\0A# UPDATE-EIX\0Acomplete -c update-eix -s h -l help -d \22Show a short help screen\22\0Acomplete -c update-eix -s V -l version -d \22Show version string\22\0Acomplete -c update-eix -l dump -d \22Show eixrc-variables\22\0Acomplete -c update-eix -l dump-defaults -d \22Show default eixrc-variables\22\0Acomplete -c update-eix -s q -l quiet -d \22Produce no output\22\0Acomplete -c update-eix -s o -l output -d \22Output to the given file\22\0Acomplete -c update-eix -s x -l exclude-overlay -d \22Exclude the given overlay from the update-process\22\0Acomplete -c update-eix -s a -l add-overlay -d \22Add the given overlay to the update-process\22\0Acomplete -c update-eix -s m -l override-method -d \22Override cache method for a specified overlay\22\0A##########\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2815 = private unnamed_addr constant [22 x i8] c"completions/usbip.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2816 = private unnamed_addr constant [2736 x i8] c"function __fish_usbip_no_subcommand -d 'Test if usbip has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i attach detach list bind unbind port\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_usbip_remote -d 'List remote usbip host'\0A    set -l remote (ip r | awk '/via/ {print $3\22\\t\22$5}')\0A    printf '%s\\n' $remote\0Aend\0A\0Afunction __fish_usbip_busid -d 'List usbip busid'\0A    set -l remote (commandline -xpc | string match -r '(?<=-r)(emote)?=?\\s*(\\S+)' | string trim)\0A    set -l busids (usbip list -r $remote 2> /dev/null | string match -r '\\d+-\\d+')\0A    printf '%s\\n' $busids\0Aend\0A\0Afunction __fish_usbip_busid_attached -d 'List usbip busid attached'\0A    set -l usbids (usbip port 2> /dev/null | string match -r '(?<=Port\\s)(\\d+)')\0A    printf '%s\\n' $usbids\0Aend\0A\0Acomplete -f -c usbip\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a attach -d 'Attach a USB device to the host'\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a detach -d 'Detach a USB device from the host'\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a list -d 'List USB devices on the host'\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a bind -d 'Bind a USB device to a driver'\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a unbind -d 'Unbind a USB device from a driver'\0Acomplete -f -c usbip -n __fish_usbip_no_subcommand -a port -d 'List USB ports on the host'\0A\0A# attach\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from attach' -s r -l remote -d 'The machine with exported USB devices' -xa \22(__fish_usbip_remote)\22\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from attach' -s b -l busid -d 'Busid of the device on <host>' -xa \22(__fish_usbip_busid)\22\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from attach' -s d -l device -d 'Id of the virtual UDB on <host>'\0A\0A# detach\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from detach' -s p -l port -d 'Vhci_hcd port the device is on' -xa \22(__fish_usbip_busid_attached)\22\0A\0A# list\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from list' -s p -l parsable -d 'Parsable list format'\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from list' -s r -l remote -d 'List the exportable USB devices on <host>' -xa \22(__fish_usbip_remote)\22\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from list' -s l -l local -d 'List the local USB devices'\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from list' -s d -l device -d 'List the local USB gadgets bound to usbip-vudc'\0A\0A# Bind\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from bind' -s b -l busid -d 'Bind usbip-host.ko to device on <busid>'\0A\0A# unbind\0Acomplete -f -c usbip -n '__fish_seen_subcommand_from unbind' -s b -l busid -d 'Unbind usbip-host.ko to device on <busid>'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2817 = private unnamed_addr constant [24 x i8] c"completions/useradd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2818 = private unnamed_addr constant [1793 x i8] c"#\0A# Command specific completions for the useradd command.\0A# These completions where generated from the commands\0A# man page by the make_completions.py script, but may\0A# have been hand edited since.\0A#\0A\0Acomplete -c useradd -s c -l comment -d 'A comment about this user' -r\0Acomplete -c useradd -s d -l home -d 'Home directory for the new user' -x -a '(__fish_complete_directories)'\0Acomplete -c useradd -s G -l groups -d 'Supplementary groups' -xa '(__fish_append , (string split -f1 : /etc/group))'\0Acomplete -c useradd -s h -l help -d 'Display help message and exit'\0Acomplete -c useradd -s m -l create-home -d 'The user\\'s home directory will be created if it does not exist'\0Acomplete -c useradd -s n -d 'Create group with name of added user if -g is not specified'\0Acomplete -c useradd -s K -l key -d 'Overrides default key/value pairs from /etc/login'\0Acomplete -c useradd -s o -l non-unique -d 'Allow user account with a duplicate UID'\0Acomplete -c useradd -s p -l password -d 'The encrypted password, as returned by crypt(3)' -r\0Acomplete -c useradd -s u -l uid -d 'The numerical value of the user\\'s ID' -r\0Acomplete -c useradd -s b -l base-dir -d 'The initial path prefix for a new user\\'s home directory' -r -a '(__fish_complete_directories)'\0Acomplete -c useradd -s e -l expiredate -d 'The date on which the user account is disabled' -r\0Acomplete -c useradd -s f -l inactive -d 'Number of days to disable account after password expiration' -r\0Acomplete -c useradd -s g -l gid -d 'The group name or ID for a new user\\'s initial group' -x -a '(string match -r \22^[^#].*\22 < /etc/group | string split -f1,3 \22:\22 | string join \22:\22 | string replace -a \22:\22 \\n)'\0Acomplete -c useradd -s s -l shell -d 'Name of the new user\\'s login shell' -x -a '(string match -r \22^[^#].*\22 < /etc/shells; type -afp nologin)'\0A", align 1
