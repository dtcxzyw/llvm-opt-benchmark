@anon.1d0b41a8d45d477c3029ec78f9b8b434.3126 = private unnamed_addr constant [729 x i8] c"# Helper function for contextual autocompletion of gpg user ids\0A\0Afunction __fish_complete_gpg_user_id -d \22Complete using gpg user ids\22 -a __fish_complete_gpg_command list_arg\0A    # gpg doesn't seem to like it when you use the whole key name as a\0A    # completion, so we skip the <EMAIL> part and use it as a description.\0A    # It also replaces \\x3a from gpg's output with colons.\0A    #\0A    # TODO: I tried with <EMAIL> and it worked, this was possibly fixed in gpg.\0A    # Regardless, it's probably nicer as a description.\0A    set -q list_arg[1]; or set list_arg --list-keys\0A    $__fish_complete_gpg_command $list_arg --with-colon | string split -a -f 10 : | string replace '\\x3a' : | string replace -r '(.*) <(.*)>' '$1\\t$2'\0Aend\0A", align 1
