@anon.1d0b41a8d45d477c3029ec78f9b8b434.3008 = private unnamed_addr constant [7859 x i8] c"# Yarn 1.22.4\0A\0A__fish_npm_helper\0Aset -l yarn_add \22yarn global add\22\0A\0A# Typically there is no need to check if (commandline -ct) begins with `--`\0A# because it won't be matched. But we can prevent the slowdown from getting\0A# a list of all packages and filtering through it if we only do that when\0A# completing what seems to be a package name.\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from remove; and not __fish_is_switch' -xa '(__npm_installed_local_packages)'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add; and not __fish_is_switch' -xa \22(__npm_filtered_list_packages \\\22$yarn_add\\\22)\22\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a help -d 'Show available commands and flags'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a add -d 'Add packages'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add' -l dev -s D\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add' -l peer -s P\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add' -l O -s O\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add' -l exact -s E\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from add' -l tilde -s T\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a bin -d 'Show location of Yarn `bin` folder'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a cache -d 'Manage Yarn cache'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from cache' -a clean\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a config -d 'Manage Yarn configuration'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from config' -a 'set get delete list'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a exec -d 'Run binaries'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a info -d 'Show information about a package'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a init -d 'Interactively create or update `package.json`'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from init' -s y -l yes\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a install -d 'Install packages'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a link -d 'Symlink a package'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a list -d 'List installed packages'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from list' -l depth\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a node -d 'Run Node with the hook already setup'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a pack -d 'Create compressed archive of packages'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a remove -d 'Remove packages'\0Acomplete -f -c yarn -n __fish_use_subcommand -a run -d 'Run a defined package script'\0A\0Afunction __fish_yarn_run\0A    if test -e package.json; and set -l python (__fish_anypython)\0A        # Warning: That weird indentation is necessary, because python.\0A        $python -S -c 'import json, sys; data = json.load(sys.stdin);\0Afor k,v in data[\22scripts\22].items(): print(k + \22\\t\22 + v[:18])' <package.json 2>/dev/null\0A    else if test -e package.json; and type -q jq\0A        jq -r '.scripts | to_entries | map(\22\\(.key)\\t\\(.value | tostring | .[0:20])\22) | .[]' package.json\0A    else if type -q jq\0A        # Yarn is quite slow and still requires `jq` because the normal format is unusable.\0A        command yarn run --json 2>/dev/null | jq -r '.data.hints? | to_entries | map(\22\\(.key)\\t\\(.value | tostring |.[0:20])\22) | .[]'\0A    end\0Aend\0A\0A# Scripts can be used like normal subcommands, or with `yarn run SCRIPT`.\0Acomplete -c yarn -n '__fish_use_subcommand; or __fish_seen_subcommand_from run' -xa \22(__fish_yarn_run)\22\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a unlink -d 'Unlink a previously created symlink'\0Acomplete -f -c yarn -n __fish_use_subcommand -a unplug -d 'Force unpack packages'\0Acomplete -f -c yarn -n __fish_use_subcommand -a up -d 'Upgrade packages'\0Acomplete -f -c yarn -n __fish_use_subcommand -a upgrade-interactive -d 'Upgrade packages interactively'\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a version -d 'Update the package version'\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from version' -l new-version\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from version' -l message\0Acomplete -f -c yarn -n '__fish_seen_subcommand_from version' -l no-git-tag-version\0A\0Acomplete -f -c yarn -n __fish_use_subcommand -a why -d 'Show why a package is installed'\0Acomplete -f -c yarn -n __fish_use_subcommand -a workspace -d 'Manage workspace packages'\0Acomplete -f -c yarn -n __fish_use_subcommand -a workspaces -d 'Show workspaces information'\0A\0A# These are the yarn commands all of them use the same options\0Aset -g yarn_cmds add bin cache config exec info init install link node pack remove run unlink unplug up upgrade-interactive version why workspace workspaces\0A\0A# Common short, long options\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l help -s h -d 'output usage information'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l version -s V -d 'output the version number'\0A\0A# The rest of common options are all of them long\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l verbose -d 'output verbose messages on internal operations'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l offline -d 'trigger an error if any required dependencies are not available in local cache'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l prefer-offline -d 'use network only if dependencies are not available in local cache'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l strict-semver\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l json\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l ignore-scripts -d 'don\\'t run lifecycle scripts'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l har -d 'save HAR output of network traffic'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l ignore-platform -d 'ignore platform checks'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l ignore-engines -d 'ignore engines check'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l ignore-optional -d 'ignore optional dependencies'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l force -d 'ignore all caches'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l no-bin-links -d 'don\\'t generate bin links when setting up packages'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l flat -d 'only allow one version of a package'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l 'prod production'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l no-lockfile -d 'don\\'t read or generate a lockfile'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l pure-lockfile -d 'don\\'t generate a lockfile'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l frozen-lockfile -d 'don\\'t generate a lockfile and fail if an update is needed'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l global-folder\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l modules-folder -d 'install modules here instead of node_modules'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l cache-folder -d 'specify a custom folder to store the yarn cache'\0A\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l mutex -d 'use a mutex to ensure only one yarn instance is executing'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l mutex -a 'file network'\0A\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l no-emoji -d 'disable emoji in output'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l proxy\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l https-proxy\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l no-progress -d 'disable progress bar'\0Acomplete -c yarn -n '__fish_seen_subcommand_from $yarn_cmds' -l network-concurrency -d 'maximum number of concurrent network requests'\0A", align 1
