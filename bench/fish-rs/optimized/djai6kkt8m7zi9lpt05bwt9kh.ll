@anon.1d0b41a8d45d477c3029ec78f9b8b434.2724 = private unnamed_addr constant [2295 x i8] c"set -l commands status show set-time set-timezone list-timezones set-local-rtc set-ntp timesync-status show-timesync\0A\0Acomplete -c timedatectl -f\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a status -d 'Show current time settings'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a show -d 'Show properties of systemd-timedated'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a set-time -d 'Set system time'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a set-timezone -d 'Set system time zone'\0Acomplete -c timedatectl -n \22__fish_seen_subcommand_from set-timezone\22 -a \22(timedatectl list-timezones)\22\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a list-timezones -d 'Show known time zones'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a set-local-rtc -d 'Control whether RTC is in local time'\0Acomplete -c timedatectl -n \22__fish_seen_subcommand_from set-local-rtc\22 -a 'true false'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a set-ntp -d 'Control network time sync'\0Acomplete -c timedatectl -n \22__fish_seen_subcommand_from set-ntp\22 -a 'true false'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a timesync-status -d 'Show status of systemd-timesyncd'\0Acomplete -c timedatectl -n \22not __fish_seen_subcommand_from $commands\22 -a show-timesync -d 'Show properties of systemd-timesyncd'\0A\0Acomplete -c timedatectl -s h -l help -d 'Show this help message'\0Acomplete -c timedatectl -l version -d 'Show package version'\0Acomplete -c timedatectl -l no-pager -d 'Do not pipe output into a pager'\0Acomplete -c timedatectl -l no-ask-password -d 'Do not prompt for password'\0Acomplete -c timedatectl -s H -l host -r -d 'Operate on remote HOST'\0Acomplete -c timedatectl -s M -l machine -r -d 'Operate on local CONTAINER'\0Acomplete -c timedatectl -l adjust-system-clock -d 'Adjust system clock when changing local RTC mode'\0Acomplete -c timedatectl -l monitor -d 'Monitor status of systemd-timesyncd'\0Acomplete -c timedatectl -s p -l property -r -d 'Show only properties by this NAME'\0Acomplete -c timedatectl -s a -l all -d 'Show all properties'\0Acomplete -c timedatectl -l value -d 'Only show properties with values'\0A", align 1
