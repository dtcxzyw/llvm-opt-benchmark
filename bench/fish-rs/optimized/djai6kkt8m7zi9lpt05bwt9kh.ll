install -- (commandline -cxp)' -l mode -xa 'user system'\0A\0A#complete -c xdg-mime install [--mode mode] [--novendor] mimetypes-file\0A#complete -c xdg-mime uninstall [--mode mode] mimetypes-file\0Acomplete -c xdg-mime -l help -d 'Display help'\0Acomplete -c xdg-mime -l manual -d 'Display long help'\0Acomplete -c xdg-mime -l version -d 'Print version'\0A", align 1
