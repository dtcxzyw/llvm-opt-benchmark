@anon.1d0b41a8d45d477c3029ec78f9b8b434.2110 = private unnamed_addr constant [6358 x i8] c"# Sample output of 'mkvmerge -i file.mkv'\0A#\0A# File 'file.mkv': container: Matroska\0A# Track ID 0: video (MPEG-4p10/AVC/h.264)\0A# Track ID 1: audio (AAC)\0A# Track ID 2: subtitles (SubStationAlpha)\0A# Attachment ID 1: type 'application/x-truetype-font', size 53532 bytes, file name 'some_font.ttf'\0A# Chapters: 7 entries\0A\0Afunction __fish_mkvextract_get_mode\0A    set -l cmd (commandline -xpc)\0A    set -l skip_next 0\0A    for c in $cmd[2..-1]\0A        test $skip_next = 1; and set skip_next 0; and continue\0A        switch $c\0A            # All extraction modes\0A            case tracks tags attachments chapters cuesheet timecodes_v2 cues\0A                echo $c\0A                return 0\0A                # General flags that require an option - skip next argument\0A            case --ui-language --command-line-charset --output-charset -r --redirect-output --ui-language --debug --engage\0A                set skip_next 1\0A                # If any of these flags are present, all other args are ignored\0A            case -h --help -V --version --check-for-updates\0A                return 1\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_mkvextract_get_file\0A    set -l cmd (commandline -xpc)\0A    # Any invocation with a file specified will already have >= 2 args\0A    if not set -q cmd[3]\0A        return 1\0A    end\0A    if not set -l mode (__fish_mkvextract_get_mode)\0A        return 1\0A    end\0A    set -l skip_next 0\0A    # Files strictly appear after the mode specifier\0A    set -l mode_found 0\0A    for c in $cmd[2..-1]\0A        test $skip_next = 1; and set skip_next 0; and continue\0A        switch $c\0A            # We've found the mode specifier, now look for the file\0A            case $mode\0A                set mode_found 1\0A                # Track-specific flags can appear between mode specifier and file\0A            case --ui-language --command-line-charset --output-charset -r --redirect-output --ui-language --debug --engage -c --blockadd --simple-language\0A                set skip_next 1\0A                # These flags now need to be explicitly skipped\0A            case -f --parse-fully -v --verbose -q --quiet '@*' --cuesheet --raw --fullraw -s --simple --gui-mode\0A                continue\0A            case -h --help -V --version --check-for-updates\0A                return 1\0A            case '*'\0A                if test $mode_found = 1\0A                    echo -- $c\0A                    return 0\0A                end\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_mkvextract_using_mode\0A    set -l mode (__fish_mkvextract_get_mode)\0A    and set -l file (__fish_mkvextract_get_file)\0A    and contains -- $mode $argv\0Aend\0A\0Afunction __fish_mkvextract_print_attachments\0A    if set -l matroska (__fish_mkvextract_get_file)\0A        if set -l info (mkvmerge -i $matroska)\0A            string match 'Attachment ID*' -- $info | string replace -r '.*?(\\d+).*? type \\'(.*?)\\'.*?file name \\'(.*?)\\'' '$1:\\t$3 ($2)'\0A        end\0A    end\0Aend\0A\0Afunction __fish_mkvextract_print_tracks\0A    if set -l matroska (__fish_mkvextract_get_file)\0A        if set -l info (mkvmerge -i $matroska)\0A            string match 'Track ID*' -- $info | string replace -r '.*?(\\d+): (.*)' '$1:\\t$2'\0A        end\0A    end\0Aend\0A\0A# simple options\0Acomplete -f -c mkvextract -s V -l version -d 'Show version information'\0Acomplete -f -c mkvextract -s h -l help -d 'Show help'\0Acomplete -f -c mkvextract -l check-for-updates -d 'Check online for updates'\0A# extraction modes\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a tracks -d 'Extract tracks to external files'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a tags -d 'Extract tags as XML'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a attachments -d 'Extract attachments'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a chapters -d 'Extract chapters as XML'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a cuesheet -d 'Extract chapters and tags as CUE sheet'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a timecodes_v2 -d 'Extract timecodes of a track as timecode v2 file'\0Acomplete -f -c mkvextract -n 'not __fish_mkvextract_get_mode' -a cues -d 'Extract cue information as text file'\0A# tracks/attachments when appropriate\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks timecodes_v2 cues' -a '(__fish_mkvextract_print_tracks)'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode attachments' -a '(__fish_mkvextract_print_attachments)'\0A# these extraction modes have no parameters other than optional flags and the file\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tags chapters cuesheet'\0A# general flags\0Acomplete -c mkvextract -s f -l parse-fully -d 'Parse the whole file instead of relying on the index'\0Acomplete -c mkvextract -s v -l verbose -d 'Increase verbosity'\0Acomplete -c mkvextract -s q -l quiet -d 'Suppress status output'\0Acomplete -c mkvextract -r -l ui-language -d 'Force a locale'\0Acomplete -c mkvextract -r -l command-line-charset -d 'Charset for strings on the command line'\0Acomplete -c mkvextract -r -l output-charset -d 'Outputs messages in specified charset'\0Acomplete -c mkvextract -r -s r -l redirect-output -d 'Redirect all messages into a file'\0Acomplete -c mkvextract -r -l debug -d 'Turn on debugging for a specific feature'\0Acomplete -c mkvextract -r -l engage -d 'Turn on an experimental feature'\0Acomplete -c mkvextract -l gui-mode -d 'Enable GUI mode'\0A# mode-specific flags\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks' -r -s c -d 'Convert text subtitles to a charset'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks' -l cuesheet -d 'Also try to extract the CUE sheet'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks' -r -l blockadd -d 'Keep only the BlockAdditions up to the specified level'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks' -l raw -d 'Extract the data to a raw file'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode tracks' -l fullraw -d 'Extract the data to a raw file including the CodecPrivate as header'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode chapters' -s s -l simple -d 'Exports the chapter information in a simple format'\0Acomplete -f -c mkvextract -n '__fish_mkvextract_using_mode chapters' -r -l simple-language -d 'Uses the chapter names of the specified language'\0A", align 1
