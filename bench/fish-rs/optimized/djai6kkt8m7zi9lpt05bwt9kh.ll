@anon.1d0b41a8d45d477c3029ec78f9b8b434.1930 = private unnamed_addr constant [2157 x i8] c"# On Solaris, `killall` kills all processes. So we don't want to bother providing completion\0A# support on that OS.\0Aset -l OS (uname)\0Aif test \22$OS\22 = SunOS\0A    exit 0\0Aend\0A\0A__fish_make_completion_signals\0A\0Afor i in $__kill_signals\0A    set -l numname (string split \22 \22 -- $i)\0A    set -l number $numname[1]\0A    set -q numname[2]\0A    and set -l name $numname[2]\0A    complete -c killall -o $number -d $name\0A    complete -c killall -o $name -d $name\0A    # The `-s` flag doesn't work in OS X\0A    test \22$OS\22 != Darwin\0A    and complete -c killall -s s -x -a \22$number $name\22\0Aend\0A\0Acomplete -c killall -xa '(__fish_complete_proc | string replace -r -- \22^-\22 \22\22)'\0A\0Aif killall --version >/dev/null 2>/dev/null # GNU\0A    complete -c killall -s e -l exact -d 'Require an exact match for very long names'\0A    complete -c killall -s I -l ignore-case -d 'Do case insensitive process name match'\0A    complete -c killall -s g -l process-group -d 'Kill the process group to which the process belongs with one signal'\0A    complete -c killall -s i -l interactive -d 'Interactively ask for confirmation before killing'\0A    complete -c killall -s u -l user -x -a \22(__fish_complete_users)\22 -d 'Kill only processes the specified user owns. Command names are optional'\0A    complete -c killall -s w -l wait -d 'Wait for all killed processes to die'\0A    complete -c killall -s v -l version -d 'Print version'\0Aelse # probably BSD\0A    complete -c killall -s v -d 'Print what is done'\0A    complete -c killall -s e -d 'Use effective UID instead of the real UID for -u'\0A    complete -c killall -o help\0A    complete -c killall -s l -d 'List names of available signals'\0A    complete -c killall -s m -d 'Case sensitive process matching'\0A    complete -c killall -s s -d \22Simulate, send no signals\22\0A    complete -c killall -s d -d \22Simulate & summarize, send no signals\22\0A    complete -c killall -s u -x -a \22(__fish_complete_users)\22 -d \22kill given user's processes\22\0A    complete -c killall -s t -xa \22(ps a -o tty | sed 1d | uniq)\22 -d 'Limit to processes on specified TTY'\0A    complete -c killall -s c -x -d 'Limit to processes matching pattern'\0A    complete -c killall -s z -d \22Don't skip zombies\22\0Aend\0A", align 1
