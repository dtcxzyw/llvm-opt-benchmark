@anon.1d0b41a8d45d477c3029ec78f9b8b434.3000 = private unnamed_addr constant [2807 x i8] c"complete -c xz -s z -l compress -d Compress\0Acomplete -c xz -s d -l decompress -l uncompress -d Decompress -k -x -a \22(__fish_complete_suffix .xz .txz .lzma .tlz)\22\0A\0Acomplete -c xz -s t -l test -d 'Test the integrity of compressed files'\0Acomplete -c xz -s l -l list -d 'Print information about compressed files'\0Acomplete -c xz -s k -l keep -d 'Don\\'t delete the input files'\0Acomplete -c xz -s f -l force\0Acomplete -c xz -s c -l stdout -l to-stdout -d 'Write to stdout instead of file'\0Acomplete -c xz -l single-stream -d 'Decompress only the first .xz stream'\0Acomplete -c xz -l no-sparse -d 'Disable creation of sparse files'\0Acomplete -c xz -s S -l suffix -d 'Use SUFFIX as the suffix for target file'\0Acomplete -c xz -l files -d 'Read the filenames to process from file' -r\0Acomplete -c xz -l files0 -d 'Identical to --files but filenames terminate with \\\\0' -r\0Acomplete -c xz -s F -l format -x -d 'Specify file format to compress/decompress' -a \22auto xz lzma alone raw\22\0Acomplete -c xz -s C -l check -x -d 'Specify type of integrity check' -a \22none crc32 crc64 sha256\22\0Acomplete -c xz -l ignore-check -d 'Don\\'t verify the integrity check'\0A\0Afor level in (seq 1 9)\0A    complete -c xz -s $level -d \22Select compression level\22\0Aend\0A\0Acomplete -c xz -s e -l extreme -d 'Use slower variant'\0Acomplete -c xz -l fast -d 'Alias of -0'\0Acomplete -c xz -l best -d 'Alias of -9'\0Acomplete -c xz -l block-size -d 'Set block size' -x\0Acomplete -c xz -l block-list -d 'Set block sizes list' -x\0Acomplete -c xz -l flush-timeout -d 'Force flush if encoder did not fush after TIMEOUT ms' -x\0Acomplete -c xz -l memlimit-compress -d 'Set memory usage limit for compression' -x\0Acomplete -c xz -l memlimit-decompress -d 'Set memory usage limit for decompression' -x\0Acomplete -c xz -s M -l memlimit -l memory -d 'Set a memory usage for compression/decompression'\0Acomplete -c xz -l no-adjust -d 'Display error and exit if exceed memory usage limit'\0Acomplete -c xz -s T -l threads -d 'Specify the number of worker threads to use' -x\0Acomplete -c xz -l lsam1 -d 'Add LZMA1 filter to filter chain' -f\0Acomplete -c xz -l lzma2 -d 'Add LZMA2 filter to filter chain' -f\0A\0Afor op in x86 powerpc ia64 arm armthumb sparc\0A    complete -c xz -l $op -d 'Add a branch/call/jump filter to filter chain' -f\0Aend\0A\0Acomplete -c xz -l delta -d 'Add Delta filter to filter chain'\0Acomplete -c xz -s q -l quiet -d 'Suppress warnings/notices'\0Acomplete -c xz -s v -l verbose -d 'Be verbose'\0Acomplete -c xz -s Q -l no-warn -d 'Don\\'t set the exit status to 2'\0Acomplete -c xz -l robot -d 'Print messages in a machine-parsable format'\0Acomplete -c xz -l info-memory -d 'Display memory informations (physical, usage limits)'\0Acomplete -c xz -s h -l help -d 'Display help'\0Acomplete -c xz -s H -l long-help -d 'Display long help'\0Acomplete -c xz -s V -l version -d 'Display version'\0A", align 1
