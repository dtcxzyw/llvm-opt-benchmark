@anon.1d0b41a8d45d477c3029ec78f9b8b434.1774 = private unnamed_addr constant [2077 x i8] c"# grub-mkrescue makes GRUB CD-ROM, disk, pendrive and floppy bootable image.\0A\0Acomplete -c grub-mkrescue -l compress -a 'no\\tNo\\ compression xz\\tXZ gz\\tGZ lzo\\tLZO' -x -d \22Compress GRUB files\22\0Acomplete -c grub-mkrescue -l dtb -r -d \22Embed a specific DTB\22\0Acomplete -c grub-mkrescue -l directory -s d -r -d \22Use images and modules under given directory\22\0Acomplete -c grub-mkrescue -l fonts -r -d \22Install given fonts\22\0Acomplete -c grub-mkrescue -l install-modules -r -d \22Install only the given modules\22\0Acomplete -c grub-mkrescue -l pubkey -s k -r -d \22Embed given file as public key for signature checking\22\0Acomplete -c grub-mkrescue -l locale-directory -r -d \22Use translation under given directory\22\0Acomplete -c grub-mkrescue -l locales -r -d \22Install only given locales\22\0Acomplete -c grub-mkrescue -l modules -r -d \22Pre-load specified modules\22\0Acomplete -c grub-mkrescue -l theme -r -d \22Install given theme\22\0Acomplete -c grub-mkrescue -l verbose -s v -d \22Print verbose messages\22\0Acomplete -c grub-mkrescue -l arcs-boot -d \22Enable ARCS boot\22\0Acomplete -c grub-mkrescue -l core-compress -x -a 'xz\\tXZ\\ compression none\\tNo\\ compression auto\\tAuto' -d \22Choose compression to use for core image\22\0Acomplete -c grub-mkrescue -l label-gbcolor -x -d \22Use given color for label background\22\0Acomplete -c grub-mkrescue -l label-color -x -d \22Use given color for label\22\0Acomplete -c grub-mkrescue -l label-font -r -d \22Use given file font for label\22\0Acomplete -c grub-mkrescue -l output -s o -r -d \22Save output in given file\22\0Acomplete -c grub-mkrescue -l product-name -x -d \22Use given string as product name\22\0Acomplete -c grub-mkrescue -l product-version -x -d \22Use given string as product version\22\0Acomplete -c grub-mkrescue -l rom-directory -r -d \22Save ROM image in given directory\22\0Acomplete -c grub-mkrescue -l sparc-boot -d \22Enable sparc boot\22\0Acomplete -c grub-mkrescue -l xorriso -r -d \22Use given file as xorriso\22\0Acomplete -c grub-mkrescue -l help -s '?' -d \22Show help\22\0Acomplete -c grub-mkrescue -l usage -d \22Show short usage message\22\0Acomplete -c grub-mkrescue -l version -s V -d \22Show program version\22\0A", align 1
