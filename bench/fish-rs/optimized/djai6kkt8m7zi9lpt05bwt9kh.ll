@anon.1d0b41a8d45d477c3029ec78f9b8b434.2738 = private unnamed_addr constant [6253 x i8] c"set -l _sub_commands 'login login_cli activate logout auth tui whoami whois notifications instance search thread timeline post upload delete favourite unfavourite reblog unreblog reblogged_by pin unpin follow unfollow mute unmute block unblock'\0A\0Afunction __fish_complete_toot_accounts\0A    toot auth | awk '/^\\*/{print $2}'\0Aend\0A\0A# No file completion for most subcomands\0Acomplete -c toot -f\0A\0A# # Subcommands\0Acomplete -c toot -a activate -n __fish_is_first_token -d 'Switch between accounts.'\0Acomplete -c toot -a auth -n __fish_is_first_token -d 'Show logged in accounts and instances'\0Acomplete -c toot -a instance -n __fish_is_first_token -d 'Display instance details'\0Acomplete -c toot -a login -n __fish_is_first_token -d 'Log in using your browser'\0Acomplete -c toot -a login_cli -n __fish_is_first_token -d 'Log in from the console'\0Acomplete -c toot -a logout -n __fish_is_first_token -d 'Log out'\0Acomplete -c toot -a notifications -n __fish_is_first_token -d 'Show notifications'\0Acomplete -c toot -a post -n __fish_is_first_token -d 'Post a status text'\0Acomplete -c toot -a search -n __fish_is_first_token -d 'Search for users or hashtags'\0Acomplete -c toot -a thread -n __fish_is_first_token -d 'Show toot thread items'\0Acomplete -c toot -a timeline -n __fish_is_first_token -d 'Show recent items'\0Acomplete -c toot -a tui -n __fish_is_first_token -d 'Toot terminal user interface'\0Acomplete -c toot -a upload -n __fish_is_first_token -d 'Upload a file'\0Acomplete -c toot -a whoami -n __fish_is_first_token -d 'Display user details'\0Acomplete -c toot -a whois -n __fish_is_first_token -d 'Display account details'\0Acomplete -c toot -a delete -n __fish_is_first_token -d 'Delete a status'\0Acomplete -c toot -a favourite -n __fish_is_first_token -d 'Favourite a status'\0Acomplete -c toot -a pin -n __fish_is_first_token -d 'Pin a status'\0Acomplete -c toot -a reblog -n __fish_is_first_token -d 'Reblog a status'\0Acomplete -c toot -a reblogged_by -n __fish_is_first_token -d 'Show rebloggers of status'\0Acomplete -c toot -a unfavourite -n __fish_is_first_token -d 'Unfavourite a status'\0Acomplete -c toot -a unpin -n __fish_is_first_token -d 'Unpin a status'\0Acomplete -c toot -a unreblog -n __fish_is_first_token -d 'Unreblog a status'\0A\0A# Accounts\0Acomplete -c toot -a follow -n __fish_is_first_token -d 'Follow an account'\0Acomplete -c toot -a unfollow -n __fish_is_first_token -d 'Unfollow an account'\0Acomplete -c toot -a mute -n __fish_is_first_token -d 'Mute an account'\0Acomplete -c toot -a unmute -n __fish_is_first_token -d 'Unmute an account'\0Acomplete -c toot -a block -n __fish_is_first_token -d 'Block an account'\0Acomplete -c toot -a unblock -n __fish_is_first_token -d 'Unblock an account'\0A\0A# Parameters common to all subcommands\0Acomplete -c toot -n \22__fish_seen_subcommand_from $_sub_commands\22 -l debug -d 'show debug log'\0Acomplete -c toot -n \22__fish_seen_subcommand_from $_sub_commands\22 -l no-color -d \22no colors in output\22\0Acomplete -c toot -n \22__fish_seen_subcommand_from $_sub_commands\22 -l quiet -d \22don't write to stdout on success\22\0Acomplete -c toot -n \22__fish_seen_subcommand_from $_sub_commands\22 -s h -l help -d 'show help message'\0A\0A# Parameters common to some subcommands\0Acomplete -c toot -n '__fish_seen_subcommand_from activate logout' -a \22(__fish_complete_toot_accounts)\22\0Acomplete -c toot -n '__fish_seen_subcommand_from login login_cli instance' -l disable-https -d 'disable HTTPS'\0Acomplete -c toot -n '__fish_seen_subcommand_from login login_cli timeline' -s i -l instance -x -d 'mastodon instance'\0Acomplete -c toot -n '__fish_seen_subcommand_from tui whoami whois notifications search thread timeline post upload delete favourite unfavourite reblog unreblog pin unpin follow unfollow mute unmute block unblock' -s u -l using -x -a \22(__fish_complete_toot_accounts)\22 -d 'account to use'\0Acomplete -c toot -n '__fish_seen_subcommand_from notifications timeline' -s r -l reverse -x -d 'reverse order of output'\0Acomplete -c toot -n '__fish_seen_subcommand_from post upload' -s d -l description -x -d 'alt text for media file'\0A\0A# Parameters for login_cli\0Acomplete -c toot -n '__fish_seen_subcommand_from login_cli' -s e -l email -x -d 'email address'\0A\0A# Parameters for notifications\0Acomplete -c toot -n '__fish_seen_subcommand_from notifications' -l clear -d 'delete all notifications'\0Acomplete -c toot -n '__fish_seen_subcommand_from notifications' -s m -l mentions -x -d 'only print mentions'\0A\0A# Parameters for search\0Acomplete -c toot -n '__fish_seen_subcommand_from search' -s r -l resolve -x -d 'resolve non-local accounts'\0A\0A# Parameters for timeline\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -s p -l public -d 'show public timeline'\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -s t -l tag -x -d 'show hastag timeline'\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -s l -l local -d 'show only statuses from local instance'\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -l list -x -d 'show timeline for given list'\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -s c -l count -x -d 'number of toots per page'\0Acomplete -c toot -n '__fish_seen_subcommand_from timeline' -s 1 -l once -d 'do not prompt to continue'\0A\0A# Parameters for post\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s m -l media -r -F -d 'path to the media file'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s v -l visibility -x -d 'post visibility' -a 'public unlisted private direct'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s s -l sensitive -d 'mark as NSFW'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s p -l spoiler-text -x -d 'warning text before content'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s r -l reply-to -x -d 'ID of the status to reply to'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s l -l language -x -d 'language code of the toot'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s e -l editor -x -d 'editor to compose toot'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -l scheduled-at -x -d 'datetime at which to schedule'\0Acomplete -c toot -n '__fish_seen_subcommand_from post' -s t -l content-type -x -d 'MIME type'\0A\0A# Parameters for upload\0Acomplete -c toot -n '__fish_seen_subcommand_from upload' -F\0A", align 1
