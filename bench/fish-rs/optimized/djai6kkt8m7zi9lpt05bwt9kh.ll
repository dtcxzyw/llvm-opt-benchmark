@anon.1d0b41a8d45d477c3029ec78f9b8b434.3446 = private unnamed_addr constant [820 x i8] c"function fish_greeting\0A    if not set -q fish_greeting\0A        set -l line1 (_ 'Welcome to fish, the friendly interactive shell')\0A        set -l line2 \\n(printf (_ 'Type %shelp%s for instructions on how to use fish') (set_color green) (set_color normal))\0A        set -g fish_greeting \22$line1$line2\22\0A    end\0A\0A    if set -q fish_private_mode\0A        set -l line (_ \22fish is running in private mode, history will not be persisted.\22)\0A        if set -q fish_greeting[1]\0A            set -g fish_greeting $fish_greeting\\n$line\0A        else\0A            set -g fish_greeting $line\0A        end\0A    end\0A\0A    # The greeting used to be skipped when fish_greeting was empty (not just undefined)\0A    # Keep it that way to not print superfluous newlines on old configuration\0A    test -n \22$fish_greeting\22\0A    and echo $fish_greeting\0Aend\0A", align 1
