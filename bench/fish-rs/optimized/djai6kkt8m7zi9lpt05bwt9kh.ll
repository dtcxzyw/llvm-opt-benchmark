@anon.1d0b41a8d45d477c3029ec78f9b8b434.2674 = private unnamed_addr constant [3801 x i8] c"# Completions for sv\0A# A part of the runit init system\0A# Author: Leonardo da Rosa Eug\C3\AAnio <lelgenio@disroot.org>\0A\0Aset -l commands \\\0A    status up down once s u d o pause cont hup \\\0A    alarm interrupt quit 1 2 term kill exit p c h \\\0A    a i q 1 2 t k e start stop reload restart \\\0A    shutdown force-stop force-reload force-restart force-shutdown \\\0A    try-restart check\0A\0Afunction __fish_complete_sv_list_services\0A    set -l svdir (path filter -d -- $SVDIR  \\\0A        /run/runit/runsvdir/current \\\0A        /run/runit/service \\\0A        /etc/services \\\0A        /services)\0A    set -q svdir[1]; or return\0A    set -l services (path basename -- $svdir[1]/*)\0A    set -l sv_status (sv status $services 2>/dev/null |\0A                      string replace -ar ';.*$' '')\0A    and string replace -r \22^(\\w+: )(.*?):\22 '$2\\t$1' $sv_status\0A    or printf \22%s\\n\22 $services\0Aend\0A\0Acomplete -f -c sv -a \22(__fish_complete_sv_list_services)\22 -n \22__fish_seen_subcommand_from $commands\22\0A\0Acomplete -fc sv -s v -d \22Report status for up, down, term, once, cont, and exit\22\0Acomplete -fc sv -s w -d \22Override the default timeout to report status\22\0A\0Aset -l no_comm \22not __fish_seen_subcommand_from $commands\22\0A\0Acomplete -kfc sv -n $no_comm -a check -d \22Check if the service is in it's requested state\22\0Acomplete -kfc sv -n $no_comm -a try-restart -d \22Run term, cont, and  up, report status\22\0Acomplete -kfc sv -n $no_comm -a force-shutdown -d \22Run exit, report status or kill on timeout\22\0Acomplete -kfc sv -n $no_comm -a force-restart -d \22Run term, cont and up, report status\22\0Acomplete -kfc sv -n $no_comm -a force-reload -d \22Run term and  cont, report status\22\0Acomplete -kfc sv -n $no_comm -a force-stop -d \22Run down, report status or kill on timeout\22\0Acomplete -kfc sv -n $no_comm -a shutdown -d \22Run exit, report status\22\0Acomplete -kfc sv -n $no_comm -a restart -d \22Run term, cont, and  up, report status using ./check\22\0Acomplete -kfc sv -n $no_comm -a reload -d \22Run hup, report status\22\0Acomplete -kfc sv -n $no_comm -a stop -d \22Run down, report status\22\0Acomplete -kfc sv -n $no_comm -a start -d \22Run up, report status\22\0A\0Acomplete -kfc sv -n $no_comm -a e -d \22Alias for exit\22\0Acomplete -kfc sv -n $no_comm -a k -d \22Alias for kill\22\0Acomplete -kfc sv -n $no_comm -a t -d \22Alias for term\22\0Acomplete -kfc sv -n $no_comm -a 2 -d \22Alias for 2\22\0Acomplete -kfc sv -n $no_comm -a 1 -d \22Alias for 1\22\0Acomplete -kfc sv -n $no_comm -a q -d \22Alias for quit\22\0Acomplete -kfc sv -n $no_comm -a i -d \22Alias for interrupt\22\0Acomplete -kfc sv -n $no_comm -a a -d \22Alias for alarm\22\0Acomplete -kfc sv -n $no_comm -a h -d \22Alias for hup\22\0Acomplete -kfc sv -n $no_comm -a c -d \22Alias for cont\22\0Acomplete -kfc sv -n $no_comm -a p -d \22Alias for pause\22\0Acomplete -kfc sv -n $no_comm -a exit -d \22Send TERM, and CONT, report status\22\0Acomplete -kfc sv -n $no_comm -a kill -d \22Send SIGKILL\22\0Acomplete -kfc sv -n $no_comm -a term -d \22Send SIGTERM\22\0Acomplete -kfc sv -n $no_comm -a 2 -d \22Send SIGUSR2\22\0Acomplete -kfc sv -n $no_comm -a 1 -d \22Send SIGUSR1\22\0Acomplete -kfc sv -n $no_comm -a quit -d \22Send SIGQUIT\22\0Acomplete -kfc sv -n $no_comm -a interrupt -d \22Send SIGINT\22\0Acomplete -kfc sv -n $no_comm -a alarm -d \22Send SIGALRM\22\0Acomplete -kfc sv -n $no_comm -a hup -d \22Send SIGHUP\22\0Acomplete -kfc sv -n $no_comm -a cont -d \22Send SIGCONT\22\0Acomplete -kfc sv -n $no_comm -a pause -d \22Send SIGSTOP\22\0A\0Acomplete -kfc sv -n $no_comm -a o -d \22Alias for once\22\0Acomplete -kfc sv -n $no_comm -a d -d \22Alias for down\22\0Acomplete -kfc sv -n $no_comm -a u -d \22Alias for up\22\0Acomplete -kfc sv -n $no_comm -a s -d \22Alias for status\22\0Acomplete -kfc sv -n $no_comm -a once -d \22Start service, but don't restart it\22\0Acomplete -kfc sv -n $no_comm -a down -d \22Send it the TERM signal\22\0Acomplete -kfc sv -n $no_comm -a up -d \22Start a service\22\0Acomplete -kfc sv -n $no_comm -a status -d \22Report the current status of the service\22\0A", align 1
