@anon.1d0b41a8d45d477c3029ec78f9b8b434.2258 = private unnamed_addr constant [3107 x i8] c"complete -x -c optipng\0Acomplete -x -c optipng -n '__fish_should_complete_switches; and __fish_is_first_arg' -a '-?\\t\22show help\22'\0Acomplete -x -c optipng -n '__fish_should_complete_switches; and __fish_is_first_arg' -a '-h\\t\22show help\22'\0Acomplete -x -c optipng -n '__fish_should_complete_switches; and __fish_is_first_arg' -a '-help\\t\22show help\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-v\\t\22run in verbose mode\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-backup\\t\22keep a backup of the modified files\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-keep\\t\22keep a backup of the modified files\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-clobber\\t\22overwrite existing files\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-fix\\t\22enable error recovery\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-force\\t\22enforce writing of a new output file\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-preserve\\t\22preserve file attributes if possible\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-quiet\\t\22run in quiet mode\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-silent\\t\22run in quiet mode\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-simulate\\t\22run in simulation mode\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-full\\t\22produce a full IDAT report (might reduce speed)\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-nb\\t\22no bit depth reduction\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-nc\\t\22no color type reduction\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-np\\t\22no palette reduction\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-nx\\t\22no reductions\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-nz\\t\22no IDAT recoding\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-snip\\t\22cut one image out of multi-image or animation files\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-strip\\t\22strip specified metadata objects (e.g. \22all\22)\22'\0A\0Afor n in (seq 0 9)\0A    complete -x -c optipng -n __fish_should_complete_switches -a \22-o$n\\t\\\22PNG optimization level $n\\\22\22\0Aend\0A\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-i0\\t\22PNG interlace type 0\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-i1\\t\22PNG interlace type 1\22'\0A\0Afor n in (seq 0 5)\0A    complete -x -c optipng -n __fish_should_complete_switches -a \22-f$n\\t'PNG delta filters $n'\22\0Aend\0A\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-out\\t\22write output file to <file>\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-dir\\t\22write output file(s) to <directory>\22'\0Acomplete -x -c optipng -n __fish_should_complete_switches -a '-log\\t\22log messages to <file>\22'\0A\0Acomplete -x -c optipng -n 'not __fish_prev_arg_in -out -dir -log' \\\0A    -k -a '(__fish_complete_suffix .png .pnm .tiff .bmp)'\0A\0Acomplete -x -c optipng -n '__fish_prev_arg_in -dir' -a '(__fish_complete_directories)'\0A", align 1
