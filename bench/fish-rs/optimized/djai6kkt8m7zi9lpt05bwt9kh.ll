@anon.1d0b41a8d45d477c3029ec78f9b8b434.3070 = private unnamed_addr constant [9013 x i8] c"# This file does some internal fish setup.\0A# It is not recommended to remove or edit it.\0A#\0A# Set default field separators\0A#\0Aset -g IFS \\n\\ \\t\0Aset -qg __fish_added_user_paths\0Aor set -g __fish_added_user_paths\0A\0A#\0A# Create the default command_not_found handler\0A#\0Afunction __fish_default_command_not_found_handler\0A    printf (_ \22fish: Unknown command: %s\\n\22) (string escape -- $argv[1]) >&2\0Aend\0A\0Aif not status --is-interactive\0A    # Hook up the default as the command_not_found handler\0A    # if we are not interactive to avoid custom handlers.\0A    function fish_command_not_found --on-event fish_command_not_found\0A        __fish_default_command_not_found_handler $argv\0A    end\0Aend\0A\0A#\0A# Set default search paths for completions and shellscript functions\0A# unless they already exist\0A#\0A\0A# __fish_data_dir, __fish_sysconf_dir, __fish_help_dir, __fish_bin_dir\0A# are expected to have been set up by read_init from fish.cpp\0A\0A# Grab extra directories (as specified by the build process, usually for\0A# third-party packages to ship completions &c.\0Aset -l __extra_completionsdir\0Aset -l __extra_functionsdir\0Aset -l __extra_confdir\0Aif path is -f -- $__fish_data_dir/__fish_build_paths.fish\0A    source $__fish_data_dir/__fish_build_paths.fish\0Aend\0A\0A# Compute the directories for vendor configuration.  We want to include\0A# all of XDG_DATA_DIRS, as well as the __extra_* dirs defined above.\0Aset -l xdg_data_dirs\0Aif set -q XDG_DATA_DIRS\0A    set --path xdg_data_dirs $XDG_DATA_DIRS\0A    set xdg_data_dirs (string replace -r '([^/])/$' '$1' -- $xdg_data_dirs)/fish\0Aelse\0A    set xdg_data_dirs $__fish_data_dir\0Aend\0A\0Aset -g __fish_vendor_completionsdirs\0Aset -g __fish_vendor_functionsdirs\0Aset -g __fish_vendor_confdirs\0A# Don't load vendor directories when running unit tests\0Aif not set -q FISH_UNIT_TESTS_RUNNING\0A    set __fish_vendor_completionsdirs $__fish_user_data_dir/vendor_completions.d $xdg_data_dirs/vendor_completions.d\0A    set __fish_vendor_functionsdirs $__fish_user_data_dir/vendor_functions.d $xdg_data_dirs/vendor_functions.d\0A    set __fish_vendor_confdirs $__fish_user_data_dir/vendor_conf.d $xdg_data_dirs/vendor_conf.d\0A\0A    # Ensure that extra directories are always included.\0A    if not contains -- $__extra_completionsdir $__fish_vendor_completionsdirs\0A        set -a __fish_vendor_completionsdirs $__extra_completionsdir\0A    end\0A    if not contains -- $__extra_functionsdir $__fish_vendor_functionsdirs\0A        set -a __fish_vendor_functionsdirs $__extra_functionsdir\0A    end\0A    if not contains -- $__extra_confdir $__fish_vendor_confdirs\0A        set -a __fish_vendor_confdirs $__extra_confdir\0A    end\0Aend\0A\0A# Set up function and completion paths. Make sure that the fish\0A# default functions/completions are included in the respective path.\0A\0Aif not set -q fish_function_path\0A    set fish_function_path $__fish_config_dir/functions $__fish_sysconf_dir/functions $__fish_vendor_functionsdirs $__fish_data_dir/functions\0Aelse if not contains -- $__fish_data_dir/functions $fish_function_path\0A    set -a fish_function_path $__fish_data_dir/functions\0Aend\0A\0Aif not set -q fish_complete_path\0A    set fish_complete_path $__fish_config_dir/completions $__fish_sysconf_dir/completions $__fish_vendor_completionsdirs $__fish_data_dir/completions $__fish_cache_dir/generated_completions\0Aelse if not contains -- $__fish_data_dir/completions $fish_complete_path\0A    set -a fish_complete_path $__fish_data_dir/completions\0Aend\0A\0A# Add a handler for when fish_user_path changes, so we can apply the same changes to PATH\0Afunction __fish_reconstruct_path -d \22Update PATH when fish_user_paths changes\22 --on-variable fish_user_paths\0A    # Deduplicate $fish_user_paths\0A    # This should help with people appending to it in config.fish\0A    set -l new_user_path\0A    for path in (string split : -- $fish_user_paths)\0A        if not contains -- $path $new_user_path\0A            set -a new_user_path $path\0A        end\0A    end\0A\0A    if test (count $new_user_path) -lt (count $fish_user_paths)\0A        # This will end up calling us again, so we return\0A        set fish_user_paths $new_user_path\0A        return\0A    end\0A\0A    set -l local_path $PATH\0A\0A    for x in $__fish_added_user_paths\0A        set -l idx (contains --index -- $x $local_path)\0A        and set -e local_path[$idx]\0A    end\0A\0A    set -g __fish_added_user_paths\0A    if set -q fish_user_paths\0A        # Explicitly split on \22:\22 because $fish_user_paths might not be a path variable,\0A        # but $PATH definitely is.\0A        for x in (string split \22:\22 -- $fish_user_paths[-1..1])\0A            if set -l idx (contains --index -- $x $local_path)\0A                set -e local_path[$idx]\0A            else\0A                set -ga __fish_added_user_paths $x\0A            end\0A            set -p local_path $x\0A        end\0A    end\0A\0A    set -xg PATH $local_path\0Aend\0A\0A#\0A# Launch debugger on SIGTRAP\0A#\0Afunction fish_sigtrap_handler --on-signal TRAP --no-scope-shadowing --description \22TRAP handler: debug prompt\22\0A    breakpoint\0Aend\0A\0A#\0A# When a prompt is first displayed, make sure that interactive\0A# mode-specific initializations have been performed.\0A# This includes a `read` prompt, hence the fish_read event.\0A# This handler removes itself after it is first called.\0A#\0Afunction __fish_on_interactive --on-event fish_prompt --on-event fish_read\0A    # We erase this *first* so it can't be called again,\0A    # e.g. if fish_greeting calls \22read\22.\0A    functions -e __fish_on_interactive\0A    __fish_config_interactive\0Aend\0A\0A# Set the locale if it isn't explicitly set. Allowing the lack of locale env vars to imply the\0A# C/POSIX locale causes too many problems. Do this before reading the snippets because they might be\0A# in UTF-8 (with non-ASCII characters).\0Anot set -q LANG # (fast path - no need to load the file if we have $LANG)\0Aand __fish_set_locale\0A\0A#\0A# Some things should only be done for login terminals\0A# This used to be in etc/config.fish - keep it here to keep the semantics\0A#\0Aif status --is-login\0A    if command -sq /usr/libexec/path_helper\0A        # Adapt construct_path from the macOS /usr/libexec/path_helper\0A        # executable for fish; see\0A        # https://opensource.apple.com/source/shell_cmds/shell_cmds-203/path_helper/path_helper.c.auto.html .\0A        function __fish_macos_set_env -d \22set an environment variable like path_helper does (macOS only)\22\0A            set -l result\0A\0A            # Populate path according to config files\0A            for path_file in $argv[2] $argv[3]/*\0A                for entry in (string split : <? $path_file)\0A                    if not contains -- $entry $result\0A                        test -n \22$entry\22\0A                        and set -a result $entry\0A                    end\0A                end\0A            end\0A\0A            # Merge in any existing path elements\0A            for existing_entry in $$argv[1]\0A                if not contains -- $existing_entry $result\0A                    set -a result $existing_entry\0A                end\0A            end\0A\0A            set -xg $argv[1] $result\0A        end\0A\0A        __fish_macos_set_env PATH /etc/paths '/etc/paths.d'\0A        if test -n \22$MANPATH\22\0A            __fish_macos_set_env MANPATH /etc/manpaths '/etc/manpaths.d'\0A        end\0A        functions -e __fish_macos_set_env\0A    end\0A\0A    #\0A    # Put linux consoles in unicode mode.\0A    #\0A    if test \22$TERM\22 = linux\0A        and string match -qir '\\.UTF' -- $LANG\0A        and command -sq unicode_start\0A        unicode_start\0A    end\0Aend\0A\0A# Invoke this here to apply the current value of fish_user_path after\0A# PATH is possibly set above.\0A__fish_reconstruct_path\0A\0A# Allow %n job expansion to be used with fg/bg/wait\0A# `jobs` is the only one that natively supports job expansion\0Afunction __fish_expand_pid_args\0A    for arg in $argv\0A        if string match -qr '^%\\d+$' -- $arg\0A            if not jobs -p $arg\0A                return 1\0A            end\0A        else\0A            printf \22%s\\n\22 $arg\0A        end\0A    end\0Aend\0A\0Afor jobbltn in bg wait disown\0A    function $jobbltn -V jobbltn\0A        set -l args (__fish_expand_pid_args $argv)\0A        and builtin $jobbltn $args\0A    end\0Aend\0Afunction fg\0A    set -l args (__fish_expand_pid_args $argv)\0A    and builtin fg $args[-1]\0Aend\0A\0Aif command -q kill\0A    # Only define this if something to wrap exists\0A    # this allows a nice \22command not found\22 error to be triggered.\0A    function kill\0A        set -l args (__fish_expand_pid_args $argv)\0A        and command kill $args\0A    end\0Aend\0A\0A# As last part of initialization, source the conf directories.\0A# Implement precedence (User > Admin > Extra (e.g. vendors) > Fish) by basically doing \22basename\22.\0Aset -l sourcelist\0Afor file in $__fish_config_dir/conf.d/*.fish $__fish_sysconf_dir/conf.d/*.fish $__fish_vendor_confdirs/*.fish\0A    set -l basename (string replace -r '^.*/' '' -- $file)\0A    contains -- $basename $sourcelist\0A    and continue\0A    set sourcelist $sourcelist $basename\0A    # Also skip non-files or unreadable files.\0A    # This allows one to use e.g. symlinks to /dev/null to \22mask\22 something (like in systemd).\0A    test -f $file -a -r $file\0A    and source $file\0Aend\0A", align 1
