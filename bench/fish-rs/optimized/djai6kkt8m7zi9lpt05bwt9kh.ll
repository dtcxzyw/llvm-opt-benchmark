yzer -l method -d 'Specifies the method name to print'\0A\0Acomplete -n \22__fish_seen_subcommand_from dex; and __fish_seen_subcommand_from $dex_subcommands\22 -c apkanalyzer -ka '(__fish_complete_suffix .apk)'\0Acomplete -n '__fish_seen_subcommand_from dex; and __fish_seen_subcommand_from code' -c apkanalyzer -ka '(__fish_complete_suffix .class)'\0A\0A# resources \0Acomplete -f -n \22__fish_seen_subcommand_from resources; and not __fish_seen_subcommand_from $resources_subcommands\22 -c apkanalyzer -a packages -d 'Prints a list of the packages that are defined in the resources table'\0Acomplete -f -n \22__fish_seen_subcommand_from resources; and not __fish_seen_subcommand_from $resources_subcommands\22 -c apkanalyzer -a configs -d 'Prints a list of configurations for the specified type'\0Acomplete -f -n \22__fish_seen_subcommand_from resources; and not __fish_seen_subcommand_from $resources_subcommands\22 -c apkanalyzer -a value -d 'Prints the value of the resource specified by config, name, and type'\0Acomplete -f -n \22__fish_seen_subcommand_from resources; and not __fish_seen_subcommand_from $resources_subcommands\22 -c apkanalyzer -a names -d 'Prints a list of resource names for a configuration and type'\0Acomplete -f -n \22__fish_seen_subcommand_from resources; and not __fish_seen_subcommand_from $resources_subcommands\22 -c apkanalyzer -a xml -d 'Prints the human-readable form of a binary XML file'\0A# resources options\0Acomplete -n '__fish_seen_subcommand_from resources; and __fish_seen_subcommand_from configs' -c apkanalyzer -l type -d 'Specifies the resource type to print' -r\0Acomplete -n '__fish_seen_subcommand_from resources; and __fish_seen_subcommand_from configs' -c apkanalyzer -l packages -d 'Specifies the packages to print' -r\0Acomplete -n '__fish_seen_subcommand_from resources; and __fish_seen_subcommand_from value' -c apkanalyzer -l config -d 'Specifies the configuration to print' -r\0Acomplete -n '__fish_seen_subcommand_from resources; and __fi