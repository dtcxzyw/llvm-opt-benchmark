@anon.1d0b41a8d45d477c3029ec78f9b8b434.3404 = private unnamed_addr constant [3101 x i8] c"# Provide a menu of the directories recently navigated to and ask the user to\0A# choose one to make the new current working directory (cwd).\0A\0Afunction cdh --description \22Menu based cd command\22\0A    # See if we've been invoked with an argument. Presumably from the `cdh` completion script.\0A    # If we have just treat it as `cd` to the specified directory.\0A    if set -q argv[1]\0A        cd $argv\0A        return\0A    end\0A\0A    if set -q argv[2]\0A        echo (_ \22cdh: Expected zero or one arguments\22) >&2\0A        return 1\0A    end\0A\0A    set -l all_dirs $dirprev $dirnext\0A    if not set -q all_dirs[1]\0A        echo (_ 'No previous directories to select. You have to cd at least once.') >&2\0A        return 0\0A    end\0A\0A    # Reverse the directories so the most recently visited is first in the list.\0A    # Also, eliminate duplicates; i.e., we only want the most recent visit to a\0A    # given directory in the selection list.\0A    set -l uniq_dirs\0A    for dir in $all_dirs[-1..1]\0A        if not contains $dir $uniq_dirs\0A            set -a uniq_dirs $dir\0A        end\0A    end\0A\0A    set -l letters a b c d e f g h i j k l m n o p q r s t u v w x y z\0A    set -l dirc (count $uniq_dirs)\0A    if test $dirc -gt (count $letters)\0A        set -l msg (_ 'This should not happen. Have you changed the cd function?')\0A        printf \22$msg\\n\22 >&2\0A        set -l msg (_ 'There are %s unique dirs in your history but I can only handle %s')\0A        printf \22$msg\\n\22 $dirc (count $letters) >&2\0A        return 1\0A    end\0A\0A    # Print the recent directories, oldest to newest. Since we previously\0A    # reversed the list, making the newest entry the first item in the array,\0A    # we count down rather than up.\0A    for i in (seq $dirc -1 1)\0A        set -l dir $uniq_dirs[$i]\0A        set -l label_color normal\0A        set -q fish_color_cwd\0A        and set label_color $fish_color_cwd\0A        set -l dir_color_reset (set_color normal)\0A        set -l dir_color\0A        if test \22$dir\22 = \22$PWD\22\0A            set dir_color (set_color $fish_color_history_current)\0A        end\0A\0A        set -l home_dir (string match -r \22^$HOME(/.*|\\$)\22 \22$dir\22)\0A        if set -q home_dir[2]\0A            set dir \22~$home_dir[2]\22\0A        end\0A        printf '%s %s %2d) %s %s%s%s\\n' (set_color $label_color) $letters[$i] $i (set_color normal) $dir_color $dir $dir_color_reset\0A    end\0A\0A    # Ask the user which directory from their history they want to cd to.\0A    set -l msg (_ 'Select directory by letter or number: ')\0A    read -l -p \22echo '$msg'\22 choice\0A    if test -z \22$choice\22\0A        return 0\0A    else if string match -q -r '^[a-z]$' $choice\0A        # Convert the letter to an index number.\0A        set choice (contains -i $choice $letters)\0A    end\0A\0A    set -l msg (_ 'Error: expected a number between 1 and %d or letter in that range, got \22%s\22')\0A    if string match -q -r '^\\d+$' $choice\0A        if test $choice -ge 1 -a $choice -le $dirc\0A            cd $uniq_dirs[$choice]\0A            return\0A        else\0A            printf \22$msg\\n\22 $dirc $choice >&2\0A            return 1\0A        end\0A    else\0A        printf \22$msg\\n\22 $dirc $choice >&2\0A        return 1\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3405 = private unnamed_addr constant [27 x i8] c"functions/contains_seq.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3406 = private unnamed_addr constant [1060 x i8] c"function contains_seq --description 'Return true if array contains a sequence'\0A    set -l printnext\0A    switch $argv[1]\0A        case --printnext\0A            set printnext[1] 1\0A            set -e argv[1]\0A    end\0A    set -l pattern\0A    set -l string\0A    set -l dest pattern\0A    for i in $argv\0A        if test \22$i\22 = --\0A            set dest string\0A            continue\0A        end\0A        set $dest $$dest $i\0A    end\0A    set -l nomatch 1\0A    set -l i 1\0A    for s in $string\0A        if set -q printnext[2]\0A            return 0\0A        end\0A        if test \22$s\22 = \22$pattern[$i]\22\0A            set -e nomatch[1]\0A            set i (math $i + 1)\0A            if not set -q pattern[$i]\0A                if set -q printnext[1]\0A                    set printnext[2] 1\0A                    continue\0A                end\0A                return 0\0A            end\0A        else\0A            if not set -q nomatch[1]\0A                set nomatch 1\0A                set i 1\0A            end\0A        end\0A    end\0A    if set -q printnext[1]\0A        echo ''\0A    end\0A    set -q printnext[2]\0Aend\0A", align 1
