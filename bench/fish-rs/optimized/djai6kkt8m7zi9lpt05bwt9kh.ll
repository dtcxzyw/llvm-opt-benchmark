@anon.1d0b41a8d45d477c3029ec78f9b8b434.1812 = private unnamed_addr constant [2982 x i8] c"# Note that when a completion file is sourced a new block scope is created so `set -l` works.\0Aset -l __fish_history_all_commands search delete save merge clear clear-session append\0A\0Acomplete -c history -s h -l help -d \22Display help and exit\22\0A\0A# Note that these options are only valid with the \22search\22 and \22delete\22 subcommands.\0Acomplete -c history -n '__fish_seen_subcommand_from search delete; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s p -l prefix -d \22Match items beginning with the string\22\0Acomplete -c history -n '__fish_seen_subcommand_from search delete; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s c -l contains -d \22Match items containing the string\22\0Acomplete -c history -n '__fish_seen_subcommand_from search delete; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s e -l exact -d \22Match items identical to the string\22\0Acomplete -c history -n '__fish_seen_subcommand_from search delete; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s t -l show-time -d \22Output with timestamps\22\0Acomplete -c history -n '__fish_seen_subcommand_from search delete; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s C -l case-sensitive -d \22Match items in a case-sensitive manner\22\0A\0A# Note that these options are only valid with the \22search\22 subcommand.\0Acomplete -c history -n '__fish_seen_subcommand_from search; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s n -l max -d \22Limit output to the first 'n' matches\22 -x\0Acomplete -c history -n '__fish_seen_subcommand_from search; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s z -l null -d \22Terminate entries with NUL character\22\0Acomplete -c history -n '__fish_seen_subcommand_from search; or not __fish_seen_subcommand_from $__fish_history_all_commands' \\\0A    -s R -l reverse -d \22Output the oldest results first\22 -x\0A\0A# We don't include a completion for the \22save\22 subcommand because it should not be used\0A# interactively.\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a search -d \22Prints commands from history matching the strings\22\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a delete -d \22Deletes commands from history matching the strings\22\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a merge -d \22Incorporate history changes from other sessions\22\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a clear -d \22Clears history file\22\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a clear-session -d \22Clears all history from the current session\22\0Acomplete -f -c history -n \22not __fish_seen_subcommand_from $__fish_history_all_commands\22 \\\0A    -a append -d \22Appends commands to the history without needing to execute them\22\0A", align 1
