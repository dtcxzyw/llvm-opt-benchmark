@anon.1d0b41a8d45d477c3029ec78f9b8b434.3571 = private unnamed_addr constant [2126 x i8] c"# name: Informative Vcs\0A# author: Mariusz Smykula <mariuszs at gmail.com>\0A\0Afunction fish_prompt --description 'Write out the prompt'\0A    set -l last_pipestatus $pipestatus\0A    set -lx __fish_last_status $status # Export for __fish_print_pipestatus.\0A\0A    if not set -q __fish_git_prompt_show_informative_status\0A        set -g __fish_git_prompt_show_informative_status 1\0A    end\0A    if not set -q __fish_git_prompt_hide_untrackedfiles\0A        set -g __fish_git_prompt_hide_untrackedfiles 1\0A    end\0A    if not set -q __fish_git_prompt_color_branch\0A        set -g __fish_git_prompt_color_branch magenta --bold\0A    end\0A    if not set -q __fish_git_prompt_showupstream\0A        set -g __fish_git_prompt_showupstream informative\0A    end\0A    if not set -q __fish_git_prompt_color_dirtystate\0A        set -g __fish_git_prompt_color_dirtystate blue\0A    end\0A    if not set -q __fish_git_prompt_color_stagedstate\0A        set -g __fish_git_prompt_color_stagedstate yellow\0A    end\0A    if not set -q __fish_git_prompt_color_invalidstate\0A        set -g __fish_git_prompt_color_invalidstate red\0A    end\0A    if not set -q __fish_git_prompt_color_untrackedfiles\0A        set -g __fish_git_prompt_color_untrackedfiles $fish_color_normal\0A    end\0A    if not set -q __fish_git_prompt_color_cleanstate\0A        set -g __fish_git_prompt_color_cleanstate green --bold\0A    end\0A\0A    set -l color_cwd\0A    set -l suffix\0A    if functions -q fish_is_root_user; and fish_is_root_user\0A        if set -q fish_color_cwd_root\0A            set color_cwd $fish_color_cwd_root\0A        else\0A            set color_cwd $fish_color_cwd\0A        end\0A        set suffix '#'\0A    else\0A        set color_cwd $fish_color_cwd\0A        set suffix '$'\0A    end\0A\0A    # PWD\0A    set_color $color_cwd\0A    echo -n (prompt_pwd)\0A    set_color normal\0A\0A    printf '%s ' (fish_vcs_prompt)\0A\0A    set -l status_color (set_color $fish_color_status)\0A    set -l statusb_color (set_color --bold $fish_color_status)\0A    set -l prompt_status (__fish_print_pipestatus \22[\22 \22]\22 \22|\22 \22$status_color\22 \22$statusb_color\22 $last_pipestatus)\0A    echo -n $prompt_status\0A    set_color normal\0A\0A    echo -n \22$suffix \22\0Aend\0A", align 1
