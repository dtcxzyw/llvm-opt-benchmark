@anon.1d0b41a8d45d477c3029ec78f9b8b434.1610 = private unnamed_addr constant [6035 x i8] c"complete -c feh -l action -s A -x -d \22Specify a shell command as action to perform on image\22\0A\0Afor i in (seq 1 9)\0A    complete -c feh -l action$i -x -d \22Extra action triggered with number key \22$i\0Aend\0A\0Acomplete -c feh -l auto-zoom -s Z -d \22Zoom pictures to screen size\22\0Acomplete -c feh -l borderless -s x -d \22Create borderless window\22\0Acomplete -c feh -l cache-thumbnails -s P -d \22Enable thumbnail caching\22\0Acomplete -c feh -l caption-path -s K -r -d \22Path to directory with image caption\22\0Acomplete -c feh -l customlist -s L -x -d \22Print image info according to given format\22\0Acomplete -c feh -l cycle-once -d \22Exit feh after one loop through slideshow\22\0Acomplete -c feh -l draw-actions -s G -d \22Draw defined actions\22\0Acomplete -c feh -l draw-exif -d \22Display EXIF information\22\0Acomplete -c feh -l draw-filename -s d -d \22Draw filename\22\0Acomplete -c feh -l draw-tinted -d \22Show overlay texts on semi-transparent background\22\0Acomplete -c feh -l filelist -s f -r\0Acomplete -c feh -l font -s e -x -r -d \22Set global font\22\0Acomplete -c feh -l fontpath -s C -r -d \22Search for fonts in directory\22\0Acomplete -c feh -l force-aliasing -d \22Disable antialiasing\22\0Acomplete -c feh -l fullindex -s I\0Acomplete -c feh -l fullscreen -s F -d \22Make window fullscreen\22\0Acomplete -c feh -l geometry -s g -x -d \22Limit window size\22\0Acomplete -c feh -l hide-pointer -s Y -d \22Hide pointer\22\0Acomplete -c feh -l image-bg -s B -x -a \22checks white black\22 -d \22Use style as background for transparent image parts\22\0Acomplete -c feh -l index -s i -d \22Enable index mode\22\0Acomplete -c feh -l index-info -x -d \22Show image information based on given format\22\0Acomplete -c feh -l info -x -d \22Execute given command line and display output\22\0Acomplete -c feh -l keep-http -s k -d \22Keep files fetched using HTTP\22\0Acomplete -c feh -l insecure -d \22Disable strict hostname and peer checking with HTTPS\22\0Acomplete -c feh -l keep-zoom-vp -d \22When switching images, keep zoom and viewport settings\22\0Acomplete -c feh -l list -s l -d \22Don't display images. Display an ls style listing\22\0Acomplete -c feh -l loadable -s U -d \22Print out image names\22\0Acomplete -c feh -l magick-timeout -x -d \22Stop trying to convert unloadable files after timeout\22\0Acomplete -c feh -l max-dimension -x -d \22Only show images which are smaller than given size\22\0Acomplete -c feh -l menu-font -s M -x -d \22Use font as menu font\22\0Acomplete -c feh -l min-dimension -x -d \22Only show image which are larger than given size\22\0Acomplete -c feh -l montage -s m -d \22Enable montage mode\22\0Acomplete -c feh -l multiwindow -s w -d \22Disable slideshow mode\22\0Acomplete -c feh -l no-jump-on-resort -d \22Don't jump to first image after resorting filelist\22\0Acomplete -c feh -l no-menus -s N -d \22Don't load or show any menus\22\0Acomplete -c feh -l no-screen-clip -d \22Don't limit window to screen size\22\0Acomplete -c feh -l no-xinerama -d \22Disable Xinerama support\22\0Acomplete -c feh -l output-dir -s j -r -d \22Save files to directory\22\0Acomplete -c feh -l preload -s p -d \22Preload images\22\0Acomplete -c feh -l quiet -s q -d \22Don't report non-fatal errors\22\0Acomplete -c feh -l randomize -s z -d \22Randomize file list before displaying\22\0Acomplete -c feh -l recursive -s r -d \22Recursively expand directory\22\0Acomplete -c feh -l no-recursive -d \22Don't recursively expand directory\22\0Acomplete -c feh -l reload -s R -x -d \22Reload filelist after given seconds\22\0Acomplete -c feh -l reverse -s n -d \22Reverse sort order\22\0Acomplete -c feh -l scale-down -s '.' -d \22Scale image to fit window geometry\22\0Acomplete -c feh -l scroll-step -x -d \22Scroll given number of pixels when using scrolling keys\22\0Acomplete -c feh -l slideshow-delay -s D -x -d \22Set delay in second between changing slides\22\0Acomplete -c feh -l sort -s S -x -a \22name\\tSort\\ by\\ name filename\\tSort\\ by\\ filename dirname\\tSort\\ by\\ directory\\ name mtime\\tSort\\ by\\ most\\ recently\\ modified width\\tSort\\ by\\ width height\\tSort\\ by\\ height pixels\\tSort\\ by\\ number\\ of\\ pixels size\\tSort\\ by\\ size format\\tSort\\ by\\ format\22 -d \22Sort file list with given parameter\22\0Acomplete -c feh -l start-at -s l -x -d \22Start filelist at given filename\22\0Acomplete -c feh -l theme -s T -x -d \22Load options from given config file\22\0Acomplete -c feh -l thumbnails -s t\0Acomplete -c feh -l thumb-title -s '~' -x -d \22Set title for window opened from thumbnail mode\22\0Acomplete -c feh -l title -s '^' -x -d \22Set window title\22\0Acomplete -c feh -l unloadable -s u -d \22Print names of images that can't be loaded by imlib2\22\0Acomplete -c feh -l verbose -s V -d \22Verbose mode\22\0Acomplete -c feh -l version -s v -d \22Print version and exit\22\0Acomplete -c feh -l xinerama-index -x\0Acomplete -c feh -l zoom -x -a \22max fill\22 -d \22Zoom images by given percent when in fullscreen\22\0A\0A# Montage Mode Options\0Acomplete -c feh -l alpha -s a -x -d \22Set thumbnail transparency (0-255)\22\0Acomplete -c feh -l bg -s b -r -a trans -d \22Use given file as background for montage\22\0Acomplete -c feh -l ignore-aspect -s X -d \22Don't retain thumbnails' aspect ratios\22\0Acomplete -c feh -l limit-height -s W -x -d \22Limit montage's height\22\0Acomplete -c feh -l limit-width -s W -x -d \22Limit montage's width\22\0Acomplete -c feh -l output -s o -r -d \22Save created montage to file\22\0Acomplete -c feh -l output-only -s O -r -d \22Save created montage to file\22\0Acomplete -c feh -l stretch -s s -d \22Enlarge if image smaller than given thumbnail size\22\0Acomplete -c feh -l thumb-height -s E -x -d \22Set thumbnail height\22\0Acomplete -c feh -l thumb-width -s y -x -d \22Set thumbnail width\22\0Acomplete -c feh -l thumb-redraw -s J -x -d \22Redraw thumbnail window every n images\22\0A\0A# Index mode options\0Acomplete -c feh -l title-font -s '@' -x -d \22Set font to print title on index\22\0A\0A# Background setting\0Acomplete -c feh -l bg-center -d \22Center file on background\22\0Acomplete -c feh -l bg-fill -d \22Set as background by zooming until image fits\22\0Acomplete -c feh -l bg-max -d \22Set as background by zooming with black borders on one side\22\0Acomplete -c feh -l bg-scale -d \22Set as background without tiling, trimming or borders\22\0Acomplete -c feh -l bg-tile -d \22Tile image if too small for screen\22\0Acomplete -c feh -l no-fehbg -d \22Do not write a ~/.fehbg file\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1611 = private unnamed_addr constant [23 x i8] c"completions/ffmpeg.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1612 = private unnamed_addr constant [13575 x i8] c"function __fish_ffmpeg_last_arg\0A    echo (commandline -cx)[-1]\0Aend\0A\0A# Allow completions to match against an argument that includes a stream specifier, e.g. -c:v:2\0Afunction __fish_ffmpeg_complete_regex\0A    set -l regex $argv[1]\0A    set -l completions $argv[2..-1]\0A\0A    complete -x -c ffmpeg -n \22__fish_ffmpeg_last_arg | string match -rq -- '^'\\\22$regex\\\22'(\\$|:)'\22 \\\0A        -a \22$completions\22\0Aend\0A\0Afunction __fish_ffmpeg_help_type\0A    printf '%s\\t%s\\n' long \22Print more options\22\0A    printf '%s\\t%s\\n' full \22Print all options\22\0A\0A    for help_type in decoder encoder demuxer muxer filter\0A        set -l regex\0A\0A        if test $help_type = filter\0A            set regex '\\S+\\s+(\\S+)\\s+\\S+\\s+(\\S+)'\0A        else\0A            set regex '\\S+\\s+(\\S+)\\s+(\\S+)'\0A        end\0A\0A        printf '%s\\n' $help_type=(ffmpeg -loglevel quiet -\22$help_type\22s | string trim \\\0A            | string match -rv '=|:$|^-' | string replace -rf \22$regex\22 '$1\\t$2')\0A    end\0Aend\0A\0Afunction __fish_ffmpeg_codec_list\0A    printf '%s\\t%s\\n' copy \22Stream copy\22\0A\0A    set -l identifier\0A\0A    switch $argv[1]\0A        case video\0A            set identifier '^V.*'\0A        case audio\0A            set identifier '^A.*'\0A        case subtitle\0A            set identifier '^S.*'\0A        case all\0A            set identifier '.*'\0A        case '*'\0A            return 1\0A    end\0A\0A    printf '%s\\n' (ffmpeg -loglevel quiet -decoders | string trim | string match -rv '=|:$|^-' \\\0A        | string match -r \22$identifier\22 | string replace -rf '\\S+\\s+(\\S+)\\s+(\\S+)' '$1\\t$2')\0Aend\0A\0Afunction __fish_ffmpeg_pix_fmts\0A    # We can't know in advance if the intention is to specify an output pix_fmt because the intent\0A    # could be to instead provide a second input, but we can rule out an output if no input has\0A    # been specified\0A    set -l regex_filter '.'\0A    if contains -- -i (commandline -cx)\0A        set regex_filter '^I'\0A    end\0A    ffmpeg -hide_banner -loglevel quiet -pix_fmts |\0A        # tail -n +9 | # skip past header\0A        string match -rv '[:=-]|FLAGS' | # skip past header\0A        string match -er $regex_filter |\0A        string replace -rf '^[IOHPB.]{5} (\\S+) .*' '$1'\0Aend\0A\0Afunction __fish_ffmpeg_filters\0A    # TODO: Figure out how to distinguish {audio,video} source and destination, because some filters\0A    # can go cross those lines (e.g. showvolume, which generates a video representation of the input\0A    # audio).\0A\0A    set -l filter '.'\0A    switch $argv[1]\0A        case video\0A            set filter '[V]\\S*->|->\\S*[V]'\0A        case audio\0A            set filter '[A]\\S*->|->\\S*[A]'\0A        case all\0A        case '*'\0A            set filter '.'\0A    end\0A\0A    ffmpeg -hide_banner -loglevel quiet -filters |\0A        string match -e -- '->' | # skip past the header\0A        string match -er $filter |\0A        string replace -rf '^ [TSC.]{3} +(\\S+) +\\S+->\\S+ +(.*)' '$1\\t$2'\0Aend\0A\0Afunction __fish_ffmpeg_presets\0A    set -l cmdline (commandline)\0A    if string match -ireq '[hx]26[45]'\0A        printf \22%s\\n\22 ultrafast superfast veryfast faster fast medium slow slower veryslow placebo\0A    end\0Aend\0A\0Afunction __fish_ffmpeg_tunes\0A    set -l cmdline (commandline)\0A    if string match -req 264\0A        printf \22%s\\n\22 film animation grain stillimage fastdecode zerolatency psnr ssim\0A    end\0A    if string match -req '265|hevc'\0A        printf \22%s\\n\22 psnr ssim grain zerolatency fastdecode\0A    end\0Aend\0A\0Afunction __fish_ffmpeg_crfs\0A    seq 1 30\0Aend\0A\0Afunction __fish_ffmpeg_profile\0A    if string match -req 264\0A        printf \22%s\\n\22 baseline main high\0A    end\0A    if string match -req '265|hevc'\0A        printf \22%s\\n\22 main high\0A    end\0Aend\0A\0Afunction __fish_ffmpeg_formats\0A    # TODO: Use heuristic to determine input vs output format and filter accordingly\0A    ffmpeg -hide_banner -loglevel quiet -formats | string replace -rf '^ [DE.]{2} ([a-z0-9_]+) +(\\S.+)$' '$1\\t$2'\0Aend\0A\0Acomplete -c ffmpeg -s i -d \22Specify input file\22\0A\0A# Print help / information / capabilities\0Acomplete -c ffmpeg -s L -d \22Show license\22\0Acomplete -x -c ffmpeg -s h -s \22?\22 -o help -l help -a \22(__fish_ffmpeg_help_type)\22 -d \22Show help\22\0Acomplete -c ffmpeg -o version -d \22Show version\22\0Acomplete -c ffmpeg -o buildconf -d \22Show build configuration\22\0Acomplete -c ffmpeg -o formats -d \22Show available formats\22\0Acomplete -c ffmpeg -o muxers -d \22Show available muxers\22\0Acomplete -c ffmpeg -o demuxers -d \22Show available demuxers\22\0Acomplete -c ffmpeg -o devices -d \22Show available devices\22\0Acomplete -c ffmpeg -o codecs -d \22Show available codecs\22\0Acomplete -c ffmpeg -o decoders -d \22Show available decoders\22\0Acomplete -c ffmpeg -o encoders -d \22Show available encoders\22\0Acomplete -c ffmpeg -o bsfs -d \22Show available bit stream filters\22\0Acomplete -c ffmpeg -o protocols -d \22Show available protocols\22\0Acomplete -c ffmpeg -o filters -d \22Show available filters\22\0Acomplete -c ffmpeg -o pix_fmts -d \22Show available pixel formats\22\0Acomplete -c ffmpeg -o layouts -d \22Show standard channel layouts\22\0Acomplete -c ffmpeg -o sample_fmts -d \22Show available audio sample formats\22\0Acomplete -c ffmpeg -o colors -d \22Show available color names\22\0Acomplete -c ffmpeg -o sources -d \22List sources of the input device\22\0Acomplete -c ffmpeg -o sinks -d \22List sinks of the output device\22\0Acomplete -c ffmpeg -o hwaccels -d \22Show available HW acceleration methods\22\0A\0A# Global options\0Acomplete -x -c ffmpeg -o loglevel -s v \\\0A    -a \22quiet panic fatal error warning info verbose debug trace\22 -d \22Set logging level\22\0Acomplete -c ffmpeg -o report -d \22Generate a report\22\0Acomplete -c ffmpeg -o max_alloc -d \22Set maximum size of a single allocated block\22\0Acomplete -c ffmpeg -s y -d \22Overwrite output files\22\0Acomplete -c ffmpeg -s n -d \22Never overwrite output files\22\0Acomplete -c ffmpeg -o ignore_unknown -d \22Ignore unknown stream types\22\0Acomplete -c ffmpeg -o filter_threads -d \22Number of non-complex filter threads\22\0Acomplete -c ffmpeg -o filter_complex_threads -d \22Number of threads for -filter_complex\22\0Acomplete -c ffmpeg -o stats -d \22Print progress report during encoding\22\0Acomplete -c ffmpeg -o max_error_rate -d \22Ratio of errors\22\0Acomplete -c ffmpeg -o bits_per_raw_sample -d \22Set the number of bits per raw sample\22\0Acomplete -c ffmpeg -o vol -d \22Change audio volume\22\0A\0A# Per-file main options\0Acomplete -c ffmpeg -s f -d \22Force format\22 -xa \22(__fish_ffmpeg_formats)\22\0Acomplete -c ffmpeg -s c -o codec -d \22Codec name\22 -xa \22(__fish_ffmpeg_codec_list all)\22\0Acomplete -c ffmpeg -o map_metadata -d \22Set metadata information of outfile from infile\22\0Acomplete -c ffmpeg -s t -d \22Record or transcode \\\22duration\\\22 seconds of audio/video\22\0Acomplete -c ffmpeg -o to -d \22Record or transcode stop time\22\0Acomplete -c ffmpeg -o fs -d \22Set the limit file size in bytes\22\0Acomplete -c ffmpeg -o ss -d \22Set the start time offset\22\0Acomplete -c ffmpeg -o seek_timestamp -d \22Enable/disable seeking by timestamp with -ss\22\0Acomplete -c ffmpeg -o timestamp -d \22Set the recording timestamp\22\0Acomplete -c ffmpeg -o metadata -d \22Add metadata\22\0Acomplete -c ffmpeg -o program -d \22Add program with specified streams\22\0Acomplete -x -c ffmpeg -o target -a '(for target in vcd svcd dvd dv dv50 ; echo \22$target\22 ; \\\0A    echo pal-\22$target\22 ; echo ntsc-\22$target\22 ; echo film-\22$target\22 ; end)' \\\0A    -d \22Specify target file type\22\0Acomplete -c ffmpeg -o apad -d \22Audio pad\22\0Acomplete -c ffmpeg -o frames -d \22Set the number of frames to output\22\0Acomplete -c ffmpeg -o filter -d \22Set stream filtergraph\22\0Acomplete -c ffmpeg -o filter_script -d \22Read stream filtergraph description from a file\22\0Acomplete -c ffmpeg -o reinit_filter -d \22Reinit filtergraph on input parameter changes\22\0Acomplete -c ffmpeg -o discard -d Discard\0Acomplete -c ffmpeg -o disposition -d Disposition\0A\0A# Video options\0Acomplete -c ffmpeg -o vframes -d \22Set the number of video frames to output\22\0Acomplete -c ffmpeg -s r -d \22Set frame rate\22\0Acomplete -c ffmpeg -s s -d \22Set frame size\22\0Acomplete -c ffmpeg -o aspect -d \22Set aspect ratio\22\0Acomplete -c ffmpeg -o bits_per_raw_sample -d \22Set the number of bits per raw sample\22\0Acomplete -c ffmpeg -o vn -d \22Disable video\22\0Acomplete -c ffmpeg -o vcodec -o \22codec:v\22 -o \22c:v\22\0A# Also list codecs when a particular stream is selected, e.g. -c:v:0\0A__fish_ffmpeg_complete_regex \22-(vcodec|c(odec)?:v)\22 \22(__fish_ffmpeg_codec_list video)\22\0Acomplete -c ffmpeg -o timecode -d \22Set initial TimeCode value\22\0Acomplete -x -c ffmpeg -o pass -a \221 2 3\22 -d \22Select the pass number\22\0Acomplete -c ffmpeg -o vf -d \22Set video filters\22\0Acomplete -c ffmpeg -o ab -o \22b:a\22 -d \22Audio bitrate\22\0Acomplete -c ffmpeg -s b -o \22b:v\22 -d \22Video bitrate\22\0Acomplete -c ffmpeg -o dn -d \22Disable data\22\0A# Advanced video options\0Acomplete -c ffmpeg -o pix_fmt\0A__fish_ffmpeg_complete_regex -pix_fmt \22(__fish_ffmpeg_pix_fmts)\22\0A\0A# Audio options\0Acomplete -c ffmpeg -o aframes -d \22Set the number of audio frames to output\22\0Acomplete -c ffmpeg -o aq -d \22Set audio quality\22\0Acomplete -c ffmpeg -o ar -d \22Set audio sampling rate\22\0Acomplete -c ffmpeg -o ac -d \22Set number of audio channels\22\0Acomplete -c ffmpeg -o an -d \22Disable audio\22\0Acomplete -c ffmpeg -o acodec -o \22codec:a\22 -o \22c:a\22\0A__fish_ffmpeg_complete_regex '-(acodec|c(odec)?:a)' \22(__fish_ffmpeg_codec_list audio)\22\0Acomplete -c ffmpeg -o vol -d \22Change audio volume\22\0Acomplete -c ffmpeg -o af -d \22Set audio filters\22\0A\0A# Subtitle options\0Acomplete -c ffmpeg -s s -d \22Set frame size\22\0Acomplete -c ffmpeg -o sn -d \22Disable subtitle\22\0Acomplete -c ffmpeg -o scodec -o \22codec:s\22 -o \22c:s\22\0A__fish_ffmpeg_complete_regex '-(scodec|c(odec)?:s)(:\\d+)?' \22(__fish_ffmpeg_codec_list subtitle)\22\0Acomplete -c ffmpeg -o stag -d \22Force subtitle tag/fourcc\22\0Acomplete -c ffmpeg -o fix_sub_duration -d \22Fix subtitles duration\22\0Acomplete -c ffmpeg -o canvas_size -d \22Set canvas size\22\0Acomplete -c ffmpeg -o spre -d \22Set the subtitle options to the indicated preset\22\0A\0A# Codec-specific options\0Acomplete -c ffmpeg -o pre -o preset -d \22Preset name\22\0A__fish_ffmpeg_complete_regex 'pre(set)?' \22(__fish_ffmpeg_presets)\22\0Acomplete -c ffmpeg -o tune\0A__fish_ffmpeg_complete_regex tune \22(__fish_ffmpeg_tunes)\22\0Acomplete -c ffmpeg -o crf -o q\0A__fish_ffmpeg_complete_regex 'crf|q' \22(__fish_ffmpeg_crfs)\22\0Acomplete -c ffmpeg -o profile\0A__fish_ffmpeg_complete_regex profile \22(__fish_ffmpeg_profiles)\22\0A\0A# Filters\0A#\0A# fish completions are not designed to take the current argument being completed as an input,\0A# and if introspected it is normally used to filter/constrain the completions generated. ffmpeg's\0A# command line syntax is extremely nasty and in addition to using stringification for all arguments,\0A# relies on special characters to delimit separate subarguments (rather than, e.g., concatenating\0A# repeated invocations of the same switch), meaning the typical way of generating fish completions\0A# would only allow us to generate the very first subargument in a complex argument payload.\0A#\0A# We hack around this in a ridiculously ugly fashion by always generating completions that are\0A# prepended with a prefix of the current value of the payload in question.\0A#\0A# Top-level ffmpeg filters are comma separated, but take optional arguments that might themselves\0A# take optional subarguments. While = is a key=value delimiter, it is also a prefix for the first\0A# argument to a filter, e.g. filter_name=opt1 and filter_name=opt1=opt_value, and in the case that\0A# a filter takes more than one argument, filter arguments are delimited with :\0A#\0A# A complete example:\0A#\0A# ffmpeg .... -filter:v filter1,filter2=f2_arg1=f2_arg1_val:f2_arg2\0A\0Afunction __fish_ffmpeg_split_filter_graph\0A    set -l filters (string split , $argv[1])\0A    printf \22%s\\n\22 $filters\0Aend\0A\0A# Given a single filter expression, emits the filter name on the first line and then each key=value\0A# pair of arguments to the filter on each subsequent line.\0Afunction __fish_ffmpeg_decompose_filter\0A    set -l parts (string split -m 1 = \22$argv\22)\0A    echo $parts[1] # the filter name\0A    set -l arguments (string split : $parts[2])\0A    printf \22%s\\n\22 $arguments\0Aend\0A\0Afunction __fish_ffmpeg_concat_filters\0A    string join -- , $argv\0Aend\0A\0Afunction __fish_ffmpeg_concat_filter_args\0A    string join -- : $argv\0Aend\0A\0Afunction __fish_ffmpeg_complete_filter\0A    set -l filter_type all\0A    if string match -rq -- '^-(vf(ilter)?|f(ilter)?:v)' (__fish_ffmpeg_last_arg)\0A        set filter_type video\0A    else if string match -rq -- '^-(af(ilter)?|f(ilter)?:a)' (__fish_ffmpeg_last_arg)\0A        set filter_type audio\0A    end\0A\0A    # echo -e \22\\n **** $filter_type **** \\n\22 > /dev/tty\0A\0A    set -l filters_arg (commandline -xp)[-1]\0A    if string match -rq -- '^-' $filters_arg\0A        # No filter name started\0A        __fish_ffmpeg_filters $filter_type\0A        return\0A    end\0A\0A    set -l filters (__fish_ffmpeg_split_filter_graph $filters_arg)\0A    # We are completing only the last filter (in case there are multiple)\0A    set -l filter $filters[-1]\0A    # Remove it from the list of passed-through filters\0A    set -e filters[-1]\0A    # `ffmpeg -h filter=FILTER` exposes information that can be used to dynamically complete not\0A    # only the name of the filter but also the name of its individual options. We currently only\0A    # support completing the name of the filter.\0A    set -l decomposed (__fish_ffmpeg_decompose_filter $filter)\0A    set -l filter_name $decomposed[1]\0A    set -l filter_args (__fish_ffmpeg_concat_filter_args $decomposed[2..-1])\0A\0A    # Emit the mutated filter graph, with permutations of the final filter name offered as\0A    # completions.\0A    for known_filter in (__fish_ffmpeg_filters $filter_type)\0A        set -l modified_filter (string join = $known_filter $filter_args)\0A        __fish_ffmpeg_concat_filters $filters $modified_filter\0A    end\0Aend\0A\0Acomplete -x -c ffmpeg -o filter -o filter:v -o filter:s -o filter:a -o vf -o af \\\0A    -a \22(__fish_ffmpeg_complete_filter)\22\0A", align 1
