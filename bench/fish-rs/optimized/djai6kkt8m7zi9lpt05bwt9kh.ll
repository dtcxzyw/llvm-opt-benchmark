@anon.1d0b41a8d45d477c3029ec78f9b8b434.3458 = private unnamed_addr constant [220 x i8] c"# The fish_mode_prompt function is prepended to the prompt\0Afunction fish_mode_prompt --description \22Displays the current mode\22\0A    # To reuse the mode indicator use this function instead\0A    fish_default_mode_prompt\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3459 = private unnamed_addr constant [23 x i8] c"functions/fish_opt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3460 = private unnamed_addr constant [1350 x i8] c"# This is a helper function for `fish_opt`. It does some basic validation of the arguments.\0Afunction __fish_opt_validate_args --no-scope-shadowing\0A    if not set -q _flag_short\0A        or test 1 -ne (string length -- $_flag_short)\0A        printf (_ \22%s: The --short flag is required and must be a single character\\n\22) fish_opt >&2\0A        return 1\0A    end\0A\0A    return 0\0Aend\0A\0A# The `fish_opt` command.\0Afunction fish_opt -d 'Produce an option specification suitable for use with `argparse`.'\0A    set -l options h/help 's/short=' 'l/long=' o/optional-val r/required-val\0A    set options $options L-long-only M-multiple-vals\0A    argparse -n fish_opt --max-args=0 --exclusive=r,o --exclusive=M,o $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help fish_opt\0A        return 0\0A    end\0A\0A    __fish_opt_validate_args\0A    or return\0A\0A    set -l opt_spec $_flag_short\0A\0A    if set -q _flag_long\0A        if set -q _flag_long_only\0A            set opt_spec \22$opt_spec-\22\0A        else\0A            set opt_spec \22$opt_spec/\22\0A        end\0A        set opt_spec \22$opt_spec$_flag_long\22\0A    end\0A\0A    if set -q _flag_multiple_vals\0A        set opt_spec \22$opt_spec=+\22\0A    else if set -q _flag_required_val\0A        set opt_spec \22$opt_spec=\22\0A    else if set -q _flag_optional_val\0A        and set opt_spec \22$opt_spec=?\22\0A    end\0A\0A    echo $opt_spec\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3461 = private unnamed_addr constant [36 x i8] c"functions/fish_print_git_action.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3462 = private unnamed_addr constant [1745 x i8] c"# Given the path to a .git directory this function prints a human-readable name\0A# for the git action in progress (e.g. \22merge\22) or returns 1.\0Afunction fish_print_git_action --argument-names git_dir\0A    if test -z \22$git_dir\22\0A        if not command -sq git\0A            return 1\0A        end\0A        if not set git_dir (command git rev-parse --git-dir 2>/dev/null)\0A            return 1\0A        end\0A    end\0A\0A    for action_dir in \22$git_dir/rebase-apply\22 \22$git_dir/rebase\22\0A        if test -d \22$action_dir\22\0A            if test -f \22$action_dir/rebasing\22\0A                echo -n rebase\0A            else if test -f \22$action_dir/applying\22\0A                echo -n apply\0A            else\0A                echo -n rebase/apply\0A            end\0A            return 0\0A        end\0A    end\0A\0A    for action_dir in \22$git_dir/rebase-merge/interactive\22 \22$git_dir/.dotest-merge/interactive\22\0A        if test -f \22$action_dir\22\0A            echo -n rebase-interactive\0A            return 0\0A        end\0A    end\0A\0A    for action_dir in \22$git_dir/rebase-merge\22 \22$git_dir/.dotest-merge\22\0A        if test -d \22$action_dir\22\0A            echo -n rebase-merge\0A            return 0\0A        end\0A    end\0A\0A    if test -f \22$git_dir/MERGE_HEAD\22\0A        echo -n merge\0A        return 0\0A    end\0A\0A    if test -f \22$git_dir/CHERRY_PICK_HEAD\22\0A        if test -d \22$git_dir/sequencer\22\0A            echo -n cherry-pick-sequence\0A        else\0A            echo -n cherry-pick\0A        end\0A        return 0\0A    end\0A\0A    if test -f \22$git_dir/REVERT_HEAD\22\0A        if test -d \22$git_dir/sequencer\22\0A            echo -n revert-sequence\0A        else\0A            echo -n revert\0A        end\0A        return 0\0A    end\0A\0A    if test -f \22$git_dir/BISECT_LOG\22\0A        echo -n bisect\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3463 = private unnamed_addr constant [33 x i8] c"functions/fish_print_hg_root.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3464 = private unnamed_addr constant [534 x i8] c"function fish_print_hg_root\0A    # If hg isn't installed, there's nothing we can do\0A    if not command -sq hg\0A        return 1\0A    end\0A\0A    # Find an hg directory above $PWD\0A    # without calling `hg root` because that's too slow\0A    set -l root\0A    set -l dir \22$(pwd -P 2>/dev/null)\22\0A    or return 1\0A\0A    while not contains -- \22$dir\22 \22\22 / .\0A        if test -f $dir'/.hg/dirstate'\0A            echo $dir/.hg\0A            return 0\0A        end\0A        # Go up one directory\0A        set dir (path dirname -- $dir)\0A    end\0A\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3465 = private unnamed_addr constant [26 x i8] c"functions/fish_prompt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3466 = private unnamed_addr constant [1420 x i8] c"# name: Default\0A# author: Lily Ballard\0A\0Afunction fish_prompt --description 'Write out the prompt'\0A    set -l last_pipestatus $pipestatus\0A    set -lx __fish_last_status $status # Export for __fish_print_pipestatus.\0A    set -l normal (set_color normal)\0A    set -q fish_color_status\0A    or set -g fish_color_status red\0A\0A    # Color the prompt differently when we're root\0A    set -l color_cwd $fish_color_cwd\0A    set -l suffix '>'\0A    if functions -q fish_is_root_user; and fish_is_root_user\0A        if set -q fish_color_cwd_root\0A            set color_cwd $fish_color_cwd_root\0A        end\0A        set suffix '#'\0A    end\0A\0A    # Write pipestatus\0A    # If the status was carried over (if no command is issued or if `set` leaves the status untouched), don't bold it.\0A    set -l bold_flag --bold\0A    set -q __fish_prompt_status_generation; or set -g __fish_prompt_status_generation $status_generation\0A    if test $__fish_prompt_status_generation = $status_generation\0A        set bold_flag\0A    end\0A    set __fish_prompt_status_generation $status_generation\0A    set -l status_color (set_color $fish_color_status)\0A    set -l statusb_color (set_color $bold_flag $fish_color_status)\0A    set -l prompt_status (__fish_print_pipestatus \22[\22 \22]\22 \22|\22 \22$status_color\22 \22$statusb_color\22 $last_pipestatus)\0A\0A    echo -n -s (prompt_login)' ' (set_color $color_cwd) (prompt_pwd) $normal (fish_vcs_prompt) $normal \22 \22$prompt_status $suffix \22 \22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3467 = private unnamed_addr constant [36 x i8] c"functions/fish_status_to_signal.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3468 = private unnamed_addr constant [631 x i8] c"function fish_status_to_signal --description \22Convert exit code to signal name\22\0A    __fish_make_completion_signals # Make sure signals are cached\0A    for arg in $argv\0A        if test $arg -gt 128\0A            # Important: each element of $__kill_signals is a string like \2210 USR1\22\0A            if set -l signal_names (string replace -r --filter '^'(math $arg-128)' ' SIG $__kill_signals)\0A                # Some signals have multiple mnemonics. Pick the first one.\0A                echo $signal_names[1]\0A            else\0A                echo $arg\0A            end\0A        else\0A            echo $arg\0A        end\0A    end\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3469 = private unnamed_addr constant [30 x i8] c"functions/fish_svn_prompt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3470 = private unnamed_addr constant [6650 x i8] c"# colour of the revision number to display in the prompt\0Aset -g __fish_svn_prompt_color_revision yellow\0A\0A# setting the prompt status separator character\0Aset -g __fish_svn_prompt_char_separator \22|\22\0A\0A# ==============================\0A\0A# SVN status display variables\0A# these are paired in groups of two:\0A# 1. the character to display in the prompt\0A# 2. the colour that should be used to display the character\0A#\0A# these variables are user-configurable and can be set to customize the display output\0A\0Aset -g __fish_svn_prompt_char_added_display A\0Aset -g __fish_svn_prompt_char_added_color green\0A\0Aset -g __fish_svn_prompt_char_conflicted_display C\0Aset -g __fish_svn_prompt_char_conflicted_color --underline magenta\0A\0Aset -g __fish_svn_prompt_char_deleted_display D\0Aset -g __fish_svn_prompt_char_deleted_color red\0A\0Aset -g __fish_svn_prompt_char_ignored_display I\0Aset -g __fish_svn_prompt_char_ignored_color --bold yellow\0A\0Aset -g __fish_svn_prompt_char_modified_display M\0Aset -g __fish_svn_prompt_char_modified_color blue\0A\0Aset -g __fish_svn_prompt_char_replaced_display R\0Aset -g __fish_svn_prompt_char_replaced_color cyan\0A\0Aset -g __fish_svn_prompt_char_unversioned_external_display X\0Aset -g __fish_svn_prompt_char_unversioned_external_color --underline cyan\0A\0Aset -g __fish_svn_prompt_char_unversioned_display '?'\0Aset -g __fish_svn_prompt_char_unversioned_color purple\0A\0Aset -g __fish_svn_prompt_char_missing_display !\0Aset -g __fish_svn_prompt_char_missing_color yellow\0A\0Aset -g __fish_svn_prompt_char_versioned_obstructed_display '~'\0Aset -g __fish_svn_prompt_char_versioned_obstructed_color magenta\0A\0Aset -g __fish_svn_prompt_char_locked_display L\0Aset -g __fish_svn_prompt_char_locked_color --bold red\0A\0Aset -g __fish_svn_prompt_char_scheduled_display '+'\0Aset -g __fish_svn_prompt_char_scheduled_color --bold green\0A\0Aset -g __fish_svn_prompt_char_switched_display S\0Aset -g __fish_svn_prompt_char_switched_color --bold blue\0A\0Aset -g __fish_svn_prompt_char_token_present_display K\0Aset -g __fish_svn_prompt_char_token_present_color --bold cyan\0A\0Aset -g __fish_svn_prompt_char_token_other_display O\0Aset -g __fish_svn_prompt_char_token_other_color --underline purple\0A\0Aset -g __fish_svn_prompt_char_token_stolen_display T\0Aset -g __fish_svn_prompt_char_token_stolen_color --bold purple\0A\0Aset -g __fish_svn_prompt_char_token_broken_display B\0Aset -g __fish_svn_prompt_char_token_broken_color --bold magenta\0A\0A# ==============================\0A\0Afunction __fish_svn_prompt_parse_status --description \22helper function that does pretty formatting on svn status\22\0A    # SVN status symbols\0A    # Do not change these! These are the expected characters that are output from `svn status`, they are taken from `svn help status`\0A    set -l __fish_svn_prompt_chars A C D I M R X '?' ! '~' L + S K O T B\0A    # this sets up an array of all the types of status codes that could be returned.\0A    set -l __fish_svn_prompt_flag_names added conflicted deleted ignored modified replaced unversioned_external unversioned missing versioned_obstructed locked scheduled switched token_present token_other token_stolen token_broken\0A    # iterate over the different status types\0A    for flag_type in $__fish_svn_prompt_flag_names\0A        # resolve the name of the variable for the character representing the current status type\0A        set -l flag_index (contains -i $flag_type $__fish_svn_prompt_flag_names)\0A        # check to see if the status list for this column contains the character representing the current status type\0A        if contains -- $__fish_svn_prompt_chars[$flag_index] $argv\0A            # if it does, then get the names of the variables for the display character and colour to format it with\0A            set -l flag_var_display __fish_svn_prompt_char_{$flag_type}_display\0A            set -l flag_var_color __fish_svn_prompt_char_{$flag_type}_color\0A            # set the colour and print display character, then restore to default display colour\0A            printf '%s%s%s' (set_color $$flag_var_color) $$flag_var_display (set_color normal)\0A        end\0A    end\0Aend\0A\0Afunction fish_svn_prompt --description \22Prompt function for svn\22\0A    # if svn isn't installed or doesn't offer svnversion then don't do anything\0A    if not command -sq svn svnversion\0A        return 1\0A    end\0A\0A    # make sure that this is a svn repo\0A    set -l checkout_info (command svn info 2>/dev/null)\0A    or return\0A\0A    # get the current revision number\0A    printf '(%s%s%s' (set_color $__fish_svn_prompt_color_revision) (__fish_print_svn_rev) (set_color normal)\0A\0A    # resolve the status of the checkout\0A    # 1. perform `svn status`\0A    # 2. remove extra lines that aren't necessary\0A    # 3. cut the output down to the first 7 columns, as these contain the information needed\0A    set -l svn_status_lines (command svn status | sed -e 's=^Summary of conflicts.*==' -e 's=^  Text conflicts.*==' -e 's=^  Property conflicts.*==' -e 's=^  Tree conflicts.*==' -e 's=.*incoming .* upon update.*==' | cut -c 1-7)\0A\0A    # track the last column to contain a status flag\0A    set -l last_column 0\0A\0A    # iterate over the 7 columns of output (the 7 columns are defined on `svn help status`)\0A    for col in (seq 7)\0A        # get the output for a particular column\0A        # 1. echo the whole status flag text\0A        # 2. cut out the current column of characters\0A        # 3. remove duplicates\0A        # 4. remove spaces\0A        set -l column_status (printf '%s\\n' $svn_status_lines | cut -c $col | sort -u | tr -d ' ')\0A\0A        # check that the column status list does not only contain an empty element (if it does, this column is empty)\0A        if test (count $column_status) -gt 1 -o -n \22$column_status[1]\22\0A\0A            # parse the status flags for this column and create the formatting by calling out to the helper function\0A            set -l svn_status_flags (__fish_svn_prompt_parse_status $column_status)\0A\0A            # the default separator is empty\0A            set -l prompt_separator \22\22\0A            for index in (seq (math \22$col - $last_column\22))\0A                # the prompt separator variable has to be updated with the number of separators needed to represent empty status columns (eg: if a file has the status \22A  +\22 then it should display as \22A|||+\22 in the prompt)\0A                set prompt_separator $prompt_separator$__fish_svn_prompt_char_separator\0A            end\0A\0A            # record that the current column was the last one printed to the prompt\0A            set last_column $col\0A            # print the separator string then the current column's status flags\0A            printf '%s%s' $prompt_separator $svn_status_flags\0A        end\0A    end\0A\0A    # print the close of the svn status prompt\0A    printf ')'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3471 = private unnamed_addr constant [25 x i8] c"functions/fish_title.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3472 = private unnamed_addr constant [698 x i8] c"function fish_title\0A    # If we're connected via ssh, we print the hostname.\0A    set -l ssh\0A    set -q SSH_TTY\0A    and set ssh \22[\22(prompt_hostname | string sub -l 10 | string collect)\22]\22\0A    # An override for the current command is passed as the first parameter.\0A    # This is used by `fg` to show the true process name, among others.\0A    if set -q argv[1]\0A        echo -- $ssh (string sub -l 20 -- $argv[1]) (prompt_pwd -d 1 -D 1)\0A    else\0A        # Don't print \22fish\22 because it's redundant\0A        set -l command (status current-command)\0A        if test \22$command\22 = fish\0A            set command\0A        end\0A        echo -- $ssh (string sub -l 20 -- $command) (prompt_pwd -d 1 -D 1)\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3473 = private unnamed_addr constant [38 x i8] c"functions/fish_update_completions.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3474 = private unnamed_addr constant [1071 x i8] c"function fish_update_completions --description \22Update man-page based completions\22\0A    set -l script $__fish_data_dir/tools/create_manpage_completions.py\0A    set -l python (__fish_anypython)\0A    or begin\0A        printf \22%s\\n\22 (_ \22python executable not found\22) >&2\0A        return 1\0A    end\0A\0A    if not test -e \22$script\22\0A        if not status list-files tools/create_manpage_completions.py &>/dev/null\0A            echo \22Cannot find man page completion generator. Please check your fish installation.\22\0A            return 1\0A        end\0A        set -l temp (mktemp -d)\0A        for file in create_manpage_completions.py deroff.py\0A            status get-file tools/$file >$temp/$file\0A            or return\0A        end\0A        set script $temp/create_manpage_completions.py\0A    end\0A\0A    # Don't write .pyc files, use the manpath, clean up old completions\0A    # display progress.\0A    set -l update_args -B $script --manpath --cleanup-in $__fish_user_data_dir/generated_completions --cleanup-in $__fish_cache_dir/generated_completions --progress $argv\0A    $python $update_args\0Aend\0A", align 1
