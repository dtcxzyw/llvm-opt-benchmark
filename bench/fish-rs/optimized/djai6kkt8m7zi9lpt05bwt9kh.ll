@anon.1d0b41a8d45d477c3029ec78f9b8b434.3142 = private unnamed_addr constant [2867 x i8] c"function __fish_complete_man\0A    # Try to guess what section to search in. If we don't know, we\0A    # use [^)]*, which should match any section.\0A    set -l section \22\22\0A    set -l token (commandline -ct)\0A    set -l prev (commandline -pxc)\0A    set -e prev[1]\0A    while set -q prev[1]\0A        switch $prev[1]\0A            case '-**'\0A\0A            case '*'\0A                set section (string escape --style=regex $prev[1])\0A                set section (string replace --all / \\\\/ $section)\0A        end\0A        set -e prev[1]\0A    end\0A\0A    set -l exclude_fish_commands\0A    # Only include fish commands when section is empty or 1\0A    if test -z \22$section\22 -o \22$section\22 = 1\0A        set -e exclude_fish_commands\0A    end\0A\0A    set section $section\22[^)]*\22\0A    # If we don't have a token but a section, list all pages for that section.\0A    # Don't do it for all sections because that would be overwhelming.\0A    if test -z \22$token\22 -a \22$section\22 != \22[^)]*\22\0A        set token \22.\22\0A    end\0A\0A    if test -n \22$token\22\0A        # Do the actual search\0A        __fish_apropos ^$token 2>/dev/null | awk '\0A                BEGIN { FS=\22[\\t ]- \22; OFS=\22\\t\22; }\0A                # BSD/Darwin\0A                /^[^( \\t]+(, [^( \\t]+)*\\('$section'\\)/ {\0A                  paren = index($1, \22(\22);\0A                  sect = substr($1, paren + 1, length($1) - paren - 1);\0A                  aliases = substr($1, 1, paren - 1)\0A                  split(aliases, pages, \22, \22);\0A                  for (i in pages) {\0A                    print pages[i], sect \22: \22 $2\0A                  }\0A                }\0A                # man-db\0A                /^[^( \\t]+ +\\('$section'\\)/ {\0A                  split($1, t, \22 \22);\0A                  sect = substr(t[2], 2, length(t[2]) - 2);\0A                  print t[1], sect \22: \22 $2;\0A                }\0A                # man-db RHEL 5 with [aliases]\0A                /^[^( \\t]+ +\\[.*\\] +\\('$section'\\)/ {\0A                  split($1, t, \22 \22);\0A                  sect = substr(t[3], 2, length(t[3]) - 2);\0A                  print t[1], sect \22: \22 $2;\0A                }   \0A                # Solaris 11\0A                # Does not display descriptions\0A                # Solaris apropos outputs embedded backspace in descriptions\0A                /^[0-9]+\\. [^( \\t]*\\('$section'\\) / {\0A                  split($1, t, \22 \22)\0A                  paren = index(t[2], \22(\22);\0A                  name = substr(t[2], 1, paren - 1);\0A                  sect = substr(t[2], paren + 1, length(t[2]) - paren - 1);\0A                  print name, sect\0A                }\0A                '\0A\0A        # Fish commands are not given by apropos\0A        if not set -ql exclude_fish_commands\0A            set -l files $__fish_data_dir/man/man1/*.1\0A            string replace -r '.*/([^/]+)\\.1$' '$1\\t1: fish command' -- $files (status list-files man/man1/ 2>/dev/null)\0A        end\0A    else\0A        return 1\0A    end\0A    return 0\0Aend\0A", align 1
