@anon.1d0b41a8d45d477c3029ec78f9b8b434.1548 = private unnamed_addr constant [3166 x i8] c"# Completions for the eix tool\0A# http://dev.croup.de/proj/eix and http://sourceforge.net/projects/eix/\0A\0A# Author: Tassilo Horn <tassilo@member.fsf.org>\0A\0A##########\0A# EIX\0A#####\0A# Global options\0A###\0A# exclusive options\0Acomplete -c eix -s h -l help -d \22Show a help screen and exit\22\0Acomplete -c eix -s V -l version -d \22Show version and exit\22\0Acomplete -c eix -l dump -d \22Dump variables to stdout\22\0Acomplete -c eix -l dump-defaults -d \22Dump default values of variables to stdout\22\0A###\0A# special options\0Acomplete -c eix -s t -l test-non-matching -d \22Print non-matching entries first\22\0Acomplete -c eix -s Q -l quick -d \22Don't read unguessable slots of installed packages (toggle)\22\0Acomplete -c eix -l care -d \22Always read slots of installed packages\22\0A###\0A# ootput options\0Acomplete -c eix -s q -l quiet -d \22(no) output (toggle)\22\0Acomplete -c eix -s n -l nocolor -d \22Don't use ANSI color codes\22\0Acomplete -c eix -s F -l force-color -d \22Force colorful output\22\0Acomplete -c eix -s c -l compact -d \22Compact search results (toggle)\22\0Acomplete -c eix -s v -l verbose -d \22Verbose search results (toggle)\22\0Acomplete -c eix -s x -l versionsort -d \22Sort output by slots/versions (toggle)\22\0Acomplete -c eix -s l -l versionlines -d \22Print available versions line-by-line (toggle)\22\0Acomplete -c eix -l format -d \22Format string for normal output\22\0Acomplete -c eix -l format-compact -d \22Format string for compact output\22\0Acomplete -c eix -l format-verbose -d \22Format string for verbose output\22\0A#####\0A# Local options\0A###\0A# Miscellaneous\0Acomplete -c eix -s I -l installed -d \22Next expression only matches installed packages\22\0Acomplete -c eix -s i -l multi-installed -d \22Match packages installed in several versions\22\0Acomplete -c eix -s d -l dup-packages -d \22Match duplicated packages\22\0Acomplete -c eix -s D -l dup-versions -d \22Match packages with duplicated versions\22\0Acomplete -c eix -s 1 -l slotted -d \22Match packages with a nontrivial slot\22\0Acomplete -c eix -s 2 -l slots -d \22Match packages with two different slots\22\0Acomplete -c eix -s u -l update -d \22Match packages without best slotted version\22\0Acomplete -c eix -s o -l overlay -d \22Match packages from overlays\22\0Acomplete -c eix -s T -l test-obsolete -d \22Match packages with obsolete entries\22\0Acomplete -c eix -s ! -l not -d \22Invert the expression (toggle)\22\0Acomplete -c eix -s '|' -l pipe -d \22Use input from pipe of emerge -pv\22\0A###\0A# Search Fields\0Acomplete -c eix -s S -l description -d \22Search the description field\22\0Acomplete -c eix -s A -l category-name -d \22Search the category and name fields\22\0Acomplete -c eix -s C -l category -d \22Search the category field\22\0Acomplete -c eix -s s -l name -d \22Search the name field (default)\22\0Acomplete -c eix -s H -l homepage -d \22Search the homepage field\22\0Acomplete -c eix -s L -l license -d \22Search the license field\22\0Acomplete -c eix -s P -l provides -d \22Search the provides field\22\0A###\0A# Type of Pattern\0Acomplete -c eix -s r -l regex -d \22Pattern is a regexp (default)\22\0Acomplete -c eix -s e -l exact -d \22Pattern is the exact string\22\0Acomplete -c eix -s p -l pattern -d \22Pattern is a wildcards-pattern\22\0Acomplete -c eix -s f -l fuzzy -d \22Use fuzzy-search with the given max. levenshtein-distance (default: 2)\22\0A#####\0A##########\0A", align 1
