@anon.1d0b41a8d45d477c3029ec78f9b8b434.2262 = private unnamed_addr constant [1516 x i8] c"complete otool -d 'object file displaying tool' -r\0Acomplete otool -s f -d 'print the fat headers' -F\0Acomplete otool -s a -d 'print the archive header' -F\0Acomplete otool -s h -d 'print the mach header' -F\0Acomplete otool -s l -d 'print the load commands' -F\0Acomplete otool -s L -d 'print shared libraries used' -F\0Acomplete otool -s d -d 'print the data section' -F\0Acomplete otool -s D -d 'print shared library id name' -F\0Acomplete otool -s o -d 'print the Obj-C segment' -F\0Acomplete otool -s r -d 'print the relocation entries' -F\0Acomplete otool -s I -d 'print the indirect symbol table' -F\0Acomplete otool -s C -d 'print linker optimization hints' -F\0Acomplete otool -s G -d 'print the data in code table' -F\0Acomplete otool -s c -d 'print arg  of a core file' -F\0Acomplete otool -s s -d 'print contents of <seg> <sect>' -x\0Acomplete otool -s P -d 'print Info.plist section' -F\0Acomplete otool -s x -d 'print all text sections' -F\0Acomplete otool -s p -d 'specify routine to disassemble' -x\0Acomplete otool -s v -d 'print verbosely'\0Acomplete otool -s V -d 'symbolicate disassembled operands'\0Acomplete otool -s X -d 'omit leading addresses, headers'\0Acomplete otool -s m -d \22disable archive(member) syntax\22\0Acomplete otool -s B -d 'ARM only: force Thumb disassembly'\0Acomplete otool -s q -d \22(default) use llvm's disassembler\22\0Acomplete otool -s Q -d \22use otool's disassembler\22\0Acomplete otool -o mcpu -d 'specify cpu for disassembly'\0Acomplete otool -s j -d 'print opcode bytes'\0Acomplete otool -l version -f -d \22print the version\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2263 = private unnamed_addr constant [21 x i8] c"completions/ouch.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2264 = private unnamed_addr constant [1457 x i8] c"# fish completions for ouch https://github.com/ouch-org/ouch\0A\0A# subcommands list\0Aset -l commands c compress d decompress l list help\0A\0A# if no subcommand yet then no file completion\0Acomplete -c ouch -f --condition \22not __fish_seen_subcommand_from $commands\22\0A\0A# subcommand completions\0Acomplete -c ouch --condition \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a compress -d \22Compress one or more files into one output file [aliases: c]\22\0Acomplete -c ouch --condition \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a decompress -d \22Decompresses one or more files, optionally into another folder [aliases: d]\22\0Acomplete -c ouch --condition \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a list -d \22List contents of an archive [aliases: l]\22\0Acomplete -c ouch --condition \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a help -d \22Print this message or the help of the given subcommand(s)\22\0A\0A# options completions\0Acomplete -c ouch -s y -l yes -d \22Skip [Y/n] questions positively\22\0Acomplete -c ouch -s n -l no -d \22Skip [Y/n] questions negatively\22\0Acomplete -c ouch -s A -l accessible -d \22Activate accessibility mode, reducing visual noise [env: ACCESSIBLE=]\22\0Acomplete -c ouch -s H -l hidden -d \22Ignores hidden files\22\0Acomplete -c ouch -s g -l gitignore -d \22Ignores files matched by git's ignore files\22\0Acomplete -c ouch -s h -l help -d \22Print help information (use `--help` for more detail)\22\0Acomplete -c ouch -s V -l version -d \22Print version information\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2265 = private unnamed_addr constant [19 x i8] c"completions/p4.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2266 = private unnamed_addr constant [41769 x i8] c"# Fish completions for Perforce (p4) SCM\0A# Based on the list of commands from\0A# https://www.perforce.com/perforce/r16.1/manuals/cmdref/\0A# Author: Boris Aranovich https://github.com/nomaed\0A\0A#########################################################\0A### p4 command parsing\0A#########################################################\0A\0Afunction __fish_print_p4_client_name -d \22Use `p4 info` output to query for current client name\22\0A    set -l p4info (p4 info -s 2> /dev/null)\0A    if string match -qr '^Client unknown' $p4info\0A        return\0A    end\0A    string match -r '^Client name: .+' $p4info | string replace 'Client name: ' ''\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_user_name -d \22Use `p4 info` output to query for current client name\22\0A    string match -r '^User name: .+' (p4 info 2> /dev/null) | string replace 'User name: ' ''\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_changelists -d \22Reformat output from `p4 changes` to simple format. Specify 'detailed!' as first argument to use username@workspace prefix\22\0A    set -l detailed\0A    if test -n \22$argv\22\0A        and test $argv[1] = \22detailed!\22\0A        set detailed true\0A        set -e argv[1]\0A    end\0A\0A    # The format of `p4 changes -L` is as follows, for each changelist:\0A    # Change 1234 on YYYY/MM/DD by user@workspace *status*\\n\0A    # \\n\0A    #   \\t  Description text line\\n\0A    #   \\t  Description text another line\\n\0A    # \\n\0A    set -l changes (p4 changes -L $argv)\0A\0A    set -l result\0A    for line in (string trim -- $changes)\0A        if test -z \22$line\22\0A            continue\0A        end\0A        # see output format ^^^\0A        set -l change_match (string match -ar '^Change ([0-9]+) on [0-9/]+ by (\\S+).*$' -- $line)\0A        if test -n \22$change_match\22\0A            if test -n \22$result\22\0A                echo $result\0A                set result\0A            end\0A            set result $change_match[2]\\t\0A            if test -n \22$detailed\22\0A                set result $result $change_match[3]:\0A            end\0A        else\0A            set -a result $line\0A        end\0A    end\0A\0A    if test -n \22$result\22\0A        echo $result\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_opened_files -d \22Use `p4 diff` to output the names of all opened files\22\0A    # p4 opened -s | sed 's/#.*//' | p4 -x - where | awk '/^\\// {print $3}'\0A    # p4 opened -s | string replace -ar '(^\\S+).*$' '$1' | p4 -x - where | string replace -ar '\\S+\\s\\S+\\s(\\S+)' '$1'\0A    string replace -a \22$PWD/\22 '' (p4 diff -sa -sb -sr)\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_branches -d \22Prints the list of all defined branches on the server\22\0A    set -l branches (p4 branches)\0A    for branch in $branches\0A        # \22Branch branch-name YYYY/MM/DD 'description text'\22\0A        set -l matches (string match -ar '^Branch\\s+(\\S+)[^\\']+\\'(.+)\\'$' $branch)\0A        if not set -q matches[2]\0A            # skip $branch if no match for branch name with description\0A            continue\0A        end\0A        # matches[2] = branch name; matches[3] = description\0A        echo -n $matches[2]\0A        if not set -q matches[3]\0A            echo -n \\t$matches[3]\0A        end\0A        echo\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_streams\0A    # I do not have an example of p4 streams output\0A    #p4 streams 2> /dev/null\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_users -d \22Lists perforce users suitable for list of completions\22\0A    # `p4 users` output format:\0A    #   \22username <email@address> (Full Name) accessed YYYY/MM/DD\22\0A    # function will output it as:\0A    #   username[TAB]Full Name <email@address>\0A    string replace -ar '(^\\S+) <([^>]+)> \\(([^\\)]+)\\).*$' '$1'\\t'$3 <$2>' (p4 users)\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_workspaces -d \22Lists current user's workspaces\22\0A    set -l user (__fish_print_p4_user_name)\0A    if test -z \22$user\22\0A        return\0A    end\0A    # \22Client clientname YYYY/MM/DD root /home/user/workspace/path 'description text'\22\0A    string replace -ar '^Client (\\S+) \\S+ root (\\S+) \\'(.+)\\'$' '$1'\\t'$3' (p4 clients -u $user)\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_workspace_changelists -d \22Lists all changelists for current user\22\0A    set -l client (__fish_print_p4_client_name)\0A    if test -n \22$client\22\0A        __fish_print_p4_changelists -c $client $argv\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_pending_changelists -d \22Lists all *pending* changelists. If 'default' argument is provided, default changelist will also be listed\22\0A    if set -q argv[1]\0A        and test $argv[1] = default\0A        echo default\\tDefault changelist\0A    end\0A    __fish_print_p4_workspace_changelists -s pending\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_shelved_changelists -d \22Lists all changelists with *shelved* files\22\0A    __fish_print_p4_workspace_changelists -s shelved\0Aend\0A\0A#########################################################\0A### completion helpers\0A#########################################################\0A\0Afunction __fish_print_p4_commands_list -d \22Lists p4 commands\22\0A    set -l commands add annotate attribute branch branches change changes changelist changelists clean client clients copy counter counters cstat delete depot depots describe diff diff2 dirs edit filelog files fix fixes flush fstat grep group groups have help info integ integrate integrated interchanges istat job jobs key keys label labels labelsync list lock logger login logout merge move opened passwd populate print protect protects prune rec reconcile rename reopen resolve resolved revert review reviews set shelve status sizes stream streams submit sync tag tickets unlock unshelve update user users where workspace workspaces\0A    for i in $commands\0A        echo $i\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_env_vars -d \22Lists environment variables that can be consumed by perforce\22\0A    set -l env_vars P4CLIENT P4PORT P4PASSWD P4USER P4CONFIG P4DIFF P4EDITOR P4MERGE P4CHARSET P4TRUST P4PAGER PWD TMP TEMP P4TICKETS P4LANGUAGE P4LOGINSSO P4COMMANDCHARSET P4DIFFUNICODE P4MERGEUNICODE P4CLIENTPATH P4AUDIT P4JOURNAL P4LOG P4PORT P4ROOT P4DEBUG P4NAME P4SSLDIR\0A    for var in $env_vars\0A        echo $var\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_file_types -d \22Lists all of available file modes\22\0A    set -l base_types text binary symlink apple resource unicode utf16\0A    for type in $base_types\0A        printf '%s\\t%s\\n' $type+m 'always set modtime' $type+w 'always writeable' $type+x 'exec bit set' $type+k '$Keyword$ expansion of Id, Header, Author, Date, DateUTC, DateTime, DateTimeUTC, DateTimeTZ, Change, File, Revision' $type+ko '$Keyword$ expansion of Id, Header only' $type+l 'exclusive open: disallow multiple opens' $type+C 'server stores compressed file per revision' $type+D 'server stores deltas in RCS format' $type+F 'server stores full file per revision' $type+S 'server stores only single head rev., or specify number to <n> of revisions' $type+X 'server runs archive trigger to access files'\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_help_keywords -d \22Keywords for `p4 help`\22\0A    echo administration\\t\22Help on specialized administration topics\22\0A    echo charset\\t\22Describes how to control Unicode translation\22\0A    echo commands\\t\22Lists all the Perforce commands\22\0A    echo configurables\\t\22Describes all of the server configuration variables\22\0A    echo dvcs\\t\22Describes decentralized version control with Perforce\22\0A    echo environment\\t\22Lists the Perforce environment variables and their meanings\22\0A    echo filetypes\\t\22Lists the Perforce filetypes and their meanings\22\0A    echo jobview\\t\22Describes Perforce jobviews\22\0A    echo legal\\t\22Legal and license information\22\0A    echo networkaddress\\t\22Help on network address syntax\22\0A    echo replication\\t\22Describes specialized replication topics\22\0A    echo revisions\\t\22Describes Perforce revision specifiers\22\0A    echo simple\\t\22Provides short descriptions of the eight most basic Perforce commands\22\0A    echo usage\\t\22Lists the six options available with all Perforce commands\22\0A    echo views\\t\22Describes the meaning of Perforce views\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_diff_options -d \22Options for `p4 diff -d`\22\0A    echo n\\t\22RCS output format, showing additions and deletions made to the file and associated line ranges\22\0A    echo c\\t\22context output format, showing line number ranges and N lines of context around the changes\22 #\0A    echo s\\t\22summary output format, showing only the number of chunks and lines added, deleted, or changed\22\0A    echo u\\t\22unified output format, showing added and deleted lines with N lines of context, in a form compatible with the patch(1) utility\22 #\0A    echo l\\t\22ignore line-ending (CR/LF) convention when finding diffs\22\0A    echo b\\t\22ignore changes made within whitespace; this option implies -dl\22\0A    echo w\\t\22ignore whitespace altogether; this option implies -dl\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_resolve_options -d \22Options for `p4 merge` using -a, -A and -d\22\0A    switch \22$argv[1]\22\0A        case a\0A            echo m\\t\22Automatic: accept the Perforce-recommended file revision (yours, their, merge)\22\0A            echo y\\t\22Accept Yours, ignore theirs\22\0A            echo t\\t\22Accept Theirs\22\0A            echo s\\t\22Safe Accept: merge if no conflict, ignore file otherwise\22\0A            echo f\\t\22Force Accept: conflicted changes will leave conflict markers in the file\22\0A        case A\0A            echo b\\t\22Resolve attributes set by p4 attribute\22\0A            echo b\\t\22Resolve file branching; that is, integrations where the source is edited and the target is deleted\22\0A            echo c\\t\22Resolve file content changes\22\0A            echo d\\t\22Integrations where the source is deleted and target is deleted\22\0A            echo t\\t\22Filetype changes\22\0A            echo m\\t\22Move and renames\22\0A        case d\0A            echo b\\t\22Ignore whitespace-only changes (for instance, a tab replaced by eight spaces)\22\0A            echo w\\t\22Ignore whitespace altogether (for instance, deletion of tabs or other whitespace)\22\0A            echo l\\t\22Ignore differences in line-ending convention\22\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_parallel_options -d \22Values for --parallel option in various commands\22\0A    set -l mode\0A    if test -n \22$argv\22\0A        set mode $argv[1]\0A    end\0A\0A    # for now only looks that mode is set, later it will need to have a specific setting\0A    echo 'threads='\\t\22sends files concurrently using N independent network connections\22\0A    echo 'batch='\\t\22specifies the number of files in a batch\22\0A    test -n \22$mode\22\0A    or echo 'batchsize='\\t\22specifies the number of bytes in a batch\22\0A    echo 'min='\\t\22specifies the minimum number of files in a parallel sync\22\0A    test -n \22$mode\22\0A    or echo 'minsize='\\t\22specifies the minimum number of bytes in a parallel sync\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_submit_options -d \22Options for `p4 submit`\22\0A    echo 'submitunchanged'\\t\22Submit all open files (default behavior)\22\0A    echo 'submitunchanged+reopen'\\t\22Submit all open files + reopen to default changelist\22\0A    echo 'revertunchanged'\\t\22Revert unmodified files, submit all the rest\22\0A    echo 'revertunchanged+reopen'\\t\22Revert unmodified files, submit all the rest + reopen them in default changelist\22\0A    echo 'leaveunchanged'\\t\22Move unchanged files to default changelist, submit all the rest\22\0A    echo 'leaveunchanged+reopen'\\t\22Submit only modified files + reopen all (modified and unmodified) in default changelist\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_noretransfer_options -d \22Options for `p4 submit --noretransfer`\22\0A    echo 1\\t\22server avoids re-transferring files that have already been archived after a failed submit operation\22\0A    echo 0\\t\22server re-transfers all files after a failed submit operation\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_integrate_output_options -d \22Options for `p4 resolve -O`\22\0A    echo b\\t\22outputs the base revision for the merge (if any)\22\0A    echo r\\t\22outputs the resolves that are being scheduled\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_print_p4_integrate_resolve_options -d \22Options for `p4 resolve -R`\22\0A    echo b\\t\22schedules a branch resolve instead of branching the target files automatically\22\0A    echo d\\t\22schedules a delete resolve instead of deleting the target files automatically\22\0A    echo s\\t\22skips cherry-picked revisions that have already been integrated\22\0Aend\0A\0A#########################################################\0A\0Afunction __fish_p4_not_in_command -d \22Checks that prompt is not inside of p4 command\22\0A    for i in (commandline -xpc)\0A        if contains -- $i (__fish_print_p4_commands_list)\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0A#########################################################\0A\0A# Perforce command is a single word that comes either as first argument\0A# or directly after global options.\0A# To test whether we're in command, it's enough that a command will appear\0A# in the arguments, even though if more than a single command is specified,\0A# p4 will complain.\0Afunction __fish_p4_is_using_command -d \22Checks if prompt is in a specific command\22\0A    if contains -- $argv[1] (commandline -xpc)\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A#########################################################\0A\0Afunction __fish_p4_register_command -d \22Adds a completion for a specific command\22\0A    complete -c p4 -n __fish_p4_not_in_command -a $argv[1] $argv[2..-1]\0Aend\0A\0A#########################################################\0A\0Afunction __fish_p4_register_command_option -d \22Adds a specific option for a command\22\0A    complete -c p4 -n \22__fish_p4_is_using_command $argv[1]\22 $argv[2..-1]\0Aend\0A\0A#########################################################\0A### global options -- can be used before any command\0A#########################################################\0A\0Acomplete -c p4 -n __fish_p4_not_in_command -s b -x -d 'Number of arguments when using -x flag'\0Acomplete -c p4 -n __fish_p4_not_in_command -s c -x -d 'Overrides P4CLIENT settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s d -r -d 'Overrides PWD settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s I -d 'Show process indicators'\0Acomplete -c p4 -n __fish_p4_not_in_command -s G -d 'python dict in/output'\0Acomplete -c p4 -n __fish_p4_not_in_command -s H -x -a '(__fish_print_hostnames)' -d 'Overrides P4HOST settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s p -x -d 'Overrides P4PORT settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s P -x -d 'Overrides P4PASSWD settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s r -x -d 'Number of retry attempts'\0Acomplete -c p4 -n __fish_p4_not_in_command -s s -d 'Prefix for each line'\0Acomplete -c p4 -n __fish_p4_not_in_command -s u -x -a '(__fish_print_p4_users)' -d 'Overrides P4USER/USER/USERNAME settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s x -r -d 'Read arguments from file'\0Acomplete -c p4 -n __fish_p4_not_in_command -s C -x -a '(__fish_print_encodings)' -d 'Overrides P4CHARSET settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s Q -x -a '(__fish_print_encodings)' -d 'Overrides P4COMMANDCHARSET settings'\0Acomplete -c p4 -n __fish_p4_not_in_command -s L -x -d 'Feature reserved for system integrators'\0Acomplete -c p4 -n __fish_p4_not_in_command -s z -x -d 'fstat output'\0Acomplete -c p4 -n __fish_p4_not_in_command -s q -d 'Quiet mode'\0Acomplete -c p4 -n __fish_p4_not_in_command -s V -d 'Display version'\0Acomplete -c p4 -n __fish_p4_not_in_command -s h -d 'Display help'\0A\0A#########################################################\0A### sub-commands\0A#########################################################\0A\0A__fish_p4_register_command add -d \22Open a new file to add it to the depot\22\0A__fish_p4_register_command annotate -d \22Print file lines along with their revisions\22\0A__fish_p4_register_command attribute -f -d \22Set per-revision attributes on revisions\22\0A__fish_p4_register_command branch -f -d \22Create or edit a branch specification\22\0A__fish_p4_register_command branches -f -d \22Display list of branches\22\0A__fish_p4_register_command cha