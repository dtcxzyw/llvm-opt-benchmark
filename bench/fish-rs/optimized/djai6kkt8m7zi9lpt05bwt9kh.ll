@anon.1d0b41a8d45d477c3029ec78f9b8b434.1382 = private unnamed_addr constant [779 x i8] c"complete -c conjure -o monitor -d 'Monitor progress'\0Acomplete -c conjure -o quiet -d 'Suppress all warning messages'\0Acomplete -c conjure -o regard-warnings -d 'Pay attention to warning messages'\0Acomplete -c conjure -o seed -d 'Seed a new sequence of pseudo-random numbers [value]'\0Acomplete -c conjure -o verbose -d 'Print detailed information about the image'\0Acomplete -c conjure -o debug -d 'Display copious debugging information [events]' -xa '(convert -list debug)'\0Acomplete -c conjure -o help -d 'Print program options'\0Acomplete -c conjure -o log -d 'Format of debugging information [format]' -xa '(__fish_complete_convert_options format)'\0A#complete -c conjure -o list                         -d 'Print a list of supported option arguments [type]' -xa '(convert -list list)'\0A", align 1
