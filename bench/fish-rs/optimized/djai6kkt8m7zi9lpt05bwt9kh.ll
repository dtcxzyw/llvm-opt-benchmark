@anon.1d0b41a8d45d477c3029ec78f9b8b434.1044 = private unnamed_addr constant [1277 x i8] c"#\0A# Command specific completions for the acpi command.\0A# These completions where generated from the commands\0A# man page by the make_completions.py script, but may\0A# have been hand edited since.\0A#\0A\0Acomplete -c acpi -s b -l battery -d 'Show battery information'\0Acomplete -c acpi -s B -l without-battery -d 'Suppress battery information'\0Acomplete -c acpi -s t -l thermal -d 'Show thermal information'\0Acomplete -c acpi -s T -l without-thermal -d 'Suppress thermal information'\0Acomplete -c acpi -s a -l ac-adapter -d 'Show ac adapter information'\0Acomplete -c acpi -s A -l without-ac-adapter -d 'Suppress ac-adapter information'\0Acomplete -c acpi -s V -l everything -d 'Show every device, overrides above options'\0Acomplete -c acpi -s s -l show-empty -d 'Show non-operational devices'\0Acomplete -c acpi -s S -l hide-empty -d 'Hide non-operational devices'\0Acomplete -c acpi -s c -l cooling -d 'Show cooling device information'\0Acomplete -c acpi -s f -l fahrenheit -d 'Use fahrenheit as the temperature unit'\0Acomplete -c acpi -s k -l kelvin -d 'Use kelvin as the temperature unit'\0Acomplete -c acpi -s d -l directory -d '<dir> path to ACPI info (/proc/acpi)'\0Acomplete -c acpi -s h -l help -d 'Display help and exit'\0Acomplete -c acpi -s v -l version -d 'Output version information and exit'\0A", align 1
