@anon.1d0b41a8d45d477c3029ec78f9b8b434.1036 = private unnamed_addr constant [1682 x i8] c"function __fish_complete_abook_formats --description 'Complete abook formats'\0A    set -l format\0A    abook --formats | while read -l x\0A        switch $x\0A            case \22input formats:\22\0A                set format input\0A            case \22output formats:\22\0A                set format output\0A            case \22query-compatible output formats:\22\0A                set format ignore\0A        end\0A        set --append \22$format\22 (string replace -rf '\\t(.*\\t.*)' '$1' -- $x)\0A    end\0A    switch $argv[1]\0A        case in\0A            for l in $input\0A                echo $l\0A            end\0A        case out\0A            for l in $output\0A                echo $l\0A            end\0A        case '*'\0A            return 1\0A    end\0Aend\0A\0Acomplete -c abook -s h -d 'Show usage'\0Acomplete -c abook -s C -l config -d 'Use an alternative configuration file' -r\0Acomplete -c abook -l datafile -d 'Use an alternative addressbook file' -r\0Acomplete -c abook -l mutt-query -d 'Make a query for mutt' -x\0Acomplete -c abook -l add-email -d 'Read email message from stdin and add the sender'\0Acomplete -c abook -l add-email-quiet -d 'Same as --add-email. Without confirmation'\0Acomplete -c abook -l convert -d 'Convert address book files'\0A\0Aset -l convert 'contains -- --convert (commandline -px)'\0Acomplete -c abook -l informat -d 'Input file format' -xa '(__fish_complete_abook_formats in)' -n $convert\0Acomplete -c abook -l outformat -d 'Output file format' -xa '(__fish_complete_abook_formats out)' -n $convert\0Acomplete -c abook -l infile -d 'Input file (default: stdin)' -r -n $convert\0Acomplete -c abook -l outfile -d 'Output file (default: stdout)' -r -n $convert\0A\0Acomplete -c abook -l formats -d 'Print available formats'\0A", align 1
