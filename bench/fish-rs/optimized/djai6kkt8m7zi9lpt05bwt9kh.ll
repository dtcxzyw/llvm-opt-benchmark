@anon.1d0b41a8d45d477c3029ec78f9b8b434.1628 = private unnamed_addr constant [1316 x i8] c"function __findstr_generate_args --description 'Function to generate args'\0A    set --local current_token (commandline --current-token --cut-at-cursor)\0A    switch $current_token\0A        case '/a:*'\0A            echo -e '0\\tBlack\0A1\\tBlue\0A2\\tGreen\0A3\\tAqua\0A4\\tRed\0A5\\tPurple\0A6\\tYellow\0A7\\tWhite\0A8\\tGray\0A9\\tLight blue\0AA\\tLight green\0AB\\tLight aqua\0AC\\tLight red\0AD\\tLight purple\0AE\\tLight yellow\0AF\\tBright white' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A        case '*'\0A            echo -e '/b\\tMatch at the beginning of the line\0A/e\\tMatch at the end of the line\0A/l\\tUse literal strings\0A/r\\tUse regular expressions\0A/s\\tSearch a current directory and all subdirectories\0A/i\\tIgnore case\0A/x\\tMatch exactly\0A/v\\tInvert match\0A/n\\tPrint line numbers\0A/m\\tPrint only the file name with matching lines\0A/o\\tPrint character offset\0A/p\\tSkip files with non-printable characters\0A/off\\tDon\\'t skip files that have the offline attribute set\0A/offline\\tDon\\'t skip files that have the offline attribute set\0A/f:\\tRead a file list from file\0A/c:\\tSpecify a literal search string\0A/g:\\tRead literal search strings from file\0A/d:\\tSpecify the search list of directories\0A/a:\\tUse color attributes with two hexadecimal digits\0A/?\\tShow help'\0A    end\0Aend\0A\0Acomplete --command findstr --no-files --arguments '(__findstr_generate_args)'\0A", align 1
