@anon.1d0b41a8d45d477c3029ec78f9b8b434.3156 = private unnamed_addr constant [1552 x i8] c"function __fish_complete_pgrep -d 'Complete pgrep/pkill' --argument-names cmd\0A    complete -c $cmd -xa '(__fish_complete_proc)'\0A    complete -c $cmd -s f -d 'Match pattern against full command line'\0A    complete -c $cmd -s g -d 'Only match processes in the process group' -xa '(__fish_complete_list , __fish_complete_groups)'\0A    complete -c $cmd -s G -d \22Only match processes whose real group ID is listed. Group 0 is translated into $cmd\\'s own process group\22 -xa '(__fish_complete_list , __fish_complete_groups)'\0A    complete -c $cmd -s n -d 'Select only the newest process'\0A    complete -c $cmd -s o -d 'Select only the oldest process'\0A    complete -c $cmd -s P -d 'Only match processes whose parent process ID is listed' -xa '(__fish_complete_list , __fish_complete_pids)'\0A    complete -c $cmd -s s -d \22Only  match  processes  whose  process  session  ID  is listed.  Session ID 0 is translated into $cmd\\'s own session ID.\22\0A    complete -c $cmd -s t -d 'Only match processes whose controlling terminal is listed.  The terminal name should  be  specified without the \22/dev/\22 prefix' -r\0A    complete -c $cmd -s u -d 'Only  match  processes  whose  effective  user ID is listed' -xa '(__fish_complete_list , __fish_complete_users)'\0A    complete -c $cmd -s U -d 'Only match processes whose real user ID is listed' -xa '(__fish_complete_list , __fish_complete_users)'\0A    complete -c $cmd -s v -d 'Negates the matching'\0A    complete -c $cmd -s x -d ' Only match processes whose name (or command line if -f is specified) exactly match the pattern'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3157 = private unnamed_addr constant [35 x i8] c"functions/__fish_complete_pids.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3158 = private unnamed_addr constant [620 x i8] c"function __fish_complete_pids -d \22Print a list of process identifiers along with brief descriptions\22\0A    # This may be a bit slower, but it's nice - having the tty displayed is really handy\0A    # 'tail -n +2' deletes the first line, which contains the headers\0A    #  $fish_pid is removed from output by string match -r -v\0A\0A    # Display the tty if available\0A    # But not if it's just question marks, meaning no tty\0A    __fish_ps -o pid,comm,tty | string match -r -v '^\\s*'$fish_pid'\\s' | tail -n +2 | string replace -r ' *([0-9]+) +([^ ].*[^ ]|[^ ]) +([^ ]+) *$' '$1\\t$2 [$3]' | string replace -r ' *\\[\\?*\\] *$' ''\0Aend\0A", align 1
