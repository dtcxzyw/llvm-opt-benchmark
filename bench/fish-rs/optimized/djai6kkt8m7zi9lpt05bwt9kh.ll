@anon.1d0b41a8d45d477c3029ec78f9b8b434.3418 = private unnamed_addr constant [433 x i8] c"function export --description 'Set env variable. Alias for `set -gx` for bash compatibility.'\0A    if not set -q argv[1]\0A        set -x\0A        return 0\0A    end\0A    for arg in $argv\0A        set -l v (string split -m 1 \22=\22 -- $arg)\0A        set -l value\0A        switch (count $v)\0A            case 1\0A                set value $$v[1]\0A            case 2\0A                set value $v[2]\0A        end\0A        set -gx $v[1] $value\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3419 = private unnamed_addr constant [28 x i8] c"functions/fish_add_path.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3420 = private unnamed_addr constant [4383 x i8] c"function fish_add_path --description \22Add paths to the PATH\22\0A    # This is meant to be the easy one-stop shop to adding stuff to $PATH.\0A    # By default it'll prepend the given paths to a universal $fish_user_paths, excluding the already-included ones.\0A    #\0A    # That means it can be executed once in an interactive session, or stuffed in config.fish,\0A    # and it will do The Right Thing.\0A    #\0A    # The options:\0A    # --prepend or --append to select whether to put the new paths first or last\0A    # --global or --universal to decide whether to use a universal or global fish_user_paths\0A    # --path to set $PATH instead\0A    # --move to move existing entries instead of ignoring them\0A    # --verbose to print the set-command used\0A    # --dry-run to print the set-command without running it\0A    # We do not allow setting $PATH universally.\0A    #\0A    # It defaults to keeping $fish_user_paths or creating a universal, prepending and ignoring existing entries.\0A    argparse -x g,U -x P,U -x a,p g/global U/universal P/path p/prepend a/append h/help m/move v/verbose n/dry-run -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help fish_add_path\0A        return 0\0A    end\0A\0A    set -l scope $_flag_global $_flag_universal\0A    if not set -q scope[1]; and not set -q fish_user_paths\0A        set scope -U\0A    end\0A\0A    set -l var fish_user_paths\0A    set -q _flag_path\0A    and set var PATH\0A    # $PATH should be global\0A    and set scope -g\0A    set -l mode $_flag_prepend $_flag_append\0A    set -q mode[1]; or set mode -p\0A\0A    # Enable verbose mode if we're interactively used\0A    status current-command | string match -rq '^fish_add_path$'\0A    and isatty stdout\0A    and set -l _flag_verbose yes\0A\0A    # To keep the order of our arguments, go through and save the ones we want to keep.\0A    set -l newpaths\0A    set -l indexes\0A    for path in $argv\0A        # Realpath allows us to canonicalize the path, which is needed for deduplication.\0A        # We could add a non-canonical version of the given path if no duplicate exists, but tbh that's a recipe for disaster.\0A\0A        # realpath complains if a parent directory does not exist, so we silence stderr.\0A        set -l p (builtin realpath -s -- $path 2>/dev/null)\0A\0A        # Ignore non-existing paths\0A        if not test -d \22$p\22\0A            # path does not exist\0A            if set -q _flag_verbose\0A                # print a message in verbose mode\0A                if test -f \22$p\22\0A                    printf (_ \22Skipping path because it is a file instead of a directory: %s\\n\22) \22$p\22\0A                else\0A                    printf (_ \22Skipping non-existent path: %s\\n\22) \22$p\22\0A                end\0A            end\0A            continue\0A        end\0A\0A        if set -l ind (contains -i -- $p $$var)\0A            # In move-mode, we remove it from its current position and add it back.\0A            if set -q _flag_move; and not contains -- $p $newpaths\0A                set -a indexes $ind\0A                set -a newpaths $p\0A            else if set -q _flag_verbose\0A                printf (_ \22Skipping already included path: %s\\n\22) \22$p\22\0A            end\0A        else if not contains -- $p $newpaths\0A            # Without move, we only add it if it's not in.\0A            set -a newpaths $p\0A        end\0A    end\0A\0A    # Ensure the variable is only set once, by constructing a new variable before.\0A    # This is to stop any handlers or anything from firing more than once.\0A    set -l newvar $$var\0A    if set -q _flag_move; and set -q indexes[1]\0A        # We remove in one step, so the indexes don't move.\0A        set -e newvar[\22$indexes\22]\0A    end\0A    set $mode newvar $newpaths\0A\0A    # Finally, only set if there is anything *to* set.\0A    # This saves us from setting, especially in the common case of someone putting this in config.fish\0A    # to ensure a path is in $PATH.\0A    if set -q newpaths[1]; or set -q indexes[1]\0A        if set -q _flag_verbose; or set -q _flag_n\0A            # The escape helps make it unambiguous - so you see whether an argument includes a space or something.\0A            echo (string escape -- set $scope $var $newvar)\0A        end\0A\0A        not set -q _flag_n\0A        and set $scope $var $newvar\0A        return 0\0A    else\0A        if set -q _flag_verbose\0A            # print a message in verbose mode\0A            printf (_ \22No paths to add, not setting anything.\\n\22) \22$p\22\0A        end\0A        return 1\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3421 = private unnamed_addr constant [37 x i8] c"functions/fish_breakpoint_prompt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3422 = private unnamed_addr constant [958 x i8] c"# Define the default debugging prompt command.\0Afunction fish_breakpoint_prompt --description \22A right prompt to be used when `breakpoint` is executed\22\0A    set -l saved_status $status\0A    set -l function (status -L0 function)\0A    set -l line (status -L0 line-number)\0A    # At the moment we don't include the filename because, even if we truncate it, it makes the\0A    # prompt too long.\0A    #set -l filename (status filename)\0A    #set -l prompt \22$filename:$function:$line >\22\0A    set -l prompt \22$function:$line\22\0A    if test $saved_status -ne 0\0A        set prompt \22$prompt [!$saved_status]\22\0A    end\0A    set prompt \22$prompt > \22\0A\0A    # Make sure the prompt doesn't consume more than half the terminal width.\0A    set -l max_len (math \22$COLUMNS / 2\22)\0A    if test (string length -- $prompt) -gt $max_len\0A        set prompt ...(string sub -s -(math $max_len - 3) -- $prompt)\0A    end\0A\0A    echo -ns (set_color $fish_color_status) \22BP $prompt\22 (set_color normal) ' '\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3423 = private unnamed_addr constant [34 x i8] c"functions/fish_clipboard_copy.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3424 = private unnamed_addr constant [1903 x i8] c"function fish_clipboard_copy\0A    set -l cmdline\0A    if isatty stdin\0A        # Copy the current selection, or the entire commandline if that is empty.\0A        # Don't use `string collect -N` here - `commandline` adds a newline.\0A        set cmdline (commandline --current-selection | __fish_indent --only-indent | string collect)\0A        test -n \22$cmdline\22; or set cmdline (commandline | __fish_indent --only-indent | string collect)\0A    else\0A        # Read from stdin\0A        while read -lz line\0A            set -a cmdline $line\0A        end\0A    end\0A\0A    if type -q pbcopy\0A        printf '%s' $cmdline | pbcopy\0A    else if set -q WAYLAND_DISPLAY; and type -q wl-copy\0A        printf '%s' $cmdline | wl-copy &\0A        disown\0A    else if set -q DISPLAY; and type -q xsel\0A        printf '%s' $cmdline | xsel --clipboard\0A    else if set -q DISPLAY; and type -q xclip\0A        printf '%s' $cmdline | xclip -selection clipboard\0A    else if type -q clip.exe\0A        printf '%s' $cmdline | clip.exe\0A    end\0A\0A    # Copy with OSC 52; useful if we are running in an SSH session or in\0A    # a container.\0A    if type -q base64 && [ \22$TERM\22 != dumb ]\0A        if not isatty stdout\0A            echo \22fish_clipboard_copy: stdout is not a terminal\22 >&2\0A            return 1\0A        end\0A        set -l encoded (printf %s $cmdline | base64 | string join '')\0A        printf '\\e]52;c;%s\\a' \22$encoded\22\0A        # tmux requires user configuration to interpret OSC 52 on stdout.\0A        # Luckily we can still make this work for the common case by bypassing\0A        # tmux and writing to its underlying terminal.\0A        if set -q TMUX\0A            set -l tmux_tty (tmux display-message -p '#{client_tty}')\0A            or return 1\0A            # The terminal might not be writable if we switched user.\0A            if test -w $tmux_tty\0A                printf '\\e]52;c;%s\\a' \22$encoded\22 >$tmux_tty\0A            end\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3425 = private unnamed_addr constant [35 x i8] c"functions/fish_clipboard_paste.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3426 = private unnamed_addr constant [891 x i8] c"function fish_clipboard_paste\0A    set -l data\0A    if type -q pbpaste\0A        set data (pbpaste 2>/dev/null | string collect -N)\0A    else if set -q WAYLAND_DISPLAY; and type -q wl-paste\0A        set data (wl-paste -n 2>/dev/null | string collect -N)\0A    else if set -q DISPLAY; and type -q xsel\0A        set data (xsel --clipboard | string collect -N)\0A    else if set -q DISPLAY; and type -q xclip\0A        set data (xclip -selection clipboard -o 2>/dev/null | string collect -N)\0A    else if type -q powershell.exe\0A        set data (powershell.exe Get-Clipboard | string trim -r -c \\r | string collect -N)\0A    end\0A\0A    # Issue 6254: Handle zero-length clipboard content\0A    if not string length -q -- \22$data\22\0A        return 1\0A    end\0A\0A    if not isatty stdout\0A        # If we're redirected, just write the data *as-is*.\0A        printf %s $data\0A        return\0A    end\0A\0A    __fish_paste $data\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3427 = private unnamed_addr constant [37 x i8] c"functions/fish_command_not_found.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3428 = private unnamed_addr constant [3496 x i8] c"### Command-not-found handlers\0A# This can be overridden by defining a new fish_command_not_found function\0A\0A# Read the OS/Distro from /etc/os-release.\0A# This has a \22ID=\22 line that defines the exact distribution,\0A# and an \22ID_LIKE=\22 line that defines what it is derived from or otherwise like.\0A# For our purposes, we use both.\0Aset -l os\0Aif test -r /etc/os-release\0A    set os (string match -r '^ID(?:_LIKE)?\\s*=.*' < /etc/os-release | \\\0A    string replace -r '^ID(?:_LIKE)?\\s*=(.*)' '$1' | string trim -c '\\'\22' | string split \22 \22)\0Aend\0A\0Afunction __fish_default_command_not_found_handler\0A    printf (_ \22fish: Unknown command: %s\\n\22) (string escape -- $argv[1]) >&2\0Aend\0A\0A# If an old handler already exists, defer to that.\0Aif functions -q __fish_command_not_found_handler\0A    function fish_command_not_found\0A        # The fish_command_not_found event was removed in fish 3.2.0,\0A        # and future versions of fish will just call a function called \22fish_command_not_found\22.\0A        # You have defined a custom handler, we suggest renaming it to \22fish_command_not_found\22.\0A        __fish_command_not_found_handler $argv\0A    end\0A    # First check if we are on OpenSUSE since SUSE's handler has no options\0A    # but the same name and path as Ubuntu's.\0Aelse if contains -- suse $os || contains -- sles $os && type -q command-not-found\0A    function fish_command_not_found\0A        command-not-found $argv[1]\0A    end\0A    # Check for Fedora's handler\0Aelse if test -f /usr/libexec/pk-command-not-found\0A    function fish_command_not_found\0A        /usr/libexec/pk-command-not-found $argv\0A    end\0A    # Check in /usr/lib, where Ubuntu places this command\0Aelse if test -f /usr/lib/command-not-found\0A    function fish_command_not_found\0A        /usr/lib/command-not-found -- $argv[1]\0A    end\0A    # Check for NixOS handler\0Aelse if test -f /run/current-system/sw/bin/command-not-found\0A    function fish_command_not_found\0A        /run/current-system/sw/bin/command-not-found $argv\0A    end\0A    # Ubuntu Feisty places this command in the regular path instead\0Aelse if type -q command-not-found\0A    function fish_command_not_found\0A        command-not-found -- $argv[1]\0A    end\0A    # pkgfile is an optional, but official, package on Arch Linux\0A    # it ships with example handlers for bash and zsh, so we'll follow that format\0Aelse if type -q pkgfile\0A    function fish_command_not_found\0A        set -l __packages (pkgfile --binaries --verbose -- $argv[1] 2>/dev/null)\0A        if test $status -eq 0\0A            printf \22%s may be found in the following packages:\\n\22 \22$argv[1]\22\0A            printf \22  %s\\n\22 $__packages\0A        else\0A            __fish_default_command_not_found_handler $argv[1]\0A        end\0A    end\0A    # pacman is too slow, see #7841.\0A    # else if type -q pacman\0A    #     function fish_command_not_found\0A    #         set -l paths $argv[1]\0A    #         # If we've not been given an absolute path, try $PATH as the starting point,\0A    #         # otherwise pacman will try *every path*, and e.g. bash-completion\0A    #         # isn't helpful.\0A    #         string match -q '/*' -- $argv[1]; or set paths $PATH/$argv[1]\0A    #         # Pacman only prints the path, so we still need to print the error.\0A    #         __fish_default_command_not_found_handler $argv[1]\0A    #         pacman -F $paths\0A    #     end\0Aelse\0A    # Use standard fish command not found handler otherwise\0A    function fish_command_not_found --on-event fish_command_not_found\0A        __fish_default_command_not_found_handler $argv\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3429 = private unnamed_addr constant [38 x i8] c"functions/fish_commandline_append.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3430 = private unnamed_addr constant [544 x i8] c"function fish_commandline_append --description \22Append the given string to the command-line, or remove the suffix if already there\22\0A    if not commandline | string length -q\0A        commandline -r $history[1]\0A    end\0A\0A    set -l escaped (string escape --style=regex -- $argv[1])\0A    set -l job (commandline -j | string collect)\0A    if set job (string replace -r -- $escaped\\$ \22\22 $job)\0A        set -l cursor (commandline -C)\0A        commandline -rj -- $job\0A        commandline -C $cursor\0A    else\0A        commandline -aj -- $argv[1]\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3431 = private unnamed_addr constant [39 x i8] c"functions/fish_commandline_prepend.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3432 = private unnamed_addr constant [867 x i8] c"function fish_commandline_prepend --description \22Prepend the given string to the command-line, or remove the prefix if already there\22\0A    if not commandline | string length -q\0A        commandline -r $history[1]\0A    end\0A\0A    set -l process (commandline -p | string collect)\0A\0A    set -l to_prepend \22$argv[1] \22\0A    if string match -qr '^ ' \22$process\22\0A        set to_prepend \22 $argv[1]\22\0A    end\0A\0A    set -l length_diff (string length -- \22$to_prepend\22)\0A    set -l cursor_location (commandline -pC)\0A\0A    set -l escaped (string escape --style=regex -- $to_prepend)\0A    if set process (string replace -r -- \22^$escaped\22 \22\22 $process)\0A        commandline --replace -p -- $process\0A        set length_diff \22-$length_diff\22\0A    else\0A        commandline -pC 0\0A        commandline -pi -- \22$to_prepend\22\0A    end\0A\0A    commandline -pC (math \22max 0,($cursor_location + $length_diff)\22)\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3433 = private unnamed_addr constant [26 x i8] c"functions/fish_config.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3434 = private unnamed_addr constant [18022 x i8] c"function fish_config --description \22Launch fish's web based configuration\22\0A    argparse h/help -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help fish_config\0A        return 0\0A    end\0A\0A    set -l cmd $argv[1]\0A    set -e argv[1]\0A\0A    set -q cmd[1]\0A    or set cmd browse\0A\0A    # The web-based configuration UI\0A    # Also opened with just `fish_config` or `fish_config browse`.\0A    if contains -- $cmd browse\0A        set -lx __fish_bin_dir $__fish_bin_dir\0A        set -l fish_path (status fish-path)\0A        and set __fish_bin_dir (path dirname -- $fish_path)\0A        if set -l python (__fish_anypython)\0A            set -l mainfile $__fish_data_dir/tools/web_config/webconfig.py\0A            if not path is -- $mainfile\0A                if not status list-files tools/web_config &>/dev/null\0A                    echo \22Cannot find web configuration tool. Please check your fish installation.\22\0A                    return 1\0A                end\0A                set -l temp (mktemp -d)\0A                for dir in (status list-files tools/web_config | path dirname | path sort -u)\0A                    mkdir -p $temp/$dir\0A                    or return\0A                end\0A                for file in (status list-files tools/web_config)\0A                    status get-file $file >$temp/$file\0A                    or return\0A                end\0A                set mainfile $temp/tools/web_config/webconfig.py\0A            end\0A\0A            $python \22$mainfile\22 $argv\0A\0A            # If the execution of 'webconfig.py' fails, display python location and return.\0A            if test $status -ne 0\0A                echo \22Please check if Python has been installed successfully.\22\0A                echo \22You can find the location of Python by executing the 'command -s $python' command.\22\0A                return 1\0A            end\0A\0A        else\0A            echo (set_color $fish_color_error)Cannot launch the web configuration tool:(set_color normal)\0A            echo (set_color -o)\22fish_config browse\22(set_color normal) requires Python.\0A            echo Installing python will fix this, and also enable completions to be\0A            echo automatically generated from man pages.\\n\0A            echo To change your prompt, use (set_color -o)\22fish_config prompt\22(set_color normal) or create a (set_color -o)\22fish_prompt\22(set_color normal) function.\0A            echo To list the samples use (set_color -o)\22fish_config prompt show\22(set_color normal).\\n\0A\0A            echo You can tweak your colors by setting the (set_color $fish_color_search_match)\\$fish_color_\\*(set_color normal) variables.\0A        end\0A        return 0\0A    end\0A\0A    if not contains -- $cmd prompt theme\0A        echo No such subcommand: $cmd >&2\0A        return 1\0A    end\0A\0A    # Variables a theme is allowed to set\0A    set -l theme_var_filter '^fish_(?:pager_)?color.*$'\0A\0A    switch $cmd\0A        case prompt\0A            # prompt - for prompt switching\0A            set -l cmd $argv[1]\0A            set -e argv[1]\0A\0A            if contains -- $cmd list; and set -q argv[1]\0A                echo \22Too many arguments\22 >&2\0A                return 1\0A            end\0A\0A            set -l prompt_dir $__fish_data_dir/sample_prompts $__fish_data_dir/tools/web_config/sample_prompts\0A            switch $cmd\0A                case show\0A                    set -l fish (status fish-path)\0A                    set -l prompts $prompt_dir/$argv.fish\0A                    set -q prompts[1]; or set prompts $prompt_dir/*.fish (status list-files tools/web_config/sample_prompts/ 2>/dev/null)\0A                    for p in $prompts\0A                        if not test -e \22$p\22\0A                            continue\0A                        end\0A                        set -l promptname (string replace -r '.*/([^/]*).fish$' '$1' $p)\0A                        echo -s (set_color --underline) $promptname (set_color normal)\0A                        $fish -c 'functions -e fish_right_prompt;\0A                        if string match -q \22tools/*\22 -- $argv[1]\0A                            status get-file $argv[1] | source\0A                        else\0A                            source $argv[1]\0A                        end\0A                        false\0A                        fish_prompt\0A                        echo (set_color normal)\0A                        if functions -q fish_right_prompt;\0A                        echo right prompt: (false; fish_right_prompt)\0A                    end' $p\0A                        echo\0A                    end\0A                case list ''\0A                    files=$prompt_dir/*.theme string replace -r '.*/([^/]*).fish$' '$1' $files (status list-files tools/web_config/sample_prompts/)\0A                    return\0A                case choose\0A                    if set -q argv[2]\0A                        echo \22Too many arguments\22 >&2\0A                        return 1\0A                    end\0A                    if not set -q argv[1]\0A                        echo \22Too few arguments\22 >&2\0A                        return 1\0A                    end\0A\0A                    set -l have\0A                    for f in $prompt_dir/$argv[1].fish\0A                        if test -f $f\0A                            source $f\0A                            set have $f\0A                            break\0A                        end\0A                    end\0A                    if not set -q have[1]\0A                        if status list-files tools/web_config/sample_prompts/$argv[1].fish &>/dev/null\0A                            status get-file tools/web_config/sample_prompts/$argv[1].fish | source\0A                            # HACK: `source` gives us a filename of \22-\22, so we check manually if we had a right prompt\0A                            set have \22\22\0A                            status get-file tools/web_config/sample_prompts/$argv[1].fish | string match -q '*function fish_right_prompt*'\0A                            and set have -\0A                        else\0A                            echo \22No such prompt: '$argv[1]'\22 >&2\0A                            return 1\0A                        end\0A                    end\0A\0A                    # Erase the right prompt if it didn't have any.\0A                    if functions -q fish_right_prompt; and test (functions --details fish_right_prompt) != $have[1]\0A                        functions --erase fish_right_prompt\0A                    end\0A                case save\0A                    read -P\22Overwrite prompt? [y/N]\22 -l yesno\0A                    if string match -riq 'y(es)?' -- $yesno\0A                        echo Overwriting\0A                        # Skip the cp if unnecessary,\0A                        # or we'd throw an error on a stock fish.\0A                        path is $__fish_config_dir/functions/fish_prompt.fish\0A                        and cp $__fish_config_dir/functions/fish_prompt.fish{,.bak}\0A                        path is $__fish_config_dir/functions/fish_right_prompt.fish\0A                        and cp $__fish_config_dir/functions/fish_right_prompt.fish{,.bak}\0A\0A                        set -l have\0A                        if set -q argv[1]\0A                            for f in $prompt_dir/$argv[1].fish\0A                                if test -f $f\0A                                    set have $f\0A                                    # Set the functions to empty so we empty the file\0A                                    # if necessary.\0A                                    function fish_prompt\0A                                    end\0A                                    function fish_right_prompt\0A                                    end\0A                                    source $f\0A                                    or return 2\0A                                end\0A                            end\0A                            if not set -q have[1]\0A                                if status list-files tools/web_config/sample_prompts/$argv[1].fish &>/dev/null\0A                                    status get-file tools/web_config/sample_prompts/$argv[1].fish | source\0A                                else\0A                                    echo \22No such prompt: '$argv[1]'\22 >&2\0A                                    return 1\0A                                end\0A                            end\0A                        end\0A\0A                        funcsave fish_prompt\0A                        or return\0A\0A                        funcsave fish_right_prompt 2>/dev/null\0A                        return\0A                    else\0A                        echo Not overwriting\0A                        return 1\0A                    end\0A            end\0A\0A            return 0\0A        case theme\0A            # Selecting themes\0A            set -l cmd $argv[1]\0A            set -e argv[1]\0A\0A            if contains -- $cmd list; and set -q argv[1]\0A                echo \22Too many arguments\22 >&2\0A                return 1\0A            end\0A\0A            set -l dirs $__fish_config_dir/themes $__fish_data_dir/tools/web_config/themes\0A\0A            switch $cmd\0A                case list ''\0A                    files=$dirs/*.theme string replace -r '.*/([^/]*).theme$' '$1' $files (status list-files tools/web_config/themes/)\0A                    return\0A                case demo\0A                    echo -ns (set_color $fish_color_command || set_color $fish_color_normal) /bright/vixens\0A                    echo -ns (set_color normal) ' '\0A                    echo -ns (set_color $fish_color_param || set_color $fish_color_normal)