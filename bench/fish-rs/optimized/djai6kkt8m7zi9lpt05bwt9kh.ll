@anon.1d0b41a8d45d477c3029ec78f9b8b434.1178 = private unnamed_addr constant [1358 x i8] c"complete -c atom -s d -l dev -d 'Run in development mode'\0Acomplete -c atom -s f -l foreground -d 'Keep main process in foreground'\0Acomplete -c atom -s h -l help -d 'Print usage message'\0Acomplete -c atom -s l -l log-file -r -d 'Log all output to file'\0Acomplete -c atom -s n -l new-window -d 'Open a new window'\0Acomplete -c atom -l profile-startup -d 'Profile startup execution time'\0Acomplete -c atom -s r -l resource-path -r -d 'Set Atom source directory and enable dev mode'\0Acomplete -c atom -l safe -d 'Run in safe mode'\0Acomplete -c atom -l benchmark -d 'Run the specified benchmarks in a new window'\0Acomplete -c atom -l benchmark-test -d 'Run a faster version of the benchmarks in headless mode'\0Acomplete -c atom -s t -l test -d 'Run the specified specs and exit with error code on failures'\0Acomplete -c atom -s m -l main-process -d 'Run the specified specs in the main process'\0Acomplete -c atom -l timeout -r -d 'Set timeout for test mode (minutes)'\0Acomplete -c atom -s v -l version -d 'Print the version information'\0Acomplete -c atom -s w -l wait -d 'Wait for editor to be closed before returning'\0Acomplete -c atom -l clear-window-state -d 'Delete all Atom environment state'\0Acomplete -c atom -l enable-electron-logging -d 'Enable low-level logging messages from Electron'\0Acomplete -c atom -s a -l add -d 'Open path as a new project in last used window'\0A", align 1
