------------------\0A\0A# clean\0A__fish_p4_register_command_option clean -a '(__fish_print_p4_opened_files)'\0A__fish_p4_register_command_option clean -s a -d \22Delete files not in depot\22\0A__fish_p4_register_command_option clean -s d -d \22Restore deleted files\22\0A__fish_p4_register_command_option clean -s e -d \22Restore edited files\22\0A__fish_p4_register_command_option clean -s I -d \22Ignore P4IGNORE settings for added files\22\0A__fish_p4_register_command_option clean -s l -d \22Display output in local file syntax with relative paths\22\0A__fish_p4_register_command_option clean -s n -d \22Preview what would be done\22\0A\0A# client, workspace @TODO: -Fs (only in -f), -c (only in -S stream)\0Afor a in client workspace\0A    __fish_p4_register_command_option $a -x -a '(__fish_print_p4_workspaces)'\0A    __fish_p4_register_command_option $a -s f -d \22Allows the last modification date to be set\22\0A    __fish_p4_register_command_option $a -s d -f -a '(__fish_print_p4_workspaces)' -d \22Delete client workspace even if not owned by user\22\0A    # __fish_p4_register_command_option $a -a '-Fs' -d 'Deletes client with shelves (must follow -f)'\0A    __fish_p4_register_command_option $a -s F -a s -d 'Deletes client with shelves (must follow -f)'\0A    __fish_p4_register_command_option $a -s o -d \22Write the client workspace spec to standard output\22\0A    __fish_p4_register_command_option $a -s i -d \22Read the client workspace spec from standard input\22\0A    __fish_p4_register_command_option $a -s c -x -a '(__fish_print_p4_workspace_changelists)' -d \22When used with -S stream, preview the workspace spec\22\0A    __fish_p4_register_command_option $a -s s -d \22Switch workspace view\22\0A    __fish_p4_register_command_option $a -s t -x -d \22Specify a client workspace Template\22\0A    __fish_p4_register_command_option $a -l serverid -x -d \22Forcefully delete workspace that is bound to another server\22\0A    __fish_p4_register_command_option $a -s S -x -a '(__fish_print_p4_streams)' -d \22Associates the workspace with the specified stream\22\0Aend\0A\0A# clients, workspaces @TODO -U and others are mutually exclusive\0Afor a in clients workspaces\0A    __fish_p4_register_command_option $a -s a -d \22List all client workspaces\22\0A    __fish_p4_register_command_option $a -s e -x -d \22List client workspaces matching filter (case-sensitive)\22\0A    __fish_p4_register_command_option $a -s E -x -d \22List client workspaces matching filter (case-insensitive)\22\0A    __fish_p4_register_command_option $a -s m -x -d \22List the first max client workspaces\22\0A    __fish_p4_register_command_option $a -s s -x -d \22List client workspaces bound to the specified serverID\22\0A    __fish_p4_register_command_option $a -s S -x -a '(__fish_print_p4_streams)' -d \22List client workspaces associated with the specified stream\22\0A    __fish_p4_register_command_option $a -s t -d \22Display time and date last update to the workspace\22\0A    __fish_p4_register_command_option $a -s u -x -a '(__fish_print_p4_users)' -d \22List only client workspaces owned by user\22\0A    __fish_p4_register_command_option $a -s U -d \22List only client workspaces unloaded with p4 unload\22\0Aend\0A\0A# flush @TODO\0A# have @TODO\0A# ignores @TODO\0A\0A# sync @TODO --parallel has unique key-value pair syntax: --parallel=optq1=n,opt2=n,opt3=n,opt4=n\0A__fish_p4_register_command_option sync -s f -d \22Force sync, overwrite all unopened files\22\0A__fish_p4_register_command_option sync -s k -d \22Keep existing workspace files, alias for p4 flush\22\0A__fish_p4_register_command_option sync -s L -d \22Perform sync on a list of valid file arguments\22\0A__fish_p4_register_command_option sync -s m -x -d \22Sync only the first max files specified\22\0A__fish_p4_register_command_option sync -s n -d \22Display sync results without actually syncing\22\0A__fish_p4_register_command_option sync -s N -d \22Display network traffic estimates without actually syncing\2