@anon.1d0b41a8d45d477c3029ec78f9b8b434.3438 = private unnamed_addr constant [784 x i8] c"function fish_default_mode_prompt --description \22Display vi prompt mode\22\0A    # Do nothing if not in vi mode\0A    if test \22$fish_key_bindings\22 = fish_vi_key_bindings\0A        or test \22$fish_key_bindings\22 = fish_hybrid_key_bindings\0A        switch $fish_bind_mode\0A            case default\0A                set_color --bold red\0A                echo '[N]'\0A            case insert\0A                set_color --bold green\0A                echo '[I]'\0A            case replace_one\0A                set_color --bold green\0A                echo '[R]'\0A            case replace\0A                set_color --bold cyan\0A                echo '[R]'\0A            case visual\0A                set_color --bold magenta\0A                echo '[V]'\0A        end\0A        set_color normal\0A        echo -n ' '\0A    end\0Aend\0A", align 1
