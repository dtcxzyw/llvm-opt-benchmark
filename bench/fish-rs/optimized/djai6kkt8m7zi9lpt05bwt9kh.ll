ubernetes -d 'Deploy the current application to Kubernetes'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -r -a languages -d 'Copy i18n files for selected languages to /webapp/i18n'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -a openshift -d 'Deploy the current application to OpenShift'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -a rancher-compose -d 'Deploy the current application to Rancher'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -a server -d 'Create a new JHipster server-side application'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -r -a service -d 'Create a new Spring service bean'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -a upgrade -d 'Upgrade the JHipster and the generated application'\0Acomplete -f -c jhipster -n __fish_prog_needs_command -a completion -d 'Print command completion script'\0A", align 1
