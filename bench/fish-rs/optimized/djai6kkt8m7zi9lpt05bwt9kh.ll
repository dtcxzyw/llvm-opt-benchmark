@anon.1d0b41a8d45d477c3029ec78f9b8b434.3567 = private unnamed_addr constant [3410 x i8] c"# name: Disco\0A# author: Fabian Homborg\0A\0Afunction fish_prompt\0A    set -l last_status $status\0A\0A    set -l normal (set_color normal)\0A    set -l usercolor (set_color $fish_color_user)\0A\0A    set -l delim \\U25BA\0A    # If we don't have unicode use a simpler delimiter\0A    string match -qi \22*.utf-8\22 -- $LANG $LC_CTYPE $LC_ALL; or set delim \22>\22\0A\0A    fish_is_root_user; and set delim \22#\22\0A\0A    set -l cwd (set_color $fish_color_cwd)\0A    if command -sq cksum\0A        # randomized cwd color\0A        # We hash the physical PWD and turn that into a color. That means directories (usually) get different colors,\0A        # but every directory always gets the same color. It's deterministic.\0A        # We use cksum because 1. it's fast, 2. it's in POSIX, so it should be available everywhere.\0A        set -l shas (pwd -P | cksum | string split -f1 ' ' | math --base=hex | string sub -s 3 | string pad -c 0 -w 6 | string match -ra ..)\0A        set -l col 0x$shas[1..3]\0A\0A        # If the (simplified idea of) luminance is below 120 (out of 255), add some more.\0A        # (this runs at most twice because we add 60)\0A        while test (math 0.2126 x $col[1] + 0.7152 x $col[2] + 0.0722 x $col[3]) -lt 120\0A            set col[1] (math --base=hex \22min(255, $col[1] + 60)\22)\0A            set col[2] (math --base=hex \22min(255, $col[2] + 60)\22)\0A            set col[3] (math --base=hex \22min(255, $col[3] + 60)\22)\0A        end\0A        set -l col (string replace 0x '' $col | string pad -c 0 -w 2 | string join \22\22)\0A\0A        set cwd (set_color $col)\0A    end\0A\0A    # Prompt status only if it's not 0\0A    set -l prompt_status\0A    test $last_status -ne 0; and set prompt_status (set_color $fish_color_status)\22[$last_status]$normal\22\0A\0A    # Only show host if in SSH or container\0A    # Store this in a global variable because it's slow and unchanging\0A    if not set -q prompt_host\0A        set -g prompt_host \22\22\0A        if set -q SSH_TTY\0A            or begin\0A                command -sq systemd-detect-virt\0A                and systemd-detect-virt -q\0A            end\0A            set prompt_host $usercolor$USER$normal@(set_color $fish_color_host)$hostname$normal\22:\22\0A        end\0A    end\0A\0A    # Shorten pwd if prompt is too long\0A    set -l pwd (prompt_pwd)\0A\0A    echo -n -s $prompt_host $cwd $pwd $normal $prompt_status $delim\0Aend\0A\0Afunction fish_right_prompt\0A    set -g __fish_git_prompt_showdirtystate 1\0A    set -g __fish_git_prompt_showuntrackedfiles 1\0A    set -g __fish_git_prompt_showupstream informative\0A    set -g __fish_git_prompt_showcolorhints 1\0A    set -g __fish_git_prompt_use_informative_chars 1\0A    # Unfortunately this only works if we have a sensible locale\0A    string match -qi \22*.utf-8\22 -- $LANG $LC_CTYPE $LC_ALL\0A    and set -g __fish_git_prompt_char_dirtystate \\U1F4a9\0A    set -g __fish_git_prompt_char_untrackedfiles \22?\22\0A\0A    # The git prompt's default format is ' (%s)'.\0A    # We don't want the leading space.\0A    set -l vcs (fish_vcs_prompt '(%s)' 2>/dev/null)\0A\0A    set -l d (set_color brgrey)(date \22+%R\22)(set_color normal)\0A\0A    set -l duration \22$cmd_duration$CMD_DURATION\22\0A    if test $duration -gt 100\0A        set duration (math $duration / 1000)s\0A    else\0A        set duration\0A    end\0A\0A    set -q VIRTUAL_ENV_DISABLE_PROMPT\0A    or set -g VIRTUAL_ENV_DISABLE_PROMPT true\0A    set -q VIRTUAL_ENV\0A    and set -l venv (string replace -r '.*/' '' -- \22$VIRTUAL_ENV\22)\0A\0A    set_color normal\0A    string join \22 \22 -- $venv $duration $vcs $d\0Aend\0A", align 1
