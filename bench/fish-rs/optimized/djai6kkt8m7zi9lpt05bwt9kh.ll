@anon.1d0b41a8d45d477c3029ec78f9b8b434.3209 = private unnamed_addr constant [34 x i8] c"functions/__fish_gnu_complete.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3210 = private unnamed_addr constant [990 x i8] c"function __fish_gnu_complete -d \22Wrapper for the complete built-in. Skips the long completions on non-GNU systems\22\0A    set -l is_gnu 0\0A\0A    set -l argv_out\0A\0A    # Check if we are using a gnu system\0A    for i in $argv\0A        switch $i\0A\0A            case -g --is-gnu\0A                set is_gnu 1\0A\0A            case '*'\0A                set argv_out $argv_out $i\0A        end\0A    end\0A\0A    set argv $argv_out\0A    set argv_out\0A    set -l skip_next 0\0A\0A    # Remove long option if not on a gnu system\0A    switch $is_gnu\0A        case 0\0A            for i in $argv\0A\0A                switch $skip_next\0A\0A                    case 1\0A                        set skip_next 0\0A                        continue\0A\0A                end\0A\0A                switch $i\0A\0A                    case -l --long\0A                        set skip_next 1\0A                        continue\0A\0A                end\0A\0A                set argv_out $argv_out $i\0A            end\0A            set argv $argv_out\0A\0A    end\0A\0A    complete $argv\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3211 = private unnamed_addr constant [31 x i8] c"functions/__fish_hg_prompt.fish", align 1
