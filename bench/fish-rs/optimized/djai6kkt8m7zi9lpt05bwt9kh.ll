@anon.1d0b41a8d45d477c3029ec78f9b8b434.2906 = private unnamed_addr constant [2481 x i8] c"# `wlr-randr` completions.\0A# See: https://gitlab.freedesktop.org/emersion/wlr-randr\0A\0Afunction __fish_print_wlr-randr_outputs --argument-names exclude\0A    if command -q jq\0A        wlr-randr --json | jq \\\0A            --raw-output \\\0A            --arg exclude \22$exclude\22 \\\0A            '.[] | select(.name != $exclude) | \22\\(.name)\\t\\(.make), \\(.model)\22'\0A    end\0Aend\0A\0Afunction __fish_get_wlr-randr-current_output\0A    set -l last_output\0A    set -l tokens (commandline -xpc)\0A\0A    while set -q tokens[1]\0A        if test \22$tokens[1]\22 = --output\0A            set last_output \22$tokens[2]\22\0A            set -e tokens[1]\0A        else if string match -qr -- '^--output=' \22$tokens[1]\22\0A            set last_output (string replace -r -- '--output=(.*)' '$1' \22$tokens[1]\22)\0A        end\0A\0A        set -e tokens[1]\0A    end\0A\0A    printf \22%s\22 $last_output\0Aend\0A\0Afunction __fish_complete_wlr-randr_modes\0A    if command -q jq\0A        set -l output (__fish_get_wlr-randr-current_output)\0A\0A        wlr-randr --json | jq \\\0A            --raw-output \\\0A            --arg output \22$output\22 \\\0A            --arg preferred_str Preferred \\\0A            --arg empty_str '' \\\0A            '.[] | select(.name == $output) | .modes[] | \22\\(.width)x\\(.height)\\t\\(if .preferred then $preferred_str else $empty_str end)\22'\0A    end\0Aend\0A\0Acomplete -c wlr-randr -f\0Acomplete -c wlr-randr -s h -l help -d 'Show help'\0Acomplete -c wlr-randr -l json -d 'Print as JSON'\0Acomplete -c wlr-randr -l dryrun -d 'Dry run'\0Acomplete -c wlr-randr -l output -x -d Output -a '(__fish_print_wlr-randr_outputs)'\0Acomplete -c wlr-randr -l on -d 'Turn on'\0Acomplete -c wlr-randr -l off -d 'Turn off'\0Acomplete -c wlr-randr -l mode -x -d Mode -a '(__fish_complete_wlr-randr_modes)'\0Acomplete -c wlr-randr -l pos -r -d Position\0Acomplete -c wlr-randr -l left-of -x -d 'Relative left position' -a '(__fish_print_wlr-randr_outputs (__fish_get_wlr-randr-current_output))'\0Acomplete -c wlr-randr -l right-of -x -d 'Relative right position' -a '(__fish_print_wlr-randr_outputs (__fish_get_wlr-randr-current_output))'\0Acomplete -c wlr-randr -l above -x -d 'Relative top position' -a '(__fish_print_wlr-randr_outputs (__fish_get_wlr-randr-current_output))'\0Acomplete -c wlr-randr -l below -x -d 'Relative bottom position' -a '(__fish_print_wlr-randr_outputs (__fish_get_wlr-randr-current_output))'\0Acomplete -c wlr-randr -l transform -x -d Transformation -a 'normal\\t 90\\t 180\\t 270\\t flipped\\t flipped-90\\t flipped-180\\t flipped-270\\t'\0Acomplete -c wlr-randr -l scale -x -d Scale\0A", align 1
