@anon.1d0b41a8d45d477c3029ec78f9b8b434.2570 = private unnamed_addr constant [3679 x i8] c"function __fish_detect_screen_socket_dir -d \22Detect which folder screen uses\22\0A    set -l screen_bin screen\0A    if not set -q __fish_screen_socket_dir\0A        set -g __fish_screen_socket_dir ($screen_bin -ls __fish_i_don_t_think_this_will_be_matched | string match -r \22(?<=No Sockets found in ).*(?=\\.)\22)\0A    end\0Aend\0A\0Afunction __fish_complete_screen_general_list_mac -d \22Get the socket list on mac\22\0A    pushd $__fish_screen_socket_dir >/dev/null\0A    set -l sockets (ls)\0A    if test (count $sockets) -ne 0\0A        switch $argv\0A            case Detached\0A                stat -f \22%Lp %SB %N\22 -t \22%D %T\22 $sockets | string match -r '^6\\d{2} .*$' | string replace -r '^6\\d{2} (\\S+ \\S+) (\\S+)' '$2\\t$1 Detached'\0A            case Attached\0A                stat -f \22%Lp %SB %N\22 -t \22%D %T\22 $sockets | string match -r '^7\\d{2} .*$' | string replace -r '^7\\d{2} (\\S+ \\S+) (\\S+)' '$2\\t$1 Attached'\0A        end\0A    end\0A    popd >/dev/null\0Aend\0A\0Afunction __fish_complete_screen_general_list -d \22Get the socket list\22\0A    set -l escaped (string escape --style=regex $argv)\0A    screen -list | string match -r '^\\t.*\\('$escaped'\\)\\s*$' | string replace -r '\\t(.*)\\s+(\\(.*\\))?\\s*\\((.*)\\)' '$1\\t$3'\0Aend\0A\0Afunction __fish_complete_screen_detached -d \22Print a list of detached screen sessions\22\0A    switch (uname)\0A        case Darwin\0A            __fish_complete_screen_general_list_mac Detached\0A        case '*'\0A            __fish_complete_screen_general_list Detached\0A    end\0Aend\0A\0Afunction __fish_complete_screen_attached -d \22Print a list of attached screen sessions\22\0A    switch (uname)\0A        case Darwin\0A            __fish_complete_screen_general_list_mac Attached\0A        case '*'\0A            __fish_complete_screen_general_list Attached\0A    end\0Aend\0A\0Afunction __fish_complete_screen -d \22Print a list of running screen sessions\22\0A    string join \\n (__fish_complete_screen_attached) (__fish_complete_screen_detached)\0Aend\0A\0A# detect socket directory for mac users\0A__fish_detect_screen_socket_dir\0A\0Acomplete -c screen -s a -d 'Include all capabilitys'\0Acomplete -c screen -s A -d 'Adapt window size'\0Acomplete -c screen -s c -r -d 'Specify init file'\0Acomplete -c screen -o d -d 'Detach screen' -a '(__fish_complete_screen)' -x\0Acomplete -c screen -o D -d 'Detach screen' -a '(__fish_complete_screen)' -x\0Acomplete -c screen -o r -d 'Reattach session' -a '(__fish_complete_screen)' -x\0Acomplete -c screen -o R -d 'Reattach/create session' -a '(__fish_complete_screen)' -x\0Acomplete -c screen -o RR -d 'Reattach/create any session' -a '(__fish_complete_screen)' -x\0Acomplete -c screen -s e -x -d 'Escape character'\0Acomplete -c screen -s f -d 'Flow control on'\0Acomplete -c screen -o fn -d 'Flow control off'\0Acomplete -c screen -o fa -d 'Flow control automatic'\0Acomplete -c screen -o h -x -d 'History length'\0Acomplete -c screen -s i -d 'Interrupt display on C-c'\0Acomplete -c screen -s l -d 'Login on'\0Acomplete -c screen -o ln -d 'Login off'\0Acomplete -c screen -o ls -d 'List sessions'\0Acomplete -c screen -o list -d 'List sessions'\0Acomplete -c screen -s L -d 'Log on'\0Acomplete -c screen -s m -d 'Ignore $STY'\0Acomplete -c screen -s O -d 'Optimal output'\0Acomplete -c screen -s p -d 'Preselect window'\0Acomplete -c screen -s q -d 'Quiet mode'\0Acomplete -c screen -o s -r -d 'Set shell'\0Acomplete -c screen -o S -x -d 'Session name'\0Acomplete -c screen -o t -x -d 'Session title'\0Acomplete -c screen -o T -x -d 'Value to use for $TERM (default \22screen\22)'\0Acomplete -c screen -s U -d 'UTF-8 mode'\0Acomplete -c screen -s v -d 'Display version and exit'\0Acomplete -c screen -o wipe -d 'Wipe dead sessions'\0Acomplete -c screen -o x -d 'Multi attach' -a '(__fish_complete_screen_attached)' -x\0Acomplete -c screen -o X -r -d 'Send command'\0A", align 1
