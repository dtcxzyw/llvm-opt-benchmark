@anon.1d0b41a8d45d477c3029ec78f9b8b434.3138 = private unnamed_addr constant [865 x i8] c"function __fish_complete_lpr_option --description 'Complete lpr option'\0A    set -l optstr \22$(commandline -t)\22\0A    switch $optstr\0A        case '*=*'\0A            string split -m1 = -- \22$optstr\22 | read -l opt val\0A            set -l descr\0A            for l in (lpoptions -l 2>/dev/null | string match -- \22*$opt*\22 | string replace -r '.*/(.*):\\s*(.*)$' '$1 $2' | string split \22 \22)\0A                if not set -q descr[1]\0A                    set descr $l\0A                    continue\0A                end\0A                set -l default ''\0A                if string match -q '\\**' -- $l\0A                    set default 'Default '\0A                    set l (string sub -s 2 -- $l)\0A                end\0A                echo $opt=$l\\t$default$descr\0A            end\0A        case '*'\0A            lpoptions -l 2>/dev/null | string replace -r '(.*)/(.*):.*$' '$1=\\t$2'\0A    end\0A\0Aend\0A", align 1
