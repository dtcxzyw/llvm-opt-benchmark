@anon.1d0b41a8d45d477c3029ec78f9b8b434.2842 = private unnamed_addr constant [2907 x i8] c"# Completion for vim-addons\0A# =========================\0A#\0A# Adrien Grellier <adrien.grellier@laposte.net>\0A#\0A\0Afunction __fish_vim-addons_subcommand -d 'Test if vim-addons has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i list status install remove disable amend files show\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0A# Commands\0A# --------\0A# list\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a list -f -d \22list the names of the addons available in the system\22\0A# status\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a status -f -d \22show the status of the addons available in the system\22\0Acomplete -c vim-addons -n \22contains status (commandline -pxc)\22 -a \22(vim-addons list)\22 -x\0A# install\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a install -x -d \22install one or more addons under ~/.vim\22\0Acomplete -c vim-addons -n \22contains install (commandline -pxc)\22 -a \22(vim-addons status | awk '\\$2 != \\\22installed\\\22 && \\$1 != \\\22#\\\22 { print \\$1}')\22 -x\0A# remove\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a remove -x -d \22remove one or more addons from ~/.vim\22\0Acomplete -c vim-addons -n \22contains remove (commandline -pxc)\22 -a \22(vim-addons status | awk '\\$2 != \\\22removed\\\22 && \\$1 != \\\22#\\\22 { print \\$1}')\22 -x\0A# disable\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a disable -x -d \22disable  one  or more addons to be used by the current user\22\0Acomplete -c vim-addons -n \22contains disable (commandline -pxc)\22 -a \22(vim-addons status | awk '\\$2 != \\\22disable\\\22 && \\$1 != \\\22#\\\22 { print \\$1}')\22 -x\0A# amend\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a amend -x -d \22undo the effects of a previous disable command\22\0Acomplete -c vim-addons -n \22contains amend (commandline -pxc)\22 -a \22(vim-addons list)\22 -x\0A# files\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a files -x -d \22list, one per line, the files composing the specified addons\22\0Acomplete -c vim-addons -n \22contains files (commandline -pxc)\22 -a \22(vim-addons list)\22 -x\0A# show\0Acomplete -c vim-addons -n __fish_vim-addons_subcommand -a show -x -d \22displays detailed information about the specified addons\22\0Acomplete -c vim-addons -n \22contains show (commandline -pxc)\22 -a \22(vim-addons list)\22 -x\0A\0A# Options\0A# --------\0Acomplete -c vim-addons -s h -l help -d \22show this usage message and exit\22\0Acomplete -c vim-addons -s q -l query -d \22be quiet and make the output more parseable\22\0Acomplete -c vim-addons -s r -l registry-dir -d \22set the registry directory\22\0Acomplete -c vim-addons -s s -l source-dir -d \22set the addons source directory\22\0Acomplete -c vim-addons -s t -l target-dir -d \22set the addons target directory\22\0Acomplete -c vim-addons -s v -l verbose -d \22increase verbosity\22\0Acomplete -c vim-addons -s y -l system-dir -d \22set the system-wide target directory\22\0Acomplete -c vim-addons -s w -l system-wide -d \22set target directory to the system-wide one\22\0A", align 1
