_completion_cache_time\22\0A        set -g __fish_nmap_script_completion_cache_time $now\0A        set -g __fish_nmap_script_completion_cache \22\22\0A        set -l cmd\0A        for l in (nmap --script-help all 2> /dev/null | grep -A2 -B1 Categories: | grep -v '^\\\\(--\\\\|Categories:\\\\|https:\\\\)')\0A            if string match -q -v --regex \22^ \22 $l\0A                set cmd $l\0A            else\0A                set __fish_nmap_script_completion_cache $__fish_nmap_script_completion_cache\\n$cmd\\t(string trim -l $l)\0A            end\0A        end\0A        for cat in all auth broadcast brute default discovery dos exploit external fuzzer intrusive malware safe version vuln\0A            set __fish_nmap_script_completion_cache $__fish_nmap_script_completion_cache\\n$cat\\tCategory\\n\0A        end\0A    end\0A    echo -e $__fish_nmap_script_completion_cache\0Aend\0Acomplete -c nmap -l script -r -a \22(__fish_complete_list , __fish_complete_nmap_script)\22\0Acomplete -c nmap -l script -r -d 'Runs a script scan'\0Acomplete -c nmap -l script-args -d 'provide arguments to NSE scripts'\0Acomplete -c nmap -l script-args-file -r -d 'load arguments to NSE scripts from a file'\0Acomplete -c nmap -l script-help -r -a \22(__fish_complete_list , __fish_complete_nmap_script)\22\0Acomplete -c nmap -l script-help -r -d \22Shows help about scripts\22\0Acomplete -c nmap -l script-trace\0Acomplete -c nmap -l script-updatedb\0A\0A# TIMING AND PERFORMANCE\0Acomplete -c nmap -l min-hostgroup -l max-hostgroup -x -d 'Adjust parallel scan group size'\0Acomplete -c nmap -l min-parallelism -l max-parallelism -x -d 'Adjust probe parallelization'\0Acomplete -c nmap -l min-rtt-timeout -l max-rtt-timeout -l initial-rtt-timeout -x -d 'Adjust probe timeouts'\0Acomplete -c nmap -l max-retries -x -d 'Specify the maximum number of port scan probe retransmissions'\0Acomplete -c nmap -l host-timeout -d 'to skip slow hosts'\0Acomplete -c nmap -l script-timeout -x\0Acomplete -c nmap -l scan-delay -l max-scan-delay -x -d 'Adjust delay between probes'\0Acomplete -c nmap -l min-rate -l max-rate -x -d 'Directly control the scanning rate'\0Acomplete -c nmap -l defeat-rst-ratelimit -d 'ignore ICMP-RST rate limits'\0Acomplete -c nmap -l defeat-icmp-ratelimit -d 'ignore ICMP unreachable in UDP'\0Acomplete -c nmap -l nsock-engine -x -d 'Enforce use of a given nsock IO multiplexing engine' -a \22epoll kqueue poll select\22\0Afunction __fish_complete_nmap_timing-template\0A    set -l i 0\0A    for t in paranoid sneaky polite normal aggressive insane\0A        printf \22%i\\t%s timing\\n\22 $i $t\0A        printf \22%s\\tTemplate %i\\n\22 $t $i\0A        set i (math $i + 1)\0A    end\0Aend\0Acomplete -c nmap -s T -x -a \22(__fish_complete_nmap_timing-template)\22 -d 'Set a timing template'\0A\0A# FIREWALL/IDS EVASION AND SPOOFING\0Acomplete -c nmap -s f -d 'fragment packets' -n \22not __fish_contains_opt -s f\22\0Acomplete -c nmap -s f -d 'use 16 bytes per fragment' -n \22__fish_contains_opt -s f\22\0Acomplete -c nmap -l mtu -d 'use specified mtu' -n \22__fish_contains_opt -s f\22\0Acomplete -c nmap -s D -x -d 'Cloak a scan with decoys'\0Acomplete -c nmap -s S -x -d 'Spoof source address'\0Acomplete -c nmap -s e -x -d 'Use specified interface' -a \22(__fish_print_interfaces)\22\0Acomplete -c nmap -l source-port -s g -x -d 'Spoof source port number'\0Acomplete -c nmap -l data -x -d 'Append custom binary data to sent packets'\0Acomplete -c nmap -l data-string -x -d 'Append custom string to sent packets'\0Acomplete -c nmap -l data-length -x -d 'Append random data to sent packets'\0Afunction __fish_complete_nmap_ip-options\0A    printf \22S\\tstrict source routing\\n\22 # may be followed by ip addresses\0A    printf \22R\\trecord route\\n\22 # may be followed by ip addresses\0A    printf \22L\\tloose source routing\\n\22 # may be followed by ip addresses\0A    printf \22T\\trecord internet timestamps\\n\22\0A    printf \22U\\trecord timestamps and ip addresses\\n\22\0A