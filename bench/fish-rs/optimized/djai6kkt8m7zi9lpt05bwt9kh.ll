@anon.1d0b41a8d45d477c3029ec78f9b8b434.2972 = private unnamed_addr constant [1113 x i8] c"function __fish_xprop_list_properties\0A    # TODO search commandline for a target window (\22-root\22 or \22-name foo\22)\0A    xprop -root | string split -f1 '('\0Aend\0A\0Acomplete -c xprop -o help -d \22Display help and exit\22\0Acomplete -c xprop -o grammar -d \22Display grammar and exit\22\0Acomplete -c xprop -o id -x -d \22Select window by id\22\0Acomplete -c xprop -o name -d \22Select window by name\22\0Acomplete -c xprop -o font -x -d \22Display font properties\22\0Acomplete -c xprop -o root -d \22Select root window\22\0Acomplete -c xprop -o display -d \22Specify X server\22\0Acomplete -c xprop -o len -x -d \22Maximum display length\22\0Acomplete -c xprop -o notype -d \22Do not show property type\22\0Acomplete -c xprop -o fs -r -d \22Set format file\22\0Acomplete -c xprop -o frame -d \22Select a window by clicking on its frame\22\0Acomplete -c xprop -o remove -d \22Remove property\22 -x -a \22( __fish_xprop_list_properties)\22\0Acomplete -c xprop -o set -d \22Set property\22 -x -a \22 (__fish_xprop_list_properties)\22\0Acomplete -c xprop -o spy -d \22Examine property updates forever\22\0Acomplete -c xprop -o f -d \22Set format\22\0Acomplete -c xprop -d Property -x -a \22( __fish_xprop_list_properties)\22\0A", align 1
