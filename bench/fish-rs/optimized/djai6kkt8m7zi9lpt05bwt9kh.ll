@anon.1d0b41a8d45d477c3029ec78f9b8b434.3132 = private unnamed_addr constant [563 x i8] c"function __fish_complete_job_pids --description \22Print a list of job PIDs and their commands\22\0A    if set -l jobpids (jobs -p)\0A        # when run at the commandline, the first line of output is a header, but\0A        # that doesn't seem to be printed when you run jobs in a subshell\0A\0A        # then we can use the jobs command again to get the corresponding\0A        # command to provide as a description for each job PID\0A        for jobpid in $jobpids\0A            set -l cmd (jobs -c $jobpid)\0A            printf \22%s\\tJob: %s\\n\22 $jobpid $cmd\0A        end\0A    end\0Aend\0A", align 1
