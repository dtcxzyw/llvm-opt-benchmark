@anon.1d0b41a8d45d477c3029ec78f9b8b434.1710 = private unnamed_addr constant [1049 x i8] c"complete -c gendarme -l version -d 'Show version'\0A\0Acomplete -c gendarme -l config -r -d 'Use config file'\0Acomplete -c gendarme -l set -x -d 'Use rule set from config file'\0Acomplete -c gendarme -l xml -r -d 'Convert stdout to XML and redirect to file'\0Acomplete -c gendarme -l html -r -d 'Convert stdout to HTML and redirect to file'\0Acomplete -c gendarme -l console -d 'Show the defects on stdout'\0Acomplete -c gendarme -l ignore -r -d 'Exclude the defects from file'\0Acomplete -c gendarme -l limit -x -d 'Specify defect limit'\0Acomplete -c gendarme -l severity -x \\\0A    -a 'all audit audit+ low low+ low- medium medium+ medium- high high+ high- critical critical-' \\\0A    -d 'Filter the reported defects to include the specified severity levels'\0Acomplete -c gendarme -l confidence -x \\\0A    -a 'all low low+ normal normal+ normal- high high+ high- total total-' \\\0A    -d 'Filter the reported defects to include the specified confidence levels'\0Acomplete -c gendarme -l quiet -d 'Discard stdout'\0Acomplete -c gendarme -s v -l verbose -d 'Show more messages'\0A", align 1
