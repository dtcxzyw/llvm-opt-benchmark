@anon.1d0b41a8d45d477c3029ec78f9b8b434.3162 = private unnamed_addr constant [462 x i8] c"function __fish_complete_proc\0A    # \22comm=\22 means \22print comm field with an empty name\22, which causes the header to be removed.\0A    # On many systems, comm is truncated (e.g. on Linux it's 15 chars),\0A    # but that's okay since commands that accept them as argument also only use those (e.g. pgrep).\0A    # String removes zombies (ones in parentheses) and padding (macOS adds some apparently).\0A    __fish_ps -o comm= | string match -rv '\\(.*\\)' | string trim\0Aend\0A", align 1
