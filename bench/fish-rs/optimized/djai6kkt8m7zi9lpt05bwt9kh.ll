@anon.1d0b41a8d45d477c3029ec78f9b8b434.2480 = private unnamed_addr constant [7136 x i8] c"function __reg_run_reg_safely\0A    set -l output (reg $argv | tr -d '\\r' | tail --lines +2 | string collect)\0A    if not string match -q -r \22reg: Invalid syntax*\22 -- $output\0A        set output (string split \\n -- $output)\0A        echo $output | string replace -a \22 \22 \\n\0A    end\0Aend\0A\0Afunction __reg_add_complete_args -a previous_token\0A    if test \22$previous_token\22 = add\0A        set -l current_token (commandline -tc)\0A        __reg_run_reg_safely query $current_token\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /t\0A        echo 'REG_SZ\0AREG_MULTI_SZ\0AREG_DWORD_BIG_ENDIAN\0AREG_DWORD\0AREG_BINARY\0AREG_DWORD_LITTLE_ENDIAN\0AREG_LINK\0AREG_FULL_RESOURCE_DESCRIPTOR\0AREG_EXPAND_SZ'\0A        return\0A    end\0A\0A    if not __fish_seen_argument -w v -w ve\0A        echo -e '/v\\tSpecify the name of the add registry entry\0A/ve\\tSpecify that the added registry entry has a null value'\0A    end\0A\0A    echo -e '/t\\tSpecify the type for the registry entry\0A/s\\tSpecify the character to be used\0A/d\\tSpecify the data for the new registry entry\0A/f\\tAdd the registry entry without prompting for confirmation\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_compare_complete_args\0A    if not __fish_seen_argument -w v -w ve\0A        echo -e '/v\\tSpecify the value name\0A/ve\\tSpecify that only entries that have a value name of null should be compared'\0A    end\0A\0A    if not __fish_seen_argument -w oa -w od -w os -w on\0A        echo -e '/oa\\tSpecify that all differences and matches are displayed\0A/od\\tSpecify that only differences are displayed\0A/os\\tSpecify that only matches are displayed\0A/on\\tSpecify that nothing is displayed'\0A    end\0A\0A    echo -e '/s\\tCompare all subkeys and entries recursively\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_copy_complete_args\0A    echo -e '/s\\tCopy all subkeys and entries under the specified subkey\0A/f\\tCopy the subkey without prompting for confirmation\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_delete_complete_args -a previous_token\0A    if test \22$previous_token\22 = delete\0A        set -l current_token (commandline -tc)\0A        __reg_run_reg_safely query $current_token\0A        return\0A    end\0A\0A    if not __fish_seen_argument -w v -w ve -w va\0A        echo -e '/v\\tDelete a specific entry under the subkey\0A/ve\\tSpecify that only entries that have no value will be deleted\0A/va\\tDelete all entries under the specified subkey'\0A    end\0A\0A    echo -e '/f\\tDelete the existing registry subkey or entry without asking for confirmation\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_export_complete_args -a previous_token\0A    if test \22$previous_token\22 = export\0A        set -l current_token (commandline -tc)\0A        __reg_run_reg_safely query $current_token\0A        return\0A    end\0A\0A    echo -e '/y\\tOverwrite any existing file with the name filename without prompting for confirmation\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_query_complete_args -a previous_token\0A    if test \22$previous_token\22 = query\0A        set -l current_token (commandline -tc)\0A        __reg_run_reg_safely query $current_token\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /t\0A        echo 'REG_SZ\0AREG_MULTI_SZ\0AREG_EXPAND_SZ\0AREG_DWORD\0AREG_BINARY\0AREG_NONE'\0A        return\0A    end\0A\0A    if not __fish_seen_argument -w v -w ve\0A        echo -e '/v\\tSpecify the registry value name\0A/ve\\tRun a query for value names that are empty'\0A    end\0A\0A    if not __fish_seen_argument -w k -w d\0A        echo -e '/k\\tSpecify to search in key names only\0A/d\\tSpecify to search in data only'\0A    end\0A\0A    echo -e '/se\\tSpecify the single value separator\0A/f\\tSpecify the data or pattern to search for\0A/c\\tSpecify that the query is case sensitive\0A/e\\tSpecify to return only exact matches\0A/t\\tSpecify registry types to search\0A/z\\tSpecify to include the numeric equivalent for the registry type in search results\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_save_complete_args -a previous_token\0A    if test \22$previous_token\22 = save\0A        set -l current_token (commandline -tc)\0A        __reg_run_reg_safely query $current_token\0A        return\0A    end\0A\0A    echo -e '/y\\tOverwrite an existing file with the name filename without prompting for confirmation\0A/?\\tShow help'\0Aend\0A\0Afunction __reg_complete_args -d 'Function to generate args'\0A    set -l previous_token (commandline -xc)[-1]\0A\0A    if __fish_seen_subcommand_from add\0A        __reg_add_complete_args $previous_token\0A    else if __fish_seen_subcommand_from compare\0A        __reg_compare_complete_args\0A    else if __fish_seen_subcommand_from copy\0A        __reg_copy_complete_args\0A    else if __fish_seen_subcommand_from delete\0A        __reg_delete_complete_args $previous_token\0A    else if __fish_seen_subcommand_from export\0A        __reg_export_complete_args $previous_token\0A    else if __fish_seen_subcommand_from query\0A        __reg_query_complete_args $previous_token\0A    else if __fish_seen_subcommand_from save\0A        __reg_save_complete_args $previous_token\0A    end\0Aend\0A\0Acomplete -c reg -f -a '(__reg_complete_args)'\0A\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a add \\\0A    -d 'Add a new subkey or entry'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a compare \\\0A    -d 'Compare specified registry subkeys or entries'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a copy \\\0A    -d 'Copy a registry entry'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a delete \\\0A    -d 'Delete a subkey or entries'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a export \\\0A    -d 'Copy the specified subkeys, entries, and values of the local computer into a file'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a import \\\0A    -d 'Copy contents of a file with registry data into the local registry'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a load \\\0A    -d 'Write saved subkeys and entries into a different subkey in the registry'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a query \\\0A    -d 'Return a list of the next tier of subkeys and entries'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a restore \\\0A    -d 'Write saved subkeys and entries back'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a save \\\0A    -d 'Save a copy of specified subkeys, entries, and values of the registry in a specified file'\0Acomplete -c reg -f \\\0A    -n 'not __fish_seen_subcommand_from add compare copy delete export import load query restore save unload' -a unload \\\0A    -d 'Remove a section of the registry that was loaded using the reg load operation'\0A", align 1
