@anon.1d0b41a8d45d477c3029ec78f9b8b434.2254 = private unnamed_addr constant [5760 x i8] c"#completion for opkg\0A\0Afunction __fish_opkg_no_subcommand -d 'Test if opkg has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i update upgrade install configure remove flag list list-installed list-upgradable list-changed-conffiles files search find info status download compare-versions print-architecture depends whatdepends whatdependsrec whatrecommends whatsuggests whatprovides whatconflicts whatreplaces\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_opkg_use_package -d 'Test if opkg command should have packages as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i contains install search find info status download compare-versions print-architecture depends whatdepends whatdependsrec whatrecommends whatsuggests whatprovides whatconflicts whatreplaces\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_opkg_use_package_installed -d 'Test if opkg command should have installed packages as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i contains upgrade configure remove flag files\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Acomplete -c opkg -n __fish_opkg_use_package -a '(__fish_print_opkg_packages)' -d Package\0A\0Acomplete -c opkg -n __fish_opkg_use_package_installed -a '(__fish_print_opkg_packages --installed)' -d Package\0A\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a update -d 'Update list of available packages'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a upgrade -d 'Upgrade packages'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a install -d 'Install package(s)'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a configure -d 'Configure unpacked package(s)'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a remove -d 'Remove package(s)'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a flag -d 'Flag package(s)'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a list -d 'List available packages'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a list-installed -d 'List installed packages'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a list-upgradable -d 'List installed and upgradable packages'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a list-changed-conffiles -d 'List user modified configuration files'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a files -d 'List files belonging to <pkg>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a search -d 'List package providing <file>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a find -d 'List packages whose name or description matches <regexp>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a info -d 'Display all info for <pkg>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a status -d 'Display all status for <pkg>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a download -d 'Download <pkg> to current directory'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a compare-versions -d 'compare versions using <= < > >= = << >>'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a print-architecture -d 'List installable package architectures'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a depends -d 'list depends'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatdepends -d 'list whatdepends'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatdependsrec -d 'list whatdepends recursively'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatrecommends -d 'list whatrecommends'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatsuggests -d 'list whatsuggests'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatprovides -d 'list whatprovides'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatconflicts -d 'list whatconflicts'\0Acomplete -f -n __fish_opkg_no_subcommand -c opkg -a whatreplaces -d 'list whatreplaces'\0A\0Acomplete -c opkg -s A -d 'Query all packages not just those installed'\0Acomplete -c opkg -s V -l verbosity -d 'Set verbosity level to <level>'\0Acomplete -c opkg -s f -l conf -d 'Use <conf_file> as the opkg configuration file'\0Acomplete -c opkg -l cache -d 'Use a package cache'\0Acomplete -c opkg -s d -l dest -d 'Use <dest_name> as the root directory'\0Acomplete -c opkg -s o -l offline-root -d 'Use <dir> as the root directory for offline'\0Acomplete -c opkg -l add-arch -d 'Register architecture with given priority'\0Acomplete -c opkg -l add-dest -d 'Register destination with given path'\0A\0Acomplete -c opkg -l force-depends -d 'Install/remove despite failed dependencies'\0Acomplete -c opkg -l force-maintainer -d 'Overwrite preexisting config files'\0Acomplete -c opkg -l force-reinstall -d 'Reinstall package(s)'\0Acomplete -c opkg -l force-overwrite -d 'Overwrite files from other package(s)'\0Acomplete -c opkg -l force-downgrade -d 'Allow opkg to downgrade packages'\0Acomplete -c opkg -l force-space -d 'Disable free space checks'\0Acomplete -c opkg -l force-postinstall -d 'Run postinstall scripts even in offline mode'\0Acomplete -c opkg -l force-remove -d 'Remove package even if prerm script fails'\0Acomplete -c opkg -l force-checksum -d 'Don\\'t fail on checksum mismatches'\0Acomplete -c opkg -l noaction -d 'No action -- test only'\0Acomplete -c opkg -l download-only -d 'No action -- download only'\0Acomplete -c opkg -l nodeps -d 'Do not follow dependencies'\0Acomplete -c opkg -l nocase -d 'Perform case insensitive pattern matching'\0Acomplete -c opkg -l size -d 'Print package size when listing available packages'\0Acomplete -c opkg -l force-removal-of-dependent-packages -d 'Remove package and all dependencies'\0Acomplete -c opkg -l autoremove -d 'Remove automatically installed packages'\0Acomplete -c opkg -s t -l tmp-dir -d 'Specify tmp-dir.'\0Acomplete -c opkg -s l -l lists-dir -