@anon.1d0b41a8d45d477c3029ec78f9b8b434.3006 = private unnamed_addr constant [12183 x i8] c"set -l progname yaourt\0Acomplete -c $progname -f\0A\0Aset -l listinstalled \22(__fish_print_pacman_packages --installed)\22\0A# This might be an issue if another package manager is also installed (e.g. for containers)\0Aset -l listall \22(__fish_print_pacman_packages)\22\0Aset -l listrepos \22(__fish_print_pacman_repos)\22\0Aset -l listgroups \22(pacman -Sg)\\t'Package Group'\22\0A\0Aset -l hasopt '__fish_contains_opt -s B backup -s C -s G getpkgbuild -s P pkgbuild -s D database -s Q query -s R remove -s S sync -s U upgrade -s F files stats'\0Aset -l noopt \22not $hasopt\22\0A\0Aset -l backup '__fish_contains_opt -s B backup'\0Aset -l clean '__fish_contains_opt -s C'\0Aset -l getpkgbuild '__fish_contains_opt -s G getpkgbuild'\0Aset -l pkgbuild '__fish_contains_opt -s P pkgbuild'\0Aset -l database '__fish_contains_opt -s D database'\0Aset -l query '__fish_contains_opt -s Q query'\0Aset -l remove '__fish_contains_opt -s R remove'\0Aset -l sync '__fish_contains_opt -s S sync'\0Aset -l upgrade '__fish_contains_opt -s U upgrade'\0Aset -l files '__fish_contains_opt -s F files'\0A\0A# HACK: We only need these three to coerce fish to stop file completion and complete options\0Acomplete -c $progname -n $noopt -a -D -d \22Modify the package database\22\0Acomplete -c $progname -n $noopt -a -Q -d \22Query the package database\22\0Acomplete -c $progname -n $noopt -a -C -d \22Manage .pac* files\22\0A# Primary operations\0Acomplete -c $progname -s D -f -l database -n $noopt -d 'Modify the package database'\0Acomplete -c $progname -s Q -f -l query -n $noopt -d 'Query the package database'\0Acomplete -c $progname -s R -f -l remove -n $noopt -d 'Remove packages from the system'\0Acomplete -c $progname -s S -f -l sync -n $noopt -d 'Synchronize packages'\0Acomplete -c $progname -s T -f -l deptest -n $noopt -d 'Check dependencies'\0Acomplete -c $progname -s U -f -l upgrade -n $noopt -d 'Upgrade or add a local package'\0Acomplete -c $progname -s F -f -l files -n $noopt -d 'Query the files database'\0Acomplete -c $progname -s V -f -l version -d 'Display version and exit'\0Acomplete -c $progname -s h -f -l help -d 'Display help'\0A# $progname operations\0Acomplete -c $progname -n $noopt -s B -l backup -d \22Backup or restore alpm local database\22\0Acomplete -c $progname -n $noopt -s C -f -d \22Manage .pac* files\22\0Acomplete -c $progname -n $noopt -s G -f -l getpkgbuild -d \22Get PKGBUILD from ABS or AUR\22\0Acomplete -c $progname -n $noopt -s P -l pkgbuild -d \22Build package from PKGBUILD found in a local directory\22\0Acomplete -c $progname -n $noopt -f -l stats -d \22Show some statistics about your packages\22\0A\0A# General options\0A# Only offer these once a command has been given so they get prominent display\0Acomplete -c $progname -n $noopt -s b -l dbpath -d 'Alternative database location' -xa '(__fish_complete_directories)'\0Acomplete -c $progname -n $hasopt -s r -l root -d 'Alternative installation root'\0Acomplete -c $progname -n $hasopt -s v -l verbose -d 'Output more status messages'\0Acomplete -c $progname -n $hasopt -l arch -d 'Alternate architecture' -f\0Acomplete -c $progname -n $hasopt -l cachedir -d 'Alternative package cache location'\0Acomplete -c $progname -n $hasopt -l config -d 'Alternate config file'\0Acomplete -c $progname -n $hasopt -l debug -d 'Display debug messages' -f\0Acomplete -c $progname -n $hasopt -l gpgdir -d 'GPG directory to verify signatures'\0Acomplete -c $progname -n $hasopt -l hookdir -d 'Hook file directory'\0Acomplete -c $progname -n $hasopt -l logfile -d 'Specify alternative log file'\0Acomplete -c $progname -n $hasopt -l noconfirm -d 'Bypass any question' -f\0A# General options (yaourt only)\0Acomplete -c $progname -n $hasopt -l color -d 'Force color'\0Acomplete -c $progname -n $hasopt -l force -d 'Force installation or updates'\0Acomplete -c $progname -n $hasopt -l insecure -d 'Allow to perform \22insecure\22 SSL connections'\0Acomplete -c $progname -n $hasopt -l nocolor -d 'Disable color'\0Acomplete -c $progname -n $hasopt -l confirm -d 'Always ask for confirmation'\0Acomplete -c $progname -n $hasopt -l pager -d 'Use $PAGER to show search results'\0Acomplete -c $progname -n $hasopt -l export -x -a '(__fish_complete_directories)' -d 'Export built packages and their sources to DIR'\0Acomplete -c $progname -n $hasopt -l tmp -x -a '(__fish_complete_directories)' -d 'Use DIR as temporary folder'\0A\0A# Transaction options (sync, remove, upgrade)\0Afor condition in sync remove upgrade\0A    complete -c $progname -n $$condition -s d -l nodeps -d 'Skip [all] dependency checks' -f\0A    complete -c $progname -n $$condition -l dbonly -d 'Modify database entry only' -f\0A    complete -c $progname -n $$condition -l noprogressbar -d 'Do not display progress bar' -f\0A    complete -c $progname -n $$condition -l noscriptlet -d 'Do not execute install script' -f\0A    complete -c $progname -n $$condition -s p -l print -d 'Dry run, only print targets' -f\0A    complete -c $progname -n $$condition -l print-format -x -d 'Specify printf-like format' -f\0Aend\0A\0A# Database and upgrade options (database, sync, upgrade)\0Afor condition in database sync upgrade\0A    complete -c $progname -n $$condition -l asdeps -d 'Mark PACKAGE as dependency' -f\0A    complete -c $progname -n $$condition -l asexplicit -d 'Mark PACKAGE as explicitly installed' -f\0Aend\0A\0A# Upgrade options (sync, upgrade)\0Afor condition in sync upgrade\0A    complete -c $progname -n $$condition -l force -d 'Bypass file conflict checks' -f\0A    complete -c $progname -n $$condition -l ignore -d 'Ignore upgrade of PACKAGE' -xa \22$listinstalled\22 -f\0A    complete -c $progname -n $$condition -l ignoregroup -d 'Ignore upgrade of GROUP' -xa \22$listgroups\22 -f\0A    complete -c $progname -n $$condition -l needed -d 'Do not reinstall up-to-date targets' -f\0A    complete -c $progname -n $$condition -l recursive -d 'Recursively reinstall all dependencies' -f\0Aend\0A\0A# Query and sync options\0Afor condition in query sync\0A    complete -c $progname -n $$condition -s g -l groups -d 'Display all packages in GROUP' -xa \22$listgroups\22 -f\0A    complete -c $progname -n $$condition -s i -l info -d 'Display information on PACKAGE' -f\0A    complete -c $progname -n $$condition -s q -l quiet -d 'Show less information' -f\0A    complete -c $progname -n $$condition -s s -l search -r -d 'Search packages for regexp' -f\0A    # Yaourt only\0A    complete -c $progname -n $$condition -l conflicts -d 'Show packages that conflict with one of the targets'\0A    complete -c $progname -n $$condition -l depends -d 'Show packages that depend on one of the targets'\0A    complete -c $progname -n $$condition -l provides -d 'Show packages that provide one of the targets'\0A    complete -c $progname -n $$condition -l replaces -d 'Show packages that replace one of the targets'\0A    complete -c $progname -n $$condition -l nameonly -d 'Query the package names only'\0Aend\0A\0A# Query options\0Acomplete -c $progname -n $query -s c -l changelog -d 'View the change log of PACKAGE' -f\0Acomplete -c $progname -n $query -s d -l deps -d 'List only non-explicit packages (dependencies)' -f\0Acomplete -c $progname -n $query -s e -l explicit -d 'List only explicitly installed packages' -f\0Acomplete -c $progname -n $query -s k -l check -d 'Check if all files owned by PACKAGE are present' -f\0Acomplete -c $progname -n $query -s l -l list -d 'List all files owned by PACKAGE' -f\0Acomplete -c $progname -n $query -s m -l foreign -d 'List all packages not in the database' -f\0Acomplete -c $progname -n $query -s o -l owns -rF -d 'Search for the package that owns FILE'\0Acomplete -c $progname -n $query -s p -l file -d 'Apply the query to a package file, not package'\0Acomplete -c $progname -n $query -s t -l unrequired -d 'List only unrequired packages' -f\0Acomplete -c $progname -n $query -s u -l upgrades -d 'List only out-of-date packages' -f\0Acomplete -c $progname -n \22$query\22 -d 'Installed package' -xa $listinstalled -f\0A# Yaourt only query options\0A# Backup file is always saved as pacman-$date.tar.bz2\0Acomplete -c $progname -n $query -r -l backupfile -k -a '(__fish_complete_suffix tar.bz2)' -d 'Query FILE instead of alpm/aur'\0Acomplete -c $progname -n $query -l date -d 'List queries result sorted by installation date'\0A\0A# Remove options\0Acomplete -c $progname -n $remove -s c -l cascade -d 'Also remove packages depending on PACKAGE' -f\0Acomplete -c $progname -n $remove -s n -l nosave -d 'Ignore file backup designations' -f\0Acomplete -c $progname -n $remove -s s -l recursive -d 'Also remove dependencies of PACKAGE' -f\0Acomplete -c $progname -n $remove -s u -l unneeded -d 'Only remove targets not required by PACKAGE' -f\0Acomplete -c $progname -n \22$remove\22 -d 'Installed package' -xa $listinstalled -f\0A\0A# Sync options\0Acomplete -c $progname -n $sync -s c -l clean -d 'Remove [all] packages from cache'\0Acomplete -c $progname -n $sync -s l -l list -xa \22$listrepos\22 -d 'List all packages in REPOSITORY'\0Acomplete -c $progname -n \22$sync; and not __fish_contains_opt -s u sysupgrade\22 -s u -l sysupgrade -d 'Upgrade all packages that are out of date'\0Acomplete -c $progname -n \22$sync; and __fish_contains_opt -s u sysupgrade\22 -s u -l sysupgrade -d 'Also downgrade packages'\0Acomplete -c $progname -n $sync -s w -l downloadonly -d 'Only download the target packages'\0Acomplete -c $progname -n $sync -s y -l refresh -d 'Download fresh copy of the package list'\0Acomplete -c $progname -n \22$sync\22 -xa \22$listall $listgroups\22\0A# Additional sync options\0Acomplete -c $progname -n $sync -s a -l aur -d 'Also search in AUR database'\0Acomplete -c $progname -n $sync -s A -l ignorearch -d 'Pass -A or --ignorearch option to makepkg'\0Acomplete -c $progname -n $sync -l aur-url -x -d 'Specify a custom AUR url'\0Aset -l has_build_opt '__fish_contains_opt -s b build'\0Acomplete -c $progname -n \22$sync; and not $has_build_opt\22 -s b -l build -d 'Build from sources(AUR or ABS)'\0Acomplete -c $progname -n \22$sync; and     $has_build_opt\22 -s b -l build -d 'Also build all dependencies'\0Acomplete -c $progname -n $sync -l devel -d 'Search an update for devel packages'\0Acomplete -c $progname -n $sync -l maintainer -d 'Search packages by maintainer instead of name (AUR only)'\0Acomplete -c $progname -n $sync -l m-arg -d 'Pass additional options to makepkg'\0A\0A# Database options\0Aset -l has_db_opt '__fish_contains_opt asdeps asexplicit'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -xa --asdeps -d 'Mark PACKAGE as dependency'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -xa --asexplicit -d 'Mark PACKAGE as explicitly installed'\0Acomplete -c $progname -n \22$database; and not $has_db_opt\22 -s k -l check -d 'Check database validity'\0Acomplete -c $progname -n \22$has_db_opt; and $database\22 -xa \22$listinstalled\22\0A\0A# File options - since pacman 5\0Aset -l has_file_opt '__fish_contains_opt list search -s l -s s'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa --list -d 'List files owned by given packages'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa -l -d 'List files owned by given packages'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa --search -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files; and not $has_file_opt\22 -xa -s -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files\22 -s y -l refresh -d 'Refresh the files database' -f\0Acomplete -c $progname -n \22$files\22 -s l -l list -d 'List files owned by given packages' -xa $listall\0Acomplete -c $progname -n \22$files\22 -s s -l search -d 'Search packages for matching files'\0Acomplete -c $progname -n \22$files\22 -s o -l owns -d 'Search for packages that include the given files'\0Acomplete -c $progname -n \22$files\22 -s q -l quiet -d 'Show less information' -f\0Acomplete -c $progname -n \22$files\22 -l machinereadable -d 'Show in machine readable format' -f\0A\0A# Upgrade options\0A# Theoretically, pacman reads packages in all formats that libarchive supports\0A# In practice, it's going to be tar.xz, tar.gz or tar.zst\0Acomplete -c $progname -n \22$upgrade\22 -k -xa '(__fish_complete_suffix pkg.tar.zst pkg.tar.xz pkg.tar.gz)' -d 'Package file'\0A\0A## Yaourt only stuff\0A# Clean options\0Aset -l has_clean_opt '__fish_contains_opt clean'\0Acomplete -c $progname -n \22$clean; and not $has_clean_opt\22 -xa --clean -d 'Clean all these files'\0A\0A# pkgbuild options\0Acomplete -c $progname -n $pkgbuild -s i -l install -d 'Also install the package'\0A\0A# getpkgbuild options\0Acomplete -c $progname -n $getpkgbuild -xa \22$listall\22\0A", align 1
