@anon.1d0b41a8d45d477c3029ec78f9b8b434.2618 = private unnamed_addr constant [11601 x i8] c"# Completions for `snap` command\0A\0Afunction __fish_snap_no_subcommand -d 'Test if snap has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i abort ack alias aliases buy changes connect disable disconnect download \\\0A                enable find get help info install interfaces known list login logout prefer refresh remove \\\0A                revert run set tasks try unalias version watch\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_snap_using_subcommand -d 'Test if given subcommand is used'\0A    for i in (commandline -xpc)\0A        if contains -- $i $argv[1]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_snap_use_file -d 'Test if snap command should have files as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i ack try\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_snap_subcommand\0A    set -l subcommand $argv[1]\0A    set -e argv[1]\0A    complete -f -c snap -n __fish_snap_no_subcommand -a $subcommand $argv\0Aend\0A\0Afunction __fish_snap_option\0A    set -l subcommand $argv[1]\0A    set -e argv[1]\0A    complete -f -c snap -n \22__fish_snap_using_subcommand $subcommand\22 $argv\0Aend\0A\0Afunction __fish_snap_disabled_snaps -d 'List disabled snaps'\0A    snap list | string match \22*disabled\22 | string replace -r '(.+?) .*disabled' '$1'\0Aend\0A\0Afunction __fish_snap_enabled_snaps -d 'List disabled snaps'\0A    snap list | string match -vr \22disabled|Name\22 | string replace -r '(.+?) .*' '$1'\0Aend\0A\0Afunction __fish_snap_installed_snaps -d 'List installed snaps'\0A    snap list | string replace -r '(.+?) .*' '$1' | string match -v 'Name*'\0Aend\0A\0Afunction __fish_snap_interfaces -d 'List of interfaces'\0A    for snap in (__fish_snap_installed_snaps)\0A        if test $snap != core\0A            snap interfaces $snap 2>/dev/null | string replace -r '[- ]*([^ ]*)[ ]+([^ ]+)' '$2$1' | string match -v \22*Slot*\22\0A        end\0A    end\0Aend\0A\0Afunction __fish_snap_change_id -d 'List change IDs'\0A    snap changes | string match -v 'ID*' | string replace -r '([0-9]*) .*' '$1'\0Aend\0A\0Afunction __fish_snap_aliases -d 'List aliases'\0A    snap aliases | string match -v 'Command*' | string replace -r '.* (.+?) .*$' '$1'\0A    snap aliases | string match -v 'Command*' | string replace -r '(.*?) .*$' '$1'\0Aend\0A\0Afunction __fish_snap_no_assertion -d 'Check that no assertion type is used yet'\0A    for i in (commandline -xpc)\0A        if contains -- $i account account-key model serial snap-declaration snap-build snap-revision \\\0A                system-user validation\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_snap_using_assertion -d 'Check if certain assertion type is used'\0A    if __fish_snap_using_subcommand known\0A        if __fish_snap_using_subcommand $argv[1]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_snap_assertion\0A    set -l assertion $argv[1]\0A    set -e argv[1]\0A    complete -f -c snap -n '__fish_snap_using_subcommand known; and __fish_snap_no_assertion' -a $assertion\0A    complete -f -c snap -n \22__fish_snap_using_assertion $assertion\22 -a \22(__fish_snap_filters $assertion)\22 \\\0A        -d Filter\0Aend\0A\0Afunction __fish_snap_filters -d 'List assertion filters'\0A    snap known $argv[1] | string match -v 'type:*' | string match '*: *' | string replace -r '(.*): (.*)' '$1=$2'\0Aend\0A\0A# Enable file completions where appropriate\0Acomplete -c snap -n __fish_snap_use_file -a '(__fish_complete_path)'\0A\0A# Support flags\0Acomplete -x -f -c snap -s h -l help -d 'Show this help message'\0Acomplete -x -f -c snap -s v -l version -d 'Print the version and exit'\0A\0A# Abort\0A__fish_snap_subcommand abort -d \22Abort a pending change\22\0A\0A# Ack\0A__fish_snap_subcommand ack -r -d \22Adds an assertion to the system\22\0A\0A# Alias\0A__fish_snap_subcommand alias -r -d \22Sets up a manual alias\22\0A__fish_snap_option alias -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Aliases\0A__fish_snap_subcommand aliases -d \22Lists aliases in the system\22\0A\0A# Buy\0A__fish_snap_subcommand buy -r -d \22Buys a snap\22\0A\0A# Changes\0A__fish_snap_subcommand changes -d \22List system changes\22\0A\0A# Connect\0A__fish_snap_subcommand connect -r -d \22Connects a plug to a slot\22\0A__fish_snap_option connect -a '(__fish_snap_interfaces)' -d \22Snap:Plug or Slot\22\0A\0A# Disable\0A__fish_snap_subcommand disable -r -d \22Disables a snap in the system\22\0A__fish_snap_option disable -a '(__fish_snap_enabled_snaps)' -d \22Enabled snap\22\0A\0A# Disconnect\0A__fish_snap_subcommand disconnect -r -d \22Disconnects a plug from a slot\22\0A__fish_snap_option disconnect -a '(__fish_snap_interfaces)' -d \22Snap:Plug or Slot\22\0A\0A# Downloads\0A__fish_snap_subcommand download -r -d \22Downloads the given snap\22\0A__fish_snap_option download -l channel -d \22Use this channel instead of stable\22\0A__fish_snap_option download -l edge -d \22Install from the edge channel\22\0A__fish_snap_option download -l beta -d \22Install from the beta channel\22\0A__fish_snap_option download -l candidate -d \22Install from the candidate channel\22\0A__fish_snap_option download -l stable -d \22Install from the stable channel\22\0A__fish_snap_option download -l revision -d \22Download the given revision of snap, to which you must have developer access\22\0A\0A# Enable\0A__fish_snap_subcommand enable -r -d \22Enables a snap in the system\22\0A__fish_snap_option enable -a '(__fish_snap_disabled_snaps)' -d \22Disabled snap\22\0A\0A# Find\0A__fish_snap_subcommand find -r -d \22Finds packages to install\22\0A__fish_snap_option find -l private -d \22Search private snaps\22\0A__fish_snap_option find -l section -d \22Restrict the search to a given section\22\0A\0A# There seems to be no programmatic way of getting configuration options\0A# Get\0A__fish_snap_subcommand get -r -d \22Prints configuration options\22\0A__fish_snap_option get -s t -d \22Strict typing with nulls and quoted strings\22\0A__fish_snap_option get -s d -d \22Always return documents, even with single key\22\0A__fish_snap_option get -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Help\0A__fish_snap_subcommand help -d \22The help command shows useful information\22\0A__fish_snap_option help -l man -d \22Generates the manpage\22\0A\0A# Info\0A__fish_snap_subcommand info -r -d \22Show detailed information about a snap\22\0A__fish_snap_option info -l verbose -d \22Include a verbose list of snap's notes\22\0A__fish_snap_option info -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Install\0A__fish_snap_subcommand install -r -d \22Installs a snap to the system\22\0A__fish_snap_option install -l channel -d \22Use this channel instead of stable\22\0A__fish_snap_option install -l edge -d \22Install from the edge channel\22\0A__fish_snap_option install -l beta -d \22Install from the beta channel\22\0A__fish_snap_option install -l candidate -d \22Install from the candidate channel\22\0A__fish_snap_option install -l stable -d \22Install from the stable channel\22\0A__fish_snap_option install -l revision -d \22Install the given revision of snap, to which you must have developer access\22\0A__fish_snap_option install -l devmode -d \22Put snap in development mode and disable security confinement\22\0A__fish_snap_option install -l jailmode -d \22Put snap in enforced confinement mode\22\0A__fish_snap_option install -l classic -d \22Put snap in classic mode and disable security confinement\22\0A__fish_snap_option install -l dangerous -d \22Install the given snap even without pre-acknowledged signatures (DANGEROUS)\22\0A\0A# Interfaces\0A__fish_snap_subcommand interfaces -d \22Lists interfaces in the system\22\0Acomplete -f -c snap -n '__fish_snap_using_subcommand interfaces' -a '(__fish_snap_installed_snaps)' -d Snap\0A__fish_snap_option interfaces -s i -d \22Constrain listing to specific interfaces\22\0A\0A# Known\0A__fish_snap_subcommand known -r -d \22Shows known assertions of the provided type\22\0A__fish_snap_option known -l remote -d \22Shows known assertions of the provided type\22\0A__fish_snap_assertion account -d 'Assertion type'\0A__fish_snap_assertion account-key -d 'Assertion type'\0A__fish_snap_assertion model -d 'Assertion type'\0A__fish_snap_assertion serial -d 'Assertion type'\0A__fish_snap_assertion snap-declaration -d 'Assertion type'\0A__fish_snap_assertion snap-build -d 'Assertion type'\0A__fish_snap_assertion snap-revision -d 'Assertion type'\0A__fish_snap_assertion system-user -d 'Assertion type'\0A__fish_snap_assertion validation -d 'Assertion type'\0A\0A# List\0A__fish_snap_subcommand list -d \22List installed snaps\22\0A__fish_snap_option list -l all -d \22Show all revisions\22\0A\0A# Login\0A__fish_snap_subcommand login -d \22Authenticates on snapd and the store\22\0A\0A# Logout\0A__fish_snap_subcommand logout -d \22Log out of the store\22\0A\0A# Prefer\0A__fish_snap_subcommand prefer -r -d \22Prefes aliases from a snap and disable conflicts\22\0A__fish_snap_option prefer -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Refresh\0A__fish_snap_subcommand refresh -r -d \22Refreshes a snap in the system\22\0A__fish_snap_option refresh -l channel -d \22Use this channel instead of stable\22\0A__fish_snap_option refresh -l edge -d \22Install from the edge channel\22\0A__fish_snap_option refresh -l beta -d \22Install from the beta channel\22\0A__fish_snap_option refresh -l candidate -d \22Install from the candidate channel\22\0A__fish_snap_option refresh -l stable -d \22Install from the stable channel\22\0A__fish_snap_option refresh -l revision -d \22Refresh to the given revision\22\0A__fish_snap_option refresh -l devmode -d \22Put snap in development mode and disable security confinement\22\0A__fish_snap_option refresh -l jailmode -d \22Put snap in enforced confinement mode\22\0A__fish_snap_option refresh -l classic -d \22Put snap in classic mode and disable security confinement\22\0A__fish_snap_option refresh -l ignore-validation -d \22Ignore validation by other snaps blocking the refresh\22\0A__fish_snap_option refresh -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Remove\0A__fish_snap_subcommand remove -r -d \22Removes a snap from the system\22\0A__fish_snap_option remove -l revision -d \22Removes only the given revision\22\0A__fish_snap_option remove -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Revert\0A__fish_snap_subcommand revert -r -d \22Revert the given snap to the previous state\22\0A__fish_snap_option refresh -l revision -d \22Revert to the given revision\22\0A__fish_snap_option refresh -l devmode -d \22Put snap in development mode and disable security confinement\22\0A__fish_snap_option refresh -l jailmode -d \22Put snap in enforced confinement mode\22\0A__fish_snap_option refresh -l classic -d \22Put snap in classic mode and disable security confinement\22\0A__fish_snap_option revert -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Run\0A__fish_snap_subcommand run -r -d \22Run the given snap command\22\0A__fish_snap_option run -l shell -d \22Run a shell instead of the command (useful for debugging)\22\0A__fish_snap_option run -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# There seems to be no programmatic way of getting configuration options\0A# Set\0A__fish_snap_subcommand set -r -d \22Changes configuration options\22\0A__fish_snap_option set -a '(__fish_snap_installed_snaps)' -d Snap\0A\0A# Tasks\0A__fish_snap_subcommand tasks -d \22List a change's tasks\22\0A__fish_snap_option tasks -a '(__fish_snap_change_id)' -d ID\0A\0A# Try\0A__fish_snap_subcommand try -r -d \22Tests a snap in the system\22\0A__fish_snap_option try -l devmode -d \22Put snap in development mode and disable security confinement\22\0A__fish_snap_option try -l jailmode -d \22Put snap in enforced confinement mode\22\0A__fish_snap_option try -l classic -d \22Put snap in classic mode and disable security confinement\22\0A\0A# Unalias\0A__fish_snap_subcommand unalias -r -d \22Unalias a manual alias or an entire snap\22\0A__fish_snap_option unalias -a '(__fish_snap_aliases)' -d \22Alias or snap\22\0A\0A# Version\0A__fish_snap_subcommand version -d \22Shows version details\22\0A\0A# Watch\0A__fish_snap_subcommand watch -d \22Watch a change in progress\22\0A__fish_snap_option watch -a '(__fish_snap_change_id)' -d ID\0A", align 1
