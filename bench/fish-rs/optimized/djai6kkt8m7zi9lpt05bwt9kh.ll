@anon.1d0b41a8d45d477c3029ec78f9b8b434.3042 = private unnamed_addr constant [7800 x i8] c"complete -c zef -f\0Acomplete -c zef -n __fish_is_first_token -s h -l help -f -d 'Display help text'\0Acomplete -c zef -n __fish_is_first_token -l version -f -d 'Detailed version information'\0Acomplete -c zef -n 'not __fish_is_first_token' -l config-path -r -F -d 'Load a specific Zef config file'\0Acomplete -c zef -n 'not __fish_is_first_token' -l error -d 'Verbosity level'\0Acomplete -c zef -n 'not __fish_is_first_token' -l warn -d 'Verbosity level'\0Acomplete -c zef -n 'not __fish_is_first_token' -l info -d 'Verbosity level (default)'\0Acomplete -c zef -n 'not __fish_is_first_token' -s v -l verbose -d 'Verbosity level'\0Acomplete -c zef -n 'not __fish_is_first_token' -l debug -d 'Verbosity level'\0A\0A# Commands\0Acomplete -c zef -n __fish_use_subcommand -a install -d 'Install specific distributions by name or path'\0Acomplete -c zef -n __fish_use_subcommand -a uninstall -f -d 'Uninstall specific distributions'\0Acomplete -c zef -n __fish_use_subcommand -a test -d 'Run tests on a given module\\'s path'\0Acomplete -c zef -n __fish_use_subcommand -a fetch -d 'Fetch and extract module\\'s source'\0Acomplete -c zef -n __fish_use_subcommand -a build -d 'Run the Build.pm in a given module\\'s path'\0Acomplete -c zef -n __fish_use_subcommand -a look -x -d 'Download a single module and change into its directory'\0Acomplete -c zef -n __fish_use_subcommand -a update -d 'Update package indexes for repositories'\0Acomplete -c zef -n __fish_use_subcommand -a upgrade -d 'Upgrade specific distributions (or all if no arguments)'\0Acomplete -c zef -n __fish_use_subcommand -a search -d 'Show a list of possible distribution candidates for the given terms'\0Acomplete -c zef -n __fish_use_subcommand -a info -d 'Show detailed distribution information'\0Acomplete -c zef -n __fish_use_subcommand -a browse -d 'Browse support urls (bugtracker etc)'\0Acomplete -c zef -n __fish_use_subcommand -a list -d 'List available distributions'\0Acomplete -c zef -n __fish_use_subcommand -a depends -d 'List full dependencies for a given identity'\0Acomplete -c zef -n __fish_use_subcommand -a rdepends -d 'List all distributions directly depending on a given identity'\0Acomplete -c zef -n __fish_use_subcommand -a locate -d 'Lookup installed module information by short-name, name-path, sha1'\0Acomplete -c zef -n __fish_use_subcommand -a smoke -d 'Run smoke testing on available modules'\0Acomplete -c zef -n __fish_use_subcommand -a nuke -d 'Delete directory/prefix containing matching configuration path or CURLI name'\0A\0A# Shared options\0Acomplete -c zef -n '__fish_seen_subcommand_from install test build' -k -a '(__fish_complete_suffix)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l fetch\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l build\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l /build -d 'Skip the building phase'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l test\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l /test -d 'Skip the testing phase'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l depends\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l /depends -d 'Do not fetch runtime dependencies'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l build-depends\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l /build-depends -d 'Do not fetch build dependencies'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l test-depends\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke depends rdepends' -l /test-depends -d 'Do not fetch test dependencies'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test fetch build' -l force -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l force-resolve -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke fetch' -l force-fetch -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l force-extract -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke build' -l force-build -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test' -l force-test -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l force-install -d 'Ignore errors'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test fetch build' -x -l timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke fetch' -x -l fetch-timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -x -l extract-timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke build' -x -l build-timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test' -x -l test-timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -x -l install-timeout -d 'Set a timeout (in seconds)'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test fetch' -x -l degree -d 'Number of simultaneous jobs to process'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke fetch' -x -l fetch-degree -d 'Number of simultaneous jobs to process'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke test' -x -l test-degree -d 'Number of simultaneous jobs to process'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l dry -d 'Run all phases except the actual installations'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l serial -d 'Install each dependency after passing testing and before building/testing the next dependency'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke fetch search info list' -l update -d 'Force a refresh for all module indexes or a specific ecosystem'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke fetch search info list' -l /update -d 'Skip refreshing all module indexes or a specific ecosystem'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l exclude\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l to -r -F -d 'Short name or spec of CompUnit::Repository to install to'\0Acomplete -c zef -n '__fish_seen_subcommand_from install upgrade smoke' -l install-to -r -F -d 'Short name or spec of CompUnit::Repository to install to'\0A\0A# Install\0Acomplete -c zef -n '__fish_seen_subcommand_from install' -l upgrade\0Acomplete -c zef -n '__fish_seen_subcommand_from install' -l deps-only -d 'Install only the dependency chains of the requested distributions'\0Acomplete -c zef -n '__fish_seen_subcommand_from install' -l contained -d 'Install dependencies regardless if they are already installed globally'\0A\0A# Uninstall\0Acomplete -c zef -n '__fish_seen_subcommand_from uninstall' -l from\0Acomplete -c zef -n '__fish_seen_subcommand_from uninstall' -l uninstall-from\0A\0A# Search, Info\0Acomplete -c zef -n '__fish_seen_subcommand_from search info' -x -l wrap\0A\0A# Browse\0Acomplete -c zef -n '__fish_seen_subcommand_from browse' -l open\0Acomplete -c zef -n '__fish_seen_subcommand_from browse' -l /open\0A\0A# List\0Acomplete -c zef -n '__fish_seen_subcommand_from list' -x -l max\0Acomplete -c zef -n '__fish_seen_subcommand_from list' -s i -l installed\0A\0A# Locate\0Acomplete -c zef -n '__fish_seen_subcommand_from locate' -l sha1\0A\0A# Nuke\0Acomplete -c zef -n '__fish_seen_subcommand_from locate' -l confirm\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3043 = private unnamed_addr constant [20 x i8] c"completions/zfs.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3044 = private unnamed_addr constant [44109 x i8] c"# Fish completions for the ZFS `zfs` command\0A#\0A# Possible enhancements:\0A# - Add a test to propose iSCSI and Trusted Extensions completions only when such system is present;\0A# - Illumos man pages suggests that it does not support nbmand nor atime mount option, so these\0A#   properties should be proposed only when available;\0A# - Generally, propose properties only when the current OS and ZFS versions support them;\0A# - For the promote command, propose only eligible filesystems;\0A# - For the rollback command, propose only the most recent snapshot for each dataset, as it will not\0A#   accept an intermediary snapshot;\0A# - For the release command, complete with existing tags;\0A# - For the diff command, complete the destination dataset of the diff;\0A# - For the program command, complete the script to be executed;\0A# - For commands accepting several arguments of different types, propose arguments in the right\0A#   order: for get, once the ZFS parameters have been given, only propose datasets.\0A\0Aset -l OS \22\22\0Aset -l freebsd_version \22\22\0Aswitch (uname)\0A    case Linux\0A        set OS Linux\0A    case Darwin\0A        set OS macOS\0A    case FreeBSD\0A        set OS FreeBSD\0A        set freebsd_version (uname -U)\0A    case SunOS\0A        set OS SunOS\0A        # Others?\0A    case \22*\22\0A        set OS unknown\0Aend\0A\0A# Certain functionality is exclusive to platforms using OpenZFS. This used to be just Linux, but it\0A# now includes FreeBSD 13 and above.\0Aif not type -q __fish_is_openzfs\0A    function __fish_is_openzfs --inherit-variable freebsd_version --inherit-variable OS\0A        test $OS = Linux || test $OS = FreeBSD -a $freebsd_version -gt 1300000\0A    end\0Aend\0A\0A# Does the current invocation need a command?\0Afunction __fish_zfs_needs_command\0A    set -l bookmark \22\22\0A    if __fish_is_zfs_feature_enabled \22feature@bookmarks\22\0A        set bookmark bookmark\0A    end\0A\0A    not __fish_seen_subcommand_from \\? create destroy snap{,shot} rollback clone promote rename list set get inherit upgrade {user,group}space {u,un,}mount {un,}share $bookmark send receive recv {un,}allow hold{s,} release diff program load-key unload-key change-key\0Aend\0A\0Afunction __fish_zfs_using_command # ZFS command whose completions are looked for\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1 # The token can only be 'zfs', so skip\0A        return 2\0A    end\0A    if test $cmd[2] = $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_zfs_list_dataset_types\0A    echo -e \22filesystem\\tZFS filesystem\22\0A    echo -e \22snapshot\\tZFS filesystem snapshot\22\0A    echo -e \22volume\\tZFS block storage device\22\0A    echo -e \22bookmark\\tZFS snapshot bookmark\22\0A    echo -e \22all\\tAny ZFS dataset\22\0Aend\0A\0Afunction __fish_zfs_list_source_types\0A    echo -e \22local\\tDataset-specific value\22\0A    echo -e \22default\\tDefault ZFS value\22\0A    echo -e \22inherited\\tValue inherited from parent dataset\22\0A    echo -e \22received\\tValue received by 'zfs receive'\22\0A    echo -e \22temporary\\tValue valid for the current mount\22\0A    echo -e \22none\\tRead-only value\22\0Aend\0A\0Afunction __fish_zfs_list_get_fields\0A    echo -e \22name\\tDataset full name\22\0A    echo -e \22property\\tProperty\22\0A    echo -e \22value\\tProperty value\22\0A    echo -e \22source\\tProperty value origin\22\0Aend\0A\0Afunction __fish_zfs_list_space_fields\0A    echo -e \22type\\tIdentity type\22\0A    echo -e \22name\\tIdentity name\22\0A    echo -e \22used\\tSpace usage\22\0A    echo -e \22quota\\tSpace quota\22\0Aend\0A\0Afunction __fish_zfs_list_userspace_types\0A    echo -e \22posixuser\\tPOSIX user\22\0A    echo -e \22smbuser\\tSamba user\22\0A    echo -e \22all\\tBoth types\22\0Aend\0A\0Afunction __fish_zfs_list_groupspace_types\0A    echo -e \22posixgroup\\tPOSIX group\22\0A    echo -e \22smbgroup\\tSamba group\22\0A    echo -e \22all\\tBoth types\22\0Aend\0A\0Afunction __fish_zfs_complete_property_values -a name\0A    # To make updates easier, instead of using a switch/case here we just copy-and-paste the lines\0A    # from zfsprops(8) directly, and then parse them when the function is called.\0A\0A    set all_options \22\0A    aclinherit=discard|noallow|restricted|passthrough|passthrough-x\0A    aclmode=discard|groupmask|passthrough|restricted\0A    acltype=off|nfsv4|posix\0A    atime=on|off\0A    canmount=on|off|noauto\0A    checksum=on|off|fletcher2|fletcher4|sha256|noparity|sha512|skein|edonr\0A    compression=on|off|gzip|gzip-N|lz4|lzjb|zle|zstd|zstd-N|zstd-fast|zstd-fast-N\0A    context=none|SELinux_User:SElinux_Role:Selinux_Type:Sensitivity_Level\0A    fscontext=none|SELinux_User:SElinux_Role:Selinux_Type:Sensitivity_Level\0A    defcontext=none|SELinux_User:SElinux_Role:Selinux_Type:Sensitivity_Level\0A    rootcontext=none|SELinux_User:SElinux_Role:Selinux_Type:Sensitivity_Level\0A    copies=1|2|3\0A    devices=on|off\0A    dedup=off|on|verify|sha256[,verify]|sha512[,verify]|skein[,verify]|edonr,verify\0A    dnodesize=legacy|auto|1k|2k|4k|8k|16k\0A    encryption=off|on|aes-128-ccm|aes-192-ccm|aes-256-ccm|aes-128-gcm|aes-192-gcm|aes-256-gcm\0A    keyformat=raw|hex|passphrase\0A    keylocation=prompt|file://</absolute/file/path>\0A    pbkdf2iters=iterations\0A    exec=on|off\0A    filesystem_limit=count|none\0A    special_small_blocks=size\0A    mountpoint=path|none|legacy\0A    nbmand=on|off\0A    overlay=on|off\0A    primarycache=all|none|metadata\0A    quota=size|none\0A    snapshot_limit=count|none\0A    recordsize=size\0A    readonly=on|off\0A    redundant_metadata=all|most\0A    refquota=size|none\0A    refreservation=size|none|auto\0A    relatime=on|off\0A    reservation=size|none\0A    secondarycache=all|none|metadata\0A    setuid=on|off\0A    sharesmb=on|off|opts\0A    sharenfs=on|off|opts\0A    logbias=latency|throughput\0A    snapdev=hidden|visible\0A    snapdir=hidden|visible\0A    sync=standard|always|disabled\0A    version=N|current\0A    volsize=size\0A    volmode=default | full | geom | dev | none\0A    vscan=on|off\0A    xattr=on|off|sa\0A    jailed=off | on\0A    casesensitivity=sensitive|insensitive|mixed\0A    normalization=none|formC|formD|formKC|formKD\0A    utf8only=on|off\0A    keyformat=raw|passphrase|hex\0A    keylocation=stdin|file:///\0A    encryption=off|on|aes-128-ccm|aes-192-ccm|aes-256-ccm|aes-128-gcm|aes-192-gcm|aes-256-gcm\0A\22\0A    # Convert the list above into an array of strings\0A    set all_options (string split \\n -- $all_options | string trim)\0A\0A    # Make sure the name doesn't already have a trailing = (depending on the context)\0A    set name (string match -r '^[^=]+' -- $name)\0A    # Extract the values \22value1|value2\22 from the long list of \22key=value1|value2\22\0A    set options (string match \22$name=*\22 -- $all_options | string split =)[2]\0A    # echo o1: (string escape -- $options)\0A    # Put each possible value on its own line and account for formatting disparities\0A    set options (string replace -a '|' \\n -- $options | string trim)\0A    # echo o2: (string escape -- $options)\0A    # Remove open-ended options (size, count, path)\0A    set options (string match -rv '^(size|count|iterations|path)$|\\<.*?\\>' -- $options)\0A    # echo o3: (string escape -- $options)\0A    # Expand optionally comma-separated arguments (e.g. skein[,verify] => skein\\nskein,verify)\0A    set options (string replace -r \22(.*)\\[,(.*?)\\]\22 '$1\\n$1,$2' -- $options)\0A    # echo o4: (string escape -- $options)\0A\0A    if set -q options[1]\0A        printf \22$name=%s\\n\22 $options\0A    end\0Aend\0A\0A# Generate a list of possible values from the man page.\0A# NB: This includes \22hints\22 like \22size\22 or \22opts\22 which may be useful or unwanted. *shrug*\0Aif type -q man && type -q col\0A    function __fish_zfs_property_options\0A        set -l property (string escape --style=regex -- $argv[1])\0A        set -l values (command man zfs | col -b | string replace -rf -- '^\\s*'$property'=(.*\\|.*)' '$1' | string split ' | ')\0A        printf '%s\\n' $property=$values\0A    end\0Aelse\0A    function __fish_zfs_property_options\0A    end\0Aend\0A\0Afunction __fish_zfs_list_permissions -V OS\0A    echo -e \22allow\\tAlso needs the permission to be allowed\22\0A    echo -e \22clone\\tAlso needs the 'create' and 'mount' permissions in the origin filesystem\22\0A    echo -e \22create\\tAlso needs the 'mount' permission\22\0A    echo -e \22destroy\\tAlso needs the 'mount' permission\22\0A    echo -e mount\0A    echo -e \22promote\\tAlso needs the 'promote' and 'mount' permissions in the origin filesystem\22\0A    echo -e \22receive\\tAlso needs the 'create' and 'mount' permissions\22\0A    echo -e \22rename\\tAlso needs the 'create' and 'mount' permissions in the new parent\22\0A    echo -e \22rollback\\tAlso needs the 'mount' permission\22\0A    echo -e send\0A    echo -e \22share\\tFor SMB and NFS shares\22\0A    echo -e \22snapshot\\tAlso needs the 'mount' permission\22\0A    echo -e groupquota\0A    echo -e groupused\0A    echo -e \22userprop\\tAllows changing any user property\22\0A    echo -e userquota\0A    echo -e userused\0A    # The remaining code of the function is almost a duplicate of __fish_complete_zfs_rw_properties and __fish_complete_zfs_ro_properties, but almost only, hence the duplication\0A    # RO properties\0A    echo -e \22volblocksize\\tVolume block size\22\0A    # R/W properties\0A    echo -e \22aclinherit\\tInheritance of ACL entries (discard, noallow, restricted, passthrough, passthrough-x)\22\0A    echo -e \22atime\\tUpdate access time on read (on, off)\22\0A    echo -e \22canmount\\tIs the dataset mountable (on, off, noauto)\22\0A    set -l additional_cksum_algs ''\0A    set -l additional_dedup_algs ''\0A    if contains -- $OS FreeBSD SunOS\0A        set additional_cksum_algs \22, noparity\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@sha512\22\0A        set additional_cksum_algs \22$additional_cksum_algs, sha512\22\0A        set additional_dedup_algs \22, sha512[,verify]\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@skein\22\0A        set additional_cksum_algs \22$additional_cksum_algs, skein\22\0A        set additional_dedup_algs \22$additional_dedup_algs, skein[,verify]\22\0A    end\0A    if __fish_is_zfs_feature_enabled \22feature@edonr\22\0A        set additional_cksum_algs \22$additional_cksum_algs, edonr\22\0A        set additional_dedup_algs \22$additional_dedup_algs, edonr[,verify]\22\0A    end\0A    echo -e \22checksum\\tData checksum (on, off, fletcher2, fletcher4, sha256$additional_cksum_algs)\22\0A    set -e additional_cksum_algs\0A    set -l additional_compress_algs ''\0A    if __fish_is_zfs_feature_enabled \22feature@lz4_compress\22\0A        set additional_compress_algs \22, lz4\22\0A    end\0A    echo -e \22compression\\tCompression algorithm (on, off, lzjb$additional_compress_algs, gzip, gzip-[1-9], zle)\22\0A    set -e additional_compress_algs\0A    echo -e \22copies\\tNumber of copies of data (1, 2, 3)\22\0A    echo -e \22dedup\\tDeduplication (on, off, verify, sha256[,verify]$additional_dedup_algs)\22\0A    set -e additional_dedup_algs\0A    echo -e \22devices\\tAre contained device nodes openable (on, off)\22\0A    echo -e \22exec\\tCan contained executables be executed (on, off)\22\0A    echo -e \22filesystem_limit\\tMax number of filesystems and volumes (COUNT, none)\22\0A    echo -e \22mountpoint\\tMountpoint (PATH, none, legacy)\22\0A    echo -e \22primarycache\\tWhich data to cache in ARC (all, none, metadata)\22\0A    echo -e \22quota\\tMax size of dataset and children (SIZE, none)\22\0A    echo -e \22snapshot_limit\\tMax number of snapshots (COUNT, none)\22\0A    echo -e \22readonly\\tRead-only (on, off)\22\0A    echo -e \22recordsize\\tSuggest block size (SIZE)\22\0A    echo -e \22redundant_metadata\\tHow redundant are the metadata (all, most)\22\0A    echo -e \22refquota\\tMax space used by dataset itself (SIZE, none)\22\0A    echo -e \22refreservation\\tMin space guaranteed to dataset itself (SIZE, none)\22\0A    echo -e \22reservation\\tMin space guaranteed to dataset (SIZE, none)\22\0A    echo -e \22secondarycache\\tWhich data to cache in L2ARC (all, none, metadata)\22\0A    echo -e \22setuid\\tRespect set-UID bit (on, off)\22\0A    echo -e \22sharenfs\\tShare in NFS (on, off, OPTS)\22\0A    echo -e \22logbias\\tHint for handling of synchronous requests (latency, throughput)\22\0A    echo -e \22snapdir\\tHide .zfs directory (hidden, visible)\22\0A    echo -e \22sync\\tHandle of synchronous requests (standard, always, disabled)\22\0A    echo -e \22volsize\\tVolume logical size (SIZE)\22\0A    if test $OS = SunOS\0A        echo -e \22zoned\\tManaged from a non-global zone (on, off)\22\0A        echo -e \22mlslabel\\tCan the dataset be mounted in a zone with Trusted Extensions enabled (LABEL, none)\22\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22sharesmb\\tShare in Samba (on, off)\22\0A        echo -e \22shareiscsi\\tShare as an iSCSI target (on, off)\22\0A        echo -e \22version\\tOn-disk version of filesystem (1, 2, current)\22\0A        echo -e \22vscan\\tScan regular files for viruses on opening and closing (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A    else if test $OS = Linux\0A        echo -e \22acltype\\tUse no ACL or POSIX ACL (noacl, posixacl)\22\0A        echo -e \22nbmand\\tMount with Non Blocking mandatory locks (on, off)\22\0A        echo -e \22relatime\\tSometimes update access time on read (on, off)\22\0A        echo -e \22shareiscsi\\tShare as an iSCSI target (on, off)\22\0A        echo -e \22sharesmb\\tShare in Samba (on, off)\22\0A        echo -e \22snapdev\\tHide volume snapshots (hidden, visible)\22\0A        echo -e \22version\\tOn-disk version of filesystem (1, 2, current)\22\0A        echo -e \22vscan\\tScan regular files for viruses on opening and closing (on, off)\22\0A        echo -e \22xattr\\tExtended attributes (on, off, sa)\22\0A    else if test $OS = FreeBSD\0A        echo -e \22aclmode\\tHow is ACL modified by chmod (discard, groupmask, passthrough, restricted)\22\0A        echo -e \22volmode\\tHow to expose volumes to OS (default, geom, dev, none)\22\0A    end\0A    # Write-once properties\0A    echo -e \22normalization\\tUnicode normalization (none, formC, formD, formKC, formKD)\22\0A    echo -e \22utf8only\\tReject non-UTF-8-compliant filenames (on, off)\22\0A    if test $OS = Linux\0A        echo -e \22casesensitivity\\tCase sensitivity (sensitive, insensitive)\22\0A    else # FreeBSD, SunOS and virtually all others\0A        echo -e \22casesensitivity\\tCase sensitivity (sensitive, insensitive, mixed)\22\0A    end\0A    # Permissions set; if none are found, or if permission sets are not supported, no output is expected, even an error\0A    for i in (zpool list -o name -H)\0A        zfs allow $i\0A    end | string match -r '@[[:alnum:]]*' | sort -u\0Aend\0A\0Afunction __fish_print_zfs_bookmarks -d \22Lists ZFS bookmarks, if the feature is enabled\22\0A    if __fish_is_zfs_feature_enabled 'feature@bookmarks'\0A        zfs list -t bookmark -o name -H\0A    end\0Aend\0A\0Afunction __fish_print_zfs_filesystems -d \22Lists ZFS filesystems\22\0A    zfs list -t filesystem -o name -H\0Aend\0A\0Afunction __fish_print_zfs_volumes -d \22Lists ZFS volumes\22\0A    zfs list -t volume -o name -H\0Aend\0A\0Acomplete -c zfs -f -n __fish_zfs_needs_command -s '?' -a '?' -d 'Display a help message'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a create -d 'Create a volume or filesystem'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a destroy -d 'Destroy a dataset'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a 'snapshot snap' -d 'Create a snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a rollback -d 'Roll back a filesystem to a previous snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a clone -d 'Create a clone of a snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a promote -d 'Promotes a clone file system to no longer be dependent on its \22origin\22 snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a rename -d 'Rename a dataset'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a list -d 'List dataset properties'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a set -d 'Set a dataset property'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a get -d 'Get one or several dataset properties'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a inherit -d 'Set a dataset property to be inherited'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a upgrade -d 'List upgradeable datasets, or upgrade one'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a userspace -d 'Get dataset space consumed by each user'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a groupspace -d 'Get dataset space consumed by each user group'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a mount -d 'Mount a filesystem'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a 'unmount umount' -d 'Unmount a filesystem'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a share -d 'Share a given filesystem, or all of them'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a unshare -d 'Stop sharing a given filesystem, or all of them'\0Aif __fish_is_zfs_feature_enabled 'feature@bookmarks'\0A    complete -c zfs -f -n __fish_zfs_needs_command -a bookmark -d 'Create a bookmark for a snapshot'\0Aend\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a send -d 'Output a stream representation of a dataset'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a 'receive recv' -d 'Write on disk a dataset from the stream representation given on standard input'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a allow -d 'Delegate, or display delegations of, rights on a dataset to (groups of) users'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a unallow -d 'Revoke delegations of rights on a dataset from (groups of) users'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a hold -d 'Put a named hold on a snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a holds -d 'List holds on a snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a release -d 'Remove a named hold from a snapshot'\0Acomplete -c zfs -f -n __fish_zfs_needs_command -a diff -d 'List changed files between a snapshot, and a filesystem or a previous snapshot'\0Aif test $OS = SunOS # This is currently only supported under Illumos, but that will probably change\0A    complete -c zfs -f -n __fish_zfs_needs_command -a program -d 'Execute a ZFS Channel Program'\0Aend\0Aif __fish_is_openzfs\0A    complete -c zfs -f -n __fish_zfs_needs_command -a load-key -d \22Load encryption key for dataset\22\0A    complete -c zfs -f -n __fish_zfs_needs_command -a unload-key -d \22Unload encryption key for dataset\22\0A    complete -c zfs -f -n __fish_zfs_needs_command -a change-key -d \22Change wrapper encryption key for dataset\22\0Aend\0A\0A# Completions hereafter try to follow the man pages commands order, for maintainability, at the cost\0A# of multiple if statements.\0A\0A# create completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command create' -s p -d 'Create all needed non-existing parent datasets'\0Aif test $OS = Linux # Only Linux supports the comma-separated format; others need multiple -o calls\0A    complete -c zfs -x -n '__fish_zfs_using_command create' -s o -d 'Dataset property' -a '(__fish_append , (__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties))'\0Aend\0Acomplete -c zfs -x -n '__fish_zfs_using_command create' -s o -d 'Dataset property' -a '(__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_zfs_complete_property_values (commandline -t))'\0A# create completions for volumes; as -V is necessary to zfs to recognize a volume creation request,\0A# we use it as a condition to propose volume creation completions.\0A# If -V is typed after -s or -b, zfs should accept it, but fish won't propose -s or -b, but, as\0A# these options are for volumes only, it seems reasonable to expect the user to ask for a volume,\0A# with -V, before giving its characteristics with -s or -b\0Acomplete -c zfs -x -n '__fish_zfs_using_command create' -s V -d 'Volume size'\0Acomplete -c zfs -f -n '__fish_zfs_using_command create; and __fish_contains_opt -s V' -s s -d 'Create a sparse volume'\0Acomplete -c zfs -x -n '__fish_zfs_using_command create; and __fish_contains_opt -s V' -s b -d Blocksize\0A# new dataset completions, applicable for both regular datasets and volumes; must start with pool\0A# and may optionally be a child of a pre-existing dataset.\0Acomplete -c zfs -x -n '__fish_zfs_using_command create' -a '(printf \22%s/\\n\22 (__fish_print_zfs_filesystems))'\0A\0A# destroy completions; as the dataset is the last item, we can't know yet if it's a snapshot, a\0A# bookmark or something else, so we can't separate snapshot-specific options from others.\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s r -d 'Recursively destroy children'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s R -d 'Recursively destroy all dependents'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s f -d 'Force unmounting'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s n -d 'Dry run'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s p -d 'Print machine-parsable verbose information'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s v -d 'Verbose mode'\0Acomplete -c zfs -f -n '__fish_zfs_using_command destroy' -s d -d 'Defer snapshot deletion'\0Acomplete -c zfs -x -n '__fish_zfs_using_command destroy' -d 'Dataset to destroy' -a '(__fish_print_zfs_filesystems; __fish_print_zfs_volumes; __fish_print_zfs_snapshots; __fish_print_zfs_bookmarks)'\0A\0A# snapshot completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command snapshot; or __fish_zfs_using_command snap' -s r -d 'Recursively snapshot children'\0Aif test $OS = Linux # Only Linux supports the comma-separated format; others need multiple -o calls\0A    complete -c zfs -x -n '__fish_zfs_using_command snapshot; or __fish_zfs_using_command snap' -s o -d 'Snapshot property' -a '(__fish_append , (__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties))'\0Aend\0Acomplete -c zfs -x -n '__fish_zfs_using_command snapshot; or __fish_zfs_using_command snap' -s o -d 'Snapshot property' -a '(__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_zfs_complete_property_values (commandline -t))'\0Acomplete -c zfs -x -n '__fish_zfs_using_command snapshot; or __fish_zfs_using_command snap' -d 'Dataset to snapshot' -a '(__fish_print_zfs_filesystems; __fish_print_zfs_volumes)'\0A\0A# rollback completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command rollback' -s r -d 'Destroy later snapshot and bookmarks'\0Acomplete -c zfs -f -n '__fish_zfs_using_command rollback' -s R -d 'Recursively destroy later snapshot, bookmarks and clones'\0Acomplete -c zfs -f -n '__fish_zfs_using_command rollback; and __fish_contains_opt -s R' -s f -d 'Force unmounting of clones'\0Acomplete -c zfs -x -n '__fish_zfs_using_command rollback' -d 'Snapshot to roll back to' -a '(__fish_print_zfs_snapshots --force)'\0A\0A# clone completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command clone' -s p -d 'Create all needed non-existing parent datasets'\0Aif test $OS = Linux # Only Linux supports the comma-separated format; others need multiple -o calls\0A    complete -c zfs -x -n '__fish_zfs_using_command clone' -s o -d 'Clone property' -a '(__fish_append , (__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties))'\0Aend\0Acomplete -c zfs -x -n '__fish_zfs_using_command clone' -s o -d 'Clone property' -a '(__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_zfs_complete_property_values (commandline -t))'\0Acomplete -c zfs -x -n '__fish_zfs_using_command clone' -d 'Snapshot to clone' -a '(__fish_print_zfs_snapshots --force)'\0A\0A# promote completions\0Acomplete -c zfs -x -n '__fish_zfs_using_command promote' -d 'Clone to promote' -a '(__fish_print_zfs_filesystems)'\0A\0A# rename completions; as the dataset is the last item, we can't know yet if it's a snapshot or not,\0A# we can't separate snapshot-specific option from others.\0Acomplete -c zfs -f -n '__fish_zfs_using_command rename' -s p -d 'Create all needed non-existing parent datasets'\0Acomplete -c zfs -f -n '__fish_zfs_using_command rename' -s r -d 'Recursively rename children snapshots'\0Aif __fish_is_openzfs\0A    complete -c zfs -f -n '__fish_zfs_using_command rename' -s f -d 'Force unmounting if needed'\0Aend\0A# These FreeBSD completions are in addition to any added via the OpenZFS check above\0Aif test $OS = FreeBSD\0A    complete -c zfs -f -n '__fish_zfs_using_command rename' -s u -d 'Do not remount filesystems during rename'\0Aend\0Acomplete -c zfs -x -n '__fish_zfs_using_command rename' -d 'Dataset to rename' -a '(__fish_print_zfs_filesystems; __fish_print_zfs_volumes; __fish_print_zfs_snapshots)'\0A\0A# list completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command list' -s H -d 'Print output in a machine-parsable format'\0Acomplete -c zfs -f -n '__fish_zfs_using_command list' -s r -d 'Operate recursively on datasets'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list; and __fish_contains_opt -s r' -s d -d 'Maximum recursion depth'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list' -s o -d 'Property to list' -a '(__fish_append , (__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_complete_zfs_ro_properties; echo -e \22name\\tDataset name\22; echo -e \22space\\tSpace properties\22))'\0Acomplete -c zfs -f -n '__fish_zfs_using_command list' -s p -d 'Print parsable (exact) values for numbers'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list; and __fish_not_contain_opt -s S' -s s -d 'Property to use for sorting output by ascending order' -a '(__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_complete_zfs_ro_properties; echo -e \22name\\tDataset name\22)'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list; and __fish_not_contain_opt -s s' -s S -d 'Property to use for sorting output by descending order' -a '(__fish_complete_zfs_rw_properties; __fish_complete_zfs_write_once_properties; __fish_complete_zfs_ro_properties; echo -e \22name\\tDataset name\22)'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list' -s t -d 'Dataset type' -a '(__fish_zfs_list_dataset_types)'\0Acomplete -c zfs -x -n '__fish_zfs_using_command list' -d 'Dataset whose properties to list' -a '(__fish_print_zfs_filesystems; __fish_print_zfs_volumes; __fish_print_zfs_snapshots)'\0A\0A# set completions (zfs set PROP VALUE POOL/DATASET)\0Acomplete -c zfs -x -n '__fish_zfs_using_command set; and __fish_is_nth_token 2' -d 'Property to set' -a '(__fish_complete_zfs_rw_properties)'\0Acomplete -c zfs -x -n '__fish_zfs_using_command set; and __fish_is_nth_token 3' -d 'Dataset whose property to set' -a '(__fish_print_zfs_filesystems; __fish_print_zfs_volumes; __fish_print_zfs_snapshots)'\0A# set property value completions\0Acomplete -c zfs -x -n '__fish_zfs_using_command set; and __fish_is_nth_token 2' -a '(__fish_zfs_complete_property_values (__fish_nth_token 2))'\0A\0A# get completions\0Acomplete -c zfs -f -n '__fish_zfs_using_command get' -s r -d 'Operate recursively on datasets'\0Acomplete -c zfs -x -n '__fish_zfs_using_command get; and __fish_contains_opt -s r' -s d -d 'Maximum recursion depth'\0Acomplete -c zfs -f -n '__fish_zfs_using_command get' -s H -d 'Print output in a machine-parsable format'\0Acomplete -c zf