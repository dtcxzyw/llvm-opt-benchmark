@anon.1d0b41a8d45d477c3029ec78f9b8b434.2660 = private unnamed_addr constant [1606 x i8] c"# Sources:\0A# stow --help \0A# https://www.gnu.org/software/stow/manual/stow.html\0A# https://git.savannah.gnu.org/cgit/stow.git/tree/NEWS\0A\0A# options\0Acomplete -c stow -s d -l dir -r -d 'Set stow dir, default $STOW_DIR or current dir'\0Acomplete -c stow -s t -l target -r -d 'Set target dir, default parent of stow dir'\0Acomplete -c stow -l ignore -x -d 'Ignore files ending in this Perl regex'\0Acomplete -c stow -l defer -x -d \22Don't stow files beginning with this Perl regex if already stowed\22\0Acomplete -c stow -l override -x -d \22Force stowing files beginning with this Perl regex if already stowed\22\0Acomplete -c stow -l no-folding -d \22Create dirs instead of symlinks to whole dirs\22\0Acomplete -c stow -l adopt -d \22Move existing files into stow dir if target exists (AND OVERWRITE!)\22\0Acomplete -c stow -s n -l no -l simulate -d \22Don't modify the file system\22\0Acomplete -c stow -s v -l verbose -d \22Increase verbosity by 1 (levels are from 0 to 5)\22\0Acomplete -c stow -l verbose -a \220 1 2 3 4 5\22 -d \22Increase verbosity by 1 or set it with verbose=N [0..5]\22\0Acomplete -c stow -s p -l compat -d \22Use legacy algorithm for unstowing\22\0Acomplete -c stow -s V -l version -d \22Show stow version number\22\0Acomplete -c stow -s h -l help -d \22Show help\22\0Acomplete -c stow -l dotfiles -d \22Stow dot-file_or_dir_name as .file_or_dir_name\22 # not yet in the manual (February 2023)\0A\0A# action flags\0Acomplete -c stow -s D -l delete -r -d \22Unstow the package names that follow this option\22\0Acomplete -c stow -s S -l stow -r -d \22Stow the package names that follow this option\22\0Acomplete -c stow -s R -l restow -r -d \22Restow: delete and then stow again\22\0A", align 1
