@anon.1d0b41a8d45d477c3029ec78f9b8b434.1262 = private unnamed_addr constant [6526 x i8] c"# Fish completions for systemd's \22busctl\22 dbus tool\0A# TODO:\0A# One issue is that sometimes these will come to a dead-end e.g. when a particular interface has no properties\0A# Another is that some busnames aren't accessible by the current user\0A# but this can't be predicted via the user that owns that name, e.g. `org.freedesktop.login1`\0A# is usually owned by a root-owned process, yet accessible (at least in part) by normal users\0A\0A# A simple wrapper to call busctl with the correct mode and output\0Afunction __fish_busctl\0A    # TODO: If there's a \22--address\22 argument we need to pass that\0A    # We also need to pass the _last_ of these (`busctl --user --system` operates on the system bus)\0A    set -l mode\0A    if __fish_contains_opt user\0A        set mode --user\0A    else\0A        set mode --system\0A    end\0A    command busctl $mode $argv --no-legend --no-pager 2>/dev/null\0Aend\0A\0Afunction _fish_busctl\0A    set -l args a-address= s-show-machine u-unique A-acquired \C3\A4-activatable \\\0A        m-match= S-size= l-list q-quiet v-verbose e-expect-reply= \C3\84-auto-start= \\\0A        1-allow-interactive-authorization= t-timeout= 2-augment-creds= U-user 3-system \\\0A        H/host= M/machine= n-no-pager N-no-legend h/help V-version\0A    set -l cmdline (commandline -xpc) (commandline -ct)\0A    set -e cmdline[1]\0A    argparse $args -- $cmdline 2>/dev/null\0A    or return\0A    set -l cmd $argv[1]\0A    set -e argv[1]\0A    switch \22$cmd\22\0A        case list help\0A            # Accepts nothing\0A            return\0A        case status\0A            # A service\0A            if not set -q argv[2]\0A                __fish_busctl_busnames\0A            end\0A        case monitor capture tree\0A            # Services\0A            __fish_busctl_busnames\0A        case introspect\0A            # Service Object Interface\0A            if not set -q argv[2]\0A                __fish_busctl_busnames\0A            else if not set -q argv[3]\0A                __fish_busctl_objects $argv[1]\0A            else if not set -q argv[4]\0A                __fish_busctl_interfaces $argv[1..2]\0A            end\0A        case call\0A            # SERVICE OBJECT INTERFACE METHOD [SIGNATURE [ARGUMENT...]]\0A            if not set -q argv[2]\0A                __fish_busctl_busnames\0A            else if not set -q argv[3]\0A                __fish_busctl_objects $argv[1]\0A            else if not set -q argv[4]\0A                __fish_busctl_interfaces $argv[1..2]\0A            else if not set -q argv[5]\0A                __fish_busctl_members method $argv[1..3]\0A            else if not set -q argv[6]\0A                __fish_busctl_signature $argv[1..4]\0A            end\0A        case get-property\0A            # SERVICE OBJECT INTERFACE PROPERTY...\0A            if not set -q argv[2]\0A                __fish_busctl_busnames\0A            else if not set -q argv[3]\0A                __fish_busctl_objects $argv[1]\0A            else if not set -q argv[4]\0A                __fish_busctl_interfaces $argv[1..2]\0A            else\0A                __fish_busctl_members property $argv[1..3]\0A            end\0A        case set-property\0A            # SERVICE OBJECT INTERFACE PROPERTY SIGNATURE ARGUMENT...\0A            if not set -q argv[2]\0A                __fish_busctl_busnames\0A            else if not set -q argv[3]\0A                __fish_busctl_objects $argv[1]\0A            else if not set -q argv[4]\0A                __fish_busctl_interfaces $argv[1..2]\0A            else if not set -q argv[5]\0A                __fish_busctl_members property $argv[1..3]\0A            else if not set -q argv[6]\0A                __fish_busctl_members signature $argv[1..4]\0A            end\0A    end\0Aend\0A\0Afunction __fish_busctl_busnames\0A    __fish_busctl list --acquired | string replace -r '\\s+.*$' ''\0A    # Describe unique names (\22:1.32\22) with their process (e.g. `:1.32\\tsteam`)\0A    __fish_busctl list --unique | string replace -r '\\s+\\S+\\s+(\\S+)\\s+.*$' '\\t$1'\0Aend\0A\0Afunction __fish_busctl_objects -a busname\0A    __fish_busctl tree --list $busname | string replace -r '\\s+.*$' ''\0Aend\0A\0Afunction __fish_busctl_interfaces -a busname -a object\0A    __fish_busctl introspect --list $busname $object | string replace -r '\\s+.*$' ''\0Aend\0A\0Afunction __fish_busctl_members -a type -a busname -a object -a interface\0A    __fish_busctl introspect --list $busname $object $interface \\\0A        | string match -- \22* $type *\22 | string replace -r '.(\\S+) .*' '$1'\0Aend\0A\0Afunction __fish_busctl_signature -a busname -a object -a interface -a member\0A    __fish_busctl introspect --list $busname $object $interface \\\0A        | string match \22.$member *\22 | while read -l a b c d\0A        echo $c\0A    end\0Aend\0A\0A### Commands\0Aset -l commands list status monitor capture tree introspect call get-property set-property help\0A\0Acomplete -f -c busctl\0Acomplete -f -c busctl -n \22not __fish_seen_subcommand_from $commands\22 -a \22$commands\22\0A\0A### Arguments to commands\0Acomplete -f -c busctl -a '(_fish_busctl)'\0A\0A# Flags\0A# These are incomplete as I have no idea how to complete --address= or --match=\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from call\22 -l quiet -d 'Suppress message payload display'\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from call get-property\22 -l verbose\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from tree\22 -l list -d 'Show a flat list instead of a tree'\0Acomplete -x -c busctl -n \22__fish_seen_subcommand_from call\22 -l expect-reply -a \22yes no\22\0Acomplete -x -c busctl -n \22__fish_seen_subcommand_from call\22 -l auto-start -a \22yes no\22 -d 'Activate the peer if necessary'\0Acomplete -x -c busctl -n \22__fish_seen_subcommand_from call\22 -l allow-interactive-authorization -a \22yes no\22\0Acomplete -x -c busctl -n \22__fish_seen_subcommand_from call\22 -l timeout -a \22(seq 0 100)\22\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from list\22 -l unique -d 'Only show unique (:X.Y) names'\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from list\22 -l acquired -d 'Only show well-known names'\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from list\22 -l activatable -d 'Only show peers that have not been activated yet but can be'\0Acomplete -f -c busctl -n \22__fish_seen_subcommand_from list\22 -l show-machine -d 'Show the machine the peers belong to'\0Acomplete -x -c busctl -n \22__fish_seen_subcommand_from list status\22 -l augment-creds -a \22yes no\22\0Acomplete -f -c busctl -l user\0Acomplete -f -c busctl -l system\0Acomplete -f -c busctl -s H -l host -a \22(__fish_print_hostnames)\22\0Acomplete -f -c busctl -s M -l machine -a \22(__fish_systemd_machines)\22\0Acomplete -f -c busctl -l no-pager\0Acomplete -f -c busctl -l no-legend\0Acomplete -f -c busctl -s h -l help\0Acomplete -f -c busctl -l version\0A", align 1
