@anon.1d0b41a8d45d477c3029ec78f9b8b434.2894 = private unnamed_addr constant [14008 x i8] c"function __fish_wine_explorer__complete_desktop_arg\0A    set -l current_token (commandline -tc)\0A\0A    switch \22$current_token\22\0A        case '/desktop=*x*'\0A            return\0A        case '/desktop=*'\0A            printf '%sx' \22$current_token\22\0A    end\0Aend\0A\0Afunction __fish_msiexec__option_completion_condition\0A    set -l token (commandline -oc)[3]\0A\0A    not string match --quiet --regex '^/(uninstall|[ipyz])$|^/[fjql]' -- \22$token\22\0Aend\0A\0Afunction __fish_msiexec_complete_option_arg\0A    set -l current_token (commandline -tc)\0A\0A    switch \22$current_token\22\0A        case '/f*'\0A            set values 'p\\tReinstall the file if it is missing' \\\0A                'o\\tReinstall the file if it is missing or if any older version is installed' \\\0A                'e\\tReinstall the file if it is missing, or if the installed version is equal or older' \\\0A                'd\\tReinstall the file if it is missing or a different version is installed' \\\0A                'c\\tReinstall the file if it is missing or the checksum does not match' \\\0A                'a\\tReinstall all files' \\\0A                'u\\tRewrite all required user registry entries' \\\0A                'm\\tRewrite all required machine registry entries' \\\0A                's\\tOverwrite any conflicting shortcuts' \\\0A                'v\\tRecache the local installation package from the source installation package'\0A\0A        case '/q*'\0A            set values 'n\\tDisable UI' \\\0A                'b\\tShow the basic UI' \\\0A                'r\\tShow the reduced UI' \\\0A                'f\\tShow the full UI'\0A\0A        case '/l*'\0A            set values '*\\tEnable all options except v and x' \\\0A                'i\\tEnable status messages' \\\0A                'w\\tEnable warning messages' \\\0A                'e\\tEnable error messages' \\\0A                'a\\tEnable messages for action startups' \\\0A                'r\\tEnable messages for action records' \\\0A                'u\\tEnable messages for user requests' \\\0A                'c\\tEnable messages for initial UI parameters' \\\0A                'm\\tEnable messages for out of memory errors' \\\0A                'o\\tEnable messages for out of disk space errors' \\\0A                'p\\tEnable messages for terminal properties' \\\0A                'v\\tEnable verbose messages' \\\0A                'x\\tEnable messages for debugging' \\\0A                '+\\tAppend messages to a file' \\\0A                '!\\tFlush each line of messages'\0A    end\0A\0A    for value in $values\0A        echo -e \22$current_token$value\22\0A    end\0Aend\0A\0Afunction __fish_wine__complete_cmd_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from cmd'\0A    complete -c $command -a '(__fish_cmd__complete_args)' -n $condition\0A\0A    set -l c_and_k_condition 'not __fish_seen_argument -w c -w k'\0A\0A    complete -c $command -a /c \\\0A        -d 'Run the command and stop' \\\0A        -n \22$condition && $c_and_k_condition\22\0A\0A    complete -c $command -a /k \\\0A        -d 'Run the command and continue' \\\0A        -n \22$condition && $c_and_k_condition\22\0A\0A    complete -c $command -a /s \\\0A        -d 'Modify the treatment of string after /c or /k' \\\0A        -n $condition\0A\0A    complete -c $command -a /q -d 'Turn echo off' -n $condition\0A\0A    complete -c $command -a /d \\\0A        -d 'Disable execution of AutoRun commands' \\\0A        -n $condition\0A\0A    set -l a_and_u_condition 'not __fish_seen_argument -w a -w u'\0A\0A    complete -c $command -a /a \\\0A        -d 'Format internal command output as ANSI' \\\0A        -n \22$condition && $a_and_u_condition\22\0A\0A    complete -c $command -a /u \\\0A        -d 'Format internal command output as Unicode' \\\0A        -n \22$condition && $a_and_u_condition\22\0A\0A    complete -c $command -a /t \\\0A        -d 'Set the background and foreground color' \\\0A        -n $condition\0A\0A    complete -c $command -a /e -d 'Manage command extensions' -n $condition\0A\0A    complete -c $command -a /f \\\0A        -d 'Manage file and directory name completion' \\\0A        -n $condition\0A\0A    complete -c $command -a /v \\\0A        -d 'Manage delayed environment variable expansion' \\\0A        -n $condition\0A\0A    complete -c $command -a '/?' -d 'Show help' -n $condition\0Aend\0A\0Afunction __fish_wine__complete_control_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from control'\0A\0A    complete -c $command \\\0A        -a 'COLOR DATE/TIME DESKTOP INTERNATIONAL KEYBOARD MOUSE PORTS PRINTERS' \\\0A        -n $condition\0Aend\0A\0Afunction __fish_wine__complete_eject_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from eject'\0A    complete -c $command -s h -d 'Show help' -n $condition\0A    complete -c $command -s a -d 'Eject all the CD drives' -n $condition\0A    complete -c $command -s u -d 'Unmount the CD drives' -n $condition\0Aend\0A\0Afunction __fish_wine__complete_explorer_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from explorer'\0A\0A    complete -c $command -a '(__fish_wine_explorer__complete_desktop_arg)' \\\0A        -n $condition\0A\0A    complete -c $command -a /n -d 'Use the single pain view' -n $condition\0A    complete -c $command -a /e, -d 'Use the default view' -n $condition\0A\0A    complete -c $command -a /root, -d 'Specify the root level of a view' \\\0A        -n $condition\0A\0A    complete -c $command -a /select, -d 'Specify the selection in a view' \\\0A        -n $condition\0A\0A    complete -c $command -a /desktop= -d 'Specify the desktop name' \\\0A        -n $condition\0Aend\0A\0Afunction __fish_wine__complete_msiexec_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from msiexec'\0A    complete -c $command -a '/? /h' -d 'Show help' -n $condition\0A\0A    complete -c $command -a '(__fish_msiexec_complete_option_arg)' \\\0A        -n $condition\0A\0A    complete -c $command -a /i \\\0A        -d 'Install the software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    set -l a_condition '__fish_seen_argument -w i -w p'\0A\0A    complete -c $command -a /a \\\0A        -d 'Use the administrator network' \\\0A        -n \22$condition && $a_condition\22\0A\0A    complete -c $command -a /f \\\0A        -d 'Repair the installation of software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /uninstall \\\0A        -d 'Uninstall the software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /j \\\0A        -d 'Advertise the software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /p \\\0A        -d 'Apply the patch to software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /q \\\0A        -d 'Change the UI while installing software' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /l \\\0A        -d 'Change the logging' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /y \\\0A        -d 'Register the MSI service' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0A\0A    complete -c $command -a /z \\\0A        -d 'Register the MSI service' \\\0A        -n \22$condition && __fish_msiexec__option_completion_condition\22\0Aend\0A\0Afunction __fish_wine__complete_regedit_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from regedit'\0A    complete -c $command -a '/?' -d 'Show help' -n $condition\0A\0A    complete -c $command -a /L \\\0A        -d 'Specify the location of system.dat file' \\\0A        -n $condition\0A\0A    complete -c $command -a /R \\\0A        -d 'Specify the location of user.dat file' \\\0A        -n $condition\0A\0A    complete -c $command -a /C \\\0A        -d 'Import contents of a registry file' \\\0A        -n $condition\0A\0A    complete -c $command -a /D \\\0A        -d 'Delete a registry key' \\\0A        -n $condition\0A\0A    complete -c $command -a /E \\\0A        -d 'Export contents to a registry file' \\\0A        -n $condition\0A\0A    complete -c $command -a /S \\\0A        -d 'Do not display messages' \\\0A        -n $condition\0A\0A    complete -c $command -a /V \\\0A        -d 'Launch the GUI in an advanced mode' \\\0A        -n $condition\0A\0A    complete -c $command -a '(__fish_reg__complete_keys)' \\\0A        -n $condition\0Aend\0A\0Afunction __fish_wine__complete_start_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from start'\0A    complete -c $command -a '/?' -d 'Show help' -n $condition\0A\0A    complete -c $command -a /d \\\0A        -d 'Specify the directory for a program' \\\0A        -n $condition\0A\0A    complete -c $command -a /b \\\0A        -d \22Don't create the new console for a progra\22 \\\0A        -n $condition\0A\0A    complete -c $command -a /i \\\0A        -d 'Clear the environment for a program' \\\0A        -n $condition\0A\0A    complete -c $command -a /min \\\0A        -d 'Start a program in the minimized window' \\\0A        -n $condition\0A\0A    complete -c $command -a /max \\\0A        -d 'Start a program in the minimized window' \\\0A        -n $condition\0A\0A    complete -c $command -a /low \\\0A        -d 'Start a program in the idle priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /normal \\\0A        -d 'Start a program in the normal priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /high \\\0A        -d 'Start a program in the high priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /realtime \\\0A        -d 'Start a program in the realtime priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /abovenormal \\\0A        -d 'Start a program in the abovenormal priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /belownormal \\\0A        -d 'Start a program in the belownormal priority class' \\\0A        -n $condition\0A\0A    complete -c $command -a /node \\\0A        -d 'Specify the NUMA node for a program' \\\0A        -n $condition\0A\0A    complete -c $command -a /affinity \\\0A        -d 'Specify the affinity mask for a program' \\\0A        -n $condition\0A\0A    complete -c $command -a /wait \\\0A        -d 'Wait for a program to exit' \\\0A        -n $condition\0A\0A    complete -c $command -a /unix \\\0A        -d 'Use the Unix filename for a program' \\\0A        -n $condition\0Aend\0A\0Afunction __fish_wine__complete_winemenubuilder_subcommand --argument-names command\0A    complete -c $command -a /w \\\0A        -d 'Wait till the shortcut can be created' \\\0A        -n '__fish_seen_subcommand_from winemenubuilder'\0Aend\0A\0Afunction __fish_wine__complete_winepath_subcommand --argument-names command\0A    set -l condition '__fish_seen_subcommand_from winepath'\0A    complete -c $command -s h -d 'Show help' -n $condition\0A    complete -c $command -s v -d 'Show version' -n $condition\0A\0A    complete -c $command -s u -l unix \\\0A        -d 'Convert a Windows path to the Unix one' \\\0A        -n $condition\0A\0A    complete -c $command -s w -l windows \\\0A        -d 'Convert a Unix path to the Windows one' \\\0A        -n $condition\0A\0A    complete -c $command -s l -l long \\\0A        -d 'Convert a Windows path to the long format' \\\0A        -n $condition\0A\0A    complete -c $command -s s -l short \\\0A        -d 'Convert a Windows path to the short format' \\\0A        -n $condition\0Aend\0A\0Aset -l command wine\0A\0Acomplete -c $command -l help -d 'Show help'\0Acomplete -c $command -l version -d 'Show version'\0A\0Aset -l subcommands_with_descriptions 'cacls\\t\22Edit ACLs\22' \\\0A    'clock\\t\22Open the clock\22' \\\0A    'cmd\\t\22Open the command prompt\22' \\\0A    'cmdlgtst\\t\22commdlg.dll test jig\22' \\\0A    'control\\t\22Open control panel\22' \\\0A    'eject\\t\22Eject optical discs\22' \\\0A    'expand\\t\22Expand cabinet files\22' \\\0A    'explorer\\t\22Open Explorer\22' \\\0A    'hh\\t\22Open HTML help\22' \\\0A    'icinfo\\t\22List installed video compressors\22' \\\0A    'iexplore\\t\22Open Internet Explorer\22' \\\0A    'lodctr\\t\22Load performance monitor counters\22' \\\0A    'msiexec\\t\22Open an installer for .msi files\22' \\\0A    'net\\t\22Manage services\22' \\\0A    'notepad\\t\22Notepad, a simple text editor\22' \\\0A    'oleview\\t\22Browse and explore COM objects as well as configure DCOM\22' \\\0A    'progman\\t\22Open Program manager\22' \\\0A    'reg\\t\22Edit registry though command line\22' \\\0A    'regedit\\t\22Edit registry\22' \\\0A    'regsvr32\\t\22Register OLE components in the registry\22' \\\0A    'rpcss\\t\22Open rpcss.exe\22' \\\0A    'rundll32\\t\22Load a DLL and run an entry point\22' \\\0A    'secedit\\t\22Edit security configuration\22' \\\0A    'services\\t\22Manages services\22' \\\0A    'spoolsv\\t\22Print documents\22' \\\0A    'start\\t\22Start a program or open a file in the program\22' \\\0A    'svchost\\t\22Host process for services\22' \\\0A    'taskmgr\\t\22Open Task Manager\22' \\\0A    'uninstaller\\t\22Uninstall a program\22' \\\0A    'unlodctr\\t\22Unload performance monitor counters\22' \\\0A    'view\\t\22View metafiles\22' \\\0A    'wineboot\\t\22Reboot Wine\22' \\\0A    'winebrowser\\t\22Launch native OS browser or mail client\22' \\\0A    'winecfg\\t\22Configure wine through a GUI\22' \\\0A    'wineconsole\\t\22Open Windows console\22' \\\0A    'winedbg\\t\22Open debugger core\22' \\\0A    'winedevice\\t\22Manages devices\22' \\\0A    'winefile\\t\22Open file explorer\22' \\\0A    'winemenubuilder\\t\22Build Unix menu entries\22' \\\0A    'winemine\\t\22classic minesweeper game\22' \\\0A    'winepath\\t\22Translate between Windows and Unix paths formats\22' \\\0A    'winetest\\t\22Run DLL conformance test programs\22' \\\0A    'winevdm\\t\22Open DOS\22' \\\0A    'winhelp\\t\22Open help\22' \\\0A    'winhlp32\\t\22HOpen help\22' \\\0A    'winver\\t\22Show about information\22' \\\0A    'wordpad\\t\22Open WordPad\22' \\\0A    'write\\t\22Open WordPad\22' \\\0A    'xcopy\\t\22Run xcopy\22'\0A\0Aset -l subcommands (string replace --regex '\\\\\\t.+' '' -- $subcommands_with_descriptions)\0Aset -l root_condition \22not __fish_seen_subcommand_from $subcommands\22\0Acomplete -c $command -a \22$subcommands_with_descriptions\22 -n $root_condition\0A\0A__fish_wine__complete_cmd_subcommand $command\0A__fish_wine__complete_control_subcommand $command\0A__fish_wine__complete_eject_subcommand $command\0A__fish_wine__complete_explorer_subcommand $command\0A__fish_wine__complete_msiexec_subcommand $command\0A__fish_wine__complete_regedit_subcommand $command\0A__fish_wine__complete_start_subcommand $command\0A__fish_wine__complete_winemenubuilder_subcommand $command\0A__fish_wine__complete_winepath_subcommand $command\0A", align 1
