@anon.1d0b41a8d45d477c3029ec78f9b8b434.2612 = private unnamed_addr constant [3806 x i8] c"# apple shortcuts.app CLI tool completion sucker downer by Aaron Gyes\0A# https://en.wikipedia.org/wiki/Shortcuts_(app)\0A\0A# Apple added fish completion output to Swift's ArgumentParser.\0A# imagine my surprise when I found fish function strings in binaries in /usr/bin!\0A\0A# checking the path is as expected is about as far as we're going with validation\0Aif test \22$(command -s shortcuts)\22 = /usr/bin/shortcuts\0A    command shortcuts --generate-completion-script=fish | source\0Aend\0A\0A# output is like: \0A\0A# function __fish_shortcuts_using_command\0A#     set cmd (commandline -xpc)\0A#     if test  (count $cmd) -eq (count $argv) \0A#         for i in (seq (count $argv))\0A#             if test  $cmd[$i] != $argv[$i] \0A#                 return 1\0A#             end\0A#         end\0A#         return 0\0A#     end\0A#     return 1\0A# end\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts' -f -a 'run' -d 'Run a shortcut.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts' -f -a 'list' -d 'List your shortcuts.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts' -f -a 'view' -d 'View a shortcut in Shortcuts.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts' -f -a 'sign' -d 'Sign a shortcut file.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts' -f -a 'help' -d 'Show subcommand help information.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run' -f -r -s i -l input-path -d 'The input to provide to the shortcut.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run -i' -f -a '(for i in *.{}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run --input-path' -f -a '(for i in *.{}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run' -f -r -s o -l output-path -d 'Where to write the shortcut output, if applicable.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run -o' -f -a '(for i in *.{}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run --output-path' -f -a '(for i in *.{}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts run' -f -r -l output-type -d 'What type to output data in, in Universal Type Identifier format.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts list' -f -r -s f -l folder-name -d 'The folder to list.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts list -f' -f -a '(command shortcuts ---completion list -- --custom (commandline -xpc)[1..-1])'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts list --folder-name' -f -a '(command shortcuts ---completion list -- --custom (commandline -xpc)[1..-1])'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts list' -f -l folders -d 'List folders instead of shortcuts.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign' -f -r -s m -l mode -d 'The signing mode.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign' -f -r -s i -l input -d 'The shortcut file to sign.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign -i' -f -a '(for i in *.{shortcut}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign --input' -f -a '(for i in *.{shortcut}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign' -f -r -s o -l output -d 'Output path for the signed shortcut file.'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign -o' -f -a '(for i in *.{shortcut,wflow}; echo $i;end)'\0A# complete -c shortcuts -n '__fish_shortcuts_using_command shortcuts sign --output' -f -a '(for i in *.{shortcut,wflow}; echo $i;end)'\0A", align 1
