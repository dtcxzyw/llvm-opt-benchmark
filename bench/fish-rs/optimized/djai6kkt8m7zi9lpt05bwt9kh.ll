@anon.1d0b41a8d45d477c3029ec78f9b8b434.3118 = private unnamed_addr constant [778 x i8] c"function __fish_complete_freedesktop_icons -d 'List installed icon names according to `https://specifications.freedesktop.org/icon-theme-spec/0.13/`'\0A    # The latest `icon-theme-spec` as of 2024-08-10 is 0.13\0A    # https://specifications.freedesktop.org/icon-theme-spec/latest/\0A    # https://specifications.freedesktop.org/icon-theme-spec/0.13/#directory_layout\0A    # 1. $HOME/.icons\0A    # 2. $XDG_DATA_DIRS/icons\0A    # 3. /usr/share/pixmaps\0A    set -l dirs (path filter -rd -- ~/.icons $XDG_DATA_DIRS/icons /usr/share/pixmaps)\0A\0A    # https://specifications.freedesktop.org/icon-theme-spec/0.13/#definitions\0A    # .png, .svg and .xpm are valid icon file formats\0A    path filter -rf -- $dirs/**/*.{png,svg,xpm} \\\0A        | path basename \\\0A        | path change-extension ''\0Aend\0A", align 1
