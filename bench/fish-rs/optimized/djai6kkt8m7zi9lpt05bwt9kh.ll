@anon.1d0b41a8d45d477c3029ec78f9b8b434.2554 = private unnamed_addr constant [3567 x i8] c"# Usage: sass-convert [options] [INPUT] [OUTPUT]\0A\0A# Description:\0A#   Converts between CSS, indented syntax, and SCSS files. For example,\0A#   this can convert from the indented syntax to SCSS, or from CSS to\0A#   SCSS (adding appropriate nesting).\0A\0A# Common Options:\0A#     -F, --from FORMAT                The format to convert from. Can be css, scss, sass.\0A#                                      By default, this is inferred from the input filename.\0A#                                      If there is none, defaults to css.\0Acomplete -c sass-convert -s F -l from -x -a \22css scss sass\22 -d \22The format to convert from\22\0A#     -T, --to FORMAT                  The format to convert to. Can be scss or sass.\0A#                                      By default, this is inferred from the output filename.\0A#                                      If there is none, defaults to sass.\0Acomplete -c sass-convert -s T -l to -x -a \22scss sass\22 -d \22The format to convert to\22\0A#     -i, --in-place                   Convert a file to its own syntax.\0A#                                      This can be used to update some deprecated syntax.\0Acomplete -c sass-convert -s i -l in-place -d \22Convert a file to its own syntax\22\0A#     -R, --recursive                  Convert all the files in a directory. Requires --from and --to.\0Acomplete -c sass-convert -s R -l recursive -d \22Convert all the files in a directory\22\0A#     -?, -h, --help                   Show this help message.\0Acomplete -c sass-convert -s '?' -s h -l help -f -d \22Show help message\22\0A#     -v, --version                    Print the Sass version.\0Acomplete -c sass-convert -s v -l version -f -d \22Print the Sass version\22\0A\0A# Style:\0A#         --dasherize                  Convert underscores to dashes.\0Acomplete -c sass-convert -l dasherize -d \22Convert underscores to dashes\22\0A#         --indent NUM                 How many spaces to use for each level of indentation. Defaults to 2.\0A#                                      \22t\22 means use hard tabs.\0Acomplete -c sass-convert -l indent -x -d \22How many spaces to use for each level of indentation\22\0A#         --old                        Output the old-style \22:prop val\22 property syntax.\0A#                                      Only meaningful when generating Sass.\0Acomplete -c sass-convert -l old -d \22Output the old-style ':prop val' property syntax\22\0A\0A# Input and Output:\0A#     -s, --stdin                      Read input from standard input instead of an input file.\0A#                                      This is the default if no input file is specified. Requires --from.\0Acomplete -c sass-convert -s s -l stdin -d \22Read input from standard input instead of an input file\22\0A#     -E, --default-encoding ENCODING  Specify the default encoding for input files.\0Acomplete -c sass-convert -s E -l default-encoding -x -d \22Specify the default encoding for input files\22\0A#         --unix-newlines              Use Unix-style newlines in written files.\0A#                                      Always true on Unix.\0Acomplete -c sass-convert -l unix-newlines -d \22Use Unix-style newlines in written files\22\0A\0A# Miscellaneous:\0A#         --cache-location PATH        The path to save parsed Sass files. Defaults to .sass-cache.\0Acomplete -c sass-convert -l cache-location -r -d \22The path to save parsed Sass files\22\0A#     -C, --no-cache                   Don't cache to sassc files.\0Acomplete -c sass-convert -s C -l no-cache -d \22Don't cache to sassc files\22\0A#         --trace                      Show a full Ruby stack trace on error\0Acomplete -c sass-convert -l trace -d \22Show a full Ruby stack trace on error\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2555 = private unnamed_addr constant [21 x i8] c"completions/sass.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2556 = private unnamed_addr constant [5644 x i8] c"# Usage: sass [options] [INPUT] [OUTPUT]\0A\0A# Description:\0A#   Converts SCSS or Sass files to CSS.\0A\0A# Common Options:\0A#     -I, --load-path PATH             Specify a Sass import path.\0Acomplete -c sass -s I -l load-path -r -d \22Specify a import path\22\0A#     -r, --require LIB                Require a Ruby library before running Sass.\0Acomplete -c sass -s r -l require -x -d \22Require a Ruby library before running\22\0A#         --compass                    Make Compass imports available and load project configuration.\0Acomplete -c sass -l compass -d \22Enable Compass imports and load project configuration\22\0A#     -t, --style NAME                 Output style. Can be nested (default), compact, compressed, or expanded.\0Acomplete -c sass -s t -l style -x -a \22nested compact compressed expanded\22 -d \22Output style\22\0A#     -?, -h, --help                   Show this help message.\0Acomplete -c sass -s '?' -s h -l help -f -d \22Show help message\22\0A#     -v, --version                    Print the Sass version.\0Acomplete -c sass -s v -l version -f -d \22Print the version\22\0A\0A# Watching and Updating:\0A#         --watch                      Watch files or directories for changes.\0A#                                      The location of the generated CSS can be set using a colon:\0A#                                        sass --watch input.sass:output.css\0A#                                        sass --watch input-dir:output-dir\0Acomplete -c sass -l watch -d \22Watch files or directories for changes\22\0A#         --poll                       Check for file changes manually, rather than relying on the OS.\0A#                                      Only meaningful for --watch.\0Acomplete -c sass -l poll -d \22Check for file changes manually, don't rely on OS\22\0A#         --update                     Compile files or directories to CSS.\0A#                                      Locations are set like --watch.\0Acomplete -c sass -l update -d \22Compile files or directories to CSS\22\0A#     -f, --force                      Recompile every Sass file, even if the CSS file is newer.\0A#                                      Only meaningful for --update.\0Acomplete -c sass -s f -l force -d \22Recompile every Sass file, even if the CSS file is newer\22\0A#         --stop-on-error              If a file fails to compile, exit immediately.\0A#                                      Only meaningful for --watch and --update.\0Acomplete -c sass -l stop-on-error -d \22If a file fails to compile, exit immediately\22\0A\0A# Input and Output:\0A#         --scss                       Use the CSS-superset SCSS syntax.\0Acomplete -c sass -l scss -d \22Use the CSS-superset SCSS syntax.\22\0A#         --sourcemap=TYPE             How to link generated output to the source files.\0A#                                        auto (default): relative paths where possible, file URIs elsewhere\0A#                                        file: always absolute file URIs\0A#                                        inline: include the source text in the sourcemap\0A#                                        none: no sourcemaps\0Acomplete -c sass -l sourcemap -x -a \22auto\\t'(default) relative paths where possible, file URIs elsewhere'\0Asfile\\t'always absolute file URIs'\0Ainline\\t'include the source text in the sourcemap'\0Anone\\t'no sourcemaps'\22 -d \22How to link generated output to the source files\22\0A#     -s, --stdin                      Read input from standard input instead of an input file.\0A#                                      This is the default if no input file is specified.\0Acomplete -c sass -s s -l stdin -d \22Read input from standard input instead of an input file\22\0A#     -E, --default-encoding ENCODING  Specify the default encoding for input files.\0Acomplete -c sass -s E -l default-encoding -x -d \22Specify the default encoding for input files\22\0A#         --unix-newlines              Use Unix-style newlines in written files.\0A#                                      Always true on Unix.\0Acomplete -c sass -l unix-newlines -d \22Use Unix-style newlines in written files\22\0A#     -g, --debug-info                 Emit output that can be used by the FireSass Firebug plugin.\0Acomplete -c sass -s g -l debug-info -d \22Emit output that can be used by the FireSass Firebug plugin\22\0A#     -l, --line-numbers               Emit comments in the generated CSS indicating the corresponding source line.\0A#         --line-comments\0Acomplete -c sass -s l -l line-numbers -l line-comments -d \22Indicate corresponding source line with comments\22\0A\0A# Miscellaneous:\0A#     -i, --interactive                Run an interactive SassScript shell.\0Acomplete -c sass -s i -l interactive -d \22Run an interactive SassScript shell\22\0A#     -c, --check                      Just check syntax, don't evaluate.\0Acomplete -c sass -s c -l check -d \22Just check syntax, don't evaluate\22\0A#         --precision NUMBER_OF_DIGITS How many digits of precision to use when outputting decimal numbers.\0A#                                      Defaults to 5.\0Acomplete -c sass -l precision -x -d \22Set precision when outputting decimal numbers\22\0A#         --cache-location PATH        The path to save parsed Sass files. Defaults to .sass-cache.\0Acomplete -c sass -l cache-location -r -d \22The path to save parsed Sass files\22\0A#     -C, --no-cache                   Don't cache parsed Sass files.\0Acomplete -c sass -s C -l no-cache -d \22Don't cache parsed Sass files\22\0A#         --trace                      Show a full Ruby stack trace on error.\0Acomplete -c sass -l trace -d \22Show a full Ruby stack trace on error\22\0A#     -q, --quiet                      Silence warnings and status messages during compilation.\0Acomplete -c sass -s q -l quiet -d \22Silence warnings and status messages during compilation\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2557 = private unnamed_addr constant [21 x i8] c"completions/sbcl.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2558 = private unnamed_addr constant [1326 x i8] c"complete -c sbcl -l help -d \22Print this message and exit.\22\0Acomplete -c sbcl -l version -d \22Print version information and exit.\22\0Acomplete -c sbcl -l core -d \22Use the specified core file instead of the default.\22\0Acomplete -c sbcl -l dynamic-space-size -d \22Size of reserved dynamic space in megabytes.\22\0Acomplete -c sbcl -l control-stack-size -d \22Size of reserved control stack in megabytes.\22\0Acomplete -c sbcl -l tls-limit -d \22Maximum number of thread-local symbols.\22\0Acomplete -c sbcl -l sysinit -d \22System-wide init-file to use instead of default.\22\0Acomplete -c sbcl -l userinit -d \22Per-user init-file to use instead of default.\22\0Acomplete -c sbcl -l no-sysinit -d \22Inhibit processing of any system-wide init-file.\22\0Acomplete -c sbcl -l no-userinit -d \22Inhibit processing of any per-user init-file.\22\0Acomplete -c sbcl -l disable-debugger -d \22Invoke sb-ext:disable-debugger.\22\0Acomplete -c sbcl -l noprint -d \22Run a Read-Eval Loop without printing results.\22\0Acomplete -c sbcl -l script -d \22Skip #! line, disable debugger, avoid verbosity.\22\0Acomplete -c sbcl -l quit -d \22Exit with code 0 after option processing.\22\0Acomplete -c sbcl -l non-interactive -d \22Sets both --quit and --disable-debugger.\22\0Acomplete -c sbcl -l eval -d \22Form to eval when processing this option.\22\0Acomplete -c sbcl -l load -d \22File to load when processing this option.\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2559 = private unnamed_addr constant [20 x i8] c"completions/sbt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2560 = private unnamed_addr constant [3983 x i8] c"############\0A# COMMANDS #\0A############\0A\0A# 1. In general it's not recommended to run commands one by one, because sbt startup is quite slow\0A# 2. Only commands without arguments are completed, because any commands with args have to be quoted: `sbt \22show key\22`\0A# 3. Only those commands are completed that could be useful to run as one off, like `sbt new ...`, the rest should be run in an interactive sbt shell\0A# 4. Tasks is somewhat dynamic and depends on the project definition, so only most common are offered\0A# 5. Same about settings (none are offered)\0A\0A# These commands can be combined in any order\0Acomplete -c sbt -f -a '(string split \22\\n\22 \22\0A    about            Display basic information about sbt and the build\0A    clean            Delete files produced by the build\0A    compile          Compile sources\0A    console          Scala REPL: project classes\0A    consoleQuick     Scala REPL: only project dependencies\0A    doc              Generate API documentation\0A    help             Display help message\0A    package          Produce the main artifact\0A    plugins          List currently available plugins\0A    projects         List the names of available projects\0A    publish          Publish artifacts to a repository\0A    publishLocal     Publish artifacts to the local Ivy repository\0A    publishM2        Publish artifacts to the local Maven repository\0A    run              Run a main class\0A    settings         List the settings defined for the current project\0A    shell            Launch an interactive sbt prompt\0A    tasks            List the tasks defined for the current project\0A    test             Execute all tests\0A\22 | string trim | string replace -r \22\\s+\22 \22\\t\22)' \\\0A    -n 'not contains -- \22new\22 (commandline -cpx);\0A    and not contains -- \22client\22 (commandline -cpx)'\0A\0A# These cannot be combined with any other commands and require an argument\0Acomplete -c sbt -f -n 'test  (count (commandline -cpx)) = 1 ' -a new -d 'Create a new sbt project from the given template'\0Acomplete -c sbt -f -n 'test  (count (commandline -cpx)) = 1 ' -a client -d 'Connect to a server with an interactive sbt prompt'\0A\0A###########\0A# OPTIONS #\0A###########\0A\0A# This is based on the output of `sbt -help`:\0A\0A# general options without arguments\0Acomplete -c sbt -o help -s h -f -d \22Print options help message\22\0Acomplete -c sbt -o verbose -s v -f -d \22Print more details\22\0Acomplete -c sbt -o debug -s d -f -d \22Set log level to debug\22\0Acomplete -c sbt -o no-colors -f -d \22Disable ANSI color codes\22\0Acomplete -c sbt -o sbt-create -f -d \22Launch even if there's no sbt project\22\0Acomplete -c sbt -o no-share -f -d \22Use all local caches\22\0Acomplete -c sbt -o no-global -f -d \22Use global caches, but not global ~/.sbt directory\22\0Acomplete -c sbt -o batch -f -d \22Disable interactive mode\22\0A\0A# general options with arguments\0Acomplete -c sbt -o sbt-dir -d \22Specify path to global settings/plugins\22 -r # path\0Acomplete -c sbt -o sbt-boot -d \22Specify path to shared boot directory\22 -r # path\0Acomplete -c sbt -o ivy -d \22Specify path to local Ivy repository\22 -r # path\0Acomplete -c sbt -o mem -d \22Set memory options\22 -x # integer? (default: -Xms1024m -Xmx1024m -XX:ReservedCodeCacheSize=128m -XX:MaxPermSize=256m)\0Acomplete -c sbt -o port -d \22Turn on JVM debugging, open at the given port\22 -r # port\0A\0A# sbt version\0Acomplete -c sbt -o sbt-version -d \22Use specified version of sbt\22 -x -a '0.13.(seq 0 6)\\t\22\22 1.0.0\\t\22\22'\0Acomplete -c sbt -o sbt-jar -d \22Use specified jar as the sbt launcher\22 -r # jar path\0Acomplete -c sbt -o sbt-rc -d \22Use an RC version of sbt\22 -f\0Acomplete -c sbt -o sbt-snapshot -d \22Use a snapshot version of sbt\22 -f\0A\0A# java-related\0Acomplete -c sbt -o java-home -d \22Alternate JAVA_HOME\22 -r # path\0Acomplete -c sbt -o D -d \22Pass -D option directly to the Java runtime\22 -x # -Dkey=val\0Acomplete -c sbt -o J-X -d \22Pass -X option directly to the Java runtime\22 -x # -X*\0Acomplete -c sbt -o S-X -d \22Pass -X option to sbt's scalacOptions\22 -x # -X*\0A# TODO: list available -X options if it's possible to do in an automatic way\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2561 = private unnamed_addr constant [26 x i8] c"completions/scanimage.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2562 = private unnamed_addr constant [2895 x i8] c"complete -c scanimage -s l -r -d 'Top-left x position of scan area [0..480pel]/[0..218mm]'\0Acomplete -c scanimage -s t -r -d 'Top-left y position of scan area [0..360pel]'\0Acomplete -c scanimage -s x -r -d 'Width of scan area [160..640pel]'\0Acomplete -c scanimage -s y -r -d 'Height of scan area [120..480pel]'\0A\0Acomplete -c scanimage -l brightness -r -d 'Controls the brightness of the acquired image [0..255: 128]'\0Acomplete -c scanimage -l hue -d 'Controls the \22hue\22 (blue-level) of the acquired image [0..255]: 128'\0Acomplete -c scanimage -l color -d 'Sets the picture\\'s color [0..255]: 133'\0Acomplete -c scanimage -l contrast -d 'Controls the contrast of the acquired image [0..255]: 128'\0Acomplete -c scanimage -l white-level -d 'Selects what radiance level should be considered \22white\22 [0..255]: 124'\0Acomplete -c scanimage -l custom-gamma -d 'Use custom gamma gable'\0Acomplete -c scanimage -l gamma-table -r -d 'Gamma-correction table [0..255, \E2\80\A6]'\0Acomplete -c scanimage -l mode -xa 'Lineart Gray Color' -d 'Scan mode'\0A\0Acomplete -c scanimage -s d -l device-name -d 'Device name to use' -xa '(scanimage -f \22%d%n\22)'\0Acomplete -c scanimage -s L -l list-devices -d 'List devices'\0Acomplete -c scanimage -s f -l formatted-device-list -r -d 'Print formatted device list [%d, %v, %m, %t, %i, %n]'\0Acomplete -c scanimage -l channel -r -d 'Selects the channel of the v4l device (e.g. television or video-in.)'\0A\0Acomplete -c scanimage -l filename -d 'The filename of the image to be loaded'\0Acomplete -c scanimage -l format -xa 'pnm tiff' -d 'Output image format'\0Acomplete -c scanimage -s i -l icc-profile -r -d 'Include this ICC profile into TIFF file'\0A\0Acomplete -c scanimage -s b -l batch -d 'Working in batch mode, FORMAT is \\'out%d.pnm\\' or \\'out%d.tif\\' by default depending on --format'\0Acomplete -c scanimage -l batch-start -r -d 'Page number to start naming files with'\0Acomplete -c scanimage -l batch-count -r -d 'How many pages to scan in batch mode'\0Acomplete -c scanimage -l batch-increment -r -d 'Increase page number in filename by #'\0Acomplete -c scanimage -l batch-double -d 'Increment page number by two'\0Acomplete -c scanimage -l batch-prompt -d 'Ask for pressing a key before scanning a page'\0A\0Acomplete -c scanimage -l accept-md5-only -d 'Only accept authorization requests using md5'\0Acomplete -c scanimage -s p -l progress -d 'Print progress messages'\0Acomplete -c scanimage -s n -l dont-scan -d 'Only set options, don\\'t actually scan'\0Acomplete -c scanimage -s T -l test -d 'Test backend thoroughly'\0Acomplete -c scanimage -s A -l all-options -d 'List all available backend options'\0Acomplete -c scanimage -s h -l help -d 'Display this help message and exit'\0Acomplete -c scanimage -s v -l verbose -d 'Give even more status messages'\0Acomplete -c scanimage -s B -l buffer-size -r -d 'Change input buffer size (in kB, default 32)'\0Acomplete -c scanimage -s V -l version -d 'Print version information'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2563 = private unnamed_addr constant [25 x i8] c"completions/schtasks.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2564 = private unnamed_addr constant [9330 x i8] c"function __schtasks_print_tasks -d 'Helper function to print tasks'\0A    schtasks /query /fo csv /nh | awk -F ',' '{ print $1 }'\0Aend\0A\0Afunction __schtasks_change_complete_args -a previous_token\0A    if test \22$previous_token\22 = /tn\0A        __schtasks_print_tasks\0A        return\0A    end\0A\0A    if string match -r -q -- \22$previous_token\22 '^/r?u$'\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    if not __fish_seen_argument -w et -w du\0A        echo -e '/et\\tSpecify the end time for the task\0A/du\\tA value that specifies the duration'\0A    end\0A\0A    if not __fish_seen_argument -w ENABLE -w DISABLE\0A        echo -e '/ENABLE\\tSpecify to enable the scheduled task\0A/DISABLE\\tSpecify to disable the scheduled task'\0A    end\0A\0A    echo -e '/tn\\tIdentify the task to be changed\0A/s\\tSpecify the name or IP address of a remote computer\0A/ru\\tChange the user name under which the scheduled task has to run\0A/rp\\tSpecify a new password for the existing user account, or the user account specified by /ru\0A/tr\\tChange the program that the task runs\0A/st\\tSpecify the start time for the task\0A/ri\\tSpecify the repetition interval for the scheduled task\0A/k\\tStop the program that the task runs at the time specified by /et or /du\0A/sd\\tSpecify the first date on which the task should be run\0A/ed\\tSpecify the last date on which the task should be run\0A/it\\tSpecify to run the scheduled task only when the run as user is logged on to the computer\0A/z\\tSpecify to delete the task upon the completion of its schedule\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_create_complete_args -a previous_token\0A    if test \22$previous_token\22 = /sc\0A        echo -e 'MINUTE\\tSpecify the number of minutes before the task should run\0AHOURLY\\tSpecify the number of hours before the task should run\0ADAILY\\tSpecify the number of days before the task should run\0AWEEKLY\\tSpecify the number of weeks before the task should run\0AMONTHLY\\tSpecify the number of months before the task should run\0AONCE\\tSpecify that that task runs once at a specified date and time\0AONSTART\\tSpecify that the task runs every time the system starts\0AONLOGON\\tSpecify that the task runs whenever a user logs on\0AONIDLE\\tSpecify that the task runs whenever the system is idle for a specified period of time'\0A        return\0A    end\0A\0A    if string match -r -q -- \22$previous_token\22 '^/r?u$'\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /mo\0A        echo -e 'MINUTE\\tSpecify that the task runs every n minutes\0AHOURLY\\tSpecify that the task runs every n hours\0ADAILY\\tSpecify that the task runs every n days\0AWEEKLY\\tSpecify that the task runs every n weeks\0AMONTHLY\\tSpecify that the task runs every n months\0AONCE\\tSpecify that the task runs once\0AONSTART\\tSpecify that the task runs at startup\0AONLOGON\\tSpecify that the task runs when the user specified by the /u parameter logs on\0AONIDLE\\tSpecify that the task runs after the system is idle for the number of minutes specified by /i'\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    if not __fish_seen_argument -w et -w du\0A        echo -e '/et\\tSpecify the time of day that a minute or hourly task schedule ends\0A/du\\tSpecify a maximum length of time for a minute or hourly schedule'\0A    end\0A\0A    echo -e '/sc\\tSpecify the schedule type\0A/tn\\tSpecify a name for the task\0A/tr\\tSpecify the program or command that the task runs\0A/s\\tSpecify the name or IP address of a remote computer\0A/ru\\tRun the task with permissions of the specified user account\0A/rp\\tSpecify a the password for the existing user account, or the user account specified by /ru\0A/mo\\tSpecify how often the task runs within its schedule type\0A/d\\tSpecify how often the task runs within its schedule type\0A/m\\tSpecify a month or months of the year during which the scheduled task should run\0A/i\\tSpecify how many minutes the computer is idle before the task starts\0A/st\\tSpecify the start time for the task\0A/ri\\tSpecify the repetition interval for the scheduled task\0A/k\\tStop the program that the task runs at the time specified by /et or /du\0A/sd\\tSpecify the date on which the task schedule starts\0A/ed\\tSpecify the date on which the schedule ends\0A/it\\tSpecify to run the scheduled task only when the run as user is logged on to the computer\0A/z\\tSpecify to delete the task upon the completion of its schedule\0A/f\\tSpecify to create the task and suppress warnings if the specified task already exists\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_delete_complete_args -a previous_token\0A    if test \22$previous_token\22 = /tn\0A        __schtasks_print_tasks\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /u\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    echo -e '/tn\\tIdentify the task to be deleted\0A/f\\tSuppress the confirmation message\0A/s\\tSpecify the name or IP address of a remote computer\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_end_complete_args -a previous_token\0A    if test \22$previous_token\22 = /tn\0A        __schtasks_print_tasks\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /u\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    echo -e '/tn\\tIdentify the task that started the program\0A/s\\tSpecify the name or IP address of a remote computer\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_query_complete_args -a previous_token\0A    if test \22$previous_token\22 = /fo\0A        echo -e 'TABLE\0ALIST\0ACSV'\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /u\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    echo -e '/fo\\tSpecify the output format\0A/nh\\tRemove column headings\0A/v\\tAdd the advanced properties of the task\0A/s\\tSpecify the name or IP address of a remote computer\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_run_complete_args -a previous_token\0A    if test \22$previous_token\22 = /tn\0A        __schtasks_print_tasks\0A        return\0A    end\0A\0A    if test \22$previous_token\22 = /u\0A        __fish_print_windows_users\0A        return\0A    end\0A\0A    if __fish_seen_argument -w s\0A        echo -e '/u\\tRun this command with the permissions of the specified user account'\0A    end\0A\0A    if __fish_seen_argument -w u\0A        echo -e '/p\\tSpecify the password of the user account specified in the /u parameter'\0A    end\0A\0A    echo -e '/tn\\tIdentify the task to start\0A/s\\tSpecify the name or IP address of a remote computer\0A/?\\tShow help'\0Aend\0A\0Afunction __schtasks_complete_args -d 'Function to generate args'\0A    set --local previous_token (commandline -xc)[-1]\0A\0A    if __fish_seen_argument -w change\0A        __schtasks_change_complete_args \22$previous_token\22\0A    else if __fish_seen_argument -w create\0A        __schtasks_create_complete_args \22$previous_token\22\0A    else if __fish_seen_argument -w delete\0A        __schtasks_delete_complete_args \22$previous_token\22\0A    else if __fish_seen_argument -w end\0A        __schtasks_end_complete_args \22$previous_token\22\0A    else if __fish_seen_argument -w query\0A        __schtasks_query_complete_args \22$previous_token\22\0A    else if __fish_seen_argument -w run\0A        __schtasks_run_complete_args \22$previous_token\22\0A    end\0Aend\0A\0Acomplete -c schtasks -f -a '(__schtasks_complete_args)'\0A\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /change \\\0A    -d 'Change one or more properties of a task'\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /create \\\0A    -d 'Schedule a new task'\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /delete \\\0A    -d 'Delete a scheduled task'\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /end \\\0A    -d 'Stop a program started by a task'\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /query \\\0A    -d 'Display tasks scheduled to run on the computer'\0Acomplete -c schtasks -f -n 'not __fish_seen_argument -w change -w create -w delete -w end \\\0A    -w query -w run' -a /run \\\0A    -d 'Start a scheduled task immediately'\0A", align 1
