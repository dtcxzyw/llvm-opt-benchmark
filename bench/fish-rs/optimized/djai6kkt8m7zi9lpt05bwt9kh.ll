@anon.1d0b41a8d45d477c3029ec78f9b8b434.2453 = private unnamed_addr constant [23 x i8] c"completions/ranger.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2454 = private unnamed_addr constant [1017 x i8] c"complete -c ranger -s d -l debug -d \22Activate debug mode\22\0Acomplete -c ranger -s c -l clean -d \22Activate clean mode\22\0Acomplete -c ranger -s r -l confdir -d \22Change configuration directory\22\0Acomplete -c ranger -l copy-config -x -d \22Create copies of the default configuration\22 -a \22all commands commands_full rc rifle scope\22\0Acomplete -c ranger -l choosefile -r -d \22Pick file with ranger\22\0Acomplete -c ranger -l choosefiles -r -d \22Pick multiple files with ranger\22\0Acomplete -c ranger -l choosedir -r -d \22Pick directory\22\0Acomplete -c ranger -l selectfile -r -d \22Open ranger with given file selected\22\0Acomplete -c ranger -l list-unused-keys -d \22List common keys which are not bound\22\0Acomplete -c ranger -l list-tagged-files -f -d \22List all tagged files with given tag (default *)\22\0Acomplete -c ranger -l profile -d \22Print statistics of CPU usage on exit\22\0Acomplete -c ranger -l cmd -r -d \22Execute command after configuration file read\22\0Acomplete -c ranger -l version -d \22Print version\22\0Acomplete -c ranger -l help -s h -d \22Print help\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2455 = private unnamed_addr constant [22 x i8] c"completions/rbenv.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2456 = private unnamed_addr constant [4590 x i8] c"# fish completion for rbenv\0A\0Afunction __fish_rbenv_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __fish_rbenv_using_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_rbenv_executables\0A    rbenv exec --complete\0Aend\0A\0Afunction __fish_rbenv_installed_rubies\0A    rbenv versions --bare\0Aend\0A\0Afunction __fish_rbenv_official_rubies\0A    if command -sq ruby-build\0A        ruby-build --definitions\0A    else\0A        # Remove trailing spaces, otherwise completion options appear like\0A        # \22\\ \\ option\22\0A        rbenv install --list | sed \22s/^[[:space:]]*//\22\0A    end\0Aend\0A\0Afunction __fish_rbenv_prefixes\0A    rbenv prefix --complete\0Aend\0A\0A### commands\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a commands -d 'List all available rbenv commands'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command commands' -a '--sh --no-sh'\0A\0A### completions\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a completions\0A\0A### exec\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a exec\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command exec' -a '(__fish_rbenv_executables)'\0A\0A### global\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a global -d 'Set or show the global Ruby version'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command global' -a '(__fish_rbenv_installed_rubies)'\0A\0A### help\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a help\0A\0A### hooks\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a hooks -d 'List hook scripts for a given rbenv command'\0A\0A### init\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a init -d 'Configure the shell environment for rbenv'\0A\0A### install\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a install -d 'Install a Ruby version'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command install' -a '(__fish_rbenv_official_rubies)'\0A\0A### uninstall\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a uninstall -d 'Uninstall a Ruby version'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command uninstall' -a '(__fish_rbenv_installed_rubies)'\0A\0A### local\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a local -d 'Set or show the local application-specific Ruby version'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command local' -a '(__fish_rbenv_installed_rubies)'\0A\0A### prefix\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a prefix -d 'Display the directory where a Ruby version is installed'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command prefix' -a '(__fish_rbenv_prefixes)'\0A\0A### rehash\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a rehash -d 'Rehash rbenv shims (run this after installing executables)'\0A\0A### root\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a root -d 'Display the root directory where versions and shims are kept'\0A\0A### shell\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a shell -d 'Set or show the shell-specific Ruby version'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command shell' -a '--unset (__fish_rbenv_installed_rubies)'\0A\0A### shims\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a shims -d 'List existing rbenv shims'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command shims' -a --short\0A\0A### version\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version -d 'Show the current Ruby version & how it was selected'\0A\0A### version-file\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version-file -d 'Detect the file that sets the current rbenv version'\0A\0A### version-file-read\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version-file-read\0A\0A### version-file-write\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version-file-write\0A\0A### version-name\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version-name -d 'Show the current Ruby version'\0A\0A### version-origin\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a version-origin -d 'Explain how the current Ruby version is set'\0A\0A### versions\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a versions -d 'List all Ruby versions known by rbenv'\0A\0A### whence\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a whence -d 'List all Ruby versions that contain the given executable'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command whence' -a --path\0A\0A### which\0Acomplete -f -c rbenv -n __fish_rbenv_needs_command -a which -d 'Show the full path for the given Ruby executable'\0Acomplete -f -c rbenv -n '__fish_rbenv_using_command which' -a '(__fish_rbenv_executables)'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2457 = private unnamed_addr constant [27 x i8] c"completions/rc-service.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2458 = private unnamed_addr constant [1080 x i8] c"# First argument is the names of the service, i.e. a file in /etc/init.d\0Acomplete -c rc-service -n \22test (__fish_number_of_cmd_args_wo_opts) = 1\22 \\\0A    -xa \22(__fish_print_service_names)\22 -d \22Service name\22\0A\0A# The second argument is what action to take with the service\0Acomplete -c rc-service -n \22test (__fish_number_of_cmd_args_wo_opts) -gt 1\22 \\\0A    -xa \22start stop restart\22\0A\0A# Complete rc-service the options\0Acomplete -c rc-service -s e -l exists -d 'Tests if the service exists or not'\0Acomplete -c rc-service -s i -l ifexists \\\0A    -d 'If the service exists, then run the command'\0Acomplete -c rc-service -s l -l list -d 'List all available services'\0Acomplete -c rc-service -s r -l resolve \\\0A    -d 'Resolve the service name to an init script'\0Acomplete -c rc-service -s h -l help -d 'Display the help output'\0Acomplete -c rc-service -s C -l nocolor -d 'Disable color output'\0Acomplete -c rc-service -s V -l version -d 'Display software version'\0Acomplete -c rc-service -s v -l verbose -d 'Run verbosely'\0Acomplete -c rc-service -s q -l quiet -d 'Run quietly (Does not affect errors)'\0A", align 1
