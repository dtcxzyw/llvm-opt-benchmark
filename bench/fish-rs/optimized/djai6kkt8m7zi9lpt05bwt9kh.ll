@anon.1d0b41a8d45d477c3029ec78f9b8b434.1984 = private unnamed_addr constant [3073 x i8] c"#loginctl (systemd 254)\0A\0A#variables\0Aset -l seen __fish_seen_subcommand_from\0Aset -l commands activate attach disable-linger enable-linger flush-devices kill-session kill-user list-seats list-sessions list-users lock-session lock-sessions seat-status session-status show-seat show-session show-user terminate-seat terminate-session terminate-user unlock-session unlock-sessions user-status\0Aset -l output cat export json json-pretty json-seq json-sse short short-full short-iso short-iso-precise short-monotonic short-precise short-unix verbose with-unit\0A\0Acomplete -c loginctl -f\0A\0A#commands\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -a \22$commands\22\0A\0A#options\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l all -s a -d \22Show all properties, including empty ones\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l full -s l -d \22Do not ellipsize output\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l help -s h -d \22Show this help\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l host -s H -d \22Operate on remote host\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l kill-who -d \22Who to send signal to\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l lines -s n -d \22Number of journal entries to show\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l machine -s M -d \22Operate on local container\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l no-ask-password -d \22Don't prompt for password\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l no-legend -d \22Do not show the headers and footers\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l no-pager -d \22Do not pipe output into a pager\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l output -s o -a \22$output\22 -d \22Change journal output mode\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l property -s p -d \22Show only properties by this name\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -s P -d \22Equivalent to --value --property\22\0Acomplete -c loginctl -x -n \22not $seen $commands\22 -l signal -s s -d \22Which signal to send\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l value -d \22When showing properties, only print the value\22\0Acomplete -c loginctl -f -n \22not $seen $commands\22 -l version -d \22Show package version\22\0A\0Afunction __fish_loginctl_list_sessions\0A    loginctl list-sessions --no-legend --no-pager --output=short | string replace -r '^\\s*(\\d+)\\s+\\d+\\s+(\\S+)\\s+(\\S+\\s+)?(\\S+\\d+).*' '$1\\t$2 at $4'\0Aend\0A\0Afunction __fish_loginctl_list_users\0A    loginctl list-users --no-legend --no-pager --output=short | string replace -r '(\\d+) (\\S+) .*' '$1\\t$2'\0Aend\0A\0Afunction __fish_loginctl_list_seats\0A    loginctl list-seats --no-legend --no-pager --output=short\0Aend\0A\0Acomplete -c loginctl -n \22$seen session-status show-session activate lock-session unlock-session terminate-session kill-session\22 -a '(__fish_loginctl_list_sessions)'\0Acomplete -c loginctl -n \22$seen user-status show-user enable-linger disable-linger terminate-user kill-user\22 -a '(__fish_loginctl_list_users)'\0Acomplete -c loginctl -n \22$seen seat-status show-seat attach terminate-seat\22 -a '(__fish_loginctl_list_seats)'\0A", align 1
