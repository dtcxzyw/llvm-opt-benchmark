@anon.1d0b41a8d45d477c3029ec78f9b8b434.1192 = private unnamed_addr constant [11758 x i8] c"# This can't currently be wrapped as the pacman completions rely on variables whose value this needs to change\0A# complete -c aura -w pacman\0Aset -l listinstalled \22(pacman -Q | tr ' ' \\t)\22\0Aset -l listall \22(__fish_print_pacman_packages)\22\0Aset -l listrepos \22(__fish_print_pacman_repos)\22\0Aset -l listgroups \22(pacman -Sg | sed 's/\\(.*\\)/\\1\\tPackage group/g')\22\0A\0Aset -l noopt 'not __fish_contains_opt -s S -s D -s Q -s R -s U -s T -s A -s B -s C -s L -s O database query sync remove upgrade deptest aursync save downgrade viewlog orphans check conf deps free stats thanks'\0Aset -l database '__fish_contains_opt -s D database'\0Aset -l query '__fish_contains_opt -s Q query'\0Aset -l remove '__fish_contains_opt -s R remove'\0Aset -l sync '__fish_contains_opt -s S sync'\0Aset -l upgrade '__fish_contains_opt -s U upgrade'\0Aset -l aur '__fish_contains_opt -s A aursync'\0Aset -l save '__fish_contains_opt -s B save'\0Aset -l downgrade '__fish_contains_opt -s C downgrade'\0Aset -l orphans '__fish_contains_opt -s O orphans'\0Aset -l logfile '__fish_contains_opt -s L viewlog'\0Aset -l check '__fish_contains_opt check'\0Aset -l conf '__fish_contains_opt conf'\0Aset -l deps '__fish_contains_opt deps'\0Aset -l free '__fish_contains_opt stats'\0Aset -l thanks '__fish_contains_opt thanks'\0Aset -l search '__fish_contains_opt -s s search'\0A\0A# By default fish expands the arguments with the option which is not desired\0A# due to performance reasons.\0A# This will make sure we are expanding an argument and not an option:\0Aset -l argument 'not expr -- (commandline --current-token) : \22^-.*\22 > /dev/null'\0A\0A# Primary operations\0Acomplete -c aura -s A -f -l aursync -n $noopt -d 'Synchronize AUR packages'\0Acomplete -c aura -s B -f -l save -n $noopt -d 'Save and restore package state'\0Acomplete -c aura -s C -f -l downgrade -n $noopt -d 'Package cache actions'\0Acomplete -c aura -s D -f -l database -n $noopt -d 'Modify the package database'\0Acomplete -c aura -s L -f -l viewlog -n $noopt -d 'Pacman log actions'\0Acomplete -c aura -s O -f -l orphans -n $noopt -d 'Operate on orphan packages'\0Acomplete -c aura -s Q -f -l query -n $noopt -d 'Query the package database'\0Acomplete -c aura -s R -f -l remove -n $noopt -d 'Remove packages from the system'\0Acomplete -c aura -s S -f -l sync -n $noopt -d 'Synchronize packages'\0Acomplete -c aura -s T -f -l deptest -n $noopt -d 'Check dependencies'\0Acomplete -c aura -s U -f -l upgrade -n $noopt -d 'Upgrade or add a local package'\0Acomplete -c aura -l check -n $noopt -d 'Validate your system'\0Acomplete -c aura -l conf -n $noopt -d 'View various configuration settings and files'\0Acomplete -c aura -l deps -n $noopt -d 'Output a dependency graph'\0Acomplete -c aura -l free -n $noopt -d 'State of Free Software install on the system'\0Acomplete -c aura -l stats -n $noopt -d 'View statistics about your machine or about Aura itself'\0Acomplete -c aura -l thanks -n $noopt -d 'The people behind Aura'\0Acomplete -c aura -s V -f -l version -d 'Display version and exit'\0Acomplete -c aura -s h -f -l help -d 'Display help'\0A\0A# General options\0Acomplete -c aura -l log-level -d 'Minimum level of Aura log messages to display'\0Acomplete -c aura -l noconfirm -d 'Do not ask for any confirmation'\0A\0A# Transaction options (sync, remove, upgrade)\0Afor condition in sync remove upgrade\0A    complete -c aura -n $$condition -s d -l nodeps -d 'Skip [all] dependency checks'\0A    complete -c aura -n $$condition -l dbonly -d 'Modify database entry only'\0A    complete -c aura -n $$condition -l noprogressbar -d 'Do not display progress bar'\0A    complete -c aura -n $$condition -l noscriptlet -d 'Do not execute install script'\0A    complete -c aura -n $$condition -s p -l print -d 'Dry run, only print targets'\0A    complete -c aura -n $$condition -l print-format -x -d 'Specify printf-like format'\0Aend\0A\0A# Database and upgrade options (database, sync, upgrade)\0Afor condition in database sync upgrade\0A    complete -c aura -n $$condition -l asdeps -d 'Mark PACKAGE as dependency'\0A    complete -c aura -n $$condition -l asexplicit -d 'Mark PACKAGE as explicitly installed'\0Aend\0A\0A# Upgrade options (sync, upgrade)\0Afor condition in sync upgrade\0A    complete -c aura -n $$condition -s f -l force -d 'Bypass file conflict checks'\0A    complete -c aura -n $$condition -l ignore -d 'Ignore upgrade of PACKAGE' -xa \22$listinstalled\22\0A    complete -c aura -n $$condition -l ignoregroup -d 'Ignore upgrade of GROUP' -xa \22$listgroups\22\0A    complete -c aura -n $$condition -l needed -d 'Do not reinstall up-to-date targets'\0A    complete -c aura -n $$condition -l recursive -d 'Recursively reinstall all dependencies'\0Aend\0A\0A# Query and sync options\0Afor condition in query sync\0A    complete -c aura -n $$condition -s g -l groups -d 'Display all packages in GROUP' -xa \22$listgroups\22\0A    complete -c aura -n $$condition -s i -l info -d 'Display information on PACKAGE'\0A    complete -c aura -n $$condition -s q -l quiet -d 'Show less information'\0A    complete -c aura -n $$condition -s s -l search -r -d 'Search packages for regexp'\0Aend\0A\0Afor condition in aur\0A    complete -c aura -n $$condition -s a -l delmakedeps -d 'Remove packages only needed during installation'\0A    complete -c aura -n $$condition -s c -l clean -d 'Clear the build directory after a package is built'\0A    complete -c aura -n $$condition -s d -l dryrun -d 'Show available upgrades, but do not perform them'\0A    complete -c aura -n $$condition -s k -l diff -d 'Show PKGBUILD diffs'\0A    complete -c aura -n $$condition -l git -d 'Include -git/-svn/etc packages'\0Aend\0A\0A# AUR options\0Acomplete -c aura -n $aur -s i -l info -d 'View package information'\0Acomplete -c aura -n $aur -s o -l open -d 'Open a given package\\'s AUR package'\0Acomplete -c aura -n $aur -s p -l pkgbuild -d 'View the packages\\'s PKGBUILD'\0Acomplete -c aura -n $aur -s s -l search -r -d 'Search the AUR for matching terms'\0Acomplete -c aura -n $aur -s u -l sysupgrade -d 'Upgrade all installed AUR packages'\0Acomplete -c aura -n $aur -s v -l provides -d 'Search for packages that \22provide\22 some package identity'\0Acomplete -c aura -n $aur -s w -l clone -d 'Download the source tarball'\0Acomplete -c aura -n $aur -s y -l refresh -d 'Pull the latest changes for every local package clone'\0Acomplete -c aura -n $aur -l build -r -d 'Specify a build location'\0Acomplete -c aura -n $aur -l builduser -r -d 'User to build as'\0Acomplete -c aura -n $aur -l hotedit -d 'Prompt for PKGBUILD editing'\0Acomplete -c aura -n $aur -l ignore -r -d 'Ignore a package upgrade'\0Acomplete -c aura -n $aur -l nocheck -d 'Do not run the check() function of the PKGBUILD'\0Acomplete -c aura -n $aur -l shellcheck -d 'Run shellcheck on PKGBUILDs before building'\0Acomplete -c aura -n $aur -l skipdepcheck -d 'Perform no dependency resolution'\0Acomplete -c aura -n $aur -l skipinteg -d 'Do not perform any verification checks on source files'\0Acomplete -c aura -n $aur -l skippgpcheck -d 'Do not verify source files with PGP signatures'\0Acomplete -c aura -n \22$aur; and $search\22 -l abc -d 'Sort alphabetically'\0Acomplete -c aura -n \22$aur; and $search\22 -l limit -d 'Limit the results to N results'\0Acomplete -c aura -n \22$aur; and $search\22 -s r -l reverse -d 'Reverse the search results'\0Acomplete -c aura -n \22$aur; and $search\22 -s q -l quiet -d 'Only print matching package names'\0A\0A# Backup options\0Acomplete -c aura -n $save -s c -l clean -d 'Remove all but the given number of backups'\0Acomplete -c aura -n $save -s l -l list -d 'Show all saved package snapshot filenames'\0Acomplete -c aura -n $save -s r -l restore -d 'Restores a record kept with -B'\0A\0A# Downgrade options\0Acomplete -c aura -n $downgrade -s b -l backup -d 'Backup to directory'\0Acomplete -c aura -n $downgrade -s c -l clean -d 'Save this many versions'\0Acomplete -c aura -n $downgrade -s i -l info -d 'Look up specific packages for info on their cache entries'\0Acomplete -c aura -n $downgrade -s l -l list -d 'Print the contents of the package cache'\0Acomplete -c aura -n $downgrade -s m -l missing -d 'Display packages that don\\'t have a tarball in the cache'\0Acomplete -c aura -n $downgrade -s n -l notsaved -d 'Delete only those tarballs which aren\\'t present in a snapshot'\0Acomplete -c aura -n $downgrade -s s -l search -r -d 'Search via regex'\0Acomplete -c aura -n $downgrade -s t -l invalid -r -d 'Delete invalid tarballs from the cache'\0Acomplete -c aura -n $downgrade -s y -l refresh -r -d 'Download missing tarballs of installed packages'\0A\0A# Logfile options\0Acomplete -c aura -n $logfile -s i -l info -d 'Show package history'\0Acomplete -c aura -n $logfile -s s -l search -r -d 'Search via regex'\0A\0A# Orphan options\0Acomplete -c aura -n $orphans -s a -l adopt -d 'Mark a package as being explicitly installed'\0Acomplete -c aura -n $orphans -s e -l elderly -d 'Display all explicitly installed, top-level packages'\0Acomplete -c aura -n $orphans -s j -l abandon -d 'Uninstall orphan packages'\0A\0A# Query options\0Acomplete -c aura -n $query -s c -l changelog -d 'View the change log of PACKAGE'\0Acomplete -c aura -n $query -s d -l deps -d 'List only non-explicit packages (dependencies)'\0Acomplete -c aura -n $query -s e -l explicit -d 'List only explicitly installed packages'\0Acomplete -c aura -n $query -s k -l check -d 'Check if all files owned by PACKAGE are present'\0Acomplete -c aura -n $query -s l -l list -d 'List all files owned by PACKAGE'\0Acomplete -c aura -n $query -s m -l foreign -d 'List all packages not in the database'\0Acomplete -c aura -n $query -s o -l owns -r -d 'Search for the package that owns FILE'\0Acomplete -c aura -n $query -s p -l file -d 'Apply the query to a package file, not package'\0Acomplete -c aura -n $query -s t -l unrequired -d 'List only unrequired packages'\0Acomplete -c aura -n $query -s u -l upgrades -d 'List only out-of-date packages'\0Acomplete -c aura -n \22$query; and $argument\22 -xa $listinstalled -d 'Installed package'\0A\0A# Remove options\0Acomplete -c aura -n $remove -s c -l cascade -d 'Also remove packages depending on PACKAGE'\0Acomplete -c aura -n $remove -s n -l nosave -d 'Ignore file backup designations'\0Acomplete -c aura -n $remove -s s -l recursive -d 'Also remove dependencies of PACKAGE'\0Acomplete -c aura -n $remove -s u -l unneeded -d 'Only remove targets not required by PACKAGE'\0Acomplete -c aura -n \22$remove; and $argument\22 -xa $listinstalled -d 'Installed package'\0A\0A# Sync options\0Acomplete -c aura -n $sync -s c -l clean -d 'Remove [all] packages from cache'\0Acomplete -c aura -n $sync -s l -l list -xa \22$listrepos\22 -d 'List all packages in REPOSITORY'\0Acomplete -c aura -n $sync -s u -l sysupgrade -d 'Upgrade all packages that are out of date'\0Acomplete -c aura -n $sync -s w -l downloadonly -d 'Only download the target packages'\0Acomplete -c aura -n $sync -s y -l refresh -d 'Download fresh copy of the package list'\0Acomplete -c aura -n \22$sync; and $argument\22 -xa \22$listall $listgroups\22\0A\0A# Upgrade options\0Acomplete -c aura -n \22$upgrade; and $argument\22 -k -a '(__fish_complete_suffix pkg.tar.xz pkg.tar.gz pkg.tar.zst)' -d 'Package file'\0A\0A# Conf options\0Acomplete -c aura -n $conf -s a -l aura -d 'View the contents of your Aura config'\0Acomplete -c aura -n $conf -s g -l gen -d 'Output your full current config as legal TOML'\0Acomplete -c aura -n $conf -s m -l makepkg -d 'View the Makepkg conf'\0Acomplete -c aura -n $conf -s p -l pacman -d 'View the Pacman conf'\0A\0A# Deps options\0Acomplete -c aura -n $deps -s l -l limit -d 'The number of layers up or down to allow'\0Acomplete -c aura -n $deps -s o -l optional -d 'Include optional dependencies'\0Acomplete -c aura -n $deps -s r -l reverse -d 'Display packages that depend on the given args'\0Acomplete -c aura -n $deps -l open -d 'Open the output image automatically'\0Acomplete -c aura -n $deps -l raw -d 'Print the raw DOT output'\0A\0A# Free options\0Acomplete -c aura -n $free -l copyleft -d 'Consider only Copyleft licenses'\0Acomplete -c aura -n $free -l lenient -d 'Allow FOSS-derived custom licenses'\0A", align 1
