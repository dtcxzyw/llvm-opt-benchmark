t root directory, but share repositories with the host'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l disable-system-resolvables -d 'Do not read installed packages'\0A\0Afunction __fish_zypper_is_subcommand_lr\0A    __fish_zypper_cmd_in_array repos lr\0Aend\0A\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l export -r -s e -d 'Export all defined repositories as a single local .repo file'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l alias -s a -d 'Show also repository alias'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l name -s n -d 'Show also repository name'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l refresh -s r -d 'Show also the autorefresh flag'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l uri -s u -d 'Show also base URI of repositories'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l priority -s p -d 'Show also repository priority'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l details -s d -d 'Show more information like URI, priority, type'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l service -s s -d 'Show also alias of parent service'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l show-enabled-only -s E -d 'Show enabled repos only'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l sort-by-uri -s U -d 'Sort the list by URI'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l sort-by-name -s N -d 'Sort the list by name'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l sort-by-priority -s P -d 'Sort the list by repository priority'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_lr -l sort-by-alias -s A -d 'Sort the list by alias'\0A\0Afunction __fish_zypper_is_subcommand_ar\0A    __fish_zypper_cmd_in_array addrepo ar\0Aend\0A\0Acomplete -c zypper -n __fish_zypper_is_subcommand_ar -l repo -r -s r -d 'Just another means to specify a .repo file to read'\0Acomplete -c zypper -n __fish_zypper_is_subcommand_ar -l check -s c -d