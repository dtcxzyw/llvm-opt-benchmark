@anon.1d0b41a8d45d477c3029ec78f9b8b434.2750 = private unnamed_addr constant [2901 x i8] c"#\0A# Completions for tr\0A#\0A\0A# Test if we are using GNU tr\0Aif command tr --version >/dev/null 2>/dev/null\0A    complete -c tr -x\0A    complete -c tr -s c -s C -l complement -d 'use the complement of SET1'\0A    complete -c tr -s d -l delete -d 'delete characters in SET1, do not translate'\0A    complete -c tr -s s -l squeeze-repeats -d 'replace each run of a character listed in SET1 with a single occurrence of that character'\0A    complete -c tr -s t -l truncate-set1 -d 'first truncate SET1 to length of SET2'\0A    complete -c tr -l help -d 'display this help and exit'\0A    complete -c tr -l version -d 'output version information and exit'\0A\0A    complete -c tr -a '[:alnum:]' -d 'all letters and digits'\0A    complete -c tr -a '[:alpha:]' -d 'all letters'\0A    complete -c tr -a '[:blank:]' -d 'all horizontal whitespace'\0A    complete -c tr -a '[:cntrl:]' -d 'all control characters'\0A    complete -c tr -a '[:digit:]' -d 'all digits'\0A    complete -c tr -a '[:graph:]' -d 'all printable characters, not including space'\0A    complete -c tr -a '[:lower:]' -d 'all lower case letters'\0A    complete -c tr -a '[:print:]' -d 'all printable characters, including space'\0A    complete -c tr -a '[:punct:]' -d 'all punctuation characters'\0A    complete -c tr -a '[:space:]' -d 'all horizontal or vertical whitespace'\0A    complete -c tr -a '[:upper:]' -d 'all upper case letters'\0A    complete -c tr -a '[:xdigit:]' -d 'all hexadecimal digits'\0Aelse\0A    # If not a GNU system, assume we have standard BSD tr features instead\0A    complete -c tr -x\0A    complete -c tr -s C -d 'Complement the set of characters in string1'\0A    complete -c tr -s c -d 'Same as -C but complement the set of values in string1'\0A    complete -c tr -s d -d 'Delete characters in string1 from the input'\0A    complete -c tr -s s -d 'Squeeze runs of characters listed in the last operand into one'\0A    complete -c tr -l u -d 'Guarantee that any output is unbuffered.'\0A\0A    complete -c tr -a '[:alnum:]' -d 'alphanumeric characters'\0A    complete -c tr -a '[:alpha:]' -d 'alphabetic characters'\0A    complete -c tr -a '[:blank:]' -d 'whitespace characters'\0A    complete -c tr -a '[:cntrl:]' -d 'control characters'\0A    complete -c tr -a '[:digit:]' -d 'numeric characters'\0A    complete -c tr -a '[:graph:]' -d 'graphic characters'\0A    complete -c tr -a '[:ideogram:]' -d 'ideographic characters'\0A    complete -c tr -a '[:lower:]' -d 'lower-case alphabetic characters'\0A    complete -c tr -a '[:phonogram:]' -d 'phonographic characters'\0A    complete -c tr -a '[:print:]' -d 'printable characters'\0A    complete -c tr -a '[:punct:]' -d 'punctuation characters'\0A    complete -c tr -a '[:rune:]' -d 'valid characters'\0A    complete -c tr -a '[:space:]' -d 'space characters'\0A    complete -c tr -a '[:special:]' -d 'special characters'\0A    complete -c tr -a '[:upper:]' -d 'upper-case characters'\0A    complete -c tr -a '[:xdigit:]' -d 'hexadecimal characters'\0Aend\0A", align 1
