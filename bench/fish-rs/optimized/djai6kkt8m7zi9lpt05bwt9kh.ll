@anon.1d0b41a8d45d477c3029ec78f9b8b434.2046 = private unnamed_addr constant [2942 x i8] c"# Completions for make\0Afunction __fish_print_make_targets --argument-names directory file\0A    # Since we filter based on localized text, we need to ensure the\0A    # text will be using the correct locale.\0A    set -lx LC_ALL C\0A\0A    set -l makeflags -C $directory\0A    if test -n \22$file\22\0A        set -a makeflags -f $file\0A    end\0A\0A    if make --version 2>/dev/null | string match -q 'GNU*'\0A        # https://stackoverflow.com/a/26339924\0A        make $makeflags -pRrq : 2>/dev/null |\0A            awk -F: -v 'bs_regex=\\\\\\\\\\\\\\\\' '/^# Files/,/^# Finished Make data base/ {\0A                if ($1 == \22# Not a target\22) skip = 1;\0A                if ($1 !~ \22^[#.\\t]\22 && !is_continuation ) {\0A                    if (!skip) print $1;\0A                    skip = 0\0A                }\0A                is_continuation = $0 ~ \22^([^#]*[^#\22 bs_regex \22])?(\22 bs_regex bs_regex \22)*\22 bs_regex \22$\22;\0A            }' 2>/dev/null\0A    else\0A        # BSD make\0A        make $makeflags -d g1 -rn >/dev/null 2>| awk -F, '/^#\\*\\*\\* Input graph:/,/^$/ {if ($1 !~ \22^#... \22) {gsub(/# /,\22\22,$1); print $1}}' 2>/dev/null\0A    end\0Aend\0A\0Afunction __fish_complete_make_targets\0A    set -l directory (string replace -rf '^make .*(-C ?|--directory(=| +))([^ ]*) .*$' '$3' -- $argv)\0A    or set directory .\0A    set -l file (string replace -rf '^make .*(-f ?|--file(=| +))([^ ]*) .*$' '$3' -- $argv)\0A    __fish_print_make_targets $directory $file\0Aend\0A\0A# This completion reenables file completion on\0A# assignments, so e.g. 'make foo FILES=<tab>' will receive standard\0A# filename completion.\0Acomplete -c make -n 'commandline -ct | string match -q \22*=*\22' -a \22(__fish_complete_make_targets (commandline -p))\22 -d Target\0Acomplete -f -c make -n 'commandline -ct | not string match -q \22*=*\22' -a \22(__fish_complete_make_targets (commandline -p))\22 -d Target\0Acomplete -c make -s f -d \22Use file as makefile\22 -r\0Acomplete -x -c make -s C -l directory -x -a \22(__fish_complete_directories (commandline -ct))\22 -d \22Change directory\22\0Acomplete -c make -s d -d \22Debug mode\22\0Acomplete -c make -s e -d \22Environment before makefile\22\0Acomplete -c make -s i -d \22Ignore errors\22\0Acomplete -x -c make -s I -d \22Search directory for makefile\22 -a \22(__fish_complete_directories (commandline -ct))\22\0Acomplete -f -c make -s j -d \22Number of concurrent jobs (no argument means no limit)\22\0Acomplete -c make -s k -d \22Continue after an error\22\0Acomplete -c make -s l -d \22Start when load drops\22\0Acomplete -c make -s n -d \22Do not execute commands\22\0Acomplete -c make -s o -r -d \22Ignore specified file\22\0Acomplete -c make -s p -d \22Print database\22\0Acomplete -c make -s q -d \22Question mode\22\0Acomplete -c make -s r -d \22Eliminate implicit rules\22\0Acomplete -c make -s s -d \22Quiet mode\22\0Acomplete -c make -s S -d \22Don't continue after an error\22\0Acomplete -c make -s t -d \22Touch files, don't run commands\22\0Acomplete -c make -s v -d \22Display version and exit\22\0Acomplete -c make -s w -d \22Print working directory\22\0Acomplete -c make -s W -r -d \22Pretend file is modified\22\0A", align 1
