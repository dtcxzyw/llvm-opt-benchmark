@anon.1d0b41a8d45d477c3029ec78f9b8b434.1456 = private unnamed_addr constant [2538 x i8] c"# completion for defaults (macOS)\0A\0Afunction __fish_defaults_domains\0A    defaults domains | string split \22, \22\0Aend\0A\0Acomplete -f -c defaults -o currentHost -d 'Restricts preferences operations to the current logged-in host'\0Acomplete -f -c defaults -o host -d 'Restricts preferences operations to hostname'\0A\0A# read\0Acomplete -f -c defaults -n __fish_use_subcommand -a read -d 'Shows defaults entire given domain'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from read read-type write rename delete' -a '(__fish_defaults_domains)'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from read read-type write rename delete' -o app\0A\0A# write\0Acomplete -f -c defaults -n __fish_use_subcommand -a write -d 'Writes domain or or a key in the domain'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o string -d 'String as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o data -d 'Raw data bytes for given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o int -d 'Integer as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o float -d 'Floating point number as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o bool -d 'Boolean as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o date -d 'Date as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o array -d 'Array as the value for the given key'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o array-add -d 'Add new elements to the end of an array'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o dict -d 'Add a dictionary to domain'\0Acomplete -f -c defaults -n '__fish_seen_subcommand_from write' -o dict-add -d 'Add new key/value pairs to a dictionary'\0A\0Acomplete -f -c defaults -n __fish_use_subcommand -a read-type -d 'Shows the type for the given domain, key'\0Acomplete -f -c defaults -n __fish_use_subcommand -a rename -d 'Renames old_key to new_key'\0Acomplete -f -c defaults -n __fish_use_subcommand -a delete -d 'Deletes domain or a key in the domain'\0Acomplete -f -c defaults -n __fish_use_subcommand -a domains -d 'Prints the names of all domains in the users defaults system'\0Acomplete -f -c defaults -n __fish_use_subcommand -a find -d 'Searches for word in domain names, keys, and values'\0Acomplete -f -c defaults -n __fish_use_subcommand -a help -d 'Prints a list of possible command formats'\0A", align 1
