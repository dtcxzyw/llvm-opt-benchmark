@anon.1d0b41a8d45d477c3029ec78f9b8b434.1560 = private unnamed_addr constant [2657 x i8] c"function __fish_print_portage_repository_names --description 'Print the names of all configured repositories'\0A    # repos.conf may be a file or a directory\0A    find /etc/portage/repos.conf -type f -exec cat '{}' + | string replace -r --filter '^\\s*\\[([[:alnum:]_][[:alnum:]_-]*)\\]' '$1' | string match -v -e DEFAULT\0Aend\0A\0A## Global Opts\0Acomplete -c emaint -s h -l help -d \22Show this help message and exit\22\0Acomplete -c emaint -s c -l check -d \22Check for problems\22\0Acomplete -c emaint -l version -d \22Show program's version number and exit\22\0Acomplete -c emaint -s f -l fix -d \22Attempt to fix problems\22\0Acomplete -c emaint -s P -l purge -d \22Remove the list of failed merges\22\0A\0A## Subcommands\0Acomplete -c emaint -n __fish_use_subcommand -xa all -d 'Perform all supported commands'\0Acomplete -c emaint -n __fish_use_subcommand -xa binhost -d 'Scan and generate metadata indexes for binary pkgs'\0Acomplete -c emaint -n __fish_use_subcommand -xa cleanconfmem -d 'Check and clean the config tracker list for uninstalled pkgs'\0Acomplete -c emaint -n __fish_use_subcommand -xa cleanresume -d 'Discard emerge --resume merge lists'\0Acomplete -c emaint -n __fish_use_subcommand -xa logs -d 'Check and clean old logs in the PORT_LOGDIR'\0Acomplete -c emaint -n __fish_use_subcommand -xa merges -d 'Scan for failed merges and fix them'\0Acomplete -c emaint -n __fish_use_subcommand -xa movebin -d 'Perform pkg move updates for binary pkgs'\0Acomplete -c emaint -n __fish_use_subcommand -xa moveinst -d 'Perform pkg move updates for installed and binary pkgs'\0Acomplete -c emaint -n __fish_use_subcommand -xa sync -d 'Check repos.conf settings and sync repositories'\0Acomplete -c emaint -n __fish_use_subcommand -xa world -d 'Check and fix problems in the world file'\0A\0A## Local opts\0A# logs\0Acomplete -c emaint -n '__fish_seen_subcommand_from logs' -s t -l time -d \22Delete logs older than NUM days\22 \\\0A    -xa \22(seq 0 365)\22\0Acomplete -c emaint -n '__fish_seen_subcommand_from logs' -s p -l pretend -d \22Output logs that would be deleted\22\0Acomplete -c emaint -n '__fish_seen_subcommand_from logs' -s C -l clean -d \22Cleans out logs more than 7 days old\22\0A# sync\0Acomplete -c emaint -n '__fish_seen_subcommand_from sync' -s a -l auto -d \22Sync auto-sync enabled repos only\22\0Acomplete -c emaint -n '__fish_seen_subcommand_from sync' -s A -l allrepos -d \22Sync all repos that have a sync-url defined\22\0Acomplete -c emaint -n '__fish_seen_subcommand_from sync' -s r -l repo -d \22Sync the specified repo\22 \\\0A    -xa \22(__fish_print_portage_repository_names)\22\0Acomplete -c emaint -n '__fish_seen_subcommand_from sync' -l sync-submodule -d \22Restrict sync to the specified submodule(s)\22 \\\0A    -xa \22glsa news profiles\22\0A", align 1
