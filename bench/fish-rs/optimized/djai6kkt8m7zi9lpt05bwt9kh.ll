@anon.1d0b41a8d45d477c3029ec78f9b8b434.2346 = private unnamed_addr constant [13798 x i8] c"# Completions for pkgng package manager\0A\0A# Solaris has a thing called \22pkg\22; it works quite differently and spews errors when called here.\0A# There are multiple SunOS-derived distributions and not all of them have `SunOS` in their name (and\0A# some of them also use pkgsrc and have a `pkg`).\0A#\0A# Additionally, this particular script is intended to complete the pkgng \22Next Generation\22 package\0A# manager initially developed for FreeBSD though now available on a few other BSDs. From here on\0A# out, maintainers can assume we are specifically talking about the (Free)BSD `pkg` command being\0A# executed on a BSD system, rather than just work with \22not SunOS\22.\0Aif ! uname | string match -irq bsd\0A    exit\0Aend\0A\0Afunction __fish_pkg_is\0A    for option in $argv\0A        if contains $option (commandline -pxc)\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_pkg_subcommand\0A    set -l skip_next 1\0A    for token in (commandline -xpc)\0A        if test $skip_next = 1\0A            set skip_next 0\0A            continue\0A        end\0A        switch $token\0A            # Option parser allows shortened long options\0A            case '--*=*'\0A                continue\0A            case -{o,j,c,r,C,R} --op\\* --j\\* --ch\\* --ro\\* --co\\* --re\\*\0A                set skip_next 1\0A                continue\0A            case '-*'\0A                continue\0A        end\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Acomplete -c pkg -n __fish_pkg_subcommand -s v -l version -d \22Display version and exit\22\0Acomplete -c pkg -n __fish_pkg_subcommand -s d -l debug -d \22Show debug information\22\0Acomplete -c pkg -n __fish_pkg_subcommand -s l -l list -d \22List subcommands\22\0Acomplete -c pkg -n __fish_pkg_subcommand -x -s o -l option -d \22Set configuration option\22\0Acomplete -c pkg -n __fish_pkg_subcommand -