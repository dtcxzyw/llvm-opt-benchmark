@anon.1d0b41a8d45d477c3029ec78f9b8b434.3448 = private unnamed_addr constant [3058 x i8] c"# Adapted from __terlar_git_prompt\0A\0Aset -g fish_color_hg_clean green\0Aset -g fish_color_hg_modified yellow\0Aset -g fish_color_hg_dirty red\0A\0Aset -g fish_color_hg_added green\0Aset -g fish_color_hg_renamed magenta\0Aset -g fish_color_hg_copied magenta\0Aset -g fish_color_hg_deleted red\0Aset -g fish_color_hg_untracked yellow\0Aset -g fish_color_hg_unmerged red\0A\0Aset -g fish_prompt_hg_status_added '\E2\9C\9A'\0Aset -g fish_prompt_hg_status_modified '*'\0Aset -g fish_prompt_hg_status_copied '\E2\87\92'\0Aset -g fish_prompt_hg_status_deleted '\E2\9C\96'\0Aset -g fish_prompt_hg_status_untracked '?'\0Aset -g fish_prompt_hg_status_unmerged !\0A\0Aset -g fish_prompt_hg_status_order added modified copied deleted untracked unmerged\0A\0Afunction fish_hg_prompt --description 'Write out the hg prompt'\0A    # If hg isn't installed, there's nothing we can do\0A    # Return 1 so the calling prompt can deal with it\0A    if not command -sq hg\0A        return 1\0A    end\0A\0A    set -l root (fish_print_hg_root)\0A    or return 1\0A\0A    # Read branch and bookmark\0A    set -l branch (cat $root/branch 2>/dev/null; or echo default)\0A    if set -l bookmark (cat $root/bookmarks.current 2>/dev/null)\0A        set branch \22$branch|$bookmark\22\0A    end\0A\0A    if not set -q fish_prompt_hg_show_informative_status\0A        set_color normal\0A        echo -n \22 ($branch)\22\0A        return\0A    end\0A\0A    echo -n '|'\0A\0A    # Disabling color and pager is always a good idea.\0A    set -l repo_status (hg status | string sub -l 2 | sort -u)\0A\0A    # Show nice color for a clean repo\0A    if test -z \22$repo_status\22\0A        set_color $fish_color_hg_clean\0A        echo -n \22($branch)\22'\E2\9C\93'\0A        set_color normal\0A\0A        # Handle modified or dirty (unknown state)\0A    else\0A        set -l hg_statuses\0A\0A        # Take actions for the statuses of the files in the repo\0A        for line in $repo_status\0A\0A            # Add a character for each file status if we have one\0A            # HACK: To allow this to work both with and without '?' globs\0A            set -l dq '?'\0A            switch $line\0A                case 'A '\0A                    set -a hg_statuses added\0A                case 'M ' ' M'\0A                    set -a hg_statuses modified\0A                case 'C '\0A                    set -a hg_statuses copied\0A                case 'D ' ' D'\0A                    set -a hg_statuses deleted\0A                case \22$dq \22\0A                    set -a hg_statuses untracked\0A                case 'U*' '*U' DD AA\0A                    set -a hg_statuses unmerged\0A            end\0A        end\0A\0A        if string match -qr '^[AMCD]' $repo_status\0A            set_color $fish_color_hg_modified\0A        else\0A            set_color $fish_color_hg_dirty\0A        end\0A\0A        echo -n \22($branch)\22'\E2\9A\A1'\0A\0A        # Sort status symbols\0A        for i in $fish_prompt_hg_status_order\0A            if contains -- $i $hg_statuses\0A                set -l color_name fish_color_hg_$i\0A                set -l status_name fish_prompt_hg_status_$i\0A\0A                set_color $$color_name\0A                echo -n $$status_name\0A            end\0A        end\0A\0A        set_color normal\0A    end\0A\0Aend\0A", align 1
