@anon.1d0b41a8d45d477c3029ec78f9b8b434.3134 = private unnamed_addr constant [944 x i8] c"function __fish_complete_list --argument-names div cmd prefix iprefix\0A    if not set -q cmd[1]\0A        echo \22Usage:\0A    __fish_complete_list <separator> <function> <prefix> <itemprefix>\0Awhere:\0A  separator - a symbol, separating individual entries\0A  function - a function which prints a completion list to complete each entry\0A  prefix - a prefix, which is printed before the list\0A  itemprefix - a prefix, which is printed before each item\22 >/dev/stderr\0A        return 1\0A    end\0A    set -q iprefix[1]\0A    or set -l iprefix \22\22\0A    set -q prefix[1]\0A    or set -l prefix \22\22\0A    set -l pat \22$(commandline -t)\22\0A    #set -l pat $argv[5]\0A    switch $pat\0A        case \22*$div*\22\0A            for i in (echo $pat | sed \22s/^\\(.\\+$div\\)$iprefix.*\\$/\\1/\22)$iprefix(eval $cmd)\0A                string unescape -- $i\0A            end\0A        case '*'\0A            for i in $prefix$iprefix(eval $cmd)\0A                string unescape -- $i\0A            end\0A    end\0A\0Aend\0A", align 1
