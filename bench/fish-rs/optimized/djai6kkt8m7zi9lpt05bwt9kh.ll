@anon.1d0b41a8d45d477c3029ec78f9b8b434.3492 = private unnamed_addr constant [560 x i8] c"function isatty -d \22Tests if a file descriptor is a tty\22\0A    set -l options h/help\0A    argparse -n isatty $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help isatty\0A        return 0\0A    end\0A\0A    if set -q argv[2]\0A        printf (_ \22%s: Too many arguments\22) isatty >&2\0A        return 1\0A    end\0A\0A    set -l fd\0A    switch \22$argv\22\0A        case stdin ''\0A            set fd 0\0A        case stdout\0A            set fd 1\0A        case stderr\0A            set fd 2\0A        case '*'\0A            set fd $argv[1]\0A    end\0A\0A    test -t \22$fd\22\0Aend\0A", align 1
