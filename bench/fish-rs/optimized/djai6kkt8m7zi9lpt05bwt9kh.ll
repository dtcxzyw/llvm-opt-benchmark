@anon.1d0b41a8d45d477c3029ec78f9b8b434.1048 = private unnamed_addr constant [14889 x i8] c"# Completions for Android adb command\0A\0Afunction __fish_adb_no_subcommand -d 'Test if adb has yet to be given the subcommand'\0A    for i in (commandline -xpc)\0A        if contains -- $i connect disconnect devices push pull sync shell emu logcat install uninstall jdwp forward bugreport backup restore version help start-server kill-server remount reboot get-state get-serialno get-devpath status-window root usb tcpip ppp sideload reconnect unroot exec-out\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_adb_get_devices -d 'Run adb devices and parse output'\0A    # This seems reasonably portable for all the platforms adb runs on\0A    set -l procs (ps -Ao comm= | string match 'adb')\0A    # Don't run adb devices unless the server is already started - it takes a while to init\0A    if set -q procs[1]\0A        adb devices -l | string replace -rf '(\\S+).*product:(\\S+).*model:(\\S+).*' '$1'\\t'$2 $3'\0A    end\0Aend\0A\0Afunction __fish_adb_get_tcpip_devices -d 'Get list of devices connected via TCP/IP'\0A    __fish_adb_get_devices | string match -r '^\\d+\\.\\d+\\.\\d+\\.\\d+:\\d+\\t.*'\0Aend\0A\0Afunction __fish_adb_run_command -d 'Runs adb with any -s parameters already given on the command line'\0A    set -l sopt\0A    set -l sopt_is_next\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        if test -n \22$sopt_is_next\22\0A            set sopt -s $i\0A            break\0A        else\0A            switch $i\0A                case -s\0A                    set sopt_is_next 1\0A            end\0A        end\0A    end\0A\0A    # If no -s option, see if there's a -d or -e instead\0A    if test -z \22$sopt\22\0A        if contains -- -d $cmd\0A            set sopt -d\0A        else if contains -- -e $cmd\0A            set sopt -e\0A        end\0A    end\0A\0A    # adb returns CRLF (seemingly) so strip CRs\0A    adb $sopt shell $argv | string replace -a \\r ''\0Aend\0A\0Afunction __fish_adb_list_packages\0A    # That \222\\>\22 is to pass the redirection *to adb*.\0A    # It sends stderr from commands it executes to its stdout as well.\0A    # Why it does that, I don't know - crossing the streams is a bad idea (c.f. Ghostbusters)\0A    __fish_adb_run_command pm list packages 2\\>/dev/null | string replace 'package:' ''\0Aend\0A\0Afunction __fish_adb_list_uninstallable_packages\0A    # -3 doesn't exactly mean show uninstallable, but it's the closest you can get to with pm list\0A    __fish_adb_run_command pm list packages -3 | string replace 'package:' ''\0Aend\0A\0Afunction __fish_adb_list_local_files\0A    set -l token (commandline -ct)*\0A\0A    # Unquoted $token to expand the array\0A    # Return list of directories suffixed with '/'\0A    find $token -maxdepth 0 -type d 2>/dev/null | string replace -r '$' /\0A    # Return list of files\0A    find $token -maxdepth 0 -type f -o -type l 2>/dev/null\0Aend\0A\0Afunction __fish_adb_list_files\0A    set -l token (commandline -ct)\0A\0A    # Have tab complete show initial / if nothing on current token\0A    if test -z \22$token\22\0A        set token /\0A    end\0A\0A    # Return list of directories suffixed with '/'\0A    __fish_adb_run_command find -H \22$token*\22 -maxdepth 0 -type d 2\\>/dev/null | string replace -r '$' /\0A    # Return list of files\0A    __fish_adb_run_command find -H \22$token*\22 -maxdepth 0 -type f 2\\>/dev/null\0Aend\0A\0Afunction __fish_adb_list_bin\0A    # list all binary without group\0A    __fish_adb_run_command ls -1 /system/bin/ 2\\>/dev/null\0A    __fish_adb_run_command ls -1 /system/xbin/ 2\\>/dev/null\0A\0Aend\0A\0Afunction __fish_adb_list_properties\0A    __fish_adb_run_command getprop | string match -rg '\\[(.*)\\]:'\0Aend\0A\0A# Generic options, must come before command\0Acomplete -n __fish_adb_no_subcommand -c adb -o a -d 'Listen on all network interfaces'\0Acomplete -n __fish_adb_no_subcommand -c adb -o d -d 'Use first USB device'\0Acomplete -n __fish_adb_no_subcommand -c adb -o e -d 'Use first TCP/IP device'\0Acomplete -n __fish_adb_no_subcommand -c adb -o s -x -a \22(__fish_adb_get_devices)\22 -d 'Use device with given serial'\0Acomplete -n __fish_adb_no_subcommand -c adb -o t -d 'Use device with given transport id'\0Acomplete -n __fish_adb_no_subcommand -c adb -o H -d 'Name of adb server host'\0Acomplete -n __fish_adb_no_subcommand -c adb -o P -d 'Port of adb server'\0Acomplete -n __fish_adb_no_subcommand -c adb -o L -d 'Listen on given socket for adb server'\0A\0A# Commands\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a connect -d 'Connect to device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a disconnect -d 'Disconnect from device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a devices -d 'List all connected devices'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a push -d 'Copy file to device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a pull -d 'Copy file from device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a sync -d 'Copy host->device only if changed'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a shell -d 'Run remote shell [command]'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a emu -d 'Run emulator console command'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a logcat -d 'View device log'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a install -d 'Install package'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a uninstall -d 'Uninstall package'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a jdwp -d 'List PIDs of processes hosting a JDWP transport'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a forward -d 'Port forwarding'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a bugreport -d 'Return bugreport information'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a backup -d 'Perform device backup'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a restore -d 'Restore device from backup'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a version -d 'Show adb version'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a help -d 'Show adb help'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a wait-for-device -d 'Block until device is online'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a start-server -d 'Ensure that there is a server running'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a kill-server -d 'Kill the server if it is running'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a remount -d 'Remounts the /system partition on the device read-write'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a reboot -d 'Reboots the device, optionally into the bootloader or recovery program'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a get-state -d 'Prints state of the device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a get-serialno -d 'Prints serial number of the device'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a get-devpath -d 'Prints device path'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a status-window -d 'Continuously print the device status'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a root -d 'Restart the adbd daemon with root permissions'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a unroot -d 'Restart the adbd daemon without root permissions'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a usb -d 'Restart the adbd daemon listening on USB'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a tcpip -d 'Restart the adbd daemon listening on TCP'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a ppp -d 'Run PPP over USB'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a sideload -d 'Sideloads the given package'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a reconnect -d 'Kick current connection from host side and make it reconnect.'\0Acomplete -f -n __fish_adb_no_subcommand -c adb -a exec-out -d 'Execute a command on the device and send its stdout back'\0A\0A# install options\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -s l -d 'Forward-lock the app'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -s r -d 'Reinstall the app keeping its data'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -s s -d 'Install on SD card instead of internal storage'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -l algo -d 'Algorithm name'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -l key -d 'Hex-encoded key'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -l iv -d 'Hex-encoded iv'\0Acomplete -n '__fish_seen_subcommand_from install' -c adb -ka '(__fish_complete_suffix .apk)'\0A\0A# uninstall\0Acomplete -n '__fish_seen_subcommand_from uninstall' -c adb -s k -d 'Keep the data and cache directories'\0Acomplete -n '__fish_seen_subcommand_from uninstall' -c adb -f -a \22(__fish_adb_list_uninstallable_packages)\22\0A\0A# devices\0Acomplete -n '__fish_seen_subcommand_from devices' -c adb -f\0Acomplete -n '__fish_seen_subcommand_from devices' -c adb -s l -d 'Also list device qualifiers'\0A\0A# disconnect\0Acomplete -n '__fish_seen_subcommand_from disconnect' -c adb -x -a \22(__fish_adb_get_tcpip_devices)\22 -d 'Device to disconnect'\0A\0A# backup\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -s f -d 'File to write backup data to'\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -o apk -d 'Enable backup of the .apks themselves'\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -o noapk -d 'Disable backup of the .apks themselves (default)'\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -o obb -d 'Enable backup of any installed apk expansion'\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -o noobb -d 'Disable backup of any installed apk expansion (default)'\0Acomplete -n '__fish_seen_subcommand_from backup' -c adb -o shared -d 'Enable backup of the device\\'s shared storage / SD card contents'\0Acomplete -n '__fish_seen_subc