@anon.1d0b41a8d45d477c3029ec78f9b8b434.3564 = private unnamed_addr constant [1222 x i8] c"# name: Astronaut\0A# author: Radu Potop\0A# description: A prompt theme similar to Starship.rs but without the emojis.\0A\0Afunction fish_prompt --description 'Write out the prompt'\0A    set -l last_status $status\0A    set -l normal (set_color normal)\0A    set -l status_color (set_color brgreen)\0A    set -l cwd_color (set_color $fish_color_cwd)\0A    set -l vcs_color (set_color brpurple)\0A    set -l prompt_status \22\22\0A\0A    # Since we display the prompt on a new line allow the directory names to be longer.\0A    set -q fish_prompt_pwd_dir_length\0A    or set -lx fish_prompt_pwd_dir_length 0\0A\0A    # Color the prompt differently when we're root\0A    set -l suffix '\E2\9D\AF'\0A    if functions -q fish_is_root_user; and fish_is_root_user\0A        if set -q fish_color_cwd_root\0A            set cwd_color (set_color $fish_color_cwd_root)\0A        end\0A        set suffix '#'\0A    end\0A\0A    # Color the prompt in red on error\0A    if test $last_status -ne 0\0A        set status_color (set_color $fish_color_error)\0A        set prompt_status $status_color \22[\22 $last_status \22]\22 $normal\0A    end\0A\0A    echo -s (prompt_login) ' ' $cwd_color (prompt_pwd) $vcs_color (fish_vcs_prompt) $normal ' ' $prompt_status\0A    echo -n -s $status_color $suffix ' ' $normal\0Aend\0A", align 1
