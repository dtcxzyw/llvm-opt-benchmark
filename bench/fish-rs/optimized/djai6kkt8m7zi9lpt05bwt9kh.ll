@anon.1d0b41a8d45d477c3029ec78f9b8b434.3122 = private unnamed_addr constant [37846 x i8] c"#\0A# Completions for the gpg program.\0A#\0A# This program accepts an rather large number of switches. It allows\0A# you to do things like changing what file descriptor errors should be\0A# written to, to make gpg use a different locale than the one\0A# specified in the environment or to specify an alternative home\0A# directory.\0A\0A# Switches related to debugging, switches whose use is not\0A# recommended, switches whose behaviour is as of yet undefined,\0A# switches for experimental features, switches to make gpg compliant\0A# to legacy pgp-versions, dos-specific switches, switches meant for\0A# the options file and deprecated or obsolete switches have all been\0A# removed. The remaining list of completions is still quite\0A# impressive.\0A\0Afunction __fish_complete_gpg -d \22Internal function for gpg completion code deduplication\22 -a __fish_complete_gpg_command\0A    if string match -q 'gpg (GnuPG) 1.*' ($__fish_complete_gpg_command --version 2>/dev/null)\0A        complete -c $__fish_complete_gpg_command -l simple-sk-checksum -d 'Integrity protect secret keys by using a SHA-1 checksum'\0A        complete -c $__fish_complete_gpg_command -l no-sig-create-check -d \22Do not verify each signature right after creation\22\0A        complete -c $__fish_complete_gpg_command -l pgp2 -d \22Set up all options to be as PGP 2.x compliant as possible\22\0A        complete -c $__fish_complete_gpg_command -l rfc1991 -d \22Try to be more RFC-1991 compliant\22\0A    else\0A        complete -c $__fish_complete_gpg_command -l no-keyring -d \22Do not use any keyring at all\22\0A        complete -c $__fish_complete_gpg_command -l no-skip-hidden-recipients -d \22During decryption, do not skip all anonymous recipients\22\0A        complete -c $__fish_complete_gpg_command -l only-sign-text-ids -d \22Exclude any non-text-based user ids from selection for signing\22\0A        complete -c $__fish_complete_gpg_command -l override-session-key-fd -x -d \22Don't use the public key but the specified session key\22\0A        complete -c $__fish_complete_gpg_command -l passwd -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Change the passphrase of the secret key belonging to the given user id\22\0A        complete -c $__fish_complete_gpg_command -l pinentry-mode -xa \22default ask cancel error loopback\22 -d \22Set the pinentry mode\22\0A        complete -c $__fish_complete_gpg_command -l quick-add-key -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22 -d \22Directly add a subkey to a key\22\0A        complete -c $__fish_complete_gpg_command -l quick-add-uid -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Adds a new user id to an existing key\22\0A        complete -c $__fish_complete_gpg_command -l quick-gen-key -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Generate a standard key without needing to answer prompts\22\0A        complete -c $__fish_complete_gpg_command -l quick-generate-key -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Generate a standard key without needing to answer prompts\22\0A        complete -c $__fish_complete_gpg_command -l quick-lsign-key -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22 -d \22Directly sign a key from the passphrase; marks signatures as non-exportable\22\0A        complete -c $__fish_complete_gpg_command -l quick-revoke-uid -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Revokes a user id on an existing key\22\0A        complete -c $__fish_complete_gpg_command -l quick-revuid -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Revokes a user id on an existing key\22\0A        complete -c $__fish_complete_gpg_command -l quick-set-expire -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22 -d \22Set the expiration time of the specified key\22\0A        complete -c $__fish_complete_gpg_command -l quick-set-primary-uid -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Sets or updates the priary uid flag for the specified key\22\0A        complete -c $__fish_complete_gpg_command -l quick-sign-key -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22 -d \22Directly sign a key from the passphrase\22\0A        complete -c $__fish_complete_gpg_command -l receive-keys -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22 -d \22Import the keys with the given key IDs from a keyserver\22\0A        complete -c $__fish_complete_gpg_command -s f -l recipient-file -r -d \22Similar to --recipient, but encrypts to key stored in file instead\22\0A        complete -c $__fish_complete_gpg_command -l request-origin -r -d \22Tell gpg to assume that the operation ultimately originated at a particular origin\22\0A        complete -c $__fish_complete_gpg_command -l sender -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22When creating a signature, tells gpg the user id of a key; when verifying, used to restrict information printed\22\0A        complete -c $__fish_complete_gpg_command -l show-key -d \22Take OpenPGP keys as input and print information about them\22\0A        complete -c $__fish_complete_gpg_command -l show-keys -d \22Take OpenPGP keys as input and print information about them\22\0A        complete -c $__fish_complete_gpg_command -l skip-hidden-recipients -d \22During decryption, skip all anonymous recipients\22\0A        complete -c $__fish_complete_gpg_command -l tofu-default-policy -xa \22auto good unknown bad ask\22 -d \22Set the default TOFU policy\22\0A        complete -c $__fish_complete_gpg_command -l tofu-policy -xa \22auto good unknown bad ask\22 -d \22Set the default TOFU policy for the specified keys\22\0A        complete -c $__fish_complete_gpg_command -l try-secret-key -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command --list-secret-keys)\22 -d \22Specify keys to be used for trial decryption\22\0A\0A        complete -c $__fish_complete_gpg_command -l with-icao-spelling -d \22Print the ICAO spelling of the fingerprint in addition to the hex digits\22\0A        complete -c $__fish_complete_gpg_command -l with-key-origin -d \22Include the locally held information on the origin and last update of a key in a key listing\22\0A        complete -c $__fish_complete_gpg_command -l with-keygrip -d \22Include the keygrip in the key listings\22\0A        complete -c $__fish_complete_gpg_command -l with-secret -d \22Include info about the presence of a secret key in public key listings done with --with-colons\22\0A        complete -c $__fish_complete_gpg_command -l no-symkey-cache -d \22Disable the passphrase cache used for symmetrical en- and decryption\22\0A        complete -c $__fish_complete_gpg_command -l no-autostart -d \22Do not start the gpg-agent or the dirmngr if it has not been started and its service is required\22\0A        complete -c $__fish_complete_gpg_command -l log-file -r -d \22Write log output to the specified file\22\0A        complete -c $__fish_complete_gpg_command -l locate-keys -d \22Locate the keys given as arguments\22\0A        complete -c $__fish_complete_gpg_command -l locate-external-keys -d \22Locate they keys given as arguments; do not consider local keys\22\0A        complete -c $__fish_complete_gpg_command -l list-signatures -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Same as --list-keys, but the signatures are listed too\22\0A        complete -c $__fish_complete_gpg_command -l list-gcrypt-config -d \22Display various internal configuration parameters of libgcrypt\22\0A        complete -c $__fish_complete_gpg_command -l known-notation -r -d \22Tell GnuPG about a critical signature notation\22\0A        complete -c $__fish_complete_gpg_command -l key-origin -d \22Track the origin of a key\22\0A        complete -c $__fish_complete_gpg_command -l input-size-hint -r -d \22Specify input size in bytes\22\0A        complete -c $__fish_complete_gpg_command -s F -l hidden-recipient-file -r -d \22Similar to --hidden-recipient, but encrypts to key stored in file instead\22\0A        complete -c $__fish_complete_gpg_command -l generate-revocation -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Generate a revocation certificate for the complete key\22\0A        complete -c $__fish_complete_gpg_command -l generate-key -d \22Generate a new key pair\22\0A        complete -c $__fish_complete_gpg_command -l generate-designated-revocation -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Generate a designated revocation certificate for a key\22\0A        complete -c $__fish_complete_gpg_command -l full-gen-key -d \22Generate a new key pair with dialogs for all options\22\0A        complete -c $__fish_complete_gpg_command -l full-generate-key -d \22Generate a new key pair with dialogs for all options\22\0A        complete -c $__fish_complete_gpg_command -l export-filter -d \22Define an import/export filter to apply to an imported/exported keyblock before it is written\22\0A        complete -c $__fish_complete_gpg_command -l import-filter -d \22Define an import/export filter to apply to an imported/exported keyblock before it is written\22\0A        complete -c $__fish_complete_gpg_command -l edit-card -d \22Present a menu to work with a smartcard\22\0A        complete -c $__fish_complete_gpg_command -l disable-signer-uid -d \22Don't embed the uid of the signing key in the data signature\22\0A        complete -c $__fish_complete_gpg_command -l disable-dirmngr -d \22Entirely disable the use of the Dirmngr\22\0A        complete -c $__fish_complete_gpg_command -l dirmngr-program -r -d \22Specify a dirmngr program to be used for keyserver access\22\0A        complete -c $__fish_complete_gpg_command -l default-new-key-algo -x -d \22Change the default algorothms for key generation\22\0A        complete -c $__fish_complete_gpg_command -l compliance -xa \22gnupg openpgp rfc4880 rfc4880bis rfc2440 pgp6 pgp7 pgp8\22 -d \22Set a compliance standard for GnuPG\22\0A        complete -c $__fish_complete_gpg_command -l change-passphrase -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Change the passphrase of the secret key belonging to the given user id\22\0A        complete -c $__fish_complete_gpg_command -l agent-program -d \22Specify an agent program to be used for secret key operations\22\0A        complete -c $__fish_complete_gpg_command -l clear-sign -d \22Make a clear text signature\22\0A    end\0A\0A    #\0A    # gpg subcommands\0A    #\0A\0A    complete -c $__fish_complete_gpg_command -s s -l sign -d \22Make a signature\22\0A    complete -c $__fish_complete_gpg_command -l clearsign -d \22Make a clear text signature\22\0A    complete -c $__fish_complete_gpg_command -s b -l detach-sign -d \22Make a detached signature\22\0A    complete -c $__fish_complete_gpg_command -s e -l encrypt -d \22Encrypt data\22\0A    complete -c $__fish_complete_gpg_command -s c -l symmetric -d \22Encrypt with a symmetric cipher using a passphrase\22\0A    complete -c $__fish_complete_gpg_command -l store -d \22Store only (make a simple literal data packet)\22\0A    complete -c $__fish_complete_gpg_command -l decrypt -d \22Decrypt specified file or stdin\22\0A    complete -c $__fish_complete_gpg_command -l verify -d \22Assume specified file or stdin is sigfile and verify it\22\0A    complete -c $__fish_complete_gpg_command -l multifile -d \22Modify certain other commands to accept multiple files for processing\22\0A    complete -c $__fish_complete_gpg_command -l verify-files -d \22Identical to '--multifile --verify'\22\0A    complete -c $__fish_complete_gpg_command -l encrypt-files -d \22Identical to '--multifile --encrypt'\22\0A    complete -c $__fish_complete_gpg_command -l decrypt-files -d \22Identical to --multifile --decrypt\22\0A\0A    complete -c $__fish_complete_gpg_command -s k -l list-keys -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22List all keys from the public keyrings, or just the ones given on the command line\22\0A    complete -c $__fish_complete_gpg_command -l list-public-keys -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22List all keys from the public keyrings, or just the ones given on the command line\22\0A    complete -c $__fish_complete_gpg_command -s K -l list-secret-keys -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command --list-secret-keys)\22 -d \22List all keys from the secret keyrings, or just the ones given on the command line\22\0A    complete -c $__fish_complete_gpg_command -l list-sigs -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Same as --list-keys, but the signatures are listed too\22\0A\0A    complete -c $__fish_complete_gpg_command -l check-sigs -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Same as --list-keys, but the signatures are listed and verified\22\0A    complete -c $__fish_complete_gpg_command -l check-signatures -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Same as --list-keys, but the signatures are listed and verified\22\0A    complete -c $__fish_complete_gpg_command -l fingerprint -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22List all keys with their fingerprints\22\0A\0A    complete -c $__fish_complete_gpg_command -l gen-key -d \22Generate a new key pair\22\0A\0A    complete -c $__fish_complete_gpg_command -l edit-key -d \22Present a menu which enables you to do all key related tasks\22 -xa \22(__fish_complete_gpg_key_id $__fish_complete_gpg_command)\22\0A\0A    complete -c $__fish_complete_gpg_command -l sign-key -xa \22(__fish_complete_gpg_user_id $__fish_complete_gpg_command)\22 -d \22Sign a public key with your sec