@anon.1d0b41a8d45d477c3029ec78f9b8b434.1888 = private unnamed_addr constant [2370 x i8] c"function __fish_complete_macos_java_version\0A    set -l json (/usr/libexec/java_home -X|plutil -convert json -o - -)\0A    osascript -l JavaScript -s o -e \22JSON.parse('$json').forEach(e => console.log(`\\${e.JVMVersion}\\t\\${e.JVMArch} \\${e.JVMName} by--exec \\${e.JVMVendor}`))\22\0Aend\0A\0Afunction __fish_complete_macos_java_home_exec\0A    # separate the buffer into two parts\0A    # where the first used to get the JAVA_HOME\0A    # and the second is the subcommand to complete\0A    set -l cmds (string replace -a -r ' *java_home *' ''  (commandline) )\0A    set -l cmds (string replace -r ' *--exec *' \\n -- \22$cmds\22)\0A\0A    # parse the java_home argv to get $JAVA_HOME/bin\0A    argparse v/version= a/arch= -- \22$cmds[1]\22\0A    set -l get_java_home /usr/libexec/java_home\0A    if test -n \22$_flag_v\22\0A        set get_java_home \22$get_java_home -v $_flag_v\22\0A    end\0A    if test -n \22$_flag_a\22\0A        set get_java_home \22$get_java_home -a $_flag_a\22\0A    end\0A    set -l java_bin_dir (eval $get_java_home)\22/bin\22\0A\0A    # if such $binary in $JAVA_HOME/bin\0A    # complete the subcommand\0A    # else\0A    # complete using $binary as prefix\0A    set -l binary (string match -r '^.*?(?= )' $cmds[2])\0A    if test -f \22$java_bin_dir/$binary\22\0A        complete -C $cmds[2]\0A    else\0A        command ls $java_bin_dir | string match -r ^\22$binary.*\22\0A    end\0Aend\0A\0Acomplete -ec java_home\0Acomplete -xc java_home -n \22__fish_not_contain_opt -s h exec \22 -l exec\0Acomplete -xc java_home -n \22__fish_contains_opt exec \22 -a \22(__fish_complete_macos_java_home_exec)\22\0Acomplete -xc java_home -n \22__fish_not_contain_opt -s h exec \22 -s v -l version -a '(__fish_complete_macos_java_version)' -d 'Filter versions (as if JAVA_VERSION had been set in the environment).'\0Acomplete -xc java_home -n \22__fish_not_contain_opt -s h exec \22 -s a -l arch -a \22arm64 x86_64\22 -d 'Filter architecture (as if JAVA_ARCH had been set in the environment).'\0Acomplete -xc java_home -n \22__fish_not_contain_opt -s h exec \22 -s h -l help -d 'Usage information.'\0Acomplete -fc java_home -n \22__fish_not_contain_opt -s h exec \22 -s F -l failfast -d 'Fail when filters return no JVMs, do not continue with default.'\0Acomplete -fc java_home -n \22__fish_not_contain_opt -s h exec \22 -s X -l xml -d 'Print full JVM list and additional data as XML plist.'\0Acomplete -fc java_home -n \22__fish_not_contain_opt -s h exec \22 -s V -l verbose -d 'Print full JVM list with architectures.'\0A", align 1
