@anon.1d0b41a8d45d477c3029ec78f9b8b434.2900 = private unnamed_addr constant [2852 x i8] c"function __fish_winetricks__complete_verbs\0A    winetricks list-all 2>/dev/null |\0A        string match --invert --regex '^==' |\0A        string match --invert --regex '^(apps|dlls|fonts|games|settings)$' |\0A        string replace --regex '(\\S+)\\s+(.+)' '$1\\t$2'\0Aend\0A\0Aset -l command winetricks\0A\0Acomplete -c $command -f\0A\0Acomplete -c $command -s h -l help -d 'Show help'\0Acomplete -c $command -s V -l version -d 'Show version'\0A\0Acomplete -c $command -l country -f -d 'Specify the country code'\0A\0Acomplete -c $command -s f -l force \\\0A    -d \22Don't check whether packages were already installed\22\0A\0Acomplete -c $command -l gui -d 'Show gui diagnostics'\0Acomplete -c $command -l isolate -d 'Use the separate bottles for applications'\0Acomplete -c $command -l self-update -d 'Update to the latest version'\0Acomplete -c $command -l update-rollback -d 'Rollback the latest self-update'\0Acomplete -c $command -s k -l keep_isos -d 'Cache ISOs'\0Acomplete -c $command -l no-clean -d \22Don't delete temporary directories\22\0Acomplete -c $command -s q -l unattended -d \22Don't show any prompts\22\0A\0Acomplete -c $command -s r -l ddrescue \\\0A    -d 'Reattempt when caching scratched discs'\0A\0Acomplete -c $command -s t -l torify -d 'Run downloads through torify'\0Acomplete -c $command -l virefy -d 'Test verbs automaitally'\0Acomplete -c $command -s v -l verbose -d 'Show commands'\0A\0Aset -l subcommands_with_descriptions 'list\\t\22List categories\22' \\\0A    'list-all\\t\22List categories and their verbs\22' \\\0A    'apps\\t\22Interact with applications\22' \\\0A    'benchmarks\\t\22Interact with benchmarks\22' \\\0A    'dlls\\t\22Interact with DLLs\22' \\\0A    'fonts\\t\22Interact with fonts\22' \\\0A    'games\\t\22Interact with games\22' \\\0A    'settings\\t\22Interact with settings\22' \\\0A    'list-cached\\t\22Interact with list-cached\22' \\\0A    'list-download\\t\22Interact with list-download\22' \\\0A    'list-manual-download\\t\22Interact with list-manual-download\22' \\\0A    'list-installed\\t\22Interact with list-installed\22' \\\0A    'prefix\\t\22Specify the bottle\22' \\\0A    'annihilate\\t\22Clear the bottle\22'\0A\0Afor architecture in 32 64\0A    set -a subcommands_with_descriptions \22arch=$architecture\\t\\\22Specify the architecture\\\22\22\0Aend\0A\0Aset -l subcommands (string replace --regex '\\\\\\t.+' '' -- $subcommands_with_descriptions)\0Aset -l root_condition \22not __fish_seen_subcommand_from $subcommands\22\0A\0Acomplete -c $command -a \22$subcommands_with_descriptions\22 -n $root_condition\0A\0Acomplete -c $command -a list \\\0A    -d 'List applications' \\\0A    -n '__fish_seen_subcommand_from apps'\0A\0Acomplete -c $command -a list \\\0A    -d 'List DLLs' \\\0A    -n '__fish_seen_subcommand_from dlls'\0A\0Afor subcommand in benchmarks fonts games settings\0A    complete -c $command -a list \\\0A        -d 'List $subcommand' \\\0A        -n '__fish_seen_subcommand_from dlls'\0Aend\0A\0Acomplete -c $command -a '(__fish_winetricks__complete_verbs)' \\\0A    -d 'Specify the verb or path to it' \\\0A    -n $root_condition\0A", align 1
