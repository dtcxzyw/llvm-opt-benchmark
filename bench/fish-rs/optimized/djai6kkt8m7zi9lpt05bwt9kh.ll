@anon.1d0b41a8d45d477c3029ec78f9b8b434.2344 = private unnamed_addr constant [2457 x i8] c"# pkg-config\0Acomplete -f -c pkg-config -l modversion -d 'Print versions of the specified libraries'\0Acomplete -f -c pkg-config -l version -d 'Display the version of pkg-config and quit'\0Acomplete -f -c pkg-config -l help -d 'Displays a help message and quit'\0Acomplete -f -c pkg-config -l print-errors -d 'Print message when errors occur'\0Acomplete -f -c pkg-config -l silence-errors -d 'Stay quiet when errors occur'\0Acomplete -f -c pkg-config -l errors-to-stdout -d 'Print errors to stdout instead of stderr'\0Acomplete -f -c pkg-config -l debug -d 'Print debugging information'\0Acomplete -f -c pkg-config -l cflags -d 'Print pre-processor and compile flags for the specified libraries'\0Acomplete -f -c pkg-config -l cflags-only-I -d 'This prints the -I part of \22--cflags\22.'\0Acomplete -f -c pkg-config -l libs -d 'Print link flags'\0Acomplete -f -c pkg-config -l libs-only-L -d 'This prints the -L/-R part of \22--libs\22.'\0Acomplete -f -c pkg-config -l libs-only-l -d 'This prints the -l part of \22--libs\22'\0A# TODO: Something like 'pkg-config --print-variables $lib' should offer the options here - the difficulty is determining $lib\0Acomplete -f -c pkg-config -l variable -d 'This returns the value of a variable defined in a package\\'s .pc file'\0Acomplete -f -c pkg-config -l define-variable -d 'This sets a global value for a variable'\0Acomplete -f -c pkg-config -l print-variables -d 'Returns a list of all variables defined in the package'\0Acomplete -f -c pkg-config -l uninstalled -d 'Return success if any -uninstalled packages are used'\0Acomplete -f -c pkg-config -l max-version -d 'Test if a package has at most the specified version'\0Acomplete -f -c pkg-config -l atleast-version -d 'Test if a package has at least this version'\0Acomplete -f -c pkg-config -l exact-version -d 'Test if a package has exactly this version'\0Acomplete -f -c pkg-config -l exists -d 'Test if