@anon.1d0b41a8d45d477c3029ec78f9b8b434.2068 = private unnamed_addr constant [17938 x i8] c"# fish completions for mdadm, as documented under Debian Stretch (mdadm v3.4)\0A# Known lacks\C2\A0:\0A# - be more contextual\C2\A0: suggest according to available files, devices, arrays\E2\80\A6\0A# - especially, suggest values for levels, metadata format\E2\80\A6 according to the already given parameters\0A# - some descriptions are not very useful, even a bit Captain Obvious-like\0A# - some options could see their meaning in different contexts explained with different completions with proper tests for context\0A# - misc and manage modes could be tested for, and the corresponding options proposed only in the right context\0A#\0A# -n tests have been simplified when __fish_contains_opt \E2\80\A6; or _fish_not_contain_opt \E2\80\A6: the options in the first test were removed from the second one,\0A#     as their absence has already been checked, because this absence caused evaluation of __fish_not_contain_opt\0A\0Afunction __fish_mdadm_metadata_options\0A    echo -e \220\\tUse original 0.90 format superblock\22\0A    echo -e \220.90\\tUse original 0.90 format superblock\22\0A    echo -e \221\\tUse last 1.x format superblock\22\0A    echo -e \22default\\tUse last 1.x format superblock\22\0A    echo -e \221.0\\tUse 1.0 format superblock\22\0A    echo -e \221.1\\tUse 1.1 format superblock\22\0A    echo -e \221.2\\tUse 1.2 format superblock\22\0A    echo -e \22ddf\\tUse DDF (Disk Data Format) format\22\0A    echo -e \22imsm\\tUse Intel(R) Matrix Storage Manager format\22\0Aend\0A\0Afunction __fish_mdadm_level_options\0A    echo -e \22linear\\tJBOD\22\0A    echo -e \22raid0\\tStripped volume (RAID 0)\22\0A    echo -e \220\\tStripped volume (RAID 0)\22\0A    echo -e \22stripe\\tStripped volume (RAID 0)\22\0A    echo -e \22raid1\\tMirrored volume (RAID 1)\22\0A    echo -e \221\\tMirrored volume (RAID 1)\22\0A    echo -e \22mirror\\tMirrored volume (RAID 1)\22\0A    echo -e \22raid4\\tStripped volume with parity disk (RAID 4)\22\0A    echo -e \224\\tStripped volume with parity disk (RAID 4)\22\0A    echo -e \22raid5\\tStripped volume with distributed parity (RAID 5)\22\0A    echo -e \225\\tStripped volume with distributed parity (RAID 5)\22\0A    echo -e \22raid6\\tStripped volume with double distributed parity (RAID 5)\22\0A    echo -e \226\\tStripped volume with double distributed parity (RAID 5)\22\0A    echo -e \22raid10\\tMirrored stripped volume (RAID 10)\22\0A    echo -e \2210\\tMirrored stripped volume (RAID 10)\22\0A    echo -e \22multipath\\tMultiple access device, AKA multipath (deprecated)\22\0A    echo -e \22mp\\tMultiple access device, AKA multipath (deprecated)\22\0A    echo -e \22faulty\\tPseudo RAID layer for single device (akin faulty RAID 1)\22\0A    echo -e \22container\\tContainer\22 # To be clarified\0Aend\0A\0Afunction __fish_mdadm_layout_options # To be clarified\0A    echo -e left-asymmetric\0A    echo -e left-symmetric\0A    echo -e right-asymmetric\0A    echo -e right-symmetric\0A    echo -e \22la\\tAlias of left-asymmetric\22\0A    echo -e \22ra\\tAlias of right-asymmetric\22\0A    echo -e \22ls\\tAlias of left-symmetric\22\0A    echo -e \22rs\\tAlias of right-symmetric\22\0A    echo -e parity-first\0A    echo -e parity-last\0A    echo -e ddf-zero-restart\0A    echo -e ddf-N-restart\0A    echo -e ddf-N-continue\0A    echo -e left-symmetric-6\0A    echo -e right-symmetric-6\0A    echo -e left-asymmetric-6\0A    echo -e right-asymmetric-6\0A    echo -e parity-first-6\0A    echo -e write-transient\0A    echo -e \22wt\\tAlias of write-transient\22\0A    echo -e read-transient\0A    echo -e \22rt\\tAlias of read-transient\22\0A    echo -e write-persistent\0A    echo -e \22wp\\tAlias of write-persistent\22\0A    echo -e read-persistent\0A    echo -e \22rp\\tAlias of read-persistent\22\0A    echo -e write-all\0A    echo -e read-fixable\0A    echo -e \22rf\\tAlias of read-fixable\22\0A    echo -e clear\0A    echo -e flush\0A    echo -e none\0A    echo -e n\0A    echo -e o\0A    echo -e f\0A    echo -e normalise\0A    echo -e preserve\0Aend\0A\0Afunction __fish_mdadm_level_options\0A    echo -e \22yes\\tUse standard format (default)\22\0A    echo -e \22md\\tUse a non-partitionable array\22\0A    echo -e \22mdp\\tUse a partitionable array\22\0A    echo -e \22part\\tUse a partitionable array\22\0A    echo -e \22p\\tUse a partitionable array\22\0Aend\0A\0Afunction __fish_mdadm_update_options\0A    echo -e \22sparc2.2\\tRemove superblock misalignment from SPARC kernel 2.2\22\0A    echo -e \22summaries\\tCorrect superblock summaries\22\0A    echo -e \22uuid\\tUpdate array UUID\22\0A    echo -e \22name\\tUpdate array name\22\0A    echo -e \22nodes\\tUpdate array nodes\22\0A    echo -e \22homehost\\tUpdate array homehost\22\0A    echo -e \22home-cluster\\tUpdate array cluster name\22\0A    echo -e \22resync\\tMark the array as dirty, thus forcing resync\22\0A    echo -e \22byteorder\\tReverse superblock endianness\22\0A    echo -e \22devicesize\\tRefresh device size\22\0A    echo -e \22no-bitmap\\tAssume bitmap absence\22\0A    echo -e \22bbl\\tReserve space for bad block list\22\0A    echo -e \22no-bbl\\tFree reserved space for bad block list\22\0A    echo -e \22metadata\\tConvert 0.90 metadata to 1.0\22\0A    echo -e \22super-minor\\tReset preferred minor to current one\22\0Aend\0A\0Afunction __fish_mdadm_action_options\0A    echo -e \22idle\\tAbort currently running actions\22\0A    echo -e \22frozen\\tAbort currently running actions, prevent their restart\22\0A    echo -e \22check\\tScrub the array (i.e. check consistency)\22\0A    echo -e \22repair\\tCheck, then resync\22\0Aend\0A\0A# In the next 7 lines, the tested option is maintained into the search list to prevent suggesting it if it has already been used, as they cannot be used twice\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s A -l assemble -d \22Assemble a pre-existing array\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s B -l build -d \22Build a legacy array without superblocks\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s C -l create -d \22Create a new array\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s F -l follow -l monitor -d \22Select monitor mode\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s G -l grow -d \22Change the size or shape of an active array\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s I -l incremental -d \22Manage devices in array, and possibly start it\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l auto-detect -d \22Start all auto-detected arrays\22\0Acomplete -c mdadm -s h -l help -d \22Display help\22\0Acomplete -c mdadm -l help-options -d \22Display more detailed help\22\0Acomplete -c mdadm -s V -l version -d \22Print version information\22\0Acomplete -c mdadm -s v -l verbose -d \22Be more verbose\22\0Acomplete -c mdadm -s q -l quiet -d \22Be quiet\22\0Acomplete -c mdadm -s f -l force -d \22Force operation\22\0Acomplete -c mdadm -s c -l config -r -d \22Specify config file or directory\22\0Acomplete -c mdadm -s s -l scan -d \22Scan for missing information\22\0Acomplete -c mdadm -s e -l metadata -a __fish_mdadm_metadata_options -x -d \22Set metadata style to use\22\0Acomplete -c mdadm -l homehost -x -d \22Provide home host identity\22\0Acomplete -c mdadm -l prefer -x -d \22Give name format preference\22\0Acomplete -c mdadm -l home-cluster -x -d \22Give cluster name\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow; or __fish_not_contain_opt -s A assemble -s F follow monitor -s I incremental auto-detect' -s n -l raid-devices -x -d \22Specify the number of active devices\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -s x -l spare-devices -x -d \22Specify the number of spare devices\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -s z -l size -x -d \22Specify the space to use from each drive\22\0Acomplete -c mdadm -n '__fish_contains_opt -s G grow' -s Z -l array-size -x -d \22Specify the size made available on the array\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -s c -l chunk -x -d \22Specify the chunk size\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l rounding -x -d \22Specify rounding factor\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -s l -l level -a __fish_mdadm_level_options -x -d \22Specify RAID level\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -s p -l layout -l parity -a __fish_mdadm_layout_options -x -d \22Specify data layout\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s B build -s C create -s G grow' -s b -l bitmap -r -d \22Specify file for write-intent bitmap\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l bitmap-chunk -x -d \22Specify chunksize of bitmap\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow -s a add' -s W -l write-mostly -d \22Prefer reading from other devices than these\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l readwrite -d \22Enable writes on array or device\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create; or __fish_not_contain_opt -s A assemble -s F follow monitor -s G grow -s I incremental' -s o -l readonly -d \22Disable writes on array\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l write-behind -x -d \22Enable write-behind mode\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l assume-clean -d \22Assume the array is clean\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s G grow' -l backup-file -r -d \22Use this file as a backup\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l data-offset -x -d \22Specify start of array data\22\0Acomplete -c mdadm -n '__fish_contains_opt -s G grow' -l continue -d \22Resume frozen --grow command\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s B build -s C create' -s N -l name -x -d \22Set array name\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s B build -s C create -s I incremental; or __fish_not_contain_opt -s F follow monitor -s G grow' -s R -l run -d \22Run array despite warnings\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s B build -s C create' -s a -l auto -l level -a __fish_mdadm_level_options -x -d \22Give instruction for device file\22 # May be improved with device numbers management\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble -s G grow' -s a -l add -d \22Add devices to array\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l nodes -d \22Specify max nodes in the cluster\22\0Acomplete -c mdadm -n '__fish_contains_opt -s B build -s C create -s G grow' -l write-journal -d \22Specify journal device for RAID-4/5/6 array\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble' -s u -l uuid -x -d \22UUID of array to assemble\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble' -s m -l super-minor -x -d \22Minor number of array device\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble; and __fish_contains_opt -s s scan' -l no-degraded -d \22Refuse to start without all drives\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble' -l invalid-backup -d \22Do not ask for backup file, unavailable\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble' -s U -l update -a __fish_mdadm_update_options -x -d \22Update superblock properties\22\0Acomplete -c mdadm -n '__fish_contains_opt -s A assemble' -l freeze-reshape -d \22Freeze --grow command\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor; or __fish_not_contain_opt -s A assemble -s B build -s C create -s G grow -s I incremental auto-detect' -s t -l test -d \22Test mode\22 # To be clarified\0Acomplete -c mdadm -n '__fish_contains_opt -s G grow; or __fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s I incremental auto-detect' -s a -l add -d \22Hot-add listed devices\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l re-add -d \22Re-add a previously removed device\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l add-spare -d \22Hot-add listed devices as spare\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s r -l remove -d \22Remove listed inactive devices\22\0Acomplete -c mdadm -n '__fish_contains_opt -s I incremental; or __fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow auto-detect' -s f -l fail -l set-faulty -d \22Mark listed devices as faulty\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l replace -d \22Mark listed devices as requiring replacement\22\0Acomplete -c mdadm -n '__fish_contains_opt replace' -l with -d \22Give devices as replacement\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l cluster-confirm -d \22Confirm existence of device\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s Q -l query -d \22Examine device for md use\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s D -l detail -d \22Print details on array\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l detail-platform -d \22Print details on platform capabilities\22\0Acomplete -c mdadm -n '__fish_contains_opt -s I incremental; or __fish_contains_opt -s D detail; or __fish_contains_opt detail-platform; or __fish_contains_opt -s E examine' -s Y -l export -d \22Format data output as key=value pairs\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s E -l examine -d \22Print content of device metadata\22\0Acomplete -c mdadm -n '__fish_contains_opt -s E examine; or __fish_contains_opt -s A assemble' -l sparc2.2 -d \22Fix examination for buggy SPARC 2.2 kernel RAID\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s X -l examine-bitmap -d \22Print report about bitmap\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l examine-badblocks -d \22List recorded bad blocks\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l dump -r -d \22Dump metadata to directory\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l restore -r -d \22Restore metadata from directory\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s S -l stop -d \22Deactivate array\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l zero-superblock -d \22Erase possible superblock\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l kill-subarray -r -d \22Delete subarray\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l update-subarray -r -d \22Update subarray\22 # To be clarified\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -s W -l wait -d \22Wait for pending operations\22\0Acomplete -c mdadm -l wait-clean -d \22Mark array as clean ASAP\22\0Acomplete -c mdadm -n '__fish_not_contain_opt -s A assemble -s B build -s C create -s F follow monitor -s G grow -s I incremental auto-detect' -l action -a __fish_mdadm_action_options -x -d \22Set sync action for md devices\22\0Acomplete -c mdadm -n '__fish_contains_opt -s I incremental' -s r -l rebuild-map -d \22Rebuild /run/mdadm/map\22\0Acomplete -c mdadm -n '__fish_contains_opt -s I incremental; and __fish_contains_opt -s f fail set-faulty' -l path -r -d \22Automatically add eventually appearing device to array\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s m -l mail -x -d \22Mail address to send alerts to\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s p -l program -l alert -x -d \22Program to run in case of an event\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s y -l syslog -d \22Record events in syslog\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s d -l delay -x -d \22Polling interval\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s r -l increment -x -d \22Generate RebuildNN events each given percentage\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s f -l daemonise -d \22Run monitor mode as a daemon\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor; and __fish_contains_opt -s 1 oneshot' -s i -l pid-file -r -d \22Write PID file when running as a daemon\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -s 1 -l oneshot -d \22Check arrays only once\22\0Acomplete -c mdadm -n '__fish_contains_opt -s F follow monitor' -l no-sharing -d \22Do not move spares between arrays\22\0Acomplete -c mdadm -n '__fish_contains_opt -s D detail; or __fish_contains_opt -s E examine' -s b -l brief -d \22Be more concise\22\0A", align 1
