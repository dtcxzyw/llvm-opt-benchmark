@anon.1d0b41a8d45d477c3029ec78f9b8b434.2490 = private unnamed_addr constant [4098 x i8] c"# resolvectl (systemd 256)\0A\0Afunction __resolvectl_interfaces\0A    resolvectl status | string replace -fr '^Link\\s+\\d+\\s+\\((.*)\\)$' '$1'\0Aend\0A\0Afunction __resolvectl_protocols\0A    resolvectl --protocol help | string match -rv ':$'\0Aend\0A\0Afunction __resolvectl_types\0A    resolvectl --type help | string match -rv ':$'\0Aend\0A\0Afunction __resolvectl_classes\0A    resolvectl --class help | string match -rv ':$'\0Aend\0A\0Afunction __resolvectl_commands\0A    printf \22%b\\n\22 \\\0A        \22query\\tResolve domain names or IP addresses\22 \\\0A        \22service\\tResolve service records\22 \\\0A        \22openpgp\\tQuery PGP keys for email\22 \\\0A        \22tlsa\\tQuery TLS public keys\22 \\\0A        \22status\\tShow current DNS settings\22 \\\0A        \22statistics\\tShow resolver statistics\22 \\\0A        \22reset-statistics\\tReset statistics counters\22 \\\0A        \22flush-caches\\tFlush all local DNS caches\22 \\\0A        \22reset-server-features\\tForget learnt DNS server feature levels\22 \\\0A        \22monitor\\tMonitor DNS queries\22 \\\0A        \22show-cache\\tShow cache contents\22 \\\0A        \22show-server-state\\tShow server state\22 \\\0A        \22dns\\tSet per-interface DNS servers\22 \\\0A        \22domain\\tSet per-interface search or routing domains\22 \\\0A        \22default-route\\tSet per-interface default route flag\22 \\\0A        \22llmnr\\tSet per-interface LLMNR settings\22 \\\0A        \22mdns\\tSet per-interface MulticastDNS settings\22 \\\0A        \22dnsovertls\\tSet per-interface DNS-over-TLS settings\22 \\\0A        \22dnssec\\tSet per-interface DNSSEC mode\22 \\\0A        \22nta\\tSet per-interface DNSSEC NTA\22 \\\0A        \22revert\\tRevert per-interface DNS configuration\22 \\\0A        \22log-level\\tSet the log-level\22\0Aend\0A\0A# variables\0Aset -l seen __fish_seen_subcommand_from\0Aset -l commands (__resolvectl_commands | string split -f 1 '\\t')\0A\0A# commands\0Acomplete -c resolvectl -f\0Acomplete -c resolvectl -n \22not $seen $commands\22 -xa \22(__resolvectl_commands)\22\0Acomplete -c resolvectl -n \22__fish_is_nth_token 2\22 -n \22$seen status dns domain default-route llmnr mdns dnssec dnsovertls nta revert\22 -xa \22(__resolvectl_interfaces)\22\0A\0A# global options\0Acomplete -c resolvectl -s 4 -d \22Resolve only IPv4\22\0Acomplete -c resolvectl -s 6 -d \22Resolve only IPv6\22\0Acomplete -c resolvectl -l interface -s i -xa \22(__resolvectl_interfaces)\22 -d \22Interface to execute the query on\22\0Acomplete -c resolvectl -l protocol -s p -xa \22(__resolvectl_protocols)\22 -d \22Network protocol for the query\22\0Acomplete -c resolvectl -l type -s t -xa \22(__resolvectl_types)\22 -d \22DNS RR type for query\22\0Acomplete -c resolvectl -l class -s c -xa \22(__resolvectl_classes)\22 -d \22DNS class for query\22\0Acomplete -c resolvectl -l service-address -xa \22true false\22 -d \22Resolve address for SRV record\22\0Acomplete -c resolvectl -l service-txt -xa \22true false\22 -d \22Resolve TXT records for services\22\0Acomplete -c resolvectl -l cname -xa \22true false\22 -d \22Follow CNAME redirects\22\0Acomplete -c resolvectl -l validate -xa \22true false\22 -d \22Allow DNSSEC validation\22\0Acomplete -c resolvectl -l synthesize -xa \22true false\22 -d \22Allow synthetic response\22\0Acomplete -c resolvectl -l cache -xa \22true false\22 -d \22Allow response from cache\22\0Acomplete -c resolvectl -l stale-data -xa \22true false\22 -d \22Allow response from cache with stale data\22\0Acomplete -c resolvectl -l relax-single-label -xa \22true false\22 -d \22Allow single label lookups to go upstream\22\0Acomplete -c resolvectl -l zone -xa \22true false\22 -d \22Allow response from locally registered mDNS/LLMNR records\22\0Acomplete -c resolvectl -l trust-anchor -xa \22true false\22 -d \22Use local trust anchors\22\0Acomplete -c resolvectl -l network -xa \22true false\22 -d \22Allow response from network\22\0Acomplete -c resolvectl -l search -xa \22true false\22 -d \22Use search domains for single-label names\22\0Acomplete -c resolvectl -l raw -xa \22payload packet\22 -d \22Dump answer as binary data\22\0Acomplete -c resolvectl -l legend -xa \22true false\22 -d \22Print headers and meta info\22\0Acomplete -c resolvectl -l json -xa \22short pretty off\22 -d \22Output as JSON in specified mode\22\0Acomplete -c resolvectl -s j -d \22Output as JSON\22\0Acomplete -c resolvectl -l help -s h -d \22Show help\22\0Acomplete -c resolvectl -l version -d \22Show version\22\0Acomplete -c resolvectl -l no-pager -d \22Do not pipe output into a pager\22\0A", align 1
