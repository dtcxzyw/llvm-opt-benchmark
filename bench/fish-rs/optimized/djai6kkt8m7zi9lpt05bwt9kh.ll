@anon.1d0b41a8d45d477c3029ec78f9b8b434.3073 = private unnamed_addr constant [32 x i8] c"functions/__fish_any_arg_in.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3074 = private unnamed_addr constant [233 x i8] c"# returns 0 only if any argument is on of the supplied arguments\0Afunction __fish_any_arg_in\0A    set -l haystack $argv\0A    for arg in (commandline -xpc)\0A        contains -- $arg $haystack\0A        and return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3075 = private unnamed_addr constant [31 x i8] c"functions/__fish_anyeditor.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3076 = private unnamed_addr constant [499 x i8] c"function __fish_anyeditor --description \22Print a editor to use, or an error message\22\0A    set -l editor\0A    if set -q VISUAL\0A        echo $VISUAL | read -at editor\0A    else if set -q EDITOR\0A        echo $EDITOR | read -at editor\0A    else\0A        __fish_echo string join \\n -- \\\0A            (_ 'External editor requested but $VISUAL or $EDITOR not set.') \\\0A            (_ 'Please set VISUAL or EDITOR to your preferred editor.')\0A        return 1\0A    end\0A    string join \\n -- $editor\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3077 = private unnamed_addr constant [30 x i8] c"functions/__fish_anypager.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3078 = private unnamed_addr constant [743 x i8] c"function __fish_anypager --description \22Print a pager to use\22\0A    set -l pager\0A    # We prefer $PAGER if we have it\0A    set -q PAGER\0A    and echo $PAGER | read -at pager\0A\0A    # or even $MANPAGER if we're allowed to\0A    if test \22$argv[1]\22 = --with-manpager\0A        set -q MANPAGER\0A        and echo $MANPAGER | read -at pager\0A    end\0A\0A    # We use them if they *exist*\0A    if command -q $pager[1]\0A        printf %s\\n $pager\0A        return 0\0A    end\0A\0A    # Cheesy hardcoded list of pagers.\0A    for cmd in less lv most more\0A        if command -q $cmd\0A            echo -- $cmd\0A            return 0\0A        end\0A    end\0A\0A    # We have no pager.\0A    # We could fall back to \22cat\22,\0A    # but in some cases that's probably not helpful.\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3079 = private unnamed_addr constant [31 x i8] c"functions/__fish_anypython.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3080 = private unnamed_addr constant [732 x i8] c"function __fish_anypython\0A    # Try python3 first, because that's usually faster and generally nicer.\0A    # Do not consider the stub /usr/bin/python3 that comes installed on Darwin to be Python\0A    # unless Xcode reports a real directory path.\0A    for py in python3 python3.{12,11,10,9,8,7,6,5,4,3} python2 python2.7 python\0A        if set -l py_path (command -s $py)\0A            if string match -q /usr/bin/python3 -- $py_path\0A                and string match -q Darwin -- \22$(uname)\22\0A                and type -q xcode-select\0A                and not xcode-select --print-path &>/dev/null\0A                continue\0A            end\0A            echo $py\0A            return 0\0A        end\0A    end\0A    # We have no python.\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3081 = private unnamed_addr constant [28 x i8] c"functions/__fish_append.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3082 = private unnamed_addr constant [283 x i8] c"function __fish_append -d \22Internal completion function for appending string to the commandline\22 --argument-names sep\0A    set -e argv[1]\0A    set -l str (commandline -tc | string replace -rf \22(.*$sep)[^$sep]*\22 '$1' | string replace -r -- '--.*=' '')\0A    printf \22%s\\n\22 \22$str\22$argv\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3083 = private unnamed_addr constant [29 x i8] c"functions/__fish_apropos.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3084 = private unnamed_addr constant [1686 x i8] c"if not type -q apropos\0A    function __fish_apropos\0A    end\0A    exit\0Aend\0A\0A# Check for macOS Catalina or above.\0Aif test (__fish_uname) = Darwin\0A    and test (string match -r \22^\\d+\22 \22$(uname -r)\22) -ge 19\0A    and test -x /usr/libexec/makewhatis\0A\0A    set -l dir\0A    if test -n \22$XDG_CACHE_HOME\22\0A        set dir $XDG_CACHE_HOME/fish\0A    else\0A        set dir (getconf DARWIN_USER_CACHE_DIR)\22fish\22\0A    end\0A\0A    function __fish_apropos -V dir\0A        # macOS 10.15 \22Catalina\22 has a read only filesystem where the whatis database should be.\0A        # The whatis database is non-existent, so apropos tries (and fails) to create it every time,\0A        # which can take seconds.\0A        #\0A        # Instead, we build a whatis database in the user cache directory\0A        # and override the MANPATH using that directory before we run `apropos`\0A        #\0A        # the cache is rebuilt once a week.\0A        set -l whatis $dir/whatis\0A        set -l max_age 600000 # like a week\0A        set -l age $max_age\0A\0A        if test -f \22$whatis\22\0A            set age (path mtime -R -- $whatis)\0A        end\0A\0A        MANPATH=\22$dir\22 MANPAGER=cat WHATISPAGER=cat apropos \22$argv\22\0A\0A        if test $age -ge $max_age\0A            test -d \22$dir\22 || mkdir -m 700 -p $dir\0A            /bin/sh -c '( \22$@\22 ) >/dev/null 2>&1 </dev/null &' -- /usr/libexec/makewhatis -o \22$whatis\22 (/usr/bin/manpath | string split : | xargs realpath)\0A        end\0A    end\0Aelse\0A    function __fish_apropos\0A        # we only ever prefix match for completions. This also ensures results for bare apropos <TAB>\0A        # (apropos '' gives no results, but apropos '^' lists all manpages)\0A        MANPAGER=cat WHATISPAGER=cat apropos \22$argv\22\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3085 = private unnamed_addr constant [42 x i8] c"functions/__fish_argcomplete_complete.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3086 = private unnamed_addr constant [329 x i8] c"function __fish_argcomplete_complete\0A    set -lx _ARGCOMPLETE 1\0A    set -lx _ARGCOMPLETE_IFS \\n\0A    set -lx _ARGCOMPLETE_SUPPRESS_SPACE 1\0A    set -lx _ARGCOMPLETE_SHELL fish\0A    set -lx COMP_LINE (commandline -pc)\0A    set -lx COMP_POINT (string length (commandline -cp))\0A    set -lx COMP_TYPE\0A    $argv 8>&1 9>&2 2>/dev/null\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3087 = private unnamed_addr constant [31 x i8] c"functions/__fish_cache_put.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3088 = private unnamed_addr constant [304 x i8] c"function __fish_cache_put\0A    set -l cache_file $argv[1]\0A    touch $cache_file\0A    set -l dir (path dirname $cache_file)\0A    chown --reference=$dir $cache_file 2>/dev/null ||\0A        chown (\0A            stat --format '%u:%g' $dir 2>/dev/null ||\0A            stat -f '%u:%g' $dir\0A        ) $cache_file\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3089 = private unnamed_addr constant [47 x i8] c"functions/__fish_cache_sourced_completions.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3090 = private unnamed_addr constant [1278 x i8] c"function __fish_cache_sourced_completions\0A    # Allow a `--name=foo` option which ends up in the filename.\0A    argparse -s name= -- $argv\0A    or return\0A\0A    set -q argv[1]\0A    or return 1\0A\0A    set -l cmd (command -s $argv[1])\0A    or begin\0A        # If we have no command, we can't get an mtime\0A        # and so we can't cache\0A        # The caller can more easily retry\0A        return 127\0A    end\0A\0A    set -l cachedir (__fish_make_cache_dir completions)\0A    or return\0A\0A    set -l stampfile $cachedir/$argv[1].stamp\0A    set -l compfile $cachedir/$argv[1].fish\0A\0A    set -l mtime (path mtime -- $cmd)\0A\0A    set -l cmtime 0\0A    path is -rf -- $stampfile\0A    and read cmtime <$stampfile\0A\0A    # If either the timestamp or the completion file don't exist,\0A    # or the mtime differs, we rerun.\0A    #\0A    # That means we'll rerun if the command was up- or downgraded.\0A    if path is -vrf -- $stampfile $compfile || test \22$cmtime\22 -ne \22$mtime\22 2>/dev/null\0A        __fish_cache_put $compfile\0A        $argv >$compfile\0A        # If the command exited unsuccessfully, we assume it didn't work.\0A        or return 2\0A        __fish_cache_put $stampfile\0A        echo -- $mtime >$stampfile\0A    end\0A\0A    if path is -rf -- $compfile\0A        source $compfile\0A        return 0\0A    end\0A    return 3\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3091 = private unnamed_addr constant [40 x i8] c"functions/__fish_cancel_commandline.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3092 = private unnamed_addr constant [130 x i8] c"# This is meant to be bound to something like ctrl-c\0Afunction __fish_cancel_commandline\0A    commandline -f cancel-commandline\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3093 = private unnamed_addr constant [41 x i8] c"functions/__fish_change_key_bindings.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3094 = private unnamed_addr constant [807 x i8] c"function __fish_change_key_bindings --argument-names bindings\0A    set -g __fish_active_key_bindings $bindings\0A    # Allow the user to set the variable universally\0A    set -l scope\0A    set -q fish_key_bindings\0A    or set scope -g\0A    # We try to use `set --no-event`, but to avoid leaving the user without bindings\0A    # if they run this with an older version we fall back on setting the variable\0A    # with an event.\0A    if ! set --no-event $scope fish_key_bindings $bindings 2>/dev/null\0A        # This triggers the handler, which calls us again\0A        set $scope fish_key_bindings $bindings\0A        # unless the handler somehow doesn't exist, which would leave us without bindings.\0A        # this happens in no-config mode.\0A        functions -q __fish_reload_key_bindings\0A        and return 1\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3095 = private unnamed_addr constant [40 x i8] c"functions/__fish_cmd__complete_args.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3096 = private unnamed_addr constant [1012 x i8] c"function __fish_cmd__complete_args -d 'Function to generate args'\0A    set -l current_token (commandline -tc)\0A\0A    switch $current_token\0A        case '/t:*'\0A            echo -e '0\\tBlack\0A1\\tBlue\0A2\\tGreen\0A3\\tAqua\0A4\\tRed\0A5\\tPurple\0A6\\tYellow\0A7\\tWhite\0A8\\tGray\0A9\\tLight blue\0AA\\tLight green\0AB\\tLight aqua\0AC\\tLight red\0AD\\tLight purple\0AE\\tLight yellow\0AF\\tBright white' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A        case '/e:*'\0A            echo -e 'on\\tEnable command extensions\0Aoff\\tDisable command extensions' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A        case '/f:*'\0A            echo -e 'on\\tEnable file and directory name completion\0Aoff\\tDisable file and directory name completion' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A        case '/v:*'\0A            echo -e 'on\\tEnable delayed environment variable expansion\0Aoff\\tDisable delayed environment variable expansion' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3097 = private unnamed_addr constant [49 x i8] c"functions/__fish_commandline_is_singlequoted.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3098 = private unnamed_addr constant [354 x i8] c"# TODO: This function is deprecated. It was used in fish_clipboard_paste\0A# which some users copied, so maybe leave it around for a few years.\0Afunction __fish_commandline_is_singlequoted --description \22Return 0 if the current token has an open single-quote\22\0A    string match -q 'single*' (__fish_tokenizer_state -- (commandline -ct | string collect))\0Aend\0A", align 1
