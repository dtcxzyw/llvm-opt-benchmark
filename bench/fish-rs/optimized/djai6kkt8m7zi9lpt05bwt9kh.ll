@anon.1d0b41a8d45d477c3029ec78f9b8b434.1228 = private unnamed_addr constant [11328 x i8] c"function __blender_player -d 'Check if -a option has been used, to run animation player'\0A    return (__fish_contains_opt -s a; and not __fish_contains_opt -s b background)\0Aend\0A\0Afunction __blender_echo_input_file_name\0A    # Find last argument ending in .blend (or .blend1, etc.)\0A    # This is because a Blender invocation can open multiple blend file\0A    # sequentially, so we need to find the last one up to this point.\0A    set -l path (commandline -pxc |\0A        string match -r '.*\\\\.blend[0-9]*$' |\0A        tail --lines=1)\0A    echo $path\0Aend\0A\0Afunction __blender_list_scenes\0A    blender --background (__blender_echo_input_file_name) --python-expr 'import bpy\0Afor scene in bpy.data.scenes:\0A    print(f\22\\t{scene.name}\22)' 2>/dev/null |\0A        string replace -r -f '^\\t' ''\0Aend\0A\0Afunction __blender_list_texts\0A    blender --background (__blender_echo_input_file_name) --python-expr 'import bpy\0Afor text in bpy.data.texts:\0A    print(f\22\\t{text.name}\22)' 2>/dev/null |\0A        string replace -r -f '^\\t' ''\0Aend\0A\0Afunction __blender_list_engines\0A    blender --background --engine help 2>/dev/null | string replace -r -f '^\\t' ''\0Aend\0A\0Afunction __blender_list_addons\0A    blender --background --python-expr 'import addon_utils\0Afor mod in addon_utils.modules():\0A    print(f\22\\t{mod.__name__}\22)' 2>/dev/null |\0A        string replace -r -f '^\\t' ''\0Aend\0A\0Acomplete -c blender -n 'not __blender_player' -o h -l help -d 'Show help'\0Acomplete -c blender -n 'not __blender_player' -o v -l version -d 'Show version'\0A\0A# Render Options:\0Acomplete -c blender -n 'not __blender_player' -o b -l background -d 'Hide UI'\0Acomplete -c blender -n 'not __blender_player' -o a -l render-anim -d 'Render animation'\0Acomplete -c blender -n 'not __blender_player; and test -e (__blender_echo_input_file_name)' -o S -l scene -a '(__blender_list_scenes)' -d 'Specify scene' -x\0Acomplete -c blender -n 'not __blender_player' -o f -l render-frame -d 'Render specified frame(s)' -x\0A\0Acomplete -c blender -n 'not __blender_player' -o s -l frame-start -d 'Specify start frame' -x\0Acomplete -c blender -n 'not __blender_player' -o e -l frame-end -d 'Specify end frame' -x\0Acomplete -c blender -n 'not __blender_player' -o j -l frame-jump -d 'Skip frame count' -x\0Acomplete -c blender -n 'not __blender_player' -o o -l render-output -d 'Specify render output' -r\0Acomplete -c blender -n 'not __blender_player' -o E -l engine -a '(__blender_list_engines)' -d 'Render engine' -x\0Acomplete -c blender -n 'not __blender_player' -o t -l threads -d 'Specify thread count'\0A\0A# Format Options:\0Acomplete -c blender -n 'not __blender_player' -o F -l render-format -a 'TGA\\tTarga\0ARAWTGA\\tTarga\\ Raw\0AJPEG\\tJPEG\0AIRIS\\tIRIS\0AAVIRAW\\tAVI\\ Raw\0AAVIJPEG\\tAVI\\ with\\ JPEG\\ codec\0APNG\\tPNG\0ABMP\\tBMP\0AHDR\\tHDR\0ATIFF\\tTIFF\0AOPEN_EXR\\tOpenEXR\0AOPEN_EXR_MULTILAYER\\tOpenEXR\\ Multilayer\0AFFMPEG\\tFFmpeg\\ Video\0ACINEON\\tCineon\0ADPX\\tDPX\0AJP2\\tJPEG\\ 2000\0AWEBP\\tWebP' -d 'Specify render format' -x\0Acomplete -c blender -n 'not __blender_player' -o x -l use-extension -a '0\\tfalse\0A1\\ttrue' -d 'Whether to add a file extension to an end of a file' -x\0A\0A# Animation Playback Options:\0Acomplete -c blender -n 'not __blender_player' -o a -d 'Run as animation player'\0A\0Acomplete -c blender -n __blender_player -o p -x -d 'Specify position and size'\0Acomplete -c blender -n __blender_player -o m -d 'Read from disk (do not buffer)'\0Acomplete -c blender -n __blender_player -o f -x -d 'Specify FPS to start with'\0Acomplete -c blender -n __blender_player -o j -x -d 'Specify frame step'\0Acomplete -c blender -n __blender_player -o s -x -d 'Specify start frame'\0Acomplete -c blender -n __blender_player -o e -x -d 'Specify end frame'\0Acomplete -c blender -n __blender_player -o c -x -d 'Memory in MB for cache'\0A\0A# Window Options:\0Acomplete -c blender -n 'not __blender_player' -o w -l window-border -d 'Show window borders'\0Acomplete -c blender -n 'not __blender_player' -o W -l window-fullscreen -d 'Show in fullscreen'\0Acomplete -c blender -n 'not __blender_player' -o p -l window-geometry -d 'Specify position and size' -x\0Acomplete -c blender -n 'not __blender_player' -o M -l window-maximized -d 'Maximize window'\0Acomplete -c blender -n 'not __blender_player' -o con -l start-console -d 'Open console'\0Acomplete -c blender -n 'not __blender_player' -l no-native-pixels -d 'Do not use native pixel size'\0Acomplete -c blender -n 'not __blender_player' -l no-window-focus -d 'Open unfocused'\0A\0A# Python Options:\0Acomplete -c blender -n 'not __blender_player' -o y -l enable-autoexec -d 'Enable Python scripts automatic execution'\0Acomplete -c blender -n 'not __blender_player' -o Y -l disable-autoexec -d 'Disable Python scripts automatic execution'\0A\0Acomplete -c blender -n 'not __blender_player' -o P -l python -d 'Specify Python script' -r\0Acomplete -c blender -n 'not __blender_player; and test -e (__blender_echo_input_file_name)' -l python-text -a '(__blender_list_texts)' -d 'Specify Python text block' -x\0Acomplete -c blender -n 'not __blender_player' -l python-expr -d 'Specify Python expression' -x\0Acomplete -c blender -n 'not __blender_player' -l python-console -d 'Open interactive console'\0Acomplete -c blender -n 'not __blender_player' -l python-exit-code -d 'Specify Python exit code on exception'\0Acomplete -c blender -n 'not __blender_player' -l python-use-system-env -d 'Use system env vars and user site-packages'\0Acomplete -c blender -n 'not __blender_player' -l addons -a '(__fish_append , (__blender_list_addons))' -d 'Specify addons' -x\0A\0A# Logging Options:\0Acomplete -c blender -n 'not __blender_player' -l log -d 'Enable logging categories' -x\0Acomplete -c blender -n 'not __blender_player' -l log-level -d 'Specify log level' -x\0Acomplete -c ble