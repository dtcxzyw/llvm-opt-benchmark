@anon.1d0b41a8d45d477c3029ec78f9b8b434.2838 = private unnamed_addr constant [8729 x i8] c"# Completions for the Visual Basic Compiler(Roslyn)\0A# See: https://docs.microsoft.com/en-us/dotnet/visual-basic/reference/command-line-compiler/compiler-options-listed-by-category\0A\0A# Compiler output\0Acomplete -c vbc -o nologo -d \22Suppresses compiler banner information\22\0Acomplete -c vbc -o utf8output -o \22utf8output+\22 -d \22Displays compiler output using UTF-8 encoding\22\0Acomplete -c vbc -o utf8output- -d \22Disable -utf8output\22\0Acomplete -c vbc -o verbose -o \22verbose+\22 -d \22Outputs extra information during compilation\22\0Acomplete -c vbc -o verbose- -d \22Disable -verbose\22\0Acomplete -c vbc -o \22modulename:\22 -d \22Specify the name of the source module\22\0Acomplete -c vbc -o \22preferreduilang:\22 -d \22Specify a language for compiler output\22\0A\0A# Optimization\0Afor bytes in 512 1024 2048 4096 8192\0A    complete -c vbc -o \22filealign:$bytes\22 -d \22Specifies where to align the sections of the output file\22\0Aend\0A\0Acomplete -c vbc -o optimize -o \22optimize+\22 -d \22Enable optimizations\22\0Acomplete -c vbc -o optimize- -d \22Disable optimizations\22\0A\0A# Output files\0Acomplete -c vbc -o doc -o \22doc:\22 -o \22doc+\22 -d \22Process documentation comments to an XML file\22\0Acomplete -c vbc -o doc- -d \22Disable -doc\22\0Acomplete -c vbc -o deterministic -d \22Output identical assemblies for identical inputs\22\0Acomplete -c vbc -o netcf -d \22Sets the compiler to target the .NET Compact Framework\22\0Acomplete -c vbc -o \22out:\22 -d \22Specifies an output file\22\0Acomplete -c vbc -o refonly -d \22Outputs only a reference assembly\22\0Acomplete -c vbc -o \22refout:\22 -d \22Specifies the output path of a reference assembly\22\0Acomplete -c vbc -o \22t:exe\22 -o \22target:exe\22 -d \22Create a console application\22\0Acomplete -c vbc -o \22t:library\22 -o \22target:library\22 -d \22Create a dynamic-link library\22\0Acomplete -c vbc -o \22t:module\22 -o \22target:module\22 -d \22Create a module that can be added to an assembly\22\0Acomplete -c vbc -o \22t:winexe\22 -o \22target:winexe\22 -d \22Create Windows application\22\0Acomplete -c vbc -o \22t:appcontainerexe\22 -o \22target:appcontainerexe\22 -d \22Create Windows application that must be run in an app container\22\0Acomplete -c vbc -o \22t:winmdobj\22 -o \22target:winmdobj\22 -d \22Create an intermediate file that can be converted to .winmd file\22\0A\0A# .NET assemblies\0Acomplete -c vbc -o \22addmodule:\22 -d \22Add type information from provided files to the project\22\0Acomplete -c vbc -o delaysign -o \22delaysign+\22 -d \22Specifies whether the assembly will be fully or partially signed\22\0Acomplete -c vbc -o delaysign- -d \22Disable -delaysign\22\0Acomplete -c vbc -o \22imports:\22 -d \22Imports a namespace from a specified assembly\22\0Acomplete -c vbc -o \22keycontainer:\22 -d \22Specify a strong name key container\22\0Acomplete -c vbc -o \22keyfile:\22 -d \22Specify a strong name key file\22\0Acomplete -c vbc -o \22libpath:\22 -d \22Specifies the location of assemblies referenced by the -reference option\22\0Acomplete -c vbc -o \22r:\22 -o \22reference:\22 -d \22Imports metadata from an assembly\22\0Acomplete -c vbc -o \22moduleassemblyname:\22 -d \22Specifies the name of the assembly that a module will be a part of\22\0Acomplete -c vbc -o \22a:\22 -o \22analyzer:\22 -d \22Run the analyzers from this assembly\22\0Acomplete -c vbc -o \22additionalfile:\22 -d \22Files that analyzers can use to generate error or warning\22\0A\0A# Debugging/error checking\0Acomplete -c vbc -o \22bugreport:\22 -d \22Creates a file that contains information that makes it easy to report a bug\22\0A\0Acomplete -c vbc -o debug -o \22debug+\22 -d \22Produces debugging information\22\0Afor arguments in full pdbonly\0A    complete -c vbc -o \22debug:$arguments\22 -d \22Produces debugging information\22\0Aend\0Acomplete -c vbc -o debug- -d \22Disable -debug\22\0A\0Acomplete -c vbc -o nowarn -o \22nowarn:\22 -d \22Suppresses the compiler's ability to generate warnings\22\0Acomplete -c vbc -o quiet -d \22Don't display code for syntax-related errors and warnings\22\0Acomplete -c vbc -o removeintchecks -o \22removeintchecks+\22 -d \22Disables integer overflow checking\22\0Acomplete -c vbc -o removeintchecks- -d \22Disable -removeintchecks\22\0Acomplete -c vbc -o warnaserror -o \22warnaserror:\22 -o \22warnaserror+\22 -o \22warnaserror+:\22 -d \22Promotes warnings to errors\22\0Acomplete -c vbc -o warnaserror- -o \22warnaserror-:\22 -d \22Disable -warnaserror\22\0Acomplete -c vbc -o \22ruleset:\22 -d \22Specify a ruleset file that disables specific diagnostics\22\0A\0A# Help\0Acomplete -c vbc -s \22?\22 -o help -d \22Displays the compiler options\22\0A\0A# Language\0Acomplete -c vbc -o \22langversion:?\22 -d \22Display the allowed values for language version\22\0Acomplete -c vbc -o \22langversion:default\22 -d \22Specify latest major version as language version\22\0Acomplete -c vbc -o \22langversion:latest\22 -d \22Specify latest version (including minor releases) as language version\22\0Afor version_number in (seq 9 15)\0A    switch $version_number\0A        case (seq 9 12) 14\0A            complete -c vbc -o \22langversion:$version_number\22 -d \22Specify $version_number as language version\22\0A            complete -c vbc -o \22langversion:$version_number.0\22 -d \22Specify $version_number.0 as language version\22\0A        case 15\0A            complete -c vbc -o \22langversion:$version_number\22 -d \22Specify $version_number as language version\22\0A            complete -c vbc -o \22langversion:$version_number.0\22 -d \22Specify $version_number.0 as language version\22\0A            complete -c vbc -o \22langversion:$version_number.3\22 -d \22Specify $version_number.3 as language version\22\0A            complete -c vbc -o \22langversion:$version_number.5\22 -d \22Specify $version_number.5 as language version\22\0A    end\0Aend\0A\0Acomplete -c vbc -o optionexplicit -o \22optionexplicit+\22 -d \22Enforces explicit declaration of variables\22\0Acomplete -c vbc -o optionexplicit- -d \22Disable -optionexplicit\22\0Acomplete -c vbc -o optionstrict -o \22optionstrict+\22 -o \22optionstrict:\22 -d \22Enforces strict type semantics\22\0Acomplete -c vbc -o optionstrict- -d \22Disable -optionstrict\22\0A\0Afor arguments in binary text\0A    complete -c vbc -o \22optioncompare:$arguments\22 -d \22Specify string comparison mode: text or binary\22\0Aend\0A\0Acomplete -c vbc -o optioninfer -o \22optioninfer+\22 -d \22Enables the use of local type inference in variable declarations\22\0Acomplete -c vbc -o optioninfer- -d \22Disable -optioninfer\22\0A\0A# Preprocessor\0Acomplete -c vbc -o \22d:\22 -o \22define:\22 -d \22Defines symbols for conditional compilation\22\0A\0A# Resources\0Acomplete -c vbc -o \22linkres:\22 -o \22linkresource:\22 -d \22Creates a link to a managed resource\22\0Acomplete -c vbc -o \22res:\22 -o \22resource:\22 -d \22Embeds a managed resource in an assembly\22\0Acomplete -c vbc -o \22win32icon:\22 -d \22Inserts an .ico file into the output file\22\0Acomplete -c vbc -o \22win32resource:\22 -d \22Inserts a Win32 resource into the output file\22\0A\0A# Miscellaneous\0Acomplete -c vbc -o \22baseaddress:\22 -d \22Specifies the base address of a DLL\22\0Acomplete -c vbc -o \22codepage:\22 -d \22Specify the code page for source code files\22\0A\0Afor arguments in prompt queue send none\0A    complete -c vbc -o \22errorreport:$arguments\22 -d \22Specify how to report internal compiler errors\22\0Aend\0A\0Acomplete -c vbc -o highentropyva -o \22highentropyva+\22 -d \22Specify if an executable supports high entropy ASLR\22\0Acomplete -c vbc -o highentropyva- -d \22Disable -highentropyva\22\0Acomplete -c vbc -o \22m:\22 -o \22main:\22 -d \22Specifies the class that contains the Sub Main procedure to use at startup\22\0Acomplete -c vbc -o noconfig -d \22Do not compile with Vbc.rsp\22\0Acomplete -c vbc -o nostdlib -d \22Causes the compiler not to reference the standard libraries\22\0Acomplete -c vbc -o nowin32manifest -d \22Don't embed any application manifest into the executable\22\0Acomplete -c vbc -o \22platform:x86\22 -d \22Specify x86 as target platform\22\0Acomplete -c vbc -o \22platform:x64\22 -d \22Specify AMD64 or EM64T as target platform\22\0Acomplete -c vbc -o \22platform:Itanium\22 -d \22Specify Itanium as target platform\22\0Acomplete -c vbc -o \22platform:arm\22 -d \22Specify ARM as target platform\22\0Acomplete -c vbc -o \22platform:anycpu\22 -d \22Specify any platform as target\22\0Acomplete -c vbc -o \22platform:anycpu32bitpreferred\22 -d \22Specify any platform as target (32-bit process on 64-bit machine)\22\0Acomplete -c vbc -o \22recurse:\22 -d \22Searches subdirectories for source files to compile\22\0Acomplete -c vbc -o \22rootnamespace:\22 -d \22Specifies a namespace for all type declarations\22\0Acomplete -c vbc -o \22sdkpath:\22 -d \22Specifies the location of Mscorlib.dll and Microsoft.VisualBasic.dll\22\0A\0Acomplete -c vbc -o \22vbruntime:\22 -d \22Specify reference to VB Runtime Library or disable library referencing\22\0Afor arguments in - + \22*\22\0A    complete -c vbc -o \22vbruntime:$arguments\22 -d \22Specify reference to VB Runtime Library or disable library referencing\22\0Aend\0A\0Acomplete -c vbc -o \22win32manifest:\22 -d \22Provide application manifest file\22\0Acomplete -c vbc -o parallel -o \22parallel+\22 -d \22Specifies whether to use concurrent build\22\0Acomplete -c vbc -o parallel- -d \22Disable -parallel\22\0Acomplete -c vbc -o \22checksumalgorithm:SHA1\22 -d \22Use SHA1 to calculate the source file checksum\22\0Acomplete -c vbc -o \22checksumalgorithm:SHA256\22 -d \22Use SHA256 to calculate the source file checksum\22\0A", align 1
