@anon.1d0b41a8d45d477c3029ec78f9b8b434.2918 = private unnamed_addr constant [1111 x i8] c"# xbps-alternatives\0A# Author: Allen Sobot <chilledfrogs@disroot.org>\0A\0Aset -l progname xbps-alternatives\0A\0Aset -l listinstalled \22(__fish_print_xbps_packages -i)\22\0A\0Acomplete -c $progname -f\0Acomplete -c $progname -a \22$listinstalled\22\0A\0Acomplete -c $progname -s C -d 'Specifies a path to the XBPS configuration directory.' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s d -d 'Enables extra debugging shown to stderr.'\0Acomplete -c $progname -s g -d 'Alternative group name to match.  To be used with the set mode.'\0Acomplete -c $progname -s h -d 'Show the help message.'\0Acomplete -c $progname -s r -d 'Specifies a full path for the target root directory.' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s v -d 'Enables verbose messages.'\0Acomplete -c $progname -s V -d 'Show the version information.'\0Acomplete -c $progname -s l -n \22not __fish_contains_opt -s s\22 -d 'Lists all current alternative groups or only from PKG, or just a specific group with -g.'\0Acomplete -c $progname -s s -n \22not __fish_contains_opt -s l\22 -d 'Set alternative groups specified by PKG or just a specific group with -g.'\0A", align 1
