@anon.1d0b41a8d45d477c3029ec78f9b8b434.2122 = private unnamed_addr constant [10083 x i8] c"# Runtime options\0Acomplete -c mono -s h -l help -d 'Show help'\0Acomplete -c mono -s V -l version -a number -f -d 'Show version'\0A\0Acomplete -c mono -l aot -a '(__fish_append , \\\\\0A  asmonly\\t\22Instruct the AOT compiler to output assembly code instead of an object file\22 \\\\\0A  bind-to-runtime-version\\t\22Force the generated AOT files to be bound to the runtime version of the compiling Mono\22 \\\\\0A  data-outfile\\t\22Instruct the AOT code generator to output certain data constructs into a separate file\22 \\\\\0A  direct-icalls\\t\22Invoke icalls directly instead of going through the operating system symbol lookup operation\22 \\\\\0A  direct-pinvoke\\t\22Invoke PInvoke methods directly instead of going through the operating system symbol lookup operation\22 \\\\\0A  dwarfdebug\\t\22Instruct the AOT compiler to emit DWARF debugging information\22 \\\\\0A  full\\t\22Create binaries which can be used with the --full-aot option\22 \\\\\0A  hybrid\\t\22Create binaries which can be used with the --hybrid-aot option\22 \\\\\0A  llvm\\t\22Perform AOT with the LLVM backend instead of the Mono backend where possible\22 \\\\\0A  llvmonly\\t\22Perform AOT with the LLVM backend exclusively and the Mono backend will not be used\22 \\\\\0A  llvmopts\\t\22Specify flags to the built-in set of flags passed to the LLVM optimizer\22 \\\\\0A  llvmllc\\t\22Specify flags to the built-in set of flags passed to the LLVM static compiler (llc)\22 \\\\\0A  mcpu\\t\22Allow AOT mode to use all instructions current CPU supports\22 \\\\\0A  dedup-include\\t\22Pass compilation where we compile the methods that we had previously skipped\22 \\\\\0A  info\\t\22Print the architecture the AOT in this copy of Mono targets and quit\22 \\\\\0A  interp\\t\22Generate all required wrappers, so that it is possible to run --interpreter without any  code generation at runtime\22 \\\\\0A  depfile\\t\22Output a gcc -M style dependency file\22 \\\\\0A  ld-flags\\t\22Specify flags to pass to the C linker (if the current AOT mode calls for invoking it)\22 \\\\\0A  llvm-path\\t\22Same for the llvm tools \\\\\\'opt\\\\\\' and \\\\\\'llc\\\\\\'\22 \\\\\0A  msym-dir\\t\22Instruct the AOT compiler to generate offline sequence points .msym files\22 \\\\\0A  mtriple\\t\22Use the GNU style target triple <TRIPLE> to determine some code generation options\22 \\\\\0A  nimt-trampolines\\t\22Precreate IMT trampolines in the AOT image\22 \\\\\0A  ngsharedvt-trampolines\\t\22Precreate value type generic sharing trampolines in the AOT image\22 \\\\\0A  nodebug\\t\22Instruct the AOT compiler to not output any debugging information\22 \\\\\0A  no-direct-calls\\t\22Prevent the AOT compiler from generating direct calls to a method\22 \\\\\0A  nrgctx-trampolines\\t\22Precreate generic sharing trampolines in the AOT image\22 \\\\\0A  nrgctx-fetch-trampolines\\t\22Precreate generic sharing fetch trampolines in the AOT image\22 \\\\\0A  ntrampolines\\t\22Precreate method trampolines in the AOT image\22 \\\\\0A  outfile\\t\22Instruct the AOT compiler to save the output to the specified file\22 \\\\\0A  print-skipped-methods\\t\22Output the skipped methods to the console\22 \\\\\0A  profile\\t\22Specify a file to use for profile-guided optimization\22 \\\\\0A  profile-only\\t\22\22 \\\\\0A  readonly-value\\t\22Override the value of a static readonly field\22 \\\\\0A  save-temps,keep-temps\\t\22Instruct the AOT compiler to keep temporary files\22 \\\\\0A  soft-debug\\t\22Instruct the compiler to generate sequence point checks\22 \\\\\0A  static\\t\22Create  an ELF object file (.o) or .s file which can be statically linked into an executable when embedding the mono runtime\22 \\\\\0A  stats\\t\22Print various stats collected during AOT compilation\22 \\\\\0A  temp-path\\t\22Specify path to store temporary files created during AOT compilation\22 \\\\\0A  threads\\t\22Use multiple threads when compiling the methods\22 \\\\\0A  tool-prefix\\t\22Prepend <PREFIX> to the name of tools ran by the AOT compiler\22 \\\\\0A  verbose\\t\22Print additional information about type loading failures\22 \\\\\0A  write-symbols,no-write-symbols\\t\22Instruct the AOT compiler to emit (or not emit) debug symbol information\22 \\\\\0A  no-opt\\t\22Instruct the AOT compiler tot no call opt when compiling with LLVM\22)' \\\0A    -f -d 'Precompile CIL code to native code'\0A\0Acomplete -c mono -l aot-path -d 'Show additional directories to search for AOT images'\0Acomplete -c mono -l apply-bindings \\\0A    -d 'Apply the assembly bindings from the specified configuration file when running the AOT compiler'\0Acomplete -c mono -l assembly-loader \\\0A    -a 'strict\\t\22Check that the public key token, culture and version of a candidate assembly matches the requested strong name\22 legacy\\t\22Allow candidate as long as the name matches\22' \\\0A    -f -d 'Use assembly loader mode'\0Acomplete -c mono -l attach -a disable -f -d 'Disable the attach functionality'\0Acomplete -c mono -l config -d 'Read configuration from file instead of using default one'\0A\0Acomplete -c mono -l debugger-agent -a '(__fish_append , \\\\\0A  address\\t\22Specify the IP address where your debugger client is listening to\22 \\\\\0A  loglevel\\t\22Specify the diagnostics log level for\22 \\\\\0A  logfile\\t\22Instruct the AOT code generator to output certain data constructs into a separate file\22 \\\\\0A  server\\t\22Specify the file where the log will be stored, it defaults to standard output\22 \\\\\0A  setpgid\\t\22If set to yes, Mono will call setpgid(0, 0) on startup\22 \\\\\0A  suspend\\t\22Suspend the vm on startup until it connects successfully to a debugger front end\22 \\\\\0A  transport\\t\22Specify the transport that the debugger will use to communicate\22)' \\\0A    -f -d 'Use a debugging agent inside the Mono runtime and connect it to a client user interface'\0A\0Acomplete -c mono -l desktop \\\0A