@anon.1d0b41a8d45d477c3029ec78f9b8b434.3514 = private unnamed_addr constant [120 x i8] c"function prompt_hostname --description 'short hostname for the prompt'\0A    string replace -r -- \22\\..*\22 \22\22 $hostname\0Aend\0A", align 1
