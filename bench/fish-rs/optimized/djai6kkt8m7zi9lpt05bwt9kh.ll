@anon.1d0b41a8d45d477c3029ec78f9b8b434.3280 = private unnamed_addr constant [191 x i8] c"function __fish_print_debian_apache_sites\0A    # Helper script for completions for a2ensite/a2dissite\0A    for site in /etc/apache2/sites-available/*\0A        basename \22$site\22 .conf\0A    end\0Aend\0A", align 1
