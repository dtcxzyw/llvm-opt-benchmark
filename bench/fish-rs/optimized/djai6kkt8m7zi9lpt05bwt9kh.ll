@anon.1d0b41a8d45d477c3029ec78f9b8b434.1904 = private unnamed_addr constant [6955 x i8] c"function __fish_journalctl_fields\0A    # This would be nicer to get programmatically, but this is how the official\0A    # bash completion does it\0A    set -l __journal_fields MESSAGE{,_ID} PRIORITY CODE_{FILE,LINE,FUNC} ERRNO SYSLOG_{FACILITY,IDENTIFIER,PID} COREDUMP_EXE _{P,U,G}ID _COMM _EXE _CMDLINE _AUDIT_{SESSION,LOGINUID} _SYSTEMD_{CGROUP,SESSION,UNIT,OWNER_UID} _SELINUX_CONTEXT _SOURCE_REALTIME_TIMESTAMP _{BOOT,MACHINE}_ID _HOSTNAME _TRANSPORT _KERNEL_{DEVICE,SUBSYSTEM} _UDEV_{SYSNAME,DEVNODE,DEVLINK} __CURSOR __{REALTIME,MONOTONIC}_TIMESTAMP\0A    for f in $__journal_fields\0A        echo $f\22=\22\0A    end\0Aend\0A\0Afunction __fish_journalctl_is_field\0A    set -l token (commandline -t)\0A    if contains -- $token (__fish_journalctl_fields)\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_journalctl_field_values\0A    set -l token (commandline -t | string split -f1 =)\0A    echo $token=(command journalctl -F $token 2>/dev/null)\0Aend\0A\0Acomplete -c journalctl -n \22not __fish_journalctl_is_field\22 -a '(__fish_journalctl_fields)' -d \22Journal field\22 -f\0Acomplete -c journalctl -n \22not __fish_journalctl_is_field\22 -a '(command journalctl -F _EXE 2>/dev/null)' -d Executable\0Acomplete -c journalctl -n \22not __fish_journalctl_is_field\22 -a '+' -d OR\0Acomplete -c journalctl -n __fish_journalctl_is_field -a '(__fish_journalctl_field_values)' -f -r\0A\0Acomplete -c journalctl -f -s h -l help -d 'Prints a short help text and exits'\0Acomplete -c journalctl -f -l version -d 'Prints a short version string and exits'\0Acomplete -c journalctl -f -l no-pager -d 'Do not pipe output into a pager'\0Acomplete -c journalctl -f -s a -l all -d 'Show all fields in full'\0Acomplete -c journalctl -f -s f -l follow -d 'Show live tail of entries'\0Acomplete -c journalctl -f -s n -l lines -d 'Controls the number of journal lines'\0Acomplete -c journalctl -f -l no-tail -d 'Show all lines, even in follow mode'\0Acomplete -c journalctl -f -s o -l output -d 'Controls the formatting' -xa '(printf %s\\t\\n (command journalctl --output=help))'\0Acomplete -c journalctl -f -s q -l quiet -d 'Suppress warning about normal user'\0Acomplete -c journalctl -f -s m -l merge -d 'Show entries interleaved from all journals'\0A\0A# Boot number (0 for current, -X for the Xst to last boot) with time as description\0Acomplete -c journalctl -f -l this-boot -d 'Show data only from the current boot'\0Acomplete -c journalctl -f -s b -l boot -d 'Show data only from a certain boot' -xa '(command journalctl 2>/dev/null --list-boots --no-pager | while read -l a b c; echo -e \22$a\\\\t$c\22; end)'\0Acomplete -c journalctl -f -s u -l unit -d 'Show data only of the specified unit' -xa \22(__fish_systemctl_services)\22\0Acomplete -c journalctl -f -s p -l priority -d 'Filter by priority' -xa 'emerg 0 alert 1 crit 2 err 3 warning 4 notice 5 info 6 debug 7'\0Acomplete -c journalctl -f -s c -l cursor -d 'Start from the passing cursor'\0Acomplete -c journalctl -f -l since -d 'Entries on or newer than DATE' -xa 'yesterday today tomorrow now'\0Acomplete -c journalctl -f -l until -d 'Entries on or older than DATE' -xa 'yesterday today tomorrow now'\0Acomplete -c journalctl -f -s F -l field -d 'Print all possible data values of FIELD' -xa '(printf %s\\t\\n (command journalctl --fields))'\0Acomplete -c journalctl -f -s D -l directory -d 'Specify journal directory' -xa \22(__fish_complete_directories)\22\0Acomplete -c journalctl -f -l new-id128 -d 'Generate a new 128 bit ID'\0Acomplete -c journalctl -f -l header -d 'Show internal header information'\0Acomplete -c journalctl -f -l disk-usage -d 'Shows the current disk usage'\0Acomplete -c journalctl -f -l setup-keys -d 'Generate Forward Secure Sealing key pair'\0Acomplete -c journalctl -f -l interval -d 'Change interval for the sealing'\0Acomplete -c journalctl -f -l verify -d 'Check journal for internal consistency'\0Acomplete -c journalctl -f -l verify-key -d 'Specifies FSS key for --verify'\0Acomplete -c journalctl -f -s r -l reverse -d \22Reverse output to show newest entries first\22\0Acomplete -c journalctl -f -l utc -d \22Express time in Coordinated Universal Time (UTC)\22\0Acomplete -c journalctl -f -l no-hostname -d \22Don't show the hostname field\22\0Acomplete -c journalctl -f -s x -l catalog -d \22Augment log lines with explanation texts from the message catalog\22\0Acomplete -c journalctl -f -l list-boots -d \22Show a list of boot numbers, their IDs and timestamps\22\0Acomplete -c journalctl -f -s k -l dmesg -d \22Show only kernel messages\22\0Acomplete -c journalctl -f -s N -l fields -d \22Print all field names used in all entries of the journal\22\0Acomplete -c journalctl -f -l update-catalog -d \22Update the message catalog index\22\0Acomplete -c journalctl -f -l sync -d \22Write all unwritten journal data and sync journals\22\0Acomplete -c journalctl -f -l flush -d \22Flush log data from /run/log/journal/ into /var/log/journal/\22\0Acomplete -c journalctl -f -l relinquish-var -d \22Write to /run/log/journal/ instead of /var/log/journal/\22\0Acomplete -c journalctl -f -l smart-relinquish-var -d \22Similar to --relinquish-var\22\0Acomplete -c journalctl -f -l rotate -d \22Mark active journal files as archived and create new empty ones\22\0Acomplete -c journalctl -f -l output-fields -d \22List of fields to be included in the output\22\0Acomplete -c journalctl -f -s t -l identifier -d \22Show messages for specified syslog identifier\22 -xa '(printf %s\\t\\n (command journalctl -F SYSLOG_IDENTIFIER))'\0Acomplete -c journalctl -f -l user-unit -d \22Show messages for the specified user session unit\22 -xa '(printf %s\\t\\n (command journalctl -F _SYSTEMD_USER_UNIT))'\0Acomplete -c journalctl -f -l facility -d \22Filter output by syslog facility\22\0Acomplete -c journalctl -f -s g -l grep -d \22Show entries where MESSAGE field matches regex\22\0Acomplete -c journalctl -f -l case-sensitive -d \22Toggle pattern matching case sensitivity\22\0Acomplete -c journalctl -F -l cursor-file -d \22Load cursor from file or save to file, if missing\22\0Acomplete -c journalctl -f -l after-cursor -d \22Show entries after the passed cursor\22\0Acomplete -c journalctl -f -l show-cursor -d \22Show cursor after the last entry\22\0Acomplete -c journalctl -f -l user -d \22Show messages from service of current user\22\0Acomplete -c journalctl -f -l system -d \22Show messages from system services and the kernel\22\0Acomplete -c journalctl -f -s M -l machine -d \22Show messages from a running, local container\22\0Acomplete -c journalctl -f -l file -d \22Operate only on journal files matching glob\22\0Acomplete -c journalctl -f -l root -d \22Use specified directory instead of the root directory\22 -xa \22(__fish_complete_directories)\22\0Acomplete -c journalctl -f -l namespace -d \22Show log data of specified namespace\22\0Acomplete -c journalctl -f -l vacuum-size -d \22Reduce disk usage below specified SIZE\22\0Acomplete -c journalctl -f -l vacuum-time -d \22Remove journal files older than TIME\22\0Acomplete -c journalctl -f -l vacuum-files -d \22Leave only INT number of journal files\22\0Acomplete -c journalctl -f -l list-catalog -d \22Show message catalog entries as a table\22\0Acomplete -c journalctl -f -l dump-catalog -d \22Show message catalog entries\22\0A", align 1
