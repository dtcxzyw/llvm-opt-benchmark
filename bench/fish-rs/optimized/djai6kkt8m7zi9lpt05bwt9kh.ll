@anon.1d0b41a8d45d477c3029ec78f9b8b434.1806 = private unnamed_addr constant [11681 x i8] c"# Heroku toolbelt completions\0A# By Jason Brokaw (github.com/jbbrokaw)\0A\0Afunction __fish_list_available_addons\0A    heroku addons:list | awk -F\22:\22 '/^[a-z]/ {print $1}'\0Aend\0A\0Afunction __fish_list_installed_addons\0A    heroku addons | awk '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_list_heroku_apps\0A    heroku apps | awk '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_list_heroku_config_keys\0A    heroku config | awk -F':' '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_list_heroku_domains\0A    heroku domains | awk '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_list_heroku_dynos\0A    heroku ps | awk -F':' '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_list_heroku_releases\0A    heroku releases | awk '{if (NR>1) print $1}'\0Aend\0A\0Afunction __fish_heroku_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_heroku_using_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Aset -l heroku_looking -c heroku -n __fish_heroku_needs_command\0A\0A# Main commands\0Acomplete $heroku_looking -xa addons -d 'list installed addons'\0Acomplete $heroku_looking -xa apps -d 'manage apps (create, destroy)'\0Acomplete $heroku_looking -xa auth -d 'authentication (login, logout)'\0Acomplete $heroku_looking -xa config -d 'manage app config vars'\0Acomplete $heroku_looking -xa domains -d 'manage custom domains'\0Acomplete $heroku_looking -xa logs -d 'display logs for an app'\0Acomplete $heroku_looking -xa ps -d 'manage dynos (dynos, workers)'\0Acomplete $heroku_looking -xa releases -d 'manage app releases'\0Acomplete $heroku_looking -xa run -d 'run one-off commands (console, rake)'\0Acomplete $heroku_looking -xa sharing -d 'manage collaborators on an app'\0A\0A# Additional topics:\0A\0Acomplete $heroku_looking -xa certs -d 'manage ssl endpoints for an app'\0Acomplete $heroku_looking -xa drains -d 'display syslog drains for an app'\0Acomplete $heroku_looking -xa features -d 'manage optional features'\0Acomplete $heroku_looking -xa fork -d 'clone an existing app'\0Acomplete $heroku_looking -xa help -d 'list commands and display help'\0Acomplete $heroku_looking -xa keys -d 'manage authentication keys'\0Acomplete $heroku_looking -xa labs -d 'manage optional features'\0Acomplete $heroku_looking -xa maintenance -d 'manage maintenance mode for an app'\0Acomplete $heroku_looking -xa members -d 'manage membership in organization accounts'\0Acomplete $heroku_looking -xa orgs -d 'manage organization accounts'\0Acomplete $heroku_looking -xa pg -d 'manage heroku-postgresql databases'\0Acomplete $heroku_looking -xa plugins -d 'manage plugins to the heroku gem'\0Acomplete $heroku_looking -xa regions -d 'list available regions'\0Acomplete $heroku_looking -xa stack -d 'manage the stack for an app'\0Acomplete $heroku_looking -xa status -d 'check status of heroku platform'\0Acomplete $heroku_looking -xa update -d 'update the heroku client'\0Acomplete $heroku_looking -xa version -d 'display version'\0A\0Acomplete $heroku_looking -xa git:clone -d \22clones heroku application to machine at DIRECTORY. defaults to app name.\22\0Acomplete $heroku_looking -xa git:remote -d \22adds a git remote to an app repo (-a APP)\22\0A\0A# Addons subcommands\0Acomplete $heroku_looking -xa addons:add -d 'install an addon'\0Acomplete -c heroku -n '__fish_heroku_using_command addons:add' -fa '(__fish_list_available_addons)'\0A\0Acomplete $heroku_looking -xa addons:docs -d \22open an addon's documentation in your browser\22\0Acomplete -c heroku -n '__fish_heroku_using_command addons:docs' -fa '(__fish_list_installed_addons)'\0A\0Acomplete $heroku_looking -xa addons:downgrade -d 'downgrade an existing addon'\0Acomplete -c heroku -n '__fish_heroku_using_command addons:downgrade' -fa '(__fish_list_installed_addons)'\0A\0Acomplete $heroku_looking -xa addons:list -d 'list all available addons'\0A\0Acomplete $heroku_looking -xa addons:open -d \22open an addon's dashboard in your browser\22\0Acomplete -c heroku -n '__fish_heroku_using_command addons:open' -fa '(__fish_list_installed_addons)'\0A\0Acomplete $heroku_looking -xa addons:remove -d 'uninstall one or more addons'\0Acomplete -c heroku -n '__fish_heroku_using_command addons:remove' -fa '(__fish_list_installed_addons)'\0A\0Acomplete $heroku_looking -xa addons:upgrade -d 'upgrade an existing addon'\0Acomplete -c heroku -n '__fish_heroku_using_command addons:upgrade' -fa '(__fish_list_installed_addons)'\0A\0A# Apps options and subcommands\0Acomplete -c heroku -n '__fish_heroku_using_command apps' -s o -l org -l ORG -d \22the org to list the apps for\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps' -s A -l all -d \22list all apps in the org. Not just joined apps\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps' -s p -l personal -d \22list apps in personal account when a default org is set\22\0A\0Acomplete $heroku_looking -xa apps:create -d \22create a new app (takes name)\22\0A\0Acomplete $heroku_looking -xa apps:destroy -d \22 permanently destroy an app (--app APP)\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:destroy' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0Acomplete $heroku_looking -xa apps:info -d \22show detailed app information\22\0A\0Acomplete $heroku_looking -xa apps:join -d \22 add yourself to an organization app (--app APP)\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:join' -l app -s a\0A\0Acomplete $heroku_looking -xa apps:leave -d \22 remove yourself from an organization app (--app APP)\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:leave' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0Acomplete $heroku_looking -xa apps:lock -d \22 lock an organization app to restrict access\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:lock' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0Acomplete $heroku_looking -xa apps:open -d \22 open the app in a web browser\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:open' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0Acomplete $heroku_looking -xa apps:rename -d \22 rename the app (apps:rename newname --app oldname)\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:rename' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0Acomplete $heroku_looking -xa apps:unlock -d \22 unlock an organization app so that any org member can join it\22\0Acomplete -c heroku -n '__fish_heroku_using_command apps:unlock' -l app -s a -xa '(__fish_list_heroku_apps)'\0A\0A# Auth subcommands\0Acomplete $heroku_looking -xa auth:login -d \22log in with your heroku credentials\22\0Acomplete $heroku_looking -xa auth:logout -d \22clear local authentication credentials\22\0Acomplete $heroku_looking -xa auth:token -d \22display your api token\22\0Acomplete $heroku_looking -xa auth:whoami -d \22display your heroku email address\22\0A\0A# Config options and subcommands\0Acomplete -c heroku -n '__fish_heroku_using_command config' -s s -l shell -d \22output config vars in shell format\22\0A\0Acomplete $heroku_looking -xa config:get -d \22display a config value for an app\22\0Acomplete -c heroku -n '__fish_heroku_using_command config:get' -xa '(__fish_list_heroku_config_keys)' -d \22display a config value for an app\22\0A\0Acomplete $heroku_looking -xa config:set -d \22set one or more config vars (KEY=VALUE)\22\0Acomplete -c heroku -n '__fish_heroku_using_command config:set' -fa '(__fish_list_heroku_config_keys)' -d \22set one or more config vars (KEY=VALUE)\22\0A\0Acomplete $heroku_looking -xa config:unset -d \22unset one or more config vars\22\0Acomplete -c heroku -n '__fish_heroku_using_command config:unset' -fa '(__fish_list_heroku_config_keys)' -d \22unset one or more config vars\22\0A\0A# Domains subcommands\0Acomplete $heroku_looking -xa domains:add -d \22add a custom domain to an app\22\0Acomplete $heroku_looking -xa domains:clear -d \22remove all custom domains from an app\22\0Acomplete $heroku_looking -xa domains:remove -d \22remove a custom domain from an app\22\0Acomplete -c heroku -n '__fish_heroku_using_command domains:remove' -fa '(__fish_list_heroku_domains)' -d \22remove a custom domain from an app\22\0A\0A# Logs options\0Acomplete -c heroku -n '__fish_heroku_using_command logs' -s n -l num -l NUM -d \22the number of lines to display\22\0Acomplete -c heroku -n '__fish_heroku_using_command logs' -s p -l ps -l PS -d \22only display logs from the given process\22\0Acomplete -c heroku -n '__fish_heroku_using_command logs' -s s -l source -l SOURCE -d \22only display logs from the given source\22\0Acomplete -c heroku -n '__fish_heroku_using_command logs' -s t -l tail -d \22continually stream logs\22\0A\0A# PG subcommands\0Acomplete $heroku_looking -xa pg:backups -d \22manage backups of heroku postgresql databases\22\0Acomplete $heroku_looking -xa pg:backups:cancel -d \22cancel an in-progress backup or restore (default newest)\22\0Acomplete $heroku_looking -xa pg:backups:capture -d \22capture a new backup\22\0Acomplete $heroku_looking -xa pg:backups:delete -d \22delete a backup\22\0Acomplete $heroku_looking -xa pg:backups:download -d \22downloads database backup\22\0Acomplete $heroku_looking -xa pg:backups:info -d \22get information about a specific backup\22\0Acomplete $heroku_looking -xa pg:backups:restore -d \22restore a backup (default latest) to a database\22\0Acomplete $heroku_looking -xa pg:backups:schedule -d \22schedule daily backups for given database\22\0Acomplete $heroku_looking -xa pg:backups:schedules -d \22list backup schedule\22\0Acomplete $heroku_looking -xa pg:backups:unschedule -d \22stop daily backups\22\0Acomplete $heroku_looking -xa pg:backups:url -d \22get secret but publicly accessible URL of a backup\22\0A\0A# PS subcommands\0Acomplete $heroku_looking -xa ps:resize -d \22resize dynos to the given size (DYNO1=1X|2X|PX)\22\0Acomplete -c heroku -n '__fish_heroku_using_command ps:resize' -fa '(__fish_list_heroku_dynos)' -d \22resize dynos to the given size (DYNO1=1X|2X|PX)\22\0A\0Acomplete $heroku_looking -xa ps:restart -d \22restart an app dyno\22\0Acomplete -c heroku -n '__fish_heroku_using_command ps:restart' -fa '(__fish_list_heroku_dynos)' -d \22restart an app dyno\22\0A\0Acomplete $heroku_looking -xa ps:scale -d \22scale dynos by the given amount (DYNO1=AMOUNT1)\22\0Acomplete -c heroku -n '__fish_heroku_using_command ps:scale' -fa '(__fish_list_heroku_dynos)' -d \22scale dynos by the given amount (DYNO1=AMOUNT1)\22\0A\0Acomplete $heroku_looking -xa ps:stop -d \22stop an app dyno\22\0Acomplete -c heroku -n '__fish_heroku_using_command ps:stop' -fa '(__fish_list_heroku_dynos)' -d \22stop an app dyno\22\0A\0A# Releases options and subcommands\0Acomplete -c heroku -n '__fish_heroku_using_command releases' -s n -l num -l NUM -d \22number of releases to show, maximum 50\22\0A\0Acomplete $heroku_looking -xa releases:info -d \22view detailed information for a release\22\0Acomplete -c heroku -n '__fish_heroku_using_command releases:info' -fa '(__fish_list_heroku_releases)' -d \22view detailed information for a release\22\0A\0Acomplete $heroku_looking -xa releases:rollback -d \22roll back to an older release\22\0Acomplete -c heroku -n '__fish_heroku_using_command releases:rollback' -fa '(__fish_list_heroku_releases)' -d \22roll back to an older release\22\0A\0A# Run options and subcommands\0Acomplete -c heroku -n '__fish_heroku_using_command run' -s s -l size -l SIZE -d \22specify dyno size\22\0A\0Acomplete $heroku_looking -xa run:console -d \22open a remote console session (with optional COMMAND)\22\0Acomplete $heroku_looking -xa run:detached -d \22run a detached dyno, where output is sent to your logs\22\0A# complete $heroku_looking -xa run:rake -d \22WARNING: `heroku run:rake` has been deprecated. Please use `heroku run rake` instead.\22\0Acomplete -c heroku -n '__fish_heroku_using_command run:detached' -s t -l tail -d \22stream logs for the dyno\22\0A\0A# Sharing subcommands\0Acomplete $heroku_looking -xa sharing:add -d \22add a collaborator to an app\22\0Acomplete $heroku_looking -xa sharing:remove -d \22remove a collaborator from an app\22\0Acomplete $heroku_looking -xa sharing:transfer -d \22transfers an app to another user or an organization.\22\0A", align 1
