@anon.1d0b41a8d45d477c3029ec78f9b8b434.1868 = private unnamed_addr constant [996 x i8] c"function __fish_print_debian_services --description 'Prints services installed'\0A    path filter -fxZ /etc/init.d/* | path basename\0Aend\0A\0Afunction __fish_invoke_rcd_has_service\0A    set -l tokens (commandline -xpc)\0A    if test (count $tokens) -eq 2\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Acomplete -f -c invoke-rc.d -n 'not __fish_invoke_rcd_has_service' -a '(__fish_print_debian_services)'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a start -d 'Start the service'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a stop -d 'Stop the service'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a restart -d 'Restart the service'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a reload -d 'Reload Configuration'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a force-reload -d 'Force reloading configuration'\0Acomplete -f -c invoke-rc.d -n __fish_invoke_rcd_has_service -a status -d 'Print the status of the service'\0A", align 1
