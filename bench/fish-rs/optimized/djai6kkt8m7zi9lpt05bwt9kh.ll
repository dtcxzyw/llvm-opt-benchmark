@anon.1d0b41a8d45d477c3029ec78f9b8b434.3128 = private unnamed_addr constant [347 x i8] c"function __fish_complete_group_ids --description \22Complete group IDs with group name as description\22\0A    if command -sq getent\0A        getent group | string replace -f -r '^([[:alpha:]_][^:]*):[^:]*:(\\d+).*' '$2\\t$1'\0A    else if test -r /etc/group\0A        string replace -f -r '^([[:alpha:]_][^:]*):[^:]*:(\\d+).*' '$2\\t$1' </etc/group\0A    end\0Aend\0A", align 1
