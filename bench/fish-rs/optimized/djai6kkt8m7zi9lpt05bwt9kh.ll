@anon.1d0b41a8d45d477c3029ec78f9b8b434.1500 = private unnamed_addr constant [1712 x i8] c"# Completion for doas https://github.com/multiplexd/doas\0A# based on the sudo completions\0A#\0A\0Afunction __fish_doas_print_remaining_args\0A    set -l tokens (commandline -xpc | string escape) (commandline -ct)\0A    set -e tokens[1]\0A    # These are all the options mentioned in the man page for openbsd's \22doas\22 (in that order).\0A    set -l opts a= C= L n s u=\0A    argparse -s $opts -- $tokens 2>/dev/null\0A    # The remaining argv is the subcommand with all its options, which is what\0A    # we want.\0A    if test -n \22$argv\22\0A        and not string match -qr '^-' $argv[1]\0A        string join0 -- $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_complete_doas_subcommand\0A    set -l args (__fish_doas_print_remaining_args | string split0)\0A    set -lx -a PATH /usr/local/sbin /sbin /usr/sbin\0A    __fish_complete_subcommand --commandline $args\0Aend\0A\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s a -d \22Choose auth method on systems using /etc/login.conf\22\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s C -r -d \22validate given config file and test it against given command\22\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s L -d \22Clear persisted authorizations, then exit\22\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s n -d \22Fail if doas would prompt for password\22\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s s -d \22Execute the shell from SHELL or /etc/passwd\22\0Acomplete -c doas -n \22not __fish_doas_print_remaining_args\22 -s u -a \22(__fish_complete_users)\22 -x -d \22Execute the command as user. The default is root.\22\0A\0A# Complete the command we are executing under doas\0Acomplete -c doas -x -a \22(__fish_complete_doas_subcommand)\22\0A", align 1
