onse\22 -x\0A        complete -c ping -s f -l flood -d \22Flood ping\22\0A        complete -c ping -l ip-timestamp -d \22Set IP timestamp type\22 -xa \22tsonly tsaddr\22\0A        complete -c ping -s l -l preload -d \22Send number of packets as fast as possible\22 -x\0A        complete -c ping -s p -l pattern -d \22Fill ICMP packet with given pattern\22 -x\0A        complete -c ping -s q -l quiet -d \22Quiet output\22\0A        complete -c ping -s R -l route -d \22Record route\22\0A        complete -c ping -s s -l size -d \22Set number of data octets\22 -x\0A        complete -c ping -s \\? -l help -d \22Show help\22\0A        complete -c ping -l usage -d \22Short usage message\22\0A        complete -c ping -s V -l version -d \22Print program version\22\0A\0A    case '*BusyBox*'\0A        # completions for ping from busybox\0A        complete -c ping -s 4 -d \22Use IPv4\22\0A        complete -c ping -s 6 -d \22Use IPv6\22\0A        complete -c ping -s c -d \22Set number of pings to send\22 -x\0A        complete -c ping -s s -d \22Set data size\22 -x\0A        complete -c ping -s i -d \22Interval (seconds)\22 -x\0A        complete -c ping -s A -d \22Ping as soon as reply is received\22\0A        complete -c ping -s t -d \22Set TTL\22 -x\0A        complete -c ping -s I -d \22Source interface or IP address\22 -xa \22(__fish_print_interfaces; __fish_print_addresses)\22\0A        complete -c ping -s W -d \22Seconds to wait for the first response\22 -x\0A        complete -c ping -s w -d \22Seconds until ping exits\22 -x\0A        complete -c ping -s q -d Quiet\0A        complete -c ping -s p -d \22Payload pattern\22 -x\0A\0A    case '*'\0A        set -l ping_os_version (uname)\0A        switch $ping_os_version\0A            case '*FreeBSD*' '*Darwin*'\0A                # In common with FreeBSD and Apple\0A                complete -c ping -s A -d \22Audible ping\22\0A                complete -c ping -s a -d \22Audible ping\22\0A                complete -c ping -s C -d \22Pr