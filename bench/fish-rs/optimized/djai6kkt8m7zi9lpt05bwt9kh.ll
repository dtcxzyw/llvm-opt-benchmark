@anon.1d0b41a8d45d477c3029ec78f9b8b434.3516 = private unnamed_addr constant [955 x i8] c"function prompt_login --description \22display user name for the prompt\22\0A    if not set -q __fish_machine\0A        set -g __fish_machine\0A        set -l debian_chroot $debian_chroot\0A\0A        if test -r /etc/debian_chroot\0A            set debian_chroot (cat /etc/debian_chroot)\0A        end\0A\0A        if set -q debian_chroot[1]\0A            and test -n \22$debian_chroot\22\0A            set -g __fish_machine \22(chroot:$debian_chroot)\22\0A        end\0A    end\0A\0A    # Prepend the chroot environment if present\0A    if set -q __fish_machine[1]\0A        echo -n -s (set_color yellow) \22$__fish_machine\22 (set_color normal) ' '\0A    end\0A\0A    # If we're running via SSH, change the host color.\0A    set -l color_host $fish_color_host\0A    if set -q SSH_TTY; and set -q fish_color_host_remote\0A        set color_host $fish_color_host_remote\0A    end\0A\0A    echo -n -s (set_color $fish_color_user) \22$USER\22 (set_color normal) @ (set_color $color_host) (prompt_hostname) (set_color normal)\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3517 = private unnamed_addr constant [25 x i8] c"functions/prompt_pwd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3518 = private unnamed_addr constant [1705 x i8] c"function prompt_pwd --description 'short CWD for the prompt'\0A    set -l options h/help d/dir-length= D/full-length-dirs=\0A    argparse -n prompt_pwd $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help prompt_pwd\0A        return 0\0A    end\0A\0A    set -q argv[1]\0A    or set argv $PWD\0A\0A    set -ql _flag_d\0A    and set -l fish_prompt_pwd_dir_length $_flag_d\0A\0A    set -q fish_prompt_pwd_dir_length\0A    or set -l fish_prompt_pwd_dir_length 1\0A\0A    set -l fulldirs 0\0A    set -ql _flag_D\0A    and set -l fish_prompt_pwd_full_dirs $_flag_D\0A\0A    set -q fish_prompt_pwd_full_dirs\0A    or set -l fish_prompt_pwd_full_dirs 1\0A\0A    for path in $argv\0A        # Replace $HOME with \22~\22\0A        set -l realhome (string escape --style=regex -- ~)\0A        set -l tmp (string replace -r '^'\22$realhome\22'($|/)' '~$1' $path)\0A\0A        if test \22$fish_prompt_pwd_dir_length\22 -eq 0\0A            echo $tmp\0A        else\0A            # Shorten to at most $fish_prompt_pwd_dir_length characters per directory\0A            # with full-length-dirs components left at full length.\0A            set -l full\0A            if test $fish_prompt_pwd_full_dirs -gt 0\0A                set -l all (string split -m (math $fish_prompt_pwd_full_dirs - 1) -r / $tmp)\0A                set tmp $all[1]\0A                set full $all[2..]\0A            else if test $fish_prompt_pwd_full_dirs -eq 0\0A                # 0 means not even the last component is kept\0A                string replace -ar '(\\.?[^/]{'\22$fish_prompt_pwd_dir_length\22'})[^/]*' '$1' $tmp\0A                continue\0A            end\0A\0A            string join / -- (string replace -ar -- '(\\.?[^/]{'\22$fish_prompt_pwd_dir_length\22'})[^/]*/' '$1/' $tmp) $full\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3519 = private unnamed_addr constant [19 x i8] c"functions/psub.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3520 = private unnamed_addr constant [2258 x i8] c"function psub --description \22Read from stdin into a file and output the filename. Remove the file when the command that called psub exits.\22\0A    set -l options -x 'f,F' -x 'F,s' h/help f/file F/fifo 's/suffix=' T-testing\0A    argparse -n psub --max-args=0 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help psub\0A        return 0\0A    end\0A\0A    set -l dirname\0A    set -l filename\0A    set -l funcname\0A\0A    if not status --is-command-substitution\0A        printf (_ \22%s: Not inside of command substitution\22) psub >&2\0A        return 1\0A    end\0A\0A    set -l tmpdir /tmp\0A    set -q TMPDIR\0A    and set tmpdir $TMPDIR\0A\0A    if set -q _flag_fifo\0A        # Write output to pipe. This needs to be done in the background so\0A        # that the command substitution exits without needing to wait for\0A        # all the commands to exit.\0A        set dirname (mktemp -d $tmpdir/.psub.XXXXXXXXXX)\0A        or return 1\0A        set filename $dirname/psub.fifo\22$_flag_suffix\22\0A        command mkfifo $filename\0A        # Note that if we were to do the obvious `cat >$filename &`, we would deadlock\0A        # because $filename may be opened before the fork. Use tee to ensure it is opened\0A        # after the fork.\0A        command tee $filename >/dev/null &\0A    else if test -z \22$_flag_suffix\22\0A        set filename (mktemp $tmpdir/.psub.XXXXXXXXXX)\0A        or return 1\0A        command cat >$filename\0A    else\0A        set dirname (mktemp -d $tmpdir/.psub.XXXXXXXXXX)\0A        or return 1\0A        set filename \22$dirname/psub$_flag_suffix\22\0A        command cat >$filename\0A    end\0A\0A    # Write filename to stdout\0A    echo $filename\0A\0A    # This flag isn't documented. It's strictly for our unit tests.\0A    if set -q _flag_testing\0A        return\0A    end\0A\0A    # Find unique function name\0A    while true\0A        set funcname __fish_psub_(random)\0A        if not functions $funcname >/dev/null 2>/dev/null\0A            break\0A        end\0A    end\0A\0A    # Make sure we erase file when caller exits\0A    function $funcname --on-job-exit caller --inherit-variable filename --inherit-variable dirname --inherit-variable funcname\0A        command rm $filename\0A        if test -n \22$dirname\22\0A            command rmdir $dirname\0A        end\0A        functions -e $funcname\0A    end\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3521 = private unnamed_addr constant [20 x i8] c"functions/pushd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3522 = private unnamed_addr constant [2367 x i8] c"function pushd --description 'Push directory to stack'\0A    set -l rot_r\0A    set -l rot_l\0A\0A    if count $argv >/dev/null\0A        # check for --help\0A        switch $argv[1]\0A            case -h --h --he --hel --help\0A                __fish_print_help pushd\0A                return 0\0A        end\0A\0A        # emulate bash by checking if argument of form +n or -n\0A        if string match -qr '^-[0-9]+$' -- $argv[1]\0A            set rot_r (string sub -s 2 -- $argv[1])\0A        else if string match -qr '^\\+[0-9]+$' -- $argv[1]\0A            set rot_l (string sub -s 2 -- $argv[1])\0A        end\0A    end\0A\0A    set -q dirstack\0A    or set -g dirstack\0A\0A    # emulate bash: an empty pushd should switch the top of dirs\0A    if not set -q argv[1]\0A        # check that the stack isn't empty\0A        if not set -q dirstack[1]\0A            echo \22pushd: no other directory\22 >&2\0A            return 1\0A        end\0A\0A        # get the top two values of the dirs stack ... the first is pwd\0A        set -l top_dir $PWD\0A        set -l next_dir $dirstack[1]\0A\0A        # alter the top of dirstack and move to directory\0A        set -g dirstack[1] $top_dir\0A        cd $next_dir\0A        return\0A    end\0A\0A    # emulate bash: check for rotations\0A    if test -n \22$rot_l\22 -o -n \22$rot_r\22\0A        # grab the current stack\0A        set -l stack $PWD $dirstack\0A\0A        # translate a right rotation to a left rotation\0A        if test -n \22$rot_r\22\0A            # check the rotation in range\0A            if test $rot_r -ge (count $stack)\0A                echo \22pushd: -$rot_r: directory stack index out of range\22 >&2\0A                return 1\0A            end\0A\0A            set rot_l (math (count $stack) - 1 - $rot_r)\0A        end\0A\0A        # check the rotation in range\0A        if test $rot_l -ge (count $stack)\0A            echo \22pushd: +$rot_l: directory stack index out of range\22 >&2\0A            return 1\0A        else\0A            # rotate stack unless rot_l is 0\0A            if test $rot_l -gt 0\0A                set stack $stack[(math $rot_l + 1)..(count $stack)] $stack[1..$rot_l]\0A            end\0A\0A            # now reconstruct dirstack and change directory\0A            set -g dirstack $stack[2..(count $stack)]\0A            cd $stack[1]\0A        end\0A\0A        # print the new stack\0A        dirs\0A        return\0A    end\0A\0A    # argv[1] is a directory\0A    set -l old_pwd $PWD\0A    cd $argv[1]; and set -g -p dirstack $old_pwd\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3523 = private unnamed_addr constant [23 x i8] c"functions/realpath.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3524 = private unnamed_addr constant [2099 x i8] c"# Provide a minimalist realpath implementation to help deal with platforms that may not provide it\0A# as a command. If an external realpath or grealpath command is available simply pass all arguments\0A# thru to it. If not fallback to our builtin.\0A\0A# The following is slightly subtle. We have to define a realpath function even if there is an\0A# external command by that name. That's because if we don't the parser will select our builtin.\0A# However, we only want our builtin if there is no external realpath command.\0A\0Aif command -sq realpath\0A    function realpath -w realpath -d \22print the resolved path [command realpath]\22\0A        command realpath $argv\0A    end\0A    exit 0\0Aend\0A\0A# If there is a HomeBrew installed version of GNU realpath named grealpath use that.\0Aif command -sq grealpath\0A    function realpath -w grealpath -d \22print the resolved path [command grealpath]\22\0A        command grealpath $argv\0A    end\0A    exit 0\0Aend\0A\0Afunction realpath -d \22return an absolute path without symlinks\22\0A    set -l options h/help q/quiet V-version s/no-symlinks N-strip z/zero\0A    set -a options e/canonicalize-existing m/canonicalize-missing L/logical P/physical\0A    set -a options 'R-relative-to=' 'B-relative-base='\0A    argparse -n realpath $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help realpath\0A        return 0\0A    end\0A\0A    set -l supported_flags\0A    if set -el _flag_no_symlinks\0A        set -el _flag_s\0A        set -a supported_flags --no-symlinks\0A    end\0A\0A    # We don't implement any of the other flags so if any are set it's an error.\0A    if string match -q '_flag_*' -- (set -l)\0A        set -l flags (set -l | string replace --filter --regex '_flag_\\w+\\s*' '' | sort -u)\0A        printf (_ \22%s: These flags are not allowed by fish realpath: '%s'\22) realpath \22$flags\22 >&2\0A        echo >&2\0A        __fish_print_help realpath\0A        return 1\0A    end\0A\0A    if not set -q argv[1]\0A        printf (_ \22%ls: Expected at least %d args, got only %d\\n\22) realpath 1 0 >&2\0A        return 1\0A    end\0A\0A    for path in $argv\0A        builtin realpath $supported_flags $path\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3525 = private unnamed_addr constant [18 x i8] c"functions/seq.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3526 = private unnamed_addr constant [1853 x i8] c"# If seq is not installed, then define a function that invokes __fish_fallback_seq\0A# We can't call type here because that also calls seq\0A\0Aif not command -sq seq\0A    if command -sq gseq\0A        # No seq provided by the OS, but GNU coreutils was apparently installed, fantastic\0A        function seq --description \22Print sequences of numbers (gseq)\22\0A            gseq $argv\0A        end\0A        exit\0A    else\0A        # No seq command\0A        function seq --description \22Print sequences of numbers\22\0A            __fish_fallback_seq $argv\0A        end\0A    end\0A\0A    function __fish_fallback_seq --description \22Fallback implementation of the seq command\22\0A        set -l from 1\0A        set -l step 1\0A        set -l to 1\0A\0A        # Remove a \22--\22 argument if it happens first.\0A        if test \22x$argv[1]\22 = x--\0A            set -e argv[1]\0A        end\0A\0A        switch (count $argv)\0A            case 1\0A                set to $argv[1]\0A            case 2\0A                set from $argv[1]\0A                set to $argv[2]\0A            case 3\0A                set from $argv[1]\0A                set step $argv[2]\0A                set to $argv[3]\0A            case '*'\0A                printf (_ \22%s: Expected 1, 2 or 3 arguments, got %d\\n\22) seq (count $argv) >&2\0A                return 1\0A        end\0A\0A        for i in $from $step $to\0A            if not string match -rq -- '^-?[0-9]*([0-9]*|\\.[0-9]+)$' $i\0A                printf (_ \22%s: '%s' is not a number\\n\22) seq $i >&2\0A                return 1\0A            end\0A        end\0A\0A        if test $step -ge 0\0A            set -l i $from\0A            while test $i -le $to\0A                echo $i\0A                set i (math -- $i + $step)\0A            end\0A        else\0A            set -l i $from\0A            while test $i -ge $to\0A                echo $i\0A                set i (math -- $i + $step)\0A            end\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3527 = private unnamed_addr constant [21 x i8] c"functions/setenv.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3528 = private unnamed_addr constant [1471 x i8] c"function setenv --description 'Set an env var for csh compatibility.'\0A    # No arguments should cause the current env vars to be displayed.\0A    if not set -q argv[1]\0A        env\0A        return\0A    end\0A\0A    # A single argument should set the named var to nothing.\0A    if not set -q argv[2]\0A        set -gx $argv[1] ''\0A        return\0A    end\0A\0A    # `setenv` accepts only two arguments: the var name and the value. If there are more than two\0A    # args it is an error. The error message is verbatim from csh.\0A    if set -q argv[3]\0A        printf (_ '%s: Too many arguments\\n') setenv >&2\0A        return 1\0A    end\0A\0A    # We have exactly two arguments as required by the csh `setenv` command.\0A    set -l var $argv[1]\0A    set -l val $argv[2]\0A\0A    # Validate the variable name.\0A    if not string match -qr '^\\w+$' -- $var\0A        # This message is verbatim from csh. We don't really need to do this but if we don't fish\0A        # will display a different error message which might confuse someone expecting the csh\0A        # message.\0A        printf (_ '%s: Variable name must contain alphanumeric characters\\n') setenv >&2\0A        return 1\0A    end\0A\0A    # We need to special case some vars to be compatible with fish. In particular how they are\0A    # treated as arrays split on colon characters. All other var values are treated literally.\0A    if contains -- $var PATH CDPATH MANPATH\0A        set -gx $var (string split -- ':' $val)\0A    else\0A        set -gx $var $val\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3529 = private unnamed_addr constant [22 x i8] c"functions/suspend.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3530 = private unnamed_addr constant [814 x i8] c"function suspend --description 'Suspend the current shell.'\0A    set -l options h/help f/force\0A    argparse -n suspend --max-args=1 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help suspend\0A        return 0\0A    end\0A\0A    if not set -q _flag_force\0A        and status is-login\0A        and status is-interactive\0A\0A        echo 2>&1 'Refusing to suspend interactive login shell.'\0A        echo 2>&1 'Use --force to override. This might hang your terminal.'\0A        return 1\0A    end\0A\0A    if status is-interactive\0A        echo -ns 'Suspending ' $fish_pid ': run'\0A        echo -n (set_color --bold) 'kill -CONT' $fish_pid (set_color normal)\0A        echo 'from another terminal to resume'\0A    end\0A\0A    # XXX always causes a zombie until one fg's when we do this:\0A    kill -STOP $fish_pid\0Aend\0A", align 1
