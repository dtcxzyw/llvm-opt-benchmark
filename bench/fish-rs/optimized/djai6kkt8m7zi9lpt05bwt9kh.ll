@anon.1d0b41a8d45d477c3029ec78f9b8b434.3442 = private unnamed_addr constant [3873 x i8] c"function fish_fossil_prompt --description 'Write out the fossil prompt'\0A    # Bail if fossil is not available\0A    if not command -sq fossil\0A        return 1\0A    end\0A\0A    # Read branch and bookmark (bail if not checkout)\0A    set -l branch (fossil branch current 2>/dev/null)\0A    or return 127\0A\0A    set -q fish_color_fossil_clean\0A    or set -g fish_color_fossil_clean green\0A    set -q fish_color_fossil_modified\0A    or set -g fish_color_fossil_modified yellow\0A    set -q fish_color_fossil_dirty\0A    or set -g fish_color_fossil_dirty red\0A\0A    set -q fish_color_fossil_added\0A    or set -g fish_color_fossil_added green\0A    set -q fish_color_fossil_renamed\0A    or set -g fish_color_fossil_renamed magenta\0A    set -q fish_color_fossil_missing\0A    or set -g fish_color_fossil_missing red\0A    set -q fish_color_fossil_deleted\0A    or set -g fish_color_fossil_deleted red\0A    set -q fish_color_fossil_untracked\0A    or set -g fish_color_fossil_untracked yellow\0A    set -q fish_color_fossil_conflict\0A    or set -g fish_color_fossil_conflict red\0A\0A    set -q fish_prompt_fossil_status_added\0A    or set -g fish_prompt_fossil_status_added '\E2\9C\9A'\0A    set -q fish_prompt_fossil_status_modified\0A    or set -g fish_prompt_fossil_status_modified '*'\0A    set -q fish_prompt_fossil_status_renamed\0A    or set -g fish_prompt_fossil_status_renamed '\E2\87\92'\0A    set -q fish_prompt_fossil_status_deleted\0A    or set -g fish_prompt_fossil_status_deleted -\0A    set -q fish_prompt_fossil_status_missing\0A    or set -g fish_prompt_fossil_status_missing '\E2\9C\96'\0A    set -q fish_prompt_fossil_status_untracked\0A    or set -g fish_prompt_fossil_status_untracked '?'\0A    set -q fish_prompt_fossil_status_conflict\0A    or set -g fish_prompt_fossil_status_conflict '\C3\97'\0A\0A    set -q fish_prompt_fossil_status_order\0A    or set -g fish_prompt_fossil_status_order added modified renamed deleted missing untracked conflict\0A\0A    echo -n ' ('\0A    set_color magenta\0A    echo -n \22$branch\22\0A    set_color normal\0A    echo -n '|'\0A    #set -l repo_status (fossil changes --differ 2>/dev/null | string match -rv '\\w:|^\\s' | string split \22 \22 -f1 | sort -u)\0A    set -l repo_status (fossil changes --differ 2>/dev/null | string match -rv '\\w:|^\\s' | string split \22 \22 -f1 | path sort -u)\0A\0A    # Show nice color for a clean repo\0A    if test -z \22$repo_status\22\0A        set_color $fish_color_fossil_clean\0A        echo -n '\E2\9C\94'\0A\0A        # Handle modified or dirty (unknown state)\0A    else\0A        set -l fossil_statuses\0A\0A        # Take actions for the statuses of the files in the repo\0A        for line in $repo_status\0A\0A            # Add a character for each file status if we have one\0A            switch $line\0A                case ADDED\0A                    set -a fossil_statuses added\0A                case EDITED\0A                    set -a fossil_statuses modified\0A                case EXTRA\0A                    set -a fossil_statuses untracked\0A                case DELETED\0A                    set -a fossil_statuses deleted\0A                case MISSING\0A                    set -a fossil_statuses missing\0A                case RENAMED\0A                    set -a fossil_statuses renamed\0A                case CONFLICT\0A                    set -a fossil_statuses conflict\0A            end\0A        end\0A\0A        if string match -qr '^(ADDED|EDITED|DELETED)' $repo_status\0A            set_color $fish_color_fossil_modified\0A        else\0A            set_color --bold $fish_color_fossil_dirty\0A        end\0A\0A        echo -n '\E2\9A\A1'\0A        set_color normal\0A\0A        # Sort status symbols\0A        for i in $fish_prompt_fossil_status_order\0A            if contains -- $i $fossil_statuses\0A                set -l color_name fish_color_fossil_$i\0A                set -l status_name fish_prompt_fossil_status_$i\0A\0A                set_color $$color_name\0A                echo -n $$status_name\0A            end\0A        end\0A    end\0A\0A    set_color normal\0A    echo -n ')'\0Aend\0A", align 1
