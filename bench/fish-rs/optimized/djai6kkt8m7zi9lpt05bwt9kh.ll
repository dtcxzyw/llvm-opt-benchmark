@anon.1d0b41a8d45d477c3029ec78f9b8b434.2844 = private unnamed_addr constant [4908 x i8] c"# these don't work\0A#complete vim -a - -d 'Read file from stdin, commands from stderr, which should be a tty'\0A\0Afunction __fish_vim_find_tags_path\0A    set -l max_depth 10\0A    set -l tags_path tags\0A\0A    for depth in (seq $max_depth)\0A        if test -f $tags_path\0A            echo $tags_path\0A            return 0\0A        end\0A\0A        set tags_path ../$tags_path\0A    end\0A\0A    return 1\0Aend\0A\0A# NB: This function is also used by the nvim completions\0Afunction __fish_vim_tags\0A    set -l token (commandline -ct)\0A    set -l tags_path (__fish_vim_find_tags_path)\0A    or return\0A\0A    # To prevent freezes on a huge tags file (e.g., on one from the Linux\0A    # kernel source tree), limit matching tag lines to some reasonable amount\0A    set -l limit 10000\0A\0A    # tags file is alphabetically sorted, so it's reasonable to use \22look\22 to\0A    # speedup the lookup of strings with known prefix\0A    command look $token $tags_path | head -n $limit | cut -f1,2 -d \\t\0Aend\0A\0A# todo\0A# +[num]        : Position the cursor on line number\0A# +/{pat}       : Position the cursor on the first occurrence of {pat}\0A# +{command}    : Execute Ex command after the first file has been read\0Acomplete -c vim -s c -r -d 'Execute Ex command after the first file has been read'\0Acomplete -c vim -s S -r -d 'Source file after the first file has been read'\0Acomplete -c vim -l cmd -r -d 'Execute Ex command before loading any vimrc'\0Acomplete -c vim -s d -r -d 'Use device as terminal (Amiga only)'\0Acomplete -c vim -s i -r -d 'Set the viminfo file location'\0Acomplete -c vim -s o -d 'Open horizontally split windows for each file'\0Acomplete -c vim -o o2 -d 'Open two horizontally split windows' # actually -o[N]\0Acomplete -c vim -s O -d 'Open vertically split windows for each file'\0Acomplete -c nvim -o O2 -d 'Open two vertically split windows' # actually -O[N]\0Acomplete -c vim -s p -d 'Open tab pages for each file'\0Acomplete -c nvim -o p2 -d 'Open two tab pages' # actually -p[N]\0Acomplete -c vim -s q -r -d 'Start in quickFix mode'\0Acomplete -c vim -s r -r -d 'Use swap files for recovery'\0Acomplete -c vim -s s -r -d 'Source and execute script file'\0Acomplete -c vim -s t -xa '(__fish_vim_tags)' -d 'Set the cursor to tag'\0Acomplete -c vim -s T -r -d 'Terminal name'\0Acomplete -c vim -s u -r -d 'Use alternative vimrc'\0Acomplete -c vim -s U -r -d 'Use alternative vimrc in GUI mode'\0Acomplete -c vim -s w -r -d 'Record all typed characters'\0Acomplete -c vim -s W -r -d 'Record all typed characters (overwrite file)'\0Acomplete -c vim -s A -d 'Start in Arabic mode'\0Acomplete -c vim -s b -d 'Start in binary mode'\0Acomplete -c vim -s C -d 'Behave mostly like vi'\0Acomplete -c vim -s d -d 'Start in diff mode'\0Acomplete -c vim -s D -d 'Debugging mode'\0Acomplete -c vim -s e -d 'Start in Ex mode'\0Acomplete -c vim -s E -d 'Start in improved Ex mode'\0Acomplete -c vim -s f -d 'Start in foreground mode'\0Acomplete -c vim -s F -d 'Start in Farsi mode'\0Acomplete -c vim -s g -d 'Start in GUI mode'\0Acomplete -c vim -s h -d 'Print help message and exit'\0Acomplete -c vim -s H -d 'Start in Hebrew mode'\0Acomplete -c vim -s L -d 'List swap files'\0Acomplete -c vim -s l -d 'Start in lisp mode'\0Acomplete -c vim -s m -d 'Disable file modification'\0Acomplete -c vim -s M -d 'Disallow file modification'\0Acomplete -c vim -s N -d 'Reset compatibility mode'\0Acomplete -c vim -s n -d 'Don\\'t use swap files'\0Acomplete -c vim -s R -d 'Read only mode'\0Acomplete -c vim -s r -d 'List swap files'\0Acomplete -c vim -s s -d 'Start in silent mode'\0Acomplete -c vim -s V -d 'Start in verbose mode'\0Acomplete -c vim -s v -d 'Start in vi mode'\0Acomplete -c vim -s x -d 'Use encryption when writing files'\0Acomplete -c vim -s X -d 'Don\\'t connect to X server'\0Acomplete -c vim -s y -d 'Start in easy mode'\0Acomplete -c vim -s Z -d 'Start in restricted mode'\0Acomplete -c vim -o nb -d 'Become an editor server for NetBeans'\0Acomplete -c vim -l no-fork -d 'Start in foreground mode'\0Acomplete -c vim -l echo-wid -d 'Echo the Window ID on stdout (GTK GUI only)'\0Acomplete -c vim -l help -d 'Print help message and exit'\0Acomplete -c vim -l literal -d 'Do not expand wildcards'\0Acomplete -c vim -l noplugin -d 'Skip loading plugins'\0Acomplete -c vim -l remote -d 'Edit files on Vim server'\0Acomplete -c vim -l remote-expr -d 'Evaluate expr on Vim server'\0Acomplete -c vim -l remote-send -d 'Send keys to Vim server'\0Acomplete -c vim -l remote-silent -d 'Edit files on Vim server'\0Acomplete -c vim -l remote-wait -d 'Edit files on Vim server'\0Acomplete -c vim -l remote-wait-silent -d 'Edit files on Vim server'\0Acomplete -c vim -l serverlist -d 'List all Vim servers that can be found'\0Acomplete -c vim -l servername -d 'Set server name'\0Acomplete -c vim -l version -d 'Print version information and exit'\0Acomplete -c vim -l socketid -r -d 'Run gvim in another window (GTK GUI only)'\0Acomplete -c vim -l clean -d 'Factory defaults: skip vimrc, plugins, viminfo'\0Acomplete -c vim -l startuptime -r -d 'Write startup timing messages to <file>'\0A", align 1
