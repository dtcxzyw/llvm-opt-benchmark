@anon.1d0b41a8d45d477c3029ec78f9b8b434.2726 = private unnamed_addr constant [702 x i8] c"__fish_make_completion_signals\0A\0Acomplete -c timeout -l foreground -d 'Run COMMAND in the foreground'\0Acomplete -c timeout -s k -l kill-after -d 'Send a KILL signal after DURATION' -x\0Acomplete -c timeout -s s -l signal -d 'Specify the signal to be sent' -xa \22$__kill_signals\22\0Acomplete -c timeout -l preserve-status -d 'Exit with same status as COMMAND'\0A\0Acomplete -c timeout -r -a '(__fish_complete_command)' -d 'Specify which command to run'\0A\0A# GNU coreutils ver\0Aif timeout --version &>/dev/null\0A    complete -c timeout -l help -d 'Display this help and exit'\0A    complete -c timeout -l version -d 'Output version and exit'\0A    complete -c timeout -s v -l verbose -d 'Send diagnostic info to stderr'\0Aend\0A", align 1
