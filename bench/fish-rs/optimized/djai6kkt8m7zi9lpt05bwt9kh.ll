@anon.1d0b41a8d45d477c3029ec78f9b8b434.1966 = private unnamed_addr constant [3235 x i8] c"function __fish_lein_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Acomplete -f -c lein -n __fish_lein_needs_command -a check -d \22Check syntax and warn on reflection.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a classpath -d \22Write the classpath of the current project to output-file.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a clean -d \22Remove all files from project's target-path.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a compile -d \22Compile Clojure source into .class files.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a deploy -d \22Build jar and deploy to remote repository.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a deps -d \22Show details about dependencies.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a do -d \22Higher-order task to perform other tasks in succession.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a help -d \22Display a list of tasks or help for a given task or subtask.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a install -d \22Install current project to the local repository.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a jar -d \22Package up all the project's files into a jar file.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a javac -d \22Compile Java source files.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a light -d \22Start a Light Table client for this project\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a new -d \22Generate scaffolding for a new project based on a template.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a plugin -d \22DEPRECATED. Please use the :user profile instead.\22\0Acomplete -f -c lein -n __fish_lein_needs_command -a pom -d \22Write a pom.xml file to disk for Maven interoperability.\22\0Aco