_prompt_color_cleanstate\0A    __fish_git_prompt_set_color __fish_git_prompt_color_invalidstate\0A    __fish_git_prompt_set_color __fish_git_prompt_color_upstream\0A\0A    # Colors with defaults with showcolorhints\0A    if contains -- \22$__fish_git_prompt_showcolorhints\22 yes true 1\0A        __fish_git_prompt_set_color __fish_git_prompt_color_flags (set_color --bold blue)\0A        __fish_git_prompt_set_color __fish_git_prompt_color_branch (set_color green)\0A        __fish_git_prompt_set_color __fish_git_prompt_color_dirtystate (set_color red)\0A        __fish_git_prompt_set_color __fish_git_prompt_color_stagedstate (set_color green)\0A    else\0A        __fish_git_prompt_set_color __fish_git_prompt_color_flags\0A        __fish_git_prompt_set_color __fish_git_prompt_color_branch\0A        __fish_git_prompt_set_color __fish_git_prompt_color_dirtystate $___fish_git_prompt_color_flags $___fish_git_prompt_color_flags_done\0A        __fish_git_prompt_set_color __fish_git_prompt_color_stagedstate $___fish_git_prompt_color_flags $___fish_git_prompt_color_flags_done\0A    end\0A\0A    # Branch_detached has a default, but is only used with showcolorhints\0A    __fish_git_prompt_set_color __fish_git_prompt_color_branch_detached (set_color red)\0A\0A    # Colors that depend on flags color\0A    __fish_git_prompt_set_color __fish_git_prompt_color_stashstate $___fish_git_prompt_color_flags $___fish_git_prompt_color_flags_done\0A    __fish_git_prompt_set_color __fish_git_prompt_color_untrackedfiles $___fish_git_prompt_color_flags $___fish_git_prompt_color_flags_done\0A\0Aend\0A\0Afunction __fish_git_prompt_reset -a type -a op -a var --description \22Event handler, resets prompt when functionality changes\22 \\\0A    --on-variable=__fish_git_prompt_{show_informative_status,use_informative_chars}\0A    if status --is-interactive\0A        # Clear characters that have different defaults with/without informative status\0A        set -e ___fish_git_prompt_char_{name,cleanstate,dirtystate,invalidstate,stagedstate,stashstate,stateseparator,untrackedfiles,upstream_ahead,upstream_behind}\0A        # Clear init so we reset the chars next time.\0A        set -e ___fish_git_prompt_init\0A    end\0Aend\0A\0Afunction __fish_git_prompt_reset_color -a type -a op -a var --description \22Event handler, resets prompt when any color changes\22 \\\0A    --on-variable=__fish_git_prompt_color{'',_prefix,_suffix,_bare,_merging,_cleanstate,_invalidstate,_upstream,_flags,_branch,_dirtystate,_stagedstate,_branch_detached,_stashstate,_untrackedfiles} --on-variable=__fish_git_prompt_showcolorhints\0A    if status --is-interactive\0A        set -e _$var\0A        set -e _{$var}_done\0A        set -e ___fish_git_prompt_init\0A        if contains -- $var __fish_git_prompt_color __fish_git_prompt_color_flags __fish_git_prompt_showcolorhints\0A            # reset all the other colors too\0A            set -e ___fish_git_prompt_color_{prefix,suffix,bare,merging,branch,dirtystate,stagedstate,invalidstate,stashstate,untrackedfiles,upstream,flags}{,_done}\0A        end\0A    end\0Aend\0A\0Afunction __fish_git_prompt_reset_char -a type -a op -a var --description \22Event handler, resets prompt when any char changes\22 \\\0A    --on-variable=__fish_git_prompt_char_{cleanstate,dirtystate,invalidstate,stagedstate,stashstate,stateseparator,untrackedfiles,upstream_ahead,upstream_behind,upstream_diverged,upstream_equal,upstream_prefix}\0A    if status --is-interactive\0A        set -e ___fish_git_prompt_init\0A        set -e _$var\0A    end\0Aend\0A", align 1
