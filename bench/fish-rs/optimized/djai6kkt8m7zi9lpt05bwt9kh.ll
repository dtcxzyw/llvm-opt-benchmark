@anon.1d0b41a8d45d477c3029ec78f9b8b434.2106 = private unnamed_addr constant [8547 x i8] c"complete -c mksquashfs -o b -d 'Data block size'\0Acomplete -c mksquashfs -o comp -d 'Selects the compression scheme' -xa 'gzip lzo lz4 xz zstd lzma'\0Acomplete -c mksquashfs -o noI -o noInodeCompression -d 'Do not compress inode table'\0Acomplete -c mksquashfs -o noId -o noIdTableCompression -d 'Do not compress the uid/gid table'\0Acomplete -c mksquashfs -o noD -o noDataCompression -d 'Do not compress data blocks'\0Acomplete -c mksquashfs -o noF -o noFragmentCompression -d 'Do not compress fragment blocks'\0Acomplete -c mksquashfs -o noX -o noXattrCompression -d 'Do not compress extended attributes'\0Acomplete -c mksquashfs -o no-compression -d 'Do not compress any of the data or metadata'\0Acomplete -c mksquashfs -o tar -d 'Read uncompressed tar file from standard in (stdin)'\0Acomplete -c mksquashfs -o no-strip -o tarstyle -d 'Act like tar, and do not strip leading directories from source files'\0Acomplete -c mksquashfs -o cpiostyle -d 'Act like cpio, and read file pathnames from standard in (stdin)'\0Acomplete -c mksquashfs -o cpiostyle0 -d 'Like -cpiostyle, but filenames are null terminated'\0Acomplete -c mksquashfs -o reproducible -d 'Build filesystems that are reproducible'\0Acomplete -c mksquashfs -o not-reproducible -d 'Build filesystems that are not reproducible'\0Acomplete -c mksquashfs -o mkfs-time -o fstime -xd 'Set filesystem creation timestamp'\0Acomplete -c mksquashfs -o all-time -xd 'Set all file timestamps'\0Acomplete -c mksquashfs -o root-time -xd 'Set root directory time'\0Acomplete -c mksquashfs -o root-mode -xd 'Set root directory permissions to octal <mode>'\0Acomplete -c mksquashfs -o root-uid -xa '(__fish_complete_user_ids)' -d 'Set root directory owner'\0Acomplete -c mksquashfs -o root-gid -xa '(__fish_complete_group_ids)' -d 'Set root directory group'\0Acomplete -c mksquashfs -o all-root -o root-owned -d 'Make all files owned by root'\0Acomplete -c mksquashfs -o force-uid -xa '(__fish_complete_user_ids)' -d 'Set all file uids'\0Acomplete -c mksquashfs -o force-gid -xa '(__fish_complete_group_ids)' -d 'Set all file gids'\0Acomplete -c mksquashfs -o pseudo-override -d 'Make pseudo file uids and gids override -all-root, -force-uid and -force-gid options'\0Acomplete -c mksquashfs -o no-exports -d 'Do not make filesystem exportable via NFS'\0Acomplete -c mksquashfs -o exports -d 'Make filesystem exportable via NFS'\0Acomplete -c mksquashfs -o no-sparse -d 'Do not detect sparse files'\0Acomplete -c mksquashfs -o no-tailends -d 'Do not pack tail ends into fragments'\0Acomplete -c mksquashfs -o tailends -o always-use-fragments -d 'Pack tail ends into fragments'\0Acomplete -c mksquashfs -o no-fragments -d 'Do not use fragments'\0Acomplete -c mksquashfs -o no-duplicates -d 'Do not perform duplicate checking'\0Acomplete -c mksquashfs -o no-hardlinks -d 'Do not hardlink files, instead store duplicates'\0Acomplete -c mksquashfs -o keep-as-directory -d 'If one source directory is specified, create a root directory containing that directory, rather than the contents of the directory'\0Acomplete -c mksquashfs -o p -xd 'Add pseudo file definition'\0Acomplete -c mksquashfs -o pf -rd 'Add list of pseudo file definitions from <pseudo-file>'\0Acomplete -c mksquashfs -o sort -rd 'Sort files according to priorities in <sort_file>'\0Acomplete -c mksquashfs -o ef -rd 'List of exclude dirs/files'\0Acomplete -c mksquashfs -o wildcards -d 'Allow extended shell wildcards (globbing) to be used in exclude dirs/files'\0Acomplete -c mksquashfs -o regex -d 'Allow POSIX regular expressions to be used in exclude dirs/files'\0Acomplete -c mksquashfs -o max-depth -xd 'Descend at most <levels> of directories when scanning filesystem'\0Acomplete -c mksquashfs -o one-file-system -d 'Do not cross filesystem boundaries'\0Acomplete -c mksquashfs -o one-file-system-x -d 'Do not cross filesystem boundaries'\0Acomplete -c mksquashfs -o no-xattrs -d 'Do not store extended attributes'\0Acomplete -c mksquashfs -o xattrs -d 'Store extended attributes'\0Acomplete -c mksquashfs -o xattrs-exclude -xd 'Exclude any xattr names matching <regex>'\0Acomplete -c mksquashfs -o xattrs-include -xd 'Include any xattr names matching <regex>'\0Acomplete -c mksquashfs -o xattrs-add -xd 'Add the xattr <name> with <val> to files'\0Acomplete -c mksquashfs -o version -d 'Print version, licence and copyright message'\0Acomplete -c mksquashfs -o exit-on-error -d 'Treat normally ignored errors as fatal'\0Acomplete -c mksquashfs -o quiet -d 'No verbose output'\0Acomplete -c mksquashfs -o info -d 'Print files written to filesystem'\0Acomplete -c mksquashfs -o no-progress -d 'Do not display the progress bar'\0Acomplete -c mksquashfs -o progress -d 'Display progress bar when using the -info option'\0Acomplete -c mksquashfs -o percentage -d 'Display a percentage rather than the full progress bar'\0Acomplete -c mksquashfs -o throttle -xd 'Throttle the I/O input rate by the given percentage'\0Acomplete -c mksquashfs -o limit -xd 'Limit the I/O input rate to the given percentage'\0Acomplete -c mksquashfs -o processors -xd 'Use <number> processors'\0Acomplete -c mksquashfs -o mem -xd 'Use <size> physical memory for caches'\0Acomplete -c mksquashfs -o mem-percent -xd 'Use <percent> physical memory for caches'\0Acomplete -c mksquashfs -o mem-default -d 'Print default memory usage in Mbytes'\0Acomplete -c mksquashfs -o noappend -d 'Do not append to existing filesystem'\0Acomplete -c mksquashfs -o root-becomes -xd 'When appending source files/directories, make the original root become a subdirectory in the new root called <name>, rather than adding the new source items to the original root'\0Acomplete -c mksquashfs -o no-recovery -d 'Do not generate a recovery file'\0Acomplete -c mksquashfs -o recovery-path -rd 'Use <name> as the directory to store the recovery file'\0Acomplete -c mksquashfs -o recover -rd 'Recover filesystem data using recovery file'\0Acomplete -c mksquashfs -o action -xd 'Evaluate <expr> on every file, and execute <action> if it returns TRUE'\0Acomplete -c mksquashfs -o log-action -xd 'As -action, but log expression evaluation results and actions performed'\0Acomplete -c mksquashfs -o true-action -xd 'As -action, but only log expressions which return TRUE'\0Acomplete -c mksquashfs -o false-action -xd 'As -action, but only log expressions which return FALSE'\0Acomplete -c mksquashfs -o action-file -rd 'As -action, but read actions from <file>'\0Acomplete -c mksquashfs -o log-action-file -rd 'As -log-action, but read actions from <file>'\0Acomplete -c mksquashfs -o true-action-file -rd 'As -true-action, but read actions from <f>'\0Acomplete -c mksquashfs -o false-action-file -rd 'As -false-action, but read actions from <f>'\0Acomplete -c mksquashfs -o default-mode -xd 'Sets the default directory permissions to octal <mode>'\0Acomplete -c mksquashfs -o default-uid -xa '(__fish_complete_user_ids)' -d 'Sets the default directory user'\0Acomplete -c mksquashfs -o default-gid -xa '(__fish_complete_group_ids)' -d 'Sets the default directory group'\0Acomplete -c mksquashfs -o ignore-zeros -d 'Allow tar files to be concatenated together and fed to Mksquashfs'\0Acomplete -c mksquashfs -o nopad -d 'Do not pad filesystem to a multiple of 4K'\0Acomplete -c mksquashfs -o o -o offset -xd 'Skip <offset> bytes at the beginning of FILESYSTEM'\0Acomplete -c mksquashfs -o h -o help -d 'Print help and exit'\0A\0Acomplete -c mksquashfs -o Xhelp -d 'Print compressor options for selected compressor'\0Acomplete -c mksquashfs -o Xwindow-size -xd 'Window size in range 8 .. 15 (gzip only)'\0Acomplete -c mksquashfs -o Xstrategy -xa 'default filtered huffman_only run_length_encoded fixed' -d 'Strategy to use (gzip only)'\0Acomplete -c mksquashfs -o Xalgorithm -xa 'lzo1x_1 lzo1x_1_11 lzo1x_1_12 lzo1x_1_15 lzo1x_999' -d 'Algorithm to use (lzo only)'\0Acomplete -c mksquashfs -o Xhc -d 'Compress using LZ4 High Compression (lz4 only)'\