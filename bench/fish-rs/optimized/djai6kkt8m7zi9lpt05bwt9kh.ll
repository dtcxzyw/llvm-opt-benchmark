@anon.1d0b41a8d45d477c3029ec78f9b8b434.3569 = private unnamed_addr constant [1167 x i8] c"# name: Informative\0A# http://michal.karzynski.pl/blog/2009/11/19/my-informative-shell-prompt/\0A\0Afunction fish_prompt --description 'Informative prompt'\0A    #Save the return status of the previous command\0A    set -l last_pipestatus $pipestatus\0A    set -lx __fish_last_status $status # Export for __fish_print_pipestatus.\0A\0A    if functions -q fish_is_root_user; and fish_is_root_user\0A        printf '%s@%s %s%s%s# ' $USER (prompt_hostname) (set -q fish_color_cwd_root\0A                                                         and set_color $fish_color_cwd_root\0A                                                         or set_color $fish_color_cwd) \\\0A            (prompt_pwd) (set_color normal)\0A    else\0A        set -l status_color (set_color $fish_color_status)\0A        set -l statusb_color (set_color --bold $fish_color_status)\0A        set -l pipestatus_string (__fish_print_pipestatus \22[\22 \22]\22 \22|\22 \22$status_color\22 \22$statusb_color\22 $last_pipestatus)\0A\0A        printf '[%s] %s%s@%s %s%s %s%s%s \\n> ' (date \22+%H:%M:%S\22) (set_color brblue) \\\0A            $USER (prompt_hostname) (set_color $fish_color_cwd) $PWD $pipestatus_string \\\0A            (set_color normal)\0A    end\0Aend\0A", align 1
