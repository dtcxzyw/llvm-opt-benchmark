@anon.1d0b41a8d45d477c3029ec78f9b8b434.1580 = private unnamed_addr constant [2696 x i8] c"function __fish_eselect_cmd\0A    eselect --brief --colour=no $argv\0Aend\0A\0Afunction __fish_complete_eselect_modules\0A    set -l sedregexp 's/^  ([a-zA-Z0-9_-]*)[ ]*/\\1\\t/g'\0A    __fish_eselect_cmd modules list | string match -r '^  ' | sed -r $sedregexp\0Aend\0A\0Afunction __fish_complete_eselect_actions\0A    set -l sedregexp 's/^  ([a-zA-Z0-9_-]*)[ ]*/\\1\\t/g'\0A    set -l cmdl (commandline -pxc)\0A    __fish_eselect_cmd $cmdl[2..-1] usage | string match -r '^  [^ -]' | sed -r $sedregexp\0Aend\0A\0Afunction __fish_complete_eselect_action_options\0A    set -l parseregexp 's/^    ([a-zA-Z0-9_-]*)[ ]*/\\1\\t/g'\0A    set -l cmdl (commandline -pxc)\0A\0A    # Alter further php completion\0A    if test (__fish_print_cmd_args_without_options)[2] = php\0A        eselect php list-modules 2>/dev/null | string split \22 \22\0A        return\0A    end\0A\0A    switch $cmdl[-1]\0A        case -'*'\0A            return\0A    end\0A\0A    set -l findregexp '/^  '$cmdl[-1]'/,/^  [^ ]/p'\0A\0A    set cmdl[-1] usage\0A    __fish_eselect_cmd $cmdl[2..-1] | sed -n -re $findregexp | string match -r '^    --' | sed -re $parseregexp\0Aend\0A\0Afunction __fish_complete_eselect_php_actions\0A    set -l sedregexp 's/^\\s*\\[([0-9]+)\\]\\s+([A-Za-z0-9\\.]+).*/\\1\\t\\2/'\0A\0A    if test (__fish_print_cmd_args_without_options)[3] = set\0A        eselect php list (__fish_print_cmd_args_without_options)[-1] 2>/dev/null | sed -r $sedregexp\0A    end\0Aend\0A\0Afunction __fish_complete_eselect_targets\0A    set -l sedregexp 's/^  \\[([0-9]+)\\][ ]*/\\1\\t/g'\0A    set -l cmdl (commandline -pxc)\0A\0A    # Disable further php completion\0A    if test (__fish_print_cmd_args_without_options)[2] = php\0A        return\0A    end\0A\0A    switch $cmdl[-1]\0A        case -'*'\0A            set cmdl[-2] list\0A        case '*'\0A            set cmdl[-1] list\0A    end\0A\0A    eselect --colour=no $cmdl[2