@anon.1d0b41a8d45d477c3029ec78f9b8b434.1562 = private unnamed_addr constant [6555 x i8] c"#function __fish_emerge_print_all_pkgs_with_version_compare -d 'Print completions for all packages including the version compare if that is already typed'\0A#    set -l version_comparator (commandline -t | string match -r '^[\\'\22]*[<>]\\?=\\?' | \\\0A#                               sed -r 's/^[\\'\22]*(.*)/\\1/g')\0A#    set -l sedstring\0A#\0A#    if set -q $version_comparator\0A#        set sedstring 's/^(.*)/\\1\\tPackage/g'\0A#    else\0A#        set sedstring 's/^(.*)/'$version_comparator'\\1\\tPackage/g'\0A#    end\0A#\0A#    __fish_emerge_print_all_pkgs | sed -r $sedstring\0A#end\0A\0Afunction __fish_emerge_print_sets\0A    for s in '@'(emerge --list-sets)\0A        switch $s\0A            case @profile\0A                printf '%s\\t%s\\n' $s 'set of packages deemed necessary for your system to run properly'\0A            case @selected-packages\0A                printf '%s\\t%s\\n' $s 'packages listed in /var/lib/portage/world'\0A            case @selected-sets\0A                printf '%s\\t%s\\n' $s 'sets listed in /var/lib/portage/world_sets'\0A            case @selected\0A                printf '%s\\t%s\\n' $s 'encompasses both the selected-packages and selected-sets sets'\0A            case @system\0A                printf '%s\\t%s\\n' $s 'set of packages deemed necessary for your system to run properly'\0A            case @world\0A                printf '%s\\t%s\\n' $s 'encompasses the selected, system and profile sets'\0A            case '*'\0A                echo $s\0A        end\0A    end\0Aend\0A\0A# TODO <ebuild|tbz2file|file|@set|atom>...\0Afunction __fish_emerge_possible_args\0A    if __fish_contains_opt check-news -s h help list-sets metadata regen -s r resume \\\0A            -s s search -s S searchdesc sync -s V version\0A        return\0A        # TODO deselect=y\0A    else if __fish_contains_opt config -s c depclean info -s P prune -s C unmerge\0A        __fish_emerge_print_sets\0A        __fish_print_portage_installed_pkgs\0A        # TODO deselect=n\0A    else\0A        __fish_emerge_print_sets\0A        __fish_print_portage_available_pkgs\0A    end\0Aend\0A\0Acomplete -c emerge -xa \22(__fish_emerge_possible_args)\22\0A\0A#########################\0A# Actions               #\0A#########################\0Acomplete -c emerge -l check-news\0Acomplete -c emerge -l clean\0Acomplete -c emerge -l config\0Acomplete -c emerge -s c -l depclean\0Acomplete -c emerge -l deselect\0Acomplete -c emerge -s h -l help\0Acomplete -c emerge -l info\0Acomplete -c emerge -l list-sets\0Acomplete -c emerge -l metadata\0Acomplete -c emerge -s P -l prune\0Acomplete -c emerge -l regen\0Acomplete -c emerge -s r -l resume\0Acomplete -c emerge -s s -l search\0Acomplete -c emerge -s S -l searchdesc\0Acomplete -c emerge -l sync\0Acomplete -c emerge -s C -l unmerge\0Acomplete -c emerge -s V -l version\0A\0A#########################\0A# Options               #\0A#########################\0Acomplete -c emerge -s A -l alert -d \22Add a terminal bell character ('\\a') to all interactive prompts\22\0A#complete -c emerge      -l alphabetical -d \22Sort flag lists alphabetically\22\0Acomplete -c emerge -s a -l ask -d \22Prompt the user before performing the merge\22\0A# ask-enter-invalid\0A# autounmask\0A# autounmask-backtrack <yn>\0A# autounmask-continue\0A# autounmask-only\0A# autounmask-unrestricted-atoms\0A# autounmask-keep-keywords\0A# autounmask-keep-masks\0A# autounmask-write\0Acomplete -c emerge -l backtrack\0Acomplete -c emerge -s b -l buildpkg -d \22Build a binary pkg additionally\22\0A# buildpkg-exclude\0Acomplete -c emerge -s B -l buildpkgonly -d \22Only build a binary pkg\22\0A# changed-deps\0Acomplete -c emerge -s U -l changed-use\0Acomplete -c emerge -s l -l changelog -d \22Show changelog of pkg. Use with --pretend\22\0Acomplete -c emerge -l color -d \22Colorized output\22 \\\0A    -xa \22y n\22\0Acomplete -c emerge -l columns -d \22Align output. Use with --pretend\22\0Acomplete -c emerge -l complete-graph\0A# complete-graph-if-new-use <yn>\0A# complete-graph-if-new-ver <yn>\0A# config-root DIR\0Acomplete -c emerge -s d -l debug -d \22Run in debug mode\22\0Acomplete -c emerge -s D -l deep -d \22Consider the whole dependency tree\22\0A# depclean-lib-check\0A# digest\0A# dynamic-deps <yn>\0Acomplete -c emerge -s e -l emptytree -d \22Reinstall all world pkgs\22\0A# exclude ATOMS\0Acomplete -c emerge -l exclude\0A# fail-clean\0Acomplete -c emerge -s f -l fetchonly -d \22Only download the pkgs but don't install them\22\0Acomplete -c emerge -s F -l fetch-all-uri -d \22Same as --fetchonly and grab all potential files\22\0A# fuzzy-search\0Acomplete -c emerge -s g -l getbinpkg -d \22Download infos from each binary pkg. Implies -k\22\0Acomplete -c emerge -s G -l getbinpkgonly -d \22As -g but don't use local infos\22\0Acomplete -c emerge -l ignore-default-opts -d \22Ignore EMERGE_DEFAULT_OPTS\22\0A# ignore-build-slot-operator-deps <yn>\0A# ignore-soname-deps <yn>\0Acomplete -c emerge -l jobs\0Acomplete -c emerge -l keep-going\0A# load-average\0A# misspell-suggestion\0A# newrepo\0Acomplete -c emerge -s N -l newuse -d \22Include installed pkgs with changed USE flags\22\0Acomplete -c emerge -l noconfmem -d \22Disregard merge records\22\0Acomplete -c emerge -s O -l nodeps -d \22Don't merge dependencies\22\0Acomplete -c emerge -s n -l noreplace -d \22Skip already installed pkgs\22\0Acomplete -c emerge -l nospinner -d \22Disable the spinner\22\0A# usepkg-exclude ATOMS\0A# rebuild-exclude ATOMS\0A# rebuild-ignore ATOMS\0Acomplete -c emerge -s 1 -l oneshot -d \22Don't add pkgs to world\22\0Acomplete -c emerge -s o -l onlydeps -d \22Only merge dependencies\22\0A# onlydeps-with-rdeps <yn>\0A# package-moves\0A# pkg-format\0A# prefix DIR\0Acomplete -c emerge -s p -l pretend -d \22Display what would be done without doing it\22\0Acomplete -c emerge -s q -l quiet -d \22Use a condensed output\22\0A# quiet-build\0A# quiet-fail\0A# quiet-repo-display\0A# quiet-unmerge-warn\0A# rage-clean\0A# read-news\0A# rebuild-if-new-slot\0A# rebuild-if-new-rev\0A# rebuild-if-new-ver\0A# rebuild-if-unbuilt\0A# rebuild-binaries\0A# rebuild-binaries-timestamp TIMESTAMP\0A# reinstall changed-use\0A# reinstall-atoms ATOMS\0A# root-deps\0A# search-index\0A# search-similarity PERCENTAGE\0Acomplete -c emerge -s w -l select\0A# selective\0Acomplete -c emerge -l skipfirst -d \22Remove first pkg in resume list. Use with --resume\22\0A# sync-module <glsa|news|profiles>\0Acomplete -c emerge -s t -l tree -d \22Show the dependency tree\22\0A# unordered-display\0Acomplete -c emerge -s u -l update\0A# use-ebuild-visibility\0A# useoldpkg-atoms ATOMS\0Acomplete -c emerge -s k -l usepkg -d \22Use binary pkg if available\22\0Acomplete -c emerge -s K -l usepkgonly -d \22Only use binary pkgs\22\0Acomplete -c emerge -s v -l verbose -d \22Run in verbose mode\22\0Acomplete -c emerge -l verbose-conflicts -d \22Verbose slot conflicts\22\0A# verbose-slot-rebuilds\0Acomplete -c emerge -l with-bdeps -d \22Pull in build time dependencies\22 \\\0A    -xa \22y n\22\0A# with-bdeps-auto <yn>\0A# with-test-bdeps\0A", align 1
