@anon.1d0b41a8d45d477c3029ec78f9b8b434.3368 = private unnamed_addr constant [51 x i8] c"function __fish_svn_prompt\0A    fish_svn_prompt\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3369 = private unnamed_addr constant [31 x i8] c"functions/__fish_systemctl.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3370 = private unnamed_addr constant [4501 x i8] c"function __fish_systemctl --description 'Call systemctl with some options from the current commandline'\0A    # We don't want to complete with ANSI color codes\0A    set -lu SYSTEMD_COLORS\0A\0A    # These options are all global - before or after subcommand/arguments.\0A    # There's a bunch of long-only options in here, so we need to be creative with the mandatory short version.\0A    set -l opts t/type= s-state= p/property= a/all\0A    set opts $opts r/recursive R-reverse A-after B-before\0A    set opts $opts l/full V-value S-show-types J-job-mode=\0A    set opts $opts F-fail i/ignore-inhibitors q/quiet N-no-block\0A    set opts $opts W-wait U-user Y-system I-failed O-no-wall\0A    set opts $opts G-global E-reload K-no-ask-password 4-kill-who\0A    set opts $opts \C3\BC-signal f-force 5-message \C3\B6-now \C3\A4-root\0A    set opts $opts \C3\9C-runtime \C3\96-preset-mode= n/lines= o/output=\0A    set opts $opts \C3\84-firmware-setup \C3\9F-plain H/host= M/machine=\0A    set opts $opts 1-no-pager 2-no-legend h/help 3-version\0A\0A    set -l args $argv\0A    set -l cmdline (commandline -xpc) (commandline -ct)\0A    set -e cmdline[1]\0A    argparse $opts -- $cmdline 2>/dev/null\0A    or return\0A\0A    # If no subcommand has been given, return so this can be used as a condition.\0A    test -n \22$argv[1]\22\0A    or return\0A    set -l cmd $argv[1]\0A    set -e argv[1]\0A\0A    # Flags we want to pass on.\0A    set -l passflags $_flag_user $_flag_system $_flag_failed\0A    switch \22$cmd\22\0A        # These are the normal commands, so just complete all units.\0A        # For \22restart\22 et al, also complete non-running ones, since it can be used regardless of state.\0A        case reenable status reload {try-,}{reload-or-,}restart is-{active,enabled,failed} show cat \\\0A            help reset-failed list-dependencies list-units revert add-{wants,requires} edit clean thaw\0A        case enable\0A            # This will only work for \22list-unit-files\22, but won't print an error for \22list-units\22.\0A            set -q _flag_state; or set _flag_state disabled\0A        case disable\0A            set -q _flag_state; or set _flag_state enabled\0A        case start\0A            # Running `start` on an already started unit isn't an _error_, but useless.\0A            set -q _flag_state; or set _flag_state dead,failed\0A        case mask\0A            set -q _flag_state; or set _flag_state loaded\0A        case unmask\0A            set -q _flag_state; or set _flag_state masked\0A        case stop kill freeze\0A            # TODO: Is \22kill\22 useful on other unit types?\0A            # Running as the catch-all, \22mounted\22 for .mount units, \22active\22 for .target.\0A            set -q _flag_state; or set _flag_state running,mounted,active\0A        case isolate set-default\0A            # These only take one unit.\0A            set -q argv[1]; and return\0A        case list-sockets\0A            set _flag_type socket\0A        case list-timers\0A            set _flag_type timer\0A        case get-default show-environment daemon-{reload,reexec} is-system-running default rescue emergency halt poweroff kexec \\\0A            suspend hibernate hybrid-sleep\0A            # Accept no arguments.\0A            return\0A        case '*'\0A            # Unknown subcommand. Since we don't want to execute just anything, return.\0A            # Note that this could also be a partial token, which is completed elsewhere.\0A            return\0A    end\0A\0A    # Add the flags back so we can pass them to our systemctl invocations.\0A    set -q _flag_type; and set passflags $passflags --type=$_flag_type\0A    set -q _flag_state; and set passflags $passflags --state=$_flag_state\0A    set -q _flag_property; and set passflags $passflags --property=$_flag_property\0A    set -q _flag_machine; and set passflags $passflags --machine=$_flag_machine\0A    set -q _flag_host; and set passflags $passflags --host=$_flag_host\0A\0A    # Output looks like\0A    # systemd-tmpfiles-clean.timer      [more whitespace] loaded    active     waiting   Daily Cleanup[...]\0A    # Use the last part as the description.\0A    systemctl --full --no-legend --no-pager --plain --all list-units $passflags | string replace -r \22(?: +(\\S+)){4}\22 \\t'$1'\0A    # We need this for disabled/static units. Also instance units without an active instance.\0A    # Output looks like\0A    # systemd-tmpfiles-clean.timer               static\0A    # Just use the state as the description, since we won't get it here.\0A    # This is an issue for units that appear in both.\0A    systemctl --full --no-legend --no-pager --plain --all list-unit-files $passflags | string replace -r \22(?: +(\\S+)){1}\22 \\t'$1'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3371 = private unnamed_addr constant [40 x i8] c"functions/__fish_systemctl_services.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3372 = private unnamed_addr constant [943 x i8] c"function __fish_systemctl_services\0A    # We don't want to complete with ANSI color codes\0A    set -lu SYSTEMD_COLORS\0A\0A    if type -q systemctl\0A        if __fish_contains_opt user\0A            systemctl --user list-unit-files --full --no-legend --no-pager --plain --type=service 2>/dev/null $argv | string split -f 1 ' '\0A            systemctl --user list-units --state=loaded --full --no-legend --no-pager --plain --type=service 2>/dev/null | string split -f 1 ' '\0A        else\0A            # list-unit-files will also show disabled units\0A            systemctl list-unit-files --full --no-legend --no-pager --plain --type=service 2>/dev/null $argv | string split -f 1 ' '\0A            # list-units will not show disabled units but will show instances (like wpa_supplicant@wlan0.service)\0A            systemctl list-units --state=loaded --full --no-legend --no-pager --plain --type=service 2>/dev/null | string split -f 1 ' '\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3373 = private unnamed_addr constant [44 x i8] c"functions/__fish_systemd_machine_images.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3374 = private unnamed_addr constant [399 x i8] c"# Like for running machines, I'm assuming machinectl doesn't allow spaces in image names\0A# This does not include the special image \22.host\22 since it isn't valid for most operations\0Afunction __fish_systemd_machine_images\0A    # We don't want to complete with ANSI color codes\0A    set -lu SYSTEMD_COLORS\0A\0A    machinectl --no-legend --no-pager list-images | while read -l a b\0A        echo $a\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3375 = private unnamed_addr constant [38 x i8] c"functions/__fish_systemd_machines.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3376 = private unnamed_addr constant [307 x i8] c"# It seems machinectl will eliminate spaces from machine names so we don't need to handle that\0Afunction __fish_systemd_machines\0A    # We don't want to complete with ANSI color codes\0A    set -lu SYSTEMD_COLORS\0A\0A    machinectl --no-legend --no-pager list --all | while read -l a b\0A        echo $a\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3377 = private unnamed_addr constant [48 x i8] c"functions/__fish_toggle_comment_commandline.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3378 = private unnamed_addr constant [1016 x i8] c"# This is meant to be bound to key sequences such as \\e#. It provides a simple way to quickly\0A# comment/uncomment the current command. This is something introduced by the Korn shell (ksh) in\0A# 1993. It allows you to capture a command in the shell history without executing it. Then\0A# retrieving the command from the shell history and removing the comment chars.\0A#\0A# This deliberately does not execute the command when removing the comment characters to give you an\0A# opportunity to modify the command. Also if the commandline is empty, the most recently commented\0A# out history item is uncommented and presented.\0A\0Afunction __fish_toggle_comment_commandline --description 'Comment/uncomment the current command'\0A    set -l cmdlines (commandline -b)\0A    if test -z \22$cmdlines\22\0A        set cmdlines (history search -p \22#\22 --max=1)\0A    end\0A    set -l cmdlines (printf '%s\\n' '#'$cmdlines | string replace -r '^##' '')\0A    commandline -r $cmdlines\0A    string match -q '#*' $cmdlines[1]\0A    and commandline -f execute\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3379 = private unnamed_addr constant [37 x i8] c"functions/__fish_tokenizer_state.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3380 = private unnamed_addr constant [2188 x i8] c"function __fish_tokenizer_state --description \22Print the state of the tokenizer at the end of the given string\22\0A    # Go through the token char-by-char in a state machine.\0A    # The states are:\0A    # - normal - no quoting is active (the starting state)\0A    # - single - open single-quote\0A    # - double - open double\0A    # - escaped - open \\\\ - the next character is non-special\0A    # - single-escaped - open \\\\ inside single-quotes\0A    # - double-escaped - open \\\\ inside double-quotes\0A\0A    argparse --min-args 1 --max-args 1 i/initial-state= -- $argv\0A    or return 1\0A\0A    set -l state normal\0A    if set -q _flag_initial_state\0A        set state $_flag_initial_state\0A    end\0A\0A    for char in (string split -- \22\22 $argv[1])\0A        switch $char\0A            case \22'\22 # single-quote\0A                switch $state\0A                    case normal single-escaped\0A                        set state single\0A                    case single\0A                        set state normal\0A                end\0A            case '\22' # double-quote\0A                switch $state\0A                    case normal double-escaped\0A                        set state double\0A                    case double\0A                        set state normal\0A                end\0A            case \\\\ # backslash escapes the next character\0A                switch $state\0A                    case double\0A                        set state double-escaped\0A                    case double-escaped\0A                        set state double\0A                    case single\0A                        set state single-escaped\0A                    case single-escaped\0A                        set state single\0A                    case normal\0A                        set state escaped\0A                    case escaped\0A                        set state normal\0A                end\0A            case \22*\22 # Any other character\0A                switch $state\0A                    case escaped\0A                        set state normal\0A                    case single-escaped\0A                        set state single\0A                    case double-escaped\0A                        set state double\0A                end\0A        end\0A    end\0A\0A    echo $state\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3381 = private unnamed_addr constant [27 x i8] c"functions/__fish_uname.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3382 = private unnamed_addr constant [127 x i8] c"function __fish_uname\0A    if not set -q __fish_uname\0A        set -g __fish_uname (uname)\0A    end\0A    echo -- $__fish_uname\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3383 = private unnamed_addr constant [36 x i8] c"functions/__fish_use_subcommand.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3384 = private unnamed_addr constant [297 x i8] c"function __fish_use_subcommand -d \22Test if a non-switch argument has been given in the current commandline\22\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        switch $i\0A            case '-*'\0A                continue\0A        end\0A        return 1\0A    end\0A    return 0\0Aend\0A", align 1
