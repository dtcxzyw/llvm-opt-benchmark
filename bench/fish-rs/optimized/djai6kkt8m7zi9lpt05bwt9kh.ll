@anon.1d0b41a8d45d477c3029ec78f9b8b434.2804 = private unnamed_addr constant [967 x i8] c"# Completions for unlz4\0A\0Acomplete -c unlz4 -k -x -a \22\0A(\0A    __fish_complete_suffix .lz4\0A)\0A\22\0A\0Acomplete -c unlz4 -s t -l test -d \22Test the integrity\22\0Acomplete -c unlz4 -l list -d \22List information about .lz4 file(s)\22\0Acomplete -r -c unlz4 -s D -d \22Use specified file as dictionary\22\0Acomplete -c unlz4 -s f -l force -d \22Overwrite without prompting\22\0Acomplete -c unlz4 -s c -l stdout -l to-stdout -d \22Force write to stdout\22\0Acomplete -c unlz4 -s m -l multiple -d \22Multiple input files\22\0Acomplete -c unlz4 -l sparse -d \22Enable sparse mode\22\0Acomplete -c unlz4 -l no-sparse -d \22Disable sparse mode\22\0Acomplete -c unlz4 -s v -l verbose -d \22Be verbose\22\0Acomplete -c unlz4 -s q -l quiet -d \22Suppress warnings\22\0Acomplete -c unlz4 -s h -l help -d \22Show help\22\0Acomplete -c unlz4 -s H -d \22Show long help\22\0Acomplete -c unlz4 -s V -l version -d \22Show version\22\0Acomplete -c unlz4 -s k -l keep -d \22Keep input file(s) (default)\22\0Acomplete -c unlz4 -l rm -d \22Remove input file(s) after decompression\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2805 = private unnamed_addr constant [22 x i8] c"completions/unrar.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2806 = private unnamed_addr constant [1311 x i8] c"function __fish_complete_unrar -d \22Peek inside of archives and list all files\22\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        switch $i\0A            case '-*'\0A                continue\0A\0A            case '*.rar'\0A                if test -f $i\0A                    set -l file_list (unrar vb $i)\0A                    printf \22%s\\tArchived file\\n\22 $file_list\0A                end\0A                return\0A        end\0A    end\0Aend\0A\0Acomplete -c unrar -a \22(__fish_complete_unrar)\22\0A\0Acomplete -x -c unrar -n __fish_use_subcommand -a e -d \22Extract files to current directory\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a l -d \22List archive\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a lt -d \22List archive (technical)\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a lb -d \22List archive (bare)\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a p -d \22Print file to stdout\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a t -d \22Test archive files\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a v -d \22Verbosely list archive\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a vt -d \22Verbosely list archive (technical)\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a vb -d \22Verbosely list archive (bare)\22\0Acomplete -x -c unrar -n __fish_use_subcommand -a x -d \22Extract files with full path\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2807 = private unnamed_addr constant [22 x i8] c"completions/unzip.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2808 = private unnamed_addr constant [2501 x i8] c"complete -c unzip -s p -d \22extract files to pipe, no messages\22\0Acomplete -c unzip -s f -d \22freshen existing files, create none\22\0Acomplete -c unzip -s u -d \22update files, create if necessary\22\0Acomplete -c unzip -s v -d \22list verbosely/show version info\22\0Acomplete -c unzip -s x -d \22exclude files that follow (in xlist)\22\0Acomplete -c unzip -s l -d \22list files (short format)\22\0Acomplete -c unzip -s t -d \22test compressed archive datamodifiers:\22\0Acomplete -c unzip -s z -d \22display archive comment only\22\0Acomplete -c unzip -s T -d \22timestamp archive to latest\22\0Acomplete -c unzip -s d -d \22extract files into dir\22 -xa '(__fish_complete_directories)'\0Acomplete -c unzip -s n -d \22never overwrite existing files\22\0Acomplete -c unzip -s o -d \22overwrite files WITHOUT prompting\22\0Acomplete -c unzip -s q -d \22quiet mode\22\0Acomplete -c unzip -o qq -d \22quieter mode\22\0Acomplete -c unzip -s a -d \22auto-convert any text files\22\0Acomplete -c unzip -s U -d \22use escapes for all non-ASCII Unicode\22\0Acomplete -c unzip -o UU -d \22ignore any Unicode fields\22\0Acomplete -c unzip -s j -d \22junk paths (do not make directories)\22\0Acomplete -c unzip -s aa -d \22treat ALL files as text\22\0Acomplete -c unzip -s C -d \22match filenames case-insensitively\22\0Acomplete -c unzip -s L -d \22make (some) names lowercase\22\0Acomplete -c unzip -s X -d \22restore UID/GID info\22\0Acomplete -c unzip -s V -d \22retain VMS version numbers\22\0Acomplete -c unzip -s K -d \22keep setuid/setgid/tacky permissions\22\0Acomplete -c unzip -s M -d \22pipe through `more` pager\22\0A# Some distros have -O and -I, some don't.\0A# Even \22-h\22 might not be available.\0Aif unzip -h 2>/dev/null | string match -rq -- -O\0A    complete -c unzip -s O -d \22specify a character encoding for DOS, Windows and OS/2 archives\22 -x -a \22(__fish_print_encodings)\22\0Aend\0Aif unzip -h 2>/dev/null | string match -rq -- -I\0A    complete -c unzip -s I -d \22specify a character encoding for UNIX and other archives\22 -x -a \22(__fish_print_encodings)\22\0Aend\0A\0A# Debian version of unzip\0Aif unzip -v 2>/dev/null | string match -eq Debian\0A\0A    # the first non-switch argument should be the zipfile\0A    complete -c unzip -n \22__fish_is_nth_token 1\22 -k -xa '(__fish_complete_suffix .zip .jar .aar)'\0A\0A    # Files thereafter are either files to include or exclude from the operation\0A    complete -c unzip -n 'not __fish_is_nth_token 1' -xa '(unzip -l (__fish_first_token) 2>/dev/null | string replace -r --filter \22.*:\\S+\\s+(.*)\22 \22\\$1\22)'\0A\0Aelse\0A\0A    # all tokens should be zip files\0A    complete -c unzip -k -xa '(__fish_complete_suffix .zip .jar .aar)'\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2809 = private unnamed_addr constant [23 x i8] c"completions/unzstd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2810 = private unnamed_addr constant [1584 x i8] c"# Completions for unzstd\0A\0Acomplete -c unzstd -k -x -a \22\0A(\0A    __fish_complete_suffix .zst\0A)\0A\22\0A\0Acomplete -c unzstd -s t -l test -d \22Test the integrity\22\0Acomplete -r -c unzstd -l train -d \22Create a dictionary from specified file(s)\22\0Acomplete -c unzstd -s l -l list -d \22List information about .zst file(s)\22\0Acomplete -c unzstd -l long -d \22Enable long distance matching with specified windowLog\22\0Acomplete -c unzstd -l single-thread -d \22Single-thread mode\22\0Acomplete -r -c unzstd -s D -d \22Use specified file as dictionary\22\0Acomplete -r -c unzstd -s o -d \22Specify file to save\22\0Acomplete -c unzstd -s f -l force -d \22Overwrite without prompting\22\0Acomplete -c unzstd -s c -l stdout -d \22Force write to stdout\22\0Acomplete -c unzstd -l sparse -d \22Enable sparse mode\22\0Acomplete -c unzstd -l no-sparse -d \22Disable sparse mode\22\0Acomplete -c unzstd -l rm -d \22Remove input file(s) after decompression\22\0Acomplete -c unzstd -s k -l keep -d \22Keep input file(s) (default)\22\0Acomplete -c unzstd -s r -d \22Recurse directories\22\0Acomplete -c unzstd -l filelist -d \22Read a list of files\22\0Acomplete -c unzstd -l output-dir-flat -d \22Specify a directory to output all files\22\0A\0Afor format in zstd gzip xz lzma lz4\0A    complete -c unzstd -l format=\22$format\22 -d \22Specify the format to use for decompression\22\0Aend\0A\0Acomplete -c unzstd -s h -l help -d \22Show help\22\0Acomplete -c unzstd -s H -d \22Show long help\22\0Acomplete -c unzstd -s V -l version -d \22Show version\22\0Acomplete -c unzstd -s v -l verbose -d \22Be verbose\22\0Acomplete -c unzstd -s q -l quiet -d \22Suppress warnings\22\0Acomplete -c unzstd -l no-progress -d \22Do not show the progress bar\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2811 = private unnamed_addr constant [34 x i8] c"completions/update-eix-remote.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2812 = private unnamed_addr constant [895 x i8] c"# Completions for the eix tool's update-eix-remote command\0A# http://dev.croup.de/proj/eix and http://sourceforge.net/projects/eix/\0A\0A# Author: Tassilo Horn <tassilo@member.fsf.org>\0A\0A##########\0A# UPDATE-EIX-REMOTE\0A# Options\0Acomplete -c update-eix-remote -s q -d \22Be quiet\22\0Acomplete -c update-eix-remote -s v -d \22Be verbose (default)\22\0Acomplete -c update-eix-remote -s u -xa '(__fish_print_users)' -d \22Call wget as the given USER\22\0Acomplete -c update-eix-remote -s o -d \22Use the given PATH as $OVERLAYPARENT\22\0A\0A# Subcommands\0Aset -l subcmds \22\0A\22\0Acomplete -c update-eix-remote -xa \\\0A    'update\\t\22Fetch the eix-caches of some layman overlays into a temporary file resp. into FILE and add them to the eix database\22\0A   fetch\\t\22Only fetch the overlays into FILE\22\0A   add\\t\22Only add the overlays from FILE to the eix database\22\0A   remove\\t\22Remove all temporarily added virtual overlays from the eix database\22'\0A", align 1
