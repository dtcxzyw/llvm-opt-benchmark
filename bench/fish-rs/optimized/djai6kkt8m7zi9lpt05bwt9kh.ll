l -l max-lpc-order -d \22Max LPC order; 0 => only fixed predictors\22\0Acomplete -c flac -s p -l qlp-coeff-precision-search -d \22Exhaustively search LP coeff quantization\22\0Acomplete -c flac -x -s q -l qlp-coeff-precision -d \22Specify precision in bits\22\0Acomplete -c flac -x -s r -l rice-partition-order -d \22Set [min,]max residual partition order\22\0A\0Acomplete -c flac -l endian=big -d \22Set byte order for samples\22\0Acomplete -c flac -l endian=little -d \22Set byte order for samples\22\0Acomplete -c flac -l channels -d \22Number of channels\22\0Acomplete -c flac -l bps -d \22Number of bits per sample\22\0Acomplete -c flac -l sample-rate -d \22Sample rate in Hz\22\0Acomplete -c flac -l sign=unsigned -d \22Sign of samples\22\0Acomplete -c flac -l sign=signed -d \22Sign of samples\22\0Acomplete -c flac -l input-size -d \22Size of the raw input in bytes\22\0Acomplete -c flac -l force-aiff-format -d \22Force decoding to AIFF format\22\0Acomplete -c flac -l force-raw-format -d \22Treat input or output as raw samples\22\0A\0Acomplete -c flac -l no-adaptive-mid-side -d \22No adaptive mid-side coding for all frames\22\0Acomplete -c flac -l no-decode-through-errors -d \22Don't continue decoding through stream errors\22\0Acomplete -c flac -l no-delete-input-file -d \22Don't delete after a successful encode/decode\22\0Acomplete -c flac -l no-exhaustive-model-search -d \22No exhaustive model search\22\0Acomplete -c flac -l no-lax -d \22Don't allow encoder to generate non-Subset files\22\0Acomplete -c flac -l no-mid-side -d \22Don't try mid-side coding for each frame\22\0Acomplete -c flac -l no-ogg -d \22Don't use Ogg as transport layer\22\0Acomplete -c flac -l no-padding -d \22Don't write a PADDING block of length #\22\0Acomplete -c flac -l no-qlp-coeff-prec-search -d \22Don't exhaustively search LP coeff quantization\22\0Acomplete -c flac -l no-replay-gain -d \22Don't calculate ReplayGain & store in Vorbis comments\22\0Acomplete -c flac -l no-residual-gnuplot -d \22Don't generate gnuplot files of residual distribution\22\0Acomplete -c flac -l no-residual-text -d \22Don't include residual signal in text output\22\0Acomplete -c flac -l no-sector-align -d \22Don't align multiple files on sector boundaries\22\0Acomplete -c flac -l no-seektable\0Acomplete -c flac -l no-silent -d \22Write runtime encode/decode statistics\22\0Acomplete -c flac -l no-force -d \22Don't force overwriting of output files\22\0Acomplete -c flac -l no-verify -d \22Don't verify a correct encoding\22\0A", align 1
