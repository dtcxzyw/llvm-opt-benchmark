l)\0A                    fish_config theme demo\0A\0A                    for t in $themes\0A                        not test -e \22$t\22\0A                        and continue\0A\0A                        set -l themename (string replace -r '.*/([^/]*).theme$' '$1' $t)\0A                        contains -- $themename $used_themes\0A                        and continue\0A                        set -a used_themes $themename\0A\0A                        echo -s (set_color normal; set_color --underline) $themename (set_color normal)\0A\0A                        # Use a new, --no-config, fish to display the theme.\0A                        # So we can use this function, explicitly source it before anything else!\0A                        functions fish_config | $fish -C \22source -\22 --no-config -c '\0A                        fish_config theme choose $argv\0A                        fish_config theme demo $argv\0A                        ' $themename\0A                    end\0A\0A                case choose save\0A                    if set -q argv[2]\0A                        echo \22Too many arguments\22 >&2\0A                        return 1\0A                    end\0A                    # The name of the theme to save *from* is optional for `fish_config theme save`\0A                    if not set -q argv[1] && contains -- $cmd choose\0A                        echo \22Too few arguments\22 >&2\0A                        return 1\0A                    end\0A\0A                    set -l scope -g\0A                    set -l have_colors\0A\0A                    if contains -- $cmd save\0A                        read -P\22Overwrite your current theme? [y/N] \22 -l yesno\0A                        if not string match -riq 'y(es)?' -- $yesno\0A                            echo Not overwriting >&2\0A                            return 1\0A                        end\0A                        set scope -U\0A                    end\0A\0A                    set -l known_colors fish_color_{normal,command,keyword,quote,redirection,\\\0A                        end,error,param,option,comment,selection,operator,escape,autosuggestion,\\\0A                        cwd,user,host,host_remote,cancel,search_match} \\\0A                        fish_pager_color_{progress,background,prefix,completion,description,\\\0A                        selected_background,selected_prefix,selected_completion,selected_description,\\\0A                        secondary_background,secondary_prefix,secondary_completion,secondary_description}\0A\0A                    # If we are choosing a theme or saving from a named theme, load the theme now.\0A                    # Otherwise, we'll persist the currently loaded/themed variables (in case of `theme save`).\0A                    if set -q argv[1]\0A                        set -l files $dirs/$argv[1].theme\0A                        set -l file\0A\0A                        for f in $files\0A                            if test -e \22$f\22\0A                                set file $f\0A                                break\0A                            end\0A                        end\0A\0A                        if not set -q file[1]\0A                            if status list-files tools/web_config/themes/$argv[1].theme &>/dev/null\0A                                set file tools/web_config/themes/$argv[1].theme\0A                            else\0A                                echo \22No such theme: $argv[1]\22 >&2\0A                                echo \22Searched directories: $dirs\22 >&2\0A                                return 1\0A                            end\0A                        end\0A\0A                        set -l content\0A                        if string match -qr '^tools/' -- $file\0A                            set content (status get-file $file)\0A                        else\0A                            read -z content < $file\0A                        end\0A\0A                        printf %s\\n $content | while read -lat toks\0A                            # The whitelist allows only color variables.\0A                            # Not the specific list, but something named *like* a color variable.\0A                            # This also takes care of empty lines and comment lines.\0A                            string match -rq -- $theme_var_filter $toks[1]\0A                            or continue\0A\0A                            # If we're supposed to set universally, remove any shadowing globals\0A                            # so the change takes effect immediately (and there's no warning).\0A                            if test x\22$scope\22 = x-U; and set -qg $toks[1]\0A                                set -eg $toks[1]\0A                            end\0A                            set $scope $toks\0A                            set -a have_colors $toks[1]\0A                        end\0A\0A                        # Set all colors that aren't mentioned to empty\0A                        for c in $known_colors\0A                            contains -- $c $have_colors\0A                            and continue\0A\0A                            # Erase conflicting global variables so we don't get a warning and\0A                            # so changes are observed immediately.\0A                            set -eg $c\0A                            set $scope $c\0A                        end\0A                    else\0A                        # We're persisting whatever current colors are loaded (maybe in the global scope)\0A                        # to the universal scope, without overriding them from a theme file.\0A                        # Like above, make sure to erase from other scopes first and ensure known color\0A                        # variables are defined, even if empty.\0A                        # This branch is only reachable in the case of `theme save` so $scope is always `-U`.\0A\0A                        for color in (printf \22%s\\n\22 $known_colors (set --names | string match -r $theme_var_filter) | sort -u)\0A                            if set -q $color\0A                                # Cache the value from whatever scope currently defines it\0A                                set -l value $$color\0A                                set -eg $color\0A                                set -U $color $value\0A                            end\0A                        end\0A                    end\0A\0A                    # If we've made it this far, we've either found a theme file or persisted the current\0A                    # state (if any). In all cases we haven't failed, so return 0.\0A                    return 0\0A                case dump\0A                    # Write the current theme in .theme format, to stdout.\0A                    set -L | string match -r $theme_var_filter\0A                case '*'\0A                    echo \22No such command: $cmd\22 >&2\0A                    return 1\0A            end\0A    end\0Aend\0A", align 1
