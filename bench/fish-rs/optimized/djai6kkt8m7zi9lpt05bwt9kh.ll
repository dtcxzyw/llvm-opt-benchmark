@anon.1d0b41a8d45d477c3029ec78f9b8b434.2248 = private unnamed_addr constant [1166 x i8] c"if test (uname) = Darwin # OS X\0A    complete -c open -s a -d 'specify app name' -r -a \22(mdfind -onlyin /Applications -onlyin ~/Applications -onlyin /System/Applications -onlyin /Developer/Applications 'kMDItemContentType==com.apple.application-*' | string replace -r '.+/(.+).app' '\\$1')\22\0A    complete -c open -s b -d 'specify app bundle id' -x -a \22(mdls (mdfind -onlyin /Applications -onlyin ~/Applications -onlyin /System/Applications -onlyin /Developer/Applications 'kMDItemContentType==com.apple.application-*') -name kMDItemCFBundleIdentifier | string replace -rf 'kMDItemCFBundleIdentifier = \\\22(.+)\\\22' '\\$1')\22\0A    complete -c open -s e -d 'open in TextEdit'\0A    complete -c open -s t -d 'open in default editor'\0A    complete -c open -s f -d 'open stdin with editor'\0A    complete -c open -s F -d 'open app with fresh state'\0A    complete -c open -s W -d 'wait for app to exit'\0A    complete -c open -s R -d 'reveal in Finder'\0A    complete -c open -s n -d 'open new instance of app'\0A    complete -c open -s g -d 'open app in background'\0A    complete -c open -s h -d 'open library header file' -r\0A    complete -c open -l args -d 'pass remaining args to app' -x\0Aend\0A", align 1
