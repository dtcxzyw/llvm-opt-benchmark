@anon.1d0b41a8d45d477c3029ec78f9b8b434.1452 = private unnamed_addr constant [2506 x i8] c"# Fish completions for gnome's \22dconf\22 configuration tool\0A\0Afunction __fish_dconf_keys\0A    set -l dir\0A    set -l key\0A    # We parse the `dump` output instead of `list`\0A    # because it allows us to complete non-incrementally\0A    # i.e. to get the keys directly, without going through\0A    # `dconf list /`, `dconf list /org/` and so on.\0A    dconf dump / 2>/dev/null | while read -l line\0A        if string match -q \22[*]\22 -- $line\0A            # New directory - just save it for the keys\0A            set dir /(string trim -c \22[]\22 -- $line)\0A        else if test -n \22$line\22\0A            # New key - output with the dir prepended.\0A            echo $dir/(string replace -r '=.*' '' -- $line)\0A        end\0A    end\0Aend\0A\0A### Commands\0Aset -l commands read list write reset compile update watch dump load help\0A\0Acomplete -f -c dconf\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a read -d 'Read the value of a key'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a list -d 'List the sub-keys and sub-directories of a directory'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a write -d 'Write a new value to a key'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a reset -d 'Delete a key or an entire directory'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a compile -d 'Compile a binary database from keyfiles'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a update -d 'Update the system dconf databases'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a watch -d 'Watch a key or directory for changes'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a dump -d 'Dump an entire subpath to stdout'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a load -d 'Populate a subpath from stdin'\0Acomplete -f -c dconf -n \22not __fish_seen_subcommand_from $commands\22 -a help -d 'Display help and exit'\0A\0A### Arguments to commands\0A# Technically, reset/watch take a \22PATH\22 (which is a dir or a key)\0A# while read and write take a KEY, but for now this is close enough.\0Acomplete -f -c dconf -n \22__fish_seen_subcommand_from read write reset watch\22 -a \22(__fish_dconf_keys)\22\0A# List/dump/load take a dir, which is something that ends in a \22/\22\0Acomplete -f -c dconf -n \22__fish_seen_subcommand_from list dump load\22 -a \22(__fish_dconf_keys | string replace -r '/[^/]*\\$' '/')\22\0A\0Acomplete -f -c dconf -n \22__fish_seen_subcommand_from help\22 -a \22$commands\22\0A", align 1
