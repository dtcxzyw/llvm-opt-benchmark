@anon.1d0b41a8d45d477c3029ec78f9b8b434.1258 = private unnamed_addr constant [12393 x i8] c"# Completion for bundler\0A\0Afunction __fish_bundle_no_command -d 'Test if bundle has been given no subcommand'\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_bundle_using_command -d 'Test if bundle has been given a specific subcommand'\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_bundled_gems\0A    bundle list | sed '1 d' | sed -e 's/\\*//g' -e 's/(.*)//g' -e 's/^ *//g' -e 's/ *$//g'\0Aend\0A\0A# Options for all commands\0Acomplete -c bundle -s r -l retry -d 'Specify the number of times you wish to attempt network commands'\0Acomplete -c bundle -l no-color -d 'Disable colorization in output'\0Acomplete -c bundle -s V -l verbose -d 'Enable verbose output mode'\0A\0A# No command\0Acomplete -f -n __fish_bundle_no_command -c bundle -l help -d 'Display a help page'\0Acomplete -c bundle -s v -l version -d 'Prints version information'\0A\0A##\0A# Primary Commands\0A##\0A\0A# Install\0Acomplete -f -n __fish_bundle_no_command -c bundle -a install -d 'Install the gems specified by the Gemfile or Gemfile.lock'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l gemfile -d 'The location of the Gemfile bundler should use'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l path -d 'The location to install the gems in the bundle to'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l system -d 'Installs the gems in the bundle to the system location'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l without -d 'A space-separated list of groups to skip installing'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l local -d 'Use cached gems instead of connecting to rubygems.org'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l deployment -d \22Switches bundler's defaults into deployment mode.\22\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l binstubs -d 'Create a directory containing executables that run in the context of the bundle'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l shebang -d 'Specify a ruby executable to use with generated binstubs'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l standalone -d 'Make a bundle that can work without RubyGems or Bundler at run-time'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -s P -l trust-policy -d 'Apply a RubyGems security policy: {High,Medium,Low,No}Security'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -s j -l jobs -d 'Install gems parallelly by starting size number of parallel workers'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l no-cache -d 'Do not update the cache in vendor/cache with the newly bundled gems'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l quiet -d 'Do not print progress information to stdout'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l clean -d 'Run bundle clean automatically after install'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l full-index -d 'Use the rubygems modern index instead of the API endpoint'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l no-prune -d 'Do not remove stale gems from the cache'\0Acomplete -f -n '__fish_bundle_using_command install' -c bundle -l frozen -d 'Do not allow the Gemfile.lock to be updated after this install'\0A\0A# Update\0Acomplete -f -n __fish_bundle_no_command -c bundle -a update -d 'Update dependencies to their latest versions'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -l source -d 'The name of a :git or :path source used in the Gemfile'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -l local -d 'Do not attempt to fetch gems remotely and use the gem cache instead'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -l quiet -d 'Only output warnings and errors'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -l full-index -d 'Use the rubygems modern index instead of the API endpoint'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -s j -l jobs -d 'Specify the number of jobs to run in parallel'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -s g -l group -d 'Update a specific group'\0Acomplete -f -n '__fish_bundle_using_command update' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Package\0Acomplete -f -n __fish_bundle_no_command -c bundle -a package -d 'Package the .gem files into vendor/cache directory'\0A\0A# Binstubs\0Acomplete -f -n __fish_bundle_no_command -c bundle -a binstubs -d 'Install the binstubs of the listed gem'\0Acomplete -f -n '__fish_bundle_using_command binstubs' -c bundle -l path -d 'Binstub destination directory (default bin)'\0Acomplete -f -n '__fish_bundle_using_command binstubs' -c bundle -l force -d 'Overwrite existing binstubs if they exist'\0Acomplete -f -n '__fish_bundle_using_command binstubs' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Exec\0Acomplete -f -n __fish_bundle_no_command -c bundle -a exec -d 'Execute a script in the context of the current bundle'\0Acomplete -f -n '__fish_bundle_using_command exec' -c bundle -l keep-file-descriptors -d 'Exec runs a command, providing it access to the gems in the bundle'\0A\0A# Help\0Acomplete -f -n __fish_bundle_no_command -c bundle -a help -d 'Describe available tasks or one specific task'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a install -d 'Install the gems specified by the Gemfile or Gemfile.lock'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a update -d 'Update dependencies to their latest versions'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a package -d 'Package .gem files into the vendor/cache directory'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a exec -d 'Execute a script in the context of the current bundle'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a config -d 'Specify and read configuration options for bundler'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a check -d 'Check bundler requirements for your application'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a list -d 'Show all of the gems in the current bundle'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a show -d 'Show the source location of a particular gem in the bundle'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a outdated -d 'Show all of the outdated gems in the current bundle'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a console -d 'Start an IRB session in the context of the current bundle'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a open -d 'Open an installed gem in your $EDITOR'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a viz -d 'Generate a visual representation of your dependencies'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a init -d 'Generate a simple Gemfile'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a gem -d 'Create a simple gem, suitable for development with bundler'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a platform -d 'Displays platform compatibility information'\0Acomplete -f -n '__fish_bundle_using_command help' -c bundle -a cleanup -d 'Cleans up unused gems in your bundler directory'\0A\0A##\0A# Utilities\0A##\0A\0A# Check\0Acomplete -f -n __fish_bundle_no_command -c bundle -a check -d 'Check if the requirements are installed and available to bundler'\0Acomplete -f -n '__fish_bundle_using_command check' -c bundle -l gemfile -d 'The location of the Gemfile bundler should use'\0Acomplete -f -n '__fish_bundle_using_command check' -c bundle -l path -d 'Specify a path other than the system default (BUNDLE_PATH or GEM_HOME)'\0Acomplete -f -n '__fish_bundle_using_command check' -c bundle -l dry-run -d 'Lock the Gemfile'\0A\0A# List\0Acomplete -f -n __fish_bundle_no_command -c bundle -a list -d 'Show lists the names and versions of all gems that are required by your Gemfile'\0Acomplete -f -n '__fish_bundle_using_command list' -c bundle -l paths -d 'List the paths of all gems required by your Gemfile'\0Acomplete -f -n '__fish_bundle_using_command list' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Show\0Acomplete -f -n __fish_bundle_no_command -c bundle -a show -d 'Show lists the names and versions of all gems that are required by your Gemfile'\0Acomplete -f -n '__fish_bundle_using_command show' -c bundle -l paths -d 'List the paths of all gems required by your Gemfile'\0Acomplete -f -n '__fish_bundle_using_command show' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Outdated\0Acomplete -f -n __fish_bundle_no_command -c bundle -a outdated -d 'Show all of the outdated gems in the current bundle'\0Acomplete -f -n '__fish_bundle_using_command outdated' -c bundle -l pre -d 'Check for newer pre-release gems'\0Acomplete -f -n '__fish_bundle_using_command outdated' -c bundle -l source -d 'Check against a specific source'\0Acomplete -f -n '__fish_bundle_using_command outdated' -c bundle -l local -d 'Use cached gems instead of attempting to fetch gems remotely'\0Acomplete -f -n '__fish_bundle_using_command outdated' -c bundle -l strict -d 'Only list newer versions allowed by your Gemfile requirements'\0Acomplete -f -n '__fish_bundle_using_command outdated' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Console\0Acomplete -f -n __fish_bundle_no_command -c bundle -a console -d 'Start an IRB session in the context of the current bundle'\0A\0A# Open\0Acomplete -f -n __fish_bundle_no_command -c bundle -a open -d 'Open an installed gem in your $EDITOR'\0Acomplete -f -n '__fish_bundle_using_command open' -c bundle -a '(__fish_bundled_gems)'\0A\0A# Viz\0Acomplete -f -n __fish_bundle_no_command -c bundle -a viz -d 'Generate a visual representation of your dependencies'\0Acomplete -f -n '__fish_bundle_using_command viz' -c bundle -s f -l file -d 'The name to use for the generated file (see format option)'\0Acomplete -f -n '__fish_bundle_using_command viz' -c bundle -s v -l version -d 'Show each gem version'\0Acomplete -f -n '__fish_bundle_using_command viz' -c bundle -s r -l requirements -d 'Show the version of each required dependency'\0Acomplete -f -n '__fish_bundle_using_command viz' -c bundle -s F -l format -d 'Output a specific format (png, jpg, svg, dot, \E2\80\A6)'\0A\0A# Init\0Acomplete -f -n __fish_bundle_no_command -c bundle -a init -d 'Generate a simple Gemfile, placed in the current directory'\0Acomplete -f -n '__fish_bundle_using_command init' -c bundle -l gemspec -d 'Use a specified .gemspec to create the Gemfile'\0A\0A# Gem\0Acomplete -f -n __fish_bundle_no_command -c bundle -a gem -d 'Create a simple gem, suitable for development with bundler'\0Acomplete -f -n '__fish_bundle_using_command gem' -c bundle -s b -l bin -d 'Generate a binary for your library'\0Acomplete -f -n '__fish_bundle_using_command gem' -c bundle -s t -l test -d 'Generate a test directory for your library (rspec or minitest)'\0Acomplete -f -n '__fish_bundle_using_command gem' -c bundle -s e -l edit -d 'Path to your editor'\0Acomplete -f -n '__fish_bundle_using_command gem' -c bundle -l ext -d 'Generate the boilerplate for C extension code'\0A\0A# Platform\0Acomplete -f -n __fish_bundle_no_command -c bundle -a platform -d 'Displays platform compatibility information'\0Acomplete -f -n '__fish_bundle_using_command platform' -c bundle -l ruby -d 'Only display Ruby directive information'\0A\0A# Clean\0Acomplete -f -n __fish_bundle_no_command -c bundle -a clean -d 'Cleans up unused gems in your bundler directory'\0Acomplete -f -n '__fish_bundle_using_command clean' -c bundle -l dry-run -d 'Only print out changes, do not actually clean gems'\0Acomplete -f -n '__fish_bundle_using_command clean' -c bundle -l force -d 'Forces clean even if --path is not set'\0A\0A# Cache\0Acomplete -f -n __fish_bundle_no_command -c bundle -a cache -d 'Cache all the gems to vendor/cache'\0Acomplete -f -n '__fish_bundle_using_command cache' -c bundle -l no-prune -d 'Do not remove stale gems from the cache'\0Acomplete -f -n '__fish_bundle_using_command cache' -c bundle -l all -d 'Include all sources (including path and git)'\0A\0A# Licenses\0Acomplete -f -n __fish_bundle_no_command -c bundle -a licenses -d 'Prints the license of all gems in the bundle'\0A\0A# Env\0Acomplete -f -n __fish_bundle_no_command -c bundle -a env -d 'Print information about the environment Bundler is running under'\0A", align 1
