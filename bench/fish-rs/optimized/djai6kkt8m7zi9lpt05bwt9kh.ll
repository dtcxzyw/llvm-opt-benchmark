@anon.1d0b41a8d45d477c3029ec78f9b8b434.1784 = private unnamed_addr constant [3876 x i8] c"function __fish_guile__complete_srfis\0A    printf '%s\\n' 0\\t'cond-expand' \\\0A        1\\t'List library' \\\0A        2\\t'and-let*' \\\0A        4\\t'Homogeneous numeric vector datatypes' \\\0A        6\\t'Basic String Ports' \\\0A        8\\t'receive' \\\0A        9\\t'define-record-type' \\\0A        10\\t'Hash-Comma Reader Extension' \\\0A        11\\t'let-values' \\\0A        13\\t'String Library' \\\0A        14\\t'Character-set Library' \\\0A        16\\t'case-lambda' \\\0A        17\\t'Generalized set!' \\\0A        18\\t'Multithreading support' \\\0A        19\\t'Time/Date Library' \\\0A        23\\t'Error Reporting' \\\0A        26\\t'specializing parameters' \\\0A        27\\t'Sources of Random Bits' \\\0A        28\\t'Basic Format Strings' \\\0A        30\\t'Nested Multi-line Comments' \\\0A        31\\t'A special form \E2\80\98rec\E2\80\99 for recursive evaluation' \\\0A        34\\t'Exception handling for programs' \\\0A        35\\t'Conditions' \\\0A        37\\t'args-fold' \\\0A        38\\t'External Representation for Data With Shared Structure' \\\0A        39\\t'Parameters' \\\0A        41\\t'Streams' \\\0A        42\\t'Eager Comprehensions' \\\0A        43\\t'Vector Library' \\\0A        45\\t'Primitives for Expressing Iterative Lazy Algorithms' \\\0A        46\\t'Basic syntax-rules Extensions' \\\0A        55\\t'Requiring Features' \\\0A        60\\t'Integers as Bits' \\\0A        61\\t'A more general cond clause' \\\0A        62\\t'S-expression comments' \\\0A        64\\t'A Scheme API for test suites' \\\0A        67\\t'Compare procedures' \\\0A        69\\t'Basic hash tables' \\\0A        71\\t'Extended let-syntax for multiple values' \\\0A        87\\t'in case clauses' \\\0A        88\\t'Keyword Objects' \\\0A        98\\t'Accessing environment variables' \\\0A        105\\t'Curly-infix expressions' \\\0A        111\\t'Boxes' \\\0A        119\\t'Wisp: simpler indentation-sensitive Scheme'\0Aend\0A\0Afunction __fish_guile__complete_function_names\0A    set -l path (commandline -poc |\0A        string match --regex '.*\\\\.scm$' |\0A        sed -n 1p)\0A\0A    test -e \22$path\22 && begin\0A        cat $path |\0A            string match --all --groups-only --regex '\\(\\s*define\\s+\\(\\s*(\\w+)'\0A    end\0Aend\0A\0Aset -l command guile\0Acomplete -c $command -f\0A\0Acomplete -c $command -s h -l help -d 'Show help'\0Acomplete -c $command -s v -l version -d 'Show version'\0Acomplete -c $command -s s -F -r -d 'Specify the script to run'\0Acomplete -c $command -s c -x -d 'Specify the code to run'\0A\0Acomplete -c $command -s L -F -r \\\0A    -d 'Specify the directory to prepend to module load path'\0A\0Acomplete -c $command -s C -F -r \\\0A    -d 'Specify the directory to prepend to module load path for compiled files'\0A\0Acomplete -c $command -s x -x \\\0A    -a '.scm\\tdefault' \\\0A    -d 'Specify the extension to prepend to extension list'\0A\0Acomplete -c $command -s l -F -r -d 'Specify the script to load'\0A\0Acomplete -c $command -s e -x \\\0A    -a '(__fish_guile__complete_function_names)' \\\0A    -d 'Specify the entry point of a script'\0A\0Acomplete -c $command -o ds \\\0A    -d 'Treat the last -s option as if it occurred at this point'\0A\0Acomplete -c $command -l use-srfi \\\0A    -a '(__fish_complete_list , __fish_guile__complete_srfis)' \\\0A    -d 'Specify the SRFI modules to load'\0A\0Afor standard in 6 7\0A    set -l option r$standard\22rc\22\0A\0A    complete -c $command -l $option \\\0A        -d \22Use $(string upper -- $option) compatible mode\22\0Aend\0A\0Acomplete -c $command -l debug -d 'Use debug mode'\0Acomplete -c $command -l no-debug -d \22Don't use debug mode\22\0Acomplete -c $command -s q -d \22Don't load .guile file\22\0A\0Acomplete -c $command -l listen \\\0A    -a '37146\\tdefault' \\\0A    -d 'Specify the port to list to'\0A\0Acomplete -c $command -l auto-compile -d 'Compile scripts automatically'\0A\0Acomplete -c $command -l fresh-auto-compile \\\0A    -d 'Compile scripts automatically forcefully'\0A\0Acomplete -c $command -l no-auto-compile -d \22Don't compile scripts automatically\22\0A\0Acomplete -c $command -l language \\\0A    -a 'scheme\\tdefault elisp ecmascript' \\\0A    -d 'Specify the language for sources'\0A", align 1
