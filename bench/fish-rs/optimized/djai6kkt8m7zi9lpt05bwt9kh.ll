@anon.1d0b41a8d45d477c3029ec78f9b8b434.3498 = private unnamed_addr constant [2564 x i8] c"function ls --description \22List contents of directory\22\0A    # Make ls use colors and show indicators if we are on a system that supports that feature and writing to stdout.\0A    #\0A\0A    # BSD, macOS and others support colors with ls -G.\0A    # GNU ls and FreeBSD ls takes --color=auto. Order of this test is important because ls also takes -G but it has a different meaning.\0A    # Solaris 11's ls command takes a --color flag.\0A    # OpenBSD requires the separate colorls program for color support.\0A    # Also test -F because we'll want to define this function even with an ls that can't do colors (like NetBSD).\0A    if not set -q __fish_ls_command\0A        set -g __fish_ls_command ls\0A        set -g __fish_ls_color_opt\0A        set -g __fish_ls_indicators_opt\0A        # OpenBSD ships a command called \22colorls\22 that takes \22-G\22 and \22-F\22,\0A        # but there's also a ruby implementation that doesn't understand \22-F\22.\0A        # Since that one's quite different, don't use it.\0A        if command -sq colorls\0A            and command colorls -GF >/dev/null 2>/dev/null\0A            set -g __fish_ls_command colorls\0A            set -g __fish_ls_color_opt -G\0A            set -g __fish_ls_indicators_opt -F\0A        else\0A            for opt in --color=auto -G --color\0A                if command ls $opt / >/dev/null 2>/dev/null\0A                    set -g __fish_ls_color_opt $opt\0A                    break\0A                end\0A            end\0A\0A            if command ls -F / >/dev/null 2>/dev/null\0A                set -g __fish_ls_indicators_opt -F\0A            end\0A        end\0A    end\0A\0A    set -l indicators_opt\0A    isatty stdout\0A    and set -a indicators_opt $__fish_ls_indicators_opt\0A\0A    # Terminal.app doesn't set $COLORTERM or $CLICOLOR,\0A    # but the new FreeBSD ls requires either to be set,\0A    # before it will enable color.\0A    # See #8309.\0A    # We don't set $COLORTERM because that should be set to\0A    # \22truecolor\22 or similar and we don't want to specify that here.\0A    test \22$TERM_PROGRAM\22 = Apple_Terminal\0A    and set -lx CLICOLOR 1\0A\0A    # If CLICOLOR_FORCE is set, don't colorize `ls` (if piped) because the results\0A    # might not be what we want; i.e. `ls --color=auto | cat` might still emit color\0A    # output (e.g. under BSD and macOS).\0A    # We don't just unset CLICOLOR_FORCE because the user might theoretically *want*\0A    # this behavior by explicitly including `--color=auto` in $argv themselves.\0A    set -qx CLICOLOR_FORCE && not isatty stdout; and set __fish_ls_color_opt\0A\0A    command $__fish_ls_command $__fish_ls_color_opt $indicators_opt $argv\0Aend\0A", align 1
