@anon.1d0b41a8d45d477c3029ec78f9b8b434.2916 = private unnamed_addr constant [1945 x i8] c"#\0A#Completions for xargs\0A#\0A\0Acomplete -c xargs -n __fish_is_first_token -s 0 -l null -d \22Terminate filenames with a \\0 instead of whitespace, ignore quotes and backslash\22\0Acomplete -c xargs -n __fish_is_first_token -s e -l eof -d \22Set the end of file string to eof-str\22\0Acomplete -c xargs -n __fish_is_first_token -s E -r -f -d \22Set the end of file string to eof-str\22\0Acomplete -c xargs -n __fish_is_first_token -l help -d \22Display help and exit\22\0Acomplete -c xargs -n __fish_is_first_token -s i -l replace -d \22Replace replace-str in the initial arguments with names from standard input\22\0Acomplete -c xargs -n __fish_is_first_token -s I -r -f -d \22Replace replace-str in the initial arguments with names from standard input\22\0Acomplete -c xargs -n __fish_is_first_token -s l -l max-lines -d \22Use at most max-lines nonblank input lines per command line\22\0Acomplete -c xargs -n __fish_is_first_token -s L -r -f -d \22Use at most max-lines nonblank input lines per command line\22\0Acomplete -c xargs -n __fish_is_first_token -s n -l max-args -r -f -d \22Use at most max-args arguments per command line\22\0Acomplete -c xargs -n __fish_is_first_token -s p -l interactive -d \22Prompt the user before running each command line\22\0Acomplete -c xargs -n __fish_is_first_token -s r -l no-run-if-empty -d \22If the standard input does not contain any nonblanks, do not run the command\22\0Acomplete -c xargs -n __fish_is_first_token -s s -l max-chars -r -f -d \22Use at most max-chars characters per command line\22\0Acomplete -c xargs -n __fish_is_first_token -s t -l verbose -d \22Print the command line on the standard error output before executing it\22\0Acomplete -c xargs -n __fish_is_first_token -l version -d \22Display version and exit\22\0Acomplete -c xargs -n __fish_is_first_token -s x -l exit -d \22Exit if the size is exceeded\22\0Acomplete -c xargs -n __fish_is_first_token -s P -l max-procs -r -f -d \22Run up to max-procs processes at a time\22\0Acomplete -c xargs -xa \22(__fish_complete_subcommand)\22\0A", align 1
