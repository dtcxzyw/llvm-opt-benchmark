@anon.1d0b41a8d45d477c3029ec78f9b8b434.1328 = private unnamed_addr constant [8409 x i8] c"function __fish_clasp_list_projects\0A    clasp list --noShorten true 2>/dev/null |\0A        string replace --regex '(.*) - https://script.google.com/d/(.*)/edit' '$2\\\\t$1'\0Aend\0A\0Afunction __fish_clasp_list_versions\0A    clasp versions 2>/dev/null |\0A        string replace --regex '(\\\\d+) - (.*)' '$1\\\\t$2' |\0A        sed -n '2,$p'\0Aend\0A\0Afunction __fish_clasp_list_deployments\0A    clasp deployments 2>/dev/null |\0A        string replace --regex -- '- (\\\\S+) @(\\\\S+).*' '$1\\\\tversion $2' |\0A        sed -n '2,$p'\0Aend\0A\0Afunction __fish_clasp_list_advanced_services\0A    printf '%s\\\\t%s service\\n' admin-sdk-directory 'Admin SDK Directory' \\\0A        admin-sdk-license-manager 'Admin SDK Enterprise License Manager' \\\0A        admin-sdk-groups-migration 'Admin SDK Groups Migration' \\\0A        admin-sdk-groups-settings 'Admin SDK Groups Settings' \\\0A        admin-sdk-reseller 'Admin SDK Google Workspace Reseller' \\\0A        admin-sdk-reports 'Admin SDK Reports' \\\0A        calendar 'Advanced Calendar' \\\0A        chat 'Advanced Chat' \\\0A        docs 'Advanced Docs' \\\0A        drive 'Advanced Drive' \\\0A        drive-activity 'Google Drive Activity' \\\0A        drive-labels 'Advanced Drive Labels' \\\0A        gmail 'Advanced Gmail' \\\0A        sheets 'Advanced Sheets' \\\0A        slides 'Advanced Slides' \\\0A        classroom Classroom \\\0A        people 'Advanced People' \\\0A        contacts-people 'Migrate from Contacts service to People API' \\\0A        tasks Tasks\0Aend\0A\0Afunction __fish_clasp_list_functions\0A    find . -name '*.js' -exec sed -nE '/^\\s*function/ s/^\\s*function\\s+(\\w+).*$/\\1/p' '{}' \\;\0Aend\0A\0Afunction __fish_clasp_list_subcommands\0A    clasp --help |\0A        string match --regex '^  [a-z]' --entire |\0A        string replace --regex '^\\\\s{2}([a-z]+).*' '$1'\0Aend\0A\0Afunction __fish_clasp_seen_subcommands_from\0A    set -l cmd (commandline -poc)\0A    set -e cmd[1]\0A\0A    test (count $argv) -gt (count $cmd) && return 1\0A\0A    set -l i (count $argv)\0A    set -l j (count $cmd)\0A    while test $i -gt 0\0A        contains -- $argv[$i] $cmd[$j] || return 1\0A        set i (math $i - 1)\0A        set j (math $j - 1)\0A    end\0A\0A    return 0\0Aend\0A\0A# options\0Acomplete -c clasp -s h -l help -d 'Show [h]elp'\0Acomplete -c clasp -s v -l version -d 'Show [v]ersion'\0A\0Acomplete -c clasp -s A -l auth -d \22Path to a '.clasprc.json' or to a directory with it\22\0Acomplete -c clasp -s I -l ignore -d \22Path to a '.claspignore.json' or to a directory with it\22\0Acomplete -c clasp -s P -l project -d \22Path to a '.clasp.json' or to a directory with it\22\0Acomplete -c clasp -s W -l why -d \22Display some debugging info upon exit\22\0A\0A# subcommands\0Acomplete -c clasp -n __fish_use_subcommand -xa login -d \22Log in to script.google.com\22\0Acomplete -c clasp -n __fish_use_subcommand -xa logout -d \22Log out\22\0Acomplete -c clasp -n __fish_use_subcommand -xa create -d \22Create a script\22\0Acomplete -c clasp -n __fish_use_subcommand -xa clone -d \22Clone a project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa pull -d \22Fetch a remote project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa push -d \22Update the remote project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa status -d \22Lists files that will be pushed by 'push' subcommand\22\0Acomplete -c clasp -n __fish_use_subcommand -xa open -d \22Open a script\22\0Acomplete -c clasp -n __fish_use_subcommand -xa deployments -d \22List deployment IDs of a script\22\0Acomplete -c clasp -n __fish_use_subcommand -xa deploy -d \22Deploy a project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa undeploy -d \22Undeploy a project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa version -d \22Create an immutable version of a script\22\0Acomplete -c clasp -n __fish_use_subcommand -xa versions -d \22List versions of a script\22\0Acomplete -c clasp -n __fish_use_subcommand -xa list -d \22List projects\22\0Acomplete -c clasp -n __fish_use_subcommand -xa logs -d \22Show StackDriver logs\22\0Acomplete -c clasp -n __fish_use_subcommand -xa run -d \22Run a function in your Apps Scripts project\22\0Acomplete -c clasp -n __fish_use_subcommand -xa apis -d \22List, enable, or disable APIs\22\0Acomplete -c clasp -n __fish_use_subcommand -xa help -d \22Show help for a command\22\0A\0A# login options\0Aset login_condition '__fish_seen_subcommand_from login'\0Acomplete -c clasp -n \22$login_condition\22 -l no-localhost -d 'Do not run a local server, manually enter code instead'\0Acomplete -c clasp -n \22$login_condition\22 -l creds -d 'Specify a relative path to credentials'\0Acomplete -c clasp -n \22$login_condition\22 -l status -d 'Show who is logged in'\0A\0A# create option\0Aset create_condition '__fish_seen_subcommand_from create'\0Acomplete -c clasp -n \22$create_condition\22 -l type -xa 'standalone docs sheets slides forms webapp api' -d \22A project type\22\0Acomplete -c clasp -n \22$create_condition\22 -l title -d \22A project title\22\0Acomplete -c clasp -n \22$create_condition\22 -l parentId -d \22A project container ID\22\0Acomplete -c clasp -n \22$create_condition\22 -l rootDir -d \22Path to a directory with project files\22\0A\0A# clone options\0Aset clone_condition '__fish_seen_subcommand_from clone'\0Acomplete -c clasp -n \22$clone_condition\22 -l rootDir -d \22Path to a directory project files\22\0Acomplete -c clasp -n \22$clone_condition\22 -xa '(__fish_clasp_list_projects)'\0A\0A# pull options\0Acomplete -c clasp -n '__fish_seen_subcommand_from pull' -l versionNumber -xa '(__fish_clasp_list_versions)' -d \22A project version to pull\22\0A\0A# push options\0Aset push_condition '__fish_seen_subcommand_from push'\0Acomplete -c clasp -n \22$push_condition\22 -s f -l force -d \22Forcibly overwrite a remote manifest\22\0Acomplete -c clasp -n \22$pu