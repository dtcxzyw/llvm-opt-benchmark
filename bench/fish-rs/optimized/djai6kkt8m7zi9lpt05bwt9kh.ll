@anon.1d0b41a8d45d477c3029ec78f9b8b434.2544 = private unnamed_addr constant [1842 x i8] c"function __run0_slice\0A    systemctl -t slice --no-legend --no-pager --plain | string split -nf 1 ' '\0A    systemctl -t slice --user --no-legend --no-pager --plain | string split -nf 1 ' '\0Aend\0A\0Acomplete -c run0 -xa \22(__fish_complete_subcommand)\22\0Acomplete -c run0 -s h -l help -d \22Show help\22\0Acomplete -c run0 -s V -l version -d \22Show version\22\0Acomplete -c run0 -s u -l user -d \22Switches to the specified user instead of root\22 -xa \22(__fish_complete_users)\22\0Acomplete -c run0 -s g -l group -d \22Switches to the specified group instead of root\22 -xa \22(__fish_complete_groups)\22\0Acomplete -c run0 -l no-ask-password -d \22Do not query the user for authentication for privileged operations\22\0Acomplete -c run0 -l machine -d \22Execute operation on a local container\22 -xa \22(machinectl list --no-legend --no-pager | string split -f 1 ' ')\22\0Acomplete -c run0 -l property -d \22Sets a property on the service unit that is created\22 -x\0Acomplete -c run0 -l description -d \22Description for unit\22 -x\0Acomplete -c run0 -l slice -d \22Make the new .service unit part of the specified slice, instead of user.slice.\22 -xa \22(__run0_slice)\22\0Acomplete -c run0 -l slice-inherit -d \22Make the new .service unit part of the slice the run0 itself has been invoked in\22\0Acomplete -c run0 -l nice -d \22Runs the invoked session with the specified nice level\22 -xa \22(seq -20 19)\22\0Acomplete -c run0 -s D -l chdir -d \22Set working directory\22 -xa \22(__fish_complete_directories)\22\0Acomplete -c run0 -l setenv -d \22Runs the invoked session with the specified environment variable set\22 -x\0Acomplete -c run0 -l background -d \22Change the terminal background color to the specified ANSI color\22 -x\0Acomplete -c run0 -l pty -d \22Request allocation of a pseudo TTY for stdio\22\0Acomplete -c run0 -l pipe -d \22Request redirect pipe for stdio\22\0Acomplete -c run0 -l shell-prompt-prefix -d \22Set a shell prompt prefix string\22 -x\0A", align 1
