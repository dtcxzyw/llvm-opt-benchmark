@anon.1d0b41a8d45d477c3029ec78f9b8b434.3552 = private unnamed_addr constant [22909 x i8] c"<!DOCTYPE html>\0A<html ng-app=\22fishconfig\22>\0A\0A<head>\0A    <meta http-equiv=\22Content-type\22 content=\22text/html;charset=UTF-8\22>\0A    <title>fish shell configuration</title>\0A    <link rel=\22icon\22 type=\22image/png\22 href=\22favicon.png\22 />\0A    <link rel=\22stylesheet\22 type=\22text/css\22 href=\22fishconfig.css\22 />\0A    <link rel=\22stylesheet\22 type=\22text/css\22 media=\22print\22 href=\22fishconfig_print.css\22>\0A    <script type=\22text/javascript\22 src=\22js/colorutils.js\22 defer></script>\0A    <script type=\22text/javascript\22 src=\22js/main.js\22 defer></script>\0A    <script type=\22text/javascript\22 src=\22js/alpine.js\22 defer></script>\0A</head>\0A\0A<!-- TODO check that every x-for has a :key binding -->\0A<!-- TODO check that every template has single child -->\0A<!-- TODO try to reduce depth by either splitting routes or eliminating redundant wrappers -->\0A\0A<body id=\22ancestor\22 x-data=\22{ currentTab: 'colors' }\22>\0A    <main id=\22parent\22>\0A        <div id=\22tab_parent\22>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab =='colors'}\22 id=\22tab_colors\22\0A                @click=\22currentTab = 'colors'\22>colors</a>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab == 'prompt'}\22 id=\22tab_prompt\22\0A                @click=\22currentTab = 'prompt'\22>prompt</a>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab == 'functions'}\22 id=\22tab_functions\22\0A                @click=\22currentTab = 'functions'\22>functions</a>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab == 'variables'}\22 id=\22tab_variables\22\0A                @click=\22currentTab = 'variables'\22>variables</a>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab == 'history'}\22 id=\22tab_history\22\0A                @click=\22currentTab = 'history'\22>history</a>\0A            <a :class=\22{'tab': true, 'selected_tab': currentTab == 'bindings'}\22 id=\22tab_bindings\22\0A                @click=\22currentTab = 'bindings'\22><span class=\22print_only\22>fish shell </span>bindings</a>\0A        </div>\0A        <div id=\22tab_contents\22>\0A            <template x-if=\22currentTab === 'colors'\22 x-data=\22colors\22>\0A                <div>\0A                    <!-- ko with: color_picker -->\0A                    <div class=\22colorpicker_text_sample\22 :style=\22{'background-color': terminalBackgroundColor}\22>\0A                        <span style=\22position: absolute; left: 10px; top: 3px\22\0A                            :style=\22{'color': `#${text_color_for_color(terminalBackgroundColor)}`}\22\0A                            x-text=\22selectedColorScheme.name\22></span>\0A                        <br />\0A                        <div class=\22color_picker_background_cells\22>\0A                            <span style=\22display: block; text-align: right; line-height: 110%\22\0A                                :style=\22{'color': `#${text_color_for_color(terminalBackgroundColor)}`}\22>\0A                                Background Color:<br />(demo only)&nbsp;\0A                            </span>\0A                            <template x-for=\22color in sampleTerminalBackgroundColors\22>\0A                                <label :style=\22{'background-color': color}\22>\0A                                    <input type=\22radio\22 :value=\22color\22 x-model=\22terminalBackgroundColor\22 hidden\0A                                        :title=\22'Preview with this background color.\\n\\nfish cannot change the background color of your terminal. Refer to your terminal settings to set its background color.'\22>\0A                                    </input>\0A                                </label>\0A                            </template>\0A                        </div>\0A                        <!-- This is the sample text -->\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'command'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.command)}\22\0A                            @click=\22selectColorSetting('command')\22>/bright/vixens</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'param'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.param)}\22\0A                            @click=\22selectColorSetting('param')\22>jump</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'end'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.end)}\22\0A                            @click=\22selectColorSetting('end')\22>|</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'command'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.command)}\22\0A                            @click=\22selectColorSetting('command')\22>dozy</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'quote'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.quote)}\22\0A                            @click=\22selectColorSetting('quote')\22> \22fowl\22</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'redirection'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.redirection)}\22\0A                            @click=\22selectColorSetting('redirection')\22>&gt; quack</span>\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'end'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.end)}\22\0A                            @click=\22selectColorSetting('end')\22>&</span>\0A                        <br>\0A\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'command'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.command)}\22\0A                            @click=\22selectColorSetting('command')\22>echo</span>\0A\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'error'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.error)}\22\0A                            @click=\22selectColorSetting('error')\22>'</span><span\0A                            :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'quote'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.quote)}\22\0A                            @click=\22selectColorSetting('quote')\22>Errors are the portals to discovery</span>\0A\0A                        <br>\0A\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'comment'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.comment)}\22\0A                            @click=\22selectColorSetting('comment')\22># This is a comment</span>\0A\0A                        <br>\0A\0A                        <span :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'command'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.command)}\22\0A                            @click=\22selectColorSetting('command')\22>Th</span><span class=\22fake_cursor\22><span\0A                                style=\22visibility: hidden\22>i</span></span><span\0A                            :class=\22{cs_clickable: customizationActive, cs_editing: csEditingType == 'autosuggestion'}\22\0A                            :style=\22{ 'color': interpret_color(selectedColorScheme.autosuggestion)}\22\0A                            @click=\22selectColorSetting('autosuggestion')\22>s is an autosuggestion</span>\0A\0A\0A                        <div style=\22position: absolute; right: 5px; bottom: 5px;\22>\0A\0A                            <button class=\22customize_theme_button\22 :class=\22{button_highlight: customizationActive}\22\0A                                :style=\22{'color': `#${text_color_for_color(terminalBackgroundColor)}`}\22\0A                                @click=\22toggleCustomizationActive\22>Customize</button>\0A\0A                            <button class=\22save_button\22\0A                                :style=\22{'color': `#${text_color_for_color(terminalBackgroundColor)}`}\22\0A                                x-show=\22showSaveButton\22 @click=\22setTheme\22 x-text=\22saveThemeButtonTitle\22></button>\0A                        </div>\0A\0A                    </div>\0A\0A                    <div x-show=\22customizationActive\22>\0A                        <div style=\22margin: 10px 0 7px 35px;\22>Choose a color for <span\0A                                x-text=\22csUserVisibleTitle\22></span>:</div>\0A                        <!-- TODO maybe add input[type=color] for 24bit terminals -->\0A                        <table class=\22colorpicker_term256\22 style=\22margin: 0px 20px;\22>\0A                            <tbody>\0A                                <template x-for=\22color_array in colorArraysArray\22>\0A                                    <tr class=\22colorpicker_term256_row\22>\0A                                        <template x-for=\22color in color_array\22>\0A                                            <td class=\22colorpicker_term256_cell\22\0A                                                :style=\22{'background-color': interpret_color(color)}\22\0A                                                @click=\22changeSelectedTextColor(color)\22>\0A                                                <div class=\22colorpicker_term256_selection_indicator\22\0A                                                    x-show=\22selectedColorScheme[selectedColorSetting] == color\22\0A                                                    :style=\22{'border-color': interpret_color(border_color_for_color(color))}\22>\0A                                                </div>\0A                                            </td>\0A                                        </template>\0A                                    </tr>\0A                                </template>\0A                            </tbody>\0A                            <!-- /ko -->\0A                        </table>\0A                    </div>\0A\0A                    <div style=\22margin: 10px 0 7px 35px;\22>Preview a theme below:</div>\0A\0A                    <div class=\22color_scheme_choices_scrollview\22>\0A                        <div class=\22color_scheme_choices_list\22>\0A                            <template x-for=\22colorScheme in colorSchemes\22>\0A                                <div class=\22color_scheme_choice_container\22\0A                                    @click=\22changeSelectedColorScheme(colorScheme)\22>\0A                                    <div class=\22color_scheme_choice_label\22>\0A                                        <!-- This click/clickBubble nonsense is so that we can have a separate URL inside a parent with an onClick handler -->\0A                                        <span x-text=\22colorScheme.name\22></span>\0A                                        <a x-show=\22colorScheme.url\22 style=\22text-decoration: none; color: inherit;\22\0A                                            :href=\22colorScheme.url\22>&#10138;</a>\0A                                    </div>\0A                                    <div class=\22colorpicker_text_sample_tight\22\0A                                        :style=\22{'background-color': colorScheme.preferred_background}\22>\0A                                        <span\0A                                            :style=\22{'color': interpret_color(colorScheme.command)}\22>/bright/vixens</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.param)}\22>jump</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.end)}\22>|</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.command)}\22>dozy</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.quote)}\22> \22fowl\22 </span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.redirection)}\22>&gt;\0A                                            quack</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.end)}\22>&</span>\0A                                        <br>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.command)}\22>echo</span>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.error)}\22>'</span><span\0A                                            :style=\22{'color': interpret_color(colorScheme.quote)}\22>Errors are the\0A                                            portals to discovery</span>\0A                                        <br>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.comment)}\22># This is a\0A                                            comment</span>\0A                                        <br>\0A                                        <span :style=\22{'color': interpret_color(colorScheme.command)}\22>Th</span><span\0A                                            class=\22fake_cursor\22><span style=\22visibility: hidden\22>i</span></span><span\0A                                            :style=\22{ 'color': interpret_color(colorScheme.autosuggestion)}\22>s is an\0A                                            autosuggestion</span>\0A                                    </div>\0A                                </div>\0A                            </template>\0A                        </div>\0A                    </div>\0A                    <!-- /ko -->\0A                </div>\0A            </template>\0A\0A            <!-- Investigate potential race condition with selectedPrompt (e.g. replace x-if with x-show) -->\0A            <template x-if=\22currentTab === 'prompt'\22 x-data=\22prompt\22>\0A                <div class=\22height_limiter\22>\0A                    <!-- The first 'sample' prompt is the current one; the remainders are samples. This ought to be cleaned up. -->\0A                    <div class=\22current_prompt\22 style=\22min-height: 7.5em;\22\0A                        :style=\22{'background-color': terminalBackgroundColor}\22>\0A                        <div class=\22prompt_demo_choice_label\22 style=\22color: #FFF;\22 x-text=\22selectedPrompt.name\22></div>\0A                        <div style='display: flex'>\0A                            <div x-html='selectedPrompt.demo' style='flex-grow: 1' class=\22prompt_demo unbordered\22></div>\0A                            <template x-if=\22selectedPrompt.right\22>\0A                                <div title=\22right prompt for {{selectedPrompt.name }}\22 x-html='selectedPrompt.right'\0A                                    class=\22prompt_demo unbordered\22 @click=\22selectPrompt(selectedPrompt)\22>\0A                                </div>\0A                            </template>\0A                        </div>\0A                        <div style=\22position: absolute; right: 5px; bottom: 5px;\22>\0A                            <button class=\22save_button\22 x-show=\22showSav