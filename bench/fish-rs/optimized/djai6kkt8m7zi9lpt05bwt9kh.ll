nd prompt in a client'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $commandprompt\22 -s I -x -d 'Comma-separated list of initial text for each prompt'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $commandprompt\22 -s p -x -d 'Comma-separated list of prompts'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $commandprompt\22 -s t -xa '(__fish_tmux_clients)' -d target-client\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $display -d 'Display a message'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $display\22 -s p -d 'print to stdout'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $display\22 -s t --keep-order -xa '(__fish_tmux_panes)' -d target-pane\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $display\22 -s c -xa '(__fish_tmux_clients)' -d target-client\0A\0A###############  End:   Status Line ###############\0A\0A###############  Begin: Buffers ###############\0A\0Aset -l choosebuffer choose-buffer\0Aset -l clearhist \22clearhist clear-history\22\0Aset -l deleteb \22deleteb delete-buffer\22\0Aset -l lsb \22lsb list-buffers\22\0Aset -l loadb \22loadb load-buffer\22\0Aset -l pasteb \22pasteb paste-buffer\22\0Aset -l saveb \22saveb save-buffer\22\0Aset -l setb \22setb set-buffer\22\0Aset -l showb \22showb show-buffer\22\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $choosebuffer -d 'interactively choose buffer'\0Acomplete -c tmux -n __fish_use_subcommand -a $clearhist -d 'forget history for a pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $deleteb -d 'delete buffer'\0Acomplete -c tmux -n __fish_use_subcommand -a $lsb -d 'list buffers'\0Acomplete -c tmux -n __fish_use_subcommand -a $loadb -d 'load buffer from path, use - for stdin'\0Acomplete -c tmux -n __fish_use_subcommand -a $pasteb -d 'paste buffer to pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $saveb -d 'save buffer to path'\0Acomplete -c tmux -n __fish_use_subcommand -a $setb -d 'set buffer to value'\0Acomplete -c tmux -n __fish_use_subcommand -a $showb -d 'print buffer to stdout'\0A\0A## commands with buffer flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $deleteb $loadb $pasteb $saveb $setb $showb\22 -xs b -a '(__fish_tmux_buffers)' --keep-order -d 'buffer name'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $setb\22 -xs n -a '(__fish_tmux_buffers)' --keep-order -d 'new buffer name'\0A\0A## commands with target pane flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $choosebuffer $clearhist $pasteb\22 -xs t --keep-order -a '(__fish_tmux_panes)' -d 'target pane'\0A\0A#commands with the -F format flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $choosebuffer $lsb\22 -xs F -d 'format string'\0A\0A#commands with the -f filter flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $choosebuffer $loadb $lsb\22 -xs f -d 'filter format string'\0A\0A# Commands that take paths\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $loadb $saveb\22 --force-files\0A\0A###############  End:   Buffers ###############\0A\0A###############  Begin: Miscellaneous ###############\0A#TODO - these commands are not currently implemented.\0A#there is a section in the tmux man page that has the same title as this section\0A#use the \22Clients and Sessions\22 code as an example when implementing this\0A###############  End:   Miscellaneous ###############\0A", align 1
