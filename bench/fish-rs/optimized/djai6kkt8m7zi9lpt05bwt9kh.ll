@anon.1d0b41a8d45d477c3029ec78f9b8b434.1148 = private unnamed_addr constant [22036 x i8] c"# fish completion for arc\0A\0Afunction __fish_arc_needs_command\0A    set -l cmd (commandline -xpc)\0A    if not set -q cmd[2]\0A        return 0\0A    else\0A        set -l skip_next 1\0A        # Skip first word because it's \22arc\22 or a wrapper\0A        for c in $cmd[2..-1]\0A            switch $c\0A                # General options that can still take a command\0A                case --trace --no-ansi --ansi --load-phutil-library config skip-arcconfig arcrc-file --conduit-{uri,token,version,timeout}\0A                    continue\0A                case \22*\22\0A                    echo $c\0A                    return 1\0A            end\0A        end\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_arc_using_command\0A    set -l cmd (__fish_arc_needs_command)\0A    test -z \22$cmd\22\0A    and return 1\0A    contains -- $cmd $argv\0A    and return 0\0Aend\0A\0A### Global options\0Acomplete -f -c arc -n __fish_arc_needs_command -l trace -d 'Debugging command'\0Acomplete -f -c arc -n __fish_arc_needs_command -l no-ansi -d 'Don\\'t use color or style for output'\0Acomplete -f -c arc -n __fish_arc_needs_command -l ansi -d 'Always use formatting'\0Acomplete -f -c arc -n __fish_arc_needs_command -l no-ansi -d 'Don\\'t use color or style for output'\0Acomplete -f -c arc -n __fish_arc_needs_command -l load-phutil-library -d 'Specify which libraries to load'\0Acomplete -f -c arc -n __fish_arc_needs_command -l conduit-uri -d 'Specify the Conduit URI'\0Acomplete -f -c arc -n __fish_arc_needs_command -l conduit-token -d 'Specify the Conduit token'\0Acomplete -f -c arc -n __fish_arc_needs_command -l conduit-version -d 'Force a version'\0Acomplete -f -c arc -n __fish_arc_needs_command -l conduit-timeout -d 'Sets the timeout'\0Acomplete -f -c arc -n __fish_arc_needs_command -l config -d 'Sets a config'\0Acomplete -f -c arc -n __fish_arc_needs_command -l skip-arcconfig -d 'Skip the working copy configuration file'\0Acomplete -c arc -n __fish_arc_needs_command -l arcrc-file -d 'Use provided file instead of ~/.arcrc'\0A\0A### shell-complete\0Acomplete -f -c arc -n __fish_arc_needs_command -a shell-complete -d 'Implements shell completion'\0Acomplete -f -c arc -n '__fish_arc_using_command shell-complete' -l current -d 'Current term in the argument list being completed'\0A\0A### get-config\0Acomplete -f -c arc -n __fish_arc_needs_command -a get-config -d 'Reads an arc configuration option'\0Acomplete -f -c arc -n '__fish_arc_using_command get-config' -l verbose -d 'Show detailed information about options'\0A\0A### download\0Acomplete -f -c arc -n __fish_arc_needs_command -a download -d 'Download a file to local disk'\0Acomplete -c arc -n '__fish_arc_using_command download' -l as -d 'Save the file with a specific name rather than the default'\0Acomplete -f -c arc -n '__fish_arc_using_command download' -l show -d 'Write file to stdout instead of to disk'\0A\0A### list\0Acomplete -f -c arc -n __fish_arc_needs_command -a list -d 'List your open Differential revisions'\0A\0A### lint\0Acomplete -f -c arc -n __fish_arc_needs_command -a lint -d 'Run static analysis on changes to check for mistakes'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l engine -d 'Override configured lint engine for this project'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l apply-patches -d 'Apply patches suggested by lint to the working copy'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l severity -d 'Set minimum message severity'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l never-apply-patches -d 'Never apply patches suggested by lint'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l rev -d 'Lint changes since a specific revision'\0Acomplete -c arc -n '__fish_arc_using_command lint' -l outfile -d 'Output the linter results to a file'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l lintall -d 'Show all lint warnings, not just those on changed lines'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l amend-all -d 'When linting git repositories, amend HEAD with all patches'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l everything -d 'Lint all files in the project'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l output -d 'Specify how results will be displayed'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l only-new -d 'Display only messages not present in the original code'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l only-changed -d 'Show lint warnings just on changed lines'\0Acomplete -f -c arc -n '__fish_arc_using_command lint' -l amend-autofixes -d 'When linting git repositories, amend HEAD with autofix'\0A\0A### flag\0Acomplete -f -c arc -n __fish_arc_needs_command -a flag -d 'In the first form, list objects you\\'ve flagged'\0Acomplete -f -c arc -n '__fish_arc_using_command flag' -l edit -d 'Edit the flag on an object'\0Acomplete -f -c arc -n '__fish_arc_using_command flag' -l color -d 'Set the color of a flag'\0Acomplete -f -c arc -n '__fish_arc_using_command flag' -l clear -d 'Delete the flag on an object'\0Acomplete -f -c arc -n '__fish_arc_using_command flag' -l note -d 'Set the note on a flag'\0A\0A### export\0Acomplete -c arc -n __fish_arc_needs_command -a export -d 'Export the local changeset to a file'\0Acomplete -f -c arc -n '__fish_arc_using_command export' -l unified -d 'Export change as a unified patch'\0Acomplete -f -c arc -n '__fish_arc_using_command export' -l git -d 'Export change as a git patch'\0Acomplete -f -c arc -n '__fish_arc_using_command export' -l encoding -d 'Attempt to convert non UTF-8 patch into specified encoding'\0Acomplete -f -c arc -n '__fish_arc_using_command export' -l arcbundle -d 'Export change as an arc bundle'\0Acomplete -f -c arc -n '__fish_arc_using_command export' -l diff -d 'Export from Differential diff'\0Acomplete -f -c arc -n '__fish_arc_usin