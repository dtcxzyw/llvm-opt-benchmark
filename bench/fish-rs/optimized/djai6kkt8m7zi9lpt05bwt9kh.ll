@anon.1d0b41a8d45d477c3029ec78f9b8b434.3264 = private unnamed_addr constant [755 x i8] c"function __fish_print_VBox_vms\0A    set -l print_names true\0A    set -l print_uuids true\0A\0A    if contains -- nouuids $argv\0A        set print_uuids false\0A    end\0A\0A    if contains -- nonames $argv\0A        set print_names false\0A    end\0A\0A    # `VBoxManage list vms` output example:\0A    # \22Machine Name\22 {222537b0-1ea1-454a-abf0-ed0d6c3c6346}\0A    # \22Another Machine\22 {332537b4-1ea1-454a-abf0-ed1d6c3c2347}\0A    set -l lines (VBoxManage list vms | string match -r '\22(.*)\22 {(.*)}')\0A\0A    while set -q lines[3]\0A        if test $print_names = true\0A            printf '%s\\tVirtual machine\\n' $lines[2]\0A        end\0A\0A        if test $print_uuids = true\0A            printf '%s\\t%s virtual machine\\n' $lines[3] $lines[2]\0A        end\0A\0A        set -e lines[1..3]\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3265 = private unnamed_addr constant [37 x i8] c"functions/__fish_print_addresses.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3266 = private unnamed_addr constant [659 x i8] c"function __fish_print_addresses --description \22List own network addresses with interface as description\22\0A    # if --all is given, also print 0.0.0.0 and ::\0A    if contains -- --all $argv\0A        echo -e \220.0.0.0\\tall\22\0A        echo -e \22::\\tall\22\0A    end\0A    if command -sq ip\0A        command ip --oneline address | string replace -r '^\\d+:\\s+(\\S+)\\s+inet6?\\s+([^\\s/]+).*' '$2\\t$1'\0A    else if command -sq ifconfig\0A        # This is for OSX/BSD\0A        # There's also linux ifconfig but that has at least two different output formats\0A        # is basically dead, and ip is installed on everything now\0A        ifconfig | awk '/^\\tinet/ { print $2 } '\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3267 = private unnamed_addr constant [40 x i8] c"functions/__fish_print_apt_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3268 = private unnamed_addr constant [2427 x i8] c"function __fish_print_apt_packages\0A    argparse --name=__fish_print_packages i/installed -- $argv\0A    or return\0A\0A    switch (commandline -ct)\0A        case '-**'\0A            return\0A    end\0A\0A    set -l search_term (commandline -ct | string replace -ar '[\\'\22\\\\\\\\]' '' | string lower)\0A\0A    if ! test -f /var/lib/dpkg/status\0A        return 1\0A    end\0A\0A    if not set -q _flag_installed\0A        # Do not generate the cache as apparently sometimes this is slow.\0A        # http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=547550\0A        # (It is safe to use `sed -r` here as we are guaranteed to be on a GNU platform\0A        # if apt-cache was found.)\0A        # Uses the UTF-8/ASCII record separator (0x1A) character.\0A        #\0A        # Note: This can include \22Description:\22 fields which we need to include,\0A        # \22Description-en_GB\22 (or another locale code) fields which we need to include\0A        # as well as \22Description-md5\22 fields which we absolutely do *not* want to include\0A        # The regex doesn't allow numbers, so unless someone makes a hash algorithm without a number\0A        # in the name, we're safe. (yes, this should absolutely have a better format).\0A        #\0A        # aptitude has options that control the output formatting, but is orders of magnitude slower\0A        #\0A        # sed could probably do all of the heavy lifting here, but would be even less readable\0A        #\0A        # The `head -n 500` causes us to stop once we have 500 lines. We do it after the `sed` because\0A        # Debian package descriptions can be extremely long and are hard-wrapped: texlive-latex-extra\0A        # has about 2700 lines on Debian 11.\0A        apt-cache --no-generate show '.*'(commandline -ct)'.*' 2>/dev/null | sed -r '/^(Package|Description-?[a-zA-Z_]*):/!d;s/Package: (.*)/\\1\\t/g;s/Description-?[^:]*: (.*)/\\1\\x1a/g' | head -n 2500 | string join \22\22 | string replace --all --regex \\x1a+ \\n | uniq\0A        return 0\0A    else\0A        # Do not not use `apt-cache` as it is sometimes inexplicably slow (by multiple orders of magnitude).\0A        awk '\0ABEGIN {\0A  FS=\22: \22\0A}\0A\0A/^Package/ {\0A  pkg=$2\0A}\0A\0A/^Status/ {\0A  installed=0\0A  if ($2 ~ /(^|\\s)installed/) {\0A    installed=1\0A  }\0A}\0A\0A/^Description(-[a-zA-Z]+)?:/ {\0A  desc=$2\0A  if (installed == 1 && index(pkg, \22'$search_term'\22) > 0) {\0A    print pkg \22\\t\22 desc\0A    installed=0 # Prevent multiple description translations from being printed\0A  }\0A}' </var/lib/dpkg/status\0A    end\0Aend\0A", align 1
