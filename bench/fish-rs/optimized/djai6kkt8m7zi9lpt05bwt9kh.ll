ete -c keybase -f -n \22$ends keybase pprof\22 -a \22$keybase_pprof\22\0Acomplete -c keybase -f -n \22$ends keybase rekey\22 -a \22$keybase_rekey\22\0Acomplete -c keybase -f -n \22$ends keybase sigs\22 -a \22$keybase_sigs\22\0Acomplete -c keybase -f -n \22$ends keybase team\22 -a \22$keybase_team\22\0Acomplete -c keybase -f -n \22$ends keybase update\22 -a \22$keybase_update\22\0Acomplete -c keybase -f -n \22$ends keybase wallet\22 -a \22$keybase_wallet\22\0Acomplete -c keybase -f -n \22$ends keybase wot\22 -a \22$keybase_wot\22\0A# 3\0Acomplete -c keybase -f -n \22$ends keybase account email\22 -a \22$keybase_account_email\22\0Acomplete -c keybase -f -n \22$ends keybase account phonenumber\22 -a \22$keybase_account_phonenumber\22\0Acomplete -c keybase -f -n \22$ends keybase bot token\22 -a \22$keybase_bot_token\22\0Acomplete -c keybase -f -n \22$ends keybase fs archive\22 -a \22$keybase_fs_archive\22\0Acomplete -c keybase -f -n \22$ends keybase fs debug\22 -a \22$keybase_fs_debug\22\0Acomplete -c keybase -f -n \22$ends keybase fs sync\22 -a \22$keybase_fs_sync\22\0A\0A# command options\0Acomplete -c keybase -f -n \22$ends keybase account upload-avatar\22 -l skip-chat-message -s s\0Acomplete -c keybase -f -n \22$ends keybase account upload-avatar\22 -l team\0A# ...\0A", align 1
