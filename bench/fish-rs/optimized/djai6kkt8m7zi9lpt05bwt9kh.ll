@anon.1d0b41a8d45d477c3029ec78f9b8b434.2394 = private unnamed_addr constant [4838 x i8] c"# Completions for ps\0A\0Aset -l gnu_linux 0\0Aif ps -V <&- >/dev/null 2>/dev/null\0A    set gnu_linux 1\0Aend\0A\0A# Separate out GNU/Linux-only options from BSD-compatible options\0Aif test \22$gnu_linux\22 -eq 1\0A    # Some short options are GNU-only\0A    complete -c ps -s a -d \22Select all processes except session leaders and terminal-less\22\0A    complete -c ps -s A -d \22Select all\22\0A    complete -c ps -s C -d \22Select by command\22 -ra '(__fish_complete_list , __fish_complete_proc)'\0A    complete -c ps -s c -d 'Show different scheduler information for the -l option'\0A    complete -c ps -s d -d \22Select all processes except session leaders\22\0A    complete -c ps -s e -d \22Select all\22\0A    complete -c ps -s F -d \22Extra full format\22\0A    complete -c ps -s f -d \22Full format\22\0A    complete -c ps -s H -l forest -d \22Show hierarchy\22\0A    complete -c ps -s j -d \22Jobs format\22\0A    complete -c ps -s l -d \22Long format\22\0A    complete -c ps -s L -d \22Show threads. With LWP/NLWP\22\0A    complete -c ps -s M -d \22Add column for security data\22\0A    complete -c ps -s m -d 'Show threads after processes'\0A    complete -c ps -s N -d \22Invert selection\22\0A    complete -c ps -s n -d \22Set namelist file\22 -r\0A    complete -c ps -s s -l sid -d \22Select by session ID\22 -x -a \22(__fish_complete_list , __fish_complete_pids)\22\0A    complete -c ps -s T -d \22Show threads. With SPID\22\0A    complete -c ps -s u -l user -d \22Select by user\22 -x -a \22(__fish_complete_list , __fish_complete_users)\22\0A    complete -c ps -s V -l version -d \22Display version and exit\22\0A    complete -c ps -s y -d \22Do not show flags\22\0A\0A    # All long-only options are GNU extensions\0A    complete -c ps -l cols -l columns -l width -d \22Set screen width\22 -r\0A    complete -c ps -l cumulative -d \22Include dead child process data\22\0A    complete -c ps -l deselect -d \22Deselect all processes that do not fulfill conditions\22\0A    complete -c ps -l headers -d \22Repeat header lines, one per page\22\0A    complete -c ps -l help -d \22Display help and exit\22\0A    complete -c ps -l info -d \22Display debug info\22\0A    complete -c ps -l lines -l rows -d \22Set screen height\22 -r\0A    complete -c ps -l no-headers -d 'Print no headers'\0A    complete -c ps -l ppid -d \22Select by parent PID\22 -x -a \22(__fish_complete_list , __fish_complete_pids)\22\0A    complete -c ps -l sort -d 'Specify sort order' -r\0Aelse\0A    # Assume BSD options otherwise\0A    complete -c ps -s a -d \22Select processes for all users\22\0A    complete -c ps -s c -d \22Show only executable name, not full invocation\22\0A    complete -c ps -s C -d \22Use raw CPU calculation (ignore resident time)\22\0A    complete -c ps -s d -d \22Arrange in descending tree format\22\0A    complete -c ps -s e -d \22Show environment as well\22\0A    complete -c ps -s f -d \22Show command-line and environment info for swapped-out processes (root-only)\22\0A    complete -c ps -s H -d \22Show threads for all processes\22\0A    complete -c ps -s h -d \22Repeat headers on each page of output\22\0A    complete -c ps -s j -d \22BSD jobs format (user, pid, ppid, pgid, sid, jobc, state, tt, time, and cmd)\22\0A    complete -c ps -s J -d \22Select by jail (name or id)\22 -r\0A    complete -c ps -s l -d \22BSD long format (uid, pid, ppid, cpu, pri, nice, vsz, rss, mwchan, state, tt, time, and cmd)\22\0A    complete -c ps -s L -d \22List available columns for -O/-o\22\0A    complete -c ps -s M -d \22Extract names from specified core file\22 -r\0A    complete -c ps -s m -d \22Sort by memory usage\22\0A    complete -c ps -s N -d \22Extract names from specified system/installation\22 -r\0A    complete -c ps -s r -d \22Sort by CPU usage\22\0A    complete -c ps -s S -d \22Include sum of child exited children in parent process times\22\0A    complete -c ps -s T -d \22Selec