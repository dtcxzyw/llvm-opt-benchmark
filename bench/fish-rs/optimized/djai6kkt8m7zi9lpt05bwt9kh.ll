@anon.1d0b41a8d45d477c3029ec78f9b8b434.3400 = private unnamed_addr constant [2542 x i8] c"function alias --description 'Creates a function wrapping a command'\0A    set -l options h/help s/save\0A    argparse -n alias --max-args=2 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help alias\0A        return 0\0A    end\0A\0A    set -l name\0A    set -l body\0A    set -l prefix\0A\0A    if not set -q argv[1]\0A        # Print the known aliases.\0A        for func in (functions -n)\0A            set -l output (functions $func | string match -r -- \22^function .* --description (?:'alias (.*)'|alias\\\\\\\\ (.*))\\$\22)\0A            if set -q output[2]\0A                set output (string replace -r -- '^'(string escape --style=regex -- $func)'[= ]' '' $output[2])\0A                echo alias $func (string escape -- $output[1])\0A            end\0A        end\0A        return 0\0A    else if not set -q argv[2]\0A        # Alias definition of the form \22name=value\22.\0A        set -l tmp (string split -m 1 \22=\22 -- $argv) \22\22\0A        set name $tmp[1]\0A        set body $tmp[2]\0A    else\0A        # Alias definition of the form \22name value\22.\0A        set name $argv[1]\0A        set body $argv[2]\0A    end\0A\0A    # sanity check\0A    if test -z \22$name\22\0A        printf ( _ \22%s: name cannot be empty\\n\22) alias >&2\0A        return 1\0A    else if test -z \22$body\22\0A        printf ( _ \22%s: body cannot be empty\\n\22) alias >&2\0A        return 1\0A    end\0A\0A    # Extract the first command from the body.\0A    printf '%s\\n' $body | read -l --list words\0A    set -l first_word $words[1]\0A    set -l last_word $words[-1]\0A\0A    # Prevent the alias from immediately running into an infinite recursion if\0A    # $body starts with the same command as $name.\0A    if test $first_word = $name\0A        if contains $name (builtin --names)\0A            set prefix builtin\0A        else\0A            set prefix command\0A        end\0A    end\0A    set -l cmd_string (string escape -- \22alias $argv\22)\0A\0A    # Do not define wrapper completion if we have \22alias foo 'foo xyz'\22 or \22alias foo 'sudo foo'\22\0A    # This is to prevent completions from recursively calling themselves (#7389).\0A    # The latter will have rare false positives but it's more important to\0A    # prevent recursion for this high-level command.\0A    set -l wraps\0A    if test $first_word != $name; and test $last_word != $name\0A        set wraps --wraps (string escape -- $body)\0A    end\0A\0A    echo \22function $name $wraps --description $cmd_string; $prefix $body \\$argv\0A        end\22 | source # The function definition in split in two lines to ensure that a '#' can be put in the body.\0A    if set -q _flag_save\0A        funcsave $name\0A    end\0Aend\0A", align 1
