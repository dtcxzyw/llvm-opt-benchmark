@anon.1d0b41a8d45d477c3029ec78f9b8b434.1716 = private unnamed_addr constant [7774 x i8] c"# Completions for gio (a part of GLib)\0A\0A# Scheme name (see: https://wiki.gnome.org/Projects/gvfs/schemes)\0Aset -l supported_schemes admin afc afp archive burn cdda computer dav dav+sd davs davs+sd dns-sd file ftp ftpis ftps google-drive gphoto2 http https localtest mtp network nfs recent sftp smb ssh test trash\0A\0Afor scheme in $supported_schemes\0A    complete -c gio -n \22__fish_seen_subcommand_from cat copy info list mkdir monitor mount move open rename remove save set trash tree\22 -a \22$scheme\22: -d Scheme\0Aend\0A\0A# Commands\0Acomplete -f -c gio -n __fish_use_subcommand -a help -d \22Print help\22\0Acomplete -f -c gio -n __fish_use_subcommand -a version -d \22Print version\22\0Acomplete -f -c gio -n __fish_use_subcommand -a cat -d \22Concatenate files to stdout\22\0Acomplete -f -c gio -n __fish_use_subcommand -a copy -d \22Copy files\22\0Acomplete -f -c gio -n __fish_use_subcommand -a info -d \22Show information about locations\22\0Acomplete -f -c gio -n __fish_use_subcommand -a list -d \22List the contents of locations\22\0Acomplete -f -c gio -n __fish_use_subcommand -a mime -d \22Get or set the handler\22\0Acomplete -f -c gio -n __fish_use_subcommand -a mkdir -d \22Create directories\22\0Acomplete -f -c gio -n __fish_use_subcommand -a monitor -d \22Monitor files\22\0Acomplete -f -c gio -n __fish_use_subcommand -a mount -d \22Mount or unmount the locations\22\0Acomplete -f -c gio -n __fish_use_subcommand -a move -d \22Move files\22\0Acomplete -f -c gio -n __fish_use_subcommand -a open -d \22Open files\22\0Acomplete -f -c gio -n __fish_use_subcommand -a rename -d \22Rename a file\22\0Acomplete -f -c gio -n __fish_use_subcommand -a remove -d \22Delete files\22\0Acomplete -f -c gio -n __fish_use_subcommand -a save -d \22Read from stdin and save\22\0Acomplete -f -c gio -n __fish_use_subcommand -a set -d \22Set a file attribute\22\0Acomplete -f -c gio -n __fish_use_subcommand -a trash -d \22Move files to the trash\22\0Acomplete -f -c gio -n __fish_use_subcommand -a tree -d \22Lists the contents of locations in a tree\22\0A\0A# Arguments of help command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from help\22 -a \22version cat copy info list mime mkdir monitor mount move open rename remove save set trash tree\22 -d Command\0A\0A# Arguments of mime command\0Afunction __fish_gio_list_mimetypes\0A    set -l python (__fish_anypython) || return\0A    $python -S -c 'import mimetypes; mimetypes.inited or mimetypes.init(); print(\22\\n\22.join(sorted(set(mimetypes.types_map.values()))))'\0Aend\0A\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mime\22 -a \22(__fish_gio_list_mimetypes)\22 -d \22MIME type\22\0A\0A# Common options\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy move\22 -s T -l no-target-directory -d \22No target directory\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy move\22 -s p -l progress -d \22Show progress\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy move\22 -s i -l interactive -d \22Prompt before overwrite\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy move save\22 -s b -l backup -d \22Backup existing destination files\22\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from info list\22 -s a -l attributes -d \22The attributes to get\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from info list set\22 -s n -l nofollow-symlinks -d \22Don't follow symbolic links\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from list tree\22 -s h -l hidden -d \22Show hidden files\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from remove trash\22 -s f -l force -d \22Ignore nonexistent files\22\0A\0A# Options of copy command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy\22 -l preserve -d \22Preserve all attributes\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy\22 -s P -l no-dereference -d \22Never follow symbolic links\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from copy\22 -l default-permissions -d \22Use default permissions\22\0A\0A# Options of info command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from info\22 -s w -l query-writable -d \22List writable attributes\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from info\22 -s f -l filesystem -d \22Get file system info\22\0A\0A# Options of list command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from list\22 -s l -l long -d \22Use a long listing format\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from list\22 -s d -l print-display-names -d \22Print display names\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from list\22 -s u -l print-uris -d \22Print full URIs\22\0A\0A# Options of mkdir command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mkdir\22 -s p -l parent -d \22Create parent directories\22\0A\0A# Options of monitor command\0Acomplete -r -c gio -n \22__fish_seen_subcommand_from monitor\22 -s d -l dir -d \22Monitor a directory\22\0Acomplete -r -c gio -n \22__fish_seen_subcommand_from monitor\22 -s f -l file -d \22Monitor a file\22\0Acomplete -r -c gio -n \22__fish_seen_subcommand_from monitor\22 -s D -l direct -d \22Monitor a file directly\22\0Acomplete -r -c gio -n \22__fish_seen_subcommand_from monitor\22 -s s -l silent -d \22Monitors a file directly without reporting changes\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from monitor\22 -s n -l no-moves -d \22Don't report move events\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from monitor\22 -s m -l mounts -d \22Watch for mount events\22\0A\0A# Options of mount command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s m -l mountable -d \22Mount as mountable\22\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from mount\22 -s d -l device -d \22Mount volume\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s u -l unmount -d Unmount\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s e -l eject -d Eject\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from mount\22 -s t -l stop -d \22Stop drive\22\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from mount\22 -s s -l unmount-scheme -a \22$supported_schemes\22 -d \22Unmount all mounts with the given scheme\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s f -l force -d \22Ignore outstanding file operations\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s a -l anonymous -d \22Use an anonymous user\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s l -l list -d List\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s o -l monitor -d \22Monitor events\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -s i -l detail -d \22Show extra information\22\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from mount\22 -l tcrypt-pim -d \22The numeric PIM when unlocking a VeraCrypt volume\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -l tcrypt-hidden -d \22Mount a TCRYPT hidden volume\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from mount\22 -l tcrypt-system -d \22Mount a TCRYPT system volume\22\0A\0A# Options of move command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from move\22 -s C -l no-copy-fallback -d \22Don't use copy and delete fallback\22\0A\0A# Options of save command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from save\22 -s c -l create -d \22Only create if not existing\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from save\22 -s a -l append -d \22Append to end of file\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from save\22 -s p -l private -d \22Restrict access to the current user\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from save\22 -s u -l unlink -d \22Replace as if the destination didn't exist\22\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from save\22 -s v -l print-etag -d \22Print new etag at end\22\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from save\22 -s e -l etag -d \22The etag of the file being overwritten\22\0A\0A# Options of set command\0Acomplete -x -c gio -n \22__fish_seen_subcommand_from set\22 -s t -l type -d \22Type of the attribute\22\0A\0A# Options of trash command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from trash\22 -l empty -d \22Empty the trash\22\0A\0A# Options of tree command\0Acomplete -f -c gio -n \22__fish_seen_subcommand_from tree\22 -s l -l follow-symlinks -d \22Follow symbolic links\22\0A", align 1
