@anon.1d0b41a8d45d477c3029ec78f9b8b434.2090 = private unnamed_addr constant [3575 x i8] c"function __fish_mkbundle_cross_args\0A    mkbundle --list-targets | awk -F '\09- ' '/^Targets available/ { exit } !/^Available targets/ { printf \22%s\\t%s\\n\22, gensub(/^\\t/, \22\22, 1, $1), $2 }'\0Aend\0A\0A# Options\0Acomplete -c mkbundle -l config -r -d 'Bundle DLLMAP Mono config file'\0Acomplete -c mkbundle -l config-dir -r -d 'Use MONO_CFG_DIR environment variable as config dir'\0Acomplete -c mkbundle -n 'not __fish_seen_argument -l sdk -l cross' -l cross -x -a '(__fish_mkbundle_cross_args)' \\\0A    -d 'Create bundle for the specified target platform'\0Acomplete -c mkbundle -l deps \\\0A    -d 'Bundle all of the referenced assemblies for the assemblies listed on the command line option'\0Acomplete -c mkbundle -l env -x -d 'Specify value for the environment variable'\0Acomplete -c mkbundle -l fetch-target -x \\\0A    -d 'Download a precompiled runtime for the specified target from the Mono distribution site'\0Acomplete -c mkbundle -l i18n -x -d 'Use encoding tables to ship with the executable'\0Acomplete -c mkbundle -s L -r -d 'Use path for look for assemblies'\0Acomplete -c mkbundle -l library -r -d 'Embed the dynamic library file'\0Acomplete -c mkbundle -l lists-targets -d 'Show all of the available remote cross compilation targets'\0Acomplete -c mkbundle -l local-targets -d 'Show all of the available local cross compilation targets'\0Acomplete -c mkbundle -l cil-strip -r -d 'Use a CIL stripper that mkbundle will use if able to'\0Acomplete -c mkbundle -l in-tree -r \\\0A    -d 'Use a mono source repository to pull the necessary headers for compilation'\0Acomplete -c mkbundle -l managed-linker -r \\\0A    -d 'Use mkbundle access to a managed linker to preprocess the assemblies'\0Acomplete -c mkbundle -l machine-config -r \\\0A    -d 'Use the given FILE as the machine.config file for the generated application'\0Acomplete -c mkbundle -l no-config \\\0A    -d 'Prevent mkbundle from automatically bundling a config file'\0Acomplete -c mkbundle -l nodeps \\\0A    -d 'Exclude all the assemblies but those were specified on the command line'\0Acomplete -c mkbundle -s o -r -d 'Use output file name'\0Acomplete -c mkbundle -l options -r -d 'Specify configuration options to the Mono runtime'\0Acomplete -c mkbundle -n 'not __fish_seen_argument -l sdk -l cross' -l sdk -r \\\0A    -d 'Use a path from which mkbundle will resolve the Mono SDK from'\0Acomplete -c mkbundle -l target-server -r -d 'Use a different server to provide cross-compiled runtimes'\0Acomplete -c mkbundle -l mono-api-struct-path -r \\\0A    -d 'Use file with the definition of the BundleMonoAPI structure'\0A\0A# Old embedding options\0Acomplete -c mkbundle -s c -d 'Produce the stub file, do not compile the resulting stub'\0Acomplete -c mkbundle -o oo -r \\\0A    -d 'Specify the name to be used for the helper object file that contains the bundle'\0Acomplete -c mkbundle -l keeptemp \\\0A    -d 'Prevent mkbundle from deleting temporary files that it uses to produce the bundle'\0Acomplete -c mkbundle -l nomain -d 'Generate the host stub without a main() function'\0Acomplete -c mkbundle -l static -d 'Statically link to mono and glib'\0Acomplete -c mkbundle -s z -d 'Compress the assemblies before embedding'\0A\0A# AOT options\0Acomplete -c mkbundle -l aot-runtime -r \\\0A    -d 'Use the path to the mono runtime to use for AOTing assemblies'\0Acomplete -c mkbundle -l aot-dedup \\\0A    -d 'Deduplicate AOT\\'ed methods based on a unique mangling of method names'\0Acomplete -c mkbundle -l aot-mode -x \\\0A    -a 'full\\t\22Generate the necessary stubs to not require runtime code generation\22 llvmonly\\t\22Do the same, but force all codegen to go through the llvm backend\22' \\\0A    -d 'Specify AOT mode'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2091 = private unnamed_addr constant [22 x i8] c"completions/mkdir.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2092 = private unnamed_addr constant [828 x i8] c"# Checks if we are using GNU tools\0Aif mkdir --version >/dev/null 2>/dev/null\0A    complete -c mkdir -l version -d 'Output version'\0A    complete -c mkdir -s m -l mode -d 'Set file mode (as in chmod)' -x\0A    complete -c mkdir -s p -l parents -d 'Make parent directories as needed'\0A    complete -c mkdir -s v -l verbose -d 'Print a message for each created directory'\0A    complete -c mkdir -l help -d 'Display help'\0A\0Aelse\0A    complete -c mkdir -s m -d 'Set file mode (as in chmod)' -x\0A    complete -c mkdir -s p -d 'Make parent directories as needed'\0A    complete -c mkdir -s v -d 'Print a message for each created directory'\0Aend\0A\0A# Checks if SELinux is installed\0Aif command -s sestatus >/dev/null 2>/dev/null\0A    complete -c mkdir -l context -s Z -d 'Set SELinux security context of each created directory to the default type'\0Aend\0A", align 1
