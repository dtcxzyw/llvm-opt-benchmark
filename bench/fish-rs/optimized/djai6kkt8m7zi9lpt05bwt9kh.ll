@anon.1d0b41a8d45d477c3029ec78f9b8b434.2246 = private unnamed_addr constant [9851 x i8] c"function __fish_opam_using_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_opam_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A# general flags\0A## ones that work without any subcommand\0Acomplete -f -c opam -l help -d \22Display the manual for an OPAM command\22\0Acomplete -f -c opam -l version -d 'Show version information'\0A## ones that require at least a subcommand (but are shared by all)\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l color -d 'Colorize the output' -a 'always never auto'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l 'compat-mode-1.0' -d 'Compatibility mode with OPAM 1.0'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l debug -d 'Print debug message on stdout'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l git-version -d 'Print the git version if it exists and exit'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l no-aspcud -d 'Do not use the external aspcud solver, even if available'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l no-base-packages -d 'Do not install base packages'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -s q -l quiet -d 'Be quiet when installing a new compiler'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -s r -l root -d 'Use ROOT as the current root path'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l strict -d 'Fail whenever an error is found in a package definition or a configuration file'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -l switch -d 'Use SWITCH as the current compiler switch'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -s v -l verbose -d 'Be more verbose'\0Acomplete -f -c opam -n 'not __fish_opam_needs_command' -s y -l yes -d 'Disable interactive mode and answer yes to all questions'\0A\0A# subcommands\0A## config\0Acomplete -f -c opam -n __fish_opam_needs_command -a config -d \22Display configuration options for packages\22\0A### config flags\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s a -l all -d 'Enable all the global and user configuration options'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l csh -d 'Use csh-compatible mode for configuring OPAM'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l dot-profile -d 'Name of the configuration file to update instead of ~/'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s e -d 'Backward-compatible option, equivalent to opam config env'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l fish -d 'Use fish-compatible mode for configuring OPAM'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s g -l global -d 'Enable all the global configuration options'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s l -l list -d 'List the current configuration'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l no-complete -d 'Do not load the auto-completion scripts in the environment'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l no-switch-eval -d 'Do not install `opam-switch-eval`'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l ocamlinit -d 'Modify ~/'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l profile -d 'Modify ~/. profile'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s R -l rec -d 'Recursive query'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l sexp -d 'Display environment variables as an s-expression'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -l sh -d 'Use sh-compatible mode for configuring OPAM'\0Acomplete -f -c opam -n '__fish_opam_using_command config' -s 