@anon.1d0b41a8d45d477c3029ec78f9b8b434.2962 = private unnamed_addr constant [1771 x i8] c"# xinput, a tool for managing X11 input devices\0Aset -l cmds version list get-feedbacks set-pointer set-mode set-ptr-feedback set-integer-feedback set-button-map query-state list-props set-int-prop set-float-prop set-prop watch-props delete-prop test test-xi2 create-master remove-master reattach float set-cp map-to-output enable disable\0A\0Afunction __fish_xinput_devices\0A    # Yeah, this includes a \22\E2\86\B3\22 char\0A    # There's either this or printing only name or id, not both\0A    xinput list --short | string replace -r '^[\\W\E2\86\B3]*(.*?)\\s+id=([0-9]+).*$' '$2\\t$1'\0A    xinput list --short | string replace -r '^[\\W\E2\86\B3]*(.*?)\\s+id=([0-9]+).*$' '$1'\0Aend\0A\0Afunction __fish_xinput_device_props\0A    set -l device $argv[1]\0A    if test -n \22$device\22\0A        xinput list-props $device | string replace -rf '\\s+(.*?)\\s+\\((\\d+)\\).*' '$2\\t$1'\0A        xinput list-props $device | string replace -rf '\\s+(.*?)\\s+\\((\\d+)\\).*' '$1'\0A    end\0Aend\0A\0Afunction __fish_xinput_nth_token\0A    set -l n $argv[1]\0A    set -l tokens (commandline -cx)\0A    set -e tokens[1] # remove command name\0A    # remove options\0A    set -l tokens (string replace -r --filter '^([^-].*)' '$1' -- $tokens)\0A    if set -q tokens[$n]\0A        echo $tokens[$n]\0A    end\0Aend\0A\0Acomplete -c xinput -f -n \22not __fish_seen_subcommand_from $cmds\22 -a \22$cmds\22\0Acomplete -c xinput -f -n \22__fish_is_nth_token 2; and __fish_seen_subcommand_from list get-feedbacks set-pointer set-mode set-ptr-feedback set-integer-feedback set-button-map query-state list-props set-int-prop set-float-prop set-prop watch-props\22 -a \22(__fish_xinput_devices)\22\0Acomplete -c xinput -f -n \22__fish_seen_subcommand_from list set-int-prop set-float-prop set-prop watch-props; and not __fish_is_nth_token 2\22 -xa \22(__fish_xinput_device_props (__fish_xinput_nth_token 2))\22\0A", align 1
