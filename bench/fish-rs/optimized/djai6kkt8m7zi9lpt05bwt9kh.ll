# Mark exported variables. L means don't abbreviate.\0A        for name in self.do_get_variable_names(\22set -nxL\22):\0A            if name in vars:\0A                vars[name].exported = True\0A\0A        # Do not return history as a variable, it may be so large the browser hangs.\0A        vars.pop(\22history\22, None)\0A\0A        return [\0A            vars[key].get_json_obj()\0A            for key in sorted(vars.keys(), key=lambda x: x.lower())\0A        ]\0A\0A    def do_get_bindings(self):\0A        \22\22\22Get key bindings\22\22\22\0A\0A        # Running __fish_config_interactive print fish greeting and\0A        # loads key bindings\0A        greeting, err = run_fish_cmd(\22 __fish_config_interactive\22)\0A\0A        # Load the key bindings and then list them with bind\0A        out, err = run_fish_cmd(\22__fish_config_interactive; bind\22)\0A\0A        # Remove fish greeting from output\0A        out = out[len(greeting) :]\0A\0A        # Put all the bindings into a list\0A        bindings = []\0A        command_to_binding = {}\0A\0A        for line in out.split(\22\\n\22):\0A            comps = line.split(\22 \22, 2)\0A\0A            # If we don't have \22bind\22, a sequence and a mapping,\0A            # it's not a valid binding.\0A            if len(comps) != 3:\0A                continue\0A\0A            # Store the \22--preset\22 value for later\0A            if comps[1] == \22--preset\22:\0A                preset = True\0A                # There's possibly a way to do this faster, but it's not important.\0A                comps = line.split(\22 \22, 3)[1:]\0A            elif comps[1] == \22--user\22:\0A                preset = False\0A                comps = line.split(\22 \22, 3)[1:]\0A            # Check again if we removed the level.\0A            if len(comps) != 3:\0A                continue\0A\0A            key = comps[1]\0A            command = comps[2]\0A\0A            if command in bindings_blacklist:\0A                continue\0A\0A            if command in command_to_binding:\0A                fish_binding = command_to_binding[command]\0A                fish_binding.add_binding(line, key)\0A            else:\0A                fish_binding = FishBinding(command, line, key)\0A                bindings.append(fish_binding)\0A                command_to_binding[command] = fish_binding\0A\0A        return [binding.get_json_obj() for binding in bindings]\0A\0A    def do_get_history(self):\0A        # Use NUL to distinguish between history items.\0A        out, err = run_fish_cmd(\22builtin history -z\22)\0A        result = out.split(\22\\0\22)\0A        if result:\0A            result.pop()  # trim off the trailing element\0A        return result\0A\0A    def do_get_color_for_variable(self, name):\0A        \22Return the color with the given name, or the empty string if there is none.\22\0A        out, err = run_fish_cmd(\22echo -n $\22 + name)\0A        return out\0A\0A    def do_set_color_for_variable(self, name, color):\0A        \22Sets a color for a fish color name, like 'autosuggestion'\22\0A        if not name:\0A            raise ValueError\0A        if not color and not color == \22\22:\0A            color = \22normal\22\0A        else:\0A            color = unparse_color(color)\0A        if not name.startswith(\22fish_pager_color_\22):\0A            varname = \22fish_color_\22 + name\0A        # If the name already starts with \22fish_\22, use it as the varname\0A        # This is needed for 'fish_pager_color' vars.\0A        if name.startswith(\22fish_\22):\0A            varname = name\0A        # Check if the varname is allowable.\0A        varname = varname.strip()\0A        if not re.match(\22^[a-zA-Z0-9_]+$\22, varname):\0A            print(\22Refusing to use variable name: '\22, varname, \22'\22)\0A            return\0A        color = color.strip()\0A        if not re.match(\22^[a-zA-Z0-9_= -]*$\22, color):\0A            print(\22Refusing to use color value: \22, color)\0A            return\0A        command = \22set -U \22 + varname\0A        command += \22 \22 + color\0A\0A        out, err = run_fish_cmd(command)\0A        return out\0A\0A    def do_get_function(self, func_name):\0A        out, err = run_fish_cmd(\22functions \22 + func_name + \22 | fish_indent --html\22)\0A        return out\0A\0A    def do_delete_history_item(self, history_item_text):\0A        # It's really lame that we always return success here\0A        cmd = (\0A            \22builtin history delete --case-sensitive --exact -- %s; builtin history save\22\0A            % escape_fish_cmd(history_item_text)\0A        )\0A        out, err = run_fish_cmd(cmd)\0A        return True\0A\0A    def do_set_prompt_function(self, prompt_func):\0A        cmd = (\0A            \22functions -e fish_right_prompt; \22\0A            + prompt_func\0A            + \22\\n\22\0A            + \22funcsave fish_prompt && funcsave fish_right_prompt 2>/dev/null\22\0A        )\0A        out, err = run_fish_cmd(cmd)\0A        return len(err) == 0\0A\0A    def do_get_prompt(self, prompt_function_text, extras_dict):\0A        # Return the prompt output by the given command\0A        cmd = (\0A            prompt_function_text\0A            + '\\n builtin cd \22'\0A            + initial_wd\0A            + '\22 \\n false \\n fish_prompt\\n'\0A        )\0A        prompt_demo_ansi, err = run_fish_cmd(cmd)\0A        prompt_demo_html = ansi_to_html(prompt_demo_ansi)\0A        right_demo_ansi, err = run_fish_cmd(\0A            \22functions -e fish_right_prompt; \22\0A            + prompt_function_text\0A            + '\\n builtin cd \22'\0A            + initial_wd\0A            + '\22 \\n false \\n functions -q fish_right_prompt && fish_right_prompt\\n'\0A        )\0A        right_demo_html = ansi_to_html(right_demo_ansi)\0A        prompt_demo_font_size = self.font_size_for_ansi_prompt(\0A            prompt_demo_ansi + right_demo_ansi\0A        )\0A        result = {\0A            \22function\22: prompt_function_text,\0A            \22demo\22: prompt_demo_html,\0A            \22font_size\22: prompt_demo_font_size,\0A            \22right\22: right_demo_html,\0A        }\0A        if extras_dict:\0A            result.update(extras_dict)\0A        return result\0A\0A    def do_get_current_prompt(self):\0A        # Return the current prompt. We run 'false' to demonstrate how the\0A        # prompt shows the command status (#1624).\0A        prompt_func, err = run_fish_cmd(\0A            \22functions fish_prompt; functions fish_right_prompt\22\0A        )\0A        result = self.do_get_prompt(\0A            prompt_func.strip(),\0A            {\22name\22: \22Current\22},\0A        )\0A        return result\0A\0A    def do_get_sample_prompt(self, text, extras_dict):\0A        # Return the prompt you get from the given text. Extras_dict is a\0A        # dictionary whose values get merged in. We run 'false' to demonstrate\0A        # how the prompt shows the command status (#1624)\0A        return self.do_get_prompt(text.strip(), extras_dict)\0A\0A    def parse_one_sample_prompt_hash(self, line, result_dict):\0A        # Allow us to skip whitespace, etc.\0A        if not line:\0A            return True\0A        if line.isspace():\0A            return True\0A\0A        # Parse a comment hash like '# name: Classic'\0A        match = re.match(r\22#\\s*(\\w+?): (.+)\22, line, re.IGNORECASE)\0A        if match:\0A            key = match.group(1).strip()\0A            value = match.group(2).strip()\0A            result_dict[key] = value\0A            return True\0A        # Skip other hash comments\0A        return line.startswith(\22#\22)\0A\0A    def read_one_sample_prompt(self, path):\0A        try:\0A            with open(path, \22rb\22) as fd:\0A                extras_dict = {}\0A                # Read one sample prompt from fd\0A                function_lines = []\0A                parsing_hashes = True\0A                unicode_lines = (line.decode(\22utf-8\22) for line in fd)\0A                for line in unicode_lines:\0A                    # Parse hashes until parse_one_sample_prompt_hash return\0A                    # False.\0A                    if parsing_hashes:\0A                        parsing_hashes = self.parse_one_sample_prompt_hash(\0A                            line, extras_dict\0A                        )\0A                    # Maybe not we're not parsing hashes, or maybe we already\0A                    # were not.\0A                    if not parsing_hashes:\0A                        function_lines.append(line)\0A                func = \22\22.join(function_lines).strip()\0A                result = self.do_get_sample_prompt(func, extras_dict)\0A                return result\0A        except IOError:\0A            # Ignore unreadable files, etc.\0A            return None\0A\0A    def do_get_sample_prompts_list(self):\0A        paths = sorted(glob.iglob(\22sample_prompts/*.fish\22))\0A        result = []\0A        try:\0A            pool = multiprocessing.pool.ThreadPool(processes=8)\0A\0A            # Kick off the \22Current\22 meta-sample\0A            current_metasample_async = pool.apply_async(self.do_get_current_prompt)\0A\0A            # Read all of the prompts in sample_prompts\0A            sample_results = pool.map(self.read_one_sample_prompt, paths, 1)\0A            result.append(current_metasample_async.get())\0A            result.extend([r for r in sample_results if r])\0A        except ImportError:\0A            # If the platform doesn't support multiprocessing, we just do it one at a time.\0A            # This happens e.g. on Termux.\0A            print(\0A                \22Platform doesn't support multiprocessing, running one at a time. This may take a while.\22\0A            )\0A            result.append(self.do_get_current_prompt())\0A            result.extend([self.read_one_sample_prompt(path) for path in paths])\0A        return result\0A\0A    def secure_startswith(self, haystack, needle):\0A        if len(haystack) < len(needle):\0A            return False\0A        bits = 0\0A        for x, y in zip(haystack, needle):\0A            bits |= ord(x) ^ ord(y)\0A        return bits == 0\0A\0A    def font_size_for_ansi_prompt(self, prompt_demo_ansi):\0A        width = ansi_prompt_line_width(prompt_demo_ansi)\0A        # Pick a font size\0A        if width >= 70:\0A            font_size = \228pt\22\0A        if width >= 60:\0A            font_size = \2210pt\22\0A        elif width >= 50:\0A            font_size = \2211pt\22\0A        elif width >= 40:\0A            font_size = \2213pt\22\0A        elif width >= 30:\0A            font_size = \2215pt\22\0A        elif width >= 25:\0A            font_size = \2216pt\22\0A        elif width >= 20:\0A            font_size = \2217pt\22\0A        else:\0A            font_size = \2218pt\22\0A        return font_size\0A\0A    def do_GET(self):\0A        p = self.path\0A\0A        authpath = \22/\22 + authkey\0A        if self.secure_startswith(p, authpath):\0A            p = p[len(authpath) :]\0A        else:\0A            return self.send_error(403)\0A        self.path = p\0A\0A        if p == \22/colors/\22:\0A            # Construct our colorschemes.\0A            # Add the current scheme first, then the default.\0A            # The rest in alphabetical order.\0A            curcolors, curinfo = self.do_get_colors()\0A            defcolors, definfo = self.do_get_colors(\22themes/fish default.theme\22)\0A            curinfo.update({\22theme\22: \22Current\22, \22colors\22: curcolors})\0A            definfo.update({\22theme\22: \22fish default\22, \22colors\22: defcolors})\0A            output = [curinfo, definfo]\0A\0A            confighome = (\0A                os.environ[\22XDG_CONFIG_HOME\22]\0A                if \22XDG_CONFIG_HOME\22 in os.environ\0A                else os.path.expanduser(\22~\22)\0A            )\0A            paths = list(glob.iglob(os.path.join(confighome, \22fish\22, \22themes/*.theme\22)))\0A            paths.extend(list(glob.iglob(\22themes/*.theme\22)))\0A            paths.sort(key=str.casefold)\0A\0A            for p in paths:\0A                theme = os.path.splitext(os.path.basename(p))[0]\0A                if any(theme == d[\22theme\22] for d in output):\0A                    continue\0A                out, outinfo = self.do_get_colors(p)\0A                outinfo.update({\22theme\22: theme, \22colors\22: out})\0A                output.append(outinfo)\0A        elif p == \22/functions/\22:\0A            output = self.do_get_functions()\0A        elif p == \22/variables/\22:\0A            output = self.do_get_variables()\0A        elif p == \22/history/\22:\0A            # start = time.time()\0A            output = self.do_get_history()\0A            # end = time.time()\0A            # print \22History: \22, end - start\0A        elif p == \22/sample_prompts/\22:\0A            output = self.do_get_sample_prompts_list()\0A        elif re.match(r\22/color/(\\w+)/\22, p):\0A            name = re.match(r\22/color/(\\w+)/\22, p).group(1)\0A            output = self.do_get_color_for_variable(name)\0A        elif p == \22/bindings/\22:\0A            output = self.do_get_bindings()\0A        else:\0A            return SimpleHTTPServer.SimpleHTTPRequestHandler.do_GET(self)\0A\0A        # Return valid output\0A        self.send_response(200)\0A        self.send_header(\22Content-type\22, \22application/json\22)\0A        self.end_headers()\0A        self.write_to_wfile(\22\\n\22)\0A\0A        # Output JSON\0A        self.write_to_wfile(json.dumps(output))\0A\0A    def do_POST(self):\0A        p = self.path\0A\0A        authpath = \22/\22 + authkey\0A        if self.secure_startswith(p, authpath):\0A            p = p[len(authpath) :]\0A        else:\0A            return self.send_error(403)\0A        self.path = p\0A\0A        # This is cheesy, we want just the actual content-type.\0A        # In some cases it'll give us the encoding as well,\0A        # (\22application/json;charset=utf-8\22)\0A        # but we don't currently care.\0A        ctype = self.headers[\22content-type\22].split(\22;\22)[0]\0A\0A        if ctype == \22application/x-www-form-urlencoded\22:\0A            length = int(self.headers[\22content-length\22])\0A            url_str = self.rfile.read(length).decode(\22utf-8\22)\0A            postvars = parse_qs(url_str, keep_blank_values=1)\0A        elif ctype == \22application/json\22:\0A            length = int(self.headers[\22content-length\22])\0A            # This used to use the provided encoding, but we use utf-8\0A            # all around the place and nobody has ever complained.\0A            #\0A            # If any other encoding is received this will raise a UnicodeError,\0A            # which will throw us out of the function and should at most exit webconfig.\0A            # If that happens to anyone we expect bug reports.\0A            url_str = self.rfile.read(length).decode(\22utf-8\22)\0A            postvars = json.loads(url_str)\0A        elif ctype == \22multipart/form-data\22:\0A            # This used to be a thing, as far as I could find there's\0A            # no use anymore, but let's keep an error around just in case.\0A            return self.send_error(500)\0A        else:\0A            postvars = {}\0A\0A        if p == \22/set_color/\22:\0A            print(\22# Colorscheme: \22 + postvars.get(\22theme\22))\0A            have_colors = set()\0A            known_colors = set(\0A                (\0A                    \22fish_color_normal\22,\0A                    \22fish_color_command\22,\0A                    \22fish_color_keyword\22,\0A                    \22fish_color_quote\22,\0A                    \22fish_color_redirection\22,\0A                    \22fish_color_end\22,\0A                    \22fish_color_error\22,\0A                    \22fish_color_param\22,\0A                    \22fish_color_option\22,\0A                    \22fish_color_comment\22,\0A                    \22fish_color_selection\22,\0A                    \22fish_color_operator\22,\0A                    \22fish_color_escape\22,\0A                    \22fish_color_autosuggestion\22,\0A                    \22fish_color_cwd\22,\0A                    \22fish_color_user\22,\0A                    \22fish_color_host\22,\0A                    \22fish_color_host_remote\22,\0A                    \22fish_color_cancel\22,\0A                    \22fish_color_search_match\22,\0A                    \22fish_pager_color_progress\22,\0A                    \22fish_pager_color_background\22,\0A                    \22fish_pager_color_prefix\22,\0A                    \22fish_pager_color_completion\22,\0A                    \22fish_pager_color_description\22,\0A                    \22fish_pager_color_selected_background\22,\0A                    \22fish_pager_color_selected_prefix\22,\0A                    \22fish_pager_color_selected_completion\22,\0A                    \22fish_pager_color_selected_description\22,\0A                    \22fish_pager_color_secondary_background\22,\0A                    \22fish_pager_color_secondary_prefix\22,\0A                    \22fish_pager_color_secondary_completion\22,\0A                    \22fish_pager_color_secondary_description\22,\0A                )\0A            )\0A            output = \22\22\0A            for item in postvars.get(\22colors\22):\0A                what = item.get(\22what\22)\0A                color = item.get(\22color\22)\0A\0A                if what:\0A                    if not what.startswith(\22fish_pager_color_\22) and not what.startswith(\0A                        \22fish_color_\22\0A                    ):\0A                        have_colors.add(\22fish_color_\22 + what)\0A                    else:\0A                        have_colors.add(what)\0A                    output = self.do_set_color_for_variable(what, color)\0A\0A            # Set all known colors that weren't defined in this theme\0A            # to empty, to avoid keeping around coloration from an earlier theme.\0A            for what in known_colors - have_colors:\0A                output += \22\\n\22 + self.do_set_color_for_variable(what, \22\22)\0A\0A        elif p == \22/get_function/\22:\0A            what = postvars.get(\22what\22)\0A            output = [self.do_get_function(what[0])]\0A        elif p == \22/delete_history_item/\22:\0A            what = postvars.get(\22what\22)\0A            if self.do_delete_history_item(what[0]):\0A                output = [\22OK\22]\0A            else:\0A                output = [\22Unable to delete history item\22]\0A        elif p == \22/set_prompt/\22:\0A            what = postvars.get(\22fish_prompt\22)\0A            if self.do_set_prompt_function(what):\0A                output = [\22OK\22]\0A            else:\0A                output = [\22Unable to set prompt\22]\0A        else:\0A            return self.send_error(404)\0A\0A        # Return valid output\0A        self.send_response(200)\0A        self.send_header(\22Content-type\22, \22application/json\22)\0A        self.end_headers()\0A        self.write_to_wfile(\22\\n\22)\0A\0A        # Output JSON\0A        self.write_to_wfile(json.dumps(output))\0A\0A    def log_request(self, code=\22-\22, size=\22-\22):\0A        \22\22\22Disable request logging\22\22\22\0A        pass\0A\0A    def log_error(self, format, *args):\0A        if format == \22code %d, message %s\22 and hasattr(self, \22path\22):\0A            # This appears to be a send_error() message\0A            # We want to include the path (if we have one)\0A            (code, msg) = args\0A            format = \22code %d, message %s, path %s\22\0A            args = (code, msg, self.path)\0A        SimpleHTTPServer.SimpleHTTPRequestHandler.log_error(self, format, *args)\0A\0A\0Aredirect_template_html = \22\22\22\0A<!DOCTYPE html>\0A<html>\0A <head>\0A  <meta http-equiv=\22refresh\22 content=\220;URL='%s'\22 />\0A </head>\0A <body>\0A  <p><a href=\22%s\22>Start the Fish