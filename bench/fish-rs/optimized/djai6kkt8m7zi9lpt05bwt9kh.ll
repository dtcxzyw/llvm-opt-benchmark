command_from smoothtime\22 -a reset -d \22Reset time smoothing\22\0A\0A## Monitoring access\0Acomplete -f -c chronyc -n __fish_use_subcommand -a cmdaccheck -d \22Check whether address is allowed\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a cmdallow -d \22Allow access to subnet as a default\22\0Acomplete -f -c chronyc -n \22__fish_seen_subcommand_from cmdallow\22 -a all -d \22Allow access to subnet and all children\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a cmddeny -d \22Deny access to subnet as a default\22\0Acomplete -f -c chronyc -n \22__fish_seen_subcommand_from cmddeny\22 -a all -d \22Deny access to subnet and all children\22\0A\0A## RTC\0Acomplete -f -c chronyc -n __fish_use_subcommand -a rtcdata -d \22Print current RTC performance parameters\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a trimrtc -d \22Correct RTC relative to system clock\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a writertc -d \22Save RTC performance parameters to file\22\0A\0A## Other daemon commands\0Acomplete -f -c chronyc -n __fish_use_subcommand -a cyclelogs -d \22Close and reopen log files\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a dump -d \22Dump all measurements to save files\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a rekey -d \22Reread keys from key file\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a shutdown -d \22Stop daemon\22\0A\0A## Client commands\0Acomplete -f -c chronyc -n __fish_use_subcommand -a dns -d \22Configure how hostname and IP address are resolved\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a timeout -d \22Set initial response timeout\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a retries -d \22Set max number of retries\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a keygen -d \22Generate key for key file\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a \22exit quit\22 -d \22Leave the program\22\0Acomplete -f -c chronyc -n __fish_use_subcommand -a help -d \22Show help message\22\0A", align 1
