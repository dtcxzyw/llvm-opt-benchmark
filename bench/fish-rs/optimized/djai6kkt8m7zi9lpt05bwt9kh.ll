@anon.1d0b41a8d45d477c3029ec78f9b8b434.2746 = private unnamed_addr constant [1794 x i8] c"complete touch -d \22change file access and modification times\22\0A# common options\0Acomplete touch -s a -d \22change access time (atime)\22\0Acomplete touch -s m -d \22change modification time (mtime)\22\0Acomplete touch -s t -d \22use specified time [[CC]YY]MMDDhhmm[.SS]\22\0A\0Aif touch --version 2>/dev/null >/dev/null # GNU\0A    complete touch -s B -l backward -x -d \22set date back\22\0A    complete touch -s c -l no-create -d \22don't create file if it doesn't exist\22\0A    complete touch -s d -l date -x -d \22set to specified YYYY-MM-DDThh:mm:SS[.frac][tz]\22\0A    complete touch -s f -l forward -x -d \22set date forward\22\0A    complete touch -s r -l reference -d \22use times from specified reference file\22\0A    # TODO these may require that = but builtin complete doesn't seem to infer it should\0A    # use = here\0A    complete touch -l time -x -d \22change specified kind of timestamp\22 -a \\\0A        \22atime\\t'change access time (atime) only'\0A    access\\t'change access time (atime) only'\0A    use\\t'change access time (atime) only'\0A    mtime\\t'change modification time (mtime) only'\0A    modify\\t'change modification time (mtime) only'\22\0A    complete touch -l help -d \22display help\22\0A    complete touch -l version -d \22display version\22\0Aelse # not GNU\0A    set -l uname (uname -s)\0A    contains $uname Darwin DragonFly FreeBSD\0A    and complete touch -s A -d \22adjust timestamps by relative value [-][hh]mm]SS\22 -x\0A    contains $uname Darwin DragonFly FreeBSD NetBSD\0A    and complete touch -s h -d \22act on symbolic links themselves\22\0A    contains $uname Darwin DragonFly FreeBSD OpenBSD SunOS\0A    and complete touch -s d -d \22set to specified YYYY-MM-DDThh:mm:SS[.frac][tz]\22 -x\0A    # common BSD options\0A    complete touch -s c -d \22don't create file if it doesn't exist\22\0A    complete touch -s r -d \22use times from specified reference file\22 -r\0Aend\0A", align 1
