@anon.1d0b41a8d45d477c3029ec78f9b8b434.2796 = private unnamed_addr constant [1255 x i8] c"if test (uname) = Darwin\0A    complete -c uname -s a -d 'Behave as though all of the options mnrsv were specified.'\0A    complete -c uname -s m -d 'print the machine hardware name.'\0A    complete -c uname -s n -d 'print the nodename'\0A    complete -c uname -s p -d 'print the machine processor architecture name.'\0A    complete -c uname -s r -d 'print the operating system release.'\0A    complete -c uname -s s -d 'print the operating system name.'\0A    complete -c uname -s v -d 'print the operating system version.'\0Aelse\0A    complete -c uname -s a -l all -d \22Print all information\22\0A    complete -c uname -s s -l kernel-name -d \22Print kernel name\22\0A    complete -c uname -s n -l nodename -d \22Print network node hostname\22\0A    complete -c uname -s r -l kernel-release -d \22Print kernel release\22\0A    complete -c uname -s v -l kernel-version -d \22Print kernel version\22\0A    complete -c uname -s m -l machine -d \22Print machine name\22\0A    complete -c uname -s p -l processor -d \22Print processor\22\0A    complete -c uname -s i -l hardware-platform -d \22Print hardware platform\22\0A    complete -c uname -s o -l operating-system -d \22Print operating system\22\0A    complete -c uname -l help -d \22Display help and exit\22\0A    complete -c uname -l version -d \22Display version and exit\22\0Aend\0A", align 1
