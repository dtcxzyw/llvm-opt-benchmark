@anon.1d0b41a8d45d477c3029ec78f9b8b434.1450 = private unnamed_addr constant [2340 x i8] c"complete -c date -f -d \22display or set date and time\22\0Aif date --version >/dev/null 2>/dev/null\0A    complete -c date -s d -l date -d \22Display date described by string\22 -x\0A    complete -c date -s f -l file -d \22Display date for each line in file\22 -r\0A    complete -c date -s I -l iso-8601 -d \22Use ISO 8601 output format\22 -x -a \22date hours minutes seconds\22\0A    complete -c date -s s -l set -d \22Set time\22 -x\0A    complete -c date -s R -l rfc-2822 -d \22Output in RFC 2822 format\22\0A    complete -c date -s r -l reference -d \22Display last modification time of file\22 -r\0A    complete -c date -s u -l utc -d \22Print/set UTC time\22 -f\0A    complete -c date -l universal -d \22Print/set UTC time\22 -f\0A    complete -c date -s h -l help -d \22Display help and exit\22 -f\0A    complete -c date -s v -l version -d \22Display version and exit\22 -f\0Aelse\0A    complete -c date -s u -d 'Display or set UTC time' -f\0A    complete -c date -s j -d \22Don't try to set the date\22 -f\0A\0A    set -l uname (uname -s)\0A\0A    switch $uname\0A        case FreeBSD Darwin DragonFly\0A            # only -u is actually POSIX. Rest are BSD extensions:\0A            complete -c date -s r -d \22Format path mtime or UNIX timestamp\22 -r\0A            complete -c date -s v -d 'Adjust clock \C2\B1 time specified' -f\0A            complete -c date -s R -d \22Use RFC 2822 output format\22\0A\0A            set -l release_major (printf '%d' (uname -r) 2>/dev/null)\0A\0A            # -d,t gone in Monterey, FreeBSD 13\0A            if test \\( \22$uname\22 = FreeBSD -a \22$release_major\22 -lt 13 \\) -o \\( \22$uname\22 = Darwin -a \22$release_major\22 -lt 21 \\)\0A                complete -c date -s t -d \22Set system's minutes west of GMT\22 -x\0A                complete -c date -s d -d \22Set system's value for DST\22 -x\0A            else\0A                complete -c date -s I -d \22Use ISO 8601 output format\22 -x -a \22date hours minutes seconds\22\0A            end\0A\0A        case NetBSD OpenBSD\0A            complete -c date -s a -d \22Change clock slowly with adjtime\22 -x\0A            complete -c date -s r -d \22Show date given seconds since epoch\22 -x\0A            if test \22$uname\22 = NetBSD\0A                complete -c date -s d -d \22Parse human-described date-time and show result\22 -x\0A                exit\0A            end\0A            complete -c date -s z -d \22Specify timezone for output\22 -x\0A    end\0A\0A    complete -c date -s f -d 'Use format string to parse date' -f\0Aend\0A", align 1
