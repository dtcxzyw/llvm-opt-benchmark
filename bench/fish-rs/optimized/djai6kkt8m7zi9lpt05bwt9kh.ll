         end\0A            set branch \22($branch)\22\0A        end\0A    end\0A\0A    if test true = $inside_gitdir\0A        if test true = $bare_repo\0A            set bare \22BARE:\22\0A        else\0A            # Let user know they're inside the git dir of a non-bare repo\0A            set branch \22GIT_DIR!\22\0A        end\0A    end\0A\0A    echo $operation\0A    echo $branch\0A    echo $detached\0A    echo $bare\0Aend\0A\0Afunction __fish_git_prompt_set_char\0A    set -l user_variable_name \22$argv[1]\22\0A    set -l char $argv[2]\0A\0A    if set -q argv[3]\0A        and begin\0A            contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A            or contains -- \22$__fish_git_prompt_use_informative_chars\22 yes true 1\0A        end\0A        set char $argv[3]\0A    end\0A\0A    set -l variable _$user_variable_name\0A    set -l variable_done \22$variable\22_done\0A\0A    if not set -q $variable\0A        set -g $variable (set -q $user_variable_name; and echo $$user_variable_name; or echo $char)\0A    end\0Aend\0A\0Afunction __fish_git_prompt_validate_chars --description \22fish_git_prompt helper, checks char variables\22\0A    # cleanstate is only defined with actual informative status.\0A    contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A    and __fish_git_prompt_set_char __fish_git_prompt_char_cleanstate '\E2\9C\94'\0A    or __fish_git_prompt_set_char __fish_git_prompt_char_cleanstate ''\0A\0A    __fish_git_prompt_set_char __fish_git_prompt_char_dirtystate '*' '\E2\9C\9A'\0A    __fish_git_prompt_set_char __fish_git_prompt_char_invalidstate '#' '\E2\9C\96'\0A    __fish_git_prompt_set_char __fish_git_prompt_char_stagedstate '+' '\E2\97\8F'\0A    __fish_git_prompt_set_char __fish_git_prompt_char_stashstate '$' '\E2\9A\91'\0A    __fish_git_prompt_set_char __fish_git_prompt_char_stateseparator ' ' '|'\0A    __fish_git_prompt_set_char __fish_git_prompt_char_untrackedfiles '%' '\E2\80\A6'\0A    __fish_git_pr