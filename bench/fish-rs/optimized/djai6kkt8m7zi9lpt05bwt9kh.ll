@anon.1d0b41a8d45d477c3029ec78f9b8b434.2198 = private unnamed_addr constant [1528 x i8] c"function __fish_ninja\0A    set -l saved_args $argv\0A    set -l dir .\0A    if argparse -i C/dir= -- (commandline -xpc)\0A        command ninja -C$_flag_C $saved_args\0A    end\0Aend\0A\0Afunction __fish_print_ninja_tools\0A    __fish_ninja -t list | string match -v '*:' | string replace -r '\\s+(\\w+).*' '$1'\0Aend\0A\0Afunction __fish_print_ninja_targets\0A    __fish_ninja -t targets 2>/dev/null | string replace -r ':.*' ''\0A    __fish_ninja -t targets all 2>/dev/null | string replace -r ':.*' '' | string match -e -r '\\.(?:o|so|a)$'\0Aend\0Acomplete -c ninja -f -a '(__fish_print_ninja_targets)' -d target\0Acomplete -x -c ninja -s t -x -a \22(__fish_print_ninja_tools)\22 -d subtool\0Acomplete -x -c ninja -s C -x -a \22(__fish_complete_directories (commandline -ct))\22 -d \22change to specified directory\22\0Acomplete -c ninja -s f -k -x -a \22(__fish_complete_suffix .ninja)\22 -d \22specify build file [default=build.ninja]\22\0Acomplete -f -c ninja -s n -d \22dry run\22\0Acomplete -f -c ninja -s v -d \22show all command lines while building\22\0Acomplete -f -c ninja -s j -d \22number of jobs to run in parallel [default derived from CPUs]\22\0Acomplete -f -c ninja -s l -d \22do not start if load average > N\22\0Acomplete -f -c ninja -s k -d \22keep going until N jobs fail [default=1]\22\0Acomplete -f -c ninja -s h -d \22show help\22\0Acomplete -f -c ninja -s d -d \22enable debugging, specify debug mode\22\0Acomplete -f -c ninja -s w -d \22adjust warnings, specify flags\22\0Acomplete -f -c ninja -s v -l verbose -d \22show all command lines while building\22\0Acomplete -f -c ninja -l version -d \22print ninja version\22\0A", align 1
