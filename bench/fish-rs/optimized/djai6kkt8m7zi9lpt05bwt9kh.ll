@anon.1d0b41a8d45d477c3029ec78f9b8b434.1492 = private unnamed_addr constant [912 x i8] c"# Completions for the dm-tool command (part of the lightdm display manager)\0A\0Aset -l cmds 'add-local-x-seat add-nested-seat add-seat list-seats lock switch-to-greeter switch-to-guest switch-to-user'\0A\0Acomplete -c dm-tool -f\0Acomplete -c dm-tool -n \22not __fish_seen_subcommand_from $cmds\22 -s h -l help -x -d \22Show help options\22\0Acomplete -c dm-tool -n \22not __fish_seen_subcommand_from $cmds\22 -s v -l version -x -d \22Show release version\22\0Acomplete -c dm-tool -n \22not __fish_seen_subcommand_from $cmds\22 -l session-bus -d \22Connect using the session bus\22\0A\0Acomplete -c dm-tool -n \22not __fish_seen_subcommand_from $cmds\22 -xa \22$cmds\22\0A\0A# switch-to-user\0Aset -l session_users \22(dm-tool list-seats | string replace -rf '.*UserName=' '' | string trim -c '\\'')\22\0Aset -l has_user \22__fish_seen_subcommand_from $session_users\22\0Acomplete -c dm-tool -n \22__fish_seen_subcommand_from switch-to-user; and not $has_user\22 -xa \22$session_users\22\0A", align 1
