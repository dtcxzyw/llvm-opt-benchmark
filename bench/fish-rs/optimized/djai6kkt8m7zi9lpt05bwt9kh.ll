@anon.1d0b41a8d45d477c3029ec78f9b8b434.2864 = private unnamed_addr constant [6582 x i8] c"function __fish_watchexec_print_remaining_args\0A    set -l spec w/watch= c/clear='?' o/on-busy-update= r/restart s/signal= stop-signal= stop-timeout= d/debounce= stdin-quit no-vcs-ignore no-project-ignore no-global-ignore no-default-ignore no-discover-ignore p/postpone delay-run= poll= shell= n no-environment emit-events-to= E/env= no-process-group N/notify project-origin= workdir= e/exts= f/filter= filter-file= i/ignore= ignore-file= fs-events= no-meta print-events v/verbose log-file= manual h/help V/version\0A\0A    set argv (commandline -xpc | string escape) (commandline -ct)\0A    set -e argv[1]\0A\0A    argparse -s $spec -- $argv 2>/dev/null\0A\0A    # The remaining argv is the subcommand with all its options, which is what\0A    # we want.\0A    if set -q argv[1]\0A        and not string match -qr '^-.*' -- $argv[1]\0A        string join0 -- $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_watchexec_complete_subcommand\0A    set -l args (__fish_watchexec_print_remaining_args | string split0)\0A    complete -C \22$args\22\0Aend\0A\0Afunction __fish_watchexec_at_argfile\0A    set -l current (commandline -ct)\0A    if test (count (commandline -xpc)) -eq 1\0A        and string match -q '@*' -- $current\0A\0A        set current (string sub -s 2 -- $current)\0A        __fish_complete_path | string replace -r \22^\22 @\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Acomplete -c watchexec -n __fish_watchexec_at_argfile -x -a \22(__fish_watchexec_at_argfile)\22\0A\0Acomplete -c watchexec -x -a \22(__fish_watchexec_complete_subcommand)\22\0A\0Acomplete -c watchexec -n \22not __fish_watchexec_print_remaining_args\22 -sw -lwatch -r -d \22Watch a specific file or directory\22\0Acomplete -c watchexec -n \22not __fish_watchexec_print_remaining_args\22 -sc -lclear -fa reset -d \22Clear screen before running command\22\0Acomplete -c watch