@anon.1d0b41a8d45d477c3029ec78f9b8b434.3339 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_windows_users.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3340 = private unnamed_addr constant [121 x i8] c"function __fish_print_windows_users --description 'Print Windows user names'\0A    wmic useraccount get name | tail +2\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3341 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_xbps_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3342 = private unnamed_addr constant [898 x i8] c"function __fish_print_xbps_packages\0A    # Caches for 5 minutes\0A    type -q -f xbps-query || return 1\0A\0A    argparse i/installed -- $argv\0A    or return 1\0A\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A\0A    if not set -q _flag_installed\0A        set -l cache_file $xdg_cache_home/xbps\0A        if test -f $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 300\0A            if test $age -lt $max_age\0A                cat $cache_file\0A                return\0A            end\0A        end\0A        __fish_cache_put $cache_file\0A        # prints: <package name>\09Package\0A        xbps-query -Rs \22\22 | sed 's/^... \\([^ ]*\\)-.* .*/\\1/; s/$/\\t'Package'/' | tee $cache_file\0A        return 0\0A    else\0A        xbps-query -l | sed 's/^.. \\([^ ]*\\)-.* .*/\\1/' # TODO: actually put package versions in tab for locally installed packages\0A        return 0\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3343 = private unnamed_addr constant [56 x i8] c"functions/__fish_print_xdg_applications_directories.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3344 = private unnamed_addr constant [612 x i8] c"function __fish_print_xdg_applications_directories --description 'Print directories where desktop files are stored'\0A    set -l data_home $XDG_DATA_HOME\0A    if test -z \22$data_home\22\0A        set data_home $HOME/.local/share/\0A    end\0A\0A    set -l data_dirs $XDG_DATA_DIRS\0A    if test -z \22$data_dirs\22\0A        set data_dirs /usr/local/share/:/usr/share/\0A    end\0A\0A    set data_dirs $data_home:$data_dirs\0A\0A    # We don't know if the dir ended in a \22/\22 or not, but duplicate slashes are okay.\0A    for path in (string split : $data_dirs)/applications\0A        if test -d $path\0A            echo $path\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3345 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_xdg_mimetypes.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3346 = private unnamed_addr constant [328 x i8] c"function __fish_print_xdg_mimetypes --description 'Print XDG mime types'\0A    set -l files (__fish_print_xdg_applications_directories)/mimeinfo.cache\0A    # If we have no file, don't run `cat` without arguments!\0A    set -q files[1] || return 1\0A    cat $files 2>/dev/null | string match -v '[MIME Cache]' | string replace = \\t\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3347 = private unnamed_addr constant [36 x i8] c"functions/__fish_print_xwindows.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3348 = private unnamed_addr constant [192 x i8] c"function __fish_print_xwindows --description 'Print X windows'\0A    xwininfo -root -children | sed '/^\\s\\+0x/!d; /(has no name)/d; s/^\\s*\\(\\S\\+\\)\\s\\+\22\\(.\\+\\)\22:\\s\\+(\\(.*\\)).*$/\\1\\t\\2 (\\3)/'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3349 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_zfs_snapshots.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3350 = private unnamed_addr constant [790 x i8] c"function __fish_print_zfs_snapshots -d \22Lists ZFS snapshots\22\0A    set fast_results (zfs list -o name -H)\0A    printf \22%s\\n\22 $fast_results\0A\0A    # Don't retrieve all snapshots for all datasets until an @ is specified,\0A    # or if there is only one possible matching dataset. (See #7472)\0A    set current_token (commandline --current-token)\0A    set current_dataset (string replace -rf \22([^@]+)@?.*\22 '$1' -- $current_token)\0A    set filtered_results (string match -ie -- $current_dataset $fast_results)\0A    if contains -- --force $argv ||\0A            string match -ieq @ -- $current_token ||\0A            not set -q filtered_results[2]\0A\0A        # Ignore errors because the dataset specified could be non-existent\0A        zfs list -t snapshot -o name -H -d 1 $current_dataset 2>/dev/null\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3351 = private unnamed_addr constant [24 x i8] c"functions/__fish_ps.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3352 = private unnamed_addr constant [189 x i8] c"function __fish_ps\0A    switch (command -s ps | path resolve | path basename)\0A        case busybox\0A            command ps $argv\0A        case '*'\0A            command ps axc $argv\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3353 = private unnamed_addr constant [25 x i8] c"functions/__fish_pwd.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3354 = private unnamed_addr constant [305 x i8] c"function __fish_pwd --description \22Show current path\22\0A    if status test-feature regex-easyesc\0A        string replace -r '^/cygdrive/(.)?' '\\U$1:' -- $PWD\0A    else\0A        # TODO: Remove this once regex-easyesc becomes the default\0A        string replace -r '^/cygdrive/(.)?' '\\\\\\U$1:' -- $PWD\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3355 = private unnamed_addr constant [40 x i8] c"functions/__fish_reg__complete_keys.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3356 = private unnamed_addr constant [1157 x i8] c"function __fish_reg__complete_keys\0A    set -l current_token (commandline -tc | string unescape)\0A\0A    set -l default_keys 'HKEY_CLASSES_ROOT\\tThe information about file extension associations' \\\0A        'HKEY_CURRENT_USER\\tThe information about a current user' \\\0A        'HKEY_LOCAL_MACHINE\\tThe information about a current machine' \\\0A        'HKEY_USERS\\tThe information about loaded users' \\\0A        'HKEY_CURRENT_CONFIG\\tThe information about hardware used while startup' \\\0A        HKEY_DYN_DATA\0A\0A    if string match --quiet --entire --regex '\\\\\\\\' -- \22$current_token\22\0A        set current_token (string replace --regex '\\\\\\\\[^\\\\\\\\]*$' '' -- \22$current_token\22)\0A\0A        set -l keys (WINEDEBUG=-all wine reg query \22$current_token\22 |\0A            string replace --regex '\\r' '' |\0A            string match --entire --regex '\\w')\0A\0A        test $pipestatus[1] != 0 && return\0A\0A        string join \\n -- $keys |\0A            string match --invert \22$current_token\22 |\0A            string replace --all --regex '[\\\\\\\\]+' '\\\\\\\\'\0A    else\0A        for key in $default_keys\0A            echo -e $key\0A        end\0A    end\0Aend\0A\0Acomplete -c true -a '(__fish_reg__complete_keys)'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3357 = private unnamed_addr constant [35 x i8] c"functions/__fish_seen_argument.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3358 = private unnamed_addr constant [1114 x i8] c"function __fish_seen_argument --description 'Check whether argument is used'\0A    argparse --ignore-unknown 's/short=+' 'o/old=+' 'l/long=+' 'w/windows=+' -- $argv\0A\0A    set --local tokens (commandline --current-process --tokens-expanded --cut-at-cursor)\0A    set --erase tokens[1]\0A\0A    for t in $tokens\0A        for s in $_flag_s\0A            if string match --regex --quiet -- \22^-[A-z0-9]*\22$s\22[A-z0-9]*\\$\22 $t\0A                return 0\0A            end\0A        end\0A\0A        for o in $_flag_o\0A            if string match --quiet -- \22-$o\22 $t\0A                return 0\0A            end\0A        end\0A\0A        for l in $_flag_l\0A            # Make sure to only prefix-match --foo=bar style tokens\0A            if string match --quiet -- \22--$l\22 (string replace -r -- '^(--.*?)=.*' '$1' $t)\0A                return 0\0A            end\0A        end\0A\0A        for w in $_flag_w\0A            if string match --quiet -- \22/$w\22 $t\0A                return 0\0A            end\0A        end\0A\0A        for raw_arg in $argv\0A            if string match --quiet -- $t $raw_arg\0A                return 0\0A            end\0A        end\0A    end\0A\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3359 = private unnamed_addr constant [42 x i8] c"functions/__fish_seen_subcommand_from.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3360 = private unnamed_addr constant [331 x i8] c"#\0A# Test to see if we've seen a subcommand from a list.\0A# This logic may seem backwards, but the commandline will often be much shorter\0A# than the list\0A#\0A\0Afunction __fish_seen_subcommand_from\0A    set -l regex (string escape --style=regex -- (commandline -pxc)[2..] | string join '|')\0A    string match -rq -- \22^$regex\22'$' $argv\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3361 = private unnamed_addr constant [32 x i8] c"functions/__fish_set_locale.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3362 = private unnamed_addr constant [3883 x i8] c"# Try to set the locale from the system configuration if we did not inherit any. One case where this\0A# can happen is a linux with systemd where the user logs in via getty (e.g., on the system console).\0A# See https://github.com/fish-shell/fish-shell/issues/3092. This isn't actually our job, so there's\0A# a bunch of edge-cases we are unlikely to handle properly. If we get a value for _any_ language\0A# variable, we assume we've inherited something sensible so we skip this to allow the user to set it\0A# at runtime without mucking with config files.\0A#\0A# NOTE: This breaks the expectation that an empty LANG will be the same as LANG=POSIX, but an empty\0A# LANG seems more likely to be caused by a missing or misconfigured locale configuration.\0A\0Afunction __fish_set_locale\0A    set -l LOCALE_VARS\0A    set -a LOCALE_VARS LANG LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE\0A    set -a LOCALE_VARS LC_MONETARY LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS\0A    set -a LOCALE_VARS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION\0A\0A    # We check LC_ALL to figure out if we have a locale but we don't set it later. That is because\0A    # locale.conf doesn't allow it so we should not set it.\0A    for locale_var in $LOCALE_VARS LC_ALL\0A        if set -q $locale_var\0A            return 0\0A        end\0A    end\0A\0A    # Try to extract the locale from the kernel boot commandline. The splitting here is a bit weird,\0A    # but we operate under the assumption that the locale can't include whitespace. Other whitespace\0A    # shouldn't concern us, but a quoted \22locale.LANG=SOMETHING\22 as a value to something else might.\0A    # Here the last definition of a variable takes precedence.\0A    if test -r /proc/cmdline\0A        for var in (string match -ra 'locale.[^=]+=\\S+' < /proc/cmdline)\0A            set -l kv (string replace 'locale.' '' -- $var | string split '=')\0A            # Only set locale variables, not other stuff contained in these files - this also\0A            # automatically ignores comments.\0A            if contains -- $kv[1] $LOCALE_VARS\0A                and set -q kv[2]\0A                set -gx $kv[1] (string trim -c '\\'\22' -- $kv[2])\0A            end\0A        end\0A    end\0A\0A    # Now read the config files we know are used by various OS distros.\0A    #\0A    # /etc/sysconfig/i18n is for old Red Hat derivatives (and possibly of no use anymore).\0A    #\0A    # /etc/env.d/02locale is from OpenRC.\0A    #\0A    # The rest are systemd inventions but also used elsewhere (e.g. Void Linux). systemd's\0A    # documentation is a bit unclear on this. We merge all the config files (and the commandline),\0A    # which seems to be what systemd itself does. (I.e. the value for a variable will be taken from\0A    # the highest-precedence source) We read the systemd files first since they are a newer\0A    # invention and therefore the rest are likely to be accumulated cruft.\0A    #\0A    # NOTE: Slackware puts the locale in /etc/profile.d/lang.sh, which we can't use because it's a\0A    # full POSIX-shell script.\0A    set -l user_cfg_dir (set -q XDG_CONFIG_HOME; and echo $XDG_CONFIG_HOME; or echo ~/.config)\0A    for f in $user_cfg_dir/locale.conf /etc/locale.conf /etc/env.d/02locale /etc/sysconfig/i18n /etc/default/locale\0A        if test -r $f\0A            while read -l kv\0A                set kv (string split '=' -- $kv)\0A                if contains -- $kv[1] $LOCALE_VARS\0A                    and set -q kv[2]\0A                    # Do not set already set variables again - this makes the merging happen.\0A                    if not set -q $kv[1]\0A                        set -gx $kv[1] (string trim -c '\\'\22' -- $kv[2])\0A                    end\0A                end\0A            end <$f\0A        end\0A    end\0A\0A    # If we really cannot get anything, at least set character encoding to UTF-8.\0A    for locale_var in $LOCALE_VARS LC_ALL\0A        if set -q $locale_var\0A            return 0\0A        end\0A    end\0A    set -gx LC_CTYPE en_US.UTF-8\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3363 = private unnamed_addr constant [41 x i8] c"functions/__fish_shared_key_bindings.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3364 = private unnamed_addr constant [6407 x i8] c"function __fish_shared_key_bindings -d \22Bindings shared between emacs and vi mode\22\0A    # These are some bindings that are supposed to be shared between vi mode and default mode.\0A    # They are supposed to be unrelated to text-editing (or movement).\0A    # This takes $argv so the vi-bindings can pass the mode they are valid in.\0A\0A    if contains -- -h $argv\0A        or contains -- --help $argv\0A        echo \22Sorry but this function doesn't support -h or --help\22 >&2\0A        return 1\0A    end\0A\0A    bind --preset $argv ctrl-y yank\0A    or return # protect against invalid $argv\0A    bind --preset $argv alt-y yank-pop\0A\0A    # Left/Right arrow\0A    bind --preset $argv right forward-char\0A    bind --preset $argv left backward-char\0A\0A    # Ctrl-left/right - these also work in vim.\0A    if test (__fish_uname) = Darwin\0A        bind --preset $argv ctrl-right forward-token\0A        bind --preset $argv ctrl-left backward-token\0A    else\0A        bind --preset $argv ctrl-right forward-word\0A        bind --preset $argv ctrl-left backward-word\0A    end\0A\0A    bind --preset $argv pageup beginning-of-history\0A    bind --preset $argv pagedown end-of-history\0A\0A    # Interaction with the system clipboard.\0A    bind --preset $argv ctrl-x fish_clipboard_copy\0A    bind --preset $argv ctrl-v fish_clipboard_paste\0A\0A    bind --preset $argv escape cancel\0A    bind --preset $argv ctrl-\\[ cancel\0A    bind --preset $argv tab complete\0A    bind --preset $argv ctrl-i complete\0A    bind --preset $argv ctrl-s pager-toggle-search\0A    # shift-tab does a tab complete followed by a search.\0A    bind --preset $argv shift-tab complete-and-search\0A    bind --preset $argv shift-delete history-delete or backward-delete-char\0A\0A    bind --preset $argv down down-or-search\0A    bind --preset $argv up up-or-search\0A\0A    bind --preset $argv shift-right forward-bigword\0A    bind --preset $argv shift-left backward-bigword\0A\0A    bind --preset $argv alt-b prevd-or-backward-word\0A    bind --preset $argv alt-f nextd-or-forward-word\0A\0A    set -l alt_right_aliases alt-right \\e\\[1\\;9C # iTerm2 < 3.5.12\0A    set -l alt_left_aliases alt-left \\e\\[1\\;9D # iTerm2 < 3.5.12\0A    if test (__fish_uname) = Darwin\0A        for alt_right in $alt_right_aliases\0A            bind --preset $argv $alt_right nextd-or-forward-word\0A        end\0A        for alt_left in $alt_left_aliases\0A            bind --preset $argv $alt_left prevd-or-backward-word\0A        end\0A    else\0A        for alt_right in $alt_right_aliases\0A            bind --preset $argv $alt_right nextd-or-forward-token\0A        end\0A        for alt_left in $alt_left_aliases\0A            bind --preset $argv $alt_left prevd-or-backward-token\0A        end\0A    end\0A\0A    bind --preset $argv alt-up history-token-search-backward\0A    bind --preset $argv alt-down history-token-search-forward\0A    bind --preset $argv \\e\\[1\\;9A history-token-search-backward # iTerm2 < 3.5.12\0A    bind --preset $argv \\e\\[1\\;9B history-token-search-forward # iTerm2 < 3.5.12\0A    # Bash compatibility\0A    # https://github.com/fish-shell/fish-shell/issues/89\0A    bind --preset $argv alt-. history-token-search-backward\0A\0A    bind --preset $argv alt-l __fish_list_current_token\0A    bind --preset $argv alt-o __fish_preview_current_file\0A    bind --preset $argv alt-w __fish_whatis_current_token\0A    bind --preset $argv ctrl-l scrollback-push clear-screen\0A    bind --preset $argv ctrl-c clear-commandline\0A    bind --preset $argv ctrl-u backward-kill-line\0A    bind --preset $argv ctrl-k kill-line\0A    bind --preset $argv ctrl-w backward-kill-path-component\0A    bind --preset $argv end end-of-line\0A    bind --preset $argv home beginning-of-line\0A\0A    bind --preset $argv alt-d 'if test \22$(commandline; printf .)\22 = \\n.; __fish_echo dirh; else; commandline -f kill-word; end'\0A    bind --preset $argv ctrl-d delete-or-exit\0A\0A    bind --preset $argv alt-s 'for cmd in sudo doas please; if command -q $cmd; fish_commandline_prepend $cmd; break; end; end'\0A\0A    # Allow reading manpages by pressing f1 (many GUI applications) or Alt+h (like in zsh).\0A    bind --preset $argv f1 __fish_man_page\0A    bind --preset $argv alt-h __fish_man_page\0A\0A    # This will make sure the output of the current command is paged using the default pager when\0A    # you press Meta-p.\0A    # If none is set, less will be used.\0A    bind --preset $argv alt-p __fish_paginate\0A\0A    # Make it easy to turn an unexecuted command into a comment in the shell history. Also,\0A    # remove the commenting chars so the command can be further edited then executed.\0A    bind --preset $argv alt-# __fish_toggle_comment_commandline\0A\0A    # These keystrokes invoke an external editor on the command buffer.\0A    bind --preset $argv alt-e edit_command_buffer\0A    bind --preset $argv alt-v edit_command_buffer\0A\0A    # Bindings that are shared in text-insertion modes.\0A    if not set -l index (contains --index -- -M $argv)\0A        or test $argv[(math $index + 1)] = insert\0A\0A        # This is the default binding, i.e. the one used if no other binding matches\0A        bind --preset $argv \22\22 self-insert\0A        or exit # protect against invalid $argv\0A\0A        # Space and other command terminators expands abbrs _and_ inserts itself.\0A        bind --preset $argv space self-insert expand-abbr\0A        bind --preset $argv \22;\22 self-insert expand-abbr\0A        bind --preset $argv \22|\22 self-insert expand-abbr\0A        bind --preset $argv \22&\22 self-insert expand-abbr\0A        bind --preset $argv \22>\22 self-insert expand-abbr\0A        bind --preset $argv \22<\22 self-insert expand-abbr\0A        set -l maybe_search_field '(commandline --search-field >/dev/null && echo --search-field)'\0A        bind --preset $argv shift-enter \22commandline -i \\n $maybe_search_field\22 expand-abbr\0A        bind --preset $argv alt-enter \22commandline -i \\n $maybe_search_field\22 expand-abbr\0A        bind --preset $argv \22)\22 self-insert expand-abbr # Closing a command substitution.\0A        bind --preset $argv ctrl-space 'test -n \22$(commandline)\22 && commandline -i \22 \22 '$maybe_search_field\0A        # Shift-space behaves like space because it's easy to mistype.\0A        bind --preset $argv shift-space 'commandline -i \22 \22 '$maybe_search_field expand-abbr\0A\0A        bind --preset $argv enter execute\0A        bind --preset $argv ctrl-j execute\0A        bind --preset $argv ctrl-m execute\0A        # Make Control+Return behave like Return because it's easy to mistype after accepting an autosuggestion.\0A        bind --preset $argv ctrl-enter execute\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3365 = private unnamed_addr constant [46 x i8] c"functions/__fish_should_complete_switches.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3366 = private unnamed_addr constant [408 x i8] c"# Returns whether we *should* complete a -s or --long argument.\0A# The preference is NOT to do so, i.e. prefer subcommands over switches.\0Afunction __fish_should_complete_switches\0A    for arg in (commandline -ct)[-1..1]\0A        if not string match -qr -- \22^-\\S*\\$\22 \22$arg\22\0A            return 1\0A        end\0A    end\0A    if string match -qr -- \22^-\22 (commandline -ct)[-1]\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A", align 1
