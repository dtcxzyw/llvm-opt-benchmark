@anon.1d0b41a8d45d477c3029ec78f9b8b434.2080 = private unnamed_addr constant [1108 x i8] c"# completion for mdutil (macOS)\0A\0Afunction __fish_mdutil_volumes\0A    command mdutil -a -s | while read -l line\0A        if string match -q \\t\22*\22 -- $line\0A            printf \22%s\\n\22 $line\0A        else\0A            # Use printf to not output a newline so indented lines are joined\0A            # to non-indented ones\0A            printf \22%s\22 (string replace -r ':$' '' -- $line)\0A        end\0A    end\0Aend\0A\0Acomplete -c mdutil -s p -f -d 'Publish metadata'\0Acomplete -c mdutil -s i -f -a 'on off' -d 'Turn indexing on or off'\0Acomplete -c mdutil -s d -f -d 'Disable Spotlight activity for volume'\0Acomplete -c mdutil -s E -f -d 'Erase and rebuild index'\0Acomplete -c mdutil -s s -f -d 'Print indexing status'\0Acomplete -c mdutil -s t -x -a '(__fish_mdutil_volumes)' -d 'Resolve files from file id with an optional volume path or device id'\0Acomplete -c mdutil -s a -f -d 'Apply command to all volumes'\0Acomplete -c mdutil -s V -x -a '(__fish_mdutil_volumes)' -d 'Apply command to all stores on the specified volume'\0Acomplete -c mdutil -s v -f -d 'Display verbose information'\0Acomplete -c mdutil -x -a '(__fish_mdutil_volumes)'\0A", align 1
