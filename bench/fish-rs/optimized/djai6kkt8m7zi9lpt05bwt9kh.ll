@anon.1d0b41a8d45d477c3029ec78f9b8b434.2472 = private unnamed_addr constant [7403 x i8] c"# Completions for the 'readelf' command\0A\0A# common section names and what they contain\0Aset -l sections '\0A\09.bss\\t\22Uninitialized read-write data\22\0A\09.data\\t\22Comment section\22\0A\09.debug\\t\22Debugging information\22\0A\09.fini\\t\22Runtime finalization instructions\22\0A\09.init\\t\22Runtime initialization instructions\22\0A\09.rodata\\t\22Read-only data\22\0A\09.text\\t\22Executable text\22\0A\09.line\\t\22Line info for symbolic debugging\22\0A\09.note\\t\22Note information\22\0A\09.dynamic\\t\22Dynamic linking information\22\0A\09.dynstr\\t\22Strings needed for dynamic linking\22\0A\09.dynsym\\t\22Dynamic linking symbol table\22\0A\09.got\\t\22Global offset table\22\0A\09.hash\\t\22Symbol hash table\22\0A\09.interp\\t\22Path name of a program interpreter\22\0A\09.plt\\t\22Procedure linking table\22\0A\09.shstrtab\\t\22String table for the section header table names\22\0A\09.strtab\\t\22String table\22\0A\09.symtab\\t\22Symbol table\22\0A'\0A\0Acomplete -c readelf -s a -l all -d \22Equivalent to -h -l -S -s -r -d -V -A -I\22\0Acomplete -c readelf -s h -l file-header -d \22Display the ELF file header\22\0Acomplete -c readelf -s l -l program-headers -l segments -d \22Display the program headers\22\0Acomplete -c readelf -s S -l section-headers -l sections -d \22Display the sections' header\22\0Acomplete -c readelf -s g -l section-groups -d \22Display the section groups\22\0Acomplete -c readelf -s t -l section-details -d \22Display the section details\22\0Acomplete -c readelf -s e -l headers -d \22Equivalent to -h -l -S\22\0Acomplete -c readelf -s s -l syms -l symbols -d \22Display the symbol table\22\0Acomplete -c readelf -l dyn-syms -d \22Display the dynamic symbol table\22\0Acomplete -c readelf -l lto-syms -d \22Display LTO symbol tables\22\0Acomplete -c readelf -l sym-base -d \22Force base for symbol sizes\22 -a '0\\t\22Mixed\22 8\\t\22Octal\22 10\\t\22Decimal\22 16\\t\22Hexadecimal\22' -x\0Acomplete -c readelf -s C -l demangle -d \22Decode mangled/processed symbol names\22 -a 'none auto gnu-v3 java gnat dlang rust' -x\0Acomplete -c readelf -l no-demangle -d \22Don't demangle low-level symbol names\22\0Acomplete -c readelf -l recurse-limit -d \22Enable a demangling recursion limit\22\0Acomplete -c readelf -l no-recurse-limit -d \22Disable a demangling recursion limit\22\0Acomplete -c readelf -s U -l unicode -d \22Controls the display of non-ASCII characters in identifier names\22 -a 'd\\t\22default\22 l\\t\22locale\22 e\\t\22escape\22 x\\t\22hex\22 h\\t\22highlight\22 i\\t\22invalid\22' -x\0Acomplete -c readelf -s n -l notes -d \22Display the core notes\22\0Acomplete -c readelf -s r -l relocs -d \22Display the relocations\22\0Acomplete -c readelf -s u -l unwind -d \22Display the unwind info\22\0Acomplete -c readelf -s d -l dynamic -d \22Display the dynamic section\22\0Acomplete -c readelf -s V -l version-info -d \22Display the version sections\22\0Acomplete -c readelf -s A -l arch-specific -d \22Display architecture specific information\22\0Acomplete -c readelf -s c -l archive-index -d \22Display the symbol/file index in an archive\22\0Acomplete -c readelf -s D -l use-dynamic -d \22Use the dynamic section info when displaying symbols\22\0Acomplete -c readelf -s L -l lint -l enable-checks -d \22Display warning messages for possible problems\22\0Acomplete -c readelf -s x -l hex-dump -d \22Dump the contents of specified section as bytes\22 -a $sections -x\0Acomplete -c readelf -s p -l string-dump -d \22Dump the contents of specified section as strings\22 -a $sections -x\0Acomplete -c readelf -s R -l relocated-dump -d \22Dump the relocated contents of of specified section\22 -a $sections -x\0Acomplete -c readelf -s z -l decompress -d \22Decompress section before dumping it\22\0Acomplete -c readelf -l debug-dump -d \22Display the contents of DWARF debug sections\22\0Acomplete -c readelf -o wa -l debug-dump=abbrev -d \22Displays the contents of the .debug_abbrev section\22\0Acomplete -c readelf -o wA -l debug-dump=addr -d \22Displays the contents of the .debug_addr section\22\0Acomplete -c readelf -o wc -l debug-dump=cu_index -d \22Displays the contents of the .debug_cu_index and/or .debug_tu_index sections\22\0Acomplete -c readelf -o wf -l debug-dump=frames -d \22Display the raw contents of a .debug_frame section\22\0Acomplete -c readelf -o wF -l debug-dump=frames-interp -d \22Display the interpreted contents of a .debug_frame section\22\0Acomplete -c readelf -o wg -l debug-dump=gdb_index -d \22 Displays the contents of the .gdb_index and/or .debug_names sections\22\0Acomplete -c readelf -o wi -l debug-dump=info -d \22Displays the contents of the .debug_info section\22\0Acomplete -c readelf -o wk -l debug-dump=links -d \22Display the contents of sections that link to separate debuginfo files\22\0Acomplete -c readelf -o wK -l debug-dump=follow-links -d \22Follow links to separate debug info files\22\0Acomplete -c readelf -o wN -l debug-dump=no-follow-links -d \22Don't follow links to separate debug info files\22\0Acomplete -c readelf -o wD -l debug-dump=use-debuginfod -d \22When following links, also query debuginfod servers\22\0Acomplete -c readelf -o wE -l debug-dump=do-not-use-debuginfod -d \22When following links, don't query debuginfod servers\22\0Acomplete -c readelf -o wl -l debug-dump=rawline -d \22Displays the contents of the .debug_line section in a raw format\22\0Acomplete -c readelf -o wL -l debug-dump=decodedline -d \22Displays the interpreted contents of the .debug_line section\22\0Acomplete -c readelf -o wm -l debug-dump=macro -d \22Displays the contents of the .debug_macro and/or .debug_macinfo sections\22\0Acomplete -c readelf -o wo -l debug-dump=loc -d \22Displays the contents of the .debug_loc and/or .debug_loclists sections\22\0Acomplete -c readelf -o wO -l debug-dump=str-offsets -d \22Displays the contents of the .debug_str_offsets section\22\0Acomplete -c readelf 