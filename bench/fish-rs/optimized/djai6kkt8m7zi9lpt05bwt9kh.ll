@anon.1d0b41a8d45d477c3029ec78f9b8b434.2922 = private unnamed_addr constant [2565 x i8] c"# Completions for xbps-create\0A# Author: Allen Sobot <chilledfrogs@disroot.org>\0A\0Aset -l progname xbps-create\0Aset -l modes none gzip bzip2 xz lz4 zstd\0A\0Acomplete -c $progname -f -a \22(__fish_complete_directories)\22\0A\0Acomplete -c $progname -s A -d 'The target architecture for this package (required)' -x\0Acomplete -c $progname -s B -d 'The package builder string, free form' -x\0Acomplete -c $progname -s C -d 'Package patterns this package conflicts with, separated by whitespaces' -x\0Acomplete -c $progname -s D -d 'Package patterns this package depends on, separated by whitespaces' -x\0Acomplete -c $progname -s F -d 'Configuration files this package provides, separated by whitespace' -x\0Acomplete -c $progname -s G -d 'Set git revisions of the sourcepkg used to build binary package' -x\0Acomplete -c $progname -s H -d 'The package homepage string' -x\0Acomplete -c $progname -s h -d 'Show the help message'\0Acomplete -c $progname -s l -d 'The package license' -x\0Acomplete -c $progname -s M -d 'A list of mutable files this package provides, separated by whitespaces' -x\0Acomplete -c $progname -s m -d 'The package maintainer name and/or email contact' -x\0Acomplete -c $progname -s n -d 'The package name/version tuple, e. g: \\'foo-1. 0_1\\'' -x\0Acomplete -c $progname -s P -d 'Virtual packages this package provides, separated by whitespace' -x\0Acomplete -c $progname -s p -d 'Preserve package files after being updated'\0Acomplete -c $progname -s q -d 'Enable quiet operation'\0Acomplete -c $progname -s R -d 'Package patterns this package replaces, separated by whitespaces' -x\0Acomplete -c $progname -s r -d 'Versions this package reverts, separated by whitespaces' -x\0Acomplete -c $progname -s S -d 'A long description for this package' -x\0Acomplete -c $progname -s s -d 'A short description for this package, one line under 80 characters' -x\0Acomplete -c $progname -s t