@anon.1d0b41a8d45d477c3029ec78f9b8b434.3506 = private unnamed_addr constant [875 x i8] c"#\0A# This allows us to use 'open FILENAME' to open a given file in the default\0A# application for the file.\0A#\0Aif not command -sq open\0A    function open --description \22Open file in default application\22\0A        set -l options h/help\0A        argparse -n open $options -- $argv\0A        or return\0A\0A        if set -q _flag_help\0A            __fish_print_help open\0A            return 0\0A        end\0A\0A        if not set -q argv[1]\0A            printf (_ \22%ls: Expected at least %d args, got only %d\\n\22) open 1 0 >&2\0A            return 1\0A        end\0A\0A        if type -q -f cygstart\0A            for i in $argv\0A                cygstart $i\0A            end\0A        else if type -q -f xdg-open\0A            for i in $argv\0A                xdg-open $i\0A            end\0A        else\0A            echo (_ 'No open utility found. Try installing \22xdg-open\22 or \22xdg-utils\22.') >&2\0A        end\0A    end\0Aend\0A", align 1
