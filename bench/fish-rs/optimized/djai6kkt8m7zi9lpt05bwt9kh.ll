@anon.1d0b41a8d45d477c3029ec78f9b8b434.3252 = private unnamed_addr constant [182 x i8] c"function __fish_paginate -d \22Paginate the current command using the users default pager\22\0A    set -l cmd (__fish_anypager)\0A    or return 1\0A\0A    fish_commandline_append \22 &| $cmd\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3253 = private unnamed_addr constant [40 x i8] c"functions/__fish_parent_directories.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3254 = private unnamed_addr constant [568 x i8] c"# Generates a list of parent directories for a given path\0A# i.e. /a/b/c/d -> [/a/b/c/, /a/b/, /a/, and /a]\0Afunction __fish_parent_directories\0A    if test (count $argv) -ne 1\0A        # for use in completions, so don't spew error messages\0A        return 1\0A    end\0A\0A    set -l splits (string split '/' $argv[1])\0A    set -l parents\0A\0A    for split in $splits\0A        if test (string length \22$split\22) -eq 0\0A            continue\0A        end\0A\0A        set parents \22$parents[1]/$split\22 $parents\0A    end\0A\0A    for parent in $parents\0A        echo $parent\0A    end\0A\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3255 = private unnamed_addr constant [27 x i8] c"functions/__fish_paste.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3256 = private unnamed_addr constant [1889 x i8] c"function __fish_paste\0A    # Also split on \\r, otherwise it looks confusing\0A    set -l data (string split \\r -- $argv[1] | string split \\n)\0A    set data (string replace -ra [[:cntrl:]] '' -- $data)\0A\0A    if commandline --search-field >/dev/null\0A        commandline --search-field -i -- $data\0A        return\0A    end\0A\0A    # If the current token has an unmatched single-quote,\0A    # escape all single-quotes (and backslashes) in the paste,\0A    # in order to turn it into a single literal token.\0A    #\0A    # This eases pasting non-code (e.g. markdown or git commitishes).\0A    set -l quote_state (__fish_tokenizer_state -- (commandline -ct | string collect))\0A    if contains -- $quote_state single single-escaped\0A        if status test-feature regex-easyesc\0A            set data (string replace -ra \22(['\\\\\\])\22 '\\\\\\\\$1' -- $data)\0A        else\0A            set data (string replace -ra \22(['\\\\\\])\22 '\\\\\\\\\\\\\\$1' -- $data)\0A        end\0A    else if not contains -- $quote_state double double-escaped\0A        and set -q data[2]\0A        # Leading whitespace in subsequent lines is unneded, since fish\0A        # already indents. Also gets rid of tabs (issue #5274).\0A        set -l tmp\0A        for line in $data\0A            switch $quote_state\0A                case normal\0A                    set -a tmp (string trim -l -- $line)\0A                case single single-escaped double double-escaped escaped\0A                    set -a tmp $line\0A            end\0A            set quote_state (__fish_tokenizer_state -i $quote_state -- $line)\0A        end\0A        set data $data[1] $tmp[2..]\0A    end\0A    if not string length -q -- (commandline -c)\0A        # If we're at the beginning of the first line, trim whitespace from the start,\0A        # so we don't trigger ignoring history.\0A        set data[1] (string trim -l -- $data[1])\0A    end\0A\0A    if test -n \22$data\22\0A        commandline --insert-smart -- $data\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3257 = private unnamed_addr constant [34 x i8] c"functions/__fish_prepend_sudo.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3258 = private unnamed_addr constant [183 x i8] c"function __fish_prepend_sudo -d \22 DEPRECATED: use fish_commandline_prepend instead. Prepend 'sudo ' to the beginning of the current commandline\22\0A    fish_commandline_prepend sudo\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3259 = private unnamed_addr constant [33 x i8] c"functions/__fish_prev_arg_in.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3260 = private unnamed_addr constant [401 x i8] c"# returns 0 only if previous argument is one of the supplied arguments\0Afunction __fish_prev_arg_in\0A    set -l tokens (commandline -cx)\0A    set -l tokenCount (count $tokens)\0A    if test $tokenCount -lt 2\0A        # need at least cmd and prev argument\0A        return 1\0A    end\0A    for arg in $argv\0A        if string match -q -- $tokens[-1] $arg\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3261 = private unnamed_addr constant [42 x i8] c"functions/__fish_preview_current_file.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3262 = private unnamed_addr constant [1115 x i8] c"function __fish_preview_current_file --description \22Open the file at the cursor in a pager\22\0A    if __fish_edit_command_if_at_cursor\0A        return 0\0A    end\0A\0A    set -l pager (__fish_anypager)\0A    or set pager cat\0A\0A    # commandline -t will never return an empty list. However, the token\0A    # could comprise multiple lines, so join them into a single string.\0A    set -l file (commandline -t | string collect)\0A    set -l prefix eval set\0A\0A    if test -z $file\0A        # $backslash will parsed as regex which may need additional escaping.\0A        set -l backslash '\\\\\\\\'\0A        not status test-feature regex-easyesc && set backslash $backslash$backslash\0A        set file (string replace -ra -- '([ ;#^<>&|()\22\\'])' \22$backslash\\$1\22 (commandline -xc)[-1])\0A        set prefix set\0A    end\0A\0A    set -q file[1] || return\0A\0A    # strip -option= from token if present\0A    set file (string replace -r -- '^-[^\\s=]*=' '' $file | string collect)\0A\0A    $prefix -l files $file || return # Bail if $file does not tokenize.\0A\0A    if set -q files[1] && test -f $files[1]\0A        $pager $files\0A        commandline -f repaint\0A    end\0Aend\0A", align 1
