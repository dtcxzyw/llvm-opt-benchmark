@anon.1d0b41a8d45d477c3029ec78f9b8b434.1782 = private unnamed_addr constant [2034 x i8] c"function __fish_guild__complete_warnings\0A    guild compile -Whelp |\0A        string replace --filter --regex '^\\s+`([a-z\\-]+)\\'\\s+(.+)' '$1\\t$2'\0A\0A    printf '%s\\n' 0 2 3\0A    echo 1\\tdefault\0Aend\0A\0Afunction __fish_guild__complete_optimizations\0A    guild compile -Ohelp |\0A        string replace --filter --regex '^\\s+-O(.+)' '$1\\nno-$1'\0A\0A    printf '%s\\n' 0 1 3\0A    echo 2\\tdefault\0Aend\0A\0Aset -l command guild\0Acomplete -c $command -f\0A\0Aset -l compile_condition '__fish_seen_subcommand_from compile'\0Acomplete -c $command -a 'compile\\tCompile scripts' -n \22not $compile_condition\22\0A\0Acomplete -c $command -s h -l help -d 'Show help' -n $compile_condition\0Acomplete -c $command -l version -d 'Show version' -n $compile_condition\0A\0Acomplete -c $command -s L -l load-path -F \\\0A    -d 'Specify the directory to prepend to module load path' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s o -l output -F \\\0A    -d 'Specify the output file to put bytecode in' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s x -x \\\0A    -d 'Specify the extension to prepend to extension list' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s W -l warning \\\0A    -a '(__fish_complete_list , __fish_guild__complete_warnings)' \\\0A    -d 'Specify the warning level for a compilation' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s O -l optimize \\\0A    -a '(__fish_guild__complete_optimizations)' \\\0A    -d 'Specify the optimization level for a compilation' \\\0A    -n $compile_condition\0A\0Afor standard in 6 7\0A    set -l option r$standard\22rc\22\0A\0A    complete -c $command -l $option \\\0A        -d \22Use $(string upper -- $option) compatible mode\22 \\\0A        -n $compile_condition\0Aend\0A\0Acomplete -c $command -s f -l from \\\0A    -a 'scheme\\tdefault elisp ecmascript' \\\0A    -d 'Specify the language for sources' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s t -l to \\\0A    -a 'rtl\\tdefault' \\\0A    -d 'Specify the language for an output' \\\0A    -n $compile_condition\0A\0Acomplete -c $command -s T -l target \\\0A    -d 'Specify the target for a code' \\\0A    -n $compile_condition\0A", align 1
