@anon.1d0b41a8d45d477c3029ec78f9b8b434.1080 = private unnamed_addr constant [2696 x i8] c"function __fish_ansible_vault_no_subcommand -d 'Test if ansible-vault has yet to be given the subcommand'\0A    commandline -pc | not string match --regex '[^-]\\b(?:create|decrypt|edit|encrypt|encrypt_string|rekey|view)\\b'\0Aend\0A\0Afunction __fish_ansible_vault_using_command\0A    set -l cmd (string trim (__fish_ansible_vault_no_subcommand))\0A    test -z \22$cmd\22\0A    and return 1\0A    contains -- \22$cmd\22 $argv\0Aend\0A\0A# generic options\0Acomplete -c ansible-vault -l version -d \22Display version and exit\22\0Acomplete -c ansible-vault -s h -l help -f -d \22Show help message and exit\22\0Acomplete -c ansible-vault -s v -l verbose -d \22Verbose mode (-vvv for more, -vvvv to enable connection debugging)\22\0Acomplete -c ansible-vault -l ask-vault-pass -f -d \22Ask for vault password\22\0Acomplete -c ansible-vault -l new-vault-id -r -d \22the new vault identity to use for rekey\22\0Acomplete -c ansible-vault -l new-vault-password-file -r -d \22New vault password file for rekey\22\0Acomplete -c ansible-vault -l vault-id -r -d \22the vault identity to use\22\0Acomplete -c ansible-vault -l vault-password-file -r -d \22Vault password file\22\0A\0A# subcommands\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -a decrypt -d 'Decrypt encrypted file or stdin'\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -a encrypt -d 'Encrypt a file or stdin'\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -ra create -d 'Create encrypted file'\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -ra edit -d 'Edit encrypted file'\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -ra rekey -d 'Rekey encrypted file'\0Acomplete -c ansible-vault -n __fish_ansible_vault_no_subcommand -ra view -d 'View contents of something encrypted'\0Acomplete -f -c ansible-vault -n __fish_ansible_vault_no_subcommand -a encrypt_string -d 'Encrypt string'\0A\0A# encrypt_string options\0Acomplete -c ansible-vault -n '__fish_ansible_vault_using_command encrypt encrypt_string' -r -l stdin-name -f -d 'Specify the variable name for stdin'\0Acomplete -c ansible-vault -n '__fish_ansible_vault_using_command encrypt encrypt_string' -r -s n -l name -f -d 'Specify the variable name'\0Acomplete -c ansible-vault -n '__fish_ansible_vault_using_command encrypt encrypt_string' -s p -l prompt -d 'Prompt for the string to encrypt'\0A\0A# shared options\0Acomplete -c ansible-vault -n '__fish_ansible_vault_using_command encrypt encrypt_string rekey edit create' -l encrypt-vault-id -r -d \22the vault id used to encrypt (required if more than vault-id is provided)\22\0Acomplete -c ansible-vault -n '__fish_ansible_vault_using_command encrypt encrypt_string decrypt' -l output -r -d \22Output file name for encrypt or decrypt; use - for stdout\22\0A", align 1
