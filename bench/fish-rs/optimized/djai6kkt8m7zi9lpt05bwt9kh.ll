@anon.1d0b41a8d45d477c3029ec78f9b8b434.3394 = private unnamed_addr constant [1820 x i8] c"function __terlar_git_prompt --description 'Write out the git prompt'\0A    set -q __fish_git_prompt_showdirtystate\0A    or set -g __fish_git_prompt_showdirtystate 1\0A    set -q __fish_git_prompt_showuntrackedfiles\0A    or set -g __fish_git_prompt_showuntrackedfiles 1\0A    set -q __fish_git_prompt_showcolorhints\0A    or set -g __fish_git_prompt_showcolorhints 1\0A    set -q __fish_git_prompt_color_untrackedfiles\0A    or set -g __fish_git_prompt_color_untrackedfiles yellow\0A    set -q __fish_git_prompt_char_untrackedfiles\0A    or set -g __fish_git_prompt_char_untrackedfiles '?'\0A    set -q __fish_git_prompt_color_invalidstate\0A    or set -g __fish_git_prompt_color_invalidstate red\0A    set -q __fish_git_prompt_char_invalidstate\0A    or set -g __fish_git_prompt_char_invalidstate '!'\0A    set -q __fish_git_prompt_color_dirtystate\0A    or set -g __fish_git_prompt_color_dirtystate blue\0A    set -q __fish_git_prompt_char_dirtystate\0A    or set -g __fish_git_prompt_char_dirtystate '*'\0A    set -q __fish_git_prompt_char_stagedstate\0A    or set -g __fish_git_prompt_char_stagedstate '\E2\9C\9A'\0A    set -q __fish_git_prompt_color_cleanstate\0A    or set -g __fish_git_prompt_color_cleanstate green\0A    set -q __fish_git_prompt_char_cleanstate\0A    or set -g __fish_git_prompt_char_cleanstate '\E2\9C\93'\0A    set -q __fish_git_prompt_color_stagedstate\0A    or set -g __fish_git_prompt_color_stagedstate yellow\0A    set -q __fish_git_prompt_color_branch_dirty\0A    or set -g __fish_git_prompt_color_branch_dirty red\0A    set -q __fish_git_prompt_color_branch_staged\0A    or set -g __fish_git_prompt_color_branch_staged yellow\0A    set -q __fish_git_prompt_color_branch\0A    or set -g __fish_git_prompt_color_branch green\0A    set -q __fish_git_prompt_char_stateseparator\0A    or set -g __fish_git_prompt_char_stateseparator '\E2\9A\A1'\0A\0A    fish_git_prompt '|%s'\0Aend\0A", align 1
