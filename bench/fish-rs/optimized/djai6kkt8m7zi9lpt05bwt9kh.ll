@anon.1d0b41a8d45d477c3029ec78f9b8b434.3450 = private unnamed_addr constant [692 x i8] c"function fish_hybrid_key_bindings --description \22Vi-style bindings that inherit emacs-style bindings in all modes\22\0A    bind --erase --all --preset # clear earlier bindings, if any\0A\0A    if test \22$fish_key_bindings\22 != fish_hybrid_key_bindings\0A        # Allow the user to set the variable universally\0A        set -q fish_key_bindings\0A        or set -g fish_key_bindings\0A        # This triggers the handler, which calls us again and ensures the user_key_bindings\0A        # are executed.\0A        set fish_key_bindings fish_hybrid_key_bindings\0A        return\0A    end\0A\0A    for mode in default insert visual\0A        fish_default_key_bindings -M $mode\0A    end\0A    fish_vi_key_bindings --no-erase\0Aend\0A", align 1
