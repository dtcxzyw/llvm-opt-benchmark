cs -l insert -d \22insert contents of FILE into current buffer\22\0Acomplete -c emacs -l kill -d \22exit without asking for confirmation\22\0Acomplete -c emacs -l load -s l -d \22load Emacs Lisp FILE using the load function\22\0Acomplete -c emacs -l visit -d \22visit FILE using find-file\22\0A\0A# Display options:\0Acomplete -c emacs -l color -xa \22auto never always ansi8\22 -d \22override color mode for character terminals\22\0Acomplete -c emacs -l background-color -o bg -d \22window background color\22\0Acomplete -c emacs -l basic-display -s D -d \22disable many display features; used for debugging Emacs\22\0Acomplete -c emacs -l border-color -o bd -d \22main border color\22\0Acomplete -c emacs -l border-width -o bw -d \22width of main border\22\0Acomplete -c emacs -l cursor-color -o -cr -d \22color of the Emacs cursor indicating point\22\0Acomplete -c emacs -l font -o fn -d \22default font; must be fixed-width\22\0Acomplete -c emacs -l foreground-color -o fg -d \22window foreground color\22\0Acomplete -c emacs -l fullheight -o fh -d \22make the first frame high as the screen\22\0Acomplete -c emacs -l fullscreen -o fs -d \22make the first frame fullscreen\22\0Acomplete -c emacs -l fullwidth -o fw -d \22make the first frame wide as the screen\22\0Acomplete -c emacs -l maximized -o mm -d \22make the first frame maximized\22\0Acomplete -c emacs -l geometry -s g -d \22window geometry\22\0Acomplete -c emacs -l no-bitmap-icon -o nbi -d \22do not use picture of gnu for Emacs icon\22\0Acomplete -c emacs -l iconic -d \22start Emacs in iconified state\22\0Acomplete -c emacs -l internal-border -o ib -d \22width between text and main border\22\0Acomplete -c emacs -l line-spacing -o lsp -d \22additional space to put between lines\22\0Acomplete -c emacs -l mouse-color -o ms -d \22mouse cursor color in Emacs window\22\0Acomplete -c emacs -l name -d \22title for initial Emacs frame\22\0Acomplete -c emacs -l no-blinking-cursor -o nbc -d \22disable blinking cursor\22\0Acomplete -c