@anon.1d0b41a8d45d477c3029ec78f9b8b434.1378 = private unnamed_addr constant [14005 x i8] c"# Fish shell completions for conda, the package management system\0A# https://conda.io/docs\0A# Based on `conda help` as per version 4.4.11\0A# Advanced completions:\0A# - completion of already defined keys for `conda config`\0A# - completion of already created environment where possible\0A#\0A# Note: conda ships with a completion for fish, automatically generated\0A# from `conda -h` but it is far cruder than the completions in this file,\0A# and it is by nature far too tricky to tweak to get the desired richness.\0A# Hence this effort.\0A\0A# First, as part of conda's configuration, some complete would have been defined\0A# Let's erase them, so that we start from a blank state\0Acomplete -c conda -e\0A\0Afunction __fish_conda_subcommand\0A    # This function does triple-duty:\0A    # If called without arguments, it will print the first subcommand.\0A    # If one exists, it returns false.\0A    # If it doesn't, it returns true.\0A    #\0A    # If called with arguments, it will check that those match the given subcommands,\0A    # and that there are no additional subcommands.\0A    set -l subcmds $argv\0A    set -q subcmds[1]\0A    set -l have_sub $status\0A\0A    # get the commandline args without the \22conda\22\0A    set -l toks (commandline -xpc)[2..-1]\0A\0A    # Remove any important options - if we had options with arguments,\0A    # they'd need to be listed here to be removed.\0A    argparse -i h/help v/version -- $toks 2>/dev/null\0A    # Return false if it fails - this shouldn't really happen,\0A    # so all bets are off\0A    or return 2\0A\0A    # Remove all matching subcommands\0A    while set -q subcmds[1]\0A        # If the subcommand matches, or we have an option, go on.\0A        # (if the option took an argument we wouldn't know,\0A        #  so it needs to be argparse'd out above!)\0A        if test \22$subcmds[1]\22 = \22$argv[1]\22\0A            set -e argv[1]\0A            set -e subcmds[1]\0A        else if string match -q -- '-*' $argv[1]\0A            set -e argv[1]\0A        else\0A            return 1\0A        end\0A    end\0A\0A    # Skip any remaining options.\0A    while string match -q -- '-*' $argv[1]\0A        set -e argv[1]\0A    end\0A\0A    # If we have no subcommand left,\0A    # we either matched all given subcommands or we need one.\0A    if not set -q argv[1]\0A        return $have_sub\0A    end\0A\0A    echo -- $argv[1]\0A\0A    # If we didn't have subcommands to check, return true\0A    # If we did, this is an additional command and so we return false.\0A    not test $have_sub -eq 0\0Aend\0A\0Afunction __fish_conda -a cmd\0A    complete -c conda -n \22contains -- (__fish_conda_subcommand) $cmd\22 $argv[2..-1]\0Aend\0A\0A# Complete for the first argument only\0Afunction __fish_conda_top\0A    complete -c conda -n 'not __fish_conda_subcommand' $argv\0Aend\0A\0Afunction __fish_conda_config_keys\0A    conda config --show | string match -r '^\\w+(?=:)'\0Aend\0A\0Afunction __fish_conda_environments\0A    conda env list | string match -rv '^#' | string match -r '^\\S+'\0Aend\0A\0A# common options\0Acomplete -c conda -f\0Acomplete -c conda -s h -l help -d \22Show help and exit\22\0A\0A# top-level options\0A__fish_conda_top -s V -l version -d \22Show the conda version number and exit\22\0A\0A# top-level commands\0A__fish_conda_top -a clean -d \22Remove unused packages and caches\22\0A__fish_conda_top -a config -d \22Modify configuration values in .condarc\22\0A__fish_conda_top -a create -d \22Create a new conda environment from a list of specified packages\22\0A__fish_conda_top -a help -d \22Displays a list of available conda commands and their help strings\22\0A__fish_conda_top -a info -d \22Display information about current conda install\22\0A__fish_conda_top -a install -d \22Installs a list of packages into a specified conda environment\22\0A__fish_conda_top -a list -d \22List linked packages in a conda environment\22\0A__fish_conda_top -a package -d \22Low-level conda package utility (EXPERIMENTAL)\22\0A__fish_conda_top -a remove -d \22Remove a list of packages from a specified conda environment\22\0A__fish_conda_top -a uninstall -d \22Alias for conda remove\22\0A__fish_conda_top -a search -d \22Search for packages and display associated information\22\0A__fish_conda_top -a update -d \22Updates conda packages to the latest compatible version\22\0A__fish_conda_top -a upgrade -d \22Alias for conda update\22\0A\0A# command added by sourcing ~/miniconda3/etc/fish/conf.d/conda.fish,\0A# which is the recommended way to use conda with fish\0A__fish_conda_top -a activate -d \22Activate the given environment\22\0A__fish_conda activate -x -a \22(__fish_conda_environments)\22\0A__fish_conda_top -a deactivate -d \22Deactivate current environment, reactivating the previous one\22\0A\0A# common to all top-level commands\0A\0Aset -l __fish_conda_commands clean config create help info install list package remove uninstall search update upgrade\0Afor cmd in $__fish_conda_commands\0A    __fish_conda $cmd -l json -d \22Report all output as json\22\0A    __fish_conda $cmd -l debug -d \22Show debug output\22\0A    __fish_conda $cmd -l verbose -s v -d \22Use once for info, twice for debug, three times for trace\22\0Aend\0A\0A# 'clean' command\0A__fish_conda clean -s y -l yes -d \22Do not ask for confirmation\22\0A__fish_conda clean -l dry-run -d \22Only display what would have been done\22\0A__fish_conda clean -s q -l quiet -d \22Do not display progress bar\22\0A__fish_conda clean -s a -l all -d \22Remove all: same as -iltps\22\0A__fish_conda clean -s i -l index-cache -d \22Remove index cache\22\0A__fish_conda clean -s l -l lock -d \22Remove all conda lock files\22\0A__fish_conda clean -s t -l tarballs -d \22Remove cached package tarballs\22\0A__fish_conda clean -s p -l packages -d \22Remove unused cached packages (no check for symlinks)\22\0A__fish_conda clean -s s -l source-cache -d \22Remove files from the source cache of conda build\22\0A\0A# 'config' command\0A\0A__fish_conda config -l system -d \22Write to the system .condarc file\22\0A__fish_conda config -l env -d \22Write to the active conda environment .condarc file\22\0A__fish_conda config -l file -d \22Write to the given file\22 -F\0A__fish_conda config -l show -x -a \22(__fish_conda_config_keys)\22 -d \22Display configuration values\22\0A__fish_conda config -l show-sources -d \22Display all identified configuration sources\22\0A__fish_conda config -l validate -d \22Validate all configuration sources\22\0A__fish_conda config -l describe -x -a \22(__fish_conda_config_keys)\22 -d \22Describe configuration parameters\22\0A__fish_conda config -l write-default -d \22Write the default configuration to a file\22\0A__fish_conda config -l get -x -a \22(__fish_conda_config_keys)\22 -d \22Get a configuration value\22\0A__fish_conda config -l append -d \22Add one configuration value to the end of a list key\22\0A__fish_conda config -l prepend -d \22Add one configuration value to the beginning of a list key\22\0A__fish_conda config -l add -d \22Alias for --prepend\22\0A__fish_conda config -l set -x -a \22(__fish_conda_config_keys)\22 -d \22Set a boolean or string key\22\0A__fish_conda config -l remove -x -a \22(__fish_conda_config_keys)\22 -d \22Remove a configuration value from a list key\22\0A__fish_conda config -l remove-key -x -a \22(__fish_conda_config_keys)\22 -d \22Remove a configuration key (and all its values)\22\0A__fish_conda config -l stdin -d \22Apply configuration given in yaml format from stdin\22\0A\0A# 'help' command\0A__fish_conda help -d \22Displays a list of available conda commands and their help strings\22\0A__fish_conda help -x -a \22$__fish_conda_commands\22\0A\0A# 'info' command\0A__fish_conda info -l offline -d \22Offline mode, don't connect to the Internet.\22\0A__fish_conda info -s a -l all -d \22Show all information, (environments, license, and system information)\22\0A__fish_conda info -s e -l envs -d \22List all known conda environments\22\0A__fish_conda info -s l -l license -d \22Display information about the local conda licenses list\22\0A__fish_conda info -s s -l system -d \22List environment variables\22\0A__fish_conda info -l base -d \22Display base environment path\22\0A__fish_conda info -l unsafe-channels -d \22Display list of channels with tokens exposed\22\0A\0A# The remaining commands share many options, so the definitions are written the other way around:\0A# the outer loop is on the options\0A\0A# Option channel\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -s c -l channel -d 'Additional channel to search for packages'\0Aend\0A\0A# Option channel-priority\0Afor cmd in create install update\0A    __fish_conda $cmd -l channel-priority -d 'Channel priority takes precedence over package version'\0Aend\0A\0A# Option clobber\0Afor cmd in create install update\0A    __fish_conda $cmd -l clobber -d 'Allow clobbering of overlapping file paths (no warnings)'\0Aend\0A\0A# Option clone\0A__fish_conda create -l clone -x -a \22(__fish_conda_environments)\22 -d \22Path to (or name of) existing local environment\22\0A\0A# Option copy\0Afor cmd in create install update\0A    __fish_conda $cmd -l copy -d 'Install all packages using copies instead of hard- or soft-linking'\0Aend\0A\0A# Option download-only\0Afor cmd in create install update\0A    __fish_conda $cmd -l download-only -d 'Solve an environment: populate caches but no linking/unlinking into prefix'\0Aend\0A\0A# Option dry-run\0Afor cmd in create install remove update\0A    __fish_conda $cmd -l dry-run -d 'Only display what would have been done'\0Aend\0A\0A# Option file\0Afor cmd in create install update\0A    __fish_conda $cmd -l file -d 'Read package versions from the given file' -F\0Aend\0A\0A# Option force\0Afor cmd in create install remove update\0A    __fish_conda $cmd -l force -d 'Force install (even when package already installed)'\0Aend\0A\0A# Option insecure\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -l insecure -d 'Allow conda to perform \22insecure\22 SSL connections and transfers'\0Aend\0A\0A# Option mkdir\0Afor cmd in create install update\0A    __fish_conda $cmd -l mkdir -d 'Create the environment directory if necessary'\0Aend\0A\0A# Option name\0A__fish_conda create -s n -l name -d \22Name of new environment\22\0Afor cmd in install list remove search update\0A    __fish_conda $cmd -s n -l name -x -a \22(__fish_conda_environments)\22 -d \22Name of existing environment\22\0Aend\0A\0A# Option no-channel-priority\0Afor cmd in create install update\0A    __fish_conda $cmd -l no-channel-priority -l no-channel-pri -l no-chan-pri -d 'Package version takes precedence over channel priority'\0Aend\0A\0A# Option no-default-packages\0A__fish_conda create -l no-default-packages -d 'Ignore create_default_packages in the .condarc file'\0A\0A# Option no-deps\0Afor cmd in create install update\0A    __fish_conda $cmd -l no-deps -d 'Do not install, update, remove, or change dependencies'\0Aend\0A\0A# Option no-pin\0Afor cmd in create install remove update\0A    __fish_conda $cmd -l no-pin -d 'Ignore pinned file'\0Aend\0A\0A# Option no-show-channel-urls\0Afor cmd in create install list update\0A    __fish_conda $cmd -l no-show-channel-urls -d \22Don't show channel urls\22\0Aend\0A\0A# Option no-update-dependencies\0Afor cmd in create install update\0A    __fish_conda $cmd -l no-update-dependencies -l no-update-deps -d \22Don't update dependencies\22\0Aend\0A\0A# Option offline\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -l offline -d \22Offline mode, don't connect to the Internet\22\0Aend\0A\0A# Option only-deps\0Afor cmd in create install update\0A    __fish_conda $cmd -l only-deps -d \22Only install dependencies\22\0Aend\0A\0A# Option override-channels\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -l override-channels -d \22Do not search default or .condarc channels\22\0Aend\0A\0A# Option prefix\0Afor cmd in create install list remove search update\0A    __fish_conda $cmd -s p -l prefix -d \22Full path to environment prefix\22\0Aend\0A\0A# Option quiet\0Afor cmd in create install remove update\0A    __fish_conda $cmd -s q -l quiet -d \22Do not display progress bar\22\0Aend\0A\0A# Option show-channel-urls\0Afor cmd in create install list update\0A    __fish_conda $cmd -l show-channel-urls -d \22Show channel urls\22\0Aend\0A\0A# Option update-dependencies\0Afor cmd in create install update\0A    __fish_conda $cmd -l update-dependencies -l update-deps -d \22Update dependencies\22\0Aend\0A\0A# Option use-index-cache\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -s C -l use-index-cache -d \22Use cache of channel index files, even if it has expired\22\0Aend\0A\0A# Option use-local\0Afor cmd in create install remove search update\0A    __fish_conda $cmd -l use-local -d \22Use locally built packages\22\0Aend\0A\0A# Option yes\0Afor cmd in create install remove update\0A    __fish_conda $cmd -s y -l yes -d \22Do not ask for confirmation\22\0Aend\0A\0A# Option revision\0A__fish_conda install -l revision -d \22Revert to the specified REVISION\22\0A\0A# Option canonical\0A__fish_conda list -s c -l canonical -d \22Output canonical names of packages only. Implies --no-pip\22\0A\0A# Option explicit\0A__fish_conda list -l explicit -d \22List explicitly all installed conda with URL (output usable by conda create --file)\22\0A\0A# Option export\0A__fish_conda list -s e -l export -d \22Output requirement string only (output usable by conda create --file)\22\0A\0A# Option full-name\0A__fish_conda list -s f -l full-name -d \22Only search for full names, i.e., ^<regex>\\$\22\0A\0A# Option md5\0A__fish_conda list -l md5 -d \22Add MD5 hashsum when using --explicit\22\0A\0A# Option no-pip\0A__fish_conda list -s c -l canonical -d \22Output canonical names of packages only. Implies --no-pip\22\0A\0A# Option revisions\0A__fish_conda list -s r -l revisions -d \22List the revision history and exit\22\0A\0A# Option all\0A__fish_conda remove -l all -d \22Remove all packages, i.e., the entire environment\22\0A__fish_conda update -l all -d \22Update all installed packages in the environment\22\0A\0A# Option features\0A__fish_conda remove -l features -d \22Remove features (instead of packages)\22\0A\0A# Option info\0A__fish_conda search -s i -l info -d \22Provide detailed information about each package\22\0A\0A# Option platform\0Aset -l __fish_conda_platforms {osx,linux,win}-{32,64}\0A__fish_conda search -l platform -x -a \22$__fish_conda_platforms\22 -d \22Search the given platform\22\0A\0A# Option reverse-dependency\0A__fish_conda search -l reverse-dependency -d \22Perform a reverse dependency search\22\0A\0A__fish_conda_top -a env -d \22Conda options for environments\22\0Acomplete -c conda -n \22__fish_conda_subcommand env\22 -a create -d \22Create a new environment\22\0Acomplete -c conda -n \22__fish_conda_subcommand env\22 -a list -d \22List all conda environments\22\0Acomplete -c conda -n \22__fish_conda_subcommand env create\22 -s f -l file -rF -d \22Create environment from yaml file\22\0A", align 1
