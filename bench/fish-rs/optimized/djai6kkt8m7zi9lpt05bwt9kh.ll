@anon.1d0b41a8d45d477c3029ec78f9b8b434.1874 = private unnamed_addr constant [6512 x i8] c"set -l __fish_iptables_tables filter nat mangle raw security\0A\0Afunction __fish_iptables_current_table\0A    set -l next_is_table 1\0A    for token in (commandline -xc)\0A        switch $token\0A            case \22--table=*\22\0A                echo (string split -m1 = -- $token)[2]\0A                return 0\0A            case --table\0A                set next_is_table 0\0A            case \22-*t*\22\0A                set next_is_table 0\0A            case \22*\22\0A                if test $next_is_table -eq 0\0A                    echo $token\0A                    return 0\0A                end\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_iptables_user_chains\0A    # There can be user-defined chains so we need iptables' help\0A    set -l tablearg\0A    set -l table (__fish_iptables_current_table)\0A    if __fish_iptables_current_table\0A        set tablearg \22--table=$table\22\0A    end\0A    # This only works as root, so ignore errors\0A    iptables $tablearg -L 2>/dev/null | string match '*Chain*' | while read -l a b c\0A        echo $b\0A    end\0Aend\0A\0Afunction __fish_iptables_chains\0A    set -l table (__fish_iptables_current_table)\0A    test -z $table\0A    and set -l table \22*\22\0A    set -l prerouting \22PREROUTING\09For packets that are coming in\22\0A    set -l input \22INPUT\09For packets destined to local sockets\22\0A    set -l output \22OUTPUT\09For locally-generated packets\22\0A    set -l forward \22FORWARD\09For packets being routed through\22\0A    set -l postrouting \22POSTROUTING\09For packets that are about to go out\22\0A    switch $table\0A        case filter\0A            echo $input\0A            echo $forward\0A            echo $output\0A        case nat\0A            echo $prerouting\0A            echo $output\0A            echo $postrouting\0A        case mangle\0A            echo $prerouting\0A            echo $input\0A            echo $output\0A            echo $forward\0A            echo $postrouting\0A        case raw\0A            echo $prerouting\0A            echo $output\0A        case security\0A            echo $input\0A            echo $output\0A            echo $forward\0A        case '*'\0A            echo $prerouting\0A            echo $input\0A            echo $output\0A            echo $forward\0A            echo $postrouting\0A    end\0A    __fish_iptables_user_chains\0Aend\0A\0Afunction __fish_iptables_has_chain\0A    # Remove descriptions\0A    set -l chains (__fish_iptables_chains | string split -m1 \22    \22 | while read -l a b; echo $a; end)\0A    set -l cmdline (commandline -xp)\0A    for c in $chains\0A        if contains -- $c $cmdline\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0A# A target is a user-defined chain, one of \22ACCEPT DROP RETURN\22 or an extension (TODO)\0Afunction __fish_iptables_targets\0A    echo ACCEPT\0A    echo DROP\0A    echo RETURN\0A    __fish_iptables_chains\0Aend\0A\0A### Commands\0Acomplete -c iptables -s A -l append -d 'Append rules to the end of a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s C -l check -d 'Check whether a matching rule exists in a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s D -l delete -d 'Delete rules from a chain' -a '(__fish_iptables_chains)' -f\0A# Rulespec is match (can't complete that) and then a target\0A# TODO: This is only valid for some options, as others need a rulenum first or no rulespec at all\0Acomplete -c iptables -n '__fish_contains_opt -s A -s C -s D append check delete; and __fish_iptables_has_chain' -s j -l jump -d 'Specify the target of a rule' -f -a\\\0A'(__fish_iptables_targets)'\0A\0Acomplete -c iptables -n '__fish_contains_opt -s A -s C -s D append check delete; and __fish_iptables_has_chain' -s m -l match -d 'Specify a match to use' -f\0Acomplete -c iptables -n __fish_iptables_has_chain -a 'ACCEPT DROP RETURN' -f\0Acomplete -c iptables -n __fish_iptables_has_chain -a '( __fish_iptables_user_chains)' -f\0Acomplete -c iptables -s I -l insert -d 'Insert rules in the beginning of a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s R -l replace -d 'Replace a rule in a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s L -l list -d 'List all rules in a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s S -l list-rules -d 'Print all rules in a chain.' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s F -l flush -d 'Delete ALL rules in a chain' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s Z -l zero -d 'Zero the packet and byte counters in chains' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s N -l new-chain -d 'Create a new user-defined chain by the given name' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s X -l delete-chain -d 'Delete the optional user-defined chain specified' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s P -l policy -d 'Set the policy for the chain to the given target' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s E -l rename-chain -d 'Rename the user specified chain to the user supplied name' -a '(__fish_iptables_chains)' -f\0Acomplete -c iptables -s h -d Help -f\0A\0Acomplete -c iptables -s p -l protocol -d 'The protocol of the rule or of the packet to check' -f\0Acomplete -c iptables -s s -l source -d 'Source specification' -f\0Acomplete -c iptables -s d -l destination -d 'Destination specification' -f\0Acomplete -c iptables -s j -l jump -d 'Specify the target of a rule' -f\0Acomplete -c iptables -s i -l in-interface -d 'Interface via which a packet was received' -f\0Acomplete -c iptables -s o -l out-interface -d 'Interface via which packet is to be sent' -f\0Acomplete -c iptables -s f -l fragment -d 'Rule only refers to second and further ipv4 fragments' -f\0Acomplete -c iptables -s c -l set-counters -d 'Initialize packet and byte counters of a rule' -f\0Acomplete -c iptables -s v -l verbose -d 'Verbose output' -f\0Acomplete -c iptables -s w -l wait -d 'Wait for the xtables lock' -f\0Acomplete -c iptables -s n -l numeric -d 'Numeric output' -f\0Acomplete -c iptables -s x -l exact -d 'Expand numbers' -f\0Acomplete -c iptables -l line-numbers -d 'When listing rules, add line numbers' -f\0Acomplete -c iptables -s t -l table -d 'The table to operate on' -a \22$__fish_iptables_tables\22 -f\0A\0A# Options that take files\0Acomplete -c iptables -l modprobe -d 'Use this command to load modules' -r\0A\0A# I don't get these\0A# complete -c iptables -s 4 -l ipv4 -d 'This option has no effect in iptables and iptables-restore.' -f\0A# complete -c iptables -s 6 -l ipv6 -d 'If a rule using the -6 option is inserted with \E2\80\A6 [See Man Page]' -f\0A# complete -c iptables -s g -l goto -d '' -f\0A\0A# Should aliased options be in the completion?\0A# complete -c iptables -l dst -d 'Alias for -d' -f\0A", align 1
