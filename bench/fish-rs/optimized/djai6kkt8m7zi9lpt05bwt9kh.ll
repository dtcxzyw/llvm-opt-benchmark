@anon.1d0b41a8d45d477c3029ec78f9b8b434.3508 = private unnamed_addr constant [433 x i8] c"function popd --description \22Pop directory from the stack and cd to it\22\0A    if count $argv >/dev/null\0A        switch $argv[1]\0A            case -h --h --he --hel --help\0A                __fish_print_help popd\0A                return 0\0A        end\0A    end\0A\0A    if set -q dirstack[1]\0A        cd $dirstack[1]\0A        set -e dirstack[1]\0A    else\0A        printf (_ \22%s: Directory stack is empty\E2\80\A6\\n\22) popd 1>&2\0A        return 1\0A    end\0Aend\0A", align 1
