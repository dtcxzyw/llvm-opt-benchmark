@anon.1d0b41a8d45d477c3029ec78f9b8b434.3482 = private unnamed_addr constant [6940 x i8] c"function funced --description 'Edit function definition'\0A    set -l options h/help 'e/editor=' i/interactive s/save\0A    argparse -n funced --max-args=1 $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help funced\0A        return 0\0A    end\0A\0A    if not set -q argv[1]\0A        printf (_ \22%ls: Expected at least %d args, got only %d\\n\22) funced 1 0\0A        return 1\0A    end\0A\0A    set -l funcname $argv[1]\0A\0A    # Check VISUAL first since theoretically EDITOR could be ed.\0A    set -l editor\0A    if set -q _flag_interactive\0A        set editor fish\0A    else if set -q _flag_editor\0A        echo $_flag_editor | read -at editor\0A    else if set -q VISUAL\0A        echo $VISUAL | read -at editor\0A    else if set -q EDITOR\0A        echo $EDITOR | read -at editor\0A    else\0A        set editor fish\0A    end\0A\0A    set -l init\0A    switch $funcname\0A        case '-*'\0A            set init function -- $funcname\\n\\nend\0A        case '*'\0A            set init function $funcname\\n\\nend\0A    end\0A\0A    if not type -q -f \22$editor[1]\22\0A        echo (_ \22funced: The value for \\$EDITOR '$editor' could not be used because the command '$editor[1]' could not be found\22) >&2\0A        set editor fish\0A    end\0A\0A    if test \22$editor\22 = fish\0A        if functions -q -- $funcname\0A            functions --no-details -- $funcname | __fish_indent --only-unindent | __fish_indent --no-indent | read -z init\0A        end\0A\0A        set -l prompt 'printf \22%s%s%s> \22 (set_color green) '$funcname' (set_color normal)'\0A        if read -p $prompt -c \22$init\22 --shell cmd\0A            echo -n $cmd | __fish_indent --only-unindent | read -lz cmd\0A            eval \22$cmd\22\0A        end\0A        if set -q _flag_save\0A            funcsave $funcname\0A        end\0A        return 0\0A    end\0A\0A    # OS X (macOS) `mktemp` is rather restricted - no suffix, no way to automatically use TMPDIR.\0A    # Create a directory so we can use a \22.fish\22 suffix for the file - makes editors pick up that\0A    # it's a fish file.\0A    set -q TMPDIR\0A    or set -l TMPDIR /tmp\0A    set -l tmpdir (mktemp -d $TMPDIR/fish.XXXXXX)\0A    or return 1\0A    set -l tmpname $tmpdir/$funcname.fish\0A\0A    set -l writepath\0A\0A    if not functions -q -- $funcname\0A        echo $init >$tmpname\0A    else if functions --details -- $funcname | string match --invert --quiet --regex '^(?:-|stdin|embedded:.*)$'\0A        set writepath (functions --details -- $funcname)\0A        # Use cat here rather than cp to avoid copying permissions\0A        cat \22$writepath\22 >$tmpname\0A    else if set -l path (functions --details -- $funcname | string match -rg '^embedded:(.*)$')\0A        status get-file $path >$tmpname\0A    else\0A        functions -- $funcname >$tmpname\0A    end\0A\0A    # Repeatedly edit until it either parses successfully, or the user cancels\0A    # If the editor command itself fails, we assume the user cancelled or the file\0A    # could not be edited, and we do not try again\0A    while true\0A        set -l checksum (__fish_md5 \22$tmpname\22)\0A\0A        if not $editor $tmpname\0A            echo (_ \22Editing failed or was cancelled\22)\0A        else\0A            # Verify the checksum (if present) to detect potential problems\0A            # with the editor command\0A            if set -q checksum[1]\0A                set -l new_checksum (__fish_md5 \22$tmpname\22)\0A                if test \22$new_checksum\22 = \22$checksum\22\0A                    echo (_ \22Editor exited but the function was not modified\22)\0A                    echo (_ \22If the editor is still running, check if it waits for completion, maybe a '--wait' option?\22)\0A                    # Source but don't save an unmodified file.\0A                    # (Source in case the file changed externally since we first loaded it.)\0A                    if set -q writepath[1]\0A                        source \22$writepath\22\0A                    end\0A                    break\0A                end\0A            end\0A\0A            if not source <$tmpname\0A                # Failed to source the function file. Prompt to try again.\0A                echo # add a line between the parse error and the prompt\0A                set -l repeat\0A                set -l prompt (_ 'Edit the file again? [Y/n]')\0A                read -P \22$prompt \22 response\0A                if test -z \22$response\22\0A                    or contains $response {Y,y}{E,e,}{S,s,}\0A                    continue\0A                else if not contains $response {N,n}{O,o,}\0A                    echo \22I don't understand '$response', assuming 'Yes'\22\0A                    sleep 2\0A                    continue\0A                end\0A                echo (_ \22Cancelled function editing\22)\0A            else if test -n \22$writepath\22\0A                if not set -q _flag_save\0A                    echo (_ \22Warning: the file containing this function has not been saved. Changes may be lost when fish is closed.\22)\0A                    set -l prompt (printf (_ 'Save function to %s? [Y/n]') \22$writepath\22)\0A                    read --prompt-str \22$prompt \22 response\0A                    if test -z \22$response\22\0A                        or contains $response {Y,y}{E,e,}{S,s,}\0A                        set _flag_save 1\0A                    else if not contains $response {N,n}{O,o,}\0A                        echo \22I don't understand '$response', assuming 'Yes'\22\0A                        set _flag_save 1\0A                    end\0A                end\0A                if set -q _flag_save\0A                    # try to write the file back\0A                    # cp preserves existing permissions, though it might overwrite the owner\0A                    if cp $tmpname \22$writepath\22 2>&1\0A                        printf (_ \22Function saved to %s\22) \22$writepath\22\0A                        echo\0A                        # read it back again - this ensures that the output of `functions --details` is correct\0A                        source \22$writepath\22\0A                    else\0A                        echo (_ \22Saving to original location failed; saving to user configuration instead.\22)\0A                        set writepath $__fish_config_dir/functions/(path basename \22$writepath\22)\0A                        if cp $tmpname \22$writepath\22\0A                            printf (_ \22Function saved to %s\22) \22$writepath\22\0A                            echo\0A                            # read it back again - this ensures that the output of `functions --details` is correct\0A                            source \22$writepath\22\0A                        else\0A                            echo (_ \22Saving to user configuration failed. Changes may be lost when fish is closed.\22)\0A                        end\0A                    end\0A                end\0A            else if set -q _flag_save\0A                funcsave $funcname\0A            else\0A                printf (_ \22Run funcsave %s to save this function to the configuration directory.\22) $funcname\0A                echo\0A            end\0A        end\0A        break\0A    end\0A\0A    set -l stat $status\0A    command rm $tmpname >/dev/null\0A    and rmdir $tmpdir >/dev/null\0A    return $stat\0Aend\0A", align 1
