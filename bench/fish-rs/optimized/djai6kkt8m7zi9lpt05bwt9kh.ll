@anon.1d0b41a8d45d477c3029ec78f9b8b434.1872 = private unnamed_addr constant [2021 x i8] c"function __fish_ipset_nosubcommand\0A    if __fish_seen_subcommand_from create add del test destroy list save restore flush rename swap help version\0A        return 1\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_ipset_needs_setname\0A    if __fish_seen_subcommand_from add del test destroy list save restore flush rename swap\0A        return 0\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_ipset_list_sets\0A    set -l ipset_list (ipset list --name 2>/dev/null)\0A    if not __fish_seen_subcommand_from $ipset_list\0A        echo $ipset_list\0A    end\0Aend\0A\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a create -d 'Create a set identified with SETNAME'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a add -d 'Add a given entry to a SET'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a del -d 'Delete an entry from a SET'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a test -d 'Test whether an entry is in a set'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a x -d 'Destroy the specified set or all sets'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a destroy -d 'Destroy the specified set or all sets'\0Acomplete -c ipset --no-files --condition __fish_ipset_nosubcommand -a list -d a\0A\0Acomplete -c ipset --no-files --condition __fish_ipset_needs_setname -a '(__fish_ipset_list_sets)'\0A\0Acomplete -c ipset --no-files -s ! -o exist -d 'Ignore errors'\0Acomplete -c ipset --no-files -s o -o output -a 'plain save xml' -d 'Output format to the list command'\0Acomplete -c ipset --no-files -s q -o quiet -d 'Suppress any output'\0Acomplete -c ipset --no-files -s r -o resolve -d 'Enforce name lookup'\0A# complete -c ipset --no-files -s 's' -o 'sorted' -d 'Sorted output (not supported yet)'\0Acomplete -c ipset --no-files -s n -o name -d 'List just the names of the sets'\0Acomplete -c ipset --no-files -s t -o terse -d 'List the set names and headers'\0Acomplete -c ipset --no-files -s f -o file -d 'Filename instead of stdout'\0A", align 1
