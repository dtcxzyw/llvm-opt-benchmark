@anon.1d0b41a8d45d477c3029ec78f9b8b434.1326 = private unnamed_addr constant [726 x i8] c"# Multiple versions are often installed as clang, clang-7, clang-8, etc.\0A# They won't be autoloaded, but once clang++ is used once, they'll gain completions too.\0A# This could potentially be moved to __fish_config_interactive.fish in the future.\0A\0A# This pattern unfortunately matches clang-format, etc. as well.\0Acomplete -p '*clang*' -n __fish_should_complete_switches -xa '(__fish_complete_clang)'\0Acomplete -c clang -n 'not __fish_should_complete_switches' \\\0A    -k -xa \22(__fish_complete_suffix .o .out .c .cpp .so .dylib)\22\0A\0A# again but without the -x this time for the pattern-matched completion\0Acomplete -p '*clang*' -n 'not __fish_should_complete_switches' \\\0A    -k -a \22(__fish_complete_suffix .o .out .c .cpp .so .dylib)\22\0A", align 1
