@anon.1d0b41a8d45d477c3029ec78f9b8b434.1882 = private unnamed_addr constant [12798 x i8] c"# iw(8) completion for fish\0A\0A# The completions for iw are based off those for ip, which has a similar options structure.\0A\0Aset -l iw_commands dev phy reg event features commands list\0A# wdev not supported since it is barely documented\0A\0Afunction __fish_iw_device\0A    __fish_print_interfaces | while read -l i\0A        printf '%s\\t%s\\n' $i Device\0A    end\0Aend\0A\0Afunction __fish_iw_phy\0A    set -l phys /sys/class/ieee80211/*\0A    string match --regex '[^/]*$' $phys\0Aend\0A\0Afunction __fish_iw_ssid\0A    printf '%s\\n' (iw dev $argv[1] scan dump | string match --regex --entire SSID | string split ' ')[2]\0Aend\0A\0Afunction __fish_complete_iw\0A    set -l cmd (commandline -xpc)\0A\0A    if string match --quiet -- '-*' $cmd[2]\0A        set -e cmd[2] # Allow other completions to complete as normal\0A    end\0A    if not set -q cmd[2]\0A        return # Uses completions from $iw_commands\0A    else if not set -q cmd[3]\0A        switch $cmd[2]\0A            case dev\0A                __fish_iw_device\0A            case phy\0A                __fish_iw_phy\0A        end\0A        return\0A    end\0A    switch $cmd[2]\0A        case dev\0A            switch \22$cmd[4]\22\0A                case ap\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' stop \22Stop AP functionality\22 \\\0A                            start \22Start AP functionality\22\0A                    end\0A                case auth connect\0A                    if not set -q cmd[5]\0A                        __fish_iw_ssid $cmd[3]\0A                    end\0A                case disconnect\0A                case cqm\0A                    if not set -q cmd[5]\0A                        echo rssi\0A                    else if not set -q cmd[6]\0A                        echo threshold\0A                        echo off\0A                    end\0A                case ftm\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' start_responder \22Start an FTM responder\22 \\\0A                            get_stats \22Get FTM responder statistics\22\0A                    end\0A                case ibss\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' join \22Join an IBSS cell or create one\22 \\\0A                            leave \22Leave the current IBSS cell\22\0A                    end\0A                case switch\0A                    if not set -q cmd[5]\0A                        echo channel\0A                        echo freq\0A                    end\0A                case info del\0A                case interface\0A                    if not set -q cmd[5]\0A                        echo add\0A                    end\0A                case link\0A                case measurement\0A                    if not set -q cmd[5]\0A                        echo ftm_request\0A                    else if not set -q cmd[6]\0A                        __fish_complete_path\0A                    end\0A                    # options after config file?\0A                case mesh\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' leave \22Leave a mesh\22 \\\0A                            join \22Join a mesh\22\0A                    end\0A                case mgmt\0A                    if not set -q cmd[5]\0A                        echo dump\0A                    else if not set -q cmd[6]\0A                        echo frame\0A                    end\0A                case mpath\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' dump \22List known mesh paths\22 \\\0A                            set \22Set an existing mesh path's next hop\22 \\\0A                            new \22Create a new mesh math manually\22 \\\0A                            del \22Remove the mesh path to a node\22 \\\0A                            get \22Get information on a mesh path to a node\22 \\\0A                            probe \22Inject ethernet frame to a peer\22\0A                    end\0A                case mpp\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' dump \22List known mesh proxy paths\22 \\\0A                            get \22Get information on mesh proxy path to a node\22\0A                    end\0A                case ocb\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' leave \22Leave the OCB mode network\22 \\\0A                            join \22Join the OCB mode network\22\0A                    end\0A                case cac\0A                    if not set -q cmd[5]\0A                        echo channel\0A                        echo freq\0A                        echo trigger\0A                    end\0A                case roc\0A                    if not set -q cmd[5]\0A                        echo start\0A                    end\0A                case scan\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' sched_stop \22Stop an ongoing scheduled scan\22 \\\0A                            sched_start \22Start a scheduled scan\22 \\\0A                            abort \22Abort ongoing scan\22 \\\0A                            trigger \22Trigger a scan\22 \\\0A                            dump \22Dmp the current scan results\22\0A                    end\0A                    # -u option?\0A                case set\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' bitrates \22Rate masks\22 \\\0A                            mcast_rate \22Multicast bitrate\22 \\\0A                            peer \22WDS peer\22 \\\0A                            noack_map \22Noack map for TIDs\22 \\\0A                            4addr \224addr (WDS) mode\22 \\\0A                            type \22Interface type/mode\22 \\\0A                            meshid \22\22 \\\0A                            monitor \22Monitor flags\22 \\\0A                            mesh_param \22Mesh parameter\22 \\\0A                            txpower \22Transmit power\22 \\\0A                            channel \22\22 \\\0A                            freq \22\22 \\\0A                            power_save \22Power save state\22\0A                    else\0A                        switch \22$cmd[5]\22\0A                            case type\0A                                if not set -q cmd[6]\0A                                    printf '%s\\n' managed ibss monitor mesh wds\0A                                end\0A                            case channel\0A                                if not set -q cmd[6]\0A                                    # cmd[6] is just the simple channel number\0A                                else if not set -q cmd[7]\0A                                    printf '%s\\n' NOHT HT20 HT40+ HT40- 5MHz 10MHz 80MHz 160MHz\0A                                end\0A                        end\0A                    end\0A                case get\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' mesh_param \22Mesh parameter\22 \\\0A                            power_save \22Power save state\22\0A                    end\0A                case station\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' dump \22List all stations known\22 \\\0A                            set \22Set station options\22 \\\0A                            del \22Remove a station entry\22 \\\0A                            get \22Get information for a station\22\0A                    end\0A                case survey\0A                    if not set -q cmd[5]\0A                        echo dump\0A                    end\0A                case vendor\0A                    if not set -q cmd[5]\0A                        echo recvbin\0A                        echo recv\0A                        echo send\0A                    end\0A                case '*'\0A                    printf '%s\\t%s\\n' ap \22Start/stop AP functionality\22 \\\0A                        auth \22Authenticate with a network\22 \\\0A                        connect \22Join a network\22 \\\0A                        disconnect \22Disconnect from the current network\22 \\\0A                        cqm \22Set connection quality monitor RSSI threshold\22 \\\0A                        ftm \22Control the FTM responder\22 \\\0A                        ibss \22Join or leave a IBSS cell\22 \\\0A                        switch \22Switch the operating channel by sending a CSA\22 \\\0A                        info \22Show information for this interface\22 \\\0A                        del \22Remove this virtual interface\22 \\\0A                        interface \22Control the interface\22 \\\0A                        link \22Print information about the current link\22 \\\0A                        measurement \22Perform measurements\22 \\\0A                        mesh \22Join or leave a mesh\22 \\\0A                        mpp \22Get information on mesh proxy paths\22 \\\0A                        mgmt \22Print mgmt frames\22 \\\0A                        mpath \22Interact with mesh paths\22 \\\0A                        ocb \22Join or leave an OCB mode network\22 \\\0A                        offchannel \22Leave operating channel\22 \\\0A                        cac \22Start or trigger a channel availability chec\22 \\\0A                        roc \22\22 \\\0A                        scan \22Scan and probe for SSIDs\22 \\\0A                        set \22Set parameters\22 \\\0A                        get \22Get parameters\22 \\\0A                        station \22Set station parameters\22 \\\0A                        survey \22List all gathered channel survey data\22 \\\0A                        vendor \22\22\0A            end\0A        case phy\0A            switch \22$cmd[4]\22\0A                case coalesce\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' show \22Show coalesce status\22 \\\0A                            disable \22Disable coalesce\22 \\\0A                            enable \22Enable coalesce\22\0A                    else if test \22$cmd[5]\22 = enable && not set -q cmd[6]\0A                        __fish_complete_path # Enable takes a config file\0A                    end\0A                case hwsim\0A                    if not set -q cmd[5]\0A                        printf '%s\\n' wakequeues stopqueues setps getps\0A                    end\0A                case info\0A                case interface\0A                    if not set -q cmd[5]\0A                        echo add\0A                    end\0A                case channels\0A                case reg\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' get \22Print the current regulatory domain information\22 \\\0A                            set \22Notify kernel about current regulatory domain\22\0A                    end\0A                case set\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' txq \22TXQ parameters\22 \\\0A                            antenna \22Bitmap of allowed antennas\22 \\\0A                            txpower \22Transmit power\22 \\\0A                            distance \22Link distance coverage class\22 \\\0A                            netns \22Network namespace\22 \\\0A                            retry \22Retry limit\22 \\\0A                            rts \22Rts threshold\22 \\\0A                            frag \22Fragmentation threshold\22 \\\0A                            channel \22\22 \\\0A                            name \22Wireless device name\22\0A                    end\0A                case get\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' txq \22TXQ parameters\22\0A                    end\0A                case get\0A                    if not set -q cmd[5]\0A                        printf '%s\\t%s\\n' show \22Show WoWLAN status\22 \\\0A                            disable \22Disable WoWLAN\22 \\\0A                            enable \22Enable WoWLAN\22\0A                    end\0A                case '*'\0A                    printf '%s\\t%s\\n' coalesce \22Interface with coalesce\22 \\\0A                        hwsim \22\22 \\\0A                        info \22Show wireless device capabilities\22 \\\0A                        interface \22Add a new virtual interface\22 \\\0A                        channels \22Show available channels\22 \\\0A                        reg \22Manage regulatory domains\22 \\\0A                        set \22Set parameters\22 \\\0A                        get \22Get parameters\22\0A            end\0A    end\0Aend\0A\0Acomplete -f -c iw\0Acomplete -f -c iw -a '(__fish_complete_iw)'\0Acomplete -f -c iw -n \22not __fish_seen_subcommand_from $iw_commands\22 -a \22$iw_commands\22\0A# Yes, iw only takes options before \22objects\22\0Acomplete -f -c iw -l debug -d \22Enable netlink message debugging\22 -n \22not __fish_seen_subcommand_from $iw_commands\22\0Acomplete -f -c iw -l version -d \22Print the version\22 -n \22not __fish_seen_subcommand_from $iw_commands\22\0A\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from event\22 -s t -d 'Print timestamp'\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from event\22 -s r -d 'Print relative timestamp'\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from event\22 -s f -d 'Print full frame for auth/assoc'\0A\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from reg\22 -a reload -d 'Reload the kernel\\'s regulatory database'\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from reg\22 -a get -d 'Print the kernel\\'s current regulatory domain information'\0Acomplete -f -c iw -n \22__fish_seen_subcommand_from reg\22 -a set -d 'Notify the kernel about the current regulatory domain'\0A", align 1
