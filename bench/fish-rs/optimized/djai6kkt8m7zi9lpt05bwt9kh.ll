@anon.1d0b41a8d45d477c3029ec78f9b8b434.1172 = private unnamed_addr constant [2534 x i8] c"# Completions for the archlinux package information and build tool `asp` (https://github.com/falconindy/asp)\0Aset -l commands checkout difflog export gc disk-usage help list-{all,arches,local,repos} {short,}log show update untrack\0A\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a checkout -d \22Checkout package\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a difflog -d \22Show the full history of the target, with file diffs\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a export -d \22Put the source files in current directory\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a gc -d \22Collect garbage\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a disk-usage -d \22Report approximate disk usage\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a help -d \22Display help and exit\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a list-all -d \22List all known packages\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a list-arches -d \22List the architectures the targets are available for\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a list-local -d \22List locally tracked packages\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a list-repos -d \22List repos the targets exist in\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a log -d \22Show revision history of the target\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a shortlog -d \22Show condensed revision history\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a show -d \22Show the target's PKGBUILD\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a update -d \22Update given targets\22 -f\0Acomplete -c asp -n \22not __fish_seen_subcommand_from $commands\22 -a untrack -d \22Remove target from local repository\22 -f\0A\0A# Remove pointless \22packages/\22 or \22community/\22 before package names\0A# Don't show foreign packages for untrack, and show no packages at all for gc, help, disk-usage, list-{all,local}\0A# This will run into the description race.\0Acomplete -c asp -n \22__fish_seen_subcommand_from checkout {diff,short,}log export list-{arches,repos} show update\22 -a \22(asp list-all | string replace -r '.*/' '')\22 -f\0Acomplete -c asp -n \22__fish_seen_subcommand_from checkout {diff,short,}log export list-{arches,repos} show update untrack\22 -a \22(asp list-local | string replace -r '.*/' '')\22 -f \\\0A    -d \22Locally tracked package\22\0A", align 1
