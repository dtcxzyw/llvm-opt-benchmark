@anon.1d0b41a8d45d477c3029ec78f9b8b434.1288 = private unnamed_addr constant [1231 x i8] c"function __fish_canto_using_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -gt 1\0A        if test $argv[1] = $cmd[2]\0A            return 0\0A        end\0A        if test count $argv -gt 2\0A            if test $argv[2] = $cmd[2]\0A                return 0\0A            end\0A        end\0A    end\0A    return 1\0Aend\0A\0Acomplete -f -c canto -s h -l help -d 'Show Help'\0Acomplete -f -c canto -s v -l version -d 'Show version'\0Acomplete -f -c canto -s u -l update -d 'Update before running'\0Acomplete -f -c canto -s l -l list -d 'List feeds'\0Acomplete -f -c canto -s a -l checkall -d 'Show number of new items'\0A\0Acomplete -f -c canto -s n -l checknew -d 'Show number of new items for feed'\0Acomplete -f -c canto -n '__fish_canto_using_command -l --checknew' -d Feed -a '(command canto -l)'\0A\0Acomplete -c canto -s o -l opml -d 'Print conf as OPML'\0Acomplete -c canto -s i -l import -d 'Import from OPML'\0Acomplete -f -c canto -s r -l url -d 'Add feed'\0A\0Acomplete -c canto -s D -l dir -d 'Set configuration directory'\0Acomplete -c canto -s C -l conf -d 'Set configuration file'\0Acomplete -c canto -s L -l log -d 'Set client log file'\0Acomplete -c canto -s F -l fdir -d 'Set feed directory'\0Acomplete -c canto -s S -l sdir -d 'Set script directory'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1289 = private unnamed_addr constant [22 x i8] c"completions/cargo.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1290 = private unnamed_addr constant [91480 x i8] c"# Tab completion for cargo (https://github.com/rust-lang/cargo).\0A\0A## --- WRITTEN MANUALLY ---\0A\0Afunction __fish_cargo\0A    cargo --color=never $argv\0Aend\0A\0Aset -l __fish_cargo_subcommands (__fish_cargo --list 2>&1 | string replace -rf '^\\s+([^\\s]+)\\s*(.*)' '$1\\t$2' | string escape)\0A\0Acomplete -c cargo -f -c cargo -n __fish_use_subcommand -a \22$__fish_cargo_subcommands\22\0Acomplete -c cargo -x -c cargo -n '__fish_seen_subcommand_from help' -a \22$__fish_cargo_subcommands\22\0A\0Afor x in bench b build c check rustc t test\0A    complete -c cargo -x -n \22__fish_seen_subcommand_from $x\22 -l bench -a \22(__fish_cargo bench --bench 2>&1 | string replace -rf '^\\s+' '')\22\0A    complete -c cargo -n \22__fish_seen_subcommand_from $x\22 -l lib -d 'Only this package\\'s library'\0A    complete -c cargo -x -n \22__fish_seen_subcommand_from $x\22 -l test -a \22(__fish_cargo test --test 2>&1 | string replace -rf '^\\s+' '')\22\0Aend\0A\0Afor x in bench b build c check r run rustc t test\0A    complete -c cargo -x -n \22__fish_seen_subcommand_from $x\22 -l bin -a \22(__fish_cargo run --bin 2>&1 | string replace -rf '^\\s+' '')\22\0A    complete -c cargo -x -n \22__fish_seen_subcommand_from $x\22 -l example -a \22(__fish_cargo run --example 2>&1 | string replace -rf '^\\s+' '')\22\0Aend\0A\0A# If using rustup, get the list of installed targets from there. Otherwise print all targets.\0A#\0A# NB: I wasn't sure if it's possible to manually target a platform you don't have the corresponding toolchain for installed,\0A# and it turns out indeed this isn't strictly correct if you choose to manually compile the standard library (-Zbuild-std,\0A# nightly only) and are targeting a platform that your native linker also supports, e.g.\0A# `cargo build +nightly -Zbuild-std --target=i586-unknown-linux-gnu` works even if you only have the i686-unknown-linux-gnu\0A# toolchain installed.\0A#\0A# Ideally, we'd use rustup's \22installed targets\22 but fall back to completions from rustc's \22all targets\22 list, but we don't\0A# have an easy way to do that in the `complete` machinery at this time.\0Afunction __fish_cargo_targets\0A    if command -q rustup\0A        functions -q __rustup_installed_targets || complete -C\22rustup \22 &>/dev/null\0A        __rustup_installed_targets\0A    else\0A        rustc --print target-list\0A    end\0Aend\0A\0Afunction __fish_cargo_features\0A    if command -q jq\0A        __fish_cargo read-manifest | jq -r '.features | keys | .[]' | __fish_concat_completions\0A    else if set -l python (__fish_anypython)\0A        __fish_cargo read-manifest | command $python -Sc \22import sys, json\22\\n\22print(*json.load(sys.stdin)['features'].keys(), sep='\\n')\22 | __fish_concat_completions\0A    end\0Aend\0A\0Afunction __fish_cargo_packages\0A    if command -q jq\0A        __fish_cargo metadata --no-deps --format-version 1 | jq -r '.packages | .[] | .name' | __fish_concat_completions\0A    else if set -l python (__fish_anypython)\0A        __fish_cargo metadata --no-deps --format-version 1 |\0A            command $python -Sc \22import sys, json\22\\n\22print(*[x['name'] for x in json.load(sys.stdin)['packages']], sep='\\n')\22\0A    end\0Aend\0Acomplete -c cargo -n '__fish_seen_subcommand_from run test build debug check clippy' -s p -l package \\\0A    -xa \22(__fish_cargo_packages)\22\0A\0A## --- AUTO-GENERATED WITH `cargo complete fish` ---\0A# Manually massaged to improve some descriptions\0Acomplete -c cargo -n __fish_use_subcommand -l explain -d 'Run `rustc --explain CODE`'\0Acomplete -c cargo -n __fish_use_subcommand -l color -d 'Coloring: auto, always, never'\0Acomplete -c cargo -n __fish_use_subcommand -l config -d 'Override a configuration value (unstable)'\0Acomplete -c cargo -n __fish_use_subcommand -s Z -d 'Unstable (nightly-only) flags to Cargo, see \\'cargo -Z help\\' for details' -xa '(__fish_cargo -Z hel