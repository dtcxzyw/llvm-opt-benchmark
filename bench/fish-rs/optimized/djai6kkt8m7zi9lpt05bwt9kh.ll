@anon.1d0b41a8d45d477c3029ec78f9b8b434.3004 = private unnamed_addr constant [440 x i8] c"complete -c yajsv -s h -l help -d 'Show help'\0Acomplete -c yajsv -s v -d 'Show version'\0A\0Acomplete -c yajsv -s b -r -d \22Allow BOM in JSON files\22\0Acomplete -c yajsv -s l -r -d \22Validate the JSON documents from newline separated paths and/or globs in a text file\22\0Acomplete -c yajsv -s q -r -d \22Hide everything except errors\22\0Acomplete -c yajsv -s r -r -d \22The referenced schema\22\0Acomplete -c yajsv -s s -r -d \22The JSON schema to validate against\22\0A", align 1
