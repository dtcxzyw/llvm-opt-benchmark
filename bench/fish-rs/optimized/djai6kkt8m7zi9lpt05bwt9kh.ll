@anon.1d0b41a8d45d477c3029ec78f9b8b434.1604 = private unnamed_addr constant [4140 x i8] c"function __fish_complete_fab_tasks\0A    for task in (fab -l)\0A        set -l _matched (string match -r \22^ +([^ ]*) *([^ ]?.*)\22 $task)\0A\0A        printf \22%s\\t%s\\n\22 \22$_matched[2]\22 \22$_matched[3]\22\0A    end\0Aend\0A\0A# tasks \0Acomplete -x -c fab -a \22(__fish_complete_fab_tasks)\22\0A\0A# options\0Acomplete -c fab -s h -l help -d \22show this help message and exit\22\0Acomplete -x -c fab -s d -l display -a \22(fab --shortlist)\22 -d \22print detailed info about command NAME\22\0Acomplete -x -c fab -s F -l list-format -a \22short normal nested\22 -d \22formats --list, choices: short, normal, nested\22\0Acomplete -c fab -s I -l initial-password-prompt -d \22Force password prompt up-front\22\0Acomplete -c fab -l initial-sudo-password-prompt -d \22Force sudo password prompt up-front\22\0Acomplete -c fab -s l -l list -d \22print list of possible commands and exit\22\0Acomplete -x -c fab -l set -d \22comma separated KEY=VALUE pairs to set Fab env vars\22\0Acomplete -c fab -l shortlist -d \22alias for -F short --list\22\0Acomplete -c fab -s V -l version -d \22show program's version number and exit\22\0Acomplete -c fab -s a -l no_agent -d \22don't user the running SSH agent\22\0Acomplete -c fab -s A -l forward-agent -d \22forward local agent to remote end\22\0Acomplete -c fab -l abort-on-prompts -d \22abort instead of prompting (for password, host, etc)\22\0Acomplete -r -c fab -s c -l config -d \22specify location of config file to use\22\0Acomplete -c fab -l colorize-errors -d \22Color error output\22\0Acomplete -c fab -s D -l disable-known-host -d \22do not load user known_hosts file\22\0Acomplete -c fab -s e -l eagerly-disconnect -d \22disconnect from hosts as soon as possible\22\0Acomplete -r -c fab -s f -l fabfile -d \22python module file to import, e.g. '../other.py'\22\0Acomplete -x -c fab -s g -l gateway -a \22(__fish_complete_user_at_hosts)\22 -d \22gateway