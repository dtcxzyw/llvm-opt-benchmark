@anon.1d0b41a8d45d477c3029ec78f9b8b434.3562 = private unnamed_addr constant [2458 x i8] c"# name: Arrow\0A# author: Bruno Ferreira Pinto, Pawel Zubrycki\0A\0Afunction fish_prompt\0A    set -l __last_command_exit_status $status\0A\0A    if not set -q -g __fish_arrow_functions_defined\0A        set -g __fish_arrow_functions_defined\0A        function _git_branch_name\0A            set -l branch (git symbolic-ref --quiet HEAD 2>/dev/null)\0A            if set -q branch[1]\0A                echo (string replace -r '^refs/heads/' '' $branch)\0A            else\0A                echo (git rev-parse --short HEAD 2>/dev/null)\0A            end\0A        end\0A\0A        function _is_git_dirty\0A            not command git diff-index --cached --quiet HEAD -- &>/dev/null\0A            or not command git diff --no-ext-diff --quiet --exit-code &>/dev/null\0A        end\0A\0A        function _is_git_repo\0A            type -q git\0A            or return 1\0A            git rev-parse --git-dir >/dev/null 2>&1\0A        end\0A\0A        function _hg_branch_name\0A            echo (hg branch 2>/dev/null)\0A        end\0A\0A        function _is_hg_dirty\0A            set -l stat (hg status -mard 2>/dev/null)\0A            test -n \22$stat\22\0A        end\0A\0A        function _is_hg_repo\0A            fish_print_hg_root >/dev/null\0A        end\0A\0A        function _repo_branch_name\0A            _$argv[1]_branch_name\0A        end\0A\0A        function _is_repo_dirty\0A            _is_$argv[1]_dirty\0A        end\0A\0A        function _repo_type\0A            if _is_hg_repo\0A                echo hg\0A                return 0\0A            else if _is_git_repo\0A                echo git\0A                return 0\0A            end\0A            return 1\0A        end\0A    end\0A\0A    set -l cyan (set_color -o cyan)\0A    set -l yellow (set_color -o yellow)\0A    set -l red (set_color -o red)\0A    set -l green (set_color -o green)\0A    set -l blue (set_color -o blue)\0A    set -l normal (set_color normal)\0A\0A    set -l arrow_color \22$green\22\0A    if test $__last_command_exit_status != 0\0A        set arrow_color \22$red\22\0A    end\0A\0A    set -l arrow \22$arrow_color\E2\9E\9C \22\0A    if fish_is_root_user\0A        set arrow \22$arrow_color# \22\0A    end\0A\0A    set -l cwd $cyan(prompt_pwd | path basename)\0A\0A    set -l repo_info\0A    if set -l repo_type (_repo_type)\0A        set -l repo_branch $red(_repo_branch_name $repo_type)\0A        set repo_info \22$blue $repo_type:($repo_branch$blue)\22\0A\0A        if _is_repo_dirty $repo_type\0A            set -l dirty \22$yellow \E2\9C\97\22\0A            set repo_info \22$repo_info$dirty\22\0A        end\0A    end\0A\0A    echo -n -s $arrow ' '$cwd $repo_info $normal ' '\0Aend\0A", align 1
