@anon.1d0b41a8d45d477c3029ec78f9b8b434.2596 = private unnamed_addr constant [2434 x i8] c"function __fish_complete_setxkbmap --description 'Complete setxkb options' --argument-names what\0A    sed -e \221,/! $what/d\22 -e '/^[[:space:]]*$/,$d' /usr/share/X11/xkb/rules/xorg.lst | sed -r 's/[[:space:]]+([^[:space:]]+)[[:space:]]+(.+)/\\1\\t\\2/'\0Aend\0A\0Aset -l filter '\22s/[^[:space:]]+[[:space:]][^[:space:]]+[[:space:]](.+)\\((.+)\\)/\\1\\t\\2/;\22'\0A\0Acomplete -c setxkbmap -o '?' -o help -d 'Print this message'\0Acomplete -c setxkbmap -o compat -d 'Specifies compatibility map component name' -xa \22(sed -r $filter /usr/share/X11/xkb/compat.dir)\22\0Acomplete -c setxkbmap -o config -d 'Specifies configuration file to use' -r\0Acomplete -c setxkbmap -o device -d 'Specifies the device ID to use' -x\0Acomplete -c setxkbmap -o display -d 'Specifies display to use' -x\0Acomplete -c setxkbmap -o geometry -d 'Specifies geometry component name' -xa \22(sed -r $filter /usr/share/X11/xkb/geometry.dir)\22\0Acomplete -c setxkbmap -o I -d 'Add <dir> to list of directories to be used' -xa '(__fish_complete_directories)'\0Acomplete -c setxkbmap -o keycodes -d 'Specifies keycodes component name' -xa \22(sed -r $filter /usr/share/X11/xkb/keycodes.dir)\22\0Acomplete -c setxkbmap -o keymap -d 'Specifies name of keymap to load' -xa \22(sed -r $filter /usr/share/X11/xkb/keymap.dir)\22\0Acomplete -c setxkbmap -o layout -d 'Specifies layout used to choose component names' -xa \22(__fish_complete_setxkbmap layout)\22\0Acomplete -c setxkbmap -o model -d 'Specifies model used to choose component names' -xa \22(__fish_complete_setxkbmap model)\22\0Acomplete -c setxkbmap -o option -d 'Adds an option used to choose component names' -xa \22(__fish_complete_list , '__fish_complete_setxkbmap option')\22\0Acomplete -c setxkbmap -o print -d 'Print a complete xkb_keymap description and exit'\0Acomplete -c setxkbmap -o query -d 'Print the current layout settings and exit'\0Acomplete -c setxkbmap -