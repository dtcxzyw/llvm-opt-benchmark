@anon.1d0b41a8d45d477c3029ec78f9b8b434.3002 = private unnamed_addr constant [7314 x i8] c"# Completions for yadm v2\0A\0A# Print an optspec for argparse to handle yadm's options\0A# that are independent of any subcommand. Borrowed from git completion file.\0Afunction __fish_yadm_global_optspecs\0A    string join \\n v-version h/help C= c=+ 'e-exec-path=?' H-html-path M-man-path I-info-path p/paginate \\\0A        P/no-pager o-no-replace-objects b-bare G-git-dir= W-work-tree= N-namespace= S-super-prefix= \\\0A        l-literal-pathspecs g-glob-pathspecs O-noglob-pathspecs i-icase-pathspecs \\\0A        Y/yadm-dir= R-yadm-repo= n-yadm-config= E-yadm-encrypt= a-yadm-archive= B-yadm-bootstrap=\0Aend\0A\0A# Config values accepted by `yadm config`\0A# See `yadm gitconfig` for setting git config values\0Afunction __fish_yadm_config_keys\0A    yadm introspect configs\0Aend\0A\0Aset -l __fish_yadm_subcommands (yadm introspect commands)\0A\0A# Borrowed from git completion file\0Afunction __fish_yadm_needs_command\0A    # Figure out if the current invocation already has a command.\0A    set -l cmd (commandline -xpc)\0A    set -e cmd[1]\0A    argparse -s (__fish_yadm_global_optspecs) -- $cmd 2>/dev/null\0A    or return 0\0A    # These flags function as commands, effectively.\0A    set -q _flag_version; and return 1\0A    set -q _flag_html_path; and return 1\0A    set -q _flag_man_path; and return 1\0A    set -q _flag_info_path; and return 1\0A    if set -q argv[1]\0A        # Also print the command, so this can be used to figure out what it is.\0A        echo $argv[1]\0A        return 1\0A    end\0A    return 0\0Aend\0A\0A# Borrowed from git completion file\0Afunction __fish_yadm_using_command\0A    set -l cmd (__fish_yadm_needs_command)\0A    test -z \22$cmd\22\0A    and return 1\0A    contains -- $cmd $argv\0A    and return 0\0A    return 1\0Aend\0A\0A# Manual wrapping (instead of `complete -w`) is necessary here because we\0A# don't want to inherit all completions from git\0Afunction __fish_complete_yadm_like_git\0A    # Remove the first word from the commandline because that is \22yadm\22\0A    set -l cmdline (commandline -xpc | string escape; commandline -ct)[2..-1]\0A\0A    # `yadm gitconfig` is same as `git config`\0A    if __fish_seen_subcommand_from gitconfig\0A        set cmdline (string replace 'gitconfig' 'config' \22$cmdline\22)\0A    end\0A\0A    set -l yadm_work_tree (yadm gitconfig --get core.worktree)\0A    set -l yadm_repo (yadm introspect repo)\0A\0A    argparse -i 'R-yadm-repo=' -- $cmdline 2>/dev/null\0A    if set -q _flag_yadm_repo\0A        set yadm_repo $_flag_yadm_repo\0A        # argparse *always* sets $argv to remaining arguments after consuming specified options\0A        set cmdline $argv\0A    end\0A\0A    set -l git_wrapper_cmd \22git --work-tree $yadm_work_tree --git-dir $yadm_repo $cmdline\22\0A\0A    # `complete -a` expects each completion to be separated by space, not newline\0A    complete -C \22$git_wrapper_cmd\22\0Aend\0A\0A# General git wrapping\0Acomplete -f -c yadm -n \22not __fish_seen_subcommand_from $__fish_yadm_subcommands\22 -a '(__fish_complete_yadm_like_git)'\0A\0A# Global options\0Acomplete -F -r -c yadm -l yadm-dir -s Y -a '(__fish_complete_directories)' -d 'Override the yadm directory'\0Acomplete -F -r -c yadm -l yadm-repo -d 'Override location of yadm repository'\0Acomplete -F -r -c yadm -l yadm-config -d 'Override location of yadm configuration file'\0Acomplete -F -r -c yadm -l yadm-encrypt -d 'Override location of yadm encryption configuration'\0Acomplete -F -r -c yadm -l yadm-archive -d 'Override location of yadm encrypted files archive'\0Acomplete -F -r -c yadm -l yadm-bootstrap -d 'Override location of yadm bootstrap program'\0A\0A# Subcommands\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a version -d 'Print yadm version'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a init -d 'Initialize new repository for tracking dotfiles'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a config -d 'Manage configuration for yadm'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a list -d 'Print list of files managed by yadm'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a bootstrap -d 'Execute bootstrap script'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a encrypt -d 'Encrypt files matched by encrypt spec file'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a decrypt -d 'Decrypt files matched by encrypt spec file'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a alt -d 'Setup and process alternate files'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a perms -d 'Update permissions'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a enter -d 'Run sub-shell with all git variables set'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a git-crypt -d 'Pass options to git-crypt if installed'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a gitconfig -d 'Pass options to the git config command'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a upgrade -d 'Migrate from v1 to v2'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a introspect -d 'Report internal yadm data'\0Acomplete -f -c yadm -n __fish_yadm_needs_command -a clone -d 'Clone remote repository for tracking dotfiles'\0A\0A# Options for subcommands\0Acomplete -f -c yadm -n \22__fish_yadm_using_command init\22 -s f -d 'Overwrite existing repository'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command init\22 -s w -r -a '(__fish_complete_directories)' -d 'Override work-tree'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command clone\22 -s f -d 'Overwrite existing repository'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command clone\22 -s w -r -a '(__fish_complete_directories)' -d 'Override work-tree'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command clone\22 -s b -d 'Use another branch'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command clone\22 -l bootstrap -d 'Force run the bootstrap script'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command clone\22 -l no-bootstrap -d 'Do not execute bootstrap script'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command list\22 -s a -d 'List all files'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command decrypt\22 -s l -d 'List files without extracting'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command introspect\22 -x -a 'commands configs repo switches'\0A\0A# These inherit some options from git\0Acomplete -f -c yadm -n \22__fish_yadm_using_command gitconfig\22 -a '(__fish_complete_yadm_like_git)'\0A\0A# Some options for `yadm config` takes configuration keys as arguments, and these should have\0A# yadm's config keys instead of git's. Inherit all other options.\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config; and not __fish_seen_argument -l get -l get-all -l replace-all -l unset -l unset-all\22 -a '(__fish_complete_yadm_like_git)'\0A\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config\22 -l get -r -a '(__fish_yadm_config_keys)' -d 'Get config with name'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config\22 -l get-all -a '(__fish_yadm_config_keys)' -d 'Get all values matching key'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config\22 -l replace-all -r -a '(__fish_yadm_config_keys)' -d 'Replace all matching variables'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config\22 -l unset -a '(__fish_yadm_config_keys)' -d 'Remove a variable'\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config\22 -l unset-all -a '(__fish_yadm_config_keys)' -d 'Remove matching variables'\0A\0A# If no argument is specified for `config`, it's as if --get was used\0Acomplete -f -c yadm -n \22__fish_yadm_using_command config; and __fish_is_nth_token 3\22 -a '(__fish_yadm_config_keys)'\0A", align 1
