@anon.1d0b41a8d45d477c3029ec78f9b8b434.2688 = private unnamed_addr constant [6730 x i8] c"function __fish_systemd_units\0A    systemctl list-unit-files --full --no-legend --no-pager --plain 2>/dev/null | string split -f 1 ' '\0A    systemctl list-units --state=loaded --full --no-legend --no-pager --plain 2>/dev/null | string split -f 1 ' '\0Aend\0A\0A# global options\0A\0Acomplete -c systemd-analyze -f\0Acomplete -c systemd-analyze -l system -d 'Operates on the system systemd instance' -n \22not __fish_contains_opt system user global\22\0Acomplete -c systemd-analyze -l user -d 'Operates on the user systemd instance' -n \22not __fish_contains_opt system user global\22\0Acomplete -c systemd-analyze -l global -d 'Operates on the system-wide configuration for user systemd instance' -n \22not __fish_contains_opt system user global\22\0Acomplete -c systemd-analyze -l order -d 'dot: show only After and Before dependencies' -n \22not __fish_contains_opt order require\22\0Acomplete -c systemd-analyze -l require -d 'dot: show only Requires, Requisite, Wants and Conflicts dependencies' -n \22not __fish_contains_opt order require\22\0Acomplete -c systemd-analyze -l from-pattern -d 'dot: show relationships matching left-hand nodes pattern'\0Acomplete -c systemd-analyze -l to-pattern -d 'dot: show relationships matching right-hand nodes pattern'\0Acomplete -c systemd-analyze -l fuzz -x -d 'critical-chain: also show units which finished timespan earlier than last unit in same level'\0Acomplete -c systemd-analyze -l man -xa no -d 'Do not invoke man to verify the existence of man pages'\0Acomplete -c systemd-analyze -l generators -d 'Invoke unit generators'\0Acomplete -c systemd-analyze -l instance -r -d 'Fallback instance name for template units'\0Acomplete -c systemd-analyze -l root -xa \22(__fish_complete_directories)\22 -d 'With cat-files, show config files underneath the specified root path'\0Acomplete -c systemd-analyze -l image -r -d 'With cat-files, show config files inside 