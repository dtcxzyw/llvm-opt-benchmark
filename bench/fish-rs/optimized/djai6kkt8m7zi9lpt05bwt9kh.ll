%s\\t$desc\\n\22 $domains\0Aend\0A\0Afunction __fish_virsh_get_networks\0A    # Example of `virsh net-list --all` output:\0A    #\0A    #  Name                 State      Autostart     Persistent\0A    # ----------------------------------------------------------\0A    #  default              active     yes           yes\0A    #  mynet                active     yes           yes\0A    #\0A\0A    set -l header 'Name State Autostart Persistent'\0A    set -l networks (virsh net-list --all | string replace -ar '[ \\t]+' ' ' | string trim | string match -rv -- ---)\0A\0A    if not string match -q -- $header $networks[1]\0A        return 1\0A    end\0A\0A    set -l networks (string match -v -- $header $networks | string match -rv '^$')\0A    for network in $networks\0A        set -l network (string split ' ' $network)\0A        set -l network_name $network[1]\0A        set -l network_state $network[2]\0A        set -l network_autostart $network[3]\0A        set -l network_persistent $network[4]\0A\0A        set -l network_qualities $network_state (test $network_autostart = 'yes'; and echo 'autostart') (test $network_persistent = 'yes'; and echo 'persistent')\0A        set -l show true\0A        if set -q argv[1]\0A            for filter in $argv\0A                if not string match -q -- $filter $network_qualities\0A                    set show false\0A                    continue\0A                end\0A            end\0A        end\0A\0A        if not test $show = true\0A            continue\0A        end\0A\0A        printf '%s\\tNetwork (%s)\\n' $network_name (string join ' ' $network_qualities)\0A    end\0Aend\0A\0A# virsh\0Acomplete -c virsh -n \22not __fish_seen_subcommand_from $cmds\22 -x\0Acomplete -c virsh -n \22not __fish_seen_subcommand_from $cmds\22 -l connect -s -x -d \22Specify hypervisor connection URI\22\0Acomplete -c virsh -n \22not __fish_seen_subcommand_from $cmds\22 -l debug -s d -x -a \220\\t 1\\t 2\\t 3\\t 4\\t\22 -d \22Specify debug level (0-4)\22\