@anon.1d0b41a8d45d477c3029ec78f9b8b434.1222 = private unnamed_addr constant [2352 x i8] c"function __fish_bind_test1\0A    set -l args\0A    set -l use_keys no\0A    for i in (commandline -pxc)\0A        switch $i\0A            case -k --k --ke --key\0A                set use_keys yes\0A\0A            case \22-*\22\0A\0A            case \22*\22\0A                set -a args $i\0A        end\0A    end\0A\0A    switch $use_keys\0A        case yes\0A            switch (count $args)\0A                case 1\0A                    return 0\0A            end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_bind_test2\0A    set -l args\0A    for i in (commandline -pxc)\0A        switch $i\0A            case \22-*\22\0A\0A            case \22*\22\0A                set -a args $i\0A        end\0A    end\0A\0A    switch (count $args)\0A        case 2\0A            return 0\0A    end\0A\0A    return 1\0A\0Aend\0A\0Acomplete -c bind -f\0Acomplete -c bind -s a -l all -d 'Show unavailable key bindings/erase all bindings'\0Acomplete -c bind -s e -l erase -d 'Erase mode'\0Acomplete -c bind -s f -l function-names -d 'Print names of available functions'\0Acomplete -c bind -s h -l help -d \22Display help and exit\22\0Acomplete -c bind -s k -l key -d 'Specify key name, not sequence'\0Acomplete -c bind -s K -l key-names -d 'Print names of available keys'\0Acomplete -c bind -s M -l mode -d 'Specify the bind mode that the bind is used in' -xa '(bind -L)'\0Acomplete -c bind -s m -l sets-mode -d 'Change current mode after bind is executed' -xa '(bind -L)'\0Acomplete -c bind -s L -l list-modes -d 'Display a list of defined bind modes'\0Acomplete -c bind -s s -l silent -d 'Operate silently'\0Acomplete -c bind -l preset -d 'Operate on preset bindings'\0Acomplete -c bind -l user -d 'Operate on user bindings'\0A\0Acomplete -c bind -n __fish_bind_test2 -a '(bind --function-names)' -d 'Function name' -x\0A\0Afunction __fish_bind_complete\0A    argparse M/mode= m/sets-mode= preset user s/silent \\\0A        a/all function-names list-modes e/erase -- (commandline -xpc)[2..] 2>/dev/null\0A    or return 1\0A    set -l token (commandline -ct)\0A    if test (count $argv) = 0 && set -l prefix (string match -r -- '(.*,)?(ctrl-|alt-|shift-|super-)*' $token)\0A        printf '%salt-\\tAlt modifier\E2\80\A6\\n' $prefix\0A        printf '%sctrl-\\tCtrl modifier\E2\80\A6\\n' $prefix\0A        printf '%sshift-\\tShift modifier\E2\80\A6\\n' $prefix\0A        printf '%ssuper-\\tSuper modifier\E2\80\A6\\n' $prefix\0A        printf '%s\\tNamed key\\n' $prefix(bind --key-names)\0A    end\0Aend\0Acomplete -c bind -k -a '(__fish_bind_complete)' -f\0A", align 1
