@anon.1d0b41a8d45d477c3029ec78f9b8b434.1186 = private unnamed_addr constant [1315 x i8] c"function __attrib_complete_args -d 'Function to generate args'\0A    set -l current_token (commandline -tc)\0A\0A    switch $current_token\0A        case '+*'\0A            echo -e 'r\\tSet the Read-only file attribute\0Aa\\tSet the Archive file attribute\0As\\tSet the System file attribute\0Ah\\tSet the Hidden file attribute\0Ai\\tSet the Not Content Indexed file attribute' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A        case '-*'\0A            echo -e 'r\\tClear the Read-only file attribute\0Aa\\tClear the Archive file attribute\0As\\tClear the System file attribute\0Ah\\tClear the Hidden file attribute\0Ai\\tClear the Not Content Indexed file attribute' | awk -F '\\t' \22{ printf \\\22$current_token%s\\t%s\\n\\\22, \\$1, \\$2 }\22\0A    end\0Aend\0A\0Acomplete -c attrib -f -a '(__attrib_complete_args)'\0A\0Acomplete -c attrib -f -n '__fish_seen_argument -w s' -a d \\\0A    -d 'Apply attrib and any command-line options to directories'\0Acomplete -c attrib -f -n '__fish_seen_argument -w s' -a l \\\0A    -d 'Apply attrib and any command-line options to the Symbolic Link'\0A\0Acomplete -c attrib -f -a + -d 'Set the file attribute'\0Acomplete -c attrib -f -a - -d 'Clear the file attribute'\0Acomplete -c attrib -f -a /s \\\0A    -d 'Apply to matching files in the current directory and all of its subdirectories'\0Acomplete -c attrib -f -a '/?' -d 'Show help'\0A", align 1
