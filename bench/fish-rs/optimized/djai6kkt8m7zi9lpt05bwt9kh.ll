@anon.1d0b41a8d45d477c3029ec78f9b8b434.3579 = private unnamed_addr constant [6197 x i8] c"# name: Scales\0A# author: Leonard Hecker <leonard@hecker.io>\0A\0A# Sources:\0A# - General theme setup: https://github.com/sorin-ionescu/prezto/blob/d275f316ffdd0bbd075afbff677c3e00791fba16/modules/prompt/functions/prompt_sorin_setup\0A# - Extraction of git info: https://github.com/sorin-ionescu/prezto/blob/d275f316ffdd0bbd075afbff677c3e00791fba16/modules/git/functions/git-info#L180-L441\0A\0Afunction fish_prompt\0A    if test -n \22$SSH_TTY\22\0A        echo -n (set_color brred)\22$USER\22(set_color white)'@'(set_color yellow)(prompt_hostname)' '\0A    end\0A\0A    echo -n (set_color blue)(prompt_pwd)' '\0A\0A    set_color -o\0A    if fish_is_root_user\0A        echo -n (set_color red)'# '\0A    end\0A    echo -n (set_color red)'\E2\9D\AF'(set_color yellow)'\E2\9D\AF'(set_color green)'\E2\9D\AF '\0A    set_color normal\0Aend\0A\0A# And now define the right prompt so that it's brought along\0Afunction fish_right_prompt\0A    set -l cmd_status $status\0A    if test $cmd_status -ne 0\0A        echo -n (set_color red)\22\E2\9C\98 $cmd_status\22\0A    end\0A\0A    if not command -sq git\0A        set_color normal\0A        return\0A    end\0A\0A    # Get the git directory for later use.\0A    # Return if not inside a Git repository work tree.\0A    if not set -l git_dir (command git rev-parse --git-dir 2>/dev/null)\0A        set_color normal\0A        return\0A    end\0A\0A    # Get the current action (\22merge\22, \22rebase\22, etc.)\0A    # and if there's one get the current commit hash too.\0A    set -l commit ''\0A    if set -l action (fish_print_git_action \22$git_dir\22)\0A        set commit (command git rev-parse HEAD 2> /dev/null | string sub -l 7)\0A    end\0A\0A    # Get either the branch name or a branch descriptor.\0A    set -l branch_detached 0\0A    if not set -l branch (command git symbolic-ref --short HEAD 2>/dev/null)\0A        set branch_detached 1\0A        set branch (command git describe --contains --all HEAD 2>/dev/null)\0A    end\0A\0A    # Get the commit difference counts between local and remote.\0A    command git rev-list --count --left-right 'HEAD...@{upstream}' 2>/dev/null \\\0A        | read -d \\t -l status_ahead status_behind\0A    if test $status -ne 0\0A        set status_ahead 0\0A        set status_behind 0\0A    end\0A\0A    # Get the stash status.\0A    # (git stash list) is very slow. => Avoid using it.\0A    set -l status_stashed 0\0A    if test -f \22$git_dir/refs/stash\22\0A        set status_stashed 1\0A    else if test -r \22$git_dir/commondir\22\0A        read -l commondir <\22$git_dir/commondir\22\0A        if test -f \22$commondir/refs/stash\22\0A            set status_stashed 1\0A        end\0A    end\0A\0A    # git-status' porcelain v1 format starts with 2 letters on each line:\0A    #   The first letter (X) denotes the index state.\0A    #   The second letter (Y) denotes the working directory state.\0A    #\0A    # The following table presents the possible combinations:\0A    # * The underscore character denotes whitespace.\0A    # * The cell values stand for the following file states:\0A    #   a: added\0A    #   d: deleted\0A    #   m: modified\0A    #   r: renamed\0A    #   u: unmerged\0A    #   t: untracked\0A    # * Cells with more than one letter signify that both states\0A    #   are simultaneously the case. This is possible since the git index\0A    #   and working directory operate independently of each other.\0A    # * Cells which are empty are unhandled by this code.\0A    # * T (= type change) is undocumented.\0A    #   See Git v1.7.8.2 release notes for more information.\0A    #\0A    #   \\ Y\E2\86\92\0A    #  X \\\0A    #  \E2\86\93  | A  | C  | D  | M  | R  | T  | U  | X  | B  | ?  | _\0A    # ----+----+----+----+----+----+----+----+----+----+----+----\0A    #  A  | u  |    | ad | am | r  | am | u  |    |    |    | a\0A    #  C  |    |    | ad | am | r  | am | u  |    |    |    | a\0A    #  D  |    |    | u  | am | r  | am | u  |    |    |    | a\0A    #  M  |    |    | ad | am | r  | am | u  |    |    |    | a\0A    #  R  | r  | r  | rd | rm | r  | rm | ur | r  | r  | r  | r\0A    #  T  |    |    | ad | am | r  | am | u  |    |    |    | a\0A    #  U  | u  | u  | u  | um | ur | um | u  | u  | u  | u  | u\0A    #  X  |    |    |    | m  | r  | m  | u  |    |    |    |\0A    #  B  |    |    |    | m  | r  | m  | u  |    |    |    |\0A    #  ?  |    |    |    | m  | r  | m  | u  |    |    | t  |\0A    #  _  |    |    | d  | m  | r  | m  | u  |    |    |    |\0A    set -l porcelain_status (command git status --porcelain 2>/dev/null | string sub -l2)\0A\0A    set -l status_added 0\0A    if string match -qr '[ACDMT][ MT]|[ACMT]D' $porcelain_status\0A        set status_added 1\0A    end\0A    set -l status_deleted 0\0A    if string match -qr '[ ACMRT]D' $porcelain_status\0A        set status_deleted 1\0A    end\0A    set -l status_modified 0\0A    if string match -qr '[MT]$' $porcelain_status\0A        set status_modified 1\0A    end\0A    set -l status_renamed 0\0A    if string match -qe R $porcelain_status\0A        set status_renamed 1\0A    end\0A    set -l status_unmerged 0\0A    if string match -qr 'AA|DD|U' $porcelain_status\0A        set status_unmerged 1\0A    end\0A    set -l status_untracked 0\0A    if string match -qe '\\?\\?' $porcelain_status\0A        set status_untracked 1\0A    end\0A\0A    set_color -o\0A\0A    if test -n \22$branch\22\0A        if test $branch_detached -ne 0\0A            set_color brmagenta\0A        else\0A            set_color green\0A        end\0A        echo -n \22 $branch\22\0A    end\0A    if test -n \22$commit\22\0A        echo -n ' '(set_color yellow)\22$commit\22\0A    end\0A    if test -n \22$action\22\0A        set_color normal\0A        echo -n (set_color white)':'(set_color -o brred)\22$action\22\0A    end\0A    if test $status_ahead -ne 0\0A        echo -n ' '(set_color brmagenta)'\E2\AC\86'\0A    end\0A    if test $status_behind -ne 0\0A        echo -n ' '(set_color brmagenta)'\E2\AC\87'\0A    end\0A    if test $status_stashed -ne 0\0A        echo -n ' '(set_color cyan)'\E2\9C\AD'\0A    end\0A    if test $status_added -ne 0\0A        echo -n ' '(set_color green)'\E2\9C\9A'\0A    end\0A    if test $status_deleted -ne 0\0A        echo -n ' '(set_color red)'\E2\9C\96'\0A    end\0A    if test $status_modified -ne 0\0A        echo -n ' '(set_color blue)'\E2\9C\B1'\0A    end\0A    if test $status_renamed -ne 0\0A        echo -n ' '(set_color magenta)'\E2\9E\9C'\0A    end\0A    if test $status_unmerged -ne 0\0A        echo -n ' '(set_color yellow)'\E2\95\90'\0A    end\0A    if test $status_untracked -ne 0\0A        echo -n ' '(set_color white)'\E2\97\BC'\0A    end\0A\0A    set_color normal\0Aend\0A", align 1
