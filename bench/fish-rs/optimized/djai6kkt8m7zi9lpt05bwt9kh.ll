@anon.1d0b41a8d45d477c3029ec78f9b8b434.3150 = private unnamed_addr constant [444 x i8] c"function __fish_complete_path --description \22Complete using path\22\0A    set -l target\0A    set -l description\0A    switch (count $argv)\0A        case 0\0A            # pass\0A        case 1\0A            set target \22$argv[1]\22\0A        case 2 \22*\22\0A            set target \22$argv[1]\22\0A            set description \22$argv[2]\22\0A    end\0A    set -l targets (complete -C\22'' $target\22)\0A    if set -q targets[1]\0A        printf \22%s\\n\22 $targets\\t\22$description\22\0A    end\0Aend\0A", align 1
