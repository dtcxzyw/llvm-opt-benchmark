@anon.1d0b41a8d45d477c3029ec78f9b8b434.3282 = private unnamed_addr constant [380 x i8] c"function __fish_print_encodings -d \22Complete using available character encodings\22\0A    if iconv --usage &>/dev/null # only GNU has this flag\0A        # Note: GNU iconv changes its output to contain the forward slashes below when stdout is not a tty.\0A        iconv --list | string replace -ra // ''\0A    else # non-GNU\0A        iconv --list | string replace -ra '\\s+' '\\n'\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3283 = private unnamed_addr constant [42 x i8] c"functions/__fish_print_eopkg_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3284 = private unnamed_addr constant [1370 x i8] c"function __fish_print_eopkg_packages\0A    type -q -f eopkg || return 1\0A\0A    argparse i/installed -- $argv\0A    or return 1\0A\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A\0A    # If the cache is less than max_age, we do not recalculate it\0A    # Determine whether to print installed/available packages\0A\0A    if set -q _flag_installed\0A        set -l cache_file $xdg_cache_home/eopkg-installed\0A        if test -f $cache_file\0A            cat $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 500\0A            if test $age -lt $max_age\0A                return 0\0A            end\0A        end\0A\0A        __fish_cache_put $cache_file\0A        # Remove package version information from output and pipe into cache file\0A        eopkg list-installed -N | cut -d ' ' -f 1 >$cache_file &\0A        return 0\0A    else\0A        set -l cache_file $xdg_cache_home/eopkg-available\0A        if test -f $cache_file\0A            cat $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 500\0A            if test $age -lt $max_age\0A                return 0\0A            end\0A        end\0A\0A        __fish_cache_put $cache_file\0A        # Remove package version information from output and pipe into cache file\0A        eopkg list-available -N | cut -d ' ' -f 1 >$cache_file &\0A        return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3285 = private unnamed_addr constant [39 x i8] c"functions/__fish_print_filesystems.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3286 = private unnamed_addr constant [571 x i8] c"function __fish_print_filesystems -d \22Print a list of all known filesystem types\22\0A    set -l fs adfs affs autofs btrfs coda coherent cramfs devpts efs ext ext2 ext3 ffs\0A    set -a fs hfs hpfs iso9660 jfs minix msdos ncpfs nfs ntfs proc qnx4 ramfs\0A    set -a fs reiserfs romfs smbfs sysv tmpfs udf ufs umsdos vfat xenix xfs xiafs\0A    # Mount has helper binaries to mount filesystems\0A    # These are called mount.* and are placed somewhere in $PATH\0A    set -l mountfs $PATH/mount.* $PATH/mount_*\0A    printf '%s\\n' $fs (string replace -ra '.*/mount[._]' '' -- $mountfs)\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3287 = private unnamed_addr constant [36 x i8] c"functions/__fish_print_gpg_algo.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3288 = private unnamed_addr constant [1096 x i8] c"# Helper function for contextual autocompletion of GPG crypto algorithm options\0A\0Afunction __fish_print_gpg_algo -d \22Complete using all algorithms of the type specified in argv[2] supported by gpg. argv[2] is a regexp\22 -a __fish_complete_gpg_command\0A    # Set a known locale, so that the output format of 'gpg --version'\0A    # is at least somewhat predictable. The locale will automatically\0A    # expire when the function goes out of scope, and the original locale\0A    # will take effect again.\0A    set -lx LC_ALL C\0A\0A    # sed script explained:\0A    # in the line that matches \22$argv:\22\0A    # \09define label 'loop'\0A    # \09if the line ends with a ','\0A    # \09\09add next line to buffer\0A    #\09\09transliterate '\\n' with ' '\0A    #\09\09goto loop\0A    # \09remove everything until the first ':' of the line\0A    # \09remove all blanks\0A    # \09transliterate ',' with '\\n' (OSX apparently doesn't like '\\n' on RHS of the s-command)\0A    # \09print result\0A    $__fish_complete_gpg_command --version | sed -ne \22/$argv[2]:/\22'{:loop\0A    /,$/{N; y!\\n! !\0A    b loop\0A    }\0A    s!^[^:]*:!!\0A    s![ ]*!!g\0A    y!,!\\n!\0A    p\0A    }'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3289 = private unnamed_addr constant [34 x i8] c"functions/__fish_print_groups.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3290 = private unnamed_addr constant [436 x i8] c"# This should be used where you want group names without a description. If you also want\0A# a description, such as when getting a list of groups for a completion, you probably want\0A# __fish_complete_groups.\0Afunction __fish_print_groups --description \22Print a list of local groups\22\0A    # Leave the heavy lifting to __fish_complete_groups but strip the descriptions.\0A    __fish_complete_groups | string replace -r '^([^\\t]*)\\t.*' '$1'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3291 = private unnamed_addr constant [32 x i8] c"functions/__fish_print_help.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3292 = private unnamed_addr constant [6071 x i8] c"function __fish_print_help --description \22Print help message for the specified fish function or builtin\22 --argument-names item error_message\0A    switch $item\0A        case !\0A            set item not\0A        case .\0A            set item source\0A        case :\0A            set item true\0A        case '['\0A            set item test\0A    end\0A\0A    # Do nothing if the file does not exist\0A    if not path is -- $__fish_data_dir/man/man1/$item.1 $__fish_data_dir/man/man1/$item.1.gz; and not status get-file man/man1/$item.1 >/dev/null\0A        return 2\0A    end\0A\0A    # Render help output, save output into the variable 'help'\0A    set -l help\0A    set -l format\0A    set -l cols\0A    if test -n \22$COLUMNS\22\0A        set cols (math $COLUMNS - 4) # leave a bit of space on the right\0A    end\0A\0A    # Pick which command we are using to render output or fail if none\0A    # We prefer mandoc because that doesn't break with unicode input.\0A    if command -qs mandoc\0A        set format mandoc -c\0A        if test -n \22$cols\22\0A            set -a format -O width=$cols\0A        end\0A    else if command -qs nroff\0A        set format nroff -c -man -t\0A        if path is -- $__fish_data_dir/groff/fish.tmac\0A            set -a format -M$__fish_data_dir/groff -mfish\0A        end\0A        if test -n \22$cols\22\0A            set -a format -rLL={$cols}n\0A        end\0A    else\0A        echo fish: (_ \22Cannot format help; no parser found\22) >&2\0A        return 1\0A    end\0A\0A    if path is -- $__fish_data_dir/man/man1/$item.1\0A        # Some nroff versions screw up non-ascii characters.\0A        # (even with the locale set correctly!)\0A        # Work around that by running preconv first.\0A        if command -sq preconv; and test \22$format[1]\22 = nroff\0A            set help (preconv -e UTF-8 \22$__fish_data_dir/man/man1/$item.1\22 | $format 2>/dev/null)\0A        else\0A            set help ($format \22$__fish_data_dir/man/man1/$item.1\22 2>/dev/null)\0A        end\0A    else if path is -- $__fish_data_dir/man/man1/$item.1.gz\0A        if command -sq preconv; and test \22$format[1]\22 = nroff\0A            set help (gunzip -c \22$__fish_data_dir/man/man1/$item.1.gz\22 2>/dev/null | preconv -e UTF-8 | $format 2>/dev/null)\0A        else\0A            set help (gunzip -c \22$__fish_data_dir/man/man1/$item.1.gz\22 2>/dev/null | $format 2>/dev/null)\0A        end\0A    else\0A        set help (status get-file man/man1/$item.1 | $format 2>/dev/null)\0A    end\0A\0A    # The original implementation trimmed off the top 5 lines and bottom 3 lines\0A    # from the nroff output. Perhaps that's reliable, but the magic numbers make\0A    # me extremely nervous. Instead, let's just strip out any lines that start\0A    # in the first column. \22normal\22 manpages put all section headers in the first\0A    # column, but fish manpages only leave NAME like that, which we want to trim\0A    # away anyway.\0A    #\0A    # While we're at it, let's compress sequences of blank lines down to a single\0A    # blank line, to duplicate the default behavior of `man`, or more accurately,\0A    # the `-s` flag to `less` that `man` passes.\0A    set -l state blank\0A    set -l have_name\0A    begin\0A        string join \\n $error_message\0A        for line in $help\0A            # categorize the line\0A            set -l line_type\0A            switch $line\0A                case ' *' \\t\\*\0A                    # starts with whitespace, check if it has non-whitespace\0A                    printf \22%s\\n\22 $line | read -l word __\0A                    if test -n $word\0A                        set line_type normal\0A                    else\0A                        # lines with just spaces probably shouldn't happen\0A                        # but let's consider them to be blank\0A                        set line_type blank\0A                    end\0A                case ''\0A                    set line_type blank\0A                case '*'\0A                    # Remove man's bolding\0A                    set -l name (string replace -ra '(.)'\\b'.' '$1' -- $line)\0A                    # We start after we have the name\0A                    contains -- $name NAME; and set have_name 1\0A                    # Everything after COPYRIGHT is useless\0A                    contains -- $name COPYRIGHT; and break\0A\0A                    # not leading space, and not empty, so must contain a non-space\0A                    # in the first column. That makes it a header/footer.\0A                    set line_type meta\0A            end\0A\0A            set -q have_name[1]; or continue\0A            switch $state\0A                case normal\0A                    switch $line_type\0A                        case normal meta\0A                            printf \22%s\\n\22 $line\0A                        case blank\0A                            set state blank\0A                    end\0A                case blank\0A                    switch $line_type\0A                        case normal meta\0A                            echo # print the blank line\0A                            printf \22%s\\n\22 $line\0A                            set state normal\0A                        case blank meta\0A                            # skip it\0A                    end\0A            end\0A        end\0A    end | begin\0A        set -l pager (__fish_anypager --with-manpager)\0A        and isatty stdout\0A        or set pager cat # cannot use a builtin here\0A\0A        # similar to man, but add -F to quit paging when the help output is brief (#6227)\0A        # Also set -X for less < v530, see #8157.\0A        set -l lessopts isRF\0A        if type -q less; and test (less --version | string match -r 'less (\\d+)')[2] -lt 530 2>/dev/null\0A            set lessopts \22$lessopts\22X\0A        end\0A\0A        not set -qx LESS\0A        and set -xl LESS $lessopts\0A\0A        # less options:\0A        # -i (--ignore-case) search case-insensitively, like man\0A        # -s (--squeeze-blank-lines) not strictly necessary since we already do that above\0A        # -R (--RAW-CONTROL-CHARS) to display colors and such\0A        # -F (--quit-if-one-screen) to maintain the non-paging behavior for small outputs\0A        # -X (--no-init) do not clear the screen, necessary for less < v530 or else short output is dropped\0A        $pager\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3293 = private unnamed_addr constant [37 x i8] c"functions/__fish_print_hostnames.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3294 = private unnamed_addr constant [6320 x i8] c"function __fish_print_hostnames -d \22Print a list of known hostnames\22\0A    # This function used to primarily query `getent hosts` and only read from `/etc/hosts` if\0A    # `getent` did not exist or `getent hosts` failed, based off the (documented) assumption that\0A    # the former *might* return more hosts than the latter, which has never been officially noted\0A    # to be the case. As `getent` is several times slower, involves shelling out, and is not\0A    # available on some platforms (Cygwin and at least some versions of macOS, such as 10.10), that\0A    # order is now reversed and `getent hosts` is only used if the hosts file is not found at\0A    # `/etc/hosts` for portability reasons.\0A\0A    begin\0A        test -r /etc/hosts && read -z </etc/hosts | string replace -r '#.*$' ''\0A        or type -q getent && getent hosts 2>/dev/null\0A    end |\0A        # Ignore own IP addresses (127.*, 0.0[.0[.0]], ::1), non-host IPs (fe00::*, ff00::*),\0A        # and leading/trailing whitespace. Split results on whitespace to handle multiple aliases for\0A        # one IP.\0A        string replace -irf '^\\s*?(?!(?:0\\.|127\\.|ff0|fe0|::1))\\S+\\s*(.*?)\\s*$' '$1' |\0A        string split ' '\0A\0A    # Print nfs servers from /etc/fstab\0A    if test -r /etc/fstab\0A        string match -r '^\\s*[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:|^[a-zA-Z\\.]*:' </etc/fstab |\0A            string replace -r ':.*' ''\0A    end\0A\0A    # Check hosts known to ssh.\0A    # Yes, seriously - the default specifies both with and without \222\22.\0A    # Termux puts these in the android data directory if not rooted.\0A    # The directory is available as $PREFIX/etc, but that variable name is so generic that\0A    # it would cause false-positives.\0A    # Also, some people might use /usr/local/etc.\0A    set -l known_hosts ~/.ssh/known_hosts{,2} \\\0A        {/data/data/com.termux/files/usr,/usr/local,}/etc/ssh/{,ssh_}known_hosts{,2}\0A    # Check default ssh configs.\0A    set -l ssh_config ~/.ssh/config\0A\0A    # Inherit settings and parameters from `ssh` aliases, if any\0A    if functions -q ssh\0A        # Get alias and commandline options.\0A        set -l ssh_func_tokens (functions ssh | string match '*command ssh *' | string split ' ')\0A        set -l ssh_command $ssh_func_tokens (commandline -cpx)\0A        # Extract ssh config path from last -F short option.\0A        if contains -- -F $ssh_command\0A            set -l ssh_config_path_is_next 1\0A            for token in $ssh_command\0A                if contains -- -F $token\0A                    set ssh_config_path_is_next 0\0A                else if test $ssh_config_path_is_next -eq 0\0A                    set ssh_config (eval \22echo $token\22)\0A                    set ssh_config_path_is_next 1\0A                end\0A            end\0A        end\0A    end\0A\0A    # Extract ssh config paths from Include option\0A    function _ssh_include --argument-names ssh_config\0A        # Relative paths in Include directive use /etc/ssh or ~/.ssh depending on\0A        # system or user level config. -F will not override this behaviour\0A        set -l relative_path $HOME/.ssh\0A        if string match '/etc/ssh/*' -- $ssh_config\0A            set relative_path /etc/ssh\0A        end\0A\0A        function _recursive --no-scope-shadowing\0A            set -l paths\0A            for config in $argv\0A                if test -r \22$config\22 -a -f \22$config\22\0A                    set paths $paths (\0A                    # Keep only Include lines and remove Include syntax\0A                    string replace -rfi '^\\s*Include\\s+' '' <$config \\\0A                    # Normalize whitespace\0A                    | string trim | string replace -r -a '\\s+' ' ')\0A                end\0A            end\0A\0A            set -l new_paths\0A            for path in $paths\0A                set -l expanded_path\0A                # Scope \22relative\22 paths in accordance to ssh path resolution\0A                if string match -qrv '^[~/]' $path\0A                    set path $relative_path/$path\0A                end\0A                # Use `eval` to expand paths (eg ~/.ssh/../test/* to /home/<user>/test/file1 /home/<user>/test/file2),\0A                # and `set` will prevent \22No matches for wildcard\22 messages\0A                eval set expanded_path $path\0A                for path in $expanded_path\0A                    # Skip unusable paths.\0A                    test -r \22$path\22 -a -f \22$path\22\0A                    or continue\0A                    echo $path\0A                    set new_paths $new_paths $path\0A                end\0A            end\0A\0A            if test -n \22$new_paths\22\0A                _recursive $new_paths\0A            end\0A        end\0A        _recursive $ssh_config\0A    end\0A    set -l ssh_configs /etc/ssh/ssh_config (_ssh_include /etc/ssh/ssh_config) $ssh_config (_ssh_include $ssh_config)\0A\0A    for file in $ssh_configs\0A        if test -r $file\0A            # Don't read from $file twice. We could use `while read` instead, but that is extremely\0A            # slow.\0A            read -alz -d \\n contents <$file\0A\0A            # Print hosts from system wide ssh configuration file\0A            # Multiple names for a single host can be given separated by spaces, so just split it explicitly (#6698).\0A            string replace -rfi '^\\s*Host\\s+(\\S.*?)\\s*$' '$1' -- $contents | string split \22 \22 | string match -rv '[\\*\\?]'\0A            # Also extract known_host paths.\0A            set known_hosts $known_hosts (string replace -rfi '.*KnownHostsFile\\s*' '' -- $contents | string split \22 \22)\0A        end\0A    end\0A\0A    # Read all files and operate on their combined content\0A    for file in $known_hosts\0A        if test -r $file\0A            read -z <$file\0A        end\0A    end |\0A        # Ignore hosts that are hashed, commented or @-marked and strip the key\0A        # Handle multiple comma-separated hostnames sharing a key, too.\0A        #\0A        # This one regex does everything we need, finding all matches including comma-separated\0A        # values, but fish does not let us print only a capturing group without the entire match,\0A        # and we can't use `string replace` instead (because CSV then fails).\0A        # string match -ar \22(?:^|,)(?![@|*!])\\[?([^ ,:\\]]+)\\]?\22\0A        #\0A        # Instead, manually piece together the regular expressions\0A        string match -v -r '^\\s*[!*|@#]' | string replace -rf '^\\s*(\\S+) .*' '$1' |\0A        string split ',' | string replace -r '\\[?([^\\]]+).*' '$1'\0A\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3295 = private unnamed_addr constant [38 x i8] c"functions/__fish_print_interfaces.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3296 = private unnamed_addr constant [440 x i8] c"function __fish_print_interfaces --description \22Print a list of known network interfaces\22\0A    if test -d /sys/class/net\0A        path basename /sys/class/net/*\0A    else # OSX/BSD\0A        set -l os (uname)\0A        if string match -e -q BSD -- $os\0A            command ifconfig | string match -e -r '^[a-z]' | string replace -r ':.*' '' | string split ' '\0A        else\0A            command ifconfig -l | string split ' '\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3297 = private unnamed_addr constant [39 x i8] c"functions/__fish_print_lpr_options.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3298 = private unnamed_addr constant [138 x i8] c"function __fish_print_lpr_options --description 'Print lpr options'\0A    lpoptions -l 2>/dev/null | sed 's+\\(.*\\)/\\(.*\\):.*$+\\1\\t\\2+'\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3299 = private unnamed_addr constant [40 x i8] c"functions/__fish_print_lpr_printers.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3300 = private unnamed_addr constant [142 x i8] c"function __fish_print_lpr_printers --description 'Print lpr printers'\0A    lpstat -p 2>/dev/null | sed 's/^\\S*\\s\\(\\S*\\)\\s\\(.*\\)$/\\1\\t\\2/'\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3301 = private unnamed_addr constant [35 x i8] c"functions/__fish_print_modules.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3302 = private unnamed_addr constant [206 x i8] c"# Helper function for completions that need to enumerate Linux modules\0Afunction __fish_print_modules\0A    find /lib/modules/(uname -r)/{kernel,misc} -type f 2>/dev/null | sed -e 's$/.*/\\([^/.]*\\).*$\\1$'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3303 = private unnamed_addr constant [35 x i8] c"functions/__fish_print_mounted.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3304 = private unnamed_addr constant [743 x i8] c"function __fish_print_mounted --description 'Print mounted devices'\0A    if test -r /etc/mtab\0A        # In mtab, spaces are replaced by a literal '\\040'\0A        # So it's safe to get the second \22field\22 and then replace it\0A        # \\011 encodes a tab, \\012 encodes a newline and \\\\ encodes a backslash\0A        # This will probably break on newlines because of our splitting, though\0A        # and tabs because of descriptions\0A        string replace -r '\\S+ (\\S+) .*' '$1' </etc/mtab | string replace -a \22\\040\22 \22 \22 | string replace -a \22\\011\22 \\t | string replace -a \22\\012\22 \\n | string replace -a \22\\\\\\\\\22 \22\\\\\22\0A    else\0A        mount | string replace -r '^(\\S+) \\S+ (\\S+) .*' '$1\\n$2' | string replace -r '[\\d.]*:/' / | string match '/*'\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3305 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_opkg_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3306 = private unnamed_addr constant [393 x i8] c"function __fish_print_opkg_packages\0A    type -q -f opkg || return 1\0A\0A    argparse i/installed -- $argv\0A    or return 1\0A\0A    if set -q _flag_installed\0A        opkg list-installed 2>/dev/null | sed -r 's/^([a-zA-Z0-9\\-]+) - ([a-zA-Z0-9\\-]+)/\\1\\t\\2/g'\0A        return 0\0A    else\0A        opkg list 2>/dev/null | sed -r 's/^([a-zA-Z0-9\\-]+) - ([a-zA-Z0-9\\-]+)/\\1\\t\\2/g'\0A        return 0\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3307 = private unnamed_addr constant [36 x i8] c"functions/__fish_print_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3308 = private unnamed_addr constant [732 x i8] c"function __fish_print_packages\0A    # This is `__fish_print_packages`. It prints packages,\0A    # from the first package manager it finds.\0A    # That's a pretty bad idea, which is why this is broken up,\0A    # and only available for legacy reasons.\0A    __fish_print_apt_packages $argv\0A    and return\0A\0A    __fish_print_pkg_packages $argv\0A    and return\0A\0A    __fish_print_pkg_add_packages $argv\0A    and return\0A\0A    __fish_print_pacman_packages $argv\0A    and return\0A\0A    __fish_print_rpm_packages $argv\0A    and return\0A\0A    __fish_print_eopkg_packages $argv\0A    and return\0A\0A    __fish_print_portage_packages $argv\0A    and return\0A\0A    __fish_print_port_packages $argv\0A    and return\0A\0A    __fish_print_xbps_packages $argv\0A    and return\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3309 = private unnamed_addr constant [43 x i8] c"functions/__fish_print_pacman_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3310 = private unnamed_addr constant [770 x i8] c"function __fish_print_pacman_packages\0A    # Caches for 5 minutes\0A    type -q -f pacman || return 1\0A\0A    argparse i/installed -- $argv\0A    or return 1\0A\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A\0A    if not set -q _flag_installed\0A        set -l cache_file $xdg_cache_home/pacman\0A        if test -f $cache_file\0A            cat $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 250\0A            if test $age -lt $max_age\0A                return\0A            end\0A        end\0A        __fish_cache_put $cache_file\0A        # prints: <package name>\09Package\0A        pacman -Ssq | sed -e 's/$/\\t'Package'/' >$cache_file &\0A        return 0\0A    else\0A        pacman -Q | string replace ' ' \\t\0A        return 0\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3311 = private unnamed_addr constant [40 x i8] c"functions/__fish_print_pacman_repos.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3312 = private unnamed_addr constant [237 x i8] c"function __fish_print_pacman_repos --description \22Print the repositories configured for arch's pacman package manager\22\0A    string match -er \22\\[.*\\]\22 </etc/pacman.conf | string match -r -v \22^#|options\22 | string replace -ra \22\\[|\\]\22 \22\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3313 = private unnamed_addr constant [38 x i8] c"functions/__fish_print_pipestatus.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3314 = private unnamed_addr constant [1362 x i8] c"function __fish_print_pipestatus --description \22Print pipestatus for prompt\22\0A    set -l last_status\0A    if set -q __fish_last_status\0A        set last_status $__fish_last_status\0A    else\0A        set last_status $argv[-1] # default to $pipestatus[-1]\0A    end\0A    set -l left_brace $argv[1]\0A    set -l right_brace $argv[2]\0A    set -l separator $argv[3]\0A    set -l brace_sep_color $argv[4]\0A    set -l status_color $argv[5]\0A\0A    set -e argv[1 2 3 4 5]\0A\0A    if not set -q argv[1]\0A        echo error: missing argument >&2\0A        status print-stack-trace >&2\0A        return 1\0A    end\0A\0A    # Only print status codes if the job failed.\0A    # SIGPIPE (141 = 128 + 13) is usually not a failure, see #6375.\0A    if not contains $last_status 0 141\0A        set -l sep $brace_sep_color$separator$status_color\0A        set -l last_pipestatus_string (fish_status_to_signal $argv | string join \22$sep\22)\0A        set -l last_status_string \22\22\0A        if test \22$last_status\22 -ne \22$argv[-1]\22\0A            set last_status_string \22 \22$status_color$last_status\0A        end\0A        set -l normal (set_color normal)\0A        # The \22normal\22s are to reset modifiers like bold - see #7771.\0A        printf \22%s\22 $normal $brace_sep_color $left_brace \\\0A            $status_color $last_pipestatus_string \\\0A            $normal $brace_sep_color $right_brace $normal $last_status_string $normal\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3315 = private unnamed_addr constant [44 x i8] c"functions/__fish_print_pkg_add_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3316 = private unnamed_addr constant [443 x i8] c"function __fish_print_pkg_add_packages\0A    # pkg_info on OpenBSD provides versioning info which we want for\0A    # installed packages but, calling it directly can cause delays in\0A    # returning information if another pkg_* tool have a lock.\0A    # Listing /var/db/pkg is a clean alternative.\0A    if type -q -f pkg_add\0A        set -l files /var/db/pkg/*\0A        string replace /var/db/pkg/ '' -- $files\0A        return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3317 = private unnamed_addr constant [40 x i8] c"functions/__fish_print_pkg_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3318 = private unnamed_addr constant [226 x i8] c"function __fish_print_pkg_packages\0A    # Pkg is fast on FreeBSD and provides versioning info which we want for\0A    # installed packages\0A    if type -q -f pkg\0A        pkg query \22%n-%v\22\0A        return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3319 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_port_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3320 = private unnamed_addr constant [699 x i8] c"function __fish_print_port_packages\0A    type -q -f port || return 1\0A\0A    # port needs caching, as it tends to be slow\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A\0A    set -l cache_file $xdg_cache_home/port\0A    if test -f $cache_file\0A        cat $cache_file\0A        set -l age (path mtime -R -- $cache_file)\0A        set -l max_age 250\0A        if test $age -lt $max_age\0A            return\0A        end\0A    end\0A\0A    __fish_cache_put $cache_file\0A    # Remove trailing whitespace and pipe into cache file\0A    printf \22all\\ncurrent\\nactive\\ninactive\\ninstalled\\nuninstalled\\noutdated\22 >$cache_file\0A    port echo all | awk '{$1=$1};1' >>$cache_file &\0A    cat $cache_file\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3321 = private unnamed_addr constant [50 x i8] c"functions/__fish_print_portage_available_pkgs.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3322 = private unnamed_addr constant [370 x i8] c"function __fish_print_portage_available_pkgs --description 'Print all available packages'\0A    set -l paths (__fish_print_portage_repository_paths)\0A    set -q paths[1]\0A    or return\0A    find $paths -mindepth 2 -maxdepth 2 -type d ! '(' '(' -path '*/eclass/*' -o -path '*/metadata/*' -o -path '*/profiles/*' -o -path '*/.*/*' ')' -prune ')' -printf '%P\\n' 2>/dev/null\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3323 = private unnamed_addr constant [50 x i8] c"functions/__fish_print_portage_installed_pkgs.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3324 = private unnamed_addr constant [238 x i8] c"function __fish_print_portage_installed_pkgs --description 'Print all installed packages (non-deduplicated)'\0A    find /var/db/pkg -mindepth 2 -maxdepth 2 -type d -printf '%P\\n' 2>/dev/null | string replace -r -- '-[0-9][0-9.]*.*$' ''\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3325 = private unnamed_addr constant [44 x i8] c"functions/__fish_print_portage_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3326 = private unnamed_addr constant [563 x i8] c"function __fish_print_portage_packages\0A    # This completes the package name from the portage tree.\0A    # True for installing new packages. Function for printing\0A    # installed on the system packages is in completions/emerge.fish\0A\0A    # eix is MUCH faster than emerge so use it if it is available\0A    if type -q -f eix\0A        eix --only-names \22^\22(commandline -ct) | cut -d/ -f2\0A        return 0\0A    else if type -q -f emerge\0A        emerge -s \\^(commandline -ct) | string match -r \22^\\*.*\22 | cut -d' ' -f3 | cut -d/ -f2\0A        return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3327 = private unnamed_addr constant [52 x i8] c"functions/__fish_print_portage_repository_paths.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3328 = private unnamed_addr constant [512 x i8] c"function __fish_print_portage_repository_paths --description 'Print the paths of all configured repositories'\0A    set -l a /etc/portage/repos.conf\0A    set -l b\0A    set -l c /usr/share/portage/config/repos.conf\0A    test -d $a\0A    and set b (path filter -f -- $a/**)\0A    test -f $a\0A    and set b $a\0A    test -n \22$b\22\0A    and string match -q \22[gentoo]\22 -- (cat $b 2>/dev/null)\0A    and set c $b\0A    or set -a c $b\0A    path is -r -- $c\0A    or return\0A    cat $c 2>/dev/null | string match -g -r '^location = (.*$)'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3329 = private unnamed_addr constant [40 x i8] c"functions/__fish_print_rpm_packages.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3330 = private unnamed_addr constant [1671 x i8] c"function __fish_print_rpm_packages\0A    type -q -f rpm /usr/share/yum-cli/completion-helper.py || return 1\0A\0A    # We do not use \22--installed\22, but we still allow passing it.\0A    argparse i/installed -- $argv\0A    or return 1\0A\0A    set -l xdg_cache_home (__fish_make_cache_dir)\0A    or return\0A\0A    if type -q -f /usr/share/yum-cli/completion-helper.py\0A        # If the cache is less than six hours old, we do not recalculate it\0A        set -l cache_file $xdg_cache_home/yum\0A        if test -f $cache_file\0A            cat $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 21600\0A            if test $age -lt $max_age\0A                return\0A            end\0A        end\0A\0A        __fish_cache_put $cache_file\0A        # Remove package version information from output and pipe into cache file\0A        /usr/share/yum-cli/completion-helper.py list all -d 0 -C | sed \22s/\\..*/\\tPackage/\22 >$cache_file &\0A        return\0A    end\0A\0A    # Rpm is too slow for this job, so we set it up to do completions\0A    # as a background job and cache the results.\0A    if type -q -f rpm\0A        # If the cache is less than five minutes old, we do not recalculate it\0A        set -l cache_file $xdg_cache_home/rpm\0A        if test -f $cache_file\0A            cat $cache_file\0A            set -l age (path mtime -R -- $cache_file)\0A            set -l max_age 250\0A            if test $age -lt $max_age\0A                return\0A            end\0A        end\0A\0A        # Remove package version information from output and pipe into cache file\0A        __fish_cache_put $cache_file\0A        rpm -qa | sed -e 's/-[^-]*-[^-]*$/\\t'Package'/' >$cache_file &\0A        return\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3331 = private unnamed_addr constant [41 x i8] c"functions/__fish_print_service_names.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3332 = private unnamed_addr constant [577 x i8] c"function __fish_print_service_names -d 'All services known to the system'\0A    if test -d /run/systemd/system # Systemd systems\0A        # For the `service` command, this needs to be without the type suffix\0A        # on Debian at least\0A        __fish_systemctl_services | string replace -r '.service$' ''\0A    else if type -f rc-service 2>/dev/null # OpenRC (Gentoo)\0A        command rc-service -l\0A    else if test -d /etc/init.d # SysV on Debian and other linuxen\0A        string replace '/etc/init.d/' '' -- /etc/init.d/*\0A    else # Freebsd\0A        command service -l\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3333 = private unnamed_addr constant [35 x i8] c"functions/__fish_print_svn_rev.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3334 = private unnamed_addr constant [121 x i8] c"function __fish_print_svn_rev --description 'Print svn revisions'\0A    printf '%s' (svnversion | sed 's=[^0-9:]*==g')\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3335 = private unnamed_addr constant [33 x i8] c"functions/__fish_print_users.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3336 = private unnamed_addr constant [429 x i8] c"# This should be used where you want user names without a description. If you also want\0A# a description, such as when getting a list of users for a completion, you probably want\0A# __fish_complete_users.\0Afunction __fish_print_users --description \22Print a list of local users\22\0A    # Leave the heavy lifting to __fish_complete_users but strip the descriptions.\0A    __fish_complete_users | string replace -r '^([^\\t]*)\\t.*' '$1'\0Aend\0A", align 1
