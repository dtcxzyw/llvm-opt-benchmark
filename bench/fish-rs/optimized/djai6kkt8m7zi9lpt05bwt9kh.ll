@anon.1d0b41a8d45d477c3029ec78f9b8b434.2620 = private unnamed_addr constant [14971 x i8] c"# Completion for SOPS (Secrets OPerationS)\0A\0Afunction __fish_sops_no_subcommand --description \22Test if there is a subcommand given\22\0A    not __fish_sops_print_remaining_args\0Aend\0A\0Afunction __fish_sops_print_remaining_args --description \22Print remaining argument given\22\0A    set -l cmd (commandline -pxc) (commandline -ct)\0A    set -e cmd[1]\0A    set -l opts d/decrypt e/encrypt r/rotate i/in-place s/show-master-keys v/version\0A    set -a opts extract ignore-mac verbose enable-local-keyservice\0A    set -a opts k/kms= p/pgp= a/age=\0A    set -a opts gcp-kms= aws-profile= azure-kv= hc-vault-transit= input-type= output-type=\0A    set -a opts add-gcp-kms= rm-gcp-kms= add-azure-kv= rm-azure-kv= add-kms= rm-kms=\0A    set -a opts add-hc-vault-transit= rm-hc-vault-transit= add-age= rm-age= add-pgp= rm-pgp=\0A    set -a opts unencrypted-suffix= encrypted-suffix= unencrypted-regex= encrypted-regex=\0A    set -a opts config= encryption-context= set= shamir-secret-sharing-threshold= output= keyservice=\0A    argparse -s $opts -- $cmd 2>/dev/null\0A    if test -n \22$argv\22\0A        and not string match -qr '^-' $argv[1]\0A        string join0 -- $argv\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0Afunction __fish_sops_commands --description \22Test if argument(s) match a sops command\22\0A    set -l args (__fish_sops_print_remaining_args | string split0)\0A    if string match -qr $argv $args[1]\0A        return 0\0A    else\0A        return 1\0A    end\0Aend\0A\0A# Primary commands\0Acomplete -F -c sops -n __fish_is_first_token -a exec-env -d \22Execute a command with decrypted values inserted into the environment\22\0Acomplete -F -c sops -n __fish_is_first_token -a exec-file -d \22Execute a command with decrypted contents as a temporary file\22\0Acomplete -F -c sops -n __fish_is_first_token -a publish -d \22Publish sops file or directory to a configured destination\22\0Acomplete -F -c sops -n __fish_is_first_token -a keyservice -d \22Start a SOPS key kervice server\22\0Acomplete -F -c sops -n __fish_is_first_token -a groups -d \22Modify the groups on a SOPS file\22\0Acomplete -F -c sops -n __fish_is_first_token -a updatekeys -d \22Update the keys of a SOPS file using the config file\22\0Acomplete -F -c sops -n __fish_is_first_token -a help -d \22Shows a list of commands or help for one command\22\0Acomplete -F -c sops -n __fish_is_first_token -a h -d \22Shows a list of commands or help for one command\22\0A\0A# Primary flags without parameters\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s d -l decrypt -d \22Decrypt a file and output the result to stdout\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s e -l encrypt -d \22Encrypt a file and output the result to stdout\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s r -l rotate -d \22Generate new encryption key & reencrypt with the new key\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s i -l in-place -d \22Write output back to the same file instead of stdout\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s s -l show-master-keys -d \22Display master encryption keys in the file during editing\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -l extract -d \22Extract a specific key or branch from decrypted input document\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -l ignore-mac -d \22Ignore Message Authentication Code during decryption\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -l verbose -d \22Enable verbose logging output\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -l enable-local-keyservice -d \22Use local key service\22\0Acomplete -F -c sops -n __fish_sops_no_subcommand -s v -l version -d \22Print the version\22\0A\0A# Primary flags with required parameters\0Acomplete -x -c sops -n __fish_sops_no_subcommand -s k -l kms -d \22Comma separated list of KMS ARNs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -s p -l pgp -d \22Comma separated list of PGP fingerprints\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -s a -l age -d \22Comma separated list of age recipients\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l gcp-kms -d \22Comma separated list of GCP KMS resource IDs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l aws-profile -d \22The AWS profile to use for requests to AWS\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l azure-kv -d \22Comma separated list of Azure Key Vault URLs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l hc-vault-transit -d \22Comma separated list of Vault's key URI\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l input-type -d \22Currently json, yaml, dotenv and binary are supported.\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l output-type -d \22Currently json, yaml, dotenv and binary are supported.\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l add-gcp-kms -d \22Comma-separated list of GCP KMS key resource IDs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l rm-gcp-kms -d \22Remove comma-separated list of GCP KMS key resource IDs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l add-azure-kv -x -d \22Add comma-separated list of Azure Key Vault key URLs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l rm-azure-kv -x -d \22Remove comma-separated list of Azure Key Vault key URLs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l add-kms -x -d \22Add comma-separated list of KMS ARNs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l rm-kms -x -d \22Remove comma-separated list of KMS ARNs\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l add-hc-vault-transit -x -d \22Add comma-separated list of Vault's URI key\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l rm-hc-vault-transit -x -d \22Remove comma-separated list of Vault's URI key\22\0Acomplete -x -c sops -n __fish_sops_no_subcommand -l add-