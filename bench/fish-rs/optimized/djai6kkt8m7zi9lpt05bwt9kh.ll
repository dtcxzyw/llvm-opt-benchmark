@anon.1d0b41a8d45d477c3029ec78f9b8b434.2152 = private unnamed_addr constant [2032 x i8] c"function __fish_print_abook_emails --description 'Print email addresses (abook)'\0A    abook --mutt-query \22\22 | string match -r -v '^\\s*$'\0A\0Aend\0A\0Aif command -sq abook\0A    complete -c mutt -f -a '(__fish_print_abook_emails)'\0A    complete -c mutt -s c -x -d 'Specify a carbon-copy (CC) recipient' -a '(__fish_print_abook_emails)'\0A    complete -c mutt -s b -x -d 'Specify a blind-carbon-copy (BCC) recipient' -a '(__fish_print_abook_emails)'\0Aend\0A\0Acomplete -c mutt -s D -d 'Print the value of all configuration options to stdout'\0Acomplete -c mutt -s h -d 'Display help'\0Acomplete -c mutt -s n -d 'Bypass the system configuration file'\0Acomplete -c mutt -s p -d 'Resume a postponed message'\0Acomplete -c mutt -s R -d 'Open a mailbox in read-only mode'\0Acomplete -c mutt -s v -d 'Display the Mutt version number and compile-time definitions'\0Acomplete -c mutt -s x -d 'Emulate the mailx compose mode'\0Acomplete -c mutt -s y -d 'Start Mutt with a listing of all mailboxes'\0Acomplete -c mutt -s z -d 'When used with -f, causes Mutt not to start if there are no messages'\0Acomplete -c mutt -s Z -d 'Open the first mailbox which contains new mail'\0A\0Acomplete -r -c mutt -s A -d 'An expanded version of the given alias is passed to stdout'\0Acomplete -r -c mutt -s a -d 'Attach a file to your message using MIME'\0Acomplete -r -c mutt -s b -d 'Specify a blind-carbon-copy (BCC) recipient'\0Acomplete -r -c mutt -s c -d 'Specify a carbon-copy (CC) recipient'\0Acomplete -r -c mutt -s e -d 'Run command after processing of initialization files'\0Acomplete -r -c mutt -s f -d 'Specify which mailbox to load'\0Acomplete -r -c mutt -s F -d 'Specify an initialization file to read instead of ~/.muttrc'\0Acomplete -r -c mutt -s H -d 'Specify a draft file containing header and body for the message'\0Acomplete -r -c mutt -s i -d 'Specify a file to include into the body of a message'\0Acomplete -r -c mutt -s m -d 'Specify a default mailbox type'\0Acomplete -r -c mutt -s Q -d 'Query a configuration variables value'\0Acomplete -r -c mutt -s s -d 'Specify the subject of the message'\0A", align 1
