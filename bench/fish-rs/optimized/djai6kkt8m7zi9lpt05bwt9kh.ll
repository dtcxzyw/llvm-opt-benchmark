@anon.1d0b41a8d45d477c3029ec78f9b8b434.1300 = private unnamed_addr constant [754 x i8] c"function __fish_cdh_args\0A    set -l all_dirs $dirprev $dirnext\0A    set -l uniq_dirs\0A\0A    # This next bit of code doesn't do anything useful at the moment since the fish pager always\0A    # sorts, and eliminates duplicate, entries. But we do this to mimic the modal behavor of `cdh`\0A    # and in hope that the fish pager behavior will be changed to preserve the order of entries.\0A    for dir in $all_dirs[-1..1]\0A        if not contains $dir $uniq_dirs\0A            set uniq_dirs $uniq_dirs $dir\0A        end\0A    end\0A\0A    for dir in $uniq_dirs\0A        set -l home_dir (string match -r \22$HOME(/.*|\\$)\22 \22$dir\22)\0A        if set -q home_dir[2]\0A            set dir \22~$home_dir[2]\22\0A        end\0A        echo $dir\0A    end\0Aend\0A\0Acomplete -c cdh -kxa '(__fish_cdh_args)'\0A", align 1
