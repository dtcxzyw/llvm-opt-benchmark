@anon.1d0b41a8d45d477c3029ec78f9b8b434.1988 = private unnamed_addr constant [2644 x i8] c"# losetup - Set up and control loop devices.\0A#\0A# This is part of the util-linux package.\0A# https://www.kernel.org/pub/linux/utils/util-linux\0A\0Afunction __fish_print_losetup_list_output\0A    printf \22%s\\t%s\\n\22 \\\0A        NAME \22Loop device name\22 \\\0A        AUTOCLEAR \22Autoclear flag set\22 \\\0A        BACK-FILE \22Device backing file\22 \\\0A        BACK-INO \22Backing file inode number\22 \\\0A        BACK-MAJ:MIN \22Backing file major:minor device number\22 \\\0A        MAJ:MIN \22Loop device major:minor number\22 \\\0A        OFFSET \22Offset from the beginning\22 \\\0A        PARTSCAN \22Partscan flag set\22 \\\0A        RO \22Read-only device\22 \\\0A        SIZELIMIT \22Size limit of the file in bytes\22 \\\0A        DIO \22Access backing file with direct-io\22 \\\0A        LOG-SEC \22Logical sector size in bytes\22\0Aend\0A\0Afunction __fish_print_losetup_attached\0A    losetup --list --raw --noheadings --output NAME,BACK-FILE | string replace ' ' \\t\0Aend\0A\0Acomplete -c losetup -s a -l all -d \22List all used devices\22\0Acomplete -c losetup -s d -l detach -x -a \22(__fish_print_losetup_attached)\22 -d \22Detach one or more devices\22\0Acomplete -c losetup -s D -l detach-all -d \22Detach all used devices\22\0Acomplete -c losetup -s f -l find -d \22Find first unused device\22\0Acomplete -c losetup -s c -l set-capacity -x -a \22(__fish_print_losetup_attached)\22 -d \22Resize the device\22\0Acomplete -c losetup -s j -l associated -r -d \22List all devices associated with given file\22\0Acomplete -c losetup -s L -l nooverlap -d \22Avoid possible conflict between devices\22\0Acomplete -c losetup -s o -l offset -x -d \22Start at given offset into file\22\0Acomplete -c losetup -l sizelimit -x -d \22Device is limited to give bytes of the file\22\0Acomplete -c losetup -s b -l sector-size -x -d \22Set the logical sector size\22\0Acomplete -c losetup -s P -l partscan -d \22Create a partitioned loop device\22\0Acomplete -c losetup -s r -l read-only -d \22Set up a read-only loop device\22\0Acomplete -c losetup -l direct-io -x -a \22on off\22 -d \22open backing file with O_DIRECT\22\0Acomplete -c losetup -l show -d \22Print device name after setup\22\0Acomplete -c losetup -s v -l verbose -d \22Verbose mode\22\0Acomplete -c losetup -s J -l json -d \22Use JSON --list output format\22\0Acomplete -c losetup -s l -l list -d \22List info about all or specified\22\0Acomplete -c losetup -s n -l noheadings -d \22Don't print headings for --list output\22\0Acomplete -c losetup -s O -l output -x -a \22(__fish_complete_list , __fish_print_losetup_list_output)\22 -d \22Specify columns to output for --list\22\0Acomplete -c losetup -l output-all -d \22Output all columns\22\0Acomplete -c losetup -l raw -d \22Use raw --list output format\22\0Acomplete -c losetup -s h -l help -d \22Display help\22\0Acomplete -c losetup -s V -l version -d \22Display version\22\0A", align 1
