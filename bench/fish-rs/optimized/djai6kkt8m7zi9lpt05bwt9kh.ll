0A# clean\0Acomplete pre-commit -n __fish_use_subcommand -a clean -d \22Clean out files\22\0A\0A# gc\0Acomplete pre-commit -n __fish_use_subcommand -a gc -d \22Clean unused cached repos\22\0A\0A# help\0Acomplete pre-commit -n __fish_use_subcommand -a help -d \22Show help for a specific command\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from help\22 -a \22$commands\22 -d Command\0A\0A# init-templatedir\0Acomplete pre-commit -n __fish_use_subcommand -a init-templatedir -d \22Install hook script in a directory\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from init-templatedir\22 -l no-allow-missing-config -d \22Assume cloned repos should have a config\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from init-templatedir\22 -s t -l hook-type -xa \22$hook_types\22 -d \22Type of hook to install\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from init-templatedir\22 -a \22(__fish_complete_directories)\22 -d \22Directory to write scripts\22\0A\0A# install\0Acomplete pre-commit -n __fish_use_subcommand -a install -d \22Install the pre-commit script\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from install\22 -l allow-missing-config -d \22Allow missing config file\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from install\22 -l install-hooks -d \22Install hook environments\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from install\22 -s t -l hook-type -xa \22$hook_types\22 -d \22Type of hook to install\22\0Acomplete pre-commit -n \22__fish_seen_subcommand_from install\22 -s f -l overwrite -d \22Overwrite existing hooks\22\0A\0A# install-hooks\0Acomplete pre-commit -n __fish_use_subcommand -a install-hooks -d \22Install all hook environments\22\0A\0A# migrate-config\0Acomplete pre-commit -n __fish_use_subcommand -a migrate-config -d \22Migrate to newer config\22\0A\0A# run / try-repo\0Acomplete pre-commit -n __fish_use_subcommand -a run -d \22Run hooks\22\0Acomplete pre-commit -n __fish_use_subcommand -a try-repo -d \22