@anon.1d0b41a8d45d477c3029ec78f9b8b434.1046 = private unnamed_addr constant [1075 x i8] c"# Completions for `actionlint` (https://github.com/rhysd/actionlint)\0A# Based on version 1.7.1\0A\0Acomplete -c actionlint -o color -d \22enable colorful output\22\0Acomplete -r -c actionlint -o config-file -d \22path to config file\22\0Acomplete -c actionlint -o debug -d \22enable debug output\22\0Acomplete -x -c actionlint -o format -d \22custom template to format error messages\22\0Acomplete -x -c actionlint -o ignore -d \22regex matching to error messages you want to ignore\22\0Acomplete -c actionlint -o init-config -d \22generate default config file\22\0Acomplete -c actionlint -o no-color -d \22disable colorful output\22\0Acomplete -c actionlint -o oneline -d \22use one line per one error\22\0Acomplete -x -c actionlint -o pyflakes -d \22command name or path of `pyflakes`\22\0Acomplete -x -c actionlint -o shellcheck -d \22command name or path of `shellcheck`\22\0Acomplete -r -c actionlint -o stdin-filename -d \22filename when reading input from stdin\22\0Acomplete -c actionlint -o verbose -d \22enable verbose output\22\0Acomplete -c actionlint -o version -d \22show version\22\0Acomplete -c actionlint -s h -o help -d \22show help message\22\0A", align 1
