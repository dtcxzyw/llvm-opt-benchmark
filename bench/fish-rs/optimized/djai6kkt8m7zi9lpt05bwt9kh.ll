@anon.1d0b41a8d45d477c3029ec78f9b8b434.2600 = private unnamed_addr constant [1057 x i8] c"# Load completions shared by various ssh tools like ssh, scp and sftp.\0A__fish_complete_ssh sftp\0A\0Acomplete -c sftp -x -a \22(__fish_complete_user_at_hosts)\22\0A\0Acomplete -c sftp -s a -d 'Attempt to continue interrupted transfers'\0Acomplete -c sftp -s B -x -d 'Size of the buffer when transferring files'\0Acomplete -c sftp -s b -F -d 'Reads a series of commands from an input batchfile'\0Acomplete -c sftp -s D -x -d 'Connect directly to a local SFTP server'\0Acomplete -c sftp -s f -d 'Flush files to disk after transfer'\0Acomplete -c sftp -s l -x -d 'Limits the used bandwidth (Kbit/s)'\0Acomplete -c sftp -s N -d 'Disables quiet mode'\0Acomplete -c sftp -s P -x -d 'Port to connect to on the remote host'\0Acomplete -c sftp -s p -d 'Preserve timestamps from the original files transferred'\0Acomplete -c sftp -s R -x -d 'How many requests may be outstanding'\0Acomplete -c sftp -s r -d 'Recursively copy entire directories'\0Acomplete -c sftp -s S -r -d 'Program to use for the encrypted connection'\0Acomplete -c sftp -s s -x -d 'The SSH2 subsystem or the path for an sftp server'\0A", align 1
