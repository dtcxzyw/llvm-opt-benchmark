@anon.1d0b41a8d45d477c3029ec78f9b8b434.3542 = private unnamed_addr constant [40919 x i8] c"#!/usr/bin/env python3\0A# -*- coding: utf-8 -*-\0A\0A# Run me like this: ./create_manpage_completions.py /usr/share/man/man{1,8}/* > man_completions.fish\0A\0A\22\22\22\0A<OWNER> = Siteshwar Vashisht\0A<YEAR> = 2012\0A\0ACopyright (c) 2012, Siteshwar Vashisht\0AAll rights reserved.\0A\0ARedistribution and use in source and binary forms, with or without modification, are permitted provided that the following conditions are met:\0A\0ARedistributions of source code must retain the above copyright notice, this list of conditions and the following disclaimer.\0ARedistributions in binary form must reproduce the above copyright notice, this list of conditions and the following disclaimer in the documentation and/or other materials provided with the distribution.\0ATHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS \22AS IS\22 AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT HOLDER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\0A\22\22\22\0A\0Afrom __future__ import print_function\0Afrom deroff import Deroffer\0Aimport argparse\0Aimport bz2\0Aimport codecs\0Aimport errno\0Aimport gzip\0Aimport os\0Aimport re\0Aimport string\0Aimport subprocess\0Aimport sys\0Aimport traceback\0A\0Alzma_available = True\0Atry:\0A    try:\0A        import lzma\0A    except ImportError:\0A        from backports import lzma\0Aexcept ImportError:\0A    lzma_available = False\0A\0Atry:\0A    from subprocess import DEVNULL\0Aexcept ImportError:\0A    DEVNULL = open(os.devnull, \22wb\22)\0A\0A# Whether we're Python 3\0AIS_PY3 = sys.version_info[0] >= 3\0A\0A# This gets set to the name of the command that we are currently executing\0ACMDNAME = \22\22\0A\0A# Information used to track which of our parsers were successful\0APARSER_INFO = {}\0A\0A# built_command writes into this global variable, yuck\0Abuilt_command_output = []\0A\0A# Diagnostic output\0Adiagnostic_output = []\0Adiagnostic_indent = 0\0A\0A# Three diagnostic verbosity levels\0AVERY_VERBOSE, BRIEF_VERBOSE, NOT_VERBOSE = 2, 1, 0\0A\0A# Pick some reasonable default values for settings\0AVERBOSITY, WRITE_TO_STDOUT, DEROFF_ONLY, KEEP_FILES = NOT_VERBOSE, False, False, False\0A\0A\0Adef add_diagnostic(dgn, msg_verbosity=VERY_VERBOSE):\0A    # Add a diagnostic message, if msg_verbosity <= VERBOSITY\0A    if msg_verbosity <= VERBOSITY:\0A        diagnostic_output.append(\22   \22 * diagnostic_indent + dgn)\0A\0A\0Adef flush_diagnostics(where):\0A    if diagnostic_output:\0A        output_str = \22\\n\22.join(diagnostic_output)\0A        print(output_str, file=where)\0A        diagnostic_output[:] = []\0A\0A\0A# Make sure we don't output the same completion multiple times, which can happen\0A# For example, xsubpp.1.gz and xsubpp5.10.1.gz\0A# This maps commands to lists of completions\0Aalready_output_completions = {}\0A\0A\0Adef compile_and_search(regex, input):\0A    options_section_regex = re.compile(regex, re.DOTALL)\0A    options_section_matched = re.search(options_section_regex, input)\0A    return options_section_matched\0A\0A\0Adef unquote_double_quotes(data):\0A    if len(data) < 2:\0A        return data\0A    if data[0] == '\22' and data[len(data) - 1] == '\22':\0A        data = data[1 : len(data) - 1]\0A    return data\0A\0A\0Adef unquote_single_quotes(data):\0A    if len(data) < 2:\0A        return data\0A    if data[0] == \22`\22 and data[len(data) - 1] == \22'\22:\0A        data = data[1 : len(data) - 1]\0A    return data\0A\0A\0A# Make a string of characters that are deemed safe in fish without needing to be escaped\0A# Note that space is not included\0Ag_fish_safe_chars = frozenset(string.ascii_letters + string.digits + \22_+-|/:=@~\22)\0A\0A\0Adef fish_escape_single_quote(str):\0A    # Escape a string if necessary so that it can be put in single quotes\0A    # If it has no non-safe chars, there's nothing to do\0A    if g_fish_safe_chars.issuperset(str):\0A        return str\0A\0A    str = str.replace(\22\\\\\22, \22\\\\\\\\\22)  # Replace one backslash with two\0A    str = str.replace(\0A        \22'\22, \22\\\\'\22\0A    )  # Replace one single quote with a backslash-single-quote\0A    return \22'\22 + str + \22'\22\0A\0A\0A# Make a string Unicode by attempting to decode it as latin-1, or UTF8. See #658\0Adef lossy_unicode(s):\0A    # All strings are unicode in Python 3\0A    if IS_PY3 or isinstance(s, unicode):\0A        return s\0A    try:\0A        return s.decode(\22latin-1\22)\0A    except UnicodeEncodeError:\0A        pass\0A    try:\0A        return s.decode(\22utf-8\22)\0A    except UnicodeEncodeError:\0A        pass\0A    return s.decode(\22latin-1\22, \22ignore\22)\0A\0A\0Adef output_complete_command(cmdname, args, description, output_list):\0A    comps = [\22complete -c\22, cmdname]\0A    comps.extend(args)\0A    if description:\0A        comps.append(\22-d\22)\0A        comps.append(description)\0A    output_list.append(lossy_unicode(\22 \22).join([lossy_unicode(c) for c in comps]))\0A\0A\0Adef built_command(options, description):\0A    #    print \22Options are: \22, options\0A    man_optionlist = re.split(' |,|\22|=|[|]', options)\0A    fish_options = []\0A    for optionstr in man_optionlist:\0A        option = re.sub(r\22(\\[.*\\])\22, \22\22, optionstr)\0A        option = option.strip(\22 \\t\\r\\n[](){}.,:!\22)\0A\0A        # Skip some problematic cases\0A        if option in [\22-\22, \22--\22]:\0A            continue\0A        if any(c in \22{}()\22 for c in option):\0A            continue\0A\0A        if option.startswith(\22--\22):\0A            # New style long option (--recursive)\0A            fish_options.append(\22-l \22 + fish_escape_single_quote(option[2:]))\0A        elif option.startswith(\22-\22) and len(option) == 2:\0A            # New style short option (-r)\0A            fish_options.append(\22-s \22 + fish_escape_single_quote(option[1:]))\0A        elif option.startswith(\22-\22) and len(option) > 2:\0A            # Old style long option (-recursive)\0A            fish_options.append(\22-o \22 + fish_escape_single_quote(option[1:]))\0A\0A    # Determine which options are new (not already in existing_options)\0A    # Then add those to the existing options\0A    existing_options = already_output_completions.setdefault(CMDNAME, set())\0A    fish_options = [opt for opt in fish_options if opt not in existing_options]\0A    existing_options.update(fish_options)\0A\0A    # Maybe it's all for naught\0A    if not fish_options:\0A        return\0A\0A    # Here's what we'll use to truncate if necessary\0A    max_description_width = 78\0A    if IS_PY3:\0A        truncation_suffix = \22\E2\80\A6\22\0A    else:\0A        ELLIPSIS_CODE_POINT = 0x2026\0A        truncation_suffix = unichr(ELLIPSIS_CODE_POINT)\0A\0A    # Try to include as many whole sentences as will fit\0A    # Clean up some probably bogus escapes in the process\0A    clean_desc = description.replace(\22\\\\'\22, \22'\22).replace(\22\\\\.\22, \22.\22)\0A    sentences = clean_desc.split(\22.\22)\0A\0A    # Clean up \22sentences\22 that are just whitespace\0A    # But don't let it be empty\0A    sentences = [x for x in sentences if x.strip()]\0A    if not sentences:\0A        sentences = [\22\22]\0A\0A    udot = lossy_unicode(\22.\22)\0A    uspace = lossy_unicode(\22 \22)\0A\0A    truncated_description = lossy_unicode(sentences[0]) + udot\0A    for line in sentences[1:]:\0A        if not line:\0A            continue\0A        proposed_description = (\0A            lossy_unicode(truncated_description) + uspace + lossy_unicode(line) + udot\0A        )\0A        if len(proposed_description) <= max_description_width:\0A            # It fits\0A            truncated_description = proposed_description\0A        else:\0A            # No fit\0A            break\0A    # Strip trailing dots\0A    truncated_description = truncated_description.strip(udot)\0A\0A    # If the first sentence does not fit, truncate if necessary\0A    if len(truncated_description) > max_description_width:\0A        prefix_len = max_description_width - len(truncation_suffix)\0A        truncated_description = truncated_description[:prefix_len] + truncation_suffix\0A\0A    # Escape some more things\0A    truncated_description = fish_escape_single_quote(truncated_description)\0A    escaped_cmd = fish_escape_single_quote(CMDNAME)\0A\0A    output_complete_command(\0A        escaped_cmd, fish_options, truncated_description, built_command_output\0A    )\0A\0A\0Adef remove_groff_formatting(data):\0A    data = data.replace(\22\\\\fI\22, \22\22)\0A    data = data.replace(\22\\\\fP\22, \22\22)\0A    data = data.replace(\22\\\\f1\22, \22\22)\0A    data = data.replace(\22\\\\fB\22, \22\22)\0A    data = data.replace(\22\\\\fR\22, \22\22)\0A    data = data.replace(\22\\\\e\22, \22\22)\0A    data = re.sub(r\22.PD( \\d+)\22, \22\22, data)\0A    data = data.replace(\22.BI\22, \22\22)\0A    data = data.replace(\22.BR\22, \22\22)\0A    data = data.replace(\220.5i\22, \22\22)\0A    data = data.replace(\22.rb\22, \22\22)\0A    data = data.replace(\22\\\\^\22, \22\22)\0A    data = data.replace(\22{ \22, \22\22)\0A    data = data.replace(\22 }\22, \22\22)\0A    data = data.replace(r\22\\ \22, \22\22)\0A    data = data.replace(r\22\\-\22, \22-\22)\0A    data = data.replace(r\22\\&\22, \22\22)\0A    data = data.replace(\22.B\22, \22\22)\0A    data = data.replace(r\22\\-\22, \22-\22)\0A    data = data.replace(\22.I\22, \22\22)\0A    data = data.replace(\22\\f\22, \22\22)\0A    data = data.replace(r\22\\(oq\22, \22'\22)\0A    data = data.replace(r\22\\(cq\22, \22'\22)\0A    data = data.replace(r\22\\(aq\22, \22'\22)\0A    data = data.replace(r\22\\(dq\22, '\22')\0A    data = data.replace(r\22\\(lq\22, '\22')\0A    data = data.replace(r\22\\(rq\22, '\22')\0A    return data\0A\0A\0Aclass ManParser(object):\0A    def is_my_type(self, manpage):\0A        return False\0A\0A    def parse_man_page(self, manpage):\0A        return False\0A\0A\0Aclass Type1ManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return compile_and_search(r'\\.SH \22OPTIONS\22(.*?)', manpage) is not None\0A\0A    def parse_man_page(self, manpage):\0A        options_section_regex = re.compile(r'\\.SH \22OPTIONS\22(.*?)(\\.SH|\\Z)', re.DOTALL)\0A        options_section = re.search(options_section_regex, manpage).group(1)\0A\0A        options_parts_regex = re.compile(r\22\\.PP(.*?)\\.RE\22, re.DOTALL)\0A        options_matched = re.search(options_parts_regex, options_section)\0A        add_diagnostic(\22Command is %r\22 % CMDNAME)\0A\0A        if options_matched is None:\0A            add_diagnostic(\22Unable to find options\22)\0A            if self.fallback(options_section):\0A                return True\0A            elif self.fallback2(options_section):\0A                return True\0A            return False\0A\0A        while options_matched is not None:\0A            data = options_matched.group(1)\0A            last_dotpp_index = data.rfind(\22.PP\22)\0A            if last_dotpp_index != -1:\0A                data = data[last_dotpp_index + 3 :]\0A\0A            data = remove_groff_formatting(data)\0A            data = data.split(\22.RS 4\22)\0A            if len(data) > 1:  # and len(data[1]) <= 300):\0A                optionName = data[0].strip()\0A\0A                if optionName.find(\22-\22) == -1:\0A                    add_diagnostic(\22%r doesn't contain '-' \22 % optionName)\0A                else:\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                return False\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A\0A    def fallback(self, options_section):\0A        add_diagnostic(\22Trying fallback\22)\0A        options_parts_regex = re.compile(r\22\\.TP( \\d+)?(.*?)\\.TP\22, re.DOTALL)\0A        options_matched = re.search(options_parts_regex, options_section)\0A        if options_matched is None:\0A            add_diagnostic(\22Still not found\22)\0A            return False\0A        while options_matched is not None:\0A            data = options_matched.group(2)\0A            data = remove_groff_formatting(data)\0A            data = data.strip()\0A            data = data.split(\22\\n\22, 1)\0A            if len(data) > 1 and len(data[1].strip()) > 0:  # and len(data[1])<400):\0A                optionName = data[0].strip()\0A                if optionName.find(\22-\22) == -1:\0A                    add_diagnostic(\22%r doesn't contain '-'\22 % optionName)\0A                else:\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                return False\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A        return True\0A\0A    def fallback2(self, options_section):\0A        add_diagnostic(\22Trying last chance fallback\22)\0A        ix_remover_regex = re.compile(r\22\\.IX.*\22)\0A        trailing_num_regex = re.compile(\22\\\\d+$\22)\0A        options_parts_regex = re.compile(r\22\\.IP (.*?)\\.IP\22, re.DOTALL)\0A\0A        options_section = re.sub(ix_remover_regex, \22\22, options_section)\0A        options_matched = re.search(options_parts_regex, options_section)\0A        if options_matched is None:\0A            add_diagnostic(\22Still (still!) not found\22)\0A            return False\0A        while options_matched is not None:\0A            data = options_matched.group(1)\0A\0A            data = remove_groff_formatting(data)\0A            data = data.strip()\0A            data = data.split(\22\\n\22, 1)\0A            if len(data) > 1 and len(data[1].strip()) > 0:  # and len(data[1])<400):\0A                optionName = re.sub(trailing_num_regex, \22\22, data[0].strip())\0A\0A                if \22-\22 not in optionName:\0A                    add_diagnostic(\22%r doesn't contain '-'\22 % optionName)\0A                else:\0A                    optionName = optionName.strip()\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                return False\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A        return True\0A\0A\0Aclass Type2ManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return compile_and_search(r\22\\.SH OPTIONS(.*?)\22, manpage) is not None\0A\0A    def parse_man_page(self, manpage):\0A        options_section_regex = re.compile(r\22\\.SH OPTIONS(.*?)(\\.SH|\\Z)\22, re.DOTALL)\0A        options_section = re.search(options_section_regex, manpage).group(1)\0A\0A        options_parts_regex = re.compile(\0A            r\22\\.[IT]P( \\d+(\\.\\d)?i?)?(.*?)\\.([IT]P|UNINDENT|UN|SH)\22, re.DOTALL\0A        )\0A        options_matched = re.search(options_parts_regex, options_section)\0A        add_diagnostic(\22Command is %r\22 % CMDNAME)\0A\0A        if options_matched is None:\0A            add_diagnostic(\22%r: Unable to find options\22 % self)\0A            return False\0A\0A        while options_matched is not None:\0A            data = options_matched.group(3)\0A            data = remove_groff_formatting(data)\0A            data = data.strip()\0A            data = data.split(\22\\n\22, 1)\0A\0A            if len(data) > 1 and len(data[1].strip()) > 0:  # and len(data[1])<400):\0A                optionName = data[0].strip()\0A                if \22-\22 not in optionName:\0A                    add_diagnostic(\22%r doesn't contain '-'\22 % optionName)\0A                else:\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A\0A\0Aclass Type3ManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return compile_and_search(r\22\\.SH DESCRIPTION(.*?)\22, manpage) != None\0A\0A    def parse_man_page(self, manpage):\0A        options_section_regex = re.compile(r\22\\.SH DESCRIPTION(.*?)(\\.SH|\\Z)\22, re.DOTALL)\0A        options_section = re.search(options_section_regex, manpage).group(1)\0A\0A        options_parts_regex = re.compile(r\22\\.TP(.*?)\\.TP\22, re.DOTALL)\0A        options_matched = re.search(options_parts_regex, options_section)\0A        add_diagnostic(\22Command is %r\22 % CMDNAME)\0A\0A        if options_matched is None:\0A            add_diagnostic(\22Unable to find options section\22)\0A            return False\0A\0A        while options_matched != None:\0A            data = options_matched.group(1)\0A\0A            data = remove_groff_formatting(data)\0A            data = data.strip()\0A            data = data.split(\22\\n\22, 1)\0A\0A            if len(data) > 1:  # and len(data[1])<400):\0A                optionName = data[0].strip()\0A                if optionName.find(\22-\22) == -1:\0A                    add_diagnostic(\22%r doesn't contain '-'\22 % optionName)\0A                else:\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                return False\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A\0A\0Aclass Type4ManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return compile_and_search(r\22\\.SH FUNCTION LETTERS(.*?)\22, manpage) != None\0A\0A    def parse_man_page(self, manpage):\0A        options_section_regex = re.compile(\0A            r\22\\.SH FUNCTION LETTERS(.*?)(\\.SH|\\Z)\22, re.DOTALL\0A        )\0A        options_section = re.search(options_section_regex, manpage).group(1)\0A\0A        options_parts_regex = re.compile(r\22\\.TP(.*?)\\.TP\22, re.DOTALL)\0A        options_matched = re.search(options_parts_regex, options_section)\0A        add_diagnostic(\22Command is %r\22 % CMDNAME)\0A\0A        if options_matched is None:\0A            print(\22Unable to find options section\22, file=sys.stderr)\0A            return False\0A\0A        while options_matched != None:\0A            data = options_matched.group(1)\0A\0A            data = remove_groff_formatting(data)\0A            data = data.strip()\0A            data = data.split(\22\\n\22, 1)\0A\0A            if len(data) > 1:  # and len(data[1])<400):\0A                optionName = data[0].strip()\0A                if optionName.find(\22-\22) == -1:\0A                    add_diagnostic(\22%r doesn't contain '-' \22 % optionName)\0A                else:\0A                    optionName = unquote_double_quotes(optionName)\0A                    optionName = unquote_single_quotes(optionName)\0A                    optionDescription = data[1].strip().replace(\22\\n\22, \22 \22)\0A                    built_command(optionName, optionDescription)\0A\0A            else:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                return False\0A\0A            options_section = options_section[options_matched.end() - 3 :]\0A            options_matched = re.search(options_parts_regex, options_section)\0A\0A\0Aclass TypeScdocManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return (\0A            compile_and_search(\0A                r\22\\.(\\\\)(\\\22) Generated by scdoc(.*?)\\.SH OPTIONS(.*?)\22, manpage\0A            )\0A            != None\0A        )\0A\0A    def parse_man_page(self, manpage):\0A        options_section_regex = re.compile(r\22\\.SH OPTIONS(.*?)\\.SH\22, re.DOTALL)\0A        options_section_matched = re.search(options_section_regex, manpage)\0A        if options_section_matched is None:\0A            return False\0A        options_section = options_section_matched.group(1)\0A\0A        options_parts_regex = re.compile(\22(.*?).RE\22, re.DOTALL)\0A        options_matched = re.match(options_parts_regex, options_section)\0A        add_diagnostic(\22Command is %r\22 % CMDNAME)\0A\0A        if options_matched is None:\0A            add_diagnostic(\22%r: Unable to find options\22 % self)\0A            return False\0A\0A        while options_matched is not None:\0A            # Get first option and move options_section\0A            option = options_matched.group(1)\0A            options_section = options_section[options_matched.end() : :]\0A            options_matched = re.match(options_parts_regex, options_section)\0A\0A            option = remove_groff_formatting(option)\0A            option = option.split(\22\\n\22)\0A\0A            # Crean option list\0A            option_clean = []\0A            for line in option:\0A                if line not in [\22\22, \22.P\22, \22.RS 4\22]:\0A                    option_clean.append(line)\0A\0A            # Shold be at least two lines\0A            if len(option_clean) < 2:\0A                add_diagnostic(\22Unable to split option from description\22)\0A                continue\0A\0A            # Name and description, others lines are ignored\0A            option_name = option_clean[0]\0A            option_description = option_clean[1]\0A\0A            if \22-\22 not in option_name:\0A                add_diagnostic(\22%r doesn't contain '-'\22 % option_name)\0A\0A            option_name = unquote_double_quotes(option_name)\0A            option_name = unquote_single_quotes(option_name)\0A            built_command(option_name, option_description)\0A\0A        return True\0A\0A\0Aclass TypeDarwinManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return compile_and_search(r\22\\.S[hH] DESCRIPTION\22, manpage) is not None\0A\0A    def trim_groff(self, line):\0A        # Remove initial period\0A        if line.startswith(\22.\22):\0A            line = line[1:]\0A        # Skip leading groff crud\0A        while re.match(r\22[A-Z][a-z]\\s\22, line):\0A            line = line[3:]\0A\0A        # If the line ends with a space and then a period or comma, then erase the space\0A        # This hack handles lines of the form '.Ar projectname .'\0A        if line.endswith(\22 ,\22) or line.endswith(\22 .\22):\0A            line = line[:-2] + line[-1]\0A        return line\0A\0A    def count_argument_dashes(self, line):\0A        # Determine how many dashes the line has using the following regex hack\0A        # Look for the start of a line, followed by a dot, then a sequence of\0A        # one or more dashes ('Fl')\0A        result = 0\0A        if line.startswith(\22.\22):\0A            line = line[4:]\0A            while line.startswith(\22Fl \22):\0A                result = result + 1\0A                line = line[3:]\0A        return result\0A\0A    # Replace some groff escapes. There's a lot we don't bother to handle.\0A    def groff_replace_escapes(self, line):\0A        line = line.replace(\22.Nm\22, CMDNAME)\0A        line = line.replace(\22\\\\ \22, \22 \22)\0A        line = line.replace(r\22\\& \22, \22\22)\0A        line = line.replace(\22.Pp\22, \22\22)\0A        return line\0A\0A    def is_option(self, line):\0A        return line.startswith(\22.It Fl\22)\0A\0A    def parse_man_page(self, manpage):\0A        got_something = False\0A        lines = manpage.splitlines()\0A        # Discard lines until we get to \22.sh Description\22\0A        while lines and not (\0A            lines[0].startswith(\22.Sh DESCRIPTION\22)\0A            or lines[0].startswith(\22.SH DESCRIPTION\22)\0A        ):\0A            lines.pop(0)\0A\0A        while lines:\0A            # Pop until we get to the next option\0A            while lines and not self.is_option(lines[0]):\0A                lines.pop(0)\0A\0A            if not lines:\0A                continue\0A\0A            # Get the line and clean it up\0A            line = lines.pop(0)\0A\0A            # Try to guess how many dashes this argument has\0A            dash_count = self.count_argument_dashes(line)\0A\0A            line = self.groff_replace_escapes(line)\0A            line = self.trim_groff(line)\0A            line = line.strip()\0A            if not line:\0A                continue\0A\0A            # Extract the name\0A            name = line.split(None, 2)[0]\0A\0A            # Extract the description\0A            desc_lines = []\0A            while lines and not self.is_option(lines[0]):\0A                line = lossy_unicode(lines.pop(0).strip())\0A                # Ignore comments\0A                if line.startswith(r\22.\\\22\22):\0A                    continue\0A                if line.startswith(\22.\22):\0A                    line = self.groff_replace_escapes(line)\0A                    line = self.trim_groff(line).strip()\0A                if line:\0A                    desc_lines.append(line)\0A            desc = \22 \22.join(desc_lines)\0A\0A            if name == \22-\22:\0A                # Skip double -- arguments\0A                continue\0A            elif len(name) > 1:\0A                # Output the command\0A                built_command((\22-\22 * dash_count) + name, desc)\0A                got_something = True\0A            elif len(name) == 1:\0A                built_command(\22-\22 + name, desc)\0A                got_something = True\0A\0A        return got_something\0A\0A\0Aclass TypeDeroffManParser(ManParser):\0A    def is_my_type(self, manpage):\0A        return True  # We're optimists\0A\0A    def is_option(self, line):\0A        return line.startswith(\22-\22)\0A\0A    def could_be_description(self, line):\0A        return len(line) > 0 and not line.startswith(\22-\22)\0A\0A    def parse_man_page(self, manpage):\0A        d = Deroffer()\0A        d.deroff(manpage)\0A        output = d.get_output()\0A        lines = output.split(\22\\n\22)\0A\0A        got_something = False\0A\0A        # Discard lines until we get to DESCRIPTION or OPTIONS\0A        while lines and not (\0A            lines[0].startswith(\22DESCRIPTION\22)\0A            or lines[0].startswith(\22OPTIONS\22)\0A            or lines[0].startswith(\22COMMAND OPTIONS\22)\0A        ):\0A            lines.pop(0)\0A\0A        # Look for BUGS and stop there\0A        for idx in range(len(lines)):\0A            line = lines[idx]\0A            if line.startswith(\22BUGS\22):\0A                # Drop remaining elements\0A                lines[idx:] = []\0A                break\0A\0A        while lines:\0A            # Pop until we get to the next option\0A            while lines and not self.is_option(lines[0]):\0A                line = lines.pop(0)\0A\0A            if not lines:\0A                continue\0A\0A            options = lines.pop(0)\0A\0A            # Pop until we get to either an empty line or a line starting with -\0A            description = \22\22\0A            while lines and self.could_be_description(lines[0]):\0A                if description:\0A                    description += \22 \22\0A                description += lines.pop(0)\0A\0A            built_command(options, description)\0A            got_something = True\0A\0A        return got_something\0A\0A\0A# Return whether the file at the given path is overwritable\0A# Raises IOError if it cannot be opened\0Adef file_is_overwritable(path):\0A    result = False\0A    file = codecs.open(path, \22r\22, encoding=\22utf-8\22)\0A    for line in file:\0A        # Skip leading empty lines\0A        line = line.strip()\0A        if not line:\0A            continue\0A\0A        # We look in the initial run of lines that start with #\0A        if not line.startswith(\22#\22):\0A            break\0A\0A        # See if this contains the magic word\0A        if \22Autogenerated\22 in line:\0A            result = True\0A            break\0A\0A    file.close()\0A    return result\0A\0A\0A# Remove any and all autogenerated completions in the given directory\0Adef cleanup_autogenerated_completions_in_directory(dir):\0A    try:\0A        for filename in os.listdir(dir):\0A            # Skip non .fish files\0A            if not filename.endswith(\22.fish\22):\0A                continue\0A            path = os.path.join(dir, filename)\0A            cleanup_autogenerated_file(path)\0A    except OSError as err:\0A        return False\0A\0A\0A# Delete the file if it is autogenerated\0Adef cleanup_autogenerated_file(path):\0A    try:\0A        if file_is_overwritable(path):\0A            os.remove(path)\0A    except (OSError, IOError):\0A        pass\0A\0A\0Adef parse_manpage_at_path(manpage_path, output_directory):\0A    # Return if CMDNAME is in 'ignoredcommands'\0A    ignoredcommands = [\0A        \22cc\22,\0A        \22g++\22,\0A        \22gcc\22,\0A        \22c++\22,\0A        \22cpp\22,\0A        \22emacs\22,\0A        \22gprof\22,\0A        \22wget\22,\0A        \22ld\22,\0A        \22awk\22,\0A    ]\0A    if CMDNAME in ignoredcommands:\0A        return\0A\0A    # Ignore some commands' gazillion man pages\0A    # for subcommands - especially things we already have\0A    ignored_prefixes = [\0A        \22bundle-\22,\0A        \22cargo-\22,\0A        \22ffmpeg-\22,\0A        \22flatpak-\22,\0A        \22git-\22,\0A        \22npm-\22,\0A        \22openssl-\22,\0A        \22ostree-\22,\0A        \22perf-\22,\0A        \22perl\22,\0A        \22pip-\22,\0A        \22zsh\22,\0A    ]\0A    for prefix in ignored_prefixes:\0A        if CMDNAME.startswith(prefix):\0A            return\0A\0A    # Clear diagnostics\0A    global diagnostic_indent\0A    diagnostic_output[:] = []\0A    diagnostic_indent = 0\0A\0A    # Set up some diagnostics\0A    add_diagnostic(\22Considering \22 + manpage_path)\0A    diagnostic_indent += 1\0A\0A    if manpage_path.endswith(\22.gz\22):\0A        fd = gzip.open(manpage_path, \22r\22)\0A        manpage = fd.read()\0A        if IS_PY3:\0A            manpage = manpage.decode(\22latin-1\22)\0A    elif manpage_path.endswith(\22.bz2\22):\0A        fd = bz2.BZ2File(manpage_path, \22r\22)\0A        manpage = fd.read()\0A        if IS_PY3:\0A            manpage = manpage.decode(\22latin-1\22)\0A    elif manpage_path.endswith(\22.xz\22) or manpage_path.endswith(\22.lzma\22):\0A        if not lzma_available:\0A            return\0A        fd = lzma.LZMAFile(str(manpage_path), \22r\22)\0A        manpage = fd.read()\0A        if IS_PY3:\0A            manpage = manpage.decode(\22latin-1\22)\0A    elif manpage_path.endswith((\22.1\22, \22.2\22, \22.3\22, \22.4\22, \22.5\22, \22.6\22, \22.7\22, \22.8\22, \22.9\22)):\0A        if IS_PY3:\0A            fd = open(manpage_path, \22r\22, encoding=\22latin-1\22)\0A        else:\0A            fd = open(manpage_path, \22r\22)\0A        manpage = fd.read()\0A    else:\0A        return\0A    fd.close()\0A\0A    manpage = str(manpage)\0A\0A    # Ignore the millions of links to BUILTIN(1)\0A    if \22BUILTIN 1\22 in manpage or \22builtin.1\22 in manpage:\0A        return\0A\0A    # Clear the output list\0A    built_command_output[:] = []\0A    global already_output_completions\0A    already_output_completions = {}\0A\0A    if DEROFF_ONLY:\0A        parsers = [TypeDeroffManParser()]\0A    else:\0A        parsers = [\0A            TypeScdocManParser(),\0A            Type1ManParser(),\0A            Type2ManParser(),\0A            Type4ManParser(),\0A            Type3ManParser(),\0A            TypeDarwinManParser(),\0A            TypeDeroffManParser(),\0A        ]\0A    parsersToTry = [p for p in parsers if p.is_my_type(manpage)]\0A\0A    success = False\0A    for parser in parsersToTry:\0A        add_diagnostic(\22Trying %s\22 % parser.__class__.__name__)\0A        diagnostic_indent += 1\0A        success = parser.parse_man_page(manpage)\0A        diagnostic_indent -= 1\0A        # Make sure empty files aren't reported as success\0A        if not built_command_output:\0A            success = False\0A        if success:\0A            PARSER_INFO.setdefault(parser.__class__.__name__, []).append(CMDNAME)\0A            break\0A\0A    if success:\0A        if WRITE_TO_STDOUT:\0A            output_file = sys.stdout\0A        else:\0A            fullpath = os.path.join(output_directory, CMDNAME + \22.fish\22)\0A            try:\0A                output_file = codecs.open(fullpath, \22w\22, encoding=\22utf-8\22)\0A            except IOError as err:\0A                add_diagnostic(\0A                    \22Unable to open file '%s': error(%d): %s\22\0A                    % (fullpath, err.errno, err.strerror)\0A                )\0A                return False\0A\0A        # Output the magic word Autogenerated so we can tell if we can overwrite this\0A        built_command_output.insert(\0A            0, \22# \22 + CMDNAME + \22\\n# Autogenerated from man page \22 + manpage_path\0A        )\0A        # built_command_output.insert(2, \22# using \22 + parser.__class__.__name__) # XXX MISATTRIBUTES THE CULPABLE PARSER! Was really using Type2 but reporting TypeDeroffManParser\0A\0A        for line in built_command_output:\0A            output_file.write(line)\0A            output_file.write(\22\\n\22)\0A        output_file.write(\22\\n\22)\0A        add_diagnostic(manpage_path + \22 parsed successfully\22)\0A        if output_file != sys.stdout:\0A            output_file.close()\0A    else:\0A        parser_names = \22, \22.join(p.__class__.__name__ for p in parsersToTry)\0A        # add_diagnostic('%s contains no options or is unparsable' % manpage_path, BRIEF_VERBOSE)\0A        add_diagnostic(\0A            \22%s contains no options or is unparsable (tried parser %s)\22\0A            % (manpage_path, parser_names),\0A            BRIEF_VERBOSE,\0A        )\0A\0A    return success\0A\0A\0Adef parse_and_output_man_pages(paths, output_directory, show_progress):\0A    global diagnostic_indent, CMDNAME\0A    paths.sort()\0A    total_count = len(paths)\0A    successful_count, index = 0, 0\0A    padding_len = len(str(total_count))\0A    last_progress_string_length = 0\0A    if show_progress and not WRITE_TO_STDOUT:\0A        print(\0A            \22Parsing man pages and writing completions to {0}\22.format(output_directory)\0A        )\0A\0A    man_page_suffixes = set([os.path.splitext(m)[1][1:] for m in paths])\0A    lzma_xz_occurs = \22xz\22 in man_page_suffixes or \22lzma\22 in man_page_suffixes\0A    if lzma_xz_occurs and not lzma_available:\0A        add_diagnostic(\0A            'At least one man page is compressed with lzma or xz, but the \22lzma\22 module is not available.'\0A            \22 Any man page compressed with either will be skipped.\22,\0A            NOT_VERBOSE,\0A        )\0A        flush_diagnostics(sys.stderr)\0A\0A    for manpage_path in paths:\0A        index += 1\0A\0A        # Get the \22base\22 command, e.g. mkfs.xfs.8.gz -> mkfs.xfs\0A        man_file_name = os.path.basename(manpage_path)\0A        # 1. strip the optional compressor suffix\0A        CMDNAME, extension = os.path.splitext(man_file_name)\0A        # 2. strip mandatory section nu:ber\0A        if CMDNAME.endswith((\22.1\22, \22.2\22, \22.3\22, \22.4\22, \22.5\22, \22.6\22, \22.7\22, \22.8\22, \22.9\22)):\0A            CMDNAME, extension = os.path.splitext(CMDNAME)\0A        # 3. XXX strip optional version(?) number?\0A        # see comment above `already_output_completions = {}` line\0A\0A        # Show progress if we're doing that\0A        if show_progress:\0A            progress_str = \22  {0} / {1} : {2}\22.format(\0A                (str(index).rjust(padding_len)), total_count, man_file_name\0A            )\0A            # Pad on the right with spaces so we overwrite whatever we wrote last time\0A            padded_progress_str = progress_str.ljust(last_progress_string_length)\0A            last_progress_string_length = len(progress_str)\0A            sys.stdout.write(\22\\r{0}\\r\22.format(padded_progress_str))\0A            sys.stdout.flush()\0A\0A        try:\0A            if parse_manpage_at_path(manpage_path, output_directory):\0A                successful_count += 1\0A        except IOError:\0A            diagnostic_indent = 0\0A            add_diagnostic(\22Cannot open \22 + manpage_path)\0A        except (KeyboardInterrupt, SystemExit):\0A            raise\0A        except:\0A            add_diagnostic(\0A                \22Error parsing %s: %s\22 % (manpage_path, sys.exc_info()[0]),\0A                BRIEF_VERBOSE,\0A            )\0A            flush_diagnostics(sys.stderr)\0A            traceback.print_exc(file=sys.stderr)\0A        flush_diagnostics(sys.stderr)\0A    print(\22\22)  # Newline after loop\0A    add_diagnostic(\0A        \22Successfully parsed %d / %d pages\22 % (successful_count, total_count),\0A        BRIEF_VERBOSE,\0A    )\0A    flush_diagnostics(sys.stderr)\0A\0A\0Adef get_paths_from_man_locations():\0A    # Return all the paths to man(1) and man(8) files in the manpath\0A\0A    parent_paths = []\0A\0A    # Most (GNU, macOS, Haiku) modern implementations of man support being called with `--path`.\0A    # Traditional implementations require a second `manpath` program: examples include FreeBSD and Solaris.\0A    # Prefer an external program first because these programs return a superset of the $MANPATH variable.\0A    for prog in [[\22man\22, \22--path\22], [\22manpath\22]]:\0A        try:\0A            output = subprocess.check_output(prog, stderr=DEVNULL)\0A            if IS_PY3:\0A                output = output.decode(\22latin-1\22)\0A            parent_paths = output.strip().split(\22:\22)\0A            break\0A        except (OSError, subprocess.CalledProcessError):\0A            continue\0A    # If we can't have the OS interpret $MANPATH, just use it as-is (gulp).\0A    if not parent_paths and os.getenv(\22MANPATH\22):\0A        parent_paths = os.getenv(\22MANPATH\22).strip().split(\22:\22)\0A    # Fallback: With mandoc (OpenBSD, embedded Linux) and NetBSD man, the only way to get the default manpath is by reading /etc.\0A    if not parent_paths:\0A        try:\0A            with open(\22/etc/man.conf\22, \22r\22) as file:\0A                data = file.read()\0A                for key in [\22MANPATH\22, \22_default\22]:\0A                    for match in re.findall(r\22^%s\\s+(.*)$\22 % key, data, re.I | re.M):\0A                        parent_paths.append(match)\0A        except FileNotFoundError:\0A            pass\0A    # Fallback: hard-code some common paths. These should be likely for FHS Linux distros, BSDs, and macOS.\0A    if not parent_paths:\0A        parent_paths = [\22/usr/share/man\22, \22/usr/local/man\22, \22/usr/local/share/man\22]\0A        print(\0A            \22Unable to get the manpath, falling back to %s.\22 % \22:\22.join(parent_paths),\0A            \22Explictly set $MANPATH to fix this error.\22,\0A            file=sys.stderr,\0A        )\0A\0A    result = []\0A    for parent_path in parent_paths:\0A        for section in [\22man1\22, \22man6\22, \22man8\22]:\0A            directory_path = os.path.join(parent_path, section)\0A            try:\0A                names = os.listdir(directory_path)\0A            except OSError:\0A                names = []\0A            names.sort()\0A            for name in names:\0A                result.append(os.path.join(directory_path, name))\0A    return result\0A\0A\0Aif __name__ == \22__main__\22:\0A    script_name = sys.argv[0]\0A    parser = argparse.ArgumentParser(\0A        description=\22create_manpage_completions: Generate fish-shell completions from manpages\22\0A    )\0A    parser.add_argument(\0A        \22-c\22,\0A        \22--cleanup-in\22,\0A        type=str,\0A        help=\22Directories to clean up in\22,\0A        action=\22append\22,\0A    )\0A    parser.add_argument(\0A        \22-d\22,\0A        \22--directory\22,\0A        type=str,\0A        help=\22The directory to save the completions in\22,\0A    )\0A    parser.add_argument(\0A        \22-k\22,\0A    