@anon.1d0b41a8d45d477c3029ec78f9b8b434.3144 = private unnamed_addr constant [4579 x i8] c"function __fish_print_user_ids\0A    if command -sq getent\0A        for line in (getent passwd)\0A            set -l v (string split : -- $line)\0A            printf \22%s\\t%s\\n\22 $v[3] $v[1]\0A        end\0A    end\0Aend\0A\0Afunction __fish_print_group_ids\0A    if command -sq getent\0A        for line in (getent group)\0A            set -l v (string split : -- $line)\0A            printf \22%s\\t%s\\n\22 $v[3] $v[1]\0A        end\0A    end\0Aend\0A\0Afunction __fish_complete_mount_opts\0A    set -l fish_mount_opts \\\0A        async\\t'Use asynchronous I/O' \\\0A        atime\\t'Update time on each access' \\\0A        noatime\\t'Do not update time on each access' \\\0A        auto\\t'Mounted with' \\\0A        noauto\\t'Not mounted by -a' \\\0A        defaults\\t'Use default options' \\\0A        dev\\t'Interpret character/block special devices' \\\0A        nodev\\t'Do not interpret character/block special devices' \\\0A        diratime\\t'Update directory inode access time' \\\0A        nodiratime\\t'Don\\'t update directory inode access time' \\\0A        dirsync\\t'Use synchronous directory operations' \\\0A        exec\\t'Permit executables' \\\0A        noexec\\t'Do not permit executables' \\\0A        group\\t'Any user within device group may mount' \\\0A        iversion\\t'Increment i_version field on inode modification' \\\0A        noiversion\\t'Don\\'t increment i_version field on inode modification' \\\0A        mand\\t'Allow mandatory locks' \\\0A        nomand\\t'Don\\'t allow mandatory locks' \\\0A        _netdev\\t'Filesystem uses network' \\\0A        nofail\\t'Don\\'t report errors' \\\0A        relatime\\t'Update inode access times' \\\0A        norelatime\\t'Don\\'t update inode access times' \\\0A        strictatime \\\0A        nostrictatime \\\0A        lazytime \\\0A        nolazytime \\\0A        suid\\t'Allow suid bits' \\\0A        nosuid\\t'Ignore suid bits' \\\0A        silent \\\0A        loud \\\0A        owner \\\0A        remount\\t'Remount read-only filesystem' \\\0A        ro\\t'Mount read-only' \\\0A        rw\\t'Mount read-write' \\\0A        sync\\t'Use synchronous I/O' \\\0A        user\\t'Any user may mount' \\\0A        nouser\\t'Only root may mount' \\\0A        users\\t'Any user may mount and unmount' \\\0A        protect \\\0A        usemp \\\0A        verbose \\\0A        {grp,no,usr,}quota \\\0A        autodefrag \\\0A        compress \\\0A        compress-force \\\0A        degraded \\\0A        discard \\\0A        enospc_debug \\\0A        flushoncommit \\\0A        inode_cache \\\0A        context=\\t'Set SELinux context' \\\0A        uid= \\\0A        gid= \\\0A        ownmask= \\\0A        othmask= \\\0A        setuid= \\\0A        setgid= \\\0A        mode= \\\0A        prefix= \\\0A        volume= \\\0A        reserved= \\\0A        root= \\\0A        bs= \\\0A        alloc_start= \\\0A        check_int{,_data,_print,_mask}= \\\0A        commit= \\\0A        compress= \\\0A        compress-force= \\\0A        device= \\\0A        fatal_errors= \\\0A        max_inline= \\\0A        metadata_ratio= \\\0A        noacl \\\0A        nobarrier \\\0A        nodatacow \\\0A        nodatasum \\\0A        notreelog \\\0A        recovery \\\0A        rescan_uuid_tree \\\0A        skip_balance \\\0A        nospace_cache \\\0A        clear_cache \\\0A        ssd \\\0A        nossd \\\0A        ssd_spread \\\0A        subvol= \\\0A        subvolrootid= \\\0A        thread_pool= \\\0A        user_subvol_rm_allowed \\\0A        acl \\\0A        noacl \\\0A        bsddf \\\0A        minixdf \\\0A        check=none \\\0A        nocheck \\\0A        debug \\\0A        errors={continue,remount-ro,panic} \\\0A        grpid \\\0A        bsdgroups \\\0A        bsdgroups \\\0A        bsdgroups \\\0A        nouid32 \\\0A        grpquota \\\0A        grpquota \\\0A        resgid= \\\0A        resuid= \\\0A        sb= \\\0A        {user,nouser}_xattr \\\0A        journal={update,unum} \\\0A        journal{_dev,_path}= \\\0A        norecovery \\\0A        noload \\\0A        data={journal,ordered,writeback} \\\0A        data_err={ignore,abort} \\\0A        barrier={0,1} \\\0A        user_xattr \\\0A        acl\0A\0A    set -l token (commandline -tc | string replace -r '^-o' -- '')\0A    set -l args (string split , -- $token)\0A\0A    if test (count $args) -ne 0\0A        set -l last_arg $args[-1]\0A        set -e args[-1]\0A\0A        switch (string replace -r '=.*' '=' -- $last_arg)\0A            case uid=\0A                set -a fish_mount_opts uid=(__fish_print_user_ids)\0A            case gid=\0A                set -a fish_mount_opts gid=(__fish_print_group_ids)\0A            case setuid=\0A                set -a fish_mount_opts setuid=(__fish_print_user_ids)\0A            case setgid=\0A                set -a fish_mount_opts setgid=(__fish_print_group_ids)\0A        end\0A    end\0A\0A    set -l prefix ''\0A    if set -q args[1]\0A        set prefix (string join , -- $args),\0A    end\0A\0A    printf '%s\\n' $prefix$fish_mount_opts\0Aend\0A", align 1
