@anon.1d0b41a8d45d477c3029ec78f9b8b434.2324 = private unnamed_addr constant [7374 x i8] c"# Lists PHPUnit test suites\0Afunction __fish_phpunit_list_suites\0A    __fish_phpunit_list --list-suites\0Aend\0A\0A# Lists PHPUnit test groups\0Afunction __fish_phpunit_list_groups\0A    __fish_phpunit_list --list-groups\0Aend\0A\0A# Lists PHPUnit objects corresponding to the given option\0Afunction __fish_phpunit_list --argument-names option\0A    # Use the same PHPUnit binary as in the command being completed\0A    set -l phpunit (commandline -xpc)[1]\0A    test -x $phpunit\0A    or return\0A\0A    $phpunit $option | tail -n +4 | string trim -c ' -'\0Aend\0A\0A# Code Coverage Options:\0Acomplete -x -c phpunit -l coverage-clover -d 'Generate code coverage report in Clover XML format'\0Acomplete -x -c phpunit -l coverage-crap4j -d 'Generate code coverage report in Crap4J XML format'\0Acomplete -x -c phpunit -l coverage-html -d 'Generate code coverage report in HTML format'\0Acomplete -x -c phpunit -l coverage-php -d 'Export PHP_CodeCoverage object to file'\0Acomplete -x -c phpunit -l coverage-text -d 'Generate code coverage report in text format'\0Acomplete -x -c phpunit -l coverage-xml -d 'Generate code coverage report in PHPUnit XML format'\0Acomplete -x -c phpunit -l whitelist -d 'Whitelist <dir> for code coverage analysis'\0Acomplete -f -c phpunit -l disable-coverage-ignore -d 'Disable annotations for ignoring code coverage'\0Acomplete -f -c phpunit -l no-coverage -d 'Ignore code coverage configuration'\0Acomplete -x -c phpunit -l dump-xdebug-filter -d 'Generate script to set Xdebug code coverage filter'\0A\0A# Logging Options:\0Acomplete -x -c phpunit -l log-junit -d 'Log test execution in JUnit XML format to file'\0Acomplete -x -c phpunit -l log-teamcity -d 'Log test execution in TeamCity format to file'\0Acomplete -x -c phpunit -l testdox-html -d 'Write agile documentation in HTML format to file'\0Acomplete -x -c phpunit -l testdox-text -d 'Write agile documentation in Text format to file'\0Acomplete -x -c phpunit -l testdox-xml -d 'Write agile documentation in XML format to file'\0Acomplete -f -c phpunit -l reverse-list -d 'Print defects in reverse order'\0A\0A# Test Selection Options:\0Acomplete -x -c phpunit -l filter -d 'Filter which tests to run'\0Acomplete -x -c phpunit -l testsuite -a '(__fish_phpunit_list_suites)' -d 'Filter which testsuite to run'\0Acomplete -x -c phpunit -l group -a '(__fish_phpunit_list_groups)' -d 'Only runs tests from the specified group(s)'\0Acomplete -f -c phpunit -l exclude-group -d 'Exclude tests from the specified group(s)'\0Acomplete -f -c phpunit -l list-groups -d 'List available test groups'\0Acomplete -f -c phpunit -l list-suites -d 'List available test suites'\0Acomplete -f -c phpunit -l list-tests -d 'List available tests'\0Acomplete -x -c phpunit -l list-tests-xml -d 'List available tests in XML format'\0Acomplete -x -c phpunit -l test-suffix -d 'Only search for test in files with specified suffix(es). Default: Test.php,.phpt'\0A\0A# Test Execution Options:\0Acomplete -f -c phpunit -l dont-report-useless-tests -d 'Do not report tests that do not test anything'\0Acomplete -f -c phpunit -l strict-coverage -d 'Be strict about @covers annotation usage'\0Acomplete -f -c phpunit -l strict-global-state -d 'Be strict about changes to global state'\0Acomplete -f -c phpunit -l disallow-test-output -d 'Be strict about output during tests'\0Acomplete -f -c phpunit -l disallow-resource-usage -d 'Be strict about resource usage during small tests'\0Acomplete -f -c phpunit -l enforce-time-limit -d 'Enforce time limit based on test size'\0Acomplete -f -c phpunit -l default-time-limit -d 'Timeout in seconds for tests without @small, @medium or @large'\0Acomplete -f -c phpunit -l disallow-todo-tests -d 'Disallow @todo-annotated tests'\0A\0Acomplete -f -c phpunit -l process-isolation -d 'Run each test in a separate PHP process'\0Acomplete -f -c phpunit -l globals-backup -d 'Backup and restore $GLOBALS for each test'\0Acomplete -f -c phpunit -l static-backup -d 'Backup and restore static attributes for each test'\0A\0Acomplete -f -c phpunit -l colors -a 'never auto always' -d 'Use colors in output'\0Acomplete -x -c phpunit -l columns -a max -d 'Number of columns to use for progress output'\0Acomplete -f -c phpunit -l stderr -d 'Write to STDERR instead of STDOUT'\0Acomplete -f -c phpunit -l stop-on-defect -d 'Stop execution upon first not-passed test'\0Acomplete -f -c phpunit -l stop-on-error -d 'Stop execution upon first error'\0Acomplete -f -c phpunit -l stop-on-failure -d 'Stop execution upon first error or failure'\0Acomplete -f -c phpunit -l stop-on-warning -d 'Stop execution upon first warning'\0Acomplete -f -c phpunit -l stop-on-risky -d 'Stop execution upon first risky test'\0Acomplete -f -c phpunit -l stop-on-skipped -d 'Stop execution upon first skipped test'\0Acomplete -f -c phpunit -l stop-on-incomplete -d 'Stop execution upon first incomplete test'\0Acomplete -f -c phpunit -l fail-on-warning -d 'Treat tests with warnings as failures'\0Acomplete -f -c phpunit -l fail-on-risky -d 'Treat risky tests as failures'\0Acomplete -f -c phpunit -s v -l verbose -d 'Output more verbose information'\0Acomplete -f -c phpunit -l debug -d 'Display debugging information'\0A\0Acomplete -x -c phpunit -l loader -d 'TestSuiteLoader implementation to use'\0Acomplete -x -c phpunit -l repeat -d 'Runs the test(s) repeatedly'\0Acomplete -f -c phpunit -l teamcity -d 'Report test execution progress in TeamCity format'\0Acomplete -f -c phpunit -l testdox -d 'Report test execution progress in TestDox format'\0Acomplete -f -c phpunit -l testdox-group -d 'Only include tests from the specified group(s)'\0Acomplete -f -c phpunit -l testdox-exclude-group -d 'Exclude tests from the specified group(s)'\0Acomplete -x -c phpunit -l no-interaction -d 'Disable TestDox progress animation'\0Acomplete -x -c phpunit -l printer -d 'TestListener implementation to use'\0A\0Acomplete -x -c phpunit -l order-by -a 'default defects duration no-depends random reverse size' -d 'Run tests in order'\0Acomplete -x -c phpunit -l random-order-seed -d 'Use a specific random seed for random order'\0Acomplete -f -c phpunit -l cache-result -d 'Write test results to cache file'\0Acomplete -f -c phpunit -l do-not-cache-result -d 'Do not write test results to cache file'\0A\0A# Configuration Options:\0Acomplete -x -c phpunit -l prepend -d 'A PHP script that is included as early as possible'\0Acomplete -x -c phpunit -l bootstrap -d 'A PHP script that is included before the tests run'\0Acomplete -x -c phpunit -s c -l configuration -k -a '(__fish_complete_suffix .xml .xml.dist)' -d 'Read configuration from XML file'\0Acomplete -f -c phpunit -l no-configuration -d 'Ignore default configuration file (phpunit.xml)'\0Acomplete -f -c phpunit -l no-logging -d 'Ignore logging configuration'\0Acomplete -f -c phpunit -l no-extensions -d 'Do not load PHPUnit extensions'\0Acomplete -f -c phpunit -l include-path -d 'Prepend PHP\\'s include_path with given path(s)'\0Acomplete -x -c phpunit -s d -d 'Sets a php.ini value in the format key[=value]'\0Acomplete -f -c phpunit -l generate-configuration -d 'Generate configuration file with suggested settings'\0Acomplete -x -c phpunit -l cache-result-file -d 'Specify result cache path and filename'\0A\0A# Miscellaneous Options:\0Acomplete -f -c phpunit -s h -l help -d 'Prints usage information'\0Acomplete -f -c phpunit -l version -d 'Prints the version and exits'\0Acomplete -x -c phpunit -l atleast-version -d 'Checks that version is greater than min and exits'\0Acomplete -f -c phpunit -l check-version -d 'Check whether PHPUnit is the latest version'\0A", align 1
