@anon.1d0b41a8d45d477c3029ec78f9b8b434.2426 = private unnamed_addr constant [1559 x i8] c"function __fish_print_pygmentize\0A    set -l lines (pygmentize -L $argv[1] | string match -r '^(?:\\* |    ).*(?:)$' | string replace -r '\\* (.*):$' '$1' | string replace -r '^(.*)\\.$' '$1' | string trim)\0A\0A    while set -q lines[2]\0A        set -l names (string split \22, \22 $lines[1])\0A        for name in $names\0A            printf '%s\\t%s\\n' $name $lines[2]\0A        end\0A\0A        set -e lines[1]\0A        set -e lines[1]\0A    end\0Aend\0A\0Acomplete -c pygmentize -s o -d \22Set output file\22\0Acomplete -c pygmentize -s s -d \22Read one line at a time\22\0Acomplete -c pygmentize -s l -d \22Set lexer\22 -x -a \22(__fish_print_pygmentize lexers Lexer)\22\0Acomplete -c pygmentize -s g -d \22Guess lexer\22\0Acomplete -c pygmentize -s f -d \22Set formatter\22 -x -a \22(__fish_print_pygmentize formatters Formatter)\22\0Acomplete -c pygmentize -s O -d \22Set coma-separated options\22 -x\0Acomplete -c pygmentize -s P -d \22Set one option\22 -x\0Acomplete -c pygmentize -s F -d \22Set filter\22 -x -a \22(__fish_print_pygmentize filters Filter)\22\0Acomplete -c pygmentize -s S -d \22Print style definition for given style\22 -x -a \22(__fish_print_pygmentize styles Style)\22\0Acomplete -c pygmentize -s L -d \22List lexers, formatters, styles or filters\22 -x -a \22lexers formatters styles filters\22\0Acomplete -c pygmentize -s N -d \22Guess and print lexer name based on given file\22\0Acomplete -c pygmentize -s H -d \22Print detailed help\22 -x -a \22lexer formatter filter\22\0Acomplete -c pygmentize -s v -d \22Print detailed traceback on unhandled exceptions\22\0Acomplete -c pygmentize -s h -d \22Print help\22\0Acomplete -c pygmentize -s V -d \22Print package version\22\0A", align 1
