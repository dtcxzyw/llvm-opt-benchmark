@anon.1d0b41a8d45d477c3029ec78f9b8b434.2392 = private unnamed_addr constant [11502 x i8] c"#completion for prt-get\0A# A function to verify if prt-get (the crux package management tool) needs to be completed by a further command\0A\0A# a function to obtain a list of installed packages with prt-get\0Afunction __fish_prt_packages -d 'Obtain a list of installed packages'\0A    prt-get listinst\0Aend\0A\0A# a function to obtain a list of ports with prt-get\0A\0Afunction __fish_prt_ports -d 'Obtain a list of ports'\0A    prt-get list\0Aend\0A\0Afunction __fish_prt_no_subcommand -d 'Test if prt-get has yet to be given the command'\0A    for i in (commandline -xpc)\0A        if contains -- $i install depinst grpinst update remove sysup lock unlock listlocked diff quickdiff search dsearch fsearch info path readme depends quickdep dependent deptree dup list printf listinst listorphans isinst current ls cat edit help dumpconfig version cache\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0A# a function to verify if prt-get should have packages as potential completion\0Afunction __fish_prt_use_package -d 'Test if prt-get should have packages as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i update remove lock unlock current\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0A# a function to test if prt-get should have ports as potential completions\0Afunction __fish_prt_use_port -d 'Test if prt-get should have ports as potential completion'\0A    for i in (commandline -xpc)\0A        if contains -- $i install depinst grpinst diff depends quickdep dependent deptree isinst info path readme ls cat edit\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Acomplete -f -c prt-get -n __fish_prt_use_package -a '(__fish_prt_packages)' -d Package\0Acomplete -f -c prt-get -n __fish_prt_use_port -a '(__fish_prt_ports)' -d Port\0A\0Acomplete -f -n __fish_prt_no_subcommand -c prt-get -a ins