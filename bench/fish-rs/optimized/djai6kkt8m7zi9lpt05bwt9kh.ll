@anon.1d0b41a8d45d477c3029ec78f9b8b434.3148 = private unnamed_addr constant [6155 x i8] c"function __fish_complete_netcat\0A    set -l nc $argv[1]\0A    set -l flavor $argv[-1]\0A\0A    switch $flavor\0A        case busybox\0A            complete -c $nc -s l -d \22Listen mode, for inbound connects\22\0A            complete -c $nc -s p -x -d \22Local port\22\0A            complete -c $nc -s w -x -d \22Connect timeout\22\0A            complete -c $nc -s i -x -d \22Delay interval for lines sent\22\0A            complete -c $nc -s f -r -d \22Use file (ala /dev/ttyS0) instead of network\22\0A            complete -c $nc -s e -r -d \22Run PROG after connect\22\0A\0A        case ncat\0A            complete -c $nc -w ncat\0A\0A        case nc.openbsd\0A            complete -c $nc -s 4 -d \22Forces nc to use IPv4 addresses only\22\0A            complete -c $nc -s 6 -d \22Forces nc to use IPv6 addresses only\22\0A            complete -c $nc -s b -d \22Allow broadcast\22\0A            complete -c $nc -s C -d \22Send CRLF as line-ending\22\0A            complete -c $nc -s D -d \22Enable debugging on the socket\22\0A            complete -c $nc -s d -d \22Do not attempt to read from stdin\22\0A            complete -c $nc -s F -d \22Pass the first connected socket using sendmsg(2) to stdout and exit\22\0A            complete -c $nc -s h -d \22Prints out nc help\22\0A            complete -c $nc -s I -x -d \22Specifies the size of the TCP receive buffer\22\0A            complete -c $nc -s i -x -d \22Specifies a delay time interval between lines of text sent and received\22\0A            complete -c $nc -s k -d \22Forces nc to stay listening for another connection after its current connection is completed\22\0A            complete -c $nc -s l -d \22Used to specify that nc should listen for an incoming connection rather than initiate a connection to a remote host\22\0A            complete -c $nc -s M -x -d \22Set the TTL / hop limit of outgoing packets\22\0A            complete -c $nc -s m -x -d \22Ask the kernel to drop incoming packets whose TTL / hop limit is under minttl\22\0A            complete -c $nc -s N -d \22shutdown(2) the network socket after EOF on the input\22\0A            complete -c $nc -s n -d \22Do not do any DNS or service lookups on any specified addresses, hostnames or ports\22\0A            complete -c $nc -s O -x -d \22Specifies the size of the TCP send buffer\22\0A            complete -c $nc -s P -x -d \22Specifies a username to present to a proxy server that requires authentication\22\0A            complete -c $nc -s p -x -d \22Specifies the source port nc should use, subject to privilege restrictions and availability\22\0A            complete -c $nc -s q -x -d \22after EOF on stdin, wait the specified number of seconds and then quit\22\0A            complete -c $nc -s r -d \22Specifies that source and/or destination ports should be chosen randomly instead of sequentially within a range or in the order that the system assigns them\22\0A            complete -c $nc -s S -d \22Enables the RFC 2385 TCP MD5 signature option\22\0A            complete -c $nc -s s -x -d \22Specifies the IP of the interface which is used to send the packets\22\0A            complete -c $nc -s T -x -a \22critical inetcontrol lowcost lowdelay netcontrol throughput reliability ef af cs0 cs1 cs2 cs3 cs4 cs5 cs6 cs7\22 -d \22Change IPv4 TOS value\22\0A            complete -c $nc -s t -d \22Causes nc to send RFC 854 DON'T and WON'T responses to RFC 854 DO and WILL requests\22\0A            complete -c $nc -s U -d \22Specifies to use UNIX-domain sockets\22\0A            complete -c $nc -s u -d \22Use UDP instead of the default option of TCP\22\0A            complete -c $nc -s V -x -d \22Set the routing table to be used\22\0A            complete -c $nc -s v -d \22Have nc give more verbose output\22\0A            complete -c $nc -s W -x -d \22Terminate after receiving recvlimit packets from the network\22\0A            complete -c $nc -s w -x -d \22Connections which cannot be established or are idle timeout after timeout seconds\22\0A            function __fish_complete_nc-connect-openbsd\0A                printf \22connect\\tHTTPS proxy\\n\22\0A                printf \224\\tSOCKS v.4\\n\22\0A                printf \225\\tSOCKS v.5\\n\22\0A            end\0A            complete -c $nc -s X -x -a \22(__fish_complete_nc-connect-openbsd)\22 -d \22Requests that nc should use the specified protocol when talking to the proxy server\22\0A            complete -c $nc -s x -x -a \22(__fish_print_hostnames)\22 -d \22Requests that nc should connect to destination using a proxy at proxy_address and port\22\0A            complete -c $nc -s Z -d \22DCCP mode\22\0A            complete -c $nc -s z -d \22Specifies that nc should just scan for listening daemons, without sending any data to them\22\0A\0A        case nc.traditional '*' # fallback to the most restricted one\0A            complete -c $nc -s c -r -d \22specify shell commands to exec after connect\22\0A            complete -c $nc -s e -r -d \22specify filename to exec after connect\22\0A            complete -c $nc -s g -x -d \22source-routing hop point[s], up to 8\22\0A            complete -c $nc -s G -x -d \22source-routing pointer: 4, 8, 12, ...\22\0A            complete -c $nc -s h -d \22display help\22\0A            complete -c $nc -s i -x -d \22delay interval for lines sent, ports scanned\22\0A            complete -c $nc -s l -d \22listen mode, for inbound connects\22\0A            complete -c $nc -s n -d \22numeric-only IP addresses, no DNS\22\0A            complete -c $nc -s o -r -d \22hex dump of traffic\22\0A            complete -c $nc -s p -x -d \22local port number (port numbers can be individual or ranges: lo-hi [inclusive])\22\0A            complete -c $nc -s q -x -d \22after EOF on stdin, wait the specified number of seconds and then quit\22\0A            complete -c $nc -s b -d \22allow UDP broadcasts\22\0A            complete -c $nc -s r -d \22randomize local and remote ports\22\0A            complete -c $nc -s s -x -d \22local source address\22\0A            complete -c $nc -s t -d \22enable telnet negotiation\22\0A            complete -c $nc -s u -d \22UDP mode\22\0A            complete -c $nc -s v -d \22verbose [use twice to be more verbose]\22\0A            complete -c $nc -s w -x -d \22timeout for connects and final net reads\22\0A            complete -c $nc -s C -d \22Send CRLF as line-ending\22\0A            complete -c $nc -s z -d \22zero-I/O mode [used for scanning]\22\0A            complete -c $nc -s T -x -a \22Minimize-Delay Maximize-Throughput Maximize-Reliability Minimize-Cost\22 -x -d \22set TOS flag\22\0A    end\0Aend\0A", align 1
