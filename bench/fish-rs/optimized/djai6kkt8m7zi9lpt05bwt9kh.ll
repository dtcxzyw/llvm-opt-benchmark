@anon.1d0b41a8d45d477c3029ec78f9b8b434.2698 = private unnamed_addr constant [9033 x i8] c"function __fish_complete_tar -d \22Peek inside of archives and list all files\22\0A    set -l args (commandline -pxc)\0A    while count $args >/dev/null\0A        switch $args[1]\0A            case '-*f' --file\0A                set -e args[1]\0A                if test -f $args[1]\0A                    set -l file_list (tar -atf $args[1] 2> /dev/null)\0A                    if test -n \22$file_list\22\0A                        printf \22%s\\tArchived file\\n\22 $file_list\0A                    end\0A                    return\0A                end\0A            case '*'\0A                set -e args[1]\0A                continue\0A        end\0A    end\0Aend\0A\0Acomplete -c tar -a \22(__fish_complete_tar)\22\0A\0A## Operation mode\0Acomplete -c tar -s A -l catenate -l concatenate -d \22Append archive to archive\22\0Acomplete -c tar -s c -l create -d \22Create archive\22\0Acomplete -c tar -s d -l diff -l compare -d \22Compare archive and filesystem\22\0Acomplete -c tar -l delete -d \22Delete from archive\22\0Acomplete -c tar -s r -l append -d \22Append files to archive\22\0Acomplete -c tar -s t -l list -d \22List archive\22\0Acomplete -c tar -l test-label -d \22Test the archive volume label\22\0Acomplete -c tar -s u -l update -d \22Append new files\22\0Acomplete -c tar -s x -l extract -l get -d \22Extract from archive\22\0Acomplete -c tar -l show-defaults -d \22Show built-in defaults for various tar options\22\0Acomplete -c tar -s \\? -l help -d \22Display short option summary\22\0Acomplete -c tar -l usage -d \22List available options\22\0Acomplete -c tar -l version -d \22Print program version and copyright information\22\0A\0A## Operation modifiers\0A\0Acomplete -c tar -l check-device -d \22Check device numbers when creating incremental archives\22\0Acomplete -c tar -s g -l listed-incremental -r -d \22Handle new GNU-format incremental backups\22\0Acomplete -c tar -l hole-detect