@anon.1d0b41a8d45d477c3029ec78f9b8b434.2936 = private unnamed_addr constant [4733 x i8] c"# Completions for xbps-query\0A# Author: Allen Sobot <chilledfrogs@disroot.org>\0A\0Aset -l progname xbps-query\0A\0Aset -l listall \22(__fish_print_xbps_packages)\22\0Aset -l listinstalled \22(__fish_print_xbps_packages -i)\22\0A\0Afunction __fish_print_xbps_pkg_props\0A    printf 'alternatives\\tList of alternatives provided by the package\\n'\0A    printf 'architecture\\tArchitecture of machine\\n'\0A    printf 'archive-compression-type\\tType of archive\\'s compression format\\n'\0A    printf 'automatic-install\\tWas the package installed automatically\\n'\0A    printf 'build-options\\tOptions used to build the package\\n'\0A    printf 'conf_files\\tList of provided system configuration files\\n'\0A    printf 'conflicts\\tList of packages the package conflicts with\\n'\0A    printf 'filename-sha256\\tFilename\\'s sha256\\n'\0A    printf 'filename-size\\tFilename\\'s size\\n'\0A    printf 'homepage\\tHomepage of the package\\n'\0A    printf 'install-date\\tDate the package was installed\\n'\0A    printf 'install-msg\\tMessage printed during installation\\n'\0A    printf 'install-script\\tPrint the package\\'s install script\\n'\0A    printf 'installed_size\\tSize of the package\\n'\0A    printf 'license\\tLicense of the package\\n'\0A    printf 'maintainer\\tMaintainer of the package\\n'\0A    printf 'metafile-sha256\\tMetafile\\'s sha256\\n'\0A    printf 'pkgver\\tThe package\\'s name/version tuple\\n'\0A    printf 'preserve\\tWill files be preserved after update\\n'\0A    printf 'provides\\tList of virtual packages provided by the package\\n'\0A    printf 'remove-msg\\tMessage printed during removal\\n'\0A    printf 'remove-script\\tPrint the package\\'s removal script\\n'\0A    printf 'replaces\\tList of packages the package replaces\\n'\0A    printf 'repository\\tRepo where package was downloaded from\\n'\0A    printf 'run_depends\\tList of packages required to run the package\\n'\0A    printf 'reverts\\tList of versions the package reverts\\n'\0A    printf 'shlib-provides\\tList of provided shared libraries\\n'\0A    printf 'shlib-requires\\tList of required shared libraries\\n'\0A    printf 'short_desc\\tShort description of the package\\n'\0A    printf 'source-revisions\\tGit revision used to build the package\\n'\0A    printf 'state\\tState of the package\\n'\0Aend\0A\0Acomplete -c $progname -f\0Acomplete -c $progname -a \22$listinstalled\22\0Acomplete -c $progname -n \22__fish_contains_opt -s R\22 -a \22$listall\22\0A\0Acomplete -c $progname -s C -d 'Use this XBPS configuration directory' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s c -d 'Use this cache directory to store binary packages' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s d -d 'Enable extra debugging shown to stderr'\0Acomplete -c $progname -s h -d 'Show the help message'\0Acomplete -c $progname -s i -d 'Ignore repositories defined in configuration files'\0Acomplete -c $progname -s M -d 'For remote repositories, the data is fetched and stored in memory only'\0Acomplete -c $progname -s p -d 'Match one or more package properties' -xa \22(__fish_complete_list , __fish_print_xbps_pkg_props)\22\0Acomplete -c $progname -s R -d 'Enable repository mode'\0Acomplete -c $progname -l repository -d 'Append the specified repository to the top of the list'\0Acomplete -c $progname -l regex -d 'Use Extended Regular Expressions'\0Acomplete -c $progname -l fulldeptree -d 'Print a full dependency tree in the show dependencies mode'\0Acomplete -c $progname -s r -d 'Use this path for the target root directory' -xa \22(__fish_complete_directories)\22\0Acomplete -c $progname -s v -d 'Enables verbose messages'\0Acomplete -c $progname -s V -d 'Show the version information'\0Acomplete -c $progname -s l -d 'List registered packages in the package database (pkgdb)'\0Acomplete -c $progname -s H -d 'List registered packages in the package database (pkgdb) that are on hold'\0Acomplete -c $progname -s L -d 'List repositories and the number of packages contained on them'\0Acomplete -c $progname -s m -d 'List packages in the package database (pkgdb) that were installed manually'\0Acomplete -c $progname -s O -d 'List package orphans in the package database (pkgdb)'\0Acomplete -c $progname -s o -d 'Search for installed package files by matching PATTERN'\0Acomplete -c $progname -s S -d 'Shows information of an installed package' -x\0Acomplete -c $progname -s s -d 'Search for packages by matching PATTERN on pkgver or short_desc'\0Acomplete -c $progname -s f -d 'Show the package files for PKG' -x\0Acomplete -c $progname -s x -d 'Show the required dependencies for PKG.  Only direct dependencies are shown' -x\0Acomplete -c $progname -s X -d 'Show the reverse dependencies for PKG' -xa \22$listinstalled\22\0Acomplete -c $progname -s X -d 'Show the reverse dependencies for PKG' -x -n \22__fish_contains_opt -s R\22 -a \22$listall\22\0Acomplete -c $progname -l cat -d 'Prints the file FILE stored in binary package PKG to stdout' -F\0A", align 1
