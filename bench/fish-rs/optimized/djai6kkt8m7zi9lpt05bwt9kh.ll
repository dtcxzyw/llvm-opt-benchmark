@anon.1d0b41a8d45d477c3029ec78f9b8b434.1602 = private unnamed_addr constant [2949 x i8] c"function __fish_complete_jails\0A    ezjail-admin list | tail +3 | awk '{ print $4 }'\0Aend\0A\0Afunction __fish_complete_running_jails\0A    ezjail-admin list | tail +3 | string match -r '^.R' | awk '{ print $4 }'\0Aend\0A\0Afunction __fish_complete_stopped_jails\0A    ezjail-admin list | tail +3 | string match -r '^.S' | awk '{ print $4 }'\0Aend\0A\0A# archive\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a archive -d \22create a backup of one or several jails\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from archive\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# config\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a config -d \22manage specific jails\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from config\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# console\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a console -d \22attach your console to a running jail\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from console\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# create\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a create -d \22installs a new jail inside ezjail's scope\22\0A\0A# delete\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a delete -d \22removes a jail from ezjail's config\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from delete\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# freeze\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a freeze -d \22dump diffs between jail initialisation and freeze time into a flavour\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from freeze\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# install\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a install -d \22create the basejail from binary packages\22\0A\0A# list\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a list -d \22list all jails\22\0A\0A# restart\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a restart -d \22restart a running jail\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from restart\22 -a \22(__fish_complete_running_jails)\22 -d jail\0A\0A# restore\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a restore -d \22create new jails from archived versions\22\0A\0A# snapshot\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a snapshot -d \22create a snapshot of a jail\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from snapshot\22 -a \22(__fish_complete_jails)\22 -d jail\0A\0A# start\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a start -d \22start a jail\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from start\22 -a \22(__fish_complete_stopped_jails)\22 -d jail\0A\0A# stop\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a stop -d \22stop a running jail\22\0Acomplete -xc ezjail-admin -n \22__fish_seen_subcommand_from stop\22 -a \22(__fish_complete_running_jails)\22 -d jail\0A\0A# troubleshoot\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a troubleshoot -d \22check for reasons for the jails to fail\22\0A\0A# update\0Acomplete -xc ezjail-admin -n __fish_use_subcommand -a update -d \22create or update the basejail from source\22\0A", align 1
