@anon.1d0b41a8d45d477c3029ec78f9b8b434.3444 = private unnamed_addr constant [29315 x i8] c"# based off of the git-prompt script that ships with git\0A# hence licensed under GPL version 2 (like the rest of fish).\0A#\0A# Written by Lily Ballard and updated by Brian Gernhardt and fish contributors\0A#\0A# This is based on git's git-prompt.bash script, Copyright (C) 2006,2007 Shawn O. Pearce <spearce@spearce.org>.\0A# The act of porting the code, along with any new code, are Copyright (C) 2012 Lily Ballard.\0A\0Afunction __fish_git_prompt_show_upstream --description \22Helper function for fish_git_prompt\22\0A    set -l show_upstream $__fish_git_prompt_showupstream\0A    set -l svn_prefix # For better SVN upstream information\0A    set -l informative\0A\0A    set -l svn_url_pattern\0A    set -l count\0A    set -l upstream git\0A    set -l verbose\0A    set -l name\0A\0A    # Default to informative if __fish_git_prompt_show_informative_status is set\0A    if contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A        set informative 1\0A    end\0A\0A    set -l svn_remote\0A    # get some config options from git-config\0A    command git config -z --get-regexp '^(svn-remote\\..*\\.url|bash\\.showupstream)$' 2>/dev/null | while read -lz key value\0A        switch $key\0A            case bash.showupstream\0A                set show_upstream $value\0A                test -n \22$show_upstream\22\0A                or return\0A            case svn-remote.'*'.url\0A                set svn_remote $svn_remote $value\0A                # Avoid adding \\| to the beginning to avoid needing #?? later\0A                if test -n \22$svn_url_pattern\22\0A                    set svn_url_pattern $svn_url_pattern\22|$value\22\0A                else\0A                    set svn_url_pattern $value\0A                end\0A                set upstream svn+git # default upstream is SVN if available, else git\0A\0A                # Save the config key (without .url) for later use\0A                set -l remote_prefix (string replace -r '\\.url$' '' -- $key)\0A                set svn_prefix $svn_prefix $remote_prefix\0A        end\0A    end\0A\0A    # parse configuration variables\0A    # and clear informative default when needed\0A    for option in $show_upstream\0A        switch $option\0A            case git svn\0A                set upstream $option\0A                set -e informative\0A            case verbose\0A                set verbose 1\0A                set -e informative\0A            case informative\0A                set informative 1\0A            case name\0A                set name 1\0A            case none\0A                return\0A        end\0A    end\0A\0A    # Find our upstream\0A    switch $upstream\0A        case git\0A            set upstream '@{upstream}'\0A        case svn\\*\0A            # get the upstream from the 'git-svn-id: \E2\80\A6' in a commit message\0A            # (git-svn uses essentially the same procedure internally)\0A            set -l svn_upstream (git log --first-parent -1 --grep=\22^git-svn-id: \\($svn_url_pattern\\)\22 2>/dev/null)\0A            if test (count $svn_upstream) -ne 0\0A                echo $svn_upstream[-1] | read -l __ svn_upstream __\0A                set svn_upstream (string replace -r '@.*' '' -- $svn_upstream)\0A                set -l cur_prefix\0A\0A                for i in (seq (count $svn_remote))\0A                    set -l remote $svn_remote[$i]\0A                    set -l mod_upstream (string replace \22$remote\22 \22\22 -- $svn_upstream)\0A                    if test \22$svn_upstream\22 != \22$mod_upstream\22\0A                        # we found a valid remote\0A                        set svn_upstream $mod_upstream\0A                        set cur_prefix $svn_prefix[$i]\0A                        break\0A                    end\0A                end\0A\0A                if test -z \22$svn_upstream\22\0A                    # default branch name for checkouts with no layout:\0A                    if test -n \22$GIT_SVN_ID\22\0A                        set upstream $GIT_SVN_ID\0A                    else\0A                        set upstream git-svn\0A                    end\0A                else\0A                    set upstream (string replace '/branches' '' -- $svn_upstream | string replace -a '/' '')\0A\0A                    # Use fetch config to fix upstream\0A                    set -l fetch_val (command git config \22$cur_prefix\22.fetch)\0A                    if test -n \22$fetch_val\22\0A                        string split -m1 : -- \22$fetch_val\22 | read -l trunk pattern\0A                        set upstream (string replace -r -- \22/$trunk\\$\22 '' $pattern) /$upstream\0A                    end\0A                end\0A            else if test $upstream = svn+git\0A                set upstream '@{upstream}'\0A            end\0A    end\0A\0A    # Find how many commits we are ahead/behind our upstream\0A    set count (command git rev-list --count --left-right $upstream...HEAD 2>/dev/null | string replace \\t \22 \22)\0A\0A    # calculate the result\0A    if test -n \22$verbose\22\0A        # Verbose has a space by default\0A        set -l prefix \22$___fish_git_prompt_char_upstream_prefix\22\0A        # Using two underscore version to check if user explicitly set to nothing\0A        if not set -q __fish_git_prompt_char_upstream_prefix\0A            set prefix \22 \22\0A        end\0A\0A        echo $count | read -l behind ahead\0A        switch \22$count\22\0A            case '' # no upstream\0A            case \220 0\22 # equal to upstream\0A                echo \22$prefix$___fish_git_prompt_char_upstream_equal\22\0A            case \220 *\22 # ahead of upstream\0A                echo \22$prefix$___fish_git_prompt_char_upstream_ahead$ahead\22\0A            case \22* 0\22 # behind upstream\0A                echo \22$prefix$___fish_git_prompt_char_upstream_behind$behind\22\0A            case '*' # diverged from upstream\0A                echo \22$prefix$___fish_git_prompt_char_upstream_diverged$ahead-$behind\22\0A        end\0A        if test -n \22$count\22 -a -n \22$name\22\0A            echo \22 \22(command git rev-parse --abbrev-ref \22$upstream\22 2>/dev/null)\0A        end\0A    else if test -n \22$informative\22\0A        echo $count | read -l behind ahead\0A        switch \22$count\22\0A            case '' # no upstream\0A            case \220 0\22 # equal to upstream\0A            case \220 *\22 # ahead of upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_ahead$ahead\22\0A            case \22* 0\22 # behind upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_behind$behind\22\0A            case '*' # diverged from upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_ahead$ahead$___fish_git_prompt_char_upstream_behind$behind\22\0A        end\0A    else\0A        switch \22$count\22\0A            case '' # no upstream\0A            case \220 0\22 # equal to upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_equal\22\0A            case \220 *\22 # ahead of upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_ahead\22\0A            case \22* 0\22 # behind upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_behind\22\0A            case '*' # diverged from upstream\0A                echo \22$___fish_git_prompt_char_upstream_prefix$___fish_git_prompt_char_upstream_diverged\22\0A        end\0A    end\0A\0A    # For the return status\0A    test \22$count\22 = \220 0\22\0Aend\0A\0A# Decide if git is safe to run.\0A# On Darwin, git is pre-installed as a stub, which will pop a dialog if you run it.\0Aif string match -q Darwin -- (__fish_uname) && string match -q /usr/bin/git -- (command -s git) && type -q xcode-select && type -q xcrun\0A    if not xcode-select --print-path &>/dev/null\0A        # Only the stub git is installed.\0A        # Do not try to run it.\0A        function __fish_git_prompt_ready\0A            return 1\0A        end\0A    else\0A        # git is installed, but on the first run it may be very slow as xcrun needs to populate the cache.\0A        # Kick it off in the background to populate the cache.\0A        /bin/sh -c '( /usr/bin/git --version; touch /tmp/__fish_git_ready ) >/dev/null 2>&1 &'\0A        function __fish_git_prompt_ready\0A            path is /tmp/__fish_git_ready || return 1\0A            # git is ready, erase the function.\0A            functions -e __fish_git_prompt_ready\0A            return 0\0A        end\0A    end\0Aend\0A\0Afunction fish_git_prompt --description \22Prompt function for Git\22\0A    # If git isn't installed, there's nothing we can do\0A    # Return 1 so the calling prompt can deal with it\0A    if not command -sq git\0A        return 1\0A    end\0A    # Fail if __fish_git_prompt_ready is defined and fails.\0A    if functions -q __fish_git_prompt_ready && not __fish_git_prompt_ready\0A        return 1\0A    end\0A    set -l repo_info (command git rev-parse --git-dir --is-inside-git-dir --is-bare-repository --is-inside-work-tree HEAD 2>/dev/null)\0A    test -n \22$repo_info\22\0A    or return\0A\0A    set -l git_dir $repo_info[1]\0A    set -l inside_gitdir $repo_info[2]\0A    set -l bare_repo $repo_info[3]\0A    set -l inside_worktree $repo_info[4]\0A    set -q repo_info[5]\0A    and set -l sha $repo_info[5]\0A\0A    set -l rbc (__fish_git_prompt_operation_branch_bare $repo_info)\0A    set -l r $rbc[1] # current operation\0A    set -l b $rbc[2] # current branch\0A    set -l detached $rbc[3]\0A    set -l dirtystate #dirty working directory\0A    set -l stagedstate #staged changes\0A    set -l invalidstate #staged changes\0A    set -l stashstate #stashes\0A    set -l untrackedfiles #untracked\0A    set -l c $rbc[4] # bare repository\0A    set -l p #upstream\0A    set -l informative_status\0A\0A    set -q __fish_git_prompt_status_order\0A    or set -g __fish_git_prompt_status_order stagedstate invalidstate dirtystate untrackedfiles stashstate\0A\0A    if not set -q ___fish_git_prompt_init\0A        # This takes a while, so it only needs to be done once,\0A        # and then whenever the configuration changes.\0A        __fish_git_prompt_validate_chars\0A        __fish_git_prompt_validate_colors\0A        set -g ___fish_git_prompt_init\0A    end\0A\0A    set -l space \22$___fish_git_prompt_color$___fish_git_prompt_char_stateseparator$___fish_git_prompt_color_done\22\0A\0A    # Use our variables as defaults, but allow overrides via the local git config.\0A    # That means if neither is set, this stays empty.\0A    #\0A    # So \22!= true\22 or \22!= false\22 are useful tests if you want to do something by default.\0A    set -l informative\0A    set -l dirty\0A    set -l untracked\0A    command git config -z --get-regexp 'bash\\.(showInformativeStatus|showDirtyState|showUntrackedFiles)' 2>/dev/null | while read -lz key value\0A        switch $key\0A            case bash.showinformativestatus\0A                set informative $value\0A            case bash.showdirtystate\0A                set dirty $value\0A            case bash.showuntrackedfiles\0A                set untracked $value\0A        end\0A    end\0A\0A    # If we don't print these, there is no need to compute them. Note: For now, staged and dirty are coupled.\0A    if not set -q dirty[1]\0A        contains -- \22$__fish_git_prompt_showdirtystate\22 yes true 1\0A        and set dirty true\0A    end\0A    contains dirtystate $__fish_git_prompt_status_order || contains stagedstate $__fish_git_prompt_status_order\0A    or set dirty false\0A\0A    if not set -q untracked[1]\0A        contains -- \22$__fish_git_prompt_showuntrackedfiles\22 yes true 1\0A        and set untracked true\0A    end\0A    contains untrackedfiles $__fish_git_prompt_status_order\0A    or set untracked false\0A\0A    if test true = $inside_worktree\0A        # Use informative status if it has been enabled locally, or it has been\0A        # enabled globally (via the fish variable) and dirty or untracked are not false.\0A        #\0A        # This is to allow overrides for the repository.\0A        if test \22$informative\22 = true\0A            or begin\0A                contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A                and test \22$dirty\22 != false\0A            end\0A            set informative_status (untracked=$untracked __fish_git_prompt_informative_status $git_dir)\0A            if test -n \22$informative_status\22\0A                set informative_status \22$space$informative_status\22\0A            end\0A        else\0A            if not test \22$dirty\22 = true; and test \22$untracked\22 = true\0A                # Only untracked, ls-files is faster.\0A                command git -c core.fsmonitor= ls-files --others --exclude-standard --directory --no-empty-directory --error-unmatch -- :/ >/dev/null 2>&1\0A                and set untrackedfiles 1\0A            else if test \22$dirty\22 = true\0A                # With both dirty and untracked, git status is ~10% faster.\0A                # With just dirty, it's ~20%.\0A                set -l opt -uno\0A                test \22$untracked\22 = true; and set opt -unormal\0A                # Don't use `--ignored=no`; it was introduced in Git 2.16, from January 2018\0A                # Ignored files are omitted by default\0A                set -l stat (command git -c core.fsmonitor= status --porcelain -z $opt | string split0)\0A\0A                set dirtystate (string match -qr '^.[ACDMRTU]' -- $stat; and echo 1)\0A                if test -n \22$sha\22\0A                    set stagedstate (string match -qr '^[ACDMRTU].' -- $stat; and echo 1)\0A                else\0A                    set invalidstate 1\0A                end\0A\0A                test \22$untracked\22 = true\0A                and set untrackedfiles (string match -qr '\\?\\?' -- $stat; and echo 1)\0A            end\0A\0A            if contains -- \22$__fish_git_prompt_showstashstate\22 yes true 1\0A                and test -r $git_dir/logs/refs/stash\0A                # If we have informative status but don't want to actually\0A                # *compute* the informative status, we might still count the stash.\0A                if contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A                    set stashstate (count < $git_dir/logs/refs/stash)\0A                else\0A                    set stashstate 1\0A                end\0A            end\0A        end\0A\0A        # (showupstream has a variety of options, not just bool)\0A        if set -q __fish_git_prompt_showupstream\0A            or contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A            set p (__fish_git_prompt_show_upstream)\0A        end\0A    end\0A\0A    set -l branch_color $___fish_git_prompt_color_branch\0A    set -l branch_done $___fish_git_prompt_color_branch_done\0A    if contains -- \22$__fish_git_prompt_showcolorhints\22 yes true 1\0A        if test $detached = yes\0A            set branch_color $___fish_git_prompt_color_branch_detached\0A            set branch_done $___fish_git_prompt_color_branch_detached_done\0A        else if test -n \22$dirtystate$untrackedfiles\22; and set -q __fish_git_prompt_color_branch_dirty\0A            set branch_color (set_color $__fish_git_prompt_color_branch_dirty)\0A            set branch_done (set_color $__fish_git_prompt_color_branch_dirty_done)\0A        else if test -n \22$stagedstate\22; and set -q __fish_git_prompt_color_branch_staged\0A            set branch_color (set_color $__fish_git_prompt_color_branch_staged)\0A            set branch_done (set_color $__fish_git_prompt_color_branch_staged_done)\0A        end\0A    end\0A\0A    set -l f \22\22\0A    for i in $__fish_git_prompt_status_order\0A        if test -n \22$$i\22\0A            set -l color_var ___fish_git_prompt_color_$i\0A            set -l color_done_var ___fish_git_prompt_color_{$i}_done\0A            set -l symbol_var ___fish_git_prompt_char_$i\0A\0A            set -l color $$color_var\0A            set -l color_done $$color_done_var\0A            set -l symbol $$symbol_var\0A\0A            # If we count some things, print the number\0A            # This won't be done if we actually do the full informative status\0A            # because that does the printing.\0A            contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A            and set f \22$f$color$symbol$$i$color_done\22\0A            or set f \22$f$color$symbol$color_done\22\0A        end\0A    end\0A\0A    set b (string replace refs/heads/ '' -- $b)\0A    if string match -qr '^\\d+$' \22$__fish_git_prompt_shorten_branch_len\22\0A        set -q __fish_git_prompt_shorten_branch_char_suffix\0A        and set -l char -c \22$__fish_git_prompt_shorten_branch_char_suffix\22\0A        set b (string shorten -m \22$__fish_git_prompt_shorten_branch_len\22 $char -- \22$b\22)\0A    end\0A    if test -n \22$b\22\0A        set b \22$branch_color$b$branch_done\22\0A        if test -z \22$dirtystate$untrackedfiles$stagedstate\22; and test -n \22$___fish_git_prompt_char_cleanstate\22\0A            and not contains -- \22$__fish_git_prompt_show_informative_status\22 yes true 1\0A            set b \22$b$___fish_git_prompt_color_cleanstate$___fish_git_prompt_char_cleanstate$___fish_git_prompt_color_cleanstate_done\22\0A        end\0A    end\0A    if test -n \22$c\22\0A        set c \22$___fish_git_prompt_color_bare$c$___fish_git_prompt_color_bare_done\22\0A    end\0A    if test -n \22$r\22\0A        set r \22$___fish_git_prompt_color_merging$r$___fish_git_prompt_color_merging_done\22\0A    end\0A    if test -n \22$p\22\0A        set p \22$___fish_git_prompt_color_upstream$p$___fish_git_prompt_color_upstream_done\22\0A    end\0A\0A    # Formatting\0A    # If we have state, a bare repo or upstream difference, add a separator.\0A    # merging is already separate.\0A    if test -n \22$f$c$p\22\0A        set f \22$space$f\22\0A    end\0A    set -l format $argv[1]\0A    if test -z \22$format\22\0A        set format \22 (%s)\22\0A    end\0A\0A    printf \22%s$format%s\22 \22$___fish_git_prompt_color_prefix\22 \22$___fish_git_prompt_color_prefix_done$c$b$f$r$p$informative_status$___fish_git_prompt_color_suffix\22 \22$___fish_git_prompt_color_suffix_done\22\0Aend\0A\0A### helper functions\0A\0Afunction __fish_git_prompt_informative_status\0A    set -l stashstate 0\0A    set -l stashfile \22$argv[1]/logs/refs/stash\22\0A    if contains -- \22$__fish_git_prompt_showstashstate\22 yes true 1; and test -e \22$stashfile\22\0A        set stashstate (count < $stashfile)\0A    end\0A\0A    # If we're not told to show untracked files, we don't.\0A    # If we are, we still use the \22normal\22 mode because it's a lot faster,\0A    # and it's unlikely anyone cares about the number of files if it's *all* of the files\0A    # in that directory.\0A    set -l untr -uno\0A    test \22$untracked\22 = true\0A    and set untr -unormal\0A\0A    # Use git status --porcelain.\0A    # The v2 format is better, but we don't actually care in this case.\0A    set -l stats (string sub -l 2 (git -c core.fsmonitor= status --porcelain -z $untr | string split0))\0A    set -l invalidstate (string match -r '^UU' $stats | count)\0A    set -l stagedstate (string match -r '^[ACDMRT].' $stats | count)\0A    set -l dirtystate (string match -r '^.[ACDMRT]' $stats | count)\0A    set -l untrackedfiles (string match -r '^\\?\\?' $stats | count)\0A\0A    set -l info\0A\0A    if test \22$dirtystate$invalidstate$stagedstate$untrackedfiles$stashstate\22 = 00000\0A        if test -n \22$___fish_git_prompt_char_cleanstate