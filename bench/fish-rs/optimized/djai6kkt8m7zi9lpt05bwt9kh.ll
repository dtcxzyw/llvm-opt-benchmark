@anon.1d0b41a8d45d477c3029ec78f9b8b434.2728 = private unnamed_addr constant [8386 x i8] c"# completion for tmutil (macOS)\0A\0Afunction __fish_tmutil_destination_ids\0A    for line in $(tmutil destinationinfo)\0A        if string match -q '*===*' -- $line\0A            # New section so clear out variables\0A            set -f name ''\0A            set -f kind ''\0A            continue\0A        end\0A\0A        if string match -q -r '^Name' -- $line\0A            # Got the destination name\0A            set -f name \22$(string match -r -g '^Name\\s+:\\s+(.*)$' $line | string trim)\22\0A            continue\0A        end\0A\0A        if string match -q -r '^Kind' -- $line\0A            # Got the destination name\0A            set -f kind \22$(string match -r -g '^Kind\\s+:\\s+(\\w+)' $line | string trim)\22\0A            continue\0A        end\0A\0A        if string match -q -r '^ID' -- $line\0A            # Got the destination ID\0A            set -f ID \22$(string match -r -g '^ID\\s+:\\s+(.*)$' $line | string trim)\22\0A            echo $ID\\t$name $kind\0A            continue\0A        end\0A    end\0Aend\0A\0Acomplete -c tmutil -n __fish_use_subcommand -a status -d 'Display Time Machine status'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from status'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a addexclusion -d 'Add an exclusion not to back up a file'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from addexclusion' -s v -d 'Volume exclusion'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from addexclusion' -s p -d 'Path exclusion'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a associatedisk -d 'Bind a snapshot volume directory to the specified local disk'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a calculatedrift -d 'Determine the amount of change between snapshots'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a compare -d 'Perform a backup diff'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s a -d 'Compare all supported metadata'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s n -d 'No metadata comparison'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s @ -d 'Compare extended attributes'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s c -d 'Compare creation times'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s d -d 'Compare file data forks'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s e -d 'Compare ACLs'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s f -d 'Compare file flags'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s g -d 'Compare GIDs'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s m -d 'Compare file modes'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s s -d 'Compare sizes'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s t -d 'Compare modification times'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s u -d 'Compare UIDs'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from compare' -s D -d 'Limit traversal depth to depth levels from the beginning of iteration'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s E -d 'Dont take exclusions into account'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from compare' -s I -d 'Ignore path'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from compare' -s U -d 'Ignore logical volume identity'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a delete -d 'Delete one or more snapshots'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from delete' -s d -d 'Backup mount point'\0Acomplete -c tmutil -r -f -n '__fish_seen_subcommand_from delete' -s t -d Timestamp\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from delete' -s p -d Path\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a deletelocalsnapshots -d 'Delete all local Time Machine snapshots for the specified date (formatted YYYY-MM-DD-HHMMSS)'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a deleteinprogress -d 'Delete all in-progress backups for a machine directory'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a destinationinfo -d 'Print information about destinations'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a disable -d 'Turn off automatic backups'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a disablelocal -d 'Turn off local Time Machine snapshots'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a enable -d 'Turn on automatic backups'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a enablelocal -d 'Turn on local Time Machine snapshots'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a inheritbackup -d 'Claim a machine directory or sparsebundle for use by the current machine'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a isexcluded -d 'Determine if a file, directory, or volume are excluded from backups'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a latestbackup -d 'Print the path to the latest snapshot'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a listlocalsnapshotdates -d 'List the creation dates of all local Time Machine snapshots'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a listlocalsnapshots -d 'List local Time Machine snapshots of the specified volume'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a listbackups -d 'Print paths for all snapshots'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a localsnapshot -d 'Create new local Time Machine snapshot of APFS volume in TM backup'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a machinedirectory -d 'Print the path to the current machine directory'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a removedestination -d 'Removes a backup destination'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from removedestination' -a '$(__fish_tmutil_destination_ids)'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a removeexclusion -d 'Remove an exclusion'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from removeexclusion' -s v -d 'Volume exclusion'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from removeexclusion' -s p -d 'Path exclusion'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a restore -d 'Restore an item'\0Acomplete -c tmutil -r -n '__fish_seen_subcommand_from restore' -s v\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a setdestination -d 'Set a backup destination'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from setdestination' -s a -d 'Add to the list of destinations'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from setdestination' -s p -d 'Enter the password at a non-echoing interactive prompt'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a snapshot -f -d 'Create new local Time Machine snapshot'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a startbackup -d 'Begin a backup if one is not already running'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from startbackup' -s a -l auto -d 'Automatic mode'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from startbackup' -s b -l block -d 'Block until finished'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from startbackup' -s r -l rotation -d 'Automatic rotation'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from startbackup' -s d -l destination -r -a '$(__fish_tmutil_destination_ids)' -d 'Backup destination'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a stopbackup -d 'Cancel a backup currently in progress'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a thinlocalsnapshots -d 'Thin local Time Machine snapshots for the specified volume'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a uniquesize -d 'Analyze the specified path and determine its unique size'\0A\0Acomplete -c tmutil -r -n __fish_use_subcommand -a verifychecksums -d 'Verify snapshot'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a version -d 'Print version'\0A\0Acomplete -c tmutil -f -n __fish_use_subcommand -a setquota -d 'Set the quota for the destination in gigabytes'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from setquota' -r -a '$(__fish_tmutil_destination_ids)'\0A\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from destinationinfo isexcluded compare status' -s X -d 'Print as XML'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from latestbackup listbackups' -s m -d 'Destination volume to list backups from'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from latestbackup listbackups' -s t -d 'Attempt to mount the backups and list their mounted paths'\0Acomplete -c tmutil -f -n '__fish_seen_subcommand_from latestbackup listbackups' -s d -d 'Backup mount point'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2729 = private unnamed_addr constant [21 x i8] c"completions/tmux.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2730 = private unnamed_addr constant [32992 x i8] c"function __fish_tmux_sessions -d 'available sessions'\0A    tmux list-sessions -F \22#S\22\\t\22#{session_windows} windows created: #{session_created_string} [#{session_width}x#{session_height}]#{session_attached}\22 | sed 's/0$//;s/1$/ (attached)/' 2>/dev/null\0Aend\0A\0Afunction __fish_tmux_clients -d 'connected clients'\0A    tmux list-clients -F \22#{client_tty}\22\\t\22#S: Created: #{client_created_string} [#{client_width}x#{client_height} #{client_termname}]\22 2>/dev/null\0Aend\0A\0A# These are meant to be used with `complete --keep-order`\0Afunction __fish_tmux_panes -d \22list tmux panes in the current session\22\0A    set -l pane_details_format (\0A        string join '' \\\0A        '[#W] #{=/15/...:pane_title}' \\\0A        '#{?pane_marked, <marked>,}' \\\0A        '#{?window_active, <active #{?pane_active,pane,win.}>,}'\0A        # TODO: Could show <zoomed>/<invisible> for active/inactive panes in a zoomed window\0A    )\0A    # panes by themselves (current window)\0A    # For pane commands, `tmux` understands an integer to mean \22pane\0A    # with this index in the current window\22\0A    tmux list-panes -F \22#P\22\\t\22#D $pane_details_format\22 2>/dev/null\0A\0A    # window.pane index\0A    tmux list-panes -s -F \22#I.#P\22\\t\22#D $pane_details_format\22 2>/dev/null\0A\0A    # unique pane id\0A    # These ids start with `%` and do not change when panes are reordered,\0A    # nor when they are moved to another window or session. We show them\0A    # for context in above completions, and support completing them.\0A    tmux list-panes -s -F \22#D\22\\t\22#I.#P $pane_details_format\22 | sort -n -k 1.2 2>/dev/null\0A\0A    # We could also add the panes in the `session:window.pane` syntax,\0A    # but there's not reason to use it in the common case where the\0A    # person is interested in the current tmux session (or there is only\0A    # one tmux session). This can also be confusing when \22sesssion groups\22\0A    # are used\0Aend\0A\0Afunction __fish_tmux_buffers -d buffers\0A    tmux list-buffers -F '#{buffer_name}'\\t'#{buffer_sample}' 2>/dev/null\0Aend\0A\0A# Meant to be used with `complete --keep-order`, since tmux follows numerical order\0Afunction __fish_tmux_windows -d \22list tmux windows in the current session\22\0A    # Using the same notation as tmux's default status bar. Could use <marked>, <active>, etc.\0A    # Unlike tmux's statusbar , we add a space for readability\0A    set -l window_flags '#{?window_active, *,}#{?window_marked_flag, M,}#{?window_zoomed_flag, Z,}'\0A\0A    # In window context, an integer means a window index in this session\0A    tmux list-windows -F \22#I\22\\t\22#W$window_flags\22 2>/dev/null\0A\0A    # Showing windows in other sessions can be confusing e.g. if there\0A    # are session groups. So, we assume the user is interested in the\0A    # current (or only) session.\0Aend\0A\0A#don't allow dirs in the completion list...\0Acomplete -c tmux -x\0A\0A###############  Begin: Dynamic Completions Using `tmux list-commands` ###############\0A\0A# The dynamic completions are exhaustive. The manual completions below override\0A# them with better-documented completions and custom completions for some\0A# arguments, e.g. for target panes, but only have partial coverage.\0Afunction __fish_tmux_parse_lscm_usage\0A    set -l lscm (tmux list-commands -F \22#{command_list_name} #{command_list_alias}\22\\t\22#{command_list_usage}\22 2>/dev/null)\0A    or return\0A\0A    for cmd_tab_usage in $lscm\0A        set -l split_command (string split --max 2 \\t -- $cmd_tab_usage)\0A        set -l cmdnames $split_command[1]\0A        set -l usage $split_command[2]\0A\0A        complete -c tmux -n __fish_use_subcommand -a \22$cmdnames\22\0A\0A        # $usage has the form '[-ABCD] [-L|-S|-U] [-e arg-name] [positional-arg-name]'\0A        for item in (string match -ag --regex '\\[([^\\]]+)\\]' $usage)\0A            if not set -l item (string trim -l -c - -- $item)\0A                continue\0A            end\0A            if set -l split_item (string split -n --max 2 \22 \22 -- \22$item\22)\0A                # The option should always have length 1 by tmux convention,\0A                # but we double-check to avoid syntax errors.\0A                if [ \22$(string length $split_item[1])\22 = 1 ]\0A                    complete -c tmux -xs $split_item[1] -n \22__fish_seen_subcommand_from $cmdnames\22 -d \22$split_item[2]\22\0A                end\0A            else\0A                for char in (string split '' -- \22$item\22)\0A                    if string match -q -r '\\||-' -- $char\0A                        # TODO: Actually treat exclusive args, [-L|-S|-U], as exclusive\0A                        # For now, we just ignore the `-`s and `|`s\0A                        continue\0A                    end\0A                    complete -c tmux -n \22__fish_seen_subcommand_from $cmdnames\22 -s $char\0A                end\0A            end\0A        end\0A    end\0Aend\0A\0A__fish_tmux_parse_lscm_usage\0Afunctions -e __fish_tmux_parse_lscm_usage\0A\0A# Completions for `tmux list-commands` itself\0Aset -l all_commands (tmux list-commands -F \22#{command_list_name} #{command_list_alias}\22 2>/dev/null)\0Aand complete -c tmux -n \22__fish_seen_subcommand_from list-commands lscm\22 -x -a \22$all_commands\22\0A\0A###############  End:   Dynamic Completions Using `tmux list-commands` ###############\0A\0A###############  Begin: Front  Flags ###############\0A#these do not require parameters\0Acomplete -c tmux -n __fish_use_subcommand -s 2 -d 'Force tmux to assume the terminal supports 256 colours'\0Acomplete -c tmux -n __fish_use_subcommand -s 8 -d 'Like -2, but indicates that the terminal supports 88 colours'\0Acomplete -c tmux -n __fish_use_subcommand -s l -d 'Behave as a login shell'\0Acomplete -c tmux -n __fish_use_subcommand -s q -d 'Set the quiet server option'\0Acomplete -c tmux -n __fish_use_subcommand -s u -d 'Flag explicitly informs tmux that UTF-8 is supported'\0Acomplete -c tmux -n __fish_use_subcommand -s v -d 'Request verbose logging'\0Acomplete -c tmux -n __fish_use_subcommand -s V -d 'Report the tmux version'\0A\0A#these require parameters\0Acomplete -c tmux -n __fish_use_subcommand -xs c -d 'Execute command using the default shell'\0Acomplete -c tmux -n __fish_use_subcommand -rs f -d 'Alternate config file'\0Acomplete -c tmux -n __fish_use_subcommand -rs L -d 'Specify the name of the server socket to use'\0Acomplete -c tmux -n __fish_use_subcommand -rs S -d 'Full path to server socket. If set, -L is ignored.'\0A###############  End:   Front  Flags ###############\0A\0A###############  Begin: Clients and Sessions ###############\0Aset -l attach 'attach-session attach at a'\0Aset -l detach 'detach-client detach'\0Aset -l has 'has-session has'\0Aset -l killserver kill-server\0Aset -l killsession kill-session\0Aset -l lsc 'list-clients lsc'\0Aset -l lscm 'list-commands lscm'\0Aset -l ls 'list-sessions ls'\0Aset -l lockc 'lock-client lockc'\0Aset -l locks 'lock-session locks'\0Aset -l new 'new-session new'\0Aset -l refresh 'refresh-client refresh'\0Aset -l rename 'rename-session rename'\0Aset -l showmsgs 'show-messages showmsgs'\0Aset -l source 'source-file source'\0Aset -l start 'start-server start'\0Aset -l suspendc 'suspend-client suspendc'\0Aset -l switchc 'switch-client switchc'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $attach -d 'attach to existing session'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $attach\22 -s d -d 'detach other clients'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $attach\22 -s r -d 'attach in read-only mode'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $detach -d 'detach current client'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $detach\22 -s P -d 'SIGHUP parent process of client, likely causing it to exit'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $has -d 'report error and exit with 1 if the session does not exist'\0Acomplete -c tmux -n __fish_use_subcommand -a $killserver -d 'kill tmux server, clients, and sessions'\0Acomplete -c tmux -n __fish_use_subcommand -a $killsession -d 'destroy session, close its windows, and detach all its clients'\0Acomplete -c tmux -n __fish_use_subcommand -a $lsc -d 'list all attached clients'\0Acomplete -c tmux -n __fish_use_subcommand -a $lscm -d 'list syntax for all tmux commands'\0Acomplete -c tmux -n __fish_use_subcommand -a $ls -d 'list all sessions'\0Acomplete -c tmux -n __fish_use_subcommand -a $lockc -d 'lock client'\0Acomplete -c tmux -n __fish_use_subcommand -a $locks -d 'lock session'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $new -d 'create a new session with name session-name'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -s d -d \22don't attach to current window\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -s A -d \22attach to existing session if session-name already exists\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -s D -d \22if -A is specified, detach other clients attached to the session\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -s P -d \22print information about the new session after creation\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -s E -d \22don't apply update-environment option\22\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs c -d start-directory\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs F -d format\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs n -d window-name\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs s -d session-name\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs t -d group-name\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs x -d width\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $new\22 -xs y -d height\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $refresh -d 'refresh client'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $refresh\22 -s S -d 'update client status bar'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $rename -d 'rename session'\0Acomplete -c tmux -n __fish_use_subcommand -a $showmsgs -d 'save msgs in status bar in per-client msg log'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $source -d 'execute commands from path'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $source\22 -F\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $start -d 'start tmux server if not running; do not create a session'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $suspendc -d 'send SIGTSTP signal to client (tty stop)'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $switchc -d 'Switch the current session for client target-client to target-session'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $switchc\22 -s l -d 'move client to the last session'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $switchc\22 -s n -d 'move client to the next session'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $switchc\22 -s p -d 'move client to the previous session'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $switchc\22 -s r -d 'toggle if client is read-only'\0A\0A#commands with a session flag\0Acomplete -c tmux -xs t -n \22__fish_seen_subcommand_from $attach $new $has $killsession $lsc $locks $rename $switchc\22 -a '(__fish_tmux_sessions)' -d target-session\0Acomplete -c tmux -xs s -n \22__fish_seen_subcommand_from $detach\22 -a '(__fish_tmux_sessions)' -d target-session\0A\0A#commands with a client flag\0Acomplete -c tmux -xs t -n \22__fish_seen_subcommand_from $detach $lockc $refresh $showmsgs $suspendc\22 -a '(__fish_tmux_clients)' -d target-client\0Acomplete -c tmux -xs c -n \22__fish_seen_subcommand_from $switchc\22 -a '(__fish_tmux_clients)' -d target-client\0A\0A#commands with the -F format flag\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $lsc $ls\22 -xs F -d 'format string'\0A\0A#commands that take shell commands\0Acomplete -c tmux -x -n \22__fish_seen_subcommand_from $new \22 -a '(__fish_complete_subcommand --fcs-skip=2)'\0A\0A###############  End: Clients and Sessions ###############\0A\0A###############  Begin: Windows and Panes ###############\0A\0Aset -l breakp \22break-pane breakp\22\0Aset -l capturep \22capture-pane capturep\22\0Aset -l chooseclient choose-client\0Aset -l choosetree choose-tree\0Aset -l customizemode customize-mode\0Aset -l displayp \22display-panes displayp\22\0Aset -l findw \22find-window findw\22\0Aset -l joinp \22join-pane joinp move-pane movep\22\0Aset -l killp \22kill-pane killp\22\0Aset -l killw \22kill-window killw\22\0Aset -l lastp \22last-pane lastp\22\0Aset -l lastw \22last-window lastw\22\0Aset -l linkw \22link-window linkw\22\0Aset -l lsp \22list-panes lsp\22\0Aset -l lsw \22list-windows lsw\22\0Aset -l movew \22move-window movew\22\0Aset -l neww \22new-window neww\22\0Aset -l nextl \22next-layout nextl\22\0Aset -l next \22next-window next\22\0Aset -l pipep \22pipe-pane pipep\22\0Aset -l prevl \22previous-layout prevl\22\0Aset -l prev \22previous-window prev\22\0Aset -l renamew \22rename-window renamew\22\0Aset -l resizep \22resize-pane resizep\22\0Aset -l resizew \22resize-window resizew\22\0Aset -l respawnp \22respawn-pane respawnp\22\0Aset -l respawnw \22respawn-window respawnw\22\0Aset -l rotatew \22rotate-window rotatew\22\0Aset -l selectl \22select-layout selectl\22\0Aset -l selectp \22select-pane selectp\22\0Aset -l selectw \22select-window selectw\22\0Aset -l splitw \22split-window splitw\22\0Aset -l swapp \22swap-pane swapp\22\0Aset -l swapw \22swap-window swapw\22\0Aset -l unlinkw \22unlink-window unlinkw\22\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $breakp -d 'break pane off into a new window'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $capturep -d 'capture contents of a pane into a buffer'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $capturep\22 -xs a -d 'capture alternate screen'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $capturep\22 -xs p -d 'output to stdout'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $capturep\22 -xs e -d 'include color escapes'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $capturep\22 -xs C -d 'escape non-printable chars'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $chooseclient -d 'interactively choose client'\0Acomplete -c tmux -n __fish_use_subcommand -a $choosetree -d 'interactively choose session/window/pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $customizemode -d 'interactively customize settings'\0Acomplete -c tmux -n __fish_use_subcommand -a $displayp -d 'display a visible indicator for each pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $findw -d 'interactively choose window matching pattern'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $joinp -d 'split destination pane and move source pane into one of the halves'\0A# $joinp takes a subset of $splitw arguments\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $splitw\22 -xs b -d 'before target'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $splitw\22 -xs h -d horizontal\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $splitw\22 -xs v -d vertical\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $splitw\22 -xs l -d 'size in lines/cols'\0Acomplete -c tmux -n \22__fish_seen_subcommand_from $joinp $splitw\22 -xs f -d 'full height/width'\0A\0Acomplete -c tmux -n __fish_use_subcommand -a $killp -d 'destroy a pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $killw -d 'destroy a window'\0Acomplete -c tmux -n __fish_use_subcommand -a $lastp -d 'select the previously selected pane'\0Acomplete -c tmux -n __fish_use_subcommand -a $lastw -d 'select the previously selected window'\0Acomplete -c tmux -n __fish_use_subcommand -a $linkw -d 'link source window to destination window'\0A\0Acomplete -c tmux -n __fish_use_subcom