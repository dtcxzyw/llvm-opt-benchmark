blish the current package to pub.dartlang.org'\0Acomplete -c dart -n '__fish_seen_subcommand_from pub' -xa remove -d 'Removes a dependency from the current package'\0Acomplete -c dart -n '__fish_seen_subcommand_from pub' -xa upgrade -d 'Upgrade the current package\\'s dependencies to latest versions'\0Acomplete -c dart -n '__fish_seen_subcommand_from pub' -xa ploader -d 'Manage uploaders for a package on pub.dartlang.org'\0A\0A# run\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l observe -d 'Run a program with common options for debugging'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l enable-vm-service -d 'Enables VM service and listen on the specified port (default localhost:8181)'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l serve-devtools -d 'Serve Dart DevTools debugger/profiler via service at <vm-service-uri>/devtools'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-serve-devtools -d 'Serve Dart DevTools debugger/profiler via service at <vm-service-uri>/devtools'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l pause-isolates-on-exit -d 'Pause isolates on exit when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-pause-isolates-on-exit -d 'Pause isolates on exit when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l pause-isolates-on-unhandled-exceptions -d 'Pause isolates after unhandled exception when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-pause-isolates-on-unhandled-exceptions -d 'Don\\'t pause isolates after unhandled exception when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l warn-on-pause-with-no-debugger -d 'Warn when isolate pauses with no attached debugger when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-warn-on-pause-with-no-debugger -d 'Don\\'t warn when isolate pauses with no attached debugger when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l pause-isolates-on-start -d 'Pause isolates on start when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-pause-isolates-on-start -d 'Don\\'t pause isolates on start when running with --enable-vm-service'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l enable-asserts -d 'Enable assert statements'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l no-enable-asserts -d 'Disable assert statements'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -l verbosity -d 'Sets the verbosity level of the compilation'\0Acomplete -c dart -n '__fish_seen_subcommand_from run' -s D -l define -d 'Define an environment declaration'\0A", align 1
