@anon.1d0b41a8d45d477c3029ec78f9b8b434.2434 = private unnamed_addr constant [1102 x i8] c"# Completions for pzstd\0A\0Acomplete -c pzstd -s d -l decompress -d Decompress -k -x -a \22\0A(\0A    __fish_complete_suffix .zst\0A)\0A\22\0A\0Acomplete -c pzstd -s t -l test -d \22Test the integrity\22\0A\0Afor level in (seq 1 19)\0A    complete -c pzstd -o $level -d \22Set compression level\22\0Aend\0A\0Acomplete -c pzstd -l ultra -d \22Enable compression level beyond 19\22\0A\0Acomplete -x -c pzstd -s p -l processes -a \22(seq 1 8)\22 -d \22De/compress using NUM working threads\22\0A\0Acomplete -r -c pzstd -s o -d \22Specify file to save\22\0Acomplete -c pzstd -s f -l force -d \22Overwrite without prompting\22\0Acomplete -c pzstd -s c -l stdout -d \22Force write to stdout\22\0Acomplete -c pzstd -l rm -d \22Remove input file(s) after de/compression\22\0Acomplete -c pzstd -s k -l keep -d \22Keep input file(s) (default)\22\0Acomplete -c pzstd -s r -d \22Recurse directories\22\0Acomplete -c pzstd -s h -l help -d \22Show help\22\0Acomplete -c pzstd -s H -d \22Show long help\22\0Acomplete -c pzstd -s V -l version -d \22Show version\22\0Acomplete -c pzstd -s v -l verbose -d \22Be verbose\22\0Acomplete -c pzstd -s q -l quiet -d \22Suppress warnings\22\0Acomplete -c pzstd -l no-check -d \22Disable integrity check\22\0A", align 1
