@anon.1d0b41a8d45d477c3029ec78f9b8b434.2026 = private unnamed_addr constant [1763 x i8] c"function __fish_lunchy_needs_command\0A    set -l cmd (commandline -xpc)\0A\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __fish_lunchy_using_command\0A    set -l cmd (commandline -xpc)\0A    set -l cmd_count (count $cmd)\0A\0A    if test $cmd_count -lt 2\0A        return 1\0A    end\0A\0A    for arg in $argv\0A        if test $arg = $cmd[2]\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A\0Acomplete -f -c lunchy -s v -l verbose -d 'Show command executions'\0A\0A# Commands\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a install -d 'Installs [file] to ~/Library/LaunchAgents or /Library/LaunchAgents'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a 'ls list' -d 'Show the list of installed agents'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a start -d 'Start the first matching agent'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a stop -d 'Stop the first matching agent'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a restart -d 'Stop and start the first matching agent'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a status -d 'Show the PID and label for all agents'\0Acomplete -f -c lunchy -n __fish_lunchy_needs_command -a edit -d 'Opens the launchctl daemon file in the default editor'\0A\0A# Commands with service completion\0Acomplete -f -c lunchy -n '__fish_lunchy_using_command ls list start stop restart status edit' -a '(lunchy ls)' -d Service\0A\0A# Command: start\0Acomplete -f -c lunchy -n '__fish_lunchy_using_command start' -s w -l write -d 'Persist command'\0Acomplete -f -c lunchy -n '__fish_lunchy_using_command start' -s F -l force -d 'Force start (disabled) agents'\0A\0A# Command: stop\0Acomplete -f -c lunchy -n '__fish_lunchy_using_command stop' -s w -l write -d 'Persist command'\0A", align 1
