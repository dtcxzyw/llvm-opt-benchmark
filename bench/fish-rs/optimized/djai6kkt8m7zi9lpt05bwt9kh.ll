@anon.1d0b41a8d45d477c3029ec78f9b8b434.1758 = private unnamed_addr constant [11508 x i8] c"# Gradle is a build system.\0A# See: https://gradle.org\0A\0Afunction __fish_gradle_contains_build_file\0A    test -f build.gradle -o -f build.gradle.kts\0Aend\0A\0Afunction __fish_gradle_create_completion_cache_file\0A    set -l xdg_cache_home $XDG_CACHE_HOME\0A    # Set up cache directory\0A    if test -z \22$xdg_cache_home\22\0A        set xdg_cache_home $HOME/.cache\0A    end\0A    mkdir -m 700 -p \22$xdg_cache_home/gradle-completions\22\0A\0A    set -l md5Hash (__fish_md5 -s $argv[1] | string replace -r '.* = ' '')\0A    string trim -- \22$xdg_cache_home/gradle-completions/$md5Hash\22\0Aend\0A\0A##############################\0A# Configure Tasks Completion #\0A##############################\0A\0A# Outside of a Project\0Afunction __fish_gradle_get_default_task_completion\0A    if __fish_gradle_contains_build_file\0A        return\0A    end\0A\0A    printf '%s\\t%s\\n' \\\0A        buildEnvironment \22Display buildscript dependencies\22 \\\0A        components \22Display components\22 \\\0A        dependencies \22Display dependencies\22 \\\0A        dependencyInsight \22Display insight of a given dependency\22 \\\0A        dependentComponents \22Display the dependent components\22 \\\0A        help \22Display help message\22 \\\0A        init \22Initialize new Gradle project\22 \\\0A        model \22Display configuration model\22 \\\0A        projects \22Display sub-projects\22 \\\0A        properties \22Display properties\22 \\\0A        tasks \22Display tasks\22 \\\0A        wrapper \22Generate Gradle wrapper files\22\0Aend\0A\0Acomplete --command gw --command gradle --command gradlew \\\0A    --exclusive \\\0A    --arguments \22(__fish_gradle_get_default_task_completion)\22\0A\0A# Inside of a Project\0Afunction __fish_gradle_get_task_completion\0A    if not __fish_gradle_contains_build_file\0A        return\0A    end\0A\0A    set -l gradle_cache_file (__fish_gradle_create_completion_cache_file \22{$PWD}-tasks\22)\0A    if not test -f \22$gradle_cache_file\22 -a -s \22$gradle_cache_file\22\0A        command gradle -q tasks --all 2>/dev/null | string match --regex '^(?!-)[A-Za-z0-9:-]+(?: - .*)?$' | string replace ' - ' \\t >\22$gradle_cache_file\22\0A    end\0A\0A    # return possible tasks\0A    string trim -- <\22$gradle_cache_file\22\0Aend\0A\0Acomplete --command gw --command gradle --command gradlew \\\0A    --condition __fish_gradle_contains_build_file \\\0A    --exclusive \\\0A    --arguments \22(__fish_gradle_get_task_completion)\22\0A\0A###############################\0A# Configure Option Completion #\0A###############################\0A\0Afunction __fish_gradle_get_console_completion\0A    printf '%s\\t%s\\n' \\\0A        auto \22Use 'rich' in console otherwise 'plain'\22 \\\0A        plain \22Disable color and rich output\22 \\\0A        rich \22Enable color and rich output\22 \\\0A        verbose \22Enable color, rich output, output task names and outcomes at the lifecycle log level\22\0Aend\0A\0Afunction __fish_gradle_get_property_completion\0A    printf '%s\\t%s\\n' \\\0A        \22org.gradle.cache.reserved.mb\22 \22Reserve Gradle Daemon memory for operations\22 \\\0A        \22org.gradle.caching\22 \22Enable Gradle build cache\22 \\\0A        \22org.gradle.console\22 \22Set type of console output to generate (plain, auto, rich, verbose)\22 \\\0A        \22org.gradle.daemon.debug\22 \22Enable debug Gradle Daemon\22 \\\0A        \22org.gradle.daemon.idletimeout\22 \22Kill Gradle Daemon after\22 \\\0A        \22org.gradle.debug\22 \22Enable debug Gradle Client\22 \\\0A        \22org.gradle.jvmargs\22 \22Set JVM arguments\22 \\\0A        \22org.gradle.java.home\22 \22Set JDK home dir\22 \\\0A        \22org.gradle.logging.level\22 \22Set default Gradle log level (quiet, warn, lifecycle, info, debug)\22 \\\0A        \22org.gradle.parallel\22 \22Enable parallel project builds (incubating)\22 \\\0A        \22org.gradle.priority\22 \22Set priority for Gradle worker processes (low, normal)\22 \\\0A        \22org.gradle.warning.mode\22 \22Set types of warnings to log (all, summary, fail, none)\22 \\\0A        \22org.gradle.workers.max\22 \22Set the number of workers Gradle is allowed to use\22\0Aend\0A\0Afunction __fish_gradle_get_priority_completion\0A    printf '%s\\t%s\\n' \\\0A        normal \22Default process priority\22 \\\0A        low \22Low process priority\22\0Aend\0A\0Afunction __fish_gradle_get_warning_mode_completion\0A    printf '%s\\t%s\\n' \\\0A        all \22Log all warnings\22 \\\0A        summary \22Suppress all warnings, log a summary at the end\22 \\\0A        fail \22Log all warnings and fail the build if there are any\22 \\\0A        none \22Suppress all warnings, including the summary at the end\22\0Aend\0A\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option help \\\0A    --short-option h --short-option '?' \\\0A    --description 'Show this help message'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option no-rebuild \\\0A    --short-option a \\\0A    --description 'Do not rebuild project dependencies'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option build-file \\\0A    --short-option b \\\0A    --require-parameter \\\0A    --description 'Specify build file'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option build-cache \\\0A    --description 'Enable Gradle build cache'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option settings-file \\\0A    --short-option c \\\0A    --require-parameter \\\0A    --description 'Specify settings file'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option configure-on-demand \\\0A    --description 'Configure necessary projects only [incubating]'\0Acomplete --command gw --command gradle --command gradlew \\\0A    --long-option console \\\0A    --exclusive \\