y custom services file'\0Acomplete -c nmap -l versiondb -r -d 'Specify custom service probes file'\0Acomplete -c nmap -l send-eth -d 'Use raw ethernet sending'\0Acomplete -c nmap -l send-ip -d 'Send at raw IP level'\0Acomplete -c nmap -l privileged -d 'Assume that the user is fully privileged'\0Acomplete -c nmap -l unprivileged -d 'Assume that the user lacks raw socket privileges'\0Acomplete -c nmap -l release-memory -d 'Release memory before quitting'\0Acomplete -c nmap -s V -l version -d 'Print version number'\0Acomplete -c nmap -s h -l help -d 'Print help summary page'\0A", align 1
