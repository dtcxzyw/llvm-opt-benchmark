@anon.1d0b41a8d45d477c3029ec78f9b8b434.1914 = private unnamed_addr constant [3457 x i8] c"function __fish_k3d_no_subcommand --description 'Test if k3d has yet to be given subcommands'\0A    for i in (commandline -xpc)\0A        if contains -- $i cluster image kubeconfig node version\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0Afunction __fish_k3d_print_clusters --description 'Print a list of k3d clusters'\0A    k3d cluster list --no-headers | awk '{print $1}'\0Aend\0A\0Afunction __fish_k3d_print_nodes --description 'Print a list of k3d nodes'\0A    k3d node list --no-headers | awk '{print $1}'\0Aend\0A\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -s h -l help -d \22More information about a command\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -l version -d \22Show k3d and default k3s version\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -a cluster -d \22Manage cluster(s)\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -a version -d \22Show k3d and default k3s version\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -a image -d \22Handle container images\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -a kubeconfig -d \22Manage kubeconfig(s)\22\0Acomplete -f -c k3d -n __fish_k3d_no_subcommand -a node -d \22Manage node(s)\22\0A\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -a create -d \22Create a new cluster\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -a list -d \22List cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -a delete -d \22Delete cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -a start -d \22Start existing k3d cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -a stop -d \22Stop existing k3d cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster; and __fish_seen_subcommand_from delete start stop' -a '(__fish_k3d_print_clusters)' -d Cluster\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from cluster' -s h -l help -d \22Print usage\22\0A\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from image' -a import -d \22Import image(s) from docker into k3d cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from image' -a help -d \22Print usage\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from image' -s h -l help -d \22Print usage\22\0A\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from kubeconfig' -a get -d \22Get kubeconfig from cluster(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from kubeconfig' -a merge -d \22Merge/write kubeconfig(s) from cluster(s) into existing kubeconfig/file\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from kubeconfig get merge' -a '(__fish_k3d_print_clusters)' -d Cluster\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from kubeconfig get merge' -s a -l all -d \22Get kubeconfig from all existing clusters\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from kubeconfig' -s h -l help -d \22Print usage\22\0A\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -a create -d \22Create a new k3s node in docker\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -a delete -d \22Delete node(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -a list -d \22List node(s)\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -a start -d \22Start an existing k3d node\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -a stop -d \22Stop an existing k3d node\22\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node; and __fish_seen_subcommand_from delete start stop' -a '(__fish_k3d_print_nodes)' -d Node\0Acomplete -f -c k3d -n '__fish_seen_subcommand_from node' -s h -l help -d \22Print usage\22\0A", align 1
