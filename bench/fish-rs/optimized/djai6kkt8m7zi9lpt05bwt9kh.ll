@anon.1d0b41a8d45d477c3029ec78f9b8b434.2546 = private unnamed_addr constant [4873 x i8] c"complete -c rustc -s h -l help\0A\0Acomplete -c rustc -x -l cfg\0Acomplete -c rustc -x -l check-cfg -d \22Provide list of expected cfgs for checking\22\0Acomplete -c rustc -r -s L -a 'dependency= crate= native= framework= all='\0Acomplete -c rustc -x -s l -a 'dylib= static= framework='\0Acomplete -c rustc -x -l crate-type -a 'bin lib rlib dylib cdylib staticlib proc-macro'\0Acomplete -c rustc -r -l crate-name\0Acomplete -c rustc -x -l edition -a '2015 2018 2021' -d \22Specify compiler edition\22\0Acomplete -c rustc -x -l emit -a 'asm llvm-bc llvm-ir obj link dep-info metadata mir'\0Acomplete -c rustc -x -l print -d \22Print compiler information\22 -xa \22(rustc --print fake 2>&1 | string match -arg '`(.*?)`' | string match -v fake)\22\0Acomplete -c rustc -s g -d \22Equivalent to -C debuginfo=2\22\0Acomplete -c rustc -s O -d \22Equivalent to -C opt-level=2\22\0Acomplete -c rustc -r -s o -d \22Write output to <filename>\22\0Acomplete -c rustc -r -l out-dir\0Acomplete -c rustc -x -l explain\0Acomplete -c rustc -l test\0Acomplete -c rustc -l target -xa \22(rustc --print target-list)\22\0Acomplete -c rustc -x -l cap-lints\0Acomplete -c rustc -s V -l version -d 'Print version info and exit'\0Acomplete -c rustc -s v -l verbose -d 'Use verbose output'\0Acomplete -c rustc -f -l extern\0Acomplete -c rustc -f -l sysroot\0Acomplete -c rustc -x -l color -a 'auto always never'\0A\0Acomplete -c rustc -s C -l codegen -xa \22(rustc -C help 2>/dev/null | string match -rv 'option is deprecated' | string replace -rf -i '(\\s+)-C\\s*(.+)=val(\\s+)--(\\s+)([^\\n]+)' '\\$2='\\t'\\$5')\22\0A\0A# rustc -Z is only available with the nightly toolchain, which may not be installed\0Afunction __fish_rustc_z_completions\0A    # This function takes a little over one second to run, so let's cache it. (It's ok if the first run is slow\0A    # since this is only run when specifically completing `rustc -Z<TAB>` and not when the completion is loaded.)\0A    if set -q __fish_cached_rustc_z_completions\0A        printf '%s\\n' $__fish_cached_rustc_z_completions\0A        return\0A    end\0A\0A    set -l rust_docs (rustc +nightly -Z help 2>/dev/null |\0A        string replace -r '^\\s+' '' | string replace -ar ' +' ' ' | string replace -r '=val +-- +' '=\\t')\0A\0A    set -f flag\0A    set -f docs\0A    set -g __fish_cached_rustc_z_completions (for line in $rust_docs\0A        # Handle multi-line completions for options with values, e.g.\0A        #    -Z                                      unpretty=val -- present the input source, unstable (and less-pretty) variants;\0A        # `normal`, `identified`,\0A        # `expanded`, `expanded,identified`,\0A        # `expanded,hygiene` (with internal representations)\0A        if string match -rq '^-Z' -- $line\0A            # Actual -Z completion\0A            set -l parts (string split -- \\t $line)\0A            set flag (string replace -r -- '-Z\\s*' '' $parts[1])\0A            set docs $parts[2]\0A            printf '%s\\t%s\\n' $flag $docs\0A        else\0A            # Check for possible argument followed by description, supporting multiple completions per line\0A            # Don't split on ',' but rather ', ' to preserve commas in backticks\0A            # echo $flag:\0A            for line in (string split ', ' -- $line | string trim -c ',' | string trim)\0A                # echo \\* $line\0A                if set -l parts (string match -gr '^(?:or )?`=?(.*?)`\\s*(?:\\((.*?)\\)|: (.*))?\\s*' -- $line)\0A                    set -l docs $parts[2] $parts[3]\0A                    printf '%s%s\\t%s\\n' $flag $parts[1] $docs\0A                else if set -l parts (string match -gr '^([a-z-]+):?\\s*(.*)' -- $line)\0A                    printf '%s%s\\t%s\\n' $flag $parts[1] $parts[2]\0A                end | string match -ev '=val'\0A            end\0A        end\0A    end)\0A    __fish_rustc_z_completions\0Aend\0Acomplete -c rustc -x -s Z -ka \22(__fish_rustc_z_completions)\22\0A\0Afunction __fish_rustc_lint_completions\0A    rustc -W help 2>/dev/null \\\0A        | string match -r \\\0A        '(?:\\s+)(?:.+)(?:\\s+)(?:allow|warn|deny|forbid)(?:\\s+){2}(?:[^\\n]+)' \\\0A        | string replace -r -i \\\0A        '(\\s+)(.+)(\\s+)(allow|warn|deny|forbid)(\\s+){2}([^\\n]+)' '$2 $6' \\\0A        | string match -r '^.*[^:]$' \\\0A        | string match -r -v '^(allow|warn|deny|forbid)$' \\\0A        | string match -r -v '^([a-z\\-]+)(\\s+)(allow|warn|deny|forbid)' \\\0A        | string replace ' ' ,\\t\0Aend\0A\0A# Support multiple arguments in one parameter as comma-separated values with `__fish_concat_completions`,\0A# combined with printing the name with a trailing , above.\0Acomplete -c rustc -s W -l warn -xa \22(__fish_rustc_lint_completions | __fish_concat_completions)\22 -d \22Warn on lint\22\0Acomplete -c rustc -s A -l allow -xa \22(__fish_rustc_lint_completions | __fish_concat_completions)\22 -d \22Allow lint\22\0Acomplete -c rustc -s D -l deny -xa \22(__fish_rustc_lint_completions | __fish_concat_completions)\22 -d \22Deny lint\22\0Acomplete -c rustc -s F -l forbid -xa \22(__fish_rustc_lint_completions | __fish_concat_completions)\22 -d \22Forbid lint\22\0A", align 1
