@anon.1d0b41a8d45d477c3029ec78f9b8b434.2820 = private unnamed_addr constant [1861 x i8] c"# Completions for userdbctl (a part of systemd)\0A\0Aset -l commands_users user groups-of-user\0Aset -l commands_groups group users-in-group\0Aset -l commands $commands_users $commands_groups\0Aset -l services \22(userdbctl services | string match -r -- '\\S+' | string match -v -- 'SERVICE')\22\0A\0A# Commands\0Acomplete -c userdbctl -f\0Acomplete -c userdbctl -n \22not __fish_seen_subcommand_from $commands\22 -a user -d 'Inspect user'\0Acomplete -c userdbctl -n \22not __fish_seen_subcommand_from $commands\22 -a group -d 'Inspect group'\0Acomplete -c userdbctl -n \22not __fish_seen_subcommand_from $commands\22 -a users-in-group -d 'Show users that are members of specified group(s)'\0Acomplete -c userdbctl -n \22not __fish_seen_subcommand_from $commands\22 -a groups-of-user -d 'Show groups the specified user(s) is a member of'\0Acomplete -c userdbctl -n \22not __fish_seen_subcommand_from $commands\22 -a services -d 'Show enabled database services'\0A\0Acomplete -c userdbctl -n \22__fish_seen_subcommand_from $commands_users\22 -a '(__fish_complete_users)'\0Acomplete -c userdbctl -n \22__fish_seen_subcommand_from $commands_groups\22 -a '(__fish_complete_groups)'\0A\0A# Options\0Acomplete -c userdbctl -s h -l help -d 'Show help'\0Acomplete -c userdbctl -l version -d 'Show version'\0Acomplete -c userdbctl -l no-pager -d 'Do not pipe output into a pager'\0Acomplete -c userdbctl -l no-legend -d 'Do not show the headers and footers'\0Acomplete -c userdbctl -l output -d 'Select output mode' -xa 'classic friendly table json'\0Acomplete -c userdbctl -s j -d 'Equivalent to --output=json'\0Acomplete -c userdbctl -s s -l service -d 'Query the specified service' -xa \22$services\22\0Acomplete -c userdbctl -l with-nss -d 'Control whether to include glibc NSS data' -xa 'yes no'\0Acomplete -c userdbctl -s N -d 'Do not synthesize or include glibc NSS data'\0Acomplete -c userdbctl -l synthesize -d 'Synthesize root/nobody user' -xa 'yes no'\0A", align 1
