@anon.1d0b41a8d45d477c3029ec78f9b8b434.2778 = private unnamed_addr constant [2462 x i8] c"# completions for ttx, xml font export utility\0A\0A# Retrieved from http://scripts.sil.org/cms/scripts/page.php?site_id=nrsi&id=IWS-AppendixC\0A# Not all may be supported by ttx; names *are* case-sensitive and correct as they appear.\0Aset -l table_names name glyf cmap post OS/2 head hmtx hhea kern hdmx LTHS vmtx vhea VDMX loca maxp DSIG PCLT gasp prep fpgm cvt CFF VORG EBDT EBLC EBSC GSUB GPOS GDEF BASE JSTF Silf Glat Gloc Feat mort morx feat acnt bsln just lcar fdsc fmtx prop Zapf opbd trak fvar gvar avar cvar bdat bhed bloc hsty PfEd TeX BDF FFTM\0A\0Aset -l formats raw row bitwise extfile\0Aset -l line_endings LF CR CRLF\0Aset -l woff_fmts woff woff2\0A\0Acomplete -f -c ttx -k -a '(__fish_complete_suffix .otf .ttf .ttx .ttc)'\0Acomplete -c ttx -f -n \22__fish_is_nth_token 1\22 -k -a '(__fish_complete_suffix .otf .ttf .ttx)'\0A\0A# General options\0Acomplete -c ttx -f -s h -d'Show help message'\0Acomplete -c ttx -f -l version -d'Show version info'\0Acomplete -c ttx -x -s d -d'Set output folder' -a '(__fish_complete_directories)'\0Acomplete -c ttx -r -s o -d'Set output filename' -k -a '(__fish_complete_suffix .otf .ttf .ttx)'\0Acomplete -c ttx -f -s f -d'Force output overwrite'\0Acomplete -c ttx -f -s v -d'Verbose output'\0Acomplete -c ttx -f -s q -d'Quiet mode'\0Acomplete -c ttx -f -s a -d'Allow virtual glyph IDs'\0A\0A# Dump options\0Acomplete -c ttx -f -s l -d'List table info'\0Acomplete -c ttx -x -s t -d'Dump named table' -a \22$table_names\22\0Acomplete -c ttx -x -s x -d'Exclude named table' -a \22$table_names\22\0Acomplete -c ttx -f -s s -d'Split tables'\0Acomplete -c ttx -f -s g -d'Split glyf tables'\0Acomplete -c ttx -f -s i -d'Do NOT disassemble TT instructions'\0Acomplete -c ttx -x -s z -d'Use FORMAT for EBDT or CBDT' -a \22$formats\22\0Acomplete -c ttx -f -s e -d'Don\\'t ignore decompilation errors'\0Acomplete -c ttx -x -s y -d'Select font index for TrueType Collection'\0Acomplete -c ttx -x -l unicodedata -d'Custom database for character names [UnicodeData.txt]' -k -a '(__fish_complete_suffix .txt)'\0Acomplete -c ttx -x -l newline -d'Set EOL format' -a \22$line_endings\22\0A\0A# Compile options\0Acomplete -c ttx -x -s m -d'Merge named TTF/OTF with SINGLE .ttx input' -k -a '(__fish_complete_suffix .otf .ttf)'\0Acomplete -c ttx -f -s b -d'Don\\'t recalculate glyph bounding boxes'\0Acomplete -c ttx -f -l recalc-timestamp -d'Set font modified timestamp to current time'\0Acomplete -c ttx -x -l flavor -d'Set WOFF flavor' -a \22$woff_fmts\22\0Acomplete -c ttx -f -l with-zopfli -d'Compress with zopfli instead of zlib'\0A", align 1
