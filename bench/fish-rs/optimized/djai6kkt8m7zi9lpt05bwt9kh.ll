@anon.1d0b41a8d45d477c3029ec78f9b8b434.1568 = private unnamed_addr constant [586 x i8] c"complete -c entr -s a -d 'Respond to all events'\0Acomplete -c entr -s c -d 'Clear the screen before running'\0Acomplete -c entr -s d -d 'Track directories and exit if new file added'\0Acomplete -c entr -s n -d 'Run in non-interactive mode'\0Acomplete -c entr -s p -d 'Postpone execution of utility until a file is modified'\0Acomplete -c entr -s r -d 'Launch utility at startup and reload on file change'\0Acomplete -c entr -s s -d 'Evaluate using the interpreter in SHELL env variable'\0Acomplete -c entr -s z -d 'Exit after utility completes'\0Acomplete -c entr -x -a '(__fish_complete_subcommand)'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1569 = private unnamed_addr constant [20 x i8] c"completions/env.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1570 = private unnamed_addr constant [5326 x i8] c"set -l is_gnu\0Aif env --version &>/dev/null\0A    set is_gnu --is-gnu\0Aend\0A\0A# Returns 0 if we're after `env` and all previous tokens have an equal sign or were switches\0Afunction __fish_env_defining_vars\0A    set last \22\22\0A    for token in (commandline -cxp)[2..] # 2.. excludes `env`. -cx already ignores the variable being completed.\0A        # Is a switch, defined an env variable, or was a variable name to unset (after -u)\0A        string match -r -- '^-|=' $token || string match -rq -- '^(-u|--unset)$' \22$last\22 || return 1\0A        set last $token\0A    end\0Aend\0A\0A# Returns 0 if we're after `env` and all previous tokens have not yet contained an equal sign\0A# Prevents `env` completions from completing payload completions.\0Afunction __fish_env_not_yet_vars\0A    not string match -qe -- = (commandline -c)\0Aend\0A\0A# Generate a list of possible variable names to redefine, excluding any already redefined.\0Afunction __fish_env_redefine_vars\0A    set -l vars (set --names -x)\0A\0A    set cmdline \22$(commandline -xp)\22\0A    for var in $vars\0A        if not string match -eq -- $var= $cmdline\0A            echo $var=\0A        end\0A    end\0Aend\0A\0A# Generate a list of possible variable names to define from completion history\0Afunction __fish_env_names_from_history\0A    set -l token (commandline -ct)\0A    # Since this is always going to be a best-effort kind of thing, limit this to uppercased variables by convention.\0A    # This prevents us from having to parse quotes to figure out what was part of the payload and what wasn't.\0A    for var in (history search --prefix \22env \22 | string match -ra '\\b([A-Z0-9_]+)=' --groups-only)\0A        echo $var=\0A    end\0Aend\0A\0A# Generate a list of possible completions for the current variable name from history\0Afunction __fish_env_values_from_history\0A    string match -rq -- \22(?<name>.+)=(?<value>.*)\22 (commandline -ct); or return 1\0A\0A    # Caveat lector: very crude multi-word tokenization handling below!\0A    set -l rname (string escape --style=regex -- $name)\0A    set -l search (string trim -c \\'\\\22 \22$value\22)\0A    set -l rsearch \22$(string escape --style=regex -- $search)\22\0A    # Search multi-word values with quotes\0A    set -l query '.*\\b'$name'=([\\'\22])('$rsearch'.+?)\\1.*'\0A    set -l matches (history search --prefix \22env \22 | string replace -rfa $query '$2')\0A    # Search multi-word values without quotes\0A    set -l query '.*\\b'$name'=('$rsearch'[^\\'\22 ]+).*'\0A    set -a matches (history search --prefix \22env \22 | string replace -rfa $query '$1')\0A    # Display results without quotes\0A    set matches (printf \22%s\\n\22 $matches | sort -u)\0A    printf \22$name=%s\\n\22 $matches\0Aend\0A\0A# Get the text after all env arguments and variables, so we can complete it as a regular command\0Afunction __fish_env_remaining_args -V is_gnu\0A    set -l argv (commandline -xpc | string escape) (commandline -ct)\0A    if set -q is_gnu[1]\0A        argparse -s i/ignore-environment u/unset= help version -- $argv 2>/dev/null\0A        or return 0\0A    else\0A        argparse -s 0 i P= S= u= v -- $argv 2>/dev/null\0A        or return 0\0A    end\0A\0A    # argv[1] is `env` or an alias.\0A    set -e argv[1]\0A\0A    # Remove all VAR=VAL arguments up to the first that isn't\0A    while set -q argv[1]\0A        if string match -q '*=*' -- $argv[1]\0A            or string match -q -- '-*' $argv[1]\0A            set -e argv[1]\0A        else\0A            break\0A        end\0A    end\0A\0A    string join \\n -- $argv\0A\0A    # Return true if there is a subcommand.\0A    test -n \22$argv[1]\22\0Aend\0A\0A# Generate a completion for the executable to execute under `env`\0Afunction __fish_complete_env_subcommand\0A    if set -l argv (__fish_env_remaining_args)\0A        complete -C \22$argv\22\0A    end\0Aend\0A\0A# Complete the name of the variable from current definitions\0Acomplete -c env -n '__fish_env_defining_vars; and not string match -eq = -- (commandline -ct)' -a \22(__fish_env_redefine_vars)\22 -f -d \22Redefine variable\22\0A# Complete the name of the variable from history\0Acomplete -c env -n '__fish_env_defining_vars; and not string match -eq = -- (commandline -ct)' -a \22(__fish_env_names_from_history)\22 -f -d Historical\0A# Complete the value for FOO= from history\0A# TODO: NO_ESCAPE when that becomes available\0Acomplete -c env -n '__fish_env_defining_vars; and string match -eq = -- (commandline -ct)' -a \22(__fish_env_values_from_history)\22 -f\0A\0A# Complete normally after we are done with `env` stuff\0Acomplete -c env -fa \22(__fish_complete_env_subcommand)\22\0A\0Aif set -q is_gnu\0A    complete -c env -n __fish_env_not_yet_vars -s i -l ignore-environment -d \22Start with an empty environment\22\0A    complete -c env -n __fish_env_not_yet_vars -s u -l unset -d \22Unset environment variable\22 -x -a \22(set --names -x)\22\0A    complete -c env -n __fish_env_not_yet_vars -l help -d \22Display help and exit\22\0A    complete -c env -n __fish_env_not_yet_vars -l version -d \22Display version and exit\22\0Aelse\0A    complete -c env -n __fish_env_not_yet_vars -s 0 -d \22End output lines with NUL\22\0A    complete -c env -n __fish_env_not_yet_vars -s i -d \22Start with empty environment\22\0A    complete -c env -n __fish_env_not_yet_vars -s P -d \22Provide an alternate PATH\22\0A    complete -c env -n __fish_env_not_yet_vars -s S -d \22Split argument into args on ' '\22\0A    complete -c env -n __fish_env_not_yet_vars -s u -d \22Unset environment variable\22 -x -a \22(set --names -x)\22\0A    complete -c env -n __fish_env_not_yet_vars -s v -d \22Verbose output on processing\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1571 = private unnamed_addr constant [22 x i8] c"completions/eopkg.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1572 = private unnamed_addr constant [8405 x i8] c"#\0A# Completions for eopkg, Solus' package manager\0A#\0A\0Afunction __fish_eopkg_subcommand -a subcommand\0A    set -e argv[1]\0A    complete -f -c eopkg -n __fish_use_subcommand -a $subcommand $argv\0Aend\0A\0Afunction __fish_eopkg_subcommand_with_shortcut -a subcommand shortcut\0A    set -e argv[1..2]\0A    complete -f -c eopkg -n __fish_use_subcommand -a $subcommand $argv\0A    complete -f -c eopkg -n __fish_use_subcommand -a $shortcut $argv\0Aend\0A\0Afunction __fish_eopkg_option -a subcommand\0A    set -e argv[1]\0A    complete -f -c eopkg -n \22__fish_seen_subcommand_from $subcommand\22 $argv\0Aend\0A\0Afunction __fish_eopkg_option_with_shortcut -a subcommand shortcut\0A    set -e argv[1..2]\0A    complete -f -c eopkg -n \22__fish_seen_subcommand_from $subcommand\22 $argv\0A    complete -f -c eopkg -n \22__fish_seen_subcommand_from $shortcut\22 $argv\0Aend\0A\0Afunction __fish_eopkg_print_components -d \22Print list of components\22\0A    eopkg list-components -N | string replace -r ' .*' ''\0Aend\0A\0Afunction __fish_eopkg_print_repos -d \22Print list of repositories\22\0A    eopkg list-repo -N | string match -e active | string replace -r ' .*' ''\0Aend\0A\0Acomplete -f -c eopkg -n '__fish_seen_subcommand_from remove-repo rr enable-repo er disable-repo dr list-available la' -a \22(__fish_eopkg_print_repos)\22 -d Repository\0Acomplete -f -c eopkg -n '__fish_seen_subcommand_from upgrade up install it info' -a \22(__fish_print_eopkg_packages)\22 -d \22Available Package\22\0Acomplete -f -c eopkg -n '__fish_seen_subcommand_from remove rm autoremove rmf check' -a \22(__fish_print_eopkg_packages --installed)\22 -d \22Installed package\22\0Acomplete -f -c eopkg -n '__fish_seen_subcommand_from upgrade up remove rm install it info check list-available la list-installed li list-upgrades lu' -s c -l component -a \22(__fish_eopkg_print_components)\22 -d Component\0A\0A## Upgrade\0A__fish_eopkg_subcommand_with_shortcut upgrade up -d \22Upgrades packages\22\0A__fish_eopkg_option_with_shortcut upgrade up -l security-only -d \22Security related upgrades only\22\0A__fish_eopkg_option_with_shortcut upgrade up -s c -l component -x -d \22Upgrade component's and recursive components' packages\22\0A__fish_eopkg_option_with_shortcut upgrade up -s n -l dry-run -d \22Show what would be done\22\0A\0A## Install\0A__fish_eopkg_subcommand_with_shortcut install it -d \22Install packages\22\0A__fish_eopkg_option_with_shortcut install it -l reinstall -d \22Reinstall already installed packages\22\0A__fish_eopkg_option_with_shortcut install it -s c -l component -x -d \22Install component's and recursive components' packages\22\0A__fish_eopkg_option_with_shortcut install it -s n -l dry-run -d \22Show what would be done\22\0A\0A## Remove\0A__fish_eopkg_subcommand_with_shortcut remove rm -d \22Remove packages\22\0A__fish_eopkg_option_with_shortcut remove rm -l purge -d \22Removes everything including changed config files of the package\22\0A__fish_eopkg_option_with_shortcut remove rm -s c -l component -x -d \22Remove component's and recursive components' packages\22\0A__fish_eopkg_option_with_shortcut remove rm -s n -l dry-run -d \22Show what would be done\22\0A\0A## Remove Orphans\0A__fish_eopkg_subcommand_with_shortcut remove-orphans rmo -d \22Remove orphaned packages\22\0A__fish_eopkg_option_with_shortcut remove-orphans rmo -l purge -d \22Remove everything including changed config files of the package\22\0A__fish_eopkg_option_with_shortcut remove-orphans rmo -s n -l dry-run -d \22Show what would be done\22\0A\0A## Autoremove\0A__fish_eopkg_subcommand_with_shortcut autoremove rmf -d \22Remove packages and dependencies\22\0A__fish_eopkg_option_with_shortcut autoremove rmf -l purge -d \22Remove everything including changed config files of the package\22\0A__fish_eopkg_option_with_shortcut autoremove rmf -s n -l dry-run -d \22Show what would be done\22\0A\0A## History\0A__fish_eopkg_subcommand_with_shortcut history hs -d \22History of operations\22\0A__fish_eopkg_option_with_shortcut history hs -s l -l last -x -d \22Output only the last n operations\22\0A__fish_eopkg_option_with_shortcut history hs -s t -l takeback -x -d \22Takeback to the state after the given operation\22\0A\0A## Search\0A__fish_eopkg_subcommand_with_shortcut search sr -d \22Search packages\22\0A__fish_eopkg_option_with_shortcut search sr -l description -d \22Search in package name\22\0A__fish_eopkg_option_with_shortcut search sr -l name -d \22Search in package name\22\0A__fish_eopkg_option_with_shortcut search sr -l summary -d \22Search in package name\22\0A__fish_eopkg_option_with_shortcut search sr -s i -l installdb -d \22Search only installed package\22\0A__fish_eopkg_option_with_shortcut search sr -s r -l repository -x -d \22Name of the source or package repository\22\0Acomplete -f -c eopkg -n '__fish_seen_subcommand_from search sr' -s r -l repository -a \22(__fish_eopkg_print_repos)\22 -d Repository\0A\0A## Search File\0A__fish_eopkg_subcommand_with_shortcut search-file sf -d \22Search for a file in installed packages\22\0A__fish_eopkg_option_with_shortcut search-file sf -s l -l long -d \22Show in long format\22\0A__fish_eopkg_option_with_shortcut search-file sf -s q -l quiet -d \22Show only package name\22\0A\0A## Repo Management\0A__fish_eopkg_subcommand_with_shortcut add-repo ar -r -d \22Add a repository\22\0A__fish_eopkg_subcommand_with_shortcut disable-repo dr -x -d \22Disable repositories\22\0A__fish_eopkg_subcommand_with_shortcut enable-repo er -x -d \22Enable repositories\22\0A__fish_eopkg_subcommand_with_shortcut remove-repo rr -x -d \22Remove repositories\22\0A\0A## List Available\0A__fish_eopkg_subcommand_with_shortcut list-available la -d \22List available packages in the repositories\22\0A__fish_eopkg_option_with_shortcut list-available la -s c -l component -x -d \22List available package under given component\22\0A__fish_eopkg_option_with_s