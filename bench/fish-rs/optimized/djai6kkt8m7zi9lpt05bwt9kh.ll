@anon.1d0b41a8d45d477c3029ec78f9b8b434.2008 = private unnamed_addr constant [1236 x i8] c"__fish_complete_lpr lpstat\0Acomplete -c lpstat -s H -d 'Show server hostname and port'\0Acomplete -c lpstat -s R -d 'Shows ranking of print jobs'\0Acomplete -c lpstat -s W -d 'Specify which jobs to show' -xa 'completed not-completed'\0Acomplete -c lpstat -s a -d 'Shows accepting state of selected printer queues' -xa '(__fish_print_lpr_printers)'\0Acomplete -c lpstat -s c -x -d 'Shows printer classes and the printers that belong to them'\0Acomplete -c lpstat -s d -d 'Shows the current default destination'\0Acomplete -c lpstat -s l -d 'Shows list of printers, classes, or jobs'\0Acomplete -c lpstat -s o -d 'Shows jobs queue on the specified destinations' -xa '(__fish_print_lpr_printers)'\0Acomplete -c lpstat -s p -d 'Shows printers and if they are enabled for printing' -xa '(__fish_print_lpr_printers)'\0Acomplete -c lpstat -s r -d 'Shows whether the CUPS server is running'\0Acomplete -c lpstat -s s -d 'Shows a status summary, including default destination'\0Acomplete -c lpstat -s t -d 'Shows all status information'\0Acomplete -c lpstat -s u -d 'Shows a list of print jobs queued by the specified users' -xa '(__fish_complete_users)'\0Acomplete -c lpstat -s v -d 'Shows printers and what device they are attached to' -xa '(__fish_print_lpr_printers)'\0A", align 1
