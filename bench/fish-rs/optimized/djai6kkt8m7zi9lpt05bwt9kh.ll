@anon.1d0b41a8d45d477c3029ec78f9b8b434.1180 = private unnamed_addr constant [1934 x i8] c"complete -c atool -r -d 'Manage file archives of various types'\0A\0A# Commands:\0Acomplete -c atool -s l -l list -d 'list files in archive (als)'\0Acomplete -c atool -s x -l extract -d 'extract files from archive (aunpack)'\0Acomplete -c atool -s X -l extract-to -r -d 'extract archive to specified directory'\0Acomplete -c atool -s a -l add -d 'create archive (apack)'\0Acomplete -c atool -s c -l cat -d 'extract file to standard out (acat)'\0Acomplete -c atool -s d -l diff -d 'generate a diff between two archives (adiff)'\0Acomplete -c atool -s r -l repack -d 'repack archives to a different format (arepack)'\0Acomplete -c atool -l help -d 'display this help and exit'\0Acomplete -c atool -l version -d 'output version information and exit'\0A\0A# Options:\0Acomplete -c atool -s e -l each -d 'execute command above for each file specified'\0Acomplete -c atool -s F -l format -d 'override archive format (see below)' -xa \22(man atool | string -r '^\\s+\\S+\\s+\\(\\..+\\)' | string replace -r '^\\s+(\\S+)\\s+\\((\\..+)\\)' '$1\\t$2')\22\0Acomplete -c atool -s O -l format-option -x -d 'give specific options to the archiver'\0Acomplete -c atool -s D -l subdir -d 'always create subdirectory when extracting'\0Acomplete -c atool -s f -l force -d 'allow overwriting of local files'\0Acomplete -c atool -s q -l quiet -d 'decrease verbosity level by one'\0Acomplete -c atool -s v -l verbose -d 'increase verbosity level by one'\0Acomplete -c atool -s V -l verbosity -d 'specify verbosity (0, 1 or 2)' -xa '(seq 0 2)'\0Acomplete -c atool -s p -l page -d 'send output through pager'\0Acomplete -c atool -s 0 -l null -d 'filenames from standard in are null-byte separated'\0Acomplete -c atool -s E -l explain -d 'explain what is being done by atool'\0Acomplete -c atool -s S -l simulate -d 'simulation mode - no filesystem changes are made'\0Acomplete -c atool -s o -l option -x -d 'override a configuration option (KEY=VALUE)'\0Acomplete -c atool -l config -r -d 'load configuration defaults from file'\0A", align 1
