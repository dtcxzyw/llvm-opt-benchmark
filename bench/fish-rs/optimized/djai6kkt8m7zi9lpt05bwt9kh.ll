@anon.1d0b41a8d45d477c3029ec78f9b8b434.1776 = private unnamed_addr constant [1422 x i8] c"# Completion for grunt\0A\0A# grunt-cli\0A# http://gruntjs.com/\0A#\0A# Copyright (c) 2012 Tyler Kellen, contributors\0A# Licensed under the MIT license.\0A# https://github.com/gruntjs/grunt/blob/master/LICENSE-MIT\0A\0Afunction __grunt_print_tasks\0A    grunt --version --verbose 2>/dev/null | awk '/Available tasks: / {$1=$2=\22\22; print $0}' | awk '{$1=$1}1' | string split ' '\0Aend\0A\0Acomplete -c grunt -fa '(__grunt_print_tasks)'\0Acomplete -c grunt -s h -l help -d \22Display help text\22\0Acomplete -c grunt -l base -d \22Specify an alternate base path\22\0Acomplete -c grunt -l no-color -d \22Disable colored output\22\0Acomplete -c grunt -l gruntfile -rd \22Specify an alternate Gruntfile\22\0Acomplete -c grunt -s d -l debug -d \22Enable debugging mode for tasks that support it\22\0Acomplete -c grunt -l stack -d \22Print a stack trace when exiting with a warning or fatal error\22\0Acomplete -c grunt -s f -l force -d \22A way to force your way past warnings.\22\0Acomplete -c grunt -l tasks -rd \22Additional directory paths to scan for task and \22extra\22 files\22\0Acomplete -c grunt -l npm -x -d \22Npm-installed grunt plugins to scan for task and \22extra\22 files\22\0Acomplete -c grunt -l no-write -d \22Disable writing files (dry run)\22\0Acomplete -c grunt -s v -l verbose -d \22Verbose mode. A lot more information output\22\0Acomplete -c grunt -s V -l version -d \22Print the grunt version. Combine with --verbose for more info\22\0Acomplete -c grunt -l completion -d \22Output shell auto-completion rules.\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1777 = private unnamed_addr constant [26 x i8] c"completions/gsettings.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1778 = private unnamed_addr constant [4412 x i8] c"# Fish completions for glibs's \22gsettings\22 configuration tool\0A\0Afunction __fish_complete_gsettings_args\0A    set -l schema_commands get monitor writable range describe set reset reset-recursively list-keys list-children list-recursively\0A    set -l key_commands get monitor writable range describe set reset\0A\0A    set -l schemadir\0A    set -l cmd (commandline -pxc)\0A    set -e cmd[1]\0A\0A    if set -q cmd[2]\0A        and string match -q -- --schemadir $cmd[1]\0A        # TODO: This needs to support proper expansion of paths (~, variables, etc.)\0A        set schemadir --schemadir $cmd[2]\0A        set -e cmd[1..2]\0A    end\0A\0A    if not set -q cmd[1]\0A        return 1\0A    end\0A\0A    set -l subcommand $cmd[1]\0A\0A    if not contains -- $subcommand $schema_commands\0A        return 1\0A    end\0A\0A    if not set -q cmd[2]\0A        # Non-relocatable schemas\0A        gsettings $schemadir list-schemas 2>/dev/null\0A\0A        # Relocatable schemas require a dconf path, but there is no universal way of\0A        # finding the right paths to suggest here. Just default to '/'.\0A        gsettings $schemadir list-relocatable-schemas 2>/dev/null | string replace -r \\$ ':/'\0A        return 0\0A    end\0A\0A    if not contains -- $subcommand $key_commands\0A        return 1\0A    end\0A\0A    set -l schema $cmd[2]\0A\0A    if not set -q cmd[3]\0A        gsettings $schemadir list-keys $schema 2>/dev/null\0A        return 0\0A    end\0A\0A    if test $subcommand != set\0A        return 1\0A    end\0A\0A    if not set -q cmd[4]\0A        set -l key $cmd[3]\0A        set -l range (gsettings $schemadir range $schema $key 2>/dev/null)\0A        set -l key_type $range[1]\0A        set -e range[1]\0A        switch $key_type\0A            case 'type b'\0A                echo true\0A                echo false\0A            case enum\0A                string join \\n $range\0A            case '*'\0A                # If no sensible suggestions can be made, just use the current value.\0A                # It gives a good indication on the expected format and is likely already close to what the user wants.\0A                gsettings $schemadir get $schema $key 2>/dev/null\0A        end\0A        return 0\0A    end\0A\0A    return 1\0Aend\0A\0Aset -l valid_commands get monitor writable range describe set reset reset-recursively list-schemas list-relocatable-schemas list-keys list-children list-recursively help\0A\0Acomplete -f -c gsettings\0A\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -l version -d 'Print the version information'\0Acomplete -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -l schemadir -d 'Specify a custom schemas directory' -xa \22(__fish_complete_directories (commandline -ct))\22\0A\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a get -d 'Get the value of a key'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a writable -d 'Determine if a key is writable'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a range -d 'Determine the valid value range of a key'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a describe -d 'Print the description of a key'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a set -d 'Set the value of a key'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a reset -d 'Reset a key to its default value'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a reset-recursively -d 'Reset all keys under the given schema'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a list-schemas -d 'List all installed, non-relocatable schemas'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a list-relocatable-schemas -d 'List all installed, relocatable schemas'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a list-keys -d 'List all keys in a schema'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a list-children -d 'List all children of a schema'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a list-recursively -d 'List keys and values, recursively'\0Acomplete -f -c gsettings -n \22not __fish_seen_subcommand_from $valid_commands\22 -a help -d 'Print help'\0A\0Acomplete -f -c gsettings -n \22__fish_seen_subcommand_from $valid_commands\22 -xa \22(__fish_complete_gsettings_args)\22\0A", align 1
