@anon.1d0b41a8d45d477c3029ec78f9b8b434.3396 = private unnamed_addr constant [1263 x i8] c"# This function is intended to be used as a validation command for individual option specifications\0A# given to the `argparse` command. It checks that the argument is a valid integer and optionally\0A# whether it is in a reasonable range.\0Afunction _validate_int --no-scope-shadowing\0A    # Note that we can't use ourself to validate the arguments to the --min and --max flags this\0A    # function recognizes.\0A    set -l options 'm-min=' 'x-max='\0A    argparse -n _argparse_validate_int $options -- $argv\0A    or return\0A\0A    if not string match -qr '^-?\\d+$' -- $_flag_value\0A        set -l msg (_ \22%s: Value '%s' for flag '%s' is not an integer\\n\22)\0A        printf $msg $_argparse_cmd $_flag_value $_flag_name >&2\0A        return 1\0A    end\0A\0A    if set -q _flag_min\0A        and test $_flag_value -lt $_flag_min\0A        set -l msg (_ \22%s: Value '%s' for flag '%s' less than min allowed of '%s'\\n\22)\0A        printf $msg $_argparse_cmd $_flag_value $_flag_name $_flag_min >&2\0A        return 1\0A    end\0A\0A    if set -q _flag_max\0A        and test $_flag_value -gt $_flag_max\0A        set -l msg (_ \22%s: Value '%s' for flag '%s' greater than max allowed of '%s'\\n\22)\0A        printf $msg $_argparse_cmd $_flag_value $_flag_name $_flag_max >&2\0A        return 1\0A    end\0A\0A    return 0\0Aend\0A", align 1
