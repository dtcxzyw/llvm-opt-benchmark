@anon.1d0b41a8d45d477c3029ec78f9b8b434.2416 = private unnamed_addr constant [1138 x i8] c"function __fish_complete_pushd_plus\0A    if count $dirstack >/dev/null\0A        # print each member of the stack, replace $HOME with ~\0A        for i in (seq (count $dirstack))\0A            printf \22+%s\\t%s\\n\22 $i \22Rotate to \22(string replace -r \22^$HOME\22 \22~\22 -- $dirstack[$i])\0A        end\0A    end\0Aend\0A\0Afunction __fish_complete_pushd_minus\0A    if count $dirstack >/dev/null\0A        # print each member of the stack, replace $HOME with ~\0A        # Negative arguments are expected to start at \22-0\22\0A        for i in (seq (count $dirstack) -1 1)\0A            printf \22%s\\t%s\\n\22 -(math $i - 1) \22Rotate to \22(string replace -r \22^$HOME\22 \22~\22 -- $dirstack[(math -$i)])\0A        end\0A    end\0Aend\0A\0Afunction __fish_complete_pushd_swap\0A    if count $dirstack >/dev/null\0A        # replace $HOME with ~\0A        printf \22\\t%s\\n\22 \22Swap with \22(string replace -r \22^$HOME\22 \22~\22 -- $dirstack[1])\0A    end\0Aend\0A\0A# support pushd <dir>\0Acomplete -c pushd -a \22(__fish_complete_cd)\22\0A\0A# support pushd <>\0Acomplete -c pushd -a '(__fish_complete_pushd_swap)'\0A\0A# support pushd <+n>\0Acomplete -c pushd -a '(__fish_complete_pushd_plus)'\0Acomplete -c pushd -a '(__fish_complete_pushd_minus)'\0A", align 1
