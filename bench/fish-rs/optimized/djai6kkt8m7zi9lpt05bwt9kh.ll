@anon.1d0b41a8d45d477c3029ec78f9b8b434.3130 = private unnamed_addr constant [388 x i8] c"function __fish_complete_groups --description \22Print a list of local groups, with group members as the description\22\0A    if command -sq getent\0A        getent group | while read -l line\0A            string split -f 1,4 : -- $line | string join \\t\0A        end\0A    else\0A        while read -l line\0A            string split -f 1,4 : -- $line | string join \\t\0A        end </etc/group\0A    end\0Aend\0A", align 1
