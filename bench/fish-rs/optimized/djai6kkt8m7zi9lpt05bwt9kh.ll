@anon.1d0b41a8d45d477c3029ec78f9b8b434.1884 = private unnamed_addr constant [10795 x i8] c"# Execute an `iwctl ... list` command and parse output\0Afunction __iwctl_filter -w iwctl\0A    # set results \22iwctl $cmd list | tail -n +5\22\0A    # if test -n \22$empty\22\0A    #     set -a results \22| string match --invert '*$empty*'\22\0A    # end\0A    # eval \22$results\22 | awk '{print $2}'\0A    # awk does not work on multiline entries, therefore we use string match,\0A    # which has the added benefit of filtering out the `No devices in ...` lines\0A\0A    argparse -i all-columns -- $argv\0A\0A    # remove color escape sequences\0A    set -l results (iwctl $argv | string replace -ra '\\e\\[[\\d;]+m' '')\0A    # calculate column widths\0A    set -l headers $results[3]\0A    # We exploit the fact that all column labels will have >2 space to the left, and inside column labels there is always only one space.\0A    set -l leading_ws (string match -r \22^ *\22 -- $headers | string length)\0A    set -l column_widths (string match -a -r '(?<=  )\\S.*?(?:  (?=\\S)|$)' -- $headers | string length)\0A\0A    if set -ql _flag_all_columns\0A        for line in (string match \22  *\22 -- $results[5..] | string sub -s (math $leading_ws + 1))\0A            for column_width in $column_widths\0A                printf %s\\t (string sub -l $column_width -- $line | string trim -r)\0A                set line (string sub -s (math $column_width + 1) -- $line)\0A            end\0A            printf \22\\n\22\0A        end\0A    else if set -q column_widths[1]\0A        # only take lines starting with `  `, i.e., no `No devices ...`\0A        # then take the first column as substring\0A        string match \22  *\22 $results[5..] | string sub -s (math $leading_ws + 1) -l $column_widths[1] | string trim -r\0A    end\0Aend\0A\0Afunction __iwctl_match_subcoms\0A    set -l match (string split --no-empty \22 \22 -- $argv)\0A\0A    set argv (commandline -pxc)\0A    # iwctl allows to specify arguments for username, password, passphrase and dont-ask regardless of any following commands\0A    argparse -i 'u/username=' 'p/password=' 'P/passphrase=' v/dont-ask -- $argv\0A    set argv $argv[2..]\0A\0A    if test (count $argv) != (count $match)\0A        return 1\0A    end\0A\0A    while set -q argv[1]\0A        string match -q -- $match[1] $argv[1]\0A        or return 1\0A        set -e match[1] argv[1]\0A    end\0Aend\0A\0Afunction __iwctl_connect\0A    set argv (commandline -pxc)\0A    # remove all options\0A    argparse -i 'u/username=' 'p/password=' 'P/passphrase=' v/dont-ask -- $argv\0A    # station name should now be the third argument (`iwctl station <wlan>`)\0A    for network in (__iwctl_filter station $argv[3] get-networks rssi-dbms --all-columns)\0A        set network (string split \\t -- $network)\0A        set -l strength \22$network[3]\22\0A        # This follows iwctls display of * to ****\0A        # https://git.kernel.org/pub/scm/network/wireless/iwd.git/tree/client/station.c?id=4a0a97379008489daa108c9bc0a4204c1ae9c6a8#n380\0A        if test $strength -ge -6000\0A            set strength 4\0A        else if test $strength -ge -6700\0A            set strength 3\0A        else if test $strength -ge -7500\0A            set strength 2\0A        else\0A            set strength 1\0A        end\0A\0A        printf \22%s\\t[%s] - %s\\n\22 \22$network[1]\22 (string repeat -n $strength '*' | string pad -rw 4 -c -) \22$network[2]\22\0A    end\0Aend\0A\0A# The `empty` messages in case we want to go back to using those\0A# set ad_hoc '(__iwctl_filter ad-hoc \22No devices in Ad-Hoc mode available.\22)'\0A# set adapter '(__iwctl_filter adapter)'\0A# set ap '(__iwctl_filter ap \22No devices in access point mode available.\22)'\0A# set device '(__iwctl_filter device)'\0A# set dpp '(__iwctl_filter dpp \22No DPP-capable devices available\22)'\0A# set known_networks '(__iwctl_filter known-networks)'\0A# set station '(__iwctl_filter station \22No devices in Station mode available.\22)'\0A# set wsc '(__iwctl_filter wsc \22No WSC-capable devices available\22)'\0A\0Acomplete -f iwctl\0A\0A# Options\0Acomplete -c iwctl -s h -l help\0Acomplete -c iwctl -s p -l password -rf\0Acomplete -c iwctl -s u -l username -rf\0Acomplete -c iwctl -s P -l passphrase -rf\0Acomplete -c iwctl -s v -l dont-ask -d \22Don't ask for missing credentials\22\0A\0A# Subcommand\0Acomplete -c iwctl -n __iwctl_match_subcoms \\\0A    -a \22ad-hoc adapter ap debug device dpp exit help known-networks quit station version wsc\22\0A\0A# ad-hoc\0Acomplete -c iwctl -n '__iwctl_match_subcoms ad-hoc' -a list -d \22List devices in Ad-Hoc mode\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms ad-hoc' -a \22(__iwctl_filter ad-hoc list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ad-hoc *\22' -n 'not __iwctl_match_subcoms ad-hoc list' -a start -d \22Start or join an Ad-Hoc network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ad-hoc *\22' -n 'not __iwctl_match_subcoms ad-hoc list' -a start_open -d \22Start of join an open Ad-Hoc network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ad-hoc *\22' -n 'not __iwctl_match_subcoms ad-hoc list' -a stop -d \22Leave an Ad-Hoc network\22\0A\0A# adapter\0Acomplete -c iwctl -n '__iwctl_match_subcoms adapter' -a list -d \22List adapters\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms adapter' -a \22(__iwctl_filter adapter list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22adapter *\22' -n 'not __iwctl_match_subcoms adapter list' -a show -d \22Show adapter info\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22adapter *\22' -n 'not __iwctl_match_subcoms adapter list' -a set-property -d \22Set property\22\0A# TODO implement completions for `properties`, i.e. all rows with `*` in first column\0A\0A# ap\0Acomplete -c iwctl -n '__iwctl_match_subcoms ap' -a list -d \22List devices in AP mode\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms ap' -a \22(__iwctl_filter ap list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ap *\22' -n 'not __iwctl_match_subcoms ap list' -a start -d \22Start an access point\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ap *\22' -n 'not __iwctl_match_subcoms ap list' -a start-profile -d \22Start an access point based on a disk profile\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ap *\22' -n 'not __iwctl_match_subcoms ap list' -a stop -d \22Stop a started access point\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ap *\22' -n 'not __iwctl_match_subcoms ap list' -a show -d \22Show AP info\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22ap *\22' -n 'not __iwctl_match_subcoms ap list' -a get-networks -d \22Get network list after scanning\22\0A\0A# debug\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22debug *\22' -a connect -d \22Connect to a specific BSS\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22debug *\22' -a roam -d \22Roam to a BSS\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22debug *\22' -a get-networks -d \22Get networks\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22debug *\22' -a autoconnect -d \22Set autoconnect property\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22debug * autoconnect\22' -a \22on off\22 -d \22Set autoconnect property\22\0A\0A# device\0Acomplete -c iwctl -n '__iwctl_match_subcoms device' -a list -d \22List devices\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms device' -a \22(__iwctl_filter device list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22device *\22' -n 'not __iwctl_match_subcoms device list' -a show -d \22Show device info\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22device *\22' -n 'not __iwctl_match_subcoms device list' -a set-property -d \22Set property\22\0A# TODO implement completions for `properties`, i.e. all rows with `*` in first column\0A\0A# dpp\0Acomplete -c iwctl -n '__iwctl_match_subcoms dpp' -a list -d \22List DPP-capable devices\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms dpp' -a \22(__iwctl_filter dpp list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22dpp *\22' -n 'not __iwctl_match_subcoms dpp list' -a start-enrollee -d \22Starts a DPP Enrollee\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22dpp *\22' -n 'not __iwctl_match_subcoms dpp list' -a start-configurator -d \22Starts a DPP Configurator\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22dpp *\22' -n 'not __iwctl_match_subcoms dpp list' -a stop -d \22Aborts a DPP operations\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22dpp *\22' -n 'not __iwctl_match_subcoms dpp list' -a show -d \22Show the DPP state\22\0A\0A# known-networks\0A# TODO Does not support SSIDs ending/starting on whitespace. Not sure how to fix.\0Acomplete -c iwctl -n '__iwctl_match_subcoms known-networks' -a list -d \22List known networks\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms known-networks' -a \22(__iwctl_filter known-networks list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22known-networks *\22' -n 'not __iwctl_match_subcoms known-networks list' -a forget -d \22Forget a known network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22known-networks *\22' -n 'not __iwctl_match_subcoms known-networks list' -a show -d \22Show known network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22known-networks *\22' -n 'not __iwctl_match_subcoms known-networks list' -a set-property -d \22Set property\22\0A\0A# station\0Acomplete -c iwctl -n '__iwctl_match_subcoms station' -a list -d \22List devices in Station mode\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms station' -a \22(__iwctl_filter station list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a connect -d \22Connect to network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station * connect\22' -a \22(__iwctl_connect)\22 -d \22Connect to network\22 --keep-order\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a connect-hidden -d \22Connect to hidden network\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a disconnect -d Disconnect\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a get-networks -d \22Get networks\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station * get-networks\22' -a \22rssi-dbms rssi-bars\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a get-hidden-access-points -d \22Get hidden APs\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station * get-hidden-access-points\22' -a rssi-dbms\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a scan -d \22Scan for networks\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22station *\22' -n 'not __iwctl_match_subcoms station list' -a show -d \22Show station info\22\0A\0A# wsc\0Acomplete -c iwctl -n '__iwctl_match_subcoms wsc' -a list -d \22List WSC-capable devices\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms wsc' -a \22(__iwctl_filter wsc list)\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22wsc *\22' -n 'not __iwctl_match_subcoms wsc list' -a push-button -d \22PushButton Mode\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22wsc *\22' -n 'not __iwctl_match_subcoms wsc list' -a start-user-pin -d \22PIN mode\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22wsc *\22' -n 'not __iwctl_match_subcoms wsc list' -a start-pin -d \22PIN mode with generated PIN\22\0Acomplete -c iwctl -n '__iwctl_match_subcoms \22wsc *\22' -n 'not __iwctl_match_subcoms wsc list' -a cancel -d \22Aborts WSC operations\22\0A", align 1
