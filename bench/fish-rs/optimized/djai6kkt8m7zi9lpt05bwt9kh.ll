@anon.1d0b41a8d45d477c3029ec78f9b8b434.1188 = private unnamed_addr constant [1687 x i8] c"function __attributes_disk_complete_args\0A    if not __fish_seen_subcommand_from set clear\0A        echo -e 'set\\tSet the specified attribute of the disk with focus\0Aclear\\tClear the specified attribute of the disk with focus'\0A        return\0A    end\0A\0A    echo -e 'readonly\\tSpecify that the disk is read-only\0Anoerr\\tWhen an error is encountered, DiskPart continues to process commands'\0Aend\0A\0Afunction __attributes_volume_complete_args\0A    if not __fish_seen_subcommand_from set clear\0A        echo -e 'set\\tSet the specified attribute of the volume with focus\0Aclear\\tClear the specified attribute of the volume with focus'\0A        return\0A    end\0A\0A    if not __fish_seen_subcommand_from readonly hidden nodefaultdriveletter shadowcopy\0A        echo -e 'readonly\\tSpecify that the volume is read-only\0Ahidden\\tSpecify that the volume is hidden\0Anodefaultdriveletter\\tSpecify that the volume does not receive a drive letter by default\0Ashadowcopy\\tSpecify that the volume is a shadow copy volume'\0A    end\0A\0A    echo -e 'noerr\\tWhen an error is encountered, DiskPart continues to process commands'\0Aend\0A\0Afunction __attributes_complete_args -d 'Function to generate args'\0A    if __fish_seen_subcommand_from disk\0A        __attributes_disk_complete_args\0A    else if __fish_seen_subcommand_from volume\0A        __attributes_volume_complete_args\0A    end\0Aend\0A\0Acomplete -c attributes -f -a '(__attributes_complete_args)'\0A\0Acomplete -c attributes -f -n 'not __fish_seen_subcommand_from disk volume' -a disk \\\0A    -d 'Display, set, or clear the attributes of a disk'\0Acomplete -c attributes -f -n 'not __fish_seen_subcommand_from dick volume' -a volume \\\0A    -d 'Display, set, or clear the attributes of a volume'\0A", align 1
