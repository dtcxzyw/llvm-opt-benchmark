@anon.1d0b41a8d45d477c3029ec78f9b8b434.3500 = private unnamed_addr constant [2202 x i8] c"if not command -qs man\0A    # see #5329 and discussion at https://github.com/fish-shell/fish-shell/commit/13e025bdb01cc4dd08463ec497a0a3495873702f\0A    exit\0Aend\0A\0Afunction man --description \22Format and display the on-line manual pages\22\0A    # Work around the \22builtin\22 manpage that everything symlinks to,\0A    # by prepending our fish datadir to man. This also ensures that man gives fish's\0A    # man pages priority, without having to put fish's bin directories first in $PATH.\0A\0A    # Preserve the existing MANPATH, and default to the system path (the empty string).\0A    set -l manpath\0A    if set -q MANPATH\0A        set manpath $MANPATH\0A    else if set -l p (command man -p 2>/dev/null)\0A        # NetBSD's man uses \22-p\22 to print the path.\0A        # FreeBSD's man also has a \22-p\22 option, but that requires an argument.\0A        # Other mans (men?) don't seem to have it.\0A        #\0A        # Unfortunately NetBSD prints things like \22/usr/share/man/man1\22,\0A        # while not allowing them as $MANPATH components.\0A        # What it needs is just \22/usr/share/man\22.\0A        #\0A        # So we strip the last component.\0A        # This leaves a few wrong directories, but that should be harmless.\0A        set manpath (string replace -r '[^/]+$' '' $p)\0A    else\0A        set manpath ''\0A    end\0A    # Notice the shadowing local exported copy of the variable.\0A    set -lx MANPATH $manpath\0A\0A    # Prepend fish's man directory if available.\0A    if set -q __fish_data_dir[1]\0A        set -l fish_manpath $__fish_data_dir/man\0A        if test -d $fish_manpath\0A            set MANPATH $fish_manpath $MANPATH\0A        end\0A    end\0A\0A    if test (count $argv) -eq 1\0A        # Some of these don't have their own page,\0A        # and adding one would be awkward given that the filename\0A        # isn't guaranteed to be allowed.\0A        # So we override them with the good name.\0A        switch $argv\0A            case :\0A                set argv true\0A            case '['\0A                set argv test\0A            case .\0A                set argv source\0A        end\0A    end\0A\0A    if not set -q argv[2] && status list-files \22man/man1/$argv[1].1\22 &>/dev/null\0A        __fish_print_help $argv\0A        return\0A    end\0A\0A    command man $argv\0Aend\0A", align 1
