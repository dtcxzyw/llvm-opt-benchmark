@anon.1d0b41a8d45d477c3029ec78f9b8b434.3494 = private unnamed_addr constant [182 x i8] c"#\0A# These are very common and useful\0A#\0Afunction la --wraps ls --description \22List contents of directory, including hidden files in directory using long format\22\0A    ls -lAh $argv\0Aend\0A", align 1
