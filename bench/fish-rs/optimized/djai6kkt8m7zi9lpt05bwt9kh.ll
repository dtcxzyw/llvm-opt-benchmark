@anon.1d0b41a8d45d477c3029ec78f9b8b434.1594 = private unnamed_addr constant [2067 x i8] c"function __fish_exif_target_file_tags\0A    for target in (string match -v -- '-*' (commandline -px)[2..])\0A        string replace -f '*' '' (exif --list-tags \22$target\22 2> /dev/null)[2..] | string replace -r '(\\s+-){4}' '' | string split -m1 ' ' | string trim\0A    end\0Aend\0A\0Afunction __fish_exif_potential_targets\0A    set -l token (commandline -t)\0A    set -l matching_files (complete -C \22__fish_command_without_completions $token\22)\0A    for file in $matching_files\0A        if test -d \22$file\22\0A            echo $file\0A        else if exif \22$file\22 &>/dev/null\0A            echo $file\0A        else if not test -e \22$file\22\0A            # Handle filenames containing $.\0A            if exif $file &>/dev/null\0A                echo $file\0A            end\0A        end\0A    end\0Aend\0A\0Afunction __fish_exif_token_begins_with_arg\0A    not string match -- '-*' (commandline -t)\0Aend\0A\0Acomplete -c exif -f -a \22(__fish_exif_potential_targets)\22 -n __fish_exif_token_begins_with_arg\0A\0Afor line in (exif --help)\0A    set -l short\0A    set -l long\0A    set -l description\0A    if set -l matches (string match -r '^\\s+-([\\w?]),\\s--([\\w=-]+)\\s+(.*)$' \22$line\22)\0A        set short $matches[2]\0A        set long $matches[3]\0A        set description $matches[4]\0A    else if set -l matches (string match -r '^\\s+--([\\w=-]+)\\s+(.*)$' \22$line\22)\0A        set long $matches[2]\0A        set description $matches[3]\0A    else\0A        continue\0A    end\0A\0A    if set -l sub_parts (string split -n --max 1 '=' $long)\0A        set long \22$sub_parts[1]\22\0A        switch (string lower \22$sub_parts[2]\22)\0A            case tag\0A                complete -c exif -s$short -l $long -d \22$description\22 -x -a \22(__fish_exif_target_file_tags)\22\0A            case ifd\0A                complete -c exif -s$short -l $long -d \22$description\22 -x -a \220 1 EXIF GPS Interoperability\22\0A            case file\0A                complete -c exif -s$short -l $long -d \22$description\22 -F\0A            case \22*\22\0A                complete -c exif -s$short -l $long -d \22$description\22 -x\0A        end\0A    else\0A        complete -c exif -s$short -l $long -d \22$description\22\0A    end\0Aend\0A", align 1
