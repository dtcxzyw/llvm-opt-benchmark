@anon.1d0b41a8d45d477c3029ec78f9b8b434.2770 = private unnamed_addr constant [4611 x i8] c"function __fish_travis_needs_command\0A    set -l cmd (commandline -xpc)\0A    if test (count $cmd) -eq 1\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A# Commands\0Acomplete -c travis -f -n __fish_travis_needs_command -a accounts -d \22Displays accounts and their subscription status\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a branches -d \22Displays the most recent build for each branch\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a cache -d \22Lists or deletes repository caches\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a cancel -d \22Cancels a job or build\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a console -d \22Interactive shell\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a disable -d \22Disables a project\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a enable -d \22Enables a project\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a encrypt -d \22Encrypts values for the .travis.yml\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a encrypt-file -d \22Encrypts a file and adds decryption steps to .travis.yml\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a endpoint -d \22Displays or changes the API endpoint\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a env -d \22Show or modify build environment variables\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a help -d \22Helps you out when in dire need of information\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a history -d \22Displays a projects build history\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a init -d \22Generates a .travis.yml and enables the project\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a lint -d \22Display warnings for a .travis.yml\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a login -d \22Authenticates against the API and stores the token\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a logout -d \22Deletes the stored API token\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a logs -d \22Streams test logs\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a monitor -d \22Live monitor for what's going on\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a open -d \22Opens a build or job in the browser\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a pubkey -d \22Prints out a repository's public key\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a raw -d \22Makes an (authenticated) API call and prints out the result\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a report -d \22Generates a report useful for filing issues\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a repos -d \22Lists repositories the user has certain permissions on\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a requests -d \22Lists recent requests\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a restart -d \22Restarts a build or job\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a settings -d \22Access repository settings\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a setup -d \22Sets up an addon or deploy target\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a show -d \22Displays a build or job\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a sshkey -d \22Checks, updates or deletes an SSH key\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a status -d \22Checks status of the latest build\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a sync -d \22Triggers a new sync with GitHub\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a token -d \22Outputs the secret API token\22\0Acomplete -c travis -f -n __fish_travis_needs_command -a version -d \22Outputs the client version\22\0Acomplete -c travis -f -