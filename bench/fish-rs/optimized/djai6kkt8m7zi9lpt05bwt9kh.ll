@anon.1d0b41a8d45d477c3029ec78f9b8b434.2694 = private unnamed_addr constant [1836 x i8] c"if tail --version >/dev/null 2>/dev/null\0A    complete -c tail -s c -l bytes -x -d 'output the last K bytes; with +K output bytes starting with the Kth'\0A    complete -c tail -s f -l follow -a 'name descriptor' -d 'output appended data as the file grows'\0A    complete -c tail -s F -d 'same as --follow=name --retry'\0A    complete -c tail -s n -l lines -x -d 'output the last K lines; with +K output lines starting with the Kth'\0A    complete -c tail -l max-unchanged-stats -x -d 'with --follow=name, reopen a FILE which has not changed size after N iterations'\0A    complete -c tail -l pid -d 'with -f, terminate after process ID, PID dies' -xa '(__fish_complete_pids)'\0A    complete -c tail -s q -l quiet -l silent -d 'never output headers giving file names'\0A    complete -c tail -l retry -d 'keep trying to open a file even when it is inaccessible; useful with --follow=name'\0A    complete -c tail -s s -l sleep-interval -x -d 'with -f, sleep for approximately N seconds (default 1.0) between iterations'\0A    complete -c tail -s v -l verbose -d 'always output headers giving file names'\0A    complete -c tail -x -l help -d 'display this help and exit'\0A    complete -c tail -x -l version -d 'output version information and exit'\0Aelse # OSX and similar - no longopts (and fewer shortopts)\0A    complete -c tail -s b -x -d 'output last K 512 byte blocks'\0A    complete -c tail -s c -x -d 'output the last K bytes or only K bytes with -r'\0A    complete -c tail -s f -d 'output appended data as the file grows'\0A    complete -c tail -s F -d 'Like -f, but also follow renamed or rotated files'\0A    complete -c tail -s n -x -d 'output the last K lines, instead of the last 10 - or only K lines with -r'\0A    complete -c tail -s q -d 'never output headers giving file names'\0A    complete -c tail -s r -d 'Display input in reverse order' # Only in OSX\0Aend\0A", align 1
