@anon.1d0b41a8d45d477c3029ec78f9b8b434.2040 = private unnamed_addr constant [9456 x i8] c"complete -f -c machinectl\0A\0Aset -l commands list status show start login enable disable poweroff reboot \\\0A    terminate kill bind copy-{to,from} list-images image-status show-image clone rename read-only remove set-limit pull-{tar,raw,dkr} \\\0A    {import,export}-{raw,tar} {list,cancel}-transfers shell\0A\0Afunction __fish_systemd_has_machine_image\0A    set -l images (__fish_systemd_machine_images)\0A    for i in $images \22.host\22\0A        # Include \22.host\22 here because it _is_ a valid machine\0A        if contains -- $i (commandline -xpc)\0A            echo $i\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0Afunction __fish_systemd_has_machine\0A    set -l cmd\0A    if not count $argv >/dev/null\0A        set cmd (commandline -xpc)\0A    else\0A        set cmd $argv\0A    end\0A    set -l machines (__fish_systemd_machines)\0A    for m in $machines\0A        if contains -- $m $cmd\0A            echo $m\0A            return 0\0A        end\0A    end\0A    return 1\0Aend\0A\0A# General options\0Acomplete -x -c machinectl -s H -l host -d 'Execute the operation on a remote host' -a \22(__fish_print_hostnames)\22\0Acomplete -x -c machinectl -s M -l machine -d 'Execute operation on a VM or container' -a \22(__fish_systemd_machines)\22\0Acomplete -f -c machinectl -s h -l help -d 'Print a short help and exit'\0Acomplete -f -c machinectl -l version -d 'Print a short version and exit'\0Acomplete -f -c machinectl -l no-pager -d 'Do not pipe output into a pager'\0Acomplete -f -c machinectl -l no-legend -d 'Do not print header and footer'\0Acomplete -f -c machinectl -l no-ask-password -d \22Don't ask for password for privileged operations\22 # might only be valid for certain commands, manpage is vague\0A\0A# Machine commands\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a list -d \22List running machines\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a list-images -d \22List startable machine images\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from list-images\22 -s a -l all -d \22Also show machines starting with a '.'\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a status -d \22Show information about machine\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from status\22 -s l -l full -d \22Do not ellipsize process tree entries\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from status\22 -s n -l lines -d \22How many journal lines to show\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from status\22 -s o -l output -d \22Formatting of journal output\22 -a \\\0A    'short short-iso short-precise short-monotonic verbose export json json-pretty json-sse cat'\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a show -d \22Show properties of machines\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from show\22 -s p -l property -d \22Limit to certain properties\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from show\22 -s a -l all -d \22Show all properties, even if not set\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a start -d \22Start machine\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a login -d \22Login to a machine\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a enable -d \22Enable machine to start at boot\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a disable -d \22Disable machine from starting at boot\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a poweroff -d \22Poweroff machine\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a reboot -d \22Reboot machine\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a terminate -d \22Terminate machine (without shutting down)\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a kill -d \22Send signal to process in a machine\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from kill\22 -l kill-who -d \22Choose who to send the signal to\22 -a 'leader all'\0A__fish_make_completion_signals\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from kill\22 -s s -l signal -d \22Signal to send\22 -a \22$__kill_signals\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a bind -d \22Bind-mount a directory to a machine\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from bind\22 -l mkdir -d \22Create destination directory\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from bind\22 -l read-only -d \22Apply read-only mount\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a copy-to -d \22Copy file or directory to a machine\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a copy-from -d \22Copy file or directory from a machine\22\0A\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a shell -d \22Open a shell on a machine\22\0A\0A# Image commands\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a list-images -d \22Show a list of locally installed machines\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a image-status -d \22Show information about machine images (human-readable)\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a show-image -d \22Show properties of machine images (machine-readable)\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a clone -d \22Clone a machine image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a rename -d \22Rename a machine image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a read-only -d \22Mark or unmark machine image as read-only\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a remove -d \22Remove machine images\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a set-limit -d \22Set size limit for machine image\22\0A\0A# Image transfer commands\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a pull-tar -d \22Download a .tar container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a pull-raw -d \22Download a .raw container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a pull-dkr -d \22Download a .dkr container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a import-tar -d \22Import a .tar container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a import-raw -d \22Import a .raw container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a export-tar -d \22Export a .tar container image\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a export-raw -d \22Export a .raw container image\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from export-tar export-raw\22 -l format -d \22Specify compression format\22 -a 'uncompressed xz gzip bzip2'\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a list-transfers -d \22Show running downloads, imports and exports\22\0Acomplete -f -c machinectl -n \22not __fish_seen_subcommand_from $commands\22 -a cancel-transfers -d \22Abort running downloads, imports or exports\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from pull-{tar,raw}\22 -l verify -a 'no checksum signature' -d \22Verify image with specified method\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from pull-dkr\22 -l verify -a no -d \22Verify image (not available for dkr)\22\0Acomplete -x -c machinectl -n \22__fish_seen_subcommand_from pull-dkr\22 -l dkr-index-url -d \22Specify index server\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from pull-{tar,raw,dkr}\22 -l force -d \22Overwrite existing machine image\22\0A\0A# These take a list of _running_ machines\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from status show poweroff reboot terminate kill\22 -a \22(__fish_systemd_machines)\22\0A\0A# These take a list of _installed_ machines, i.e. \22machine images\22\0A# enable seems to do something with a running machine that's not listed as an image, it seems to be a bug\0A# disable is kinda hard, as it's essentially a wrapper around `systemctl disable systemd-nspawn@XXX`, but completing machine images is the least wrong for now\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from start clone rename image-status show-image remove enable disable\22 -a \22(__fish_systemd_machine_images)\22\0A\0A# These take one machine and then something else\0A# bind copy-to copy-from take paths so we're done (almost, copy-from takes a path _on the machine_),\0A# while login takes exactly one machine and nothing else, which fish currently doesn't do\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from login bind copy-to copy-from; and not __fish_systemd_has_machine\22 -a \22(__fish_systemd_machines)\22\0A\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from login bind copy-to copy-from shell; and not __fish_systemd_has_machine\22 -a \22(__fish_systemd_machines)\22\0A# This is imperfect as we print the _local_ users\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from shell; and not __fish_systemd_has_machine (commandline -xpc | cut -d\22@\22 -f2-)\22 -a \22(__fish_print_users)@(__fish_systemd_machines)\22\0A\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from read-only; and not __fish_systemd_has_machine_image\22 -a \22(__fish_systemd_machine_images)\22\0Acomplete -f -c machinectl -n \22__fish_seen_subcommand_from read-only; and __fish_systemd_has_machine_image\22 -a \22yes no\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2041 = private unnamed_addr constant [24 x i8] c"completions/magento.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2042 = private unnamed_addr constant [35741 x i8] c"function __fish_print_magento_url_protocols -d \22Shows all available URL protocols\22\0A    echo http://\0A    echo https://\0Aend\0A\0Afunction __fish_print_magento_mysql_engines\0A    echo MyISAM\\t\22MyISAM storage engine\22\0A    echo InnoDB\\t\22Supports transactions, row-level locking, and foreign keys\22\0A    echo BLACKHOLE\\t\22/dev/null storage engine (anything you write to it disappears)\22\0A    echo MEMORY\\t\22Hash based, stored in memory, useful for temporary tables\22\0A    echo CSV\\t\22CSV storage engine\22\0A    echo ARCHIVE\\t\22Archive storage engine\22\0Aend\0A\0A###\0A\0Afunction __fish_print_magento_modules -d \22Lists all Magento modules\22\0A    set -l config_path app/etc/config.php\0A    test -f $config_path; or return\0A\0A    set -l in_modules 0\0A    cat $config_path | while read -l line\0A        if test \22$in_modules\22 -eq 0\0A            if string match -rq '[\\'\22]modules[\\'\22]\\s*=>.*\\[' -- $line\0A                set in_modules 1\0A            end\0A        else\0A            if string match -rq '^\\s*]\\s*,\\s*$' -- $line\0A                break\0A            end\0A            string replace -rf '\\s*[\\'\22](.*?)[\\'\22]\\s*=>.*' '$1' -- $line\0A        end\0A    end\0Aend\0A\0Afunction __fish_print_magento_i18n_packing_modes -d \22Shows all available packing modes\22\0A    echo replace\\t\22replace language pack by new one\22\0A    echo merge\\t\22merge language packages\22\0Aend\0A\0Afunction __fish_print_magento_available_ides -d \22Shows all IDEs supported by magento\22\0A    echo phpstorm\\t\22JetBrains PhpStorm\22\0Aend\0A\0Afunction __fish_print_magento_available_tests -d \22Shows all available magento tests\22\0A    echo all\\t\22all tests\22\0A    echo unit\\t\22unit tests only\22\0A    echo integration\\t\22integration tests only\22\0A    echo integration-all\\t\22all integration tests\22\0A    echo static\\t\22static file tests only\22\0A    echo static-all\\t\22all static file tests\22\0A    echo integrity\\t\22integrity tests only\22\0A    echo legacy\\t\22legacy tests only\22\0A    echo default\\t\22all tests\22\0Aend\0A\0Afunction __fish_print_magento_theme_areas -d \22Shows all available magento theme areas\22\0A    echo frontend\\t\22Frontend\22\0A    echo adminhtml\\t\22Backend\22\0Aend\0A\0Afunction __fish_print_magento_languages -d \22Shows all existing magento languages\22\0A    echo af_ZA\\t\22Afrikaans (South Africa)\22\0A    echo sq_AL\\t\22Albanian (Albania)\22\0A    echo ar_DZ\\t\22Arabic (Algeria)\22\0A    echo ar_EG\\t\22Arabic (Egypt)\22\0A    echo ar_KW\\t\22Arabic (Kuwait)\22\0A    echo ar_MA\\t\22Arabic (Morocco)\22\0A    echo ar_SA\\t\22Arabic (Saudi Arabia)\22\0A    echo az_Latn_AZ\\t\22Azerbaijani (Azerbaijan)\22\0A    echo eu_ES\\t\22Basque (Spain)\22\0A    echo be_BY\\t\22Belarusian (Belarus)\22\0A    echo bn_BD\\t\22Bengali (Bangladesh)\22\0A    echo bs_Latn_BA\\t\22Bosnian (Bosnia and Herzegovina)\22\0A    echo bg_BG\\t\22Bulgarian (Bulgaria)\22\0A    echo ca_ES\\t\22Catalan (Spain)\22\0A    echo zh_Hans_CN\\t\22Chinese (China)\22\0A    echo zh_Hant_HK\\t\22Chinese (Hong Kong SAR China)\22\0A    echo zh_Hant_TW\\t\22Chinese (Taiwan)\22\0A    echo hr_HR\\t\22Croatian (Croatia)\22\0A    echo cs_CZ\\t\22Czech (Czech Republic)\22\0A    echo da_DK\\t\22Danish (Denmark)\22\0A    echo nl_BE\\t\22Dutch (Belgium)\22\0A    echo nl_NL\\t\22Dutch (Netherlands)\22\0A    echo en_AU\\t\22English (Australia)\22\0A    echo en_CA\\t\22English (Canada)\22\0A    echo en_IE\\t\22English (Ireland)\22\0A    echo en_NZ\\t\22English (New Zealand)\22\0A    echo en_GB\\t\22English (United Kingdom)\22\0A    echo en_US\\t\22English (United States)\22\0A    echo et_EE\\t\22Estonian (Estonia)\22\0A    echo fil_PH\\t\22Filipino (Philippines)\22\0A    echo fi_FI\\t\22Finnish (Finland)\22\0A    echo fr_BE\\t\22French (Belgium)\22\0A    echo fr_CA\\t\22French (Canada)\22\0A    echo fr_FR\\t\22French (France)\22\0A    echo gl_ES\\t\22Galician (Spain)\22\0A    echo ka_GE\\t\22Georgian (Georgia)\22\0A    echo de_AT\\t\22German (Austria)\22\0A    echo de_DE\\t\22German (Germany)\22\0A    echo de_CH\\t\22German (Switzerland)\22\0A    echo el_GR\\t\22Greek (Greece)\22\0A    echo gu_IN\\t\22Gujarati (India)\22\0A    echo he_IL\\t\22Hebrew (Israel)\22\0A    echo hi_IN\\t\22Hindi (India)\22\0A    echo hu_HU\\t\22Hungarian (Hungary)\22\0A    echo is_IS\\t\22Icelandic (Iceland)\22\0A    echo id_ID\\t\22Indonesian (Indonesia)\22\0A    echo it_IT\\t\22Italian (Italy)\22\0A    echo it_CH\\t\22Italian (Switzerland)\22\0A    echo ja_JP\\t\22Japanese (Japan)\22\0A    echo km_KH\\t\22Khmer (Cambodia)\22\0A    echo ko_KR\\t\22Korean (South Korea)\22\0A    echo lo_LA\\t\22Lao (Laos)\22\0A    echo lv_LV\\t\22Latvian (Latvia)\22\0A    echo lt_LT\\t\22Lithuanian (Lithuania)\22\0A    echo mk_MK\\t\22Macedonian (Macedonia)\22\0A    echo ms_Latn_MY\\t\22Malay (Malaysia)\22\0A    echo mn_Cyrl_MN\\t\22Mongolian (Mongolia)\22\0A    echo nb_NO\\t\22Norwegian Bokm\C3\A5l (Norway)\22\0A    echo nn_NO\\t\22Norwegian Nynorsk (Norway)\22\0A    echo fa_IR\\t\22Persian (Iran)\22\0A    echo pl_PL\\t\22Polish (Poland)\22\0A    echo pt_BR\\t\22Portuguese (Brazil)\22\0A    echo pt_PT\\t\22Portuguese (Portugal)\22\0A    echo ro_RO\\t\22Romanian (Romania)\22\0A    echo ru_RU\\t\22Russian (Russia)\22\0A    echo sr_Cyrl_RS\\t\22Serbian (Serbia)\22\0A    echo sk_SK\\t\22Slovak (Slovakia)\22\0A    echo sl_SI\\t\22Slovenian (Slovenia)\22\0A    echo es_AR\\t\22Spanish (Argentina)\22\0A    echo es_CL\\t\22Spanish (Chile)\22\0A    echo es_CO\\t\22Spanish (Colombia)\22\0A    echo es_CR\\t\22Spanish (Costa Rica)\22\0A    echo es_MX\\t\22Spanish (Mexico)\22\0A    echo es_PA\\t\22Spanish (Panama)\22\0A    echo es_PE\\t\22Spanish (Peru)\22\0A    echo es_ES\\t\22Spanish (Spain)\22\0A    echo es_VE\\t\22Spanish (Venezuela)\22\0A    echo sw_KE\\t\22Swahili (Kenya)\22\0A    echo sv_SE\\t\22Swedish (Sweden)\22\0A    echo th_TH\\t\22Thai (Thailand)\22\0A    echo tr_TR\\t\22Turkish (Turkey)\22\0A    echo uk_UA\\t\22Ukrainian (Ukraine)\22\0A    echo vi_VN\\t\22Vietnamese (Vietnam)\22\0A    echo cy_GB\\t\22Welsh (United Kingdom)\22\0Aend\0A\0Afunction __fish_print_magento_source_theme_file_types -d \22Shows all available source theme file types\22\0A    echo less\\t\22Currently only LESS is supported\22\0Aend\0A\0Afunction __fish_print_magento_deploy_modes -d \22Shows all available deploy modes\22\0A    echo developer\\t\22Development mode\22\0A    echo production\\t\22Production mode\22\0Aend\0A\0Afunction __fish_print_magento_cache_types -d \22Shows all available cache types\22\0A    echo config\\t\22Configuration\22\0A    echo layout\\t\22Layout\22\0A    echo block_html\\t\22Block HTML output\22\0A    echo collections\\t\22Collections data\22\0A    echo db_ddl\\t\22Database schema\22\0A    echo eav\\t\22Entity attribute value (EAV)\22\0A    echo full_page\\t\22Page cache\22\0A    echo reflection\\t\22Reflection\22\0A    echo translate\\t\22Translations\22\0A    echo config_integration\\t\22Integration configuration\22\0A    echo config_integration_api\\t\22Integration API configuration\22\0A    echo config_webservice\\t\22Web services configuration\22\0Aend\0A\0Afunction __fish_print_magento_verbosity_levels -d \22Shows all available verbosity levels\22\0A    echo 1\\t\22normal output\22\0A    echo 2\\t\22more verbose output\22\0A    echo 3\\t\22debug\22\0Aend\0A\0Afunction __fish_print_magento_list_formats -d \22Shows all available output formats\22\0A    echo txt\\t\22Print as plain text\22\0A    echo json\\t\22Print as JSON\22\0A    echo xml\\t\22Print as XML\22\0Aend\0A\0Afunction __fish_print_magento_commands_list -d \22Lists magento commands\22\0A    set -l commands help list admin:user:create admin:user:unlock \\\0A        app:config:dump cache:clean cache:disable cache:enable cache:flush \\\0A        cache:status catalog:images:resize catalog:product:attributes:cleanup \\\0A        cron:run customer:hash:upgrade deploy:mode:set deploy:mode:show \\\0A        dev:source-theme:deploy dev:tests:run dev:urn-catalog:generate \\\0A        dev:xml:convert i18n:collect-phrases i18n:pack i18n:uninstall \\\0A        indexer:info indexer:reindex indexer:reset indexer:set-mode \\\0A        indexer:show-mode indexer:status info:adminuri info:backups:list \\\0A        info:currency:list info:dependencies:show-framework \\\0A        info:dependencies:show-modules info:dependencies:show-modules-circular \\\0A        info:language:list info:timezone:list maintenance:allow-ips \\\0A        maintenance:disable maintenance:enable maintenance:status module:disable \\\0A        module:enable module:status module:uninstall sampledata:deploy \\\0A        sampledata:remove sampledata:reset setup:backup setup:config:set \\\0A        setup:cron:run setup:db-data:upgrade setup:db-schema:upgrade \\\0A        setup:db:status setup:di:compile setup:install \\\0A        setup:performance:generate-fixtures setup:rollback \\\0A        setup:static-content:deploy setup:store-config:set \\\0A        setup:uninstall setup:upgrade theme:uninstall\0A    for i in $commands\0A        echo $i\0A    end\0Aend\0A\0A#########################################################\0A\0Afunction __fish_magento_not_in_command -d \22Checks that prompt is not inside of magento command\22\0A    set -l cmd (commandline -xpc)\0A    for i in $cmd\0A        if contains -- $i (__fish_print_magento_commands_list)\0A            return 1\0A        end\0A    end\0A    return 0\0Aend\0A\0A#########################################################\0A\0A# Perforce command is a single word that comes either as first argument\0A# or directly after global options.\0A# To test whether we're in command, it's enough that a command will appear\0A# in the arguments, even though if more than a single command is specified,\0A# p4 will complain.\0Afunction __fish_magento_is_using_command -d \22Checks if prompt is in a specific command\22\0A    if contains -- $argv[1] (commandline -xpc)\0A        return 0\0A    end\0A    return 1\0Aend\0A\0A#########################################################\0A\0Afunction __fish_magento_register_command -d \22Adds a completion for a specific command\22\0A    complete -c magento -n __fish_magento_not_in_command -a $argv[1] $argv[2..-1]\0Aend\0A\0A#########################################################\0A\0Afunction __fish_magento_register_command_option -d \22Adds a specific option for a command\22\0A    complete -c magento -n \22__fish_magento_is_using_command $argv[1]\22 $argv[2..-1]\0Aend\0A\0A#########################################################\0A\0Afunction __fish_magento_parameter_missing -d \22Checks if a parameter has been given already\22\0A    if __fish_contains_opt $argv\0A        return 1\0A    end\0A\0A    return 0\0Aend\0A\0A##################\0A# Global options #\0A##################\0Acomplete -x -c magento -s h -l help -d \22Show help for a command\22\0Acomplete -x -c magento -s q -l quiet -d \22Do not output any message\22\0Acomplete -x -c magento -s v -l verbose -a \22(__fish_print_magento_verbosity_levels)\22 -d \22Increase verbosity: 1 for normal, 2 for verbose and 3 for debug\22\0Acomplete -x -c magento -o -vv\0Acomplete -x -c magento -o vvv\0Acomplete -x -c magento -s V -l version -d \22Show version\22\0Acomplete -x -c magento -l ansi -d \22Force colored output\22\0Acomplete -x -c magento -l no-ansi -d \22Disable colored output\22\0Acomplete -x -c magento -s n -l no-interaction -d \22Don't ask any interactive question\22\0A\0A################\0A# Sub-Commands #\0A################\0A__fish_magento_register_command help -a \22(__fish_print_magento_commands_list)\22 -d \22Show help for a command\22\0A__fish_magento_register_command list -d \22List commands\22\0A\0A__fish_magento_register_command admin:user:create -x -d \22Create admin account\22\0A__fish_magento_register_command admin:user:unlock -x -d 