links all\22\0A    complete -c cp -l parents -d \22Use full source file name under DIRECTORY\22\0A    complete -c cp -s r -s R -l recursive -d \22Copy directories recursively\22\0A    complete -c cp -l reflink -d \22Control clone/CoW copies\22 -a \22always auto never\22\0A    complete -c cp -l remove-destination -d \22First remove existing destination files\22\0A    complete -c cp -f -l sparse -r -d \22Control creation of sparse files\22 -xa \22always auto never\22\0A    complete -c cp -s s -l symbolic-link -d \22Make symbolic links instead of copying\22\0A    complete -c cp -s T -l no-target-directory -d \22Treat DEST as a normal file\22\0A    complete -c cp -s x -l one-file-system -d \22Stay on this file system\22\0A    complete -c cp -s Z -d \22Set SELinux context of copy to default type\22\0A    complete -c cp -s X -l context -r -d \22Set SELinux context of copy to CONTEXT\22\0Aelse # BSD/macOS\0A    set -l uname (uname -s)\0A    # Solaris:   cp [-R | r [H | L | P ]] [-fi ] [-p        ]\0A    # openbsd:   cp\09[-R |   [H | L | P ]] [-fi ] [-pv       ]\0A    # macos:     cp [-R |   [H | L | P ]] [-fin] [-pvalxscX ] # -c: clone -X: copy xattrs\0A    # netbsd:    cp [-R |   [H | L | P ]] [-fi ] [-pval    N] # -l: hard link instead of copy -N: don't copy file flags\0A    # dragonfly: cp [-R |   [H | L | P ]] [-fin] [-pvalx    ] # -x: don't traverse mount points\0A    # freebsd:   cp\09[-R |   [H | L | P ]] [-fin] [-pvalxs   ] # -s: symlink instead of copy\0A    if test \22$uname\22 = SunOS # annoying\0A        complete -c cp -s r -d \22Copy directories recursively\22\0A        complete -c cp -s R -d \22Like -r, but replicating pipes instead of reading pipes\22\0A    else\0A        complete -c cp -s R -d \22Copy directories recursively\22\0A    end\0A    complete -c cp -s H -d \22-R: Follow symlink arguments\22\0A    complete -c cp -s L -d \22-R: Follow all symlinks\22\0A    complete -c cp -s P -d \22-R: Don't follow symlinks (default)\22\0A\0A    complete -c cp -s f