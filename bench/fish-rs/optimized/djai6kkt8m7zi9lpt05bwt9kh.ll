@anon.1d0b41a8d45d477c3029ec78f9b8b434.2312 = private unnamed_addr constant [1356 x i8] c"complete -c pfctl -s s -d 'Show a filter parameter by modifier' -xa \\\0A    'queue\\t\22Show loaded queue definitions\22 \\\0A\09rules\\t\22Show loaded filter rules\22 \\\0A\09Anchors\\t\22Show anchors attached to main ruleset\22 \\\0A\09states\\t\22Show state table\22\0A\09Sources\\t\22Show source tracking table\22 \\\0A\09info\\t\22Show filter information\22 \\\0A\09labels\\t\22Show stats of labeled filter rules\22 \\\0A\09timeouts\\t\22Show global timeouts\22 \\\0A\09memory\\t\22Show pool memory hard limits\22 \\\0A\09Tables\\t\22Show the list of tables\22 \\\0A\09osfp\\t\22Show a list of OS fingerprints\22 \\\0A\09Interfaces\\t\22List PF interfaces/drivers\22 \\\0A\09all\\t\22Everything.\22'\0Acomplete -c pfctl -s F -d 'Flush filter params specified by mod' -xa \\\0A    'rules\\t\22Flush filter rules\22 \\\0A\09states\\t\22Flush state table\22 \\\0A\09Sources\\t\22Flush source tracking table\22 \\\0A\09info\\t\22Flush filter information\22 \\\0A\09Tables\\t\22Flush the tables\22 \\\0A\09ospf\\t\22Flush the passive OS fingerprints\22 \\\0A\09all\\t\22Flush everything\22'\0Acomplete -c pfctl -s T -d 'Table command' -xa \\\0A    'kill\\t\22Kill a table.\22 \\\0A\09flush\\t\22Flush addresses of a table\22 \\\0A\09add\\t\22Add one or more addresses in table\22 \\\0A\09delete\\t\22Delete one or more addresses from a table\22 \\\0A\09expire\\t\22Delete addresses where stats cleared > N seconds\22 \\\0A\09replace\\t\22Replace the addresses of the table\22 \\\0A\09show\\t\22Show the contents of a table\22 \\\0A\09test\\t\22Test if the given addresses match a table\22 \\\0A\09zero\\t\22Clear all the stats of a table\22'\0A", align 1
