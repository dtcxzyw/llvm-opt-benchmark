@anon.1d0b41a8d45d477c3029ec78f9b8b434.2478 = private unnamed_addr constant [2353 x i8] c"complete -c reflector -f\0A# options\0Acomplete -c reflector -s h -l help -d 'Show help'\0Acomplete -c reflector -l connection-timeout -d 'The number of seconds to wait before a connection times out'\0Acomplete -c reflector -l download-timeout -d 'The number of seconds to wait before a download times out'\0Acomplete -c reflector -l list-countries -d 'Display a table of the distribution of servers by country'\0Acomplete -c reflector -l cache-timeout -d 'The cache timeout in seconds for the data retrieved from the Arch Linux Mirror Status API'\0Acomplete -c reflector -l url -d 'The URL from which to retrieve the mirror data in JSON format'\0Acomplete -c reflector -l save -d 'Save the mirrorlist to the given path'\0Acomplete -c reflector -l sort -d 'Sort the mirrorlist' -xa 'age rate country score delay'\0Acomplete -c reflector -l threads -d 'The number of threads to use for downloading'\0Acomplete -c reflector -l verbose -d 'Print extra information'\0Acomplete -c reflector -l info -d 'Print mirror information instead of a mirror list'\0A\0A# filters\0Acomplete -c reflector -s a -l age -d 'Only return mirrors that have synchronized in the last n hours'\0Acomplete -c reflector -l delay -d 'Only return mirrors with a reported sync delay of n hours or less, where n is a float'\0Acomplete -c reflector -s c -l country -d 'Restrict mirrors to selected countries' -xa \22(reflector --list-countries | cut -f 1 -d ' ' | tail -n +3)\22\0Acomplete -c reflector -s f -l fastest -d 'Return the n fastest mirrors that meet the other criteria'\0Acomplete -c reflector -s i -l include -d 'Include servers that match <regex>'\0Acomplete -c reflector -s x -l exclude -d 'Exclude servers that match <regex>'\0Acomplete -c reflector -s l -l latest -d 'Limit the list to the n most recently synchronized servers'\0Acomplete -c reflector -l score -d 'Limit the list to the n servers with the highest score'\0Acomplete -c reflector -s n -l number -d 'Return at most n mirrors'\0Acomplete -c reflector -s p -l protocol -d 'Match one of the given protocols' -xa 'http https ftp rsync'\0Acomplete -c reflector -l completion-percent -d 'Set the minimum completion percent for the returned mirrors'\0Acomplete -c reflector -l isos -d 'Only return mirrors that host ISOs'\0Acomplete -c reflector -l ipv4 -d 'Only return mirrors that support IPv4'\0Acomplete -c reflector -l ipv6 -d 'Only return mirrors that support IPv6'\0A", align 1
