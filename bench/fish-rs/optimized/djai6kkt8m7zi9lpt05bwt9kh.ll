@anon.1d0b41a8d45d477c3029ec78f9b8b434.2690 = private unnamed_addr constant [2841 x i8] c"function __fish_cryptenroll_pkcs11_devices\0A    systemd-cryptenroll --pkcs11-token-uri=list 2>/dev/null | tail -n +2 | string replace -r '(\\S+)\\s(\\S+).*' '$1\\t$2'\0A    echo -e \22auto\\tautomatically determine URI of security token\22\0A    echo -e \22list\\tlist available PKCS#11 tokens\22\0Aend\0A\0Afunction __fish_cryptenroll_fido2_devices\0A    systemd-cryptenroll --fido2-device=list 2>/dev/null | tail -n +2 | string replace -ar ' +' ' ' | string replace -r '(\\S+)\\s(.*)' '$1\\t$2'\0A    echo -e \22auto\\tautomatically determine device node of security token\22\0A    echo -e \22list\\tlist available FIDO2 tokens\22\0Aend\0A\0Afunction __fish_cryptenroll_tpm2_devices\0A    systemd-cryptenroll --tpm2-device=list 2>/dev/null | tail -n +2 | string replace -r '(\\S+)\\s(\\S+).*' '$1\\t$2'\0A    echo -e \22auto\\tautomatically determine device node of TPM2 device\22\0A    echo -e \22list\\tlist available TPM2 devices\22\0Aend\0A\0Afunction __fish_cryptenroll_complete_wipe\0A    echo -e \22all\\twipe all key slots\22\0A    echo -e \22empty\\twipe key slots unlocked by an empty passphrase\22\0A    echo -e \22password\\twipe key slots unlocked by a traditional passphrase\22\0A    echo -e \22recovery\\twipe key slots unlocked by a recovery key\22\0A    echo -e \22pkcs11\\twipe key slots unlocked by a PKCS#11 token\22\0A    echo -e \22fido2\\twipe key slots unlocked by a FIDO2 token\22\0A    echo -e \22tpm2\\twipe key slots unlocked by a TPM2 chip\22\0A    for i in (seq 0 31)\0A        echo -e \22$i\\twipe key slot $i\22\0A    end\0Aend\0A\0Acomplete -c systemd-cryptenroll -xa \22(__fish_complete_blockdevice)\22\0A\0Acomplete -c systemd-cryptenroll -l password -d \22Enroll a regular password\22\0Acomplete -c systemd-cryptenroll -l recovery-key -d \22Enroll an auto-generated recovery key\22\0Acomplete -c systemd-cryptenroll -l pkcs11-token-uri -kxa \22(__fish_cryptenroll_pkcs11_devices)\22 -d \22Enroll a PKCS#11 security token or smartcard\22\0Acomplete -c systemd-cryptenroll -l fido2-device -kxa \22(__fish_cryptenroll_fido2_devices)\22 -d \22Enroll a FIDO2 security token\22\0Acomplete -c systemd-cryptenroll -l fido2-with-client-pin -xa \22yes no\22 -d \22Require to enter a PIN when unlocking the volume\22\0Acomplete -c systemd-cryptenroll -l fido2-with-user-presence -xa \22yes no\22 -d \22Require to verify presence when unlocking the volume\22\0Acomplete -c systemd-cryptenroll -l fido2-with-user-verification -xa \22yes no\22 -d \22Require user verification when unlocking the volume\22\0Acomplete -c systemd-cryptenroll -l tpm2-device -kxa \22(__fish_cryptenroll_tpm2_devices)\22 -d \22Enroll a TPM2 security chip\22\0Acomplete -c systemd-cryptenroll -l tpm2-pcrs -x -d \22Bind the enrollment of TPM2 device to specified PCRs\22\0Acomplete -c systemd-cryptenroll -l wipe-slot -kxa \22(__fish_complete_list , __fish_cryptenroll_complete_wipe)\22 -d \22Wipes one or more LUKS2 key slots\22\0Acomplete -c systemd-cryptenroll -l help -s h -d \22Print a short help\22\0Acomplete -c systemd-cryptenroll -l version -d \22Print a short version string\22\0A", align 1
