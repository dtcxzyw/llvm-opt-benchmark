@anon.1d0b41a8d45d477c3029ec78f9b8b434.2744 = private unnamed_addr constant [1349 x i8] c"#completion for totem\0A\0Acomplete -c totem -l usage -d 'Output a brief synopsis of command options then quit'\0Acomplete -c totem -s '?' -l help -d 'Output  a longer help message then quit'\0Acomplete -c totem -l version -d 'Output version information then quit'\0Acomplete -c totem -l play-pause -d 'Tell any running totem instance: Toggle between play and pause'\0Acomplete -c totem -l play -d 'Tell any running totem instance: Play'\0Acomplete -c totem -l pause -d 'Tell any running totem instance: Pause'\0Acomplete -c totem -l next -d 'Tell any running totem instance: Skip to next'\0Acomplete -c totem -l previous -d 'Tell any running totem instance: Skip to previous'\0Acomplete -c totem -l seek-fwd -d 'Tell any running totem instance: Seek forwards 15 sec'\0Acomplete -c totem -l seek-bwd -d 'Tell any running totem instance: Seek backwards 15 sec'\0Acomplete -c totem -l volume-up -d 'Tell any running totem instance: Raise volume by 8%'\0Acomplete -c totem -l volume-down -d 'Tell any running totem instance: Lower volume by 8%'\0Acomplete -c totem -l fullscreen -d 'Tell any running totem instance: Toggle fullscreen'\0Acomplete -c totem -l quit -d 'Tell any running totem instance: Quit'\0A\0Acomplete -r -c totem -l enqueue -d 'Tell any running totem instance: Add to playlist'\0Acomplete -r -c totem -l replace -d 'Tell any running totem instance: Play from playlist'\0A", align 1
