@anon.1d0b41a8d45d477c3029ec78f9b8b434.2252 = private unnamed_addr constant [820 x i8] c"if string match -q \22OpenSSL*\22 (command openssl version)\0A    # This is real OpenSSL that has the list command.\0A    function __fish_openssl_subcommand_options --description \22Print options for openssl subcommand\22\0A        set -l cmd (commandline -pxc)\0A        openssl list -options $cmd[2] | string replace -r -- '^(\\S*)\\s*.*' '-$1'\0A    end\0A\0A    complete -c openssl -n __fish_use_subcommand -x -a \22(openssl list -1 -commands -cipher-commands -digest-commands)\22\0A    complete -c openssl -n 'not __fish_use_subcommand && string match -qr -- \22^-\22 (commandline -ct)' -a \22(__fish_openssl_subcommand_options)\22\0Aelse\0A    # Perhaps LibreSSL - see #7966\0A    # TODO: support subcommand options.\0A    complete -c openssl -n __fish_use_subcommand -x -a \22(openssl help 2>&1 | string match -rv '^[A-Z]|^\\$|Error' | string split -n ' ')\22\0Aend\0A", align 1
