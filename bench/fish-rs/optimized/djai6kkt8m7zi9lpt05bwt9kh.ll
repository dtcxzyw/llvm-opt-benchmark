@anon.1d0b41a8d45d477c3029ec78f9b8b434.1546 = private unnamed_addr constant [1639 x i8] c"# Completions for the eix tool's eix-sync command\0A# http://dev.croup.de/proj/eix and http://sourceforge.net/projects/eix/\0A\0A# Author: Tassilo Horn <tassilo@member.fsf.org>\0A\0A##########\0A# EIX-SYNC\0Acomplete -c eix-sync -s i -d \22Ignore all previous options\22\0Acomplete -c eix-sync -s d -d \22Only show differences to the previously saved database and exit\22\0Acomplete -c eix-sync -s s -xa '(__fish_print_users)@(__fish_print_hostnames):' -d \22Sync via rsync from the given SERVER\22\0Acomplete -c eix-sync -s c -xa '(__fish_print_users)@(__fish_print_hostnames):' -d \22Sync via rsync *to* the given CLIENT\22\0Acomplete -c eix-sync -s U -d \22Do not touch the database and omit the hooks after update-eix. (Implies -R)\22\0Acomplete -c eix-sync -s u -d \22Update database only and show differences\22\0Acomplete -c eix-sync -s g -d \22Do not call gensync (and the !commands in /etc/eix-sync.conf)\22\0Acomplete -c eix-sync -s @ -d \22Do not execute the hooks of /etc/eix-sync.conf\22\0Acomplete -c eix-sync -s S -d \22Do not execute the hooks after emerge --sync (@@ entries)\22\0Acomplete -c eix-sync -s m -d \22Run emerge --metadata instead of emerge --sync\22\0Acomplete -c eix-sync -s t -d \22Use temporary file to save the current database\22\0Acomplete -c eix-sync -s v -d \22Don't suppress output of update-eix and emerge\22\0Acomplete -c eix-sync -s q -d \22Be quiet (close stdout)\22\0Acomplete -c eix-sync -s w -d \22Run emerge-webrsync instead of emerge --sync\22\0Acomplete -c eix-sync -s r -d \22Really recreate the dep-cache (rm -rf /var/cache/edb/dep/*) (default)\22\0Acomplete -c eix-sync -s R -d \22Do not really recreate the dep-cache\22\0Acomplete -c eix-sync -s h -d \22Show a short help text and exit\22\0A##########\0A", align 1
