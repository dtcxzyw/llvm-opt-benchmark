@anon.1d0b41a8d45d477c3029ec78f9b8b434.2094 = private unnamed_addr constant [3799 x i8] c"# completion for mkdocs\0A\0Acomplete -f -c mkdocs -s h -l help -d 'Show help and exit'\0Acomplete -f -c mkdocs -s v -l verbose -d 'Enable verbose output'\0Acomplete -f -c mkdocs -s q -l quiet -d 'Silence warnings'\0Acomplete -n 'not __fish_seen_subcommand_from build gh-deploy new serve' -f -c mkdocs -s V -l version -d 'Show the version and exit'\0A\0A## build\0Acomplete -n 'not __fish_seen_subcommand_from build gh-deploy new serve' -f -c mkdocs -a build -d 'Build the MkDocs documentation'\0Acomplete -n 'contains build (commandline -pxc)' -f -c mkdocs -s c -l clean -d 'Remove old site_dir before building (the default)'\0Acomplete -n 'contains build (commandline -pxc)' -c mkdocs -s f -l config-file -r -d 'Provide a specific MkDocs config'\0Acomplete -n 'contains build (commandline -pxc)' -f -c mkdocs -s s -l strict -d 'Enable strict mode. This will cause MkDocs to abort the build on any warnings'\0Acomplete -n 'contains build (commandline -pxc)' -c mkdocs -s t -l theme -d 'The theme to use when building your documentation' -xa 'mkdocs readthedocs material'\0Acomplete -n 'contains build (commandline -pxc)' -c mkdocs -s e -l theme-dir -r -d 'The theme directory to use when building your documentation'\0Acomplete -n 'contains build (commandline -pxc)' -c mkdocs -s d -l site-dir -r -d 'The directory to output the result of the documentation build'\0A\0A## gh-deploy\0Acomplete -n 'not __fish_seen_subcommand_from build gh-deploy new serve' -f -c mkdocs -a gh-deploy -d 'Deploy your documentation to GitHub Pages'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -f -c mkdocs -s c -l clean -d 'Remove old site_dir before building (the default)'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -c mkdocs -s f -l config-file -r -d 'Provide a specific MkDocs config'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -f -c mkdocs -s m -l message -r -d 'A commit message to use when committing to the GitHub Pages remote branch'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -f -c mkdocs -s b -l remote-branch -r -d 'The remote branch to commit to for GitHub Pages'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -f -c mkdocs -s r -l remote-name -r -d 'The remote name to commit to for GitHub Pages'\0Acomplete -n 'contains gh-deploy (commandline -pxc)' -f -c mkdocs -l force -d 'Force the push to the repository'\0A\0A## new\0Acomplete -n 'not __fish_seen_subcommand_from build gh-deploy new serve' -f -c mkdocs -a new -r -d 'Create a new MkDocs project'\0A\0A## serve\0Acomplete -n 'not __fish_seen_subcommand_from build gh-deploy new serve' -f -c mkdocs -a serve -d 'Run the builtin development server'\0Acomplete -n 'contains serve (commandline -pxc)' -c mkdocs -s f -l config-file -r -d 'Provide a specific MkDocs config'\0Acomplete -n 'contains serve (commandline -pxc)' -c mkdocs -s a -l dev-addr -r -d 'IP address and port to serve documentation locally (default: localhost:8000)'\0Acomplete -n 'contains serve (commandline -pxc)' -f -c mkdocs -s s -l strict -d 'Enable strict mode. This will cause MkDocs to abort the build on any warnings'\0Acomplete -n 'contains serve (commandline -pxc)' -c mkdocs -s t -l theme -d 'The theme to use when building your documentation' -xa 'mkdocs readthedocs material'\0Acomplete -n 'contains serve (commandline -pxc)' -c mkdocs -s e -l theme-dir -r -d 'The theme directory to use when building your documentation'\0Acomplete -n 'contains serve (commandline -pxc)' -f -c mkdocs -l livereload -d 'Enable the live reloading in the development server (this is the default)'\0Acomplete -n 'contains serve (commandline -pxc)' -f -c mkdocs -l no-livereload -d 'Disable the live reloading in the development server'\0Acomplete -n 'contains serve (commandline -pxc)' -f -c mkdocs -l dirtyreload -d 'Enable the live reloading in the development server, but only re-build files that have changed'\0A", align 1
