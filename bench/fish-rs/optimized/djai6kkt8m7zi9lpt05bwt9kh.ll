@anon.1d0b41a8d45d477c3029ec78f9b8b434.2588 = private unnamed_addr constant [747 x i8] c"complete -c set_color -x -d Color -a '(set_color --print-colors)'\0Acomplete -c set_color -s b -l background -x -a '(set_color --print-colors)' -d \22Change background color\22\0Acomplete -c set_color -s b -l underline-color -x -a '(set_color --print-colors)' -d \22Change underline color\22\0Acomplete -c set_color -s o -l bold -d 'Make font bold'\0Acomplete -c set_color -s i -l italics -d Italicise\0Acomplete -c set_color -s d -l dim -d 'Dim text'\0Acomplete -c set_color -s r -l reverse -d 'Reverse color text'\0Acomplete -c set_color -s u -l underline -d 'Underline style' -a 'single double curly dotted dashed'\0Acomplete -c set_color -s h -l help -d 'Display help and exit'\0Acomplete -c set_color -s c -l print-colors -d 'Print a list of all accepted color names'\0A", align 1
