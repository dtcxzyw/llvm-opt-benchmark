@anon.1d0b41a8d45d477c3029ec78f9b8b434.3164 = private unnamed_addr constant [3160 x i8] c"function __fish_complete_ssh -d \22common completions for ssh commands\22 --argument-names command\0A    complete -c $command -s 4 -d \22IPv4 only\22\0A    complete -c $command -s 6 -d \22IPv6 only\22\0A    complete -c $command -s A -d \22Enables forwarding of the authentication agent\22\0A    complete -c $command -s C -d \22Compress all data\22\0A    complete -c $command -s c -d \22Encryption algorithm\22 -xa \22(__fish_complete_list , __fish_ssh_ciphers)\22\0A    complete -c $command -s F -d \22Configuration file\22 -rF\0A    complete -c $command -s i -d \22Identity key file\22 -rF\0A    complete -c $command -s J -d 'ProxyJump host' -xa \22(__fish_complete_user_at_hosts)\22\0A    complete -c $command -s o -d Options -xa \22\0A        AddKeysToAgent\0A        AddressFamily\0A        BatchMode\0A        BindAddress\0A        BindInterface\0A        CanonicalDomains\0A        CanonicalizeFallbackLocal\0A        CanonicalizeHostname\0A        CanonicalizeMaxDots\0A        CanonicalizePermittedCNAMEs\0A        CASignatureAlgorithms\0A        CertificateFile\0A        ChallengeResponseAuthentication\0A        CheckHostIP\0A        Ciphers\0A        ClearAllForwardings\0A        Compression\0A        ConnectionAttempts\0A        ConnectTimeout\0A        ControlMaster\0A        ControlPath\0A        ControlPersist\0A        DynamicForward\0A        EscapeChar\0A        ExitOnForwardFailure\0A        FingerprintHash\0A        ForwardAgent\0A        ForwardX11\0A        ForwardX11Timeout\0A        ForwardX11Trusted\0A        GatewayPorts\0A        GlobalKnownHostsFile\0A        GSSAPIAuthentication\0A        GSSAPIClientIdentity\0A        GSSAPIDelegateCredentials\0A        GSSAPIKexAlgorithms\0A        GSSAPIKeyExchange\0A        GSSAPIRenewalForcesRekey\0A        GSSAPIServerIdentity\0A        GSSAPITrustDns\0A        HashKnownHosts\0A        Host\0A        HostbasedAuthentication\0A        HostbasedKeyTypes\0A        HostKeyAlgorithms\0A        HostKeyAlias\0A        Hostname\0A        IdentitiesOnly\0A        IdentityAgent\0A        IdentityFile\0A        IPQoS\0A        KbdInteractiveAuthentication\0A        KbdInteractiveDevices\0A        KexAlgorithms\0A        LocalCommand\0A        LocalForward\0A        LogLevel\0A        MACs\0A        Match\0A        NoHostAuthenticationForLocalhost\0A        NumberOfPasswordPrompts\0A        PasswordAuthentication\0A        PermitLocalCommand\0A        PKCS11Provider\0A        Port\0A        PreferredAuthentications\0A        ProxyCommand\0A        ProxyJump\0A        ProxyUseFdpass\0A        PubkeyAcceptedKeyTypes\0A        PubkeyAuthentication\0A        RekeyLimit\0A        RemoteCommand\0A        RemoteForward\0A        RequestTTY\0A        SendEnv\0A        ServerAliveCountMax\0A        ServerAliveInterval\0A        SetEnv\0A        StreamLocalBindMask\0A        StreamLocalBindUnlink\0A        StrictHostKeyChecking\0A        TCPKeepAlive\0A        Tunnel\0A        TunnelDevice\0A        UpdateHostKeys\0A        User\0A        UserKnownHostsFile\0A        VerifyHostKeyDNS\0A        VisualHostKey\0A        XAuthLocation\0A    \22\0A    complete -c $command -s q -d \22Quiet mode\22\0A    complete -c $command -s v -d \22Verbose mode\22\0Aend\0A\0Afunction __fish_ssh_ciphers -d \22List of possible SSH cipher algorithms\22\0A    ssh -Q cipher\0Aend\0A\0Afunction __fish_ssh_macs -d \22List of possible SSH MAC algorithms\22\0A    ssh -Q mac\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3165 = private unnamed_addr constant [41 x i8] c"functions/__fish_complete_subcommand.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3166 = private unnamed_addr constant [1441 x i8] c"function __fish_complete_subcommand -d \22Complete subcommand\22 --no-scope-shadowing\0A    # How many non-option tokens we skip in the input commandline before completing the subcommand\0A    # Usually 1; use \22--fcs-skip=2\22 to make it 2 (see e.g. tmux and ssh completions)\0A    set -l skip_next 1\0A    set -l subcommand\0A    while string match -rq -- '^--[a-z]' $argv[1]\0A        set -l arg $argv[1]\0A        set -e argv[1]\0A        switch $arg\0A            case '--fcs-skip=*'\0A                set skip_next (string split = -- $arg)[2]\0A            case --commandline # --commandline means to use our arguments instead of the commandline.\0A                complete -C \22$argv\22\0A                return\0A        end\0A    end\0A    set -l options_with_param $argv\0A\0A    set -l cmd (commandline -cxp | string escape) (commandline -ct)\0A    while set -q cmd[1]\0A        set -l token $cmd[1]\0A        set -e cmd[1]\0A        if contains -- $token $options_with_param\0A            set skip_next (math $skip_next + 1)\0A            continue\0A        end\0A        switch $token\0A            case '-*' '*=*'\0A                continue\0A            case '*'\0A                if test $skip_next -gt 0\0A                    set skip_next (math $skip_next - 1)\0A                    continue\0A                end\0A                # found the start of our command\0A                set subcommand $token $cmd\0A                break\0A        end\0A    end\0A\0A    printf \22%s\\n\22 (complete -C \22$subcommand\22)\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3167 = private unnamed_addr constant [37 x i8] c"functions/__fish_complete_suffix.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3168 = private unnamed_addr constant [3964 x i8] c"# Find files ending in any of the non-switch arguments and output them as completions.\0A# * --description provides the description that should be part of each generated completion,\0A# * --prefix=DIR makes __fish_complete_suffix behave as if it were called in DIR rather than $PWD\0A# * --complete=PREFIX only lists files that begin with PREFIX\0A#\0A# Files matching the above preconditions are printed first then other, non-matching files\0A# are printed for fallback purposes. As such, it is imperative that `complete` calls that\0A# shell out to `__fish_complete_suffix` are made with a `-k` switch to ensure sort order\0A# is preserved.\0Afunction __fish_complete_suffix -d \22Complete using files\22\0A    set -l _flag_prefix \22\22\0A    set -l _flag_complete (commandline -ct)\0A\0A    argparse 'prefix=' 'description=' 'complete=' -- $argv\0A\0A    set -l suff (string escape --style=regex -- $argv)\0A    set -l files\0A\0A    # Simple and common case: no prefix, just complete normally and sort matching files first.\0A    if test -z $_flag_prefix\0A        # Use normal file completions.\0A        set files (complete -C \22__fish_command_without_completions $_flag_complete\22)\0A        set -l files_with_suffix (string match -r -- (string join \22|\22 \22^.*\22$suff\\$) $files)\0A        set -l directories (string match -r -- '^.*/$' $files)\0A        set files $files_with_suffix $directories $files\0A    else\0A        # Only directories are supported as prefixes, and to use the same logic\0A        # for both absolute prefixed paths and relative non-prefixed paths, $_flag_prefix\0A        # must terminate in a `/` if it is present, so it can be unconditionally\0A        # prefixed to any path to get the desired result.\0A        if not string match -qr '/$' $_flag_prefix\0A            set _flag_prefix $_flag_prefix/\0A        end\0A\0A        # Strip leading ./ as it confuses the detection of base and suffix\0A        # It is conditionally re-added below.\0A        set -l base $_flag_prefix(string replace -r '^(\22\\')?\\\\./' '' -- $_flag_complete | string trim -c '\\'\22') # \22 make emacs syntax highlighting happy\0A\0A        set -l all\0A        set -l files_with_suffix\0A        set -l dirs\0A        # If $_flag_complete is \22./ma\22 and the file is \22main.py\22, we'll catch that case here,\0A        # but complete.cpp will not consider it a match, so we have to output the\0A        # correct form.\0A\0A        # Also do directory completion, since there might be files with the correct\0A        # suffix in a subdirectory.\0A        set all $base*\0A        set files_with_suffix (string match -r -- (string join \22|\22 \22.*\22$suff) $all)\0A        if not string match -qr '/$' -- $argv\0A            set dirs $base*/\0A\0A            # The problem is that we now have each directory included twice in the output,\0A            # once as `dir` and once as `dir/`. The runtime here is O(n) for n directories\0A            # in the output, but hopefully since we have only one level (no nested results)\0A            # it should be fast. The alternative is to shell out to `sort` and remove any\0A            # duplicate results, but it would have to be a huge `n` to make up for the fork\0A            # overhead.\0A            for dir in $dirs\0A                set all (string match -v (string match -r '(.*)/$' -- $dir)[2] -- $all)\0A            end\0A        end\0A\0A        set files $files_with_suffix $dirs $all\0A        if string match -qr '^\\\\./' -- $_flag_complete\0A            set files ./$files\0A        else\0A            # \22Escape\22 files starting with a literal dash `-` with a `./`\0A            set files (string replace -r -- \22^-\22 \22./-\22 $files)\0A        end\0A    end\0A\0A    if set -q files[1]\0A        if string match -qr -- . \22$_flag_description\22\0A            set _flag_description \22\\t$_flag_description\22\0A        end\0A        if string match -qr -- . \22$_flag_prefix\22\0A            set -l prefix (string escape --style=regex -- $_flag_prefix)\0A            set files (string replace -r -- \22^$prefix\22 \22\22 $files)\0A        end\0A        printf \22%s$_flag_description\\n\22 $files\0A    end\0A\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3169 = private unnamed_addr constant [44 x i8] c"functions/__fish_complete_user_at_hosts.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3170 = private unnamed_addr constant [208 x i8] c"function __fish_complete_user_at_hosts -d \22Print list host-names with user@\22\0A    for user_at in (commandline -ct | string match -r '.*@'; or echo \22\22)(__fish_print_hostnames)\0A        echo $user_at\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3171 = private unnamed_addr constant [39 x i8] c"functions/__fish_complete_user_ids.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3172 = private unnamed_addr constant [347 x i8] c"function __fish_complete_user_ids --description \22Complete user IDs with user name as description\22\0A    if command -sq getent\0A        getent passwd | string replace -f -r '^([[:alpha:]_][^:]*):[^:]*:(\\d+).*' '$2\\t$1'\0A    else if test -r /etc/passwd\0A        string replace -f -r '^([[:alpha:]_][^:]*):[^:]*:(\\d+).*' '$2\\t$1' </etc/passwd\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3173 = private unnamed_addr constant [36 x i8] c"functions/__fish_complete_users.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3174 = private unnamed_addr constant [1073 x i8] c"# This should be used where you want user names with a description. Such as in an argument\0A# completion. If you just want a list of user names use __fish_print_users.\0A# The string replace command takes into account GECOS-formatted description fields, by retaining\0A# only the first field, the relevant one, from the comma-separated list\0Afunction __fish_complete_users --description \22Print a list of local users, with the real user name as a description\22\0A    if command -sq getent\0A        command getent passwd | while read -l line\0A            string split -f 1,5 : -- $line | string join \\t | string replace -r ',.*' ''\0A        end\0A    else if command -sq dscl\0A        # This is the \22Directory Service command line utility\22 used on macOS in place of getent.\0A        command dscl . -list /Users RealName | string match -r -v '^_' | string replace -r ' {2,}' \\t\0A    else if test -r /etc/passwd\0A        string match -v -r '^\\s*#' </etc/passwd | while read -l line\0A            string split -f 1,5 : -- $line | string join \\t | string replace -r ',.*' ''\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3175 = private unnamed_addr constant [40 x i8] c"functions/__fish_complete_wireshark.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3176 = private unnamed_addr constant [7031 x i8] c"# Helper functions for wireshark/tshark/dumpcap completion\0A\0Afunction __fish_wireshark_choices\0A    string replace -rf -- '^\\s*(\\S+) \\(?([^)]*)\\)?$' '$1\\t$2' $argv\0Aend\0A\0Afunction __fish_wireshark_interface\0A    # no remote capture yet\0A    command tshark -D 2>/dev/null | string replace -r \22.*\\. (\\S+)\\s*\\(?([^)]*)\\)?\\$\22 '$1\\t$2'\0Aend\0A\0Afunction __fish_wireshark_protocol\0A    command tshark -G protocols 2>/dev/null | awk -F\\t '{print $3\22\\t\22$1}'\0Aend\0A\0Afunction __fish_wireshark_heuristic\0A    command tshark -G heuristic-decodes 2>/dev/null | awk -F\\t '{print $2\22\\t\22$1}'\0Aend\0A\0Afunction __fish_tshark_name_resolving_flags\0A    printf -- (commandline -ct | string replace -r -- '^-N' '')%s\\n \\\0A        d\\t\22enable resolution from captured DNS packets\22 \\\0A        m\\t\22enable MAC address resolution\22 \\\0A        n\\t\22enable network address resolution\22 \\\0A        N\\t\22enable using external resolvers (such as DNS) for network address resolution\22 \\\0A        t\\t\22enable transport-layer port number resolution\22 \\\0A        v\\t\22enable VLAN IDs to names resolution\22\0Aend\0A\0Afunction __fish_tshark_decode_as\0A    set -l tok (commandline -ct | string collect)\0A    if string match -rq -- '==$' $tok\0A        return\0A    else if string match -rq -- '(==|,)' $tok\0A        set -l tok_no_comma (string replace -r -- ',.*$' '' $tok)\0A        command tshark -d (string replace -r -- '^-d' '' $tok) 2>|\0A            string replace -rf -- \22^\\t(\\S+) \\(?([^\\)]*)\\)?\\$\22 \22$tok_no_comma,\\$1\\t\\$2\22\0A    else\0A        command tshark -d . 2>| string replace -rf -- \22^\\t(\\S+) \\(?([^\\)]*)\\)?\\$\22 '$1==\\t$2'\0A    end\0Aend\0A\0Afunction __fish_complete_wireshark\0A    set -l shark $argv\0A    complete -c $shark -s a -l autostop -d 'Specify a criterion to stop writing the capture file' -xa '\0Aduration:\\t\22Stop writing to capture files after N seconds have elapsed\22\0Afiles:\\t\22Stop writing to capture files after N files were written\22\0Afilesize:\\t\22Stop writing a capture file after it reaches a size of N kB\22\0Apackets:\\t\22Stop writing a capture file after it contains N packets\22'\0A    complete -c $shark -s b -l ring-buffer -d 'Write multiple capture files' -xa '\0Aduration:\\t\22Switch to the next file after N seconds have elapsed\22\0Afiles:\\t\22Begin again with the first file after N files were written\22\0Afilesize:\\t\22Switch to the next file after it reaches a size of N kB\22\0Ainterval:\\t\22Switch to the next file when the time is an exact multiple of N seconds\22\0Apackets:\\t\22Switch to the next file after it contains N packets\22'\0A    complete -c $shark -s B -l buffer-size -d 'Set capture buffer size (in MiB, default is 2 MiB)' -x\0A    complete -c $shark -s c -d 'Set the maximum number of packets to read' -x\0A    complete -c $shark -l capture-comment -d 'Add a capture comment to the output file' -x\0A    complete -c $shark -s D -l list-interfaces -d \22Print a list of interfaces on which $shark can capture and exit\22\0A    complete -c $shark -s f -d 'Set a capture filter expression' -x\0A    complete -c $shark -s i -ra '(__fish_wireshark_interface)'\0A    complete -c $shark -s i -ra '-\\t\22Capture from standard input\22' \\\0A        -d 'Network interface or pipe to use for live packet capture'\0A    complete -c $shark -s I -l monitor-mode -d 'Put the interface in \22monitor mode\22'\0A    complete -c $shark -s L -l list-data-link-types -d 'List the data link types supported by the interface and exit'\0A    complete -c $shark -l list-time-stamp-types -d 'List time stamp types supported for the interface'\0A    complete -c $shark -s p -l no-promiscuous-mode -d \22Don't put the interface into promiscuous mode\22\0A    complete -c $shark -s s -l snapshot-length -d 'Set the default snapshot length in bytes to use when capturing live data' -x\0A    complete -c $shark -l time-stamp-type -d \22Change the interface's timestamp method\22 -xa '(__fish_wireshark_choices (command tshark --list-time-stamp-types 2>/dev/null))'\0A    complete -c $shark -s v -l version -d 'Print the version and exit'\0A    complete -c $shark -s w -d 'Write raw packet data to the given file (\22-\22 means stdout)' -r\0A    complete -c $shark -s y -l linktype -d 'Set the data link type to use while capturing packets' -xa '(__fish_wireshark_choices (command tshark -L 2>/dev/null))'\0A\0A    switch $shark\0A        case dumpcap tshark\0A            complete -c tshark -s q -d \22Don't display the continuous count of packets captured\22\0A            complete -c tshark -s g -d 'Create output files with greoup-read permissions'\0A    end\0A\0A    switch $shark\0A        case wireshark tshark\0A            complete -c $shark -s C -d 'Run with the given configuration profile' -xa '(\0Aset -l folders (tshark -G folders 2>/dev/null | awk \\'/Personal configuration/{ print $NF}\\')/profiles/*\0Astring match -r \22[^/]*\\\\$\22 -- $folders)'\0A            complete -c $shark -s d -d 'Specify how a layer type should be dissected' -xa '(__fish_tshark_decode_as)'\0A            complete -c $shark -l enable-protocol -d 'Enable dissection of the given protocol' -xa '(__fish_wireshark_protocol)'\0A            complete -c $shark -l disable-protocol -d 'Disable dissection of the given protocol' -xa '(__fish_wireshark_protocol)'\0A            complete -c $shark -l enable-heuristic -d 'Enable dissection of heuristic protocol' -xa '(__fish_wireshark_heuristic)'\0A            complete -c $shark -l disable-heuristic -d 'Disable dissection of heuristic protocol' -xa '(__fish_wireshark_heuristic)'\0A            complete -c $shark -s K -d 'Load kerberos crypt keys from the specified keytab file' -r\0A            complete -c $shark -s n -d 'Disable network object name resolution (hostname, TCP and UDP port names)'\0A            complete -c $shark -s N -d 'Turn on name resolution only for particular types of addresses and port numbers' -xa '( __fish_tshark_name_resolving_flags)'\0A            complete -c $shark -s o -d 'Override a preference value' -xa '(\0A    command tshark -G defaultprefs 2>/dev/null | string replace -rf -- \\'^#([a-z].*):.*\\' \\'$1:\\')'\0A            complete -c $shark -s r -l read-file -d 'Read packet data from the given file' -r\0A            complete -c $shark -s R -l read-filter -d 'Apply the given read filter' -x\0A            complete -c $shark -s t -d 'Set the format of the packet timestamp printed in summary lines' -xa '\0Aa\\t\22absolute time\22\0Aad\\t\22absolute time with date\22\0Aadoy\\t\22absolute time with date using day of year\22\0Ad\\t\22delta: time since the previous packet was captured\22\0Add\\t\22delta displayed: time since the previous displayed packet was captured\22\0Ae\\t\22epoch: time in seconds since Jan 1, 1970\22\0Ar\\t\22relative time elapsed between the first packet and the current packet\22\0Au\\t\22absolute UTC time\22\0Aud\\t\22absolute UTC time with date\22\0Audoy\\t\22absolute UTC time with date using day of year\22'\0A            complete -c $shark -s u -d \22Specifies the seconds type\22 -xa 's\\t\22seconds\22 hms\\t\22hours, minutes and seconds\22'\0A            complete -c $shark -s X -d \22Specify an extension to be passed to a $shark module\22 -x # TODO\0A            complete -c $shark -s Y -l display-filter -d 'Apply the given display filter' -x\0A            complete -c $shark -s z -d 'Collect various types of statistics' -x # TODO\0A    end\0Aend\0A", align 1
