@anon.1d0b41a8d45d477c3029ec78f9b8b434.3228 = private unnamed_addr constant [312 x i8] c"function __fish_is_zfs_feature_enabled \\\0A    -a feature pool \\\0A    -d \22Returns 0 if the given ZFS pool feature is active or enabled for the given pool or for any pool if none specified\22\0A\0A    type -q zpool || return\0A    zpool get -H -o value $feature $pool 2>/dev/null | string match -rq '^(enabled|active)$'\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3229 = private unnamed_addr constant [40 x i8] c"functions/__fish_list_current_token.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3230 = private unnamed_addr constant [589 x i8] c"# This function is typically bound to Alt-L, it is used to list the contents\0A# of the directory under the cursor.\0A\0Afunction __fish_list_current_token -d \22List contents of token under the cursor if it is a directory, otherwise list the contents of the current directory\22\0A    set -l val \22$(commandline -t | string replace -r '^~' \22$HOME\22)\22\0A    set -l cmd\0A    if test -d $val\0A        set cmd ls $val\0A    else\0A        set -l dir (dirname -- $val)\0A        if test $dir != . -a -d $dir\0A            set cmd ls $dir\0A        else\0A            set cmd ls\0A        end\0A    end\0A    __fish_echo $cmd\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3231 = private unnamed_addr constant [36 x i8] c"functions/__fish_make_cache_dir.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3232 = private unnamed_addr constant [620 x i8] c"function __fish_make_cache_dir --description \22Create and return XDG_CACHE_HOME\22\0A    set -l xdg_cache_home $XDG_CACHE_HOME\0A    if test -z \22$xdg_cache_home\22; or string match -qv '/*' -- $xdg_cache_home; or set -q xdg_cache_home[2]\0A        set xdg_cache_home $HOME/.cache\0A    end\0A\0A    # If we get an argument, we try to create that as a subdirectory.\0A    # So if you call `__fish_make_cache_dir completions`,\0A    # this creates e.g. ~/.cache/fish/completions\0A    if not path is -d $xdg_cache_home/fish/\22$argv[1]\22\0A        mkdir -m 700 -p $xdg_cache_home/fish/\22$argv[1]\22\0A    end; and echo $xdg_cache_home/fish/\22$argv[1]\22\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3233 = private unnamed_addr constant [45 x i8] c"functions/__fish_make_completion_signals.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3234 = private unnamed_addr constant [2333 x i8] c"function __fish_make_completion_signals --description 'Make list of kill signals for completion'\0A    set -q __kill_signals\0A    and return 0\0A\0A    set -g __kill_signals\0A\0A    # Cygwin's kill is special, and the documentation lies.\0A    # Just hardcode the signals.\0A    set -l os (uname)\0A    if string match -q 'CYGWIN*' -- $os\0A        or string match -eiq Msys -- $os\0A        or string match -eiq mingw -- $os\0A        set -a __kill_signals \221 HUP\22 \222 INT\22 \223 QUIT\22 \224 ILL\22 \225 TRAP\22 \226 ABRT\22 \\\0A            \226 IOT\22 \227 BUS\22 \228 FPE\22 \229 KILL\22 \2210 USR1\22 \2211 SEGV\22 \\\0A            \2212 USR2\22 \2213 PIPE\22 \2214 ALRM\22 \2215 TERM\22 \2216 STKFLT\22 \2217 CHLD\22 \\\0A            \2217 CLD\22 \2218 CONT\22 \2219 STOP\22 \2220 TSTP\22 \2221 TTIN\22 \2222 TTOU\22 \\\0A            \2223 URG\22 \2224 XCPU\22 \2225 XFSZ\22 \2226 VTALRM\22 \2227 PROF\22 \2228 WINC\22 \\\0A            \2229 IO\22 \2229 POLL\22 \2230 PWR\22 \2231 SYS\22 \2234 RTMIN\22 \2264 RTMA\22\0A        return\0A    end\0A\0A    # If we don't have a kill, we don't try to run it.\0A    # We require a kill *command* because we used to unconditionally define\0A    # a wrapper (to allow %foo expansion)\0A    command -q kill\0A    or return\0A\0A    # Some systems use the GNU coreutils kill command where `kill -L` produces an extended table\0A    # format that looks like this:\0A    #\0A    #  1 HUP    Hangup: 1\0A    #  2 INT    Interrupt: 2\0A    #\0A    # The procps `kill -L` produces a more compact table. We can distinguish the two cases by\0A    # testing whether it supports `kill -t`; in which case it is the coreutils `kill` command.\0A    # Darwin doesn't have kill -t or kill -L\0A    if kill -t 2>/dev/null >/dev/null\0A        or not kill -L 2>/dev/null >/dev/null\0A        # Posix systems print out the name of a signal using 'kill -l SIGNUM'.\0A        complete -c kill -s l --description \22List names of available signals\22\0A        for i in (seq 31)\0A            set -a __kill_signals $i\22 \22(kill -l $i 2>/dev/null | string upper)\0A        end\0A    else\0A        # util-linux (on Arch) and procps-ng (on Debian) kill use 'kill -L' to write out a numbered list\0A        # of signals. Use this to complete on both number _and_ on signal name.\0A        complete -c kill -s L --description \22List codes and names of available signals\22\0A        kill -L 2>/dev/null | string trim | string replace -ra '   *' \\n | while read -l signo signame\0A            set -a __kill_signals \22$signo $signame\22\0A        end\0A    end\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3235 = private unnamed_addr constant [30 x i8] c"functions/__fish_man_page.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3236 = private unnamed_addr constant [1504 x i8] c"function __fish_man_page\0A    # Get all commandline tokens not starting with \22-\22, up to and including the cursor's\0A    set -l args (string match -rv '^-|^$' -- (commandline -cpx && commandline -t))\0A\0A    # If commandline is empty, exit.\0A    if not set -q args[1]\0A        printf \\a\0A        return\0A    end\0A\0A    # Skip leading commands and display the manpage of following command\0A    while set -q args[2]\0A        and string match -qr -- '^(and|begin|builtin|caffeinate|command|doas|entr|env|exec|if|mosh|nice|not|or|pipenv|prime-run|setsid|sudo|systemd-nspawn|time|watch|while|xargs|.*=.*)$' $args[1]\0A        set -e args[1]\0A    end\0A\0A    # If there are at least two tokens not starting with \22-\22, the second one might be a subcommand.\0A    # Try \22man first-second\22 and fall back to \22man first\22 if that doesn't work out.\0A    set -l maincmd (path basename $args[1])\0A    # HACK: If stderr is not attached to a terminal `less` (the default pager)\0A    # wouldn't use the alternate screen.\0A    # But since we don't know what pager it is, and because `man` is totally underspecified,\0A    # the best we can do is to *try* the man page, and assume that `man` will return false if it fails.\0A    # See #7863.\0A    if set -q args[2]\0A        and not string match -q -- '*/*' $args[2]\0A        and man \22$maincmd-$args[2]\22 &>/dev/null\0A        man \22$maincmd-$args[2]\22\0A    else\0A        if man \22$maincmd\22 &>/dev/null\0A            man \22$maincmd\22\0A        else\0A            printf \\a\0A        end\0A    end\0A\0A    commandline -f repaint\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3237 = private unnamed_addr constant [25 x i8] c"functions/__fish_md5.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3238 = private unnamed_addr constant [732 x i8] c"function __fish_md5\0A    if type -q md5sum\0A        # GNU systems\0A        if set -q argv[2]\0A            if test $argv[1] = -s\0A                echo $argv[2] | md5sum | string split ' ' -f 1\0A            else\0A                printf (_ \22%s: Too many arguments %s\\n\22) fish_md5 $argv >&2\0A            end\0A        else\0A            md5sum $argv[1] | string split ' ' -f 1\0A        end\0A        return 0\0A    else if type -q md5\0A        # BSD systems\0A        if set -q argv[2]\0A            if test $argv[1] = -s\0A                md5 -s $argv[2]\0A            else\0A                printf (_ \22%s: Too many arguments %s\\n\22) fish_md5 $argv >&2\0A            end\0A        else\0A            md5 -q $argv[1]\0A        end\0A        return 0\0A    end\0A    return 1\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3239 = private unnamed_addr constant [31 x i8] c"functions/__fish_move_last.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3240 = private unnamed_addr constant [706 x i8] c"function __fish_move_last -d \22Move the last element of a directory history from src to dest\22\0A    set -l src $argv[1]\0A    set -l dest $argv[2]\0A\0A    set -l size_src (count $$src)\0A\0A    if test $size_src = 0\0A        # Cannot make this step\0A        # Print a bel, which is the character to print for notifications like these.\0A        printf \\a\0A        return 1\0A    end\0A\0A    # Append current dir to the end of the destination\0A    set -g (echo $dest) $$dest $PWD\0A\0A    set -l ssrc $$src\0A\0A    # Change dir to the last entry in the source dir-hist\0A    builtin cd $ssrc[$size_src]\0A\0A    # Keep all but the last from the source dir-hist\0A    set -e (echo $src)\\[$size_src]\0A\0A    # All ok, return success\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3241 = private unnamed_addr constant [34 x i8] c"functions/__fish_no_arguments.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3242 = private unnamed_addr constant [269 x i8] c"function __fish_no_arguments -d \22Internal fish function\22\0A    set -l cmd (commandline -pxc) (commandline -tc)\0A    set -e cmd[1]\0A    for i in $cmd\0A        switch $i\0A            case '-*'\0A\0A            case '*'\0A                return 1\0A        end\0A    end\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3243 = private unnamed_addr constant [37 x i8] c"functions/__fish_not_contain_opt.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3244 = private unnamed_addr constant [1094 x i8] c"function __fish_not_contain_opt -d \22Checks that a specific option is not in the current command line\22\0A    set -l next_short\0A    set -l short_opt\0A    set -l long_opt\0A\0A    for i in $argv\0A        if test -n \22$next_short\22\0A            set next_short\0A            set short_opt $short_opt $i\0A        else\0A            switch $i\0A                case -s\0A                    set next_short 1\0A                case '-*'\0A                    echo __fish_not_contain_opt: Unknown option $i >&2\0A                    return 1\0A\0A                case '*'\0A                    set long_opt $long_opt $i\0A            end\0A        end\0A    end\0A\0A    for i in $short_opt\0A        if test -z \22$i\22\0A            continue\0A        end\0A\0A        if string match -qr -- \22^-$i|^-[^-]*$i\22 (commandline -cpx)\0A            return 1\0A        end\0A\0A        if string match -qr -- \22^-$i|^-[^-]*$i\22 (commandline -ct)\0A            return 1\0A        end\0A    end\0A\0A    for i in $long_opt\0A        if test -z \22$i\22\0A            continue\0A        end\0A\0A        if contains -- --$i (commandline -cpx)\0A            return 1\0A        end\0A    end\0A\0A    return 0\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3245 = private unnamed_addr constant [32 x i8] c"functions/__fish_npm_helper.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3246 = private unnamed_addr constant [4275 x i8] c"# This file is explicitly sourced by the npm and yarn completions\0A# It is used to enumerate entries from the npm registry, interact with a locally installed\0A# package.json file, and more.\0A# Other completions that would depend on this include jspm, pnpm, etc.\0A\0A# If all-the-package-names is installed, it will be used to generate npm completions.\0A# Install globally with `sudo npm install -g all-the-package-names`. Keep it up to date.\0Afunction __npm_helper_installed\0A    # This function takes the command to globally install a package as $argv[1]\0A    if not type -q all-the-package-names\0A        if not set -qg __fish_npm_pkg_info_shown\0A            set -l old (commandline)\0A            commandline -r \22\22\0A            echo \\nfish: Run `$argv[1] all-the-package-names` to gain intelligent \\\0A                package completion >&2\0A            commandline -f repaint\0A            commandline -r $old\0A            set -g __fish_npm_pkg_info_shown 1\0A        end\0A        return 1\0A    end\0Aend\0A\0A# Entire list of packages is too long to be used efficiently in a `complete` subcommand.\0A# Search it for matches instead.\0Afunction __npm_filtered_list_packages\0A    # This function takes the command to globally install a package as $argv[1]\0A    if not __npm_helper_installed $argv[1]\0A        return\0A    end\0A\0A    # Do not provide any completions if nothing has been entered yet to avoid long hang.\0A    if string match -rq -- . (commandline -ct)\0A        # Filter the results here rather than in the C++ code due to #5267\0A        # `all-the-package-names` reads a billion line JSON file using node (slow) then prints\0A        # it all (slow) using node (slow). Directly parse the `names.json` file that ships with it instead.\0A        for path in {$HOME/.config/yarn/global,$HOME/.npm-global/lib,/usr/local/lib}/node_modules/all-the-package-names/names.json\0A            test -f $path || continue\0A            # Using `string replace` directly is slow because it doesn't know to stop looking after a match cannot be\0A            # found in the alphabetically sorted list. Use `look` for its binary search support.\0A            look '  \22'(commandline -ct) $path | string replace -rf '^  \22(.*?)\22.*' '$1'\0A            break\0A        end\0A    end\0Aend\0A\0Afunction __npm_find_package_json\0A    set -l parents (__fish_parent_directories (pwd -P))\0A\0A    for p in $parents\0A        if test -f \22$p/package.json\22\0A            echo \22$p/package.json\22\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __npm_installed_global_packages\0A    set -l prefix (npm prefix -g)\0A    set -l node_modules \22$prefix/lib/node_modules\22\0A\0A    for path in $node_modules/*\0A        set -l mod (path basename -- $path)\0A\0A        if string match -rq \22^@\22 $mod\0A            for sub_path in $path/*\0A                set -l sub_mod (string split '/' $sub_path)[-1]\0A                echo $mod/$sub_mod\0A            end\0A        else\0A            echo $mod\0A        end\0A    end\0Aend\0A\0Afunction __npm_installed_local_packages\0A    set -l package_json (__npm_find_package_json)\0A    if not test $status -eq 0\0A        # no package.json in tree\0A        return 1\0A    end\0A\0A    if set -l python (__fish_anypython)\0A        $python -S -c 'import json, sys; data = json.load(sys.stdin);\0Aprint(\22\\n\22.join(data.get(\22dependencies\22, []))); print(\22\\n\22.join(data.get(\22devDependencies\22, [])))' <$package_json 2>/dev/null\0A    else if type -q jq\0A        jq -r '.dependencies as $a1 | .devDependencies as $a2 | ($a1 + $a2) | to_entries[] | .key' $package_json\0A    else\0A        set -l depsFound 0\0A        for line in (cat $package_json)\0A            # echo \22evaluating $line\22\0A            if test $depsFound -eq 0\0A                # echo \22mode: noDeps\22\0A                if string match -qr '(devD|d)ependencies\22' -- $line\0A                    # echo \22switching to mode: deps\22\0A                    set depsFound 1\0A                    continue\0A                end\0A                continue\0A            end\0A\0A            if string match -qr '\\}' -- $line\0A                # echo \22switching to mode: noDeps\22\0A                set depsFound 0\0A                continue\0A            end\0A\0A            # echo \22mode: deps\22\0A\0A            string replace -r '^\\s*\22([^\22]+)\22.*' '$1' -- $line\0A        end\0A    end\0Aend\0A\0Afunction __fish_npm_helper\0A    # dummy function to allow sourcing this file\0Aend\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3247 = private unnamed_addr constant [31 x i8] c"functions/__fish_nth_token.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.3248 = private unnamed_addr constant [386 x i8] c"function __fish_nth_token --description 'Prints the Nth token (ignoring command and switches/flags)' --argument-names n\0A    set -l tokens (commandline -px | string replace -r --filter '^([^-].*)' '$1')\0A    # Increment $n by one to account for ignoring the command\0A    if test (count $tokens) -ge (math \22$n\22 + 1)\0A        echo $tokens[(math $n + 1)]\0A    else\0A        return 1\0A    end\0Aend\0A", align 1
