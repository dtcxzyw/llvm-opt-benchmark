@anon.1d0b41a8d45d477c3029ec78f9b8b434.2664 = private unnamed_addr constant [2898 x i8] c"complete -c stream -o authenticate -d 'Decipher image with this password [password]'\0Acomplete -c stream -o channel -d 'Apply option to select image channels [type]' -xa '(stream -list channel)'\0Acomplete -c stream -o colorspace -d 'Alternate image colorspace [type]' -xa '(stream -list colorspace)'\0Acomplete -c stream -o compress -d 'Type of pixel compression when writing the image [type]' -xa '(stream -list compress)'\0Acomplete -c stream -o define -d 'Define one or more image format options [format:option]'\0Acomplete -c stream -o density -d 'Horizontal and vertical density of the image [geometry]'\0Acomplete -c stream -o depth -d 'Image depth [value]'\0Acomplete -c stream -o extract -d 'Extract area from image [geometry]'\0Acomplete -c stream -o identify -d 'Identify the format and characteristics of the image'\0Acomplete -c stream -o interlace -d 'Type of image interlacing scheme [type]' -xa '(stream -list interlace)'\0Acomplete -c stream -o interpolate -d 'Pixel color interpolation method [method]' -xa '(stream -list interpolate)'\0Acomplete -c stream -o limit -d 'Pixel cache resource limit [type value]' -x\0Acomplete -c stream -o map -d 'Components one or more pixel components'\0Acomplete -c stream -o monitor -d 'Monitor progress'\0Acomplete -c stream -o quantize -d 'Reduce colors in this colorspace [colorspace]' -xa '(stream -list colorspace)'\0Acomplete -c stream -o quiet -d 'Suppress all warning messages'\0Acomplete -c stream -o regard-warnings -d 'Pay attention to warning messages'\0Acomplete -c stream -o respect-parentheses -d 'Settings remain in effect until parenthesis boundary'\0Acomplete -c stream -o sampling-factor -d 'Horizontal and vertical sampling factor [geometry]'\0Acomplete -c stream -o seed -d 'Seed a new sequence of pseudo-random numbers [value]'\0Acomplete -c stream -o set -d 'Attribute set an image attribute [value]'\0Acomplete -c stream -o size -d