@anon.1d0b41a8d45d477c3029ec78f9b8b434.2824 = private unnamed_addr constant [2058 x i8] c"complete -c usermod -xa \22(__fish_complete_users)\22\0Acomplete -c usermod -s a -l append -d \22Append groups (use with -G)\22\0Acomplete -c usermod -s c -l comment -d \22Change user's password file comment\22 -x\0Acomplete -c usermod -s d -l home -d \22Change user's login directory\22 -r\0Acomplete -c usermod -s e -l expiredate -d \22Date (YYYY-MM-DD) on which the user account will be disabled\22 -x\0Acomplete -c usermod -s f -l inactive -d \22Number of days after a password expires until the account is locked\22 -xa \22(seq 0 365)\22\0Acomplete -c usermod -s g -l gid -d \22Group name or number of the user's new initial login group\22 -xa \22(__fish_complete_groups)\22\0Acomplete -c usermod -s G -l groups -d \22List of groups which the user is also a member of\22 -xa \22(__fish_complete_list , __fish_complete_groups)\22\0Acomplete -c usermod -s l -l login -d \22Change user's name\22 -x\0Acomplete -c usermod -s L -l lock -d \22Lock user's password\22 -f\0Acomplete -c usermod -s m -l move-home -d \22Move the content of the user's home directory to the new location\22 -f\0Acomplete -c usermod -s o -l non-unique -d \22Allow non-unique UID\22 -f\0Acomplete -c usermod -s p -l password -d \22The encrypted password, as returned by crypt(3)\22 -x\0Acomplete -c usermod -s R -l root -d \22Apply changes in this directory\22 -x\0Acomplete -c usermod -s P -l prefix -d \22Apply changes in the PREFIX_DIR\22 -x\0Acomplete -c usermod -s s -l shell -d \22The name of the user's new login shell\22 -x\0Acomplete -c usermod -s u -l uid -d \22The new numerical value of the user's ID\22 -x\0Acomplete -c usermod -s U -l unlock -d \22Unlock a users password\22 -f\0Acomplete -c usermod -s v -l add-subuids -d \22Add a range of subordinate uids to the user's account\22 -x\0Acomplete -c usermod -s V -l del-subuids -d \22Remove a range of subordinate uids from the user's account\22 -x\0Acomplete -c usermod -s w -l add-subgids -d \22Add a range of subordinate gids to the user's account\22 -x\0Acomplete -c usermod -s W -l del-subgids -d \22Remove a range of subordinate gids from the user's account\22 -x\0Acomplete -c usermod -s Z -l selinux-user -d \22The new SELinux user for the user's login\22 -x\0A", align 1
