@anon.1d0b41a8d45d477c3029ec78f9b8b434.1870 = private unnamed_addr constant [28662 x i8] c"# ip(8) completion for fish\0A\0A# The difficulty here is that ip allows abbreviating options, so we need to complete \22ip a\22 like \22ip address\22, but not \22ip m\22 like \22ip mroute\22\0A# Also the manpage and even the grammar it accepts is utter shite (options can only be before commands, some things are only in the BNF, others only in the text)\0A# It also quite likes the word \22dev\22, even though it needs it less than the BNF specifies\0A\0Aset -l ip_commands link address addrlabel route rule neighbour ntable tunnel tuntap maddr mroute mrule monitor xfrm netns l2tp tcp_metrics\0Aset -l ip_addr a ad add addr addre addres address\0Aset -l ip_link l li lin link\0Aset -l ip_neigh n ne nei neig neigh neighb neighbo neighbor neighbour\0Aset -l ip_route r ro rou rout route\0Aset -l ip_rule ru rul rule\0Aset -l ip_all_commands $ip_commands $ip_addr $ip_link $ip_neigh $ip_route $ip_rule\0A\0Afunction __fish_ip_commandwords\0A    set -l skip 0\0A    set -l cmd (commandline -xpc | string escape)\0A    # Remove the first word because it's \22ip\22 or an alias for it\0A    set -e cmd[1]\0A    set -l have_command 0\0A    for word in $cmd\0A        switch $word\0A            # Normalize the commands to their full form - `ip a` is `ip address`\0A            # This can't be just an unambiguity check because there's also `ip addrlabel`\0A            case a ad add addr addre addres address\0A                # \22addr add\22 is a thing, so we can only echo \22address\22 if it's actually the command\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo address\0A                else\0A                    echo $word\0A                end\0A            case l li lin link\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo link\0A                else\0A                    echo $word\0A                end\0A            case \22addrl*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo addrlabel\0A                else\0A                    echo $word\0A                end\0A            case r ro rou rout route\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo route\0A                else\0A                    echo $word\0A                end\0A            case \22ru*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo rule\0A                else\0A                    echo $word\0A                end\0A            case n ne nei neig neigh neighb neighbo neighbor neighbour\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo neighbour\0A                else\0A                    echo $word\0A                end\0A            case nt\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo ntable\0A                else\0A                    echo $word\0A                end\0A            case t tu tun tunn tunne tunnel\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo tunnel\0A                else\0A                    echo $word\0A                end\0A            case \22tunt*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo tuntap\0A                else\0A                    echo $word\0A                end\0A            case m ma mad madd maddr maddre maddres maddress\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo maddress\0A                else\0A                    echo $word\0A                end\0A            case mr \22mro*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo mroute\0A                else\0A                    echo $word\0A                end\0A            case \22mru*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo mrule\0A                else\0A                    echo $word\0A                end\0A            case \22mo*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo monitor\0A                else\0A                    echo $word\0A                end\0A            case \22x*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo xfrm\0A                else\0A                    echo $word\0A                end\0A            case \22net*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo netns\0A                else\0A                    echo $word\0A                end\0A            case \22l*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo l2tp\0A                else\0A                    echo $word\0A                end\0A            case \22tc*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo tcp_metrics\0A                else\0A                    echo $word\0A                end\0A            case \22to*\22\0A                if test $have_command = 0\0A                    set have_command 1\0A                    echo token\0A                else\0A                    echo $word\0A                end\0A            case -n -netns --netns\0A                if test $have_command = 0\0A                    set skip 1\0A                else\0A                    echo $word\0A                end\0A            case '-*'\0A                test $have_command = 0\0A                and continue\0A                echo $word\0A            case '*'\0A                if test $skip = 1\0A                    set skip 0\0A                    continue\0A                end\0A                echo $word\0A        end\0A    end\0A    # Print an empty line if the current token is empty, so we know that the one before it is finished\0A    # TODO: For some reason it is necessary to always print the current token - why doesn't the above loop catch it?\0A    set -l token (commandline -ct)\0A    echo $token\0Aend\0A\0Afunction __fish_ip_device\0A    command ip -o link show | while read -l a b c\0A        printf '%s\\t%s\\n' (string replace -r '(@.*)?:' '' -- $b) Device\0A    end\0Aend\0A\0Afunction __fish_ip_scope\0A    if test -r /etc/iproute2/rt_scopes\0A        string replace -r '#.*' '' </etc/iproute2/rt_scopes \\\0A            | string match -v '^\\s*$' \\\0A            | string replace -r '(\\S+)\\s*(\\S+)' '$1\\t$2\\n$2\\t$1' \\\0A            | string match -rv '^(global|link|host).*' # Ignore scopes with better descriptions\0A    end\0A    # Predefined scopes\0A    printf '%s\\t%s\\n' global \22Address is globally valid\22 \\\0A        link \22Address is link-local, only valid on this device\22 \\\0A        host \22Address is only valid on this host\22\0Aend\0A\0Afunction __fish_ip_netns_list\0A    command ip netns list | while read -l a b c\0A        echo -- $a\0A    end\0Aend\0A\0Afunction __fish_ip_routing_tables\0A    command ip -d route show table all 2>/dev/null | string replace -fr '.*\\stable\\s(\\S+).*' '$1'\0Aend\0A\0Afunction __fish_ip_types\0A    printf '%s\\t%s\\n' \\\0A        bridge \22Ethernet Bridge device\22 \\\0A        bond \22Bonding device\22 \\\0A        dummy \22Dummy network interface\22 \\\0A        hsr \22High-availability Seamless Redundancy device\22 \\\0A        ifb \22Intermediate Functional Block device\22 \\\0A        ipoib \22IP over Infiniband device\22 \\\0A        macvlan \22Virtual interface base on link layer address (MAC)\22 \\\0A        macvtap \22Virtual interface based on link layer address (MAC) and TAP.\22 \\\0A        vcan \22Virtual Controller Area Network interface\22 \\\0A        vxcan \22Virtual Controller Area Network tunnel interface\22 \\\0A        veth \22Virtual ethernet interface\22 \\\0A        vlan \22802.1q tagged virtual LAN interface\22 \\\0A        vxlan \22Virtual eXtended LAN\22 \\\0A        ip6tnl \22Virtual tunnel interface IPv4|IPv6 over IPv6\22 \\\0A        ipip \22Virtual tunnel interface IPv4 over IPv4\22 \\\0A        sit \22Virtual tunnel interface IPv6 over IPv4\22 \\\0A        gre \22Virtual tunnel interface GRE over IPv4\22 \\\0A        gretap \22Virtual L2 tunnel interface GRE over IPv4\22 \\\0A        erspan \22Encapsulated Remote SPAN over GRE and IPv4\22 \\\0A        ip6gre \22Virtual tunnel interface GRE over IPv6\22 \\\0A        ip6gretap \22Virtual L2 tunnel interface GRE over IPv6\22 \\\0A        ip6erspan \22Encapsulated Remote SPAN over GRE and IPv6\22 \\\0A        vti \22Virtual tunnel interface\22 \\\0A        nlmon \22Netlink monitoring device\22 \\\0A        ipvlan \22Interface for L3 (IPv6/IPv4) based VLANs\22 \\\0A        ipvtap \22Interface for L3 (IPv6/IPv4) based VLANs and TAP\22 \\\0A        lowpan \22Interface for 6LoWPAN (IPv6) over IEEE 802.15.4 / Bluetooth\22 \\\0A        geneve \22GEneric NEtwork Virtualization Encapsulation\22 \\\0A        bareudp \22Bare UDP L3 encapsulation support\22 \\\0A        macsec \22Interface for IEEE 802.1AE MAC Security (MACsec)\22 \\\0A        vrf \22Interface for L3 VRF domains\22 \\\0A        netdevsim \22Interface for netdev API tests\22 \\\0A        rmnet \22Qualcomm rmnet device\22 \\\0A        xfrm \22Virtual xfrm interface\22\0Aend\0A\0Afunction __fish_ip_neigh_states\0A    printf '%s\\t%s\\n' \\\0A        permanent \22entry is valid forever\22 \\\0A        noarp \22entry is valid without validation\22 \\\0A        reachable \22entry is valid until timeout\22 \\\0A        stale \22entry is valid but suspicious\22 \\\0A        none \22pseudo state\22 \\\0A        incomplete \22entry has not yet been validated\22 \\\0A        delay \22entry validation is currently delayed\22 \\\0A        probe \22neighbor is being probed\22 \\\0A        failed \22neighbor validation has ultimately failed\22\0Aend\0A\0Afunction __fish_complete_ip\0A    set -l cmd (__fish_ip_commandwords)\0A    set -l count (count $cmd)\0A    switch \22$cmd[1]\22\0A        case address\0A            # We're still _on_ the second word, which is the subcommand\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add new protocol address\22 \\\0A                    delete \22Delete protocol address\22 \\\0A                    show \22Look at protocol addresses\22 \\\0A                    flush \22Flush protocol addresses\22 \\\0A                    help \22Display help\22\0A            else\0A                switch $cmd[2]\0A                    # Change and replace are undocumented (apart from mentions in the BNF)\0A                    case add change replace\0A                        switch $count\0A                            case 3\0A                                # __fish_ip_complete_ip\0A                            case '*'\0A                                switch $cmd[-2]\0A                                    case dev\0A                                        __fish_ip_device\0A                                    case scope\0A                                        __fish_ip_scope\0A                                        # TODO: Figure out how to complete these\0A                                    case label\0A                                        # Prefix\0A                                    case local peer broadcast\0A                                        # Address\0A                                    case valid_lft preferred_lft\0A                                        # Lifetime\0A                                    case '*'\0A                                        printf '%s\\t%s\\n' forever \22Keep address valid forever\22 \\\0A                                            home \22(Ipv6 only) Designate address as home address\22 \\\0A                                            nodad \22(Ipv6 only) Don't perform duplicate address detection\22 \\\0A                                            dev \22Add address to specified device\22 \\\0A                                            scope \22Set scope of address\22 \\\0A                                            label \22Tag address with label\22\0A                                end\0A                        end\0A                    case delete\0A                        switch $count\0A                            case 3\0A                                command ip -o addr show | while read -l a b c d e\0A                                    echo $d\0A                                end\0A                            case 4\0A                                # A dev argument is mandatory, but contrary to the BNF, other things (like \22scope\22) are also valid here\0A                                # And yes, unlike e.g. show, this _needs_ the \22dev\22 before the device\0A                                # Otherwise it barfs and says \22??? prefix is expected\22\0A                                # Anyway, try to steer the user towards supplying a device\0A                                echo dev\0A                            case 5\0A                                switch $cmd[-2]\0A                                    case dev\0A                                        command ip -o addr show | string match \22*$cmd[3]*\22 | while read -l a b c\0A                                            echo $b\0A                                        end\0A                                        # TODO: Moar\0A                                end\0A                        end\0A                    case show save flush # These take the same args\0A                        switch $cmd[-2]\0A                            case dev\0A                                __fish_ip_device\0A                            case scope\0A                                __fish_ip_scope\0A                            case to\0A                                # Prefix\0A                            case label\0A                                # Label-pattern\0A                            case '*'\0A                                printf '%s\\t%s\\n' up \22Only active devices\22 \\\0A                                    dev \22Limit to a certain device\22 \\\0A                                    scope \22Limit scope\22 \\\0A                                    to \22Limit prefix\22 \\\0A                                    label \22Limit by label\22 \\\0A                                    dynamic \22(Ipv6 only) Limit to dynamic addresses\22 \\\0A                                    permanent \22(Ipv6 only) Limit to permanent addresses\22\0A                                __fish_ip_device\0A                                # TODO: Moar\0A                        end\0A                end\0A            end\0A        case link\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add virtual link\22 \\\0A                    delete \22Delete virtual link\22 \\\0A                    set \22Change device attributes\22 \\\0A                    show \22Display device attributes\22 \\\0A                    help \22Display help\22\0A            else\0A                # TODO: Add moar\0A                switch $cmd[2]\0A                    case add\0A                        switch $cmd[-2]\0A                            case link\0A                                __fish_ip_device\0A                            case name # freeform, uncompleteable.\0A                            case type\0A                                __fish_ip_types\0A                            case txqueuelen\0A                            case address\0A                            case broadcast\0A                            case mtu index numtxqueues numrxqueues gso_max_size gso_max_segs\0A                                # These all take some kind of number?\0A                                seq 0 50\0A                            case add '*'\0A                                # We assume if we haven't checked it above, we're back to `ip link add`, with any optionals completed.\0A                                # So we now suggest optionals.\0A                                printf '%s\\t%s\\n' \\\0A                                    link \22\22 \\\0A                                    type \22\22 \\\0A                                    txqueuelen PACKETS \\\0A                                    address LLADDR \\\0A                                    broadcast LLADDR \\\0A                                    mtu MTU \\\0A                                    index IDX \\\0A                                    numtxqueues QUEUE_COUNT \\\0A                                    numrxqueues QUEUE_COUNT \\\0A                                    gso_max_size BYTES \\\0A                                    gso_max_segs\0A                        end\0A                    case delete\0A                        switch $cmd[-2]\0A                            case delete\0A                                __fish_ip_device\0A                                echo dev\0A                                echo group\0A                            case dev\0A                                __fish_ip_device\0A                            case group\0A                            case type\0A                                __fish_ip_types\0A                            case '*'\0A                                if not set -q cmd[6]\0A                                    echo type\0A                                end\0A                        end\0A                    case set\0A                        switch $cmd[-2]\0A                            case type\0A                                __fish_ip_types\0A                                echo bridge_slave\0A                                echo bond_slave\0A                            case arp dynamic {all,}multicast pro{misc,todown} trailers spoofchk query_rss trust\0A                                echo on\0A                                echo off\0A                            case name alias\0A                            case address broadcast\0A                            case mtu txqueuelen\0A                            case netns\0A                            case link-netnsid\0A                            case vf mac\0A                            case {{max,min}_tx_,}rate\0A                            case node_guid port_guid\0A                            case state\0A                                echo auto\0A                                echo enable\0A                                echo disable\0A                            case master dev # Yes, the word \22dev\22 is allowed here!\0A                                __fish_ip_device\0A                            case nomaster\0A                            case vrf\0A                            case xdp'*'\0A                            case object section pinned\0A                            case addrgenmode\0A                            case macaddr\0A                            case group\0A                            case set '*'\0A                                __fish_ip_device\0A                                echo group\0A                                echo up\0A                                echo down\0A                        end\0A                    case show\0A                    case help\0A                        __fish_ip_types\0A                end\0A            end\0A        case neighbour\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add new neighbour entry\22 \\\0A                    delete \22Delete neighbour entry\22 \\\0A                    change \22Change neighbour entry\22 \\\0A                    replace \22Add or change neighbour entry\22 \\\0A                    show \22List neighbour entries\22 \\\0A                    flush \22Flush neighbour entries\22 \\\0A                    get \22Lookup neighbour entry\22 \\\0A                    help \22Display help\22\0A            else\0A                switch $cmd[2]\0A                    case add del delete change replace\0A                        switch $cmd[-2]\0A                            case lladdr\0A                            case nud\0A                                __fish_ip_neigh_states\0A                            case proxy\0A                            case dev\0A                                __fish_ip_device\0A                            case '*'\0A                                echo lladdr\0A                                echo nud\0A                                echo proxy\0A                                echo dev\0A                                echo router\0A                                echo use\0A                                echo managed\0A                                echo extern_learn\0A                        end\0A                    case show flush\0A                        switch $cmd[-2]\0A                            case to\0A                            case dev\0A                                __fish_ip_device\0A                            case vrf\0A                            case nud\0A                                __fish_ip_neigh_states\0A                                echo all\0A                            case '*'\0A                                echo to\0A                                echo dev\0A                                echo vrf\0A                                echo nomaster\0A                                echo proxy\0A                                echo unused\0A                                echo nud\0A                        end\0A                    case get\0A                        switch $cmd[-2]\0A                            case to\0A                            case dev\0A                                __fish_ip_device\0A                            case '*'\0A                                echo proxy\0A                                echo to\0A                                echo dev\0A                        end\0A                end\0A            end\0A        case route\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add new route\22 \\\0A                    change \22Change route\22 \\\0A                    append \22Append route\22 \\\0A                    replace \22Change or add new route\22 \\\0A                    delete \22Delete route\22 \\\0A                    show \22List routes\22 \\\0A                    flush \22Flush routing tables\22 \\\0A                    get \22Get a single route\22 \\\0A                    save \22Save routing table to stdout\22 \\\0A                    showdump \22Show saved routing table from stdin\22 \\\0A                    restore \22Restore routing table from stdin\22 \\\0A                    help \22Display help\22\0A            else\0A                # TODO: switch on $cmd[2] and complete subcommand specific arguments\0A                # for now just complete most useful arguments for the last token\0A                switch $cmd[-2]\0A                    case dev iif oif\0A                        __fish_ip_device\0A                    case table\0A                        __fish_ip_routing_tables\0A                end\0A            end\0A        case rule\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add new rule\22 \\\0A                    delete \22Delete rule\22 \\\0A                    flush \22Flush rules\22 \\\0A                    show \22List rules\22 \\\0A                    save \22Save rules to stdout\22 \\\0A                    restore \22Restore rules from stdin\22 \\\0A                    help \22Display help\22\0A            else\0A                # TODO: switch on $cmd[2] and complete subcommand specific arguments\0A                # for now just complete most useful arguments for the last token\0A                switch $cmd[-2]\0A                    case iif oif\0A                        __fish_ip_device\0A                    case table\0A                        __fish_ip_routing_tables\0A                end\0A            end\0A        case netns\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' add \22Add network namespace\22 \\\0A                    attach \22Attach process to network namespace\22 \\\0A                    delete \22Delete network namespace\22 \\\0A                    set \22Change network namespace attributes\22 \\\0A                    identify \22Display network namespace for a process id\22 \\\0A                    pids \22Display process ids of processes running in network namespace\22 \\\0A                    monitor \22Report as network namespace names are added and deleted\22 \\\0A                    exec \22Execute command in network namespace\22 \\\0A                    help \22Display help\22 \\\0A                    list \22List network namespaces\22\0A            else\0A                switch $cmd[2]\0A                    case delete\0A                        if not set -q cmd[4]\0A                            __fish_ip_netns_list\0A                        end\0A                    case exec\0A                        if not set -q cmd[4]\0A                            __fish_ip_netns_list\0A                        else\0A                            __fish_complete_subcommand --commandline $cmd[4..-1]\0A                        end\0A                    case pids\0A                        if not set -q cmd[4]\0A                            __fish_ip_netns_list\0A                        end\0A                    case set\0A                        if not set -q cmd[4]\0A                            __fish_ip_netns_list\0A                        end\0A                    case attach\0A                        if not set -q cmd[4]\0A                            __fish_ip_netns_list\0A                        else\0A                            __fish_complete_pids\0A                        end\0A                    case identify\0A                        if not set -q cmd[4]\0A                            __fish_complete_pids\0A                        end\0A                end\0A            end\0A        case tuntap\0A            if not set -q cmd[3]\0A                printf '%s\\t%s\\n' \\\0A                    add \22Add a new tun or tap device\22 \\\0A                    del \22Delete a tun or tap device\22 \\\0A                    show \22Show tun and tap devices\22 \\\0A                    help \22Display help\22\0A            else\0A                switch $cmd[-2]\0A                    case dev\0A                        __fish_ip_device\0A                    case mode\0A                        printf '%s\\n' tun tap\0A                    case user\0A                        __fish_complete_users\0A                    case group\0A                        __fish_complete_groups\0A                    case '*'\0A                        printf '%s\\n' dev mode user group one_queue pi vnet_hdr multi_queue name\0A                end\0A            end\0A    end\0Aend\0A\0Acomplete -f -c ip\0Acomplete -f -c ip -a '(__fish_complete_ip)'\0Acomplete -f -c ip -n \22not __fish_seen_subcommand_from $ip_all_commands\22 -a \22$ip_commands\22\0A# Yes, ip only takes options before \22objects\22\0Acomplete -c ip -s h -l human -d \22Output statistics with human readable values\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -s b -l batch -d \22Read commands from file or stdin\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -l force -d \22Don't terminate on errors in batch mode\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -s V -l Version -d \22Print the version\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s s -l stats -d \22Output more information\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s d -l details -d \22Output more detailed information\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s l -l loops -d \22Specify maximum number of loops for 'ip addr flush'\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s f -l family -d \22The protocol family to use\22 -a \22inet inet6 bridge ipx dnet link any\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s 4 -d \22Short for --family inet\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s 6 -d \22Short for --family inet6\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s B -d \22Short for --family bridge\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s M -d \22Short for --family mpls\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s 0 -d \22Short for --family link\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s o -l oneline -d \22Output on one line\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s r -l resolve -d \22Resolve names and print them instead of addresses\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s n -l netns -d \22Use specified network namespace\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s a -l all -d \22Execute command for all objects\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s c -l color -d \22Configure color output\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s t -l timestamp -d \22Display current time when using monitor\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -o ts -l tshort -d \22Like -timestamp, but shorter format\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -o rc -l rcvbuf -d \22Set the netlink socket receive buffer size\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -o iec -d \22Print human readable rates in IEC units\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -o br -l brief -d \22Print only basic information in a tabular format\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s j -l json -d \22Output results in JSON\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0Acomplete -c ip -f -s p -l pretty -d \22Output results in pretty JSON\22 -n \22not __fish_seen_subcommand_from $ip_commands\22\0A", align 1
