@anon.1d0b41a8d45d477c3029ec78f9b8b434.1992 = private unnamed_addr constant [3306 x i8] c"complete -c lpadmin -s c -d 'Adds the named printer to class' -x\0Acomplete -c lpadmin -s i -d 'Sets a  SysV style interface script for printer' -x\0Acomplete -c lpadmin -s m -d 'Sets a standard SysV interface script or PPD file ' -x\0Acomplete -c lpadmin -s R -d 'Deletes the named option from printer' -xa '(__fish_print_lpr_options)'\0Acomplete -c lpadmin -s r -d 'Removes the named printer from class' -x\0A\0Acomplete -c lpadmin -s v -d 'Sets the device-uri attribute of the printer queue' -r\0Acomplete -c lpadmin -s D -d 'Provides a textual description of the destination' -x\0Acomplete -c lpadmin -s E -d 'Enables the destination and accepts jobs'\0Acomplete -c lpadmin -s L -d 'Provides a textual location of the destination' -x\0Acomplete -c lpadmin -s P -d 'Specify a PDD file to use with the printer' -k -xa \22(__fish_complete_suffix .ppd .ppd.gz)\22\0Acomplete -c lpadmin -s o -xa cupsIPPSupplies=true -d 'Specify if IPP supply level values should be reported'\0Acomplete -c lpadmin -s o -xa cupsIPPSupplies=false -d 'Specify if IPP supply level values should be reported'\0Acomplete -c lpadmin -s o -xa cupsSNMPSupplies=true -d 'Specify if SNMP supply level values should be reported'\0Acomplete -c lpadmin -s o -xa cupsSNMPSupplies=false -d 'Specify if SNMP supply level values should be reported'\0Acomplete -c lpadmin -s o -xa job-k-limit= -d 'Sets the kilobyte limit for per-user quotas'\0Acomplete -c lpadmin -s o -xa job-page-limit= -d 'Sets the page limit for per-user quotas (int) '\0Acomplete -c lpadmin -s o -xa job-quota-period= -d 'Sets the accounting period for per-user quotas (sec)'\0Acomplete -c lpadmin -s o -xa job-sheets-default= -d 'Sets the default banner page(s) to use for print jobs'\0Acomplete -c lpadmin -s o -d 'Sets a  PPD option for the printer' -xa '(__fish_complete_lpr_option)'\0A#complete -c lpadmin -s o -d 'Sets a default server-side option for the destination' -xa '(__fish_complete_lpr_option | sed \22s/=/-default=/\22)'\0Acomplete -c lpadmin -s o -d 'Set the binary communications program to use' -xa 'port-monitor=none port-monitor=bcp port-monitor=tbcp'\0Acomplete -c lpadmin -s o -d \22Set error policy if printer backend can't send job\22 -xa 'printer-error-policy=abort-job printer-error-policy=retry-job printer-error-policy=retry-current-job printer-error-policy=stop-printer'\0Acomplete -c lpadmin -s o -xa printer-is-shared=true -d 'Sets dest to shared/published or unshared/unpublished'\0Acomplete -c lpadmin -s o -xa printer-is-shared=false -d 'Sets dest to shared/published or unshared/unpublished'\0Acomplete -c lpadmin -s o -d 'Set IPP operation policy associated with dest' -xa \22printer-policy=(test -r /etc/cups/cupsd.conf; and string replace -r --filter '<Policy (.*)>' '$1' < /etc/cups/cupsd.conf)\22\0A\0Acomplete -c lpadmin -s u -xa 'allow:all allow:none (__fish_complete_list , __fish_complete_users allow:)' -d 'Sets user-level access control on a destination'\0Acomplete -c lpadmin -s u -xa '(__fish_complete_list , __fish_complete_groups allow: @)' -d 'Sets user-level access control on a destination'\0Acomplete -c lpadmin -s u -xa 'deny:all deny:none (__fish_complete_list , __fish_complete_users deny:)' -d 'Sets user-level access control on a destination'\0Acomplete -c lpadmin -s u -xa '(__fish_complete_list , __fish_complete_groups deny: @)' -d 'Sets user-level access control on a destination'\0A", align 1
