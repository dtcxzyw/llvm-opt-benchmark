@anon.1d0b41a8d45d477c3029ec78f9b8b434.3575 = private unnamed_addr constant [3744 x i8] c"# name: Nim\0A# author: Guilhem \22Nim\22 Saurel \E2\88\92 https://github.com/nim65s/dotfiles/\0A\0Afunction fish_prompt\0A    # This prompt shows:\0A    # - green lines if the last return command is OK, red otherwise\0A    # - your user name, in red if root or yellow otherwise\0A    # - your hostname, in cyan if ssh or blue otherwise\0A    # - the current path (with prompt_pwd)\0A    # - date +%X\0A    # - the current virtual environment, if any\0A    # - the current git status, if any, with fish_git_prompt\0A    # - the current battery state, if any, and if your power cable is unplugged, and if you have \22acpi\22\0A    # - current background jobs, if any\0A\0A    # It goes from:\0A    # \E2\94\AC\E2\94\80[nim@Hattori:~]\E2\94\80[11:39:00]\0A    # \E2\95\B0\E2\94\80>$ echo here\0A\0A    # To:\0A    # \E2\94\AC\E2\94\80[nim@Hattori:~/w/dashboard]\E2\94\80[11:37:14]\E2\94\80[V:django20]\E2\94\80[G:master\E2\86\911|\E2\97\8F1\E2\9C\9A1\E2\80\A61]\E2\94\80[B:85%, 05:41:42 remaining]\0A    # \E2\94\82 2    15054    0%    arr\C3\AAt\C3\A9e    sleep 100000\0A    # \E2\94\82 1    15048    0%    arr\C3\AAt\C3\A9e    sleep 100000\0A    # \E2\95\B0\E2\94\80>$ echo there\0A\0A    set -l retc red\0A    test $status = 0; and set retc green\0A\0A    set -q __fish_git_prompt_showupstream\0A    or set -g __fish_git_prompt_showupstream auto\0A\0A    function _nim_prompt_wrapper\0A        set retc $argv[1]\0A        set -l field_name $argv[2]\0A        set -l field_value $argv[3]\0A\0A        set_color normal\0A        set_color $retc\0A        echo -n '\E2\94\80'\0A        set_color -o green\0A        echo -n '['\0A        set_color normal\0A        test -n $field_name\0A        and echo -n $field_name:\0A        set_color $retc\0A        echo -n $field_value\0A        set_color -o green\0A        echo -n ']'\0A    end\0A\0A    set_color $retc\0A    echo -n '\E2\94\AC\E2\94\80'\0A    set_color -o green\0A    echo -n [\0A\0A    if functions -q fish_is_root_user; and fish_is_root_user\0A        set_color -o red\0A    else\0A        set_color -o yellow\0A    end\0A\0A    echo -n $USER\0A    set_color -o white\0A    echo -n @\0A\0A    if test -z \22$SSH_CLIENT\22\0A        set_color -o blue\0A    else\0A        set_color -o cyan\0A    end\0A\0A    echo -n (prompt_hostname)\0A    set_color -o white\0A    echo -n :(prompt_pwd)\0A    set_color -o green\0A    echo -n ']'\0A\0A    # Date\0A    _nim_prompt_wrapper $retc '' (date +%X)\0A\0A    # Vi-mode\0A    # The default mode prompt would be prefixed, which ruins our alignment.\0A    function fish_mode_prompt\0A    end\0A\0A    if test \22$fish_key_bindings\22 = fish_vi_key_bindings\0A        or test \22$fish_key_bindings\22 = fish_hybrid_key_bindings\0A        set -l mode\0A        switch $fish_bind_mode\0A            case default\0A                set mode (set_color --bold red)N\0A            case insert\0A                set mode (set_color --bold green)I\0A            case replace_one\0A                set mode (set_color --bold green)R\0A                echo '[R]'\0A            case replace\0A                set mode (set_color --bold cyan)R\0A            case visual\0A                set mode (set_color --bold magenta)V\0A        end\0A        set mode $mode(set_color normal)\0A        _nim_prompt_wrapper $retc '' $mode\0A    end\0A\0A    # Virtual Environment\0A    set -q VIRTUAL_ENV_DISABLE_PROMPT\0A    or set -g VIRTUAL_ENV_DISABLE_PROMPT true\0A    set -q VIRTUAL_ENV\0A    and _nim_prompt_wrapper $retc V (path basename \22$VIRTUAL_ENV\22)\0A\0A    # git\0A    set -l prompt_git (fish_git_prompt '%s')\0A    test -n \22$prompt_git\22\0A    and _nim_prompt_wrapper $retc G $prompt_git\0A\0A    # Battery status\0A    type -q acpi\0A    and acpi -a 2>/dev/null | string match -rq off\0A    and _nim_prompt_wrapper $retc B (acpi -b | cut -d' ' -f 4-)\0A\0A    # New line\0A    echo\0A\0A    # Background jobs\0A    set_color normal\0A\0A    for job in (jobs)\0A        set_color $retc\0A        echo -n '\E2\94\82 '\0A        set_color brown\0A        echo $job\0A    end\0A\0A    set_color normal\0A    set_color $retc\0A    echo -n '\E2\95\B0\E2\94\80>'\0A    set_color -o red\0A    echo -n '$ '\0A    set_color normal\0Aend\0A", align 1
