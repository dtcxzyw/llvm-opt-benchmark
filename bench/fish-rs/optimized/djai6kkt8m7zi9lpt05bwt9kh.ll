@anon.1d0b41a8d45d477c3029ec78f9b8b434.1474 = private unnamed_addr constant [1893 x i8] c"set -l commands allow permit grant block deny revoke edit exec fetchurl help hook prune reload status stdlib version\0A\0Aset -l with_file allow permit grant block deny revoke edit\0A\0Acomplete -c direnv -f\0A\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a \22allow permit grant\22 -d \22Grant direnv permission to load the given .envrc or .env file\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a \22block deny revoke\22 -d \22Revoke the authorization of a given .envrc or .env file\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a edit -d \22Open given file or current .envrc/.env in \\$EDITOR and allow it to be loaded afterwards\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a exec -d \22Execute a command after loading the first .envrc or .env found in DIR\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a fetchurl -d \22Fetch a given URL into direnv's CAS\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a help -d \22show help\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a hook -d \22Used to setup the shell hook\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a prune -d \22Remove old allowed files\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a reload -d \22Trigger an env reload\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a status -d \22Print some debug status information\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a stdlib -d \22Display the stdlib available in the .envrc execution context\22\0Acomplete -c direnv -n \22not __fish_seen_subcommand_from $commands\22 \\\0A    -a version -d \22Print the version or check that direnv is at least given version\22\0A\0Acomplete -c direnv -n \22__fish_seen_subcommand_from $with_file\22 -F\0A", align 1
