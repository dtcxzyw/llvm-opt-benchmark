@anon.1d0b41a8d45d477c3029ec78f9b8b434.2892 = private unnamed_addr constant [1862 x i8] c"#Windscribe 1.4\0A\0A#variables\0Aset -l seen __fish_seen_subcommand_from\0Aset -l commands account connect disconnect examples firewall lanbypass locations login logout port protocol proxy sendlog speedtest status viewlog\0A\0A#options\0Acomplete -c windscribe -x -n \22not $seen $commands\22 -l help\0A\0A#commands\0Acomplete -c windscribe -f -n \22$seen $commands\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a account -d \22Output current account details\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a connect -d \22Connect to Windscribe\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a disconnect -d \22Disconnect from VPN\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a examples -d \22Show usage examples\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a firewall -d \22View/Modify Firewall mode\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a lanbypass -d \22View/Modify Firewall LAN bypass\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a locations -d \22Output list of all available server locations\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a login -d \22Login to Windscribe account\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a logout -d \22Logout and disconnect\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a port -d \22View/Modify default Port\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a protocol -d \22View/Modify default Protocol\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a proxy -d \22View/Modify Proxy Settings\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a sendlog -d \22Send the debug log to Support\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a speedtest -d \22Test the connection speed\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a status -d \22Check status of Windscribe and connection\22\0Acomplete -c windscribe -f -n \22not $seen $commands\22 -a viewlog -d \22View the debug log\22\0A", align 1
