@anon.1d0b41a8d45d477c3029ec78f9b8b434.3532 = private unnamed_addr constant [2319 x i8] c"# This defines a compatibility shim for the `trap` command found in other shells like bash and zsh.\0Afunction trap -d 'Perform an action when the shell receives a signal'\0A    set -l options h/help l/list-signals p/print\0A    argparse -n trap $options -- $argv\0A    or return\0A\0A    if set -q _flag_help\0A        __fish_print_help trap\0A        return 0\0A    end\0A\0A    set -l mode\0A    set -l cmd\0A    set -l sig\0A\0A    # Determine the mode based on either an explicit flag or the non-flag args.\0A    if set -q _flag_print\0A        set mode print\0A    else if set -q _flag_list_signals\0A        set mode list\0A    else\0A        switch (count $argv)\0A            case 0\0A                set mode print\0A            case 1\0A                set mode clear\0A            case '*'\0A                if test $argv[1] = -\0A                    set -e argv[1]\0A                    set mode clear\0A                else\0A                    set mode set\0A                end\0A        end\0A    end\0A\0A    switch $mode\0A        case clear\0A            for sig in (string upper -- $argv | string replace -r '^SIG' '')\0A                if test -n \22$sig\22\0A                    functions -e __trap_handler_$sig\0A                end\0A            end\0A\0A        case set\0A            set -l cmd $argv[1]\0A            set -e argv[1]\0A\0A            for sig in (string upper -- $argv | string replace -r '^SIG' '')\0A                if test -n \22$sig\22\0A                    set -l sw --on-signal $sig\0A                    if string match -qi exit -- $sig\0A                        set sw --on-event fish_exit\0A                    end\0A                    echo \22function __trap_handler_$sig $sw; $cmd; end\22 | source\0A                else\0A                    return 1\0A                end\0A            end\0A\0A        case print\0A            set -l names\0A            if set -q argv[1]\0A                set names $argv\0A            else\0A                set names (functions -a | string split ',' | string match \22__trap_handler_*\22 | string replace '__trap_handler_' '')\0A            end\0A\0A            for sig in (string upper -- $names | string replace -r '^SIG' '')\0A                if test -n \22$sig\22\0A                    functions __trap_handler_$sig\0A                    echo \22\22\0A                else\0A                    return 1\0A                end\0A            end\0A\0A        case list\0A            kill -l\0A    end\0Aend\0A", align 1
