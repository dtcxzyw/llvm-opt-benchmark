ys ES2018.Intl ES2018.Promise ES2018.RegExp ESNext.AsyncIterable ESNext.Array ESNext.Intl ESNext.Symbol\22 -d \22List of library files to be included in the compilation\22\0Acomplete -c tsc -l listEmittedFiles -d \22Print names of generated files part of the compilation\22\0Acomplete -c tsc -l listFiles -d \22Print names of files part of the compilation\22\0A\0Acomplete -c tsc -l locale -x -a \22(\0A    printf '%s\\t%s\\n' en 'English (US)'\0A    printf '%s\\t%s\\n' cs Czech\0A    printf '%s\\t%s\\n' de German\0A    printf '%s\\t%s\\n' es Spanish\0A    printf '%s\\t%s\\n' fr French\0A    printf '%s\\t%s\\n' it Italian\0A    printf '%s\\t%s\\n' ja Japanese\0A    printf '%s\\t%s\\n' ko Korean\0A    printf '%s\\t%s\\n' pl Polish\0A    printf '%s\\t%s\\n' pt-BR 'Portuguese(Brazil)'\0A    printf '%s\\t%s\\n' ru Russian\0A    printf '%s\\t%s\\n' tr Turkish\0A    printf '%s\\t%s\\n' zh-CN 'Simplified Chinese'\0A    printf '%s\\t%s\\n' zh-TW 'Traditional Chinese'\0A)\22 -d \22The locale to use to show error messages, e.g. en-us\22\0A\0Acomplete -c tsc -l mapRoot -d \22Specify the location where debugger should locate map files instead of generated locations\22\0Acomplete -c tsc -l maxNodeModuleJsDepth -d \22The maximum folder depth used for checking JavaScript files from node_modules\22\0Acomplete -c tsc -s m -l module -x -a \22None CommonJS AMD System UMD ES6 ES2015 ESNext\22 -d \22Specify module code generation\22\0Acomplete -c tsc -l moduleResolution -x -a \22Node Classic\22 -d \22Determine how modules get resolved\22\0A\0Acomplete -c tsc -l newLine -x -a \22(\0A    printf '%s\\t%s\\n' crlf windows\0A    printf '%s\\t%s\\n' lf unix\0A)\22 -d \22Use the specified end of line sequence to be used when emitting files\22\0A\0Acomplete -c tsc -l noEmit -d \22Do not emit outputs\22\0Acomplete -c tsc -l noEmitHelpers -d \22Disable generating custom helper functions in compiled output\22\0Acomplete -c tsc -l noEmitOnError -d \22Do not emit outputs if any errors were reported\22\0Acomplete -c tsc -l noErrorTruncation -d \22Do not truncate error messages\22\0Acomplete -c tsc -l noFallthroughCasesInSwitch -d \22Report errors for fallthrough cases in switch statement\22\0Acomplete -c tsc -l noImplicitAny -d \22Raise error on expressions and declarations with an implied any type\22\0Acomplete -c tsc -l noImplicitReturns -d \22Report an error for codepaths that do not return in a function\22\0Acomplete -c tsc -l noImplicitThis -d \22Raise error on this expressions with an implied any type\22\0Acomplete -c tsc -l noImplicitUseStrict -d \22Do not emit \\\22use strict\\\22 directives in module output\22\0Acomplete -c tsc -l noLib -d \22Do not include the default library file (lib.d.ts)\22\0Acomplete -c tsc -l noResolve -d \22Do not add triple-slash references or module import targets to the list of compiled files\22\0Acomplete -c tsc -l noStrictGenericChecks -d \22Disable strict checking of generic signatures in function types\22\0Acomplete -c tsc -l noUnusedLocals -d \22Report errors on unused locals\22\0Acomplete -c tsc -l noUnusedParameters -d \22Report errors on unused parameters\22\0Acomplete -c tsc -l outDir -d \22Redirect output structure to the directory\22\0Acomplete -c tsc -l outFile -d \22Concatenate and emit output to single file\22\0Acomplete -c tsc -l preserveConstEnums -d \22Do not erase const enum declarations in generated code\22\0Acomplete -c tsc -l preserveSymlinks -d \22Disable resolving symlinks to their realpath\22\0Acomplete -c tsc -l preserveWatchOutput -d \22Disable wiping the console in watch mode\22\0Acomplete -c tsc -l pretty -d \22Stylize errors and messages using color and context\22\0Acomplete -c tsc -s p -l project -d \22Compile a project given a valid configuration file\22\0Acomplete -c tsc -l removeComments -d \22Remove all comments except copy-right header comments beginning with /*!\22\0Acomplete -c tsc -l resolveJsonModule -d \22Include modules imported with .json extension\22\0Acomplete -c tsc -l rootDir -d \22Specifies the root directory of input files\22\0Acomplete -c tsc -l showConfig -d \22Print the final configuration instead of building\22\0Acomplete -c tsc -l skipLibCheck -d \22Skip type checking of all declaration files (*.d.ts)\22\0Acomplete -c tsc -l sourceMap -d \22Generates corresponding .map file\22\0Acomplete -c tsc -l sourceRoot -d \22Specify the root path for debuggers to find the reference source code\22\0Acomplete -c tsc -l strict -d \22Enable all strict type checking options\22\0Acomplete -c tsc -l strictBindCallApply -d \22Enable stricter checking of the bind, call, and apply methods on functions\22\0Acomplete -c tsc -l strictFunctionTypes -d \22Disable bivariant parameter checking for function types\22\0Acomplete -c tsc -l strictPropertyInitialization -d \22Ensure non-undefined class properties are initialized in the constructor\22\0Acomplete -c tsc -l strictNullChecks -d \22When type checking, take into account null and undefined\22\0Acomplete -c tsc -l suppressExcessPropertyErrors -d \22Suppress excess property checks for object literals\22\0Acomplete -c tsc -l suppressImplicitAnyIndexErrors -d \22Suppress --noImplicitAny errors for indexing objects lacking index signatures\22\0A\0Acomplete -c tsc -s t -l target -x -a \22(\0A    printf '%s\\t%s\\n' ES3 'ECMAScript 3 (default)'\0A    printf '%s\\t%s\\n' ES5 'ECMAScript 5'\0A    printf '%s\\t%s\\n' ES6 'ECMAScript 6'\0A    printf '%s\\t%s\\n' ES2015 'ECMAScript 2015'\0A    printf '%s\\t%s\\n' ES2016 'ECMAScript 2016'\0A    printf '%s\\t%s\\n' ES2017 'ECMAScript 2017'\0A    printf '%s\\t%s\\n' ESNext 'Latest supported ECMAScript'\0A)\22 -d \22Specify ECMAScript target version\22\0A\0Acomplete -c tsc -l traceResolution -d \22Report module resolution log messages\22\0Acomplete -c tsc -l tsBuildInfoFile -d \22Specify what file to store incremental build information in\22\0Acomplete -c tsc -l types -d \22List of names of type definitions to include\22\0Acomplete -c tsc -l typeRoots -d \22List of folders to include type definitions from\22\0Acomplete -c tsc -s v -l version -d \22Print the compiler\E2\80\99s version\22\0Acomplete -c tsc -s w -l watch -d \22Run the compiler in watch mode\22\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2775 = private unnamed_addr constant [23 x i8] c"completions/tshark.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2776 = private unnamed_addr constant [3953 x i8] c"# tshark - Dump and analyze network traffic\0A\0A__fish_complete_wireshark tshark\0A\0Afunction __fish_tshark_protocols\0A    set -l tok (commandline -ct | string collect)\0A    set -l tok_param (string replace -r -- '^-O' '' $tok)\0A    command tshark -G protocols 2>/dev/null | while read -l -d \\t name shortname identifier\0A        printf \22%s%s\\t%s\\n\22 (string replace -r -- '(.+),[^,]*$' '$1,' $tok_param) $tok_no_comma $identifier $name\0A    end\0Aend\0A\0Acomplete -c tshark -s 2 -d 'Perform a two-pass analysis'\0A# This is fairly expensive, but only done upon the user pressing tab.\0Acomplete -c tshark -s e -d 'Add a field to the list of fields to display' -xa '(command tshark -G fields 2> /dev/null | awk -F\\t \\'{print $3\22\\t\22$2}\\')'\0Acomplete -c tshark -s E -d 'Set an option controlling the printing of fields' -xa '\0Abom=y\\t\22Prepend output with the UTF-8 byte order mark\22\0Aheader=y\\t\22Print a list of the selected field names\22\0Aseparator=\\t\22Set the separator character to use for fields\22\0Aoccurrence=\\t\22Select which occurrence to use for fields that have multiple: f=first, l=last, a=all\22\0Aaggregator=\\t\22Set the aggregator character to use for fields that have multiple occurrences\22\0Aquote=\\t\22Set the quote character to use to surround fields d=\\\22, s=\\', n=no quotes\22'\0A\0Acomplete -c tshark -s F -d 'Set the output capture file format' -xa '(command tshark -F 2>| string replace -rf \22\\s+(\\S+) - (.*)\22 \\'$1\\t$2\\')'\0Acomplete -c tshark -s G -d 'Print a glossary' -xa '(\0Aprintf \22help\\tList available report types\\n\22\0Acommand tshark -G help 2>/dev/null | string replace -rf \22\\s+-G (\\S+)\\s+(.*)\22 \\'$1\\t$2\\'\0A)'\0Acomplete -c tshark -s H -d 'Read a list of entries from a \22hosts\22 file' -r\0Acomplete -c tshark -s j -d 'Protocol match filter used for ek|json|jsonraw|pdml output file types' -x\0Acomplete -c tshark -s J -d 'Protocol match filter used, includes all child protocols' -x\0Acomplete -c tshark -s l -d 'Flush the standard output after the information for each packet is printed'\0Acomplete -c tshark -s O -d 'Show a detailed view of the comma-separated list of protocols' -xa '(__fish_tshark_protocols)'\0Acomplete -c tshark -s P -l print -d 'Decode and display packet summary or details'\0Acomplete -c tshark -s Q -d \22When capturing packets, don't display, on the standard error, the initial message\22\0Acomplete -c tshark -s S -d 'Set the line separator to be printed between packets' -x\0Acomplete -c tshark -s T -d 'Set the format of the output when viewing decoded packet data' -xa '\0Aek\\t\22Newline delimited JSON for bulk import into Elasticsearch\22\0Afields\\t\22The values of fields specified with the -e option, in a form specified by the -E option\22\0Ajson\\t\22JSON file format\22\0Ajsonraw\\t\22JSON file format including only raw hex-encoded packet data\22\0Apdml\\t\22Packet Details Markup Language, an XML-based format for the details of a decoded packet\22\0Aps\\t\22PostScript for a human-readable summary of each of the packets\22\0Apsml\\t\22Packet Summary Markup Language\22\0Atabs\\t\22Tab-separated human-readable one-line packet summaries\22\0Atext\\t\22Default\22'\0A\0Acomplete -c tshark -s U -d \22PDUs export according to given tap name\22 -xa '(\0A    printf \22%s\\tTap name\\n\22 (command tshark -U \22\22 2>| string replace -rf \22^tshark:\\s*\22 \22\22)[2..-1])'\0Acomplete -c tshark -s V -d 'Causes TShark to print a view of packet details'\0Acomplete -c tshark -s W -d 'Save extra information in the capture file if the format supports it' -xa n\0Acomplete -c tshark -s x -d 'Print hex and ASCII dumps of packet data'\0Acomplete -c tshark -s M -d 'Automatically reset internal session when reaching N packets' -x\0Acomplete -c tshark -l color -d 'Enable coloring of packets according to standard Wireshark color filters'\0Acomplete -c tshark -l no-duplicate-keys -d 'Merge duplicate keys in json output'\0Acomplete -c tshark -l elastic-mapping-filter -d 'Only put specified protocols in an ElasticSearch mapping file' -x # TODO\0Acomplete -c tshark -l export-objects -d 'Export all objects within a protocol into directory given destination directory' -x # TODO\0A", align 1
