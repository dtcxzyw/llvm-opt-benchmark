@anon.1d0b41a8d45d477c3029ec78f9b8b434.2440 = private unnamed_addr constant [2616 x i8] c"# Define the completions for the qjsc command\0A# QuickJS Compiler version 2021-03-27\0A# usage: qjsc [options] [files]\0A\0A# options are:\0A# -c          only output bytecode in a C file\0A# -e          output main() and bytecode in a C file (default = executable output)\0A# -o output   set the output filename\0A# -N cname    set the C name of the generated data\0A# -m          compile as Javascript module (default=autodetect)\0A# -D module_name         compile a dynamically loaded module or worker\0A# -M module_name[,cname] add initialization code for an external C module\0A# -x          byte swapped output\0A# -p prefix   set the prefix of the generated C names\0A# -S n        set the maximum stack size to 'n' bytes (default=262144)\0A# -flto       use link time optimization\0A# -fbignum    enable bignum extensions\0A# -fno-[date|eval|string-normalize|regexp|json|proxy|map|typedarray|promise|module-loader|bigint]\0A#             disable selected language features (smaller code size)\0A# from https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=quickjs 2021.03.27\0A\0Acomplete -c qjsc -s c -d 'Only output bytecode in a C file'\0Acomplete -c qjsc -s e -d 'Output main() and bytecode in a C file (default = executable output)'\0Acomplete -c qjsc -s o -r -d 'Set the output filename'\0Acomplete -c qjsc -s N -r -d 'Set the C name of the generated data'\0Acomplete -c qjsc -s m -d 'Compile as Javascript module (default=autodetect)'\0Acomplete -c qjsc -s D -r -d 'Compile a dynamically loaded module or worker'\0Acomplete -c qjsc -s M -r -d 'Add initialization code for an external C module'\0Acomplete -c qjsc -s x -d 'Byte swapped output'\0Acomplete -c qjsc -s p -r -d 'Set the prefix of the generated C names'\0Acomplete -c qjsc -s S -r -d 'Set the maximum stack size to 'n' bytes (default=262144)'\0Acomplete -c qjsc -o flto -d 'Use link time optimization'\0Acomplete -c qjsc -o fbignum -d 'Enable bignum extensions'\0Acomplete -c qjsc -o fno-date -d 'Disable the date extension'\0Acomplete -c qjsc -o fno-eval -d 'Disable the eval extension'\0Acomplete -c qjsc -o fno-string-normalize -d 'Disable the string normalize extension'\0Acomplete -c qjsc -o fno-regexp -d 'Disable the regexp extension'\0Acomplete -c qjsc -o fno-json -d 'Disable the JSON extension'\0Acomplete -c qjsc -o fno-proxy -d 'Disable the proxy extension'\0Acomplete -c qjsc -o fno-map -d 'Disable the Map extension'\0Acomplete -c qjsc -o fno-typedarray -d 'Disable the Typed Array extension'\0Acomplete -c qjsc -o fno-promise -d 'Disable the Promise extension'\0Acomplete -c qjsc -o fno-module-loader -d 'Disable the module loader extension'\0Acomplete -c qjsc -o fno-bigint -d 'Disable the BigInt extension'\0A", align 1
