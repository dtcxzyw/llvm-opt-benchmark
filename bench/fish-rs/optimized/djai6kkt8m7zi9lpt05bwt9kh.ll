@anon.1d0b41a8d45d477c3029ec78f9b8b434.1496 = private unnamed_addr constant [1298 x i8] c"function __fish_dmidecode_complete_keywords\0A    dmidecode -s 2>&1 1>/dev/null | string match -rg '^\\s+(.*)'\0Aend\0A\0Afunction __fish_dmidecode_complete_types\0A    dmidecode -t 2>&1 1>/dev/null | string match -rg '^\\s+(.*)'\0Aend\0A\0Acomplete -c dmidecode -f\0Acomplete -c dmidecode -s d -l dev-mem -r -d 'Memory device file'\0Acomplete -c dmidecode -s q -l quiet -d 'Be less verbose'\0Acomplete -c dmidecode -l no-quirks -d 'Decode everything exactly as it is'\0Acomplete -c dmidecode -s s -l string -xa '(__fish_dmidecode_complete_keywords)' -d 'Only display specified value'\0Acomplete -c dmidecode -s t -l type -xa '(__fish_dmidecode_complete_types)' -d 'Only display entries of specified type'\0Acomplete -c dmidecode -s H -l handle -x -d 'Only display specified handle'\0Acomplete -c dmidecode -s u -l dump -d 'Do not decode the entries'\0Acomplete -c dmidecode -l dump-bin -r -d 'Dump DMI data to a file'\0Acomplete -c dmidecode -l from-dump -r -d 'Read DMI data generated using --dump-bin'\0Acomplete -c dmidecode -l no-sysfs -d 'Do not attempt to read DMI data from sysfs files'\0Acomplete -c dmidecode -l oem-string -x -d 'Only display the value of the OEM string number N'\0Acomplete -c dmidecode -s h -l help -d 'Display usage information and exit'\0Acomplete -c dmidecode -s V -l version -d 'Display the version and exit'\0A", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1497 = private unnamed_addr constant [20 x i8] c"completions/dnf.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.1498 = private unnamed_addr constant [27085 x i8] c"#\0A# Completions for the dnf command\0A#\0A\0Afunction __dnf_is_dnf5\0A    path resolve -- $PATH/dnf | path filter | string match -q -- '*/dnf5'\0Aend\0A\0Afunction __dnf_list_installed_packages\0A    dnf repoquery --cacheonly \22$cur*\22 --qf \22%{name}\\n\22 --installed </dev/null\0Aend\0A\0Afunction __dnf_list_available_packages\0A    set -l tok (commandline -ct | string collect)\0A    set -l files (__fish_complete_suffix .rpm)\0A    if string match -q -- '*/*' $tok\0A        # Fast path - package names can't contain slashes, so show files.\0A        string join -- \\n $files\0A        return\0A    end\0A    set -l results\0A    if __dnf_is_dnf5\0A        # dnf5 provides faster completions than repoquery, but does not maintain the\0A        # same sqlite db as dnf4\0A        set results (dnf --complete=2 dnf install \22$tok*\22)\0A    else if type -q sqlite3\0A        # dnf --cacheonly list --available gives a list of non-installed packages dnf is aware of,\0A        # but it is slow as molasses. Unfortunately, sqlite3 is not available oob (Fedora Server 32).\0A\0A        # This schema is bad, there is only a \22pkg\22 field with the full\0A        #    packagename-version-release.fedorarelease.architecture\0A        # tuple. We are only interested in the packagename.\0A        set results (sqlite3 /var/cache/dnf/packages.db \22SELECT pkg FROM available WHERE pkg LIKE '$tok%'\22 2>/dev/null |\0A            string replace -r -- '-[^-]*-[^-]*$' '')\0A    else\0A        # In some cases dnf will ask for input (e.g. to accept gpg keys).\0A        # Connect it to /dev/null to try to stop it.\0A        set results (dnf repoquery --cacheonly \22$tok*\22 --qf \22%{name}\\n\22 --available </dev/null 2>/dev/null)\0A    end\0A    if set -q results[1]\0A        set results (string match -r -- '.*\\\\.rpm$' $files) $results\0A    else\0A        set results $files\0A    end\0A    string join \\n $results\0Aend\0A\0Afunction __dnf_list_transactions\0A    if not __dnf_is_dnf5 && type -q sqlite3\0A        sqlite3 /var/lib/dnf/history.sqlite \22SELECT id, cmdline FROM trans\22 2>/dev/null | string replace \22|\22 \\t\0A    end\0Aend\0A\0A# Alias\0Acomplete -c dnf -n __fish_use_subcommand -xa alias -d \22Manage aliases\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from alias\22 -xa add -d \22Add a new alias\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from alias\22 -xa list -d \22Lists all defined aliases\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from alias\22 -xa delete -d \22Delete an alias\22\0A\0A# Autoremove\0Acomplete -c dnf -n __fish_use_subcommand -xa autoremove -d \22Removes unneeded packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from autoremove\22 -xa \22(__dnf_list_installed_packages)\22\0A\0A# Check\0Acomplete -c dnf -n __fish_use_subcommand -xa check -d \22Check for problems in packagedb\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from check\22 -l dependencies -d \22Checks dependencies\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from check\22 -l duplicates -d \22Checks duplicates\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from check\22 -l obsoleted -d \22Checks obsoleted\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from check\22 -l provides -d \22Checks provides\22\0A\0A# Check-Update\0Acomplete -c dnf -n __fish_use_subcommand -xa check-update -d \22Checks for updates\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from check-update\22 -l changelogs\0A\0A# Clean\0Acomplete -c dnf -n __fish_use_subcommand -xa clean -d \22Clean up cache directory\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from clean\22 -xa dbcache -d \22Removes the database cache\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from clean\22 -xa expire-cache -d \22Marks the repository metadata expired\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from clean\22 -xa metadata -d \22Removes repository metadata\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from clean\22 -xa packages -d \22Removes any cached packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from clean\22 -xa all -d \22Removes all cache\22\0A\0A# Distro-sync\0Acomplete -c dnf -n __fish_use_subcommand -xa distro-sync -d \22Synchronizes packages to match the latest\22\0A\0A# Downgrade\0Acomplete -c dnf -n __fish_use_subcommand -xa downgrade -d \22Downgrades the specified package\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from downgrade\22 -xa \22(__dnf_list_installed_packages)\22\0A\0A# Group\0Acomplete -c dnf -n __fish_use_subcommand -xa group -d \22Manage groups\22\0A\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa summary -d \22Display overview of installed and available groups\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa info -d \22Display package list of a group\22\0A# Group install\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa install -d \22Install group\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from install\22 -l with-optional -d \22Include optional packages\22\0A# Group list\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa list -d \22List groups\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from list\22 -l installed -d \22List installed groups\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from list\22 -l available -d \22List available groups\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from list\22 -l hidden -d \22List hidden groups\22\0A# Group remove\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa remove -d \22Remove group\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from remove\22 -l with-optional -d \22Include optional packages\22\0A\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa upgrade -d \22Upgrade group\22\0A# Group mark\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and not __fish_seen_subcommand_from mark\22 -xa mark -d \22Marks group without manipulating packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from mark\22 -xa install -d \22Mark group installed without installing packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from group; and __fish_seen_subcommand_from mark\22 -xa remove -d \22Mark group removed without removing packages\22\0A\0A# Help\0Acomplete -c dnf -n __fish_use_subcommand -xa help -d \22Display help and exit\22\0A\0A# History\0Acomplete -c dnf -n __fish_use_subcommand -xa history -d \22View and manage past transactions\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa list -d \22Lists all transactions\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa info -d \22Describe the given transactions\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa redo -d \22Redoes the specified transaction\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa rollback -d \22Undo all transactions performed after the specified transaction\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa undo -d \22Undoes the specified transaction\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from history\22 -xa userinstalled -d \22Lists all user installed packages\22\0A\0Afor i in info redo rollback undo\0A    complete -c dnf -n \22__fish_seen_subcommand_from history; and  __fish_seen_subcommand_from $i\22 -xa \22(__dnf_list_transactions)\22\0Aend\0A\0A# Info\0Acomplete -c dnf -n __fish_use_subcommand -xa info -d \22Describes the given package\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from info; and not __fish_seen_subcommand_from history\22 -k -xa \22(__dnf_list_available_packages)\22\0A\0A# Install\0Acomplete -c dnf -n __fish_use_subcommand -xa install -d \22Install package\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from install\22 -k -xa \22(__dnf_list_available_packages)\22\0A\0A# List\0Acomplete -c dnf -n __fish_use_subcommand -xa list -d \22Lists all packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l all -d \22Lists all packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l installed -d \22Lists installed packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l available -d \22Lists available packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l extras -d \22Lists installed packages that are not in any known repository\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l obsoletes -d \22List installed obsoleted packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l recent -d \22List recently added packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l upgrades -d \22List available upgrades\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from list\22 -l autoremove -d \22List packages which will be removed by autoremove\22\0A\0A# Makecache\0Acomplete -c dnf -n __fish_use_subcommand -xa makecache -d \22Downloads and caches metadata for all known repos\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from makecache\22 -l timer -d \22Instructs DNF to be more resource-aware\22\0A\0A# Mark\0Acomplete -c dnf -n __fish_use_subcommand -xa mark -d \22Mark packages\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from mark\22 -xa install -d \22Mark package installed\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from mark\22 -xa remove -d \22Unmarks installed package\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from mark\22 -xa group -d \22Mark installed by group\22\0A\0A# Module\0Acomplete -c dnf -n __fish_use_subcommand -xa module -d \22Manage modules\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa install -d \22Install module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa update -d \22Update modules\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa remove -d \22Remove module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa enable -d \22Enable a module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa disable -d \22Disable a module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa reset -d \22Reset module state\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa list -d \22List modules\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module; and __fish_seen_subcommand_from list\22 -l all -d \22Lists all module \22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module; and __fish_seen_subcommand_from list\22 -l enabled -d \22Lists enabled module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module; and __fish_seen_subcommand_from list\22 -l disabled -d \22Lists disabled module\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module; and __fish_seen_subcommand_from list\22 -l installed -d \22List  installed modules\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module\22 -xa info -d \22Print module information\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from module; and __fish_seen_subcommand_from info\22 -l profile -d \22Print module profiles information\22\0A\0A# Offline-distrosync\0Acomplete -c dnf -n __fish_use_subcommand -xa offline-distrosync -d \22Synchronizes packages to match the latest\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from offline-distrosync\22 -xa download -d \22Download updates for offline upgrade\22\0Acomplete -c dnf -n \22__fish_seen_subcommand_from offline-distrosync\22 -xa clean -