reboot flag was set'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a ps -d 'List running processes still using deleted files'\0A\0A#  Subcommands:\0A\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a subcommand -d 'Lists available subcommands'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a \22$__fish_zypper_subcommands\22\0A\0A# Global Options:\0A\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l help -s h -d Help\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l version -s V -d 'Output the version number'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l promptids -d 'Output a list of zypper user prompts'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l config -r -s c -d 'Use specified config file instead of the default'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l userdata -d 'User defined transaction id used in history and plugins'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l quiet -s q -d 'Suppress normal output, print only error messages'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l verbose -s v -d 'Increase verbosity'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l no-abbrev -s A -d 'Do not abbreviate text in tables'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l table-style -s s -d 'Table style (integer)'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l rug-compatible -s r -d 'Turn on rug compatibility'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l non-interactive -s n -d 'Do not ask anything, use default answers automatically'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l non-interactive-include-reboot-patches -d 'Do not treat patches as interactive, which have the rebootSuggested-flag set'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l xmlout -s x -d 'Switch to XML output'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l ignore-unknown -s i -d 'Ignore unknown packages'\0Acomplete -c zypper -n __fish_zypper_no_subcommand -l ter