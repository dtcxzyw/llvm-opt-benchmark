@anon.1d0b41a8d45d477c3029ec78f9b8b434.3068 = private unnamed_addr constant [53445 x i8] c"# completion for zypper\0A\0Aset -g __fish_zypper_all_commands shell sh repos lr addrepo ar removerepo rr renamerepo nr modifyrepo mr refresh ref clean cc services ls addservice as modifyservice ms removeservice rs refresh-services refs install in remove rm verify ve source-install si install-new-recommends inr update up list-updates lu patch list-patches lp dist-upgrade dup patch-check pchk search se info if patch-info pattern-info product-info patches pch packages pa patterns pt products pd what-provides wp addlock al removelock rl locks ll cleanlocks cl locales lloc addlocale aloc removelocale rloc versioncmp vcmp targetos tos licenses download source-download needs-rebooting ps\0Aset -g __fish_zypper_subcommands (zypper -q subcommand | string split ', ')\0Aset -g __fish_zypper_pkg_commands install in remove rm info if addlock al removelock rl source-install si update up download\0Aset -g __fish_zypper_repo_commands repos lr removerepo rr renamerepo nr modifyrepo mr refresh ref clean cc packages pa patches pch patterns pt products pd\0Aset -g __fish_zypper_file_commands install in addrepo ar\0Aset -g __fish_zypper_package_types package patch pattern product srcpackage application\0Aset -g __fish_zypper_download_modes only in-advance in-heaps as-needed\0Aset -g __fish_zypper_solver_focus_modes Job Installed Update\0A\0Afunction __fish_zypper_cmd_in_array\0A    for i in (commandline -pcx)\0A        # -- is used to provide no options for contains\0A        # (if $i is equal to --optname without -- will be error)\0A        if contains -- $i $argv\0A            return 0\0A        end\0A    end\0A\0A    return 1\0Aend\0A\0Afunction __fish_zypper_no_subcommand\0A    not __fish_zypper_cmd_in_array $__fish_zypper_all_commands $__fish_zypper_subcommands\0Aend\0A\0Afunction __fish_zypper_use_pkg\0A    __fish_zypper_cmd_in_array $__fish_zypper_pkg_commands\0Aend\0A\0Afunction __fish_zypper_use_repo\0A    __fish_zypper_cmd_in_array $__fish_zypper_repo_commands\0Aend\0A\0Afunction __fish_zypper_not_use_file\0A    not __fish_zypper_cmd_in_array $__fish_zypper_file_commands\0Aend\0A\0Afunction __fish_zypper_print_repos\0A    argparse e/enabled -- $argv\0A    set -q _flag_e; and set -l enabled -E\0A    set -l zypper_lr (zypper -t lr $enabled)\0A    # Because spaces and special characters are allowed in repo aliases (bad\0A    # practice though, but allowed), it's impossible to parse the aliases from\0A    # zypper's output correctly. So we fetch them from the repo files.\0A    set -l repos (cat /etc/zypp/repos.d/*.repo | string replace -rf '^\\[(.+)\\]$' '$1')\0A    # Then use the aliases to match their names from zypper's output.\0A    string replace -rf '^[\\d\\s]+\\| ('(string escape -n $repos | string join \\|)') +\\| (.+)\\s+\\|.*\\|.*\\|.*$' '$1\\t$2' -- $zypper_lr\0Aend\0A\0Afunction __fish_zypper_print_packages\0A    set -l repo\0A    set -l type\0A    set -l idx\0A    set -l args (commandline -pxc)\0A    while set -q args[1]\0A        switch $args[1]\0A            case -t --type\0A                set -e args[1]\0A                if contains -- $args[1] $__fish_zypper_package_types\0A                    set type $args[1]\0A                end\0A            case -r --repo --from\0A                set -e args[1]\0A                if contains -- $args[1] (__fish_zypper_print_repos -e | string replace -r '^(.+)\\t.*$' '$1')\0A                    set repo $repo $args[1]\0A                end\0A        end\0A        set -e args[1]\0A    end\0A\0A    if __fish_zypper_is_subcommand_rm\0A        set idx /var/cache/zypp/solv/@System/solv.idx\0A    else if test -z \22$repo\22\0A        set idx /var/cache/zypp/solv/*/solv.idx\0A    else\0A        set idx /var/cache/zypp/solv/$repo/solv.idx\0A    end\0A\0A    if test -z \22$type\22\0A        cat $idx | string replace -rf '^([^\\t]+)\\t.*\\t.*$' '$1'\0A    else if test \22$type\22 = package\0A        cat $idx | string match -rv '^('(string join \\| $__fish_zypper_package_types)'):' | string replace -rf '^([^\\t]+)\\t.*\\t.*$' '$1'\0A    else\0A        cat $idx | string replace -rf \22^$type\22':([^\\t]+)\\t.*\\t.*$' '$1\\t'\22$type\22\0A    end\0Aend\0A\0Acomplete -n __fish_zypper_use_pkg -c zypper -a '(__fish_zypper_print_packages)' -d Package\0Acomplete -f -n __fish_zypper_use_repo -c zypper -a '(__fish_zypper_print_repos)' -d Repo\0Acomplete -f -n __fish_zypper_not_use_file -c zypper\0A\0A# Commands:\0A\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'help ?' -d 'Print help'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'shell sh' -d 'Accept multiple commands at once'\0A\0A#  Repository Management:\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'repos lr' -d 'List all defined repositories'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'addrepo ar' -d 'Add a new repository'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'removerepo rr' -d 'Remove specified repository'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'renamerepo nr' -d 'Rename specified repository'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'modifyrepo mr' -d 'Modify specified repository'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'refresh ref' -d 'Refresh all repositories'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'clean cc' -d 'Clean local caches'\0A\0A#  Service Management:\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'services ls' -d 'List all defined services'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'addservice as' -d 'Add a new service'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'modifyservice ms' -d 'Modify specified service'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'removeservice rs' -d 'Remove specified service'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'refresh-services refs' -d 'Refresh all services'\0A\0A#  Software Management:\0Acomplete -n __fish_zypper_no_subcommand -c zypper -a 'install in' -d 'Install packages'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'remove rm' -d 'Remove packages'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'verify ve' -d 'Verify integrity of package dependencies'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'source-install si' -d 'Install source packages and their build dependencies'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'install-new-recommends inr' -d 'Install newly added packages recommended by installed packages'\0A\0A#  Update Management:\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'update up' -d 'Update installed packages with newer versions'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'list-updates lu' -d 'List available updates'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a patch -d 'Install needed patches'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'list-patches lp' -d 'List needed patches'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'dist-upgrade dup' -d 'Perform a distribution upgrade'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'patch-check pchk' -d 'Check for patches'\0A\0A#  Querying:\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'search se' -d 'Search for packages matching a pattern'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'info if' -d 'Show full information for specified packages'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a patch-info -d 'Show full information for specified patches'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a pattern-info -d 'Show full information for specified patterns'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a product-info -d 'Show full information for specified products'\0Acomplete -f -n __fish_zypper_no_subcommand -c zypper -a 'patches pch' -d 'List all available patches'\0Acomplete -f