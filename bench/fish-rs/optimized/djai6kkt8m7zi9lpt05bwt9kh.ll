@anon.1d0b41a8d45d477c3029ec78f9b8b434.2060 = private unnamed_addr constant [2672 x i8] c"# Completion for: MATLAB R2021b\0Afunction __fish_matlabcheck_no_desktop_nodesktop_opts\0A    not __fish_seen_argument --old desktop --old nodesktop\0A    return $status\0Aend\0A\0Afunction __fish_matlabcheck_no_batch_r_opts\0A    not __fish_seen_argument --old batch --short r\0A    return $status\0Aend\0A\0Acomplete -c matlab -s h -l help -d 'Show help'\0A\0A# Mode options\0Acomplete -c matlab -o desktop -n __fish_matlabcheck_no_desktop_nodesktop_opts -d 'Start without a controlling terminal'\0Acomplete -c matlab -o nodesktop -n __fish_matlabcheck_no_desktop_nodesktop_opts -d 'Run the JVM software without opening the desktop'\0Acomplete -c matlab -o nojvm -d 'Start without the JVM software'\0A\0A# Display options\0Acomplete -c matlab -o noFigureWindows -d 'Disable the display of figure windows'\0Acomplete -c matlab -o nosplash -d 'Don\\'t display the splash screen during startup'\0Acomplete -c matlab -o nodisplay -d 'Start the JVM software without starting desktop'\0Acomplete -c matlab -o display -x -d 'Send X commands to X Window Server display xDisp'\0A\0A# Set initial working folder\0Acomplete -c matlab -o sd -r -d 'Set the folder'\0Acomplete -c matlab -o useStartupFolderPref -d 'Change the folder to the Initial working folder preference'\0A\0A# Debugging options\0Acomplete -c matlab -o logfile -r -a '(__fish_complete_suffix .log)' -d 'Copy Command Window output into filename'\0Acomplete -c matlab -s n -d 'Display the environment variables/arguments passed to the executable'\0Acomplete -c matlab -s e -d 'Display all environment variables and their values to standard output'\0Acomplete -c matlab -s Dgdb -x -d 'Start in debug mode'\0Acomplete -c matlab -s Dlldb -x -d 'Start in debug mode'\0Acomplete -c matlab -s Ddbx -x -d 'Start in debug mode'\0Acomplete -c matlab -o jdb -x -d 'Enable use of the Java debugger'\0Acomplete -c matlab -o debug -d 'Display information for debugging X-based problems'\0A\0A# Execute MATLAB script or function\0Acomplete -c matlab -o batch -x -n __fish_matlabcheck_no_batch_r_opts -d 'Execute script, statement, or function non-interactively'\0Acomplete -c matlab -s r -x -n __fish_matlabcheck_no_batch_r_opts -d 'Execute the statement'\0A\0A# Use single computational thread\0Acomplete -c matlab -o singleCompThread -d 'Limit to a single computational thread'\0A\0A# Disable searching custom Java class path\0Acomplete -c matlab -o nouserjavapath -d 'Disable use of javaclasspath.txt and javalibrarypath.txt files'\0A\0A# OpenGL library options\0Acomplete -c matlab -o softwareopengl -d 'Force to start with software OpenGL libraries'\0Acomplete -c matlab -o nosoftwareopengl -d 'Disable auto-selection of OpenGL software'\0A\0A# Specify license file\0Acomplete -c matlab -s c -r -d 'Use the specified license file'\0A", align 1
