@anon.1d0b41a8d45d477c3029ec78f9b8b434.2104 = private unnamed_addr constant [716 x i8] c"function __fish_mkpasswd_methods --description \22Complete hashing methods for mkpasswd\22\0A    mkpasswd -m help | tail -n +2 | string replace -r '^(\\S+)\\s+(\\S.*)' '$1\\t$2'\0A    echo -e \22help\\tList available methods\22\0Aend\0A\0Acomplete -c mkpasswd -f\0Acomplete -c mkpasswd -s S -l salt -x -d 'Use given string as salt'\0Acomplete -c mkpasswd -s R -l rounds -x -d 'Use given number of rounds'\0Acomplete -c mkpasswd -s m -l method -xa \22(__fish_mkpasswd_methods)\22 -d 'Compute the password using the given method'\0Acomplete -c mkpasswd -s 5 -d 'Like --method=md5crypt'\0Acomplete -c mkpasswd -s P -l password-fd -x -d 'Read the password from the given file descriptor'\0Acomplete -c mkpasswd -s s -l stdin -d 'Read the password from stdin'\0A", align 1
