@anon.1d0b41a8d45d477c3029ec78f9b8b434.2801 = private unnamed_addr constant [21 x i8] c"completions/uniq.fish", align 1
@anon.1d0b41a8d45d477c3029ec78f9b8b434.2802 = private unnamed_addr constant [1385 x i8] c"if uniq --version >/dev/null 2>/dev/null\0A    complete -c uniq -s c -l count -d \22Print number of occurrences\22\0A    complete -c uniq -s d -l repeated -d \22Only print duplicates\22\0A    complete -c uniq -s D -l all-repeated -d \22Remove non-duplicate lines\22 -f -x -a \22\0A\09\09none\\t'Remove none-duplicate lines'\0A\09\09prepend\\t'Remove non-duplicate lines and print an empty line before each non-duplicate'\0A\09\09separate\\t'Remove non-duplicate lines and print an empty line between each non-duplicate'\0A\09\22\0A    complete -c uniq -s f -l skip-fields -d \22Avoid comparing first N fields\22 -r\0A    complete -c uniq -s i -l ignore-case -d \22Case insensitive\22\0A    complete -c uniq -s s -l skip-chars -d \22Avoid comparing first N characters\22 -r\0A    complete -c uniq -s u -l unique -d \22Only print unique lines\22\0A    complete -c uniq -s w -l check-chars -d \22Compare only specified number of characters\22 -r\0A    complete -c uniq -l help -d \22Display help and exit\22\0A    complete -c uniq -l version -d \22Display version and exit\22\0Aelse # BSD\0A    complete -c uniq -s c -d 'Precede each output line with count of its occurrence'\0A    complete -c uniq -s d -d 'Only print duplicates'\0A    complete -c uniq -s f -d 'Avoid comparing first N fields' -x\0A    complete -c uniq -s s -d 'Avoid comparing first N characters' -x\0A    complete -c uniq -s u -d 'Only print unique lines'\0A    complete -c uniq -s i -d 'Case insensitive comparison'\0Aend\0A", align 1
