@.str = private unnamed_addr constant [68 x i8] c"[THISMODULE] reads a [REF].pdb[ref] (or [REF].gro[ref]) file, reads\00", align 1
@.str.1 = private unnamed_addr constant [67 x i8] c"some database files, adds hydrogens to the molecules and generates\00", align 1
@.str.2 = private unnamed_addr constant [70 x i8] c"coordinates in GROMACS (GROMOS), or optionally [REF].pdb[ref], format\00", align 1
@.str.3 = private unnamed_addr constant [34 x i8] c"and a topology in GROMACS format.\00", align 1
@.str.4 = private unnamed_addr constant [72 x i8] c"These files can subsequently be processed to generate a run input file.\00", align 1
@.str.5 = private unnamed_addr constant [6 x i8] c"[PAR]\00", align 1
@.str.6 = private unnamed_addr constant [57 x i8] c"[THISMODULE] will search for force fields by looking for\00", align 1
@.str.7 = private unnamed_addr constant [72 x i8] c"a [TT]forcefield.itp[tt] file in subdirectories [TT]<forcefield>.ff[tt]\00", align 1
@.str.8 = private unnamed_addr constant [70 x i8] c"of the current working directory and of the GROMACS library directory\00", align 1
@.str.9 = private unnamed_addr constant [74 x i8] c"as inferred from the path of the binary or the [TT]GMXLIB[tt] environment\00", align 1
@.str.10 = private unnamed_addr constant [10 x i8] c"variable.\00", align 1
@.str.11 = private unnamed_addr constant [52 x i8] c"By default the forcefield selection is interactive,\00", align 1
@.str.12 = private unnamed_addr constant [73 x i8] c"but you can use the [TT]-ff[tt] option to specify one of the short names\00", align 1
@.str.13 = private unnamed_addr constant [78 x i8] c"in the list on the command line instead. In that case [THISMODULE] just looks\00", align 1
@.str.14 = private unnamed_addr constant [57 x i8] c"for the corresponding [TT]<forcefield>.ff[tt] directory.\00", align 1
@.str.15 = private unnamed_addr constant [63 x i8] c"After choosing a force field, all files will be read only from\00", align 1
@.str.16 = private unnamed_addr constant [41 x i8] c"the corresponding force field directory.\00", align 1
@.str.17 = private unnamed_addr constant [69 x i8] c"If you want to modify or add a residue types, you can copy the force\00", align 1
@.str.18 = private unnamed_addr constant [67 x i8] c"field directory from the GROMACS library directory to your current\00", align 1
@.str.19 = private unnamed_addr constant [65 x i8] c"working directory. If you want to add new protein residue types,\00", align 1
@.str.20 = private unnamed_addr constant [74 x i8] c"you will need to modify [TT]residuetypes.dat[tt] in the library directory\00", align 1
@.str.21 = private unnamed_addr constant [65 x i8] c"or copy the whole library directory to a local directory and set\00", align 1
@.str.22 = private unnamed_addr constant [71 x i8] c"the environment variable [TT]GMXLIB[tt] to the name of that directory.\00", align 1
@.str.23 = private unnamed_addr constant [71 x i8] c"Check Chapter 5 of the manual for more information about file formats.\00", align 1
@.str.24 = private unnamed_addr constant [75 x i8] c"Note that a [REF].pdb[ref] file is nothing more than a file format, and it\00", align 1
@.str.25 = private unnamed_addr constant [64 x i8] c"need not necessarily contain a protein structure. Every kind of\00", align 1
@.str.26 = private unnamed_addr constant [70 x i8] c"molecule for which there is support in the database can be converted.\00", align 1
@.str.27 = private unnamed_addr constant [70 x i8] c"If there is no support in the database, you can add it yourself.[PAR]\00", align 1
@.str.28 = private unnamed_addr constant [68 x i8] c"The program has limited intelligence, it reads a number of database\00", align 1
@.str.29 = private unnamed_addr constant [70 x i8] c"files, that allow it to make special bonds (Cys-Cys, Heme-His, etc.),\00", align 1
@.str.30 = private unnamed_addr constant [67 x i8] c"if necessary this can be done manually. The program can prompt the\00", align 1
@.str.31 = private unnamed_addr constant [66 x i8] c"user to select which kind of LYS, ASP, GLU, CYS or HIS residue is\00", align 1
@.str.32 = private unnamed_addr constant [70 x i8] c"desired. For Lys the choice is between neutral (two protons on NZ) or\00", align 1
@.str.33 = private unnamed_addr constant [66 x i8] c"protonated (three protons, default), for Asp and Glu unprotonated\00", align 1
@.str.34 = private unnamed_addr constant [66 x i8] c"(default) or protonated, for His the proton can be either on ND1,\00", align 1
@.str.35 = private unnamed_addr constant [71 x i8] c"on NE2 or on both. By default these selections are done automatically.\00", align 1
@.str.36 = private unnamed_addr constant [54 x i8] c"For His, this is based on an optimal hydrogen bonding\00", align 1
@.str.37 = private unnamed_addr constant [69 x i8] c"conformation. Hydrogen bonds are defined based on a simple geometric\00", align 1
@.str.38 = private unnamed_addr constant [66 x i8] c"criterion, specified by the maximum hydrogen-donor-acceptor angle\00", align 1
@.str.39 = private unnamed_addr constant [65 x i8] c"and donor-acceptor distance, which are set by [TT]-angle[tt] and\00", align 1
@.str.40 = private unnamed_addr constant [33 x i8] c"[TT]-dist[tt] respectively.[PAR]\00", align 1
@.str.41 = private unnamed_addr constant [70 x i8] c"The protonation state of N- and C-termini can be chosen interactively\00", align 1
@.str.42 = private unnamed_addr constant [74 x i8] c"with the [TT]-ter[tt] flag.  Default termini are ionized (NH3+ and COO-),\00", align 1
@.str.43 = private unnamed_addr constant [74 x i8] c"respectively.  Some force fields support zwitterionic forms for chains of\00", align 1
@.str.44 = private unnamed_addr constant [72 x i8] c"one residue, but for polypeptides these options should NOT be selected.\00", align 1
@.str.45 = private unnamed_addr constant [68 x i8] c"The AMBER force fields have unique forms for the terminal residues,\00", align 1
@.str.46 = private unnamed_addr constant [69 x i8] c"and these are incompatible with the [TT]-ter[tt] mechanism. You need\00", align 1
@.str.47 = private unnamed_addr constant [62 x i8] c"to prefix your N- or C-terminal residue names with \22N\22 or \22C\22\00", align 1
@.str.48 = private unnamed_addr constant [69 x i8] c"respectively to use these forms, making sure you preserve the format\00", align 1
@.str.49 = private unnamed_addr constant [70 x i8] c"of the coordinate file. Alternatively, use named terminating residues\00", align 1
@.str.50 = private unnamed_addr constant [22 x i8] c"(e.g. ACE, NME).[PAR]\00", align 1
@.str.51 = private unnamed_addr constant [66 x i8] c"The separation of chains is not entirely trivial since the markup\00", align 1
@.str.52 = private unnamed_addr constant [63 x i8] c"in user-generated PDB files frequently varies and sometimes it\00", align 1
@.str.53 = private unnamed_addr constant [64 x i8] c"is desirable to merge entries across a TER record, for instance\00", align 1
@.str.54 = private unnamed_addr constant [62 x i8] c"if you want a disulfide bridge or distance restraints between\00", align 1
@.str.55 = private unnamed_addr constant [67 x i8] c"two protein chains or if you have a HEME group bound to a protein.\00", align 1
@.str.56 = private unnamed_addr constant [62 x i8] c"In such cases multiple chains should be contained in a single\00", align 1
@.str.57 = private unnamed_addr constant [33 x i8] c"[TT]moleculetype[tt] definition.\00", align 1
@.str.58 = private unnamed_addr constant [56 x i8] c"To handle this, [THISMODULE] uses two separate options.\00", align 1
@.str.59 = private unnamed_addr constant [79 x i8] c"First, [TT]-chainsep[tt] allows you to choose when a new chemical chain should\00", align 1
@.str.60 = private unnamed_addr constant [72 x i8] c"start, and termini added when applicable. This can be done based on the\00", align 1
@.str.61 = private unnamed_addr constant [79 x i8] c"existence of TER records, when the chain id changes, or combinations of either\00", align 1
@.str.62 = private unnamed_addr constant [69 x i8] c"or both of these. You can also do the selection fully interactively.\00", align 1
@.str.63 = private unnamed_addr constant [80 x i8] c"In addition, there is a [TT]-merge[tt] option that controls how multiple chains\00", align 1
@.str.64 = private unnamed_addr constant [82 x i8] c"are merged into one moleculetype, after adding all the chemical termini (or not).\00", align 1
@.str.65 = private unnamed_addr constant [79 x i8] c"This can be turned off (no merging), all non-water chains can be merged into a\00", align 1
@.str.66 = private unnamed_addr constant [66 x i8] c"single molecule, or the selection can be done interactively.[PAR]\00", align 1
@.str.67 = private unnamed_addr constant [77 x i8] c"[THISMODULE] will also check the occupancy field of the [REF].pdb[ref] file.\00", align 1
@.str.68 = private unnamed_addr constant [67 x i8] c"If any of the occupancies are not one, indicating that the atom is\00", align 1
@.str.69 = private unnamed_addr constant [65 x i8] c"not resolved well in the structure, a warning message is issued.\00", align 1
@.str.70 = private unnamed_addr constant [84 x i8] c"When a [REF].pdb[ref] file does not originate from an X-ray structure determination\00", align 1
@.str.71 = private unnamed_addr constant [67 x i8] c"all occupancy fields may be zero. Either way, it is up to the user\00", align 1
@.str.72 = private unnamed_addr constant [70 x i8] c"to verify the correctness of the input data (read the article!).[PAR]\00", align 1
@.str.73 = private unnamed_addr constant [67 x i8] c"During processing the atoms will be reordered according to GROMACS\00", align 1
@.str.74 = private unnamed_addr constant [65 x i8] c"conventions. With [TT]-n[tt] an index file can be generated that\00", align 1
@.str.75 = private unnamed_addr constant [65 x i8] c"contains one group reordered in the same way. This allows you to\00", align 1
@.str.76 = private unnamed_addr constant [68 x i8] c"convert a GROMOS trajectory and coordinate file to GROMOS. There is\00", align 1
@.str.77 = private unnamed_addr constant [68 x i8] c"one limitation: reordering is done after the hydrogens are stripped\00", align 1
@.str.78 = private unnamed_addr constant [67 x i8] c"from the input and before new hydrogens are added. This means that\00", align 1
@.str.79 = private unnamed_addr constant [39 x i8] c"you should not use [TT]-ignh[tt].[PAR]\00", align 1
@.str.80 = private unnamed_addr constant [70 x i8] c"The [REF].gro[ref] and [TT].g96[tt] file formats do not support chain\00", align 1
@.str.81 = private unnamed_addr constant [75 x i8] c"identifiers. Therefore it is useful to enter a [REF].pdb[ref] file name at\00", align 1
@.str.82 = private unnamed_addr constant [82 x i8] c"the [TT]-o[tt] option when you want to convert a multi-chain [REF].pdb[ref] file.\00", align 1
@.str.83 = private unnamed_addr constant [70 x i8] c"The option [TT]-vsite[tt] removes hydrogen and fast improper dihedral\00", align 1
@.str.84 = private unnamed_addr constant [69 x i8] c"motions. Angular and out-of-plane motions can be removed by changing\00", align 1
@.str.85 = private unnamed_addr constant [66 x i8] c"hydrogens into virtual sites and fixing angles, which fixes their\00", align 1
@.str.86 = private unnamed_addr constant [71 x i8] c"position relative to neighboring atoms. Additionally, all atoms in the\00", align 1
@.str.87 = private unnamed_addr constant [72 x i8] c"aromatic rings of the standard amino acids (i.e. PHE, TRP, TYR and HIS)\00", align 1
@.str.88 = private unnamed_addr constant [76 x i8] c"can be converted into virtual sites, eliminating the fast improper dihedral\00", align 1
@.str.89 = private unnamed_addr constant [62 x i8] c"fluctuations in these rings (but this feature is deprecated).\00", align 1
@.str.90 = private unnamed_addr constant [50 x i8] c"[BB]Note[bb] that in this case all other hydrogen\00", align 1
@.str.91 = private unnamed_addr constant [74 x i8] c"atoms are also converted to virtual sites. The mass of all atoms that are\00", align 1
@.str.92 = private unnamed_addr constant [64 x i8] c"converted into virtual sites, is added to the heavy atoms.[PAR]\00", align 1
@.str.93 = private unnamed_addr constant [70 x i8] c"Also slowing down of dihedral motion can be done with [TT]-heavyh[tt]\00", align 1
@.str.94 = private unnamed_addr constant [68 x i8] c"done by increasing the hydrogen-mass by a factor of 4. This is also\00", align 1
@.str.95 = private unnamed_addr constant [70 x i8] c"done for water hydrogens to slow down the rotational motion of water.\00", align 1
@.str.96 = private unnamed_addr constant [68 x i8] c"The increase in mass of the hydrogens is subtracted from the bonded\00", align 1
@.str.97 = private unnamed_addr constant [68 x i8] c"(heavy) atom so that the total mass of the system remains the same.\00", align 1
@.str.98 = private unnamed_addr constant [69 x i8] c"As a special case, ring-closed (or cyclic) molecules are considered.\00", align 1
@.str.99 = private unnamed_addr constant [70 x i8] c"[THISMODULE] automatically determines if a cyclic molecule is present\00", align 1
@.str.100 = private unnamed_addr constant [72 x i8] c"by evaluating the distance between the terminal atoms of a given chain.\00", align 1
@.str.101 = private unnamed_addr constant [49 x i8] c"If this distance is greater than the [TT]-sb[tt]\00", align 1
@.str.102 = private unnamed_addr constant [49 x i8] c"(\22Short bond warning distance\22, default 0.05 nm)\00", align 1
@.str.103 = private unnamed_addr constant [78 x i8] c"and less than the [TT]-lb[tt] (\22Long bond warning distance\22, default 0.25 nm)\00", align 1
@.str.104 = private unnamed_addr constant [76 x i8] c"the molecule is considered to be ring closed and will be processed as such.\00", align 1
@.str.105 = private unnamed_addr constant [77 x i8] c"Please note that this does not detect cyclic bonds over periodic boundaries.\00", align 1
