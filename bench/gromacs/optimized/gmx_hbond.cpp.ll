@.str.63 = private unnamed_addr constant [63 x i8] c"   frames, this also contains information on solvent insertion\00", align 1
@.str.64 = private unnamed_addr constant [70 x i8] c"   into hydrogen bonds. Ordering is identical to that in [TT]-hbn[tt]\00", align 1
@.str.65 = private unnamed_addr constant [15 x i8] c"   index file.\00", align 1
@.str.66 = private unnamed_addr constant [75 x i8] c" * [TT]-dan[tt]: write out the number of donors and acceptors analyzed for\00", align 1
@.str.67 = private unnamed_addr constant [72 x i8] c"   each timeframe. This is especially useful when using [TT]-shell[tt].\00", align 1
@.str.68 = private unnamed_addr constant [75 x i8] c" * [TT]-nhbdist[tt]: compute the number of HBonds per hydrogen in order to\00", align 1
@.str.69 = private unnamed_addr constant [42 x i8] c"   compare results to Raman Spectroscopy.\00", align 1
@.str.70 = private unnamed_addr constant [72 x i8] c"Note: options [TT]-ac[tt], [TT]-life[tt], [TT]-hbn[tt] and [TT]-hbm[tt]\00", align 1
