@.str.25 = private unnamed_addr constant [70 x i8] c"[THISMODULE] computes and analyzes hydrogen bonds. Hydrogen bonds are\00", align 1
@.str.26 = private unnamed_addr constant [70 x i8] c"determined based on cutoffs for the angle Hydrogen - Donor - Acceptor\00", align 1
@.str.27 = private unnamed_addr constant [53 x i8] c"(zero is extended) and the distance Donor - Acceptor\00", align 1
@.str.28 = private unnamed_addr constant [46 x i8] c"(or Hydrogen - Acceptor using [TT]-noda[tt]).\00", align 1
@.str.29 = private unnamed_addr constant [66 x i8] c"OH and NH groups are regarded as donors, O is an acceptor always,\00", align 1
@.str.30 = private unnamed_addr constant [60 x i8] c"N is an acceptor by default, but this can be switched using\00", align 1
@.str.31 = private unnamed_addr constant [66 x i8] c"[TT]-nitacc[tt]. Dummy hydrogen atoms are assumed to be connected\00", align 1
@.str.32 = private unnamed_addr constant [47 x i8] c"to the first preceding non-hydrogen atom.[PAR]\00", align 1
@.str.33 = private unnamed_addr constant [66 x i8] c"You need to specify two groups for analysis, which must be either\00", align 1
@.str.34 = private unnamed_addr constant [65 x i8] c"identical or non-overlapping. All hydrogen bonds between the two\00", align 1
@.str.35 = private unnamed_addr constant [26 x i8] c"groups are analyzed.[PAR]\00", align 1
@.str.36 = private unnamed_addr constant [75 x i8] c"If you set [TT]-shell[tt], you will be asked for an additional index group\00", align 1
@.str.37 = private unnamed_addr constant [67 x i8] c"which should contain exactly one atom. In this case, only hydrogen\00", align 1
@.str.38 = private unnamed_addr constant [68 x i8] c"bonds between atoms within the shell distance from the one atom are\00", align 1
@.str.39 = private unnamed_addr constant [17 x i8] c"considered.[PAR]\00", align 1
@.str.40 = private unnamed_addr constant [77 x i8] c"With option -ac, rate constants for hydrogen bonding can be derived with the\00", align 1
@.str.41 = private unnamed_addr constant [80 x i8] c"model of Luzar and Chandler (Nature 379:55, 1996; J. Chem. Phys. 113:23, 2000).\00", align 1
@.str.42 = private unnamed_addr constant [68 x i8] c"If contact kinetics are analyzed by using the -contact option, then\00", align 1
@.str.43 = private unnamed_addr constant [89 x i8] c"n(t) can be defined as either all pairs that are not within contact distance r at time t\00", align 1
@.str.44 = private unnamed_addr constant [83 x i8] c"(corresponding to leaving the -r2 option at the default value 0) or all pairs that\00", align 1
@.str.45 = private unnamed_addr constant [90 x i8] c"are within distance r2 (corresponding to setting a second cut-off value with option -r2).\00", align 1
@.str.46 = private unnamed_addr constant [59 x i8] c"See mentioned literature for more details and definitions.\00", align 1
@.str.47 = private unnamed_addr constant [6 x i8] c"[PAR]\00", align 1
@.str.48 = private unnamed_addr constant [16 x i8] c"[BB]Output:[bb]\00", align 1
@.str.49 = private unnamed_addr constant [66 x i8] c" * [TT]-num[tt]:  number of hydrogen bonds as a function of time.\00", align 1
@.str.50 = private unnamed_addr constant [69 x i8] c" * [TT]-ac[tt]:   average over all autocorrelations of the existence\00", align 1
@.str.51 = private unnamed_addr constant [52 x i8] c"   functions (either 0 or 1) of all hydrogen bonds.\00", align 1
@.str.52 = private unnamed_addr constant [63 x i8] c" * [TT]-dist[tt]: distance distribution of all hydrogen bonds.\00", align 1
@.str.53 = private unnamed_addr constant [60 x i8] c" * [TT]-ang[tt]:  angle distribution of all hydrogen bonds.\00", align 1
@.str.54 = private unnamed_addr constant [75 x i8] c" * [TT]-hx[tt]:   the number of n-n+i hydrogen bonds as a function of time\00", align 1
@.str.55 = private unnamed_addr constant [71 x i8] c"   where n and n+i stand for residue numbers and i ranges from 0 to 6.\00", align 1
@.str.56 = private unnamed_addr constant [70 x i8] c"   This includes the n-n+3, n-n+4 and n-n+5 hydrogen bonds associated\00", align 1
@.str.57 = private unnamed_addr constant [29 x i8] c"   with helices in proteins.\00", align 1
@.str.58 = private unnamed_addr constant [71 x i8] c" * [TT]-hbn[tt]:  all selected groups, donors, hydrogens and acceptors\00", align 1
@.str.59 = private unnamed_addr constant [70 x i8] c"   for selected groups, all hydrogen bonded atoms from all groups and\00", align 1
@.str.60 = private unnamed_addr constant [69 x i8] c"   all solvent atoms involved in insertion. Output is limited unless\00", align 1
@.str.61 = private unnamed_addr constant [28 x i8] c"   [TT]-nomerge[tt] is set.\00", align 1
