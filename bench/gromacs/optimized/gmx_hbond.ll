@.str.64 = private unnamed_addr constant [70 x i8] c"   into hydrogen bonds. Ordering is identical to that in [TT]-hbn[tt]\00", align 1
@.str.65 = private unnamed_addr constant [15 x i8] c"   index file.\00", align 1
@.str.66 = private unnamed_addr constant [75 x i8] c" * [TT]-dan[tt]: write out the number of donors and acceptors analyzed for\00", align 1
