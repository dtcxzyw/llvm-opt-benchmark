@.str.58 = private unnamed_addr constant [71 x i8] c" * [TT]-hbn[tt]:  all selected groups, donors, hydrogens and acceptors\00", align 1
@.str.59 = private unnamed_addr constant [70 x i8] c"   for selected groups, all hydrogen bonded atoms from all groups and\00", align 1
