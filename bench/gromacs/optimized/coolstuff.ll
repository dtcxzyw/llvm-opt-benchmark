@.str.1253 = private unnamed_addr constant [9 x i8] c"Voltaire\00", align 1
@.str.1254 = private unnamed_addr constant [53 x i8] c"Men love to wonder, and that is the seed of science.\00", align 1
@.str.1255 = private unnamed_addr constant [70 x i8] c"In mathematics you don't understand things, you just get used to them\00", align 1
