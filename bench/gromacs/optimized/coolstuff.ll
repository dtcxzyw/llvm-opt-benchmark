@.str.1270 = private unnamed_addr constant [62 x i8] c"Mathematics is no more computation than typing is literature.\00", align 1
@.str.1271 = private unnamed_addr constant [18 x i8] c"John Allen Paulos\00", align 1
@.str.1272 = private unnamed_addr constant [69 x i8] c"Mathematics is like love; a simple idea, but it can get complicated.\00", align 1
@.str.1273 = private unnamed_addr constant [47 x i8] c"I had a polynomial once. My doctor removed it.\00", align 1
@.str.1274 = private unnamed_addr constant [14 x i8] c"Michael Grant\00", align 1
