@.str.1262 = private unnamed_addr constant [21 x i8] c"Carl Friedrich Gauss\00", align 1
@.str.1263 = private unnamed_addr constant [73 x i8] c"The difficulty lies, not in the new ideas, but in escaping the old ones.\00", align 1
