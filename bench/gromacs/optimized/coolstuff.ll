@.str.1279 = private unnamed_addr constant [59 x i8] c"The sign of wisdom is to have more questions than answers.\00", align 1
@.str.1280 = private unnamed_addr constant [15 x i8] c"Abhijit Naskar\00", align 1
@.str.1281 = private unnamed_addr constant [64 x i8] c"Stupidity got us into this mess, and stupidity will get us out.\00", align 1
