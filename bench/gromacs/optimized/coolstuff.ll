@.str.1289 = private unnamed_addr constant [17 x i8] c"Bertrand Russell\00", align 1
@.str.1290 = private unnamed_addr constant [69 x i8] c"I don't believe in astrology; I'm a Sagittarian and we're skeptical.\00", align 1
@.str.1291 = private unnamed_addr constant [116 x i8] c"I see they found out the universe is 80 million years older than we thought. It's also been lying about its weight.\00", align 1
@.str.1292 = private unnamed_addr constant [11 x i8] c"Bill Maher\00", align 1
