@.str.1209 = private unnamed_addr constant [58 x i8] c"Everything is theoretically impossible, until it is done.\00", align 1
@.str.1210 = private unnamed_addr constant [16 x i8] c"Robert Heinlein\00", align 1
@.str.1211 = private unnamed_addr constant [86 x i8] c"Bad times have a scientific value. These are occasions a good learner would not miss.\00", align 1
@.str.1212 = private unnamed_addr constant [98 x i8] c"The scientist is not a person who gives the right answers, he's one who asks the right questions.\00", align 1
@.str.1213 = private unnamed_addr constant [50 x i8] c"Rockets are cool. There's no getting around that.\00", align 1
@.str.1214 = private unnamed_addr constant [10 x i8] c"Elon Musk\00", align 1
@.str.1215 = private unnamed_addr constant [42 x i8] c"Life would be tragic if it weren't funny.\00", align 1
@.str.1216 = private unnamed_addr constant [16 x i8] c"Stephen Hawking\00", align 1
@.str.1217 = private unnamed_addr constant [56 x i8] c"Somewhere, something incredible is waiting to be known.\00", align 1
@.str.1218 = private unnamed_addr constant [170 x i8] c"I am driven by two main philosophies: know more today about the world than I knew yesterday and lessen the suffering of others. You'd be surprised how far that gets you.\00", align 1
@.str.1219 = private unnamed_addr constant [20 x i8] c"Neil deGrasse Tyson\00", align 1
