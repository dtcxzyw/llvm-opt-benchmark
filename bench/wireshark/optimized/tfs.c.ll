  %3 = icmp eq ptr %1, null
  %.not6 = icmp eq i32 %0, 0
  br i1 %3, label %4, label %6

4:                                                ; preds = %2
  %5 = select i1 %.not6, ptr @.str.1, ptr @.str
  br label %8

6:                                                ; preds = %2
  %.in.idx = select i1 %.not6, i64 8, i64 0
  %.in = getelementptr inbounds i8, ptr %1, i64 %.in.idx
  %7 = load ptr, ptr %.in, align 8
