define hidden i32 @strip_trailing_blanks(ptr noundef %0, i32 noundef %1) local_unnamed_addr #0 {
  %.not = icmp eq ptr %0, null
  br i1 %.not, label %.loopexit, label %.preheader

.preheader:                                       ; preds = %2
  %.114 = add i32 %1, -1
  %3 = icmp sgt i32 %.114, -1
  br i1 %3, label %.lr.ph.preheader, label %.loopexit

.lr.ph.preheader:                                 ; preds = %.preheader
  %4 = zext nneg i32 %.114 to i64
  br label %.lr.ph

.lr.ph:                                           ; preds = %.lr.ph.preheader, %7
  %indvars.iv = phi i64 [ %4, %.lr.ph.preheader ], [ %indvars.iv.next, %7 ]
  %5 = getelementptr i8, ptr %0, i64 %indvars.iv
  %6 = load i8, ptr %5, align 1
  switch i8 %6, label %.loopexit.loopexit.split.loop.exit [
    i8 32, label %7
    i8 0, label %7
  ]

7:                                                ; preds = %.lr.ph, %.lr.ph
  store i8 0, ptr %5, align 1
  %indvars.iv.next = add nsw i64 %indvars.iv, -1
  %8 = icmp sgt i64 %indvars.iv, 0
  br i1 %8, label %.lr.ph, label %.loopexit, !llvm.loop !4

.loopexit.loopexit.split.loop.exit:               ; preds = %.lr.ph
  %9 = trunc nuw nsw i64 %indvars.iv to i32
  br label %.loopexit

.loopexit:                                        ; preds = %7, %.loopexit.loopexit.split.loop.exit, %.preheader, %2
  %.0 = phi i32 [ 0, %2 ], [ %.114, %.preheader ], [ %9, %.loopexit.loopexit.split.loop.exit ], [ -1, %7 ]
  ret i32 %.0
