@anon.faf009aaacdb3bbda30f9435f6d39aa4.1766 = private unnamed_addr constant [29 x i8] c"multi-line-summary-first-line", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1767 = private unnamed_addr constant [1588 x i8] c"## What it does\0AChecks for docstring summary lines that are not positioned on the first\0Aphysical line of the docstring.\0A\0A## Why is this bad?\0A[PEP 257] recommends that multi-line docstrings consist of \22a summary line\0Ajust like a one-line docstring, followed by a blank line, followed by a\0Amore elaborate description.\22\0A\0AThe summary line should be located on the first physical line of the\0Adocstring, immediately after the opening quotes.\0A\0AThis rule may not apply to all projects; its applicability is a matter of\0Aconvention. By default, this rule is enabled when using the `google`\0Aconvention, and disabled when using the `numpy` and `pep257` conventions.\0A\0AFor an alternative, see [D213].\0A\0A## Example\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22\0A    Return a sorted copy of the list.\0A\0A    Sort the list in ascending order and return a copy of the result using the\0A    bubble sort algorithm.\0A    \22\22\22\0A```\0A\0AUse instead:\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22Return a sorted copy of the list.\0A\0A    Sort the list in ascending order and return a copy of the result using the bubble\0A    sort algorithm.\0A    \22\22\22\0A```\0A\0A## Options\0A- `lint.pydocstyle.convention`\0A\0A## References\0A- [PEP 257 \E2\80\93 Docstring Conventions](https://peps.python.org/pep-0257/)\0A- [NumPy Style Guide](https://numpydoc.readthedocs.io/en/latest/format.html)\0A- [Google Python Style Guide - Docstrings](https://google.github.io/styleguide/pyguide.html#38-comments-and-docstrings)\0A\0A[D213]: https://docs.astral.sh/ruff/rules/multi-line-summary-second-line\0A[PEP 257]: https://peps.python.org/pep-0257\0A", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1768 = private unnamed_addr constant [59 x i8] c"Multi-line docstring summary should start at the first line", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1769 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1768, [8 x i8] c";\00\00\00\00\00\00\00" }>, align 8
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1770 = private unnamed_addr constant [30 x i8] c"multi-line-summary-second-line", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1771 = private unnamed_addr constant [1571 x i8] c"## What it does\0AChecks for docstring summary lines that are not positioned on the second\0Aphysical line of the docstring.\0A\0A## Why is this bad?\0A[PEP 257] recommends that multi-line docstrings consist of \22a summary line\0Ajust like a one-line docstring, followed by a blank line, followed by a\0Amore elaborate description.\22\0A\0AThe summary line should be located on the second physical line of the\0Adocstring, immediately after the opening quotes and the blank line.\0A\0AThis rule may not apply to all projects; its applicability is a matter of\0Aconvention. By default, this rule is disabled when using the `google`,\0A`numpy`, and `pep257` conventions.\0A\0AFor an alternative, see [D212].\0A\0A## Example\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22Return a sorted copy of the list.\0A\0A    Sort the list in ascending order and return a copy of the result using the\0A    bubble sort algorithm.\0A    \22\22\22\0A```\0A\0AUse instead:\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22\0A    Return a sorted copy of the list.\0A\0A    Sort the list in ascending order and return a copy of the result using the bubble\0A    sort algorithm.\0A    \22\22\22\0A```\0A\0A## Options\0A- `lint.pydocstyle.convention`\0A\0A## References\0A- [PEP 257 \E2\80\93 Docstring Conventions](https://peps.python.org/pep-0257/)\0A- [NumPy Style Guide](https://numpydoc.readthedocs.io/en/latest/format.html)\0A- [Google Python Style Guide - Docstrings](https://google.github.io/styleguide/pyguide.html#38-comments-and-docstrings)\0A\0A[D212]: https://docs.astral.sh/ruff/rules/multi-line-summary-first-line\0A[PEP 257]: https://peps.python.org/pep-0257\0A", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1772 = private unnamed_addr constant [60 x i8] c"Multi-line docstring summary should start at the second line", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1773 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1772, [8 x i8] c"<\00\00\00\00\00\00\00" }>, align 8
