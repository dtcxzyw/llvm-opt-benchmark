@anon.8ad231a129453d088979dfad2582f60a.1330 = private unnamed_addr constant [25 x i8] c"pandas-use-of-dot-is-null", align 1
@anon.8ad231a129453d088979dfad2582f60a.1331 = private unnamed_addr constant [801 x i8] c"## What it does\0AChecks for uses of `.isnull` on Pandas objects.\0A\0A## Why is this bad?\0AIn the Pandas API, `.isna` and `.isnull` are equivalent. For consistency,\0Aprefer `.isna` over `.isnull`.\0A\0AAs a name, `.isna` more accurately reflects the behavior of the method,\0Asince these methods check for `NaN` and `NaT` values in addition to `None`\0Avalues.\0A\0A## Example\0A```python\0Aimport pandas as pd\0A\0Aanimals_df = pd.read_csv(\22animals.csv\22)\0Apd.isnull(animals_df)\0A```\0A\0AUse instead:\0A```python\0Aimport pandas as pd\0A\0Aanimals_df = pd.read_csv(\22animals.csv\22)\0Apd.isna(animals_df)\0A```\0A\0A## References\0A- [Pandas documentation: `isnull`](https://pandas.pydata.org/docs/reference/api/pandas.isnull.html#pandas.isnull)\0A- [Pandas documentation: `isna`](https://pandas.pydata.org/docs/reference/api/pandas.isna.html#pandas.isna)\0A", align 1
@anon.8ad231a129453d088979dfad2582f60a.1332 = private unnamed_addr constant [62 x i8] c"`.isna` is preferred to `.isnull`; functionality is equivalent", align 1
@anon.8ad231a129453d088979dfad2582f60a.1333 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.8ad231a129453d088979dfad2582f60a.1332, [8 x i8] c">\00\00\00\00\00\00\00" }>, align 8
@anon.8ad231a129453d088979dfad2582f60a.1334 = private unnamed_addr constant [26 x i8] c"pandas-use-of-dot-not-null", align 1
@anon.8ad231a129453d088979dfad2582f60a.1335 = private unnamed_addr constant [815 x i8] c"## What it does\0AChecks for uses of `.notnull` on Pandas objects.\0A\0A## Why is this bad?\0AIn the Pandas API, `.notna` and `.notnull` are equivalent. For consistency,\0Aprefer `.notna` over `.notnull`.\0A\0AAs a name, `.notna` more accurately reflects the behavior of the method,\0Asince these methods check for `NaN` and `NaT` values in addition to `None`\0Avalues.\0A\0A## Example\0A```python\0Aimport pandas as pd\0A\0Aanimals_df = pd.read_csv(\22animals.csv\22)\0Apd.notnull(animals_df)\0A```\0A\0AUse instead:\0A```python\0Aimport pandas as pd\0A\0Aanimals_df = pd.read_csv(\22animals.csv\22)\0Apd.notna(animals_df)\0A```\0A\0A## References\0A- [Pandas documentation: `notnull`](https://pandas.pydata.org/docs/reference/api/pandas.notnull.html#pandas.notnull)\0A- [Pandas documentation: `notna`](https://pandas.pydata.org/docs/reference/api/pandas.notna.html#pandas.notna)\0A", align 1
@anon.8ad231a129453d088979dfad2582f60a.1336 = private unnamed_addr constant [64 x i8] c"`.notna` is preferred to `.notnull`; functionality is equivalent", align 1
