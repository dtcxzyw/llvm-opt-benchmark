@anon.8ad231a129453d088979dfad2582f60a.1435 = private unnamed_addr constant [3721 x i8] c"## What it does\0AChecks for functions or methods with too many branches, including (nested)\0A`if`, `elif`, and `else` branches, `for` loops, `try`-`except` clauses, and\0A`match` and `case` statements.\0A\0ABy default, this rule allows up to 12 branches. This can be configured\0Ausing the [`lint.pylint.max-branches`] option.\0A\0A## Why is this bad?\0AFunctions or methods with many branches are harder to understand\0Aand maintain than functions or methods with fewer branches.\0A\0A## Example\0AGiven:\0A```python\0Adef capital(country):\0A    if country == \22Australia\22:\0A        return \22Canberra\22\0A    elif country == \22Brazil\22:\0A        return \22Brasilia\22\0A    elif country == \22Canada\22:\0A        return \22Ottawa\22\0A    elif country == \22England\22:\0A        return \22London\22\0A    elif country == \22France\22:\0A        return \22Paris\22\0A    elif country == \22Germany\22:\0A        return \22Berlin\22\0A    elif country == \22Poland\22:\0A        return \22Warsaw\22\0A    elif country == \22Romania\22:\0A        return \22Bucharest\22\0A    elif country == \22Spain\22:\0A        return \22Madrid\22\0A    elif country == \22Thailand\22:\0A        return \22Bangkok\22\0A    elif country == \22Turkey\22:\0A        return \22Ankara\22\0A    elif country == \22United States\22:\0A        return \22Washington\22\0A    else:\0A        return \22Unknown\22  # 13th branch\0A```\0A\0AUse instead:\0A```python\0Adef capital(country):\0A    capitals = {\0A        \22Australia\22: \22Canberra\22,\0A        \22Brazil\22: \22Brasilia\22,\0A        \22Canada\22: \22Ottawa\22,\0A        \22England\22: \22London\22,\0A        \22France\22: \22Paris\22,\0A        \22Germany\22: \22Berlin\22,\0A        \22Poland\22: \22Warsaw\22,\0A        \22Romania\22: \22Bucharest\22,\0A        \22Spain\22: \22Madrid\22,\0A        \22Thailand\22: \22Bangkok\22,\0A        \22Turkey\22: \22Ankara\22,\0A        \22United States\22: \22Washington\22,\0A    }\0A    city = capitals.get(country, \22Unknown\22)\0A    return city\0A```\0A\0AGiven:\0A```python\0Adef grades_to_average_number(grades):\0A    numbers = []\0A    for grade in grades:  # 1st branch\0A        if len(grade) not in {1, 2}:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A\0A        if len(grade) == 2 and grade[1] not in {\22+\22, \22-\22}:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A\0A        letter = grade[0]\0A\0A        if letter in {\22F\22, \22E\22}:\0A            number = 0.0\0A        elif letter == \22D\22:\0A            number = 1.0\0A        elif letter == \22C\22:\0A            number = 2.0\0A        elif letter == \22B\22:\0A            number = 3.0\0A        elif letter == \22A\22:\0A            number = 4.0\0A        else:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A\0A        modifier = 0.0\0A        if letter != \22F\22 and grade[-1] == \22+\22:\0A            modifier = 0.3\0A        elif letter != \22F\22 and grade[-1] == \22-\22:\0A            modifier = -0.3\0A\0A        numbers.append(max(0.0, min(number + modifier, 4.0)))\0A\0A    try:\0A        return sum(numbers) / len(numbers)\0A    except ZeroDivisionError:  # 13th branch\0A        return 0\0A```\0A\0AUse instead:\0A```python\0Adef grades_to_average_number(grades):\0A    grade_values = {\22F\22: 0.0, \22E\22: 0.0, \22D\22: 1.0, \22C\22: 2.0, \22B\22: 3.0, \22A\22: 4.0}\0A    modifier_values = {\22+\22: 0.3, \22-\22: -0.3}\0A\0A    numbers = []\0A    for grade in grades:\0A        if len(grade) not in {1, 2}:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A\0A        letter = grade[0]\0A        if letter not in grade_values:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A        number = grade_values[letter]\0A\0A        if len(grade) == 2 and grade[1] not in modifier_values:\0A            raise ValueError(f\22Invalid grade: {grade}\22)\0A        modifier = modifier_values.get(grade[-1], 0.0)\0A\0A        if letter == \22F\22:\0A            numbers.append(0.0)\0A        else:\0A            numbers.append(max(0.0, min(number + modifier, 4.0)))\0A\0A    try:\0A        return sum(numbers) / len(numbers)\0A    except ZeroDivisionError:\0A        return 0\0A```\0A\0A## Options\0A- `lint.pylint.max-branches`\0A", align 1
