@anon.0e1c26e9d874215adbd54bac9512570c.9 = private unnamed_addr constant [17460 x i8] c"\22\22\22\0A============================\0A``ctypes`` Utility Functions\0A============================\0A\0ASee Also\0A--------\0Aload_library : Load a C library.\0Andpointer : Array restype/argtype with verification.\0Aas_ctypes : Create a ctypes array from an ndarray.\0Aas_array : Create an ndarray from a ctypes array.\0A\0AReferences\0A----------\0A.. [1] \22SciPy Cookbook: ctypes\22, https://scipy-cookbook.readthedocs.io/items/Ctypes.html\0A\0AExamples\0A--------\0ALoad the C library:\0A\0A>>> _lib = np.ctypeslib.load_library('libmystuff', '.')     #doctest: +SKIP\0A\0AOur result type, an ndarray that must be of type double, be 1-dimensional\0Aand is C-contiguous in memory:\0A\0A>>> array_1d_double = np.ctypeslib.ndpointer(\0A...                          dtype=np.double,\0A...                          ndim=1, flags='CONTIGUOUS')    #doctest: +SKIP\0A\0AOur C-function typically takes an array and updates its values\0Ain-place.  For example::\0A\0A    void foo_func(double* x, int length)\0A    {\0A        int i;\0A        for (i = 0; i < length; i++) {\0A            x[i] = i*i;\0A        }\0A    }\0A\0AWe wrap it using:\0A\0A>>> _lib.foo_func.restype = None                      #doctest: +SKIP\0A>>> _lib.foo_func.argtypes = [array_1d_double, c_int] #doctest: +SKIP\0A\0AThen, we're ready to call ``foo_func``:\0A\0A>>> out = np.empty(15, dtype=np.double)\0A>>> _lib.foo_func(out, len(out))                #doctest: +SKIP\0A\0A\22\22\22\0A__all__ = ['load_library', 'ndpointer', 'c_intp', 'as_ctypes', 'as_array',\0A           'as_ctypes_type']\0A\0Aimport os\0Afrom numpy import (\0A    integer, ndarray, dtype as _dtype, asarray, frombuffer\0A)\0Afrom numpy.core.multiarray import _flagdict, flagsobj\0A\0Atry:\0A    import ctypes\0Aexcept ImportError:\0A    ctypes = None\0A\0Aif ctypes is None:\0A    def _dummy(*args, **kwds):\0A        \22\22\22\0A        Dummy object that raises an ImportError if ctypes is not available.\0A\0A        Raises\0A        ------\0A        ImportError\0A            If ctypes is not available.\0A\0A        \22\22\22\0A        raise ImportError(\22ctypes is not available.\22)\0A    load_library = _dummy\0A    as_ctypes = _dummy\0A    as_array = _dummy\0A    from numpy import intp as c_intp\0A    _ndptr_base = object\0Aelse:\0A    import numpy.core._internal as nic\0A    c_intp = nic._getintp_ctype()\0A    del nic\0A    _ndptr_base = ctypes.c_void_p\0A\0A    # Adapted from Albert Strasheim\0A    def load_library(libname, loader_path):\0A        \22\22\22\0A        It is possible to load a library using\0A\0A        >>> lib = ctypes.cdll[<full_path_name>] # doctest: +SKIP\0A\0A        But there are cross-platform considerations, such as library file extensions,\0A        plus the fact Windows will just load the first library it finds with that name.\0A        NumPy supplies the load_library function as a convenience.\0A\0A        .. versionchanged:: 1.20.0\0A            Allow libname and loader_path to take any\0A            :term:`python:path-like object`.\0A\0A        Parameters\0A        ----------\0A        libname : path-like\0A            Name of the library, which can have 'lib' as a prefix,\0A            but without an extension.\0A        loader_path : path-like\0A            Where the library can be found.\0A\0A        Returns\0A        -------\0A        ctypes.cdll[libpath] : library object\0A           A ctypes library object\0A\0A        Raises\0A        ------\0A        OSError\0A            If there is no library with the expected extension, or the\0A            library is defective and cannot be loaded.\0A        \22\22\22\0A        if ctypes.__version__ < '1.0.1':\0A            import warnings\0A            warnings.warn(\22All features of ctypes interface may not work \22\0A                          \22with ctypes < 1.0.1\22, stacklevel=2)\0A\0A        # Convert path-like objects into strings\0A        libname = os.fsdecode(libname)\0A        loader_path = os.fsdecode(loader_path)\0A\0A        ext = os.path.splitext(libname)[1]\0A        if not ext:\0A            # Try to load library with platform-specific name, otherwise\0A            # default to libname.[so|pyd].  Sometimes, these files are built\0A            # erroneously on non-linux platforms.\0A            from numpy.distutils.misc_util import get_shared_lib_extension\0A            so_ext = get_shared_lib_extension()\0A            libname_ext = [libname + so_ext]\0A            # mac, windows and linux >= py3.2 shared library and loadable\0A            # module have different extensions so try both\0A            so_ext2 = get_shared_lib_extension(is_python_ext=True)\0A            if not so_ext2 == so_ext:\0A                libname_ext.insert(0, libname + so_ext2)\0A        else:\0A            libname_ext = [libname]\0A\0A        loader_path = os.path.abspath(loader_path)\0A        if not os.path.isdir(loader_path):\0A            libdir = os.path.dirname(loader_path)\0A        else:\0A            libdir = loader_path\0A\0A        for ln in libname_ext:\0A            libpath = os.path.join(libdir, ln)\0A            if os.path.exists(libpath):\0A                try:\0A                    return ctypes.cdll[libpath]\0A                except OSError:\0A                    ## defective lib file\0A                    raise\0A        ## if no successful return in the libname_ext loop:\0A        raise OSError(\22no file with expected extension\22)\0A\0A\0Adef _num_fromflags(flaglist):\0A    num = 0\0A    for val in flaglist:\0A        num += _flagdict[val]\0A    return num\0A\0A_flagnames = ['C_CONTIGUOUS', 'F_CONTIGUOUS', 'ALIGNED', 'WRITEABLE',\0A              'OWNDATA', 'WRITEBACKIFCOPY']\0Adef _flags_fromnum(num):\0A    res = []\0A    for key in _flagnames:\0A        value = _flagdict[key]\0A        if (num & value):\0A            res.append(key)\0A    return res\0A\0A\0Aclass _ndptr(_ndptr_base):\0A    @classmethod\0A    def from_param(cls, obj):\0A        if not isinstance(obj, ndarray):\0A            raise TypeError(\22argument must be an ndarray\22)\0A        if cls._dtype_ is not None \\\0A               and obj.dtype != cls._dtype_:\0A            raise TypeError(\22array must have data type %s\22 % cls._dtype_)\0A        if cls._ndim_ is not None \\\0A               and obj.ndim != cls._ndim_:\0A            raise TypeError(\22array must have %d dimension(s)\22 % cls._ndim_)\0A        if cls._shape_ is not None \\\0A               and obj.shape != cls._shape_:\0A            raise TypeError(\22array must have shape %s\22 % str(cls._shape_))\0A        if cls._flags_ is not None \\\0A               and ((obj.flags.num & cls._flags_) != cls._flags_):\0A            raise TypeError(\22array must have flags %s\22 %\0A                    _flags_fromnum(cls._flags_))\0A        return obj.ctypes\0A\0A\0Aclass _concrete_ndptr(_ndptr):\0A    \22\22\22\0A    Like _ndptr, but with `_shape_` and `_dtype_` specified.\0A\0A    Notably, this means the pointer has enough information to reconstruct\0A    the array, which is not generally true.\0A    \22\22\22\0A    def _check_retval_(self):\0A        \22\22\22\0A        This method is called when this class is used as the .restype\0A        attribute for a shared-library function, to automatically wrap the\0A        pointer into an array.\0A        \22\22\22\0A        return self.contents\0A\0A    @property\0A    def contents(self):\0A        \22\22\22\0A        Get an ndarray viewing the data pointed to by this pointer.\0A\0A        This mirrors the `contents` attribute of a normal ctypes pointer\0A        \22\22\22\0A        full_dtype = _dtype((self._dtype_, self._shape_))\0A        full_ctype = ctypes.c_char * full_dtype.itemsize\0A        buffer = ctypes.cast(self, ctypes.POINTER(full_ctype)).contents\0A        return frombuffer(buffer, dtype=full_dtype).squeeze(axis=0)\0A\0A\0A# Factory for an array-checking class with from_param defined for\0A#  use with ctypes argtypes mechanism\0A_pointer_type_cache = {}\0Adef ndpointer(dtype=None, ndim=None, shape=None, flags=None):\0A    \22\22\22\0A    Array-checking restype/argtypes.\0A\0A    An ndpointer instance is used to describe an ndarray in restypes\0A    and argtypes specifications.  This approach is more flexible than\0A    using, for example, ``POINTER(c_double)``, since several restrictions\0A    can be specified, which are verified upon calling the ctypes function.\0A    These include data type, number of dimensions, shape and flags.  If a\0A    given array does not satisfy the specified restrictions,\0A    a ``TypeError`` is raised.\0A\0A    Parameters\0A    ----------\0A    dtype : data-type, optional\0A        Array data-type.\0A    ndim : int, optional\0A        Number of array dimensions.\0A    shape : tuple of ints, optional\0A        Array shape.\0A    flags : str or tuple of str\0A        Array flags; may be one or more of:\0A\0A          - C_CONTIGUOUS / C / CONTIGUOUS\0A          - F_CONTIGUOUS / F / FORTRAN\0A          - OWNDATA / O\0A          - WRITEABLE / W\0A          - ALIGNED / A\0A          - WRITEBACKIFCOPY / X\0A\0A    Returns\0A    -------\0A    klass : ndpointer type object\0A        A type object, which is an ``_ndtpr`` instance containing\0A        dtype, ndim, shape and flags information.\0A\0A    Raises\0A    ------\0A    TypeError\0A        If a given array does not satisfy the specified restrictions.\0A\0A    Examples\0A    --------\0A    >>> clib.somefunc.argtypes = [np.ctypeslib.ndpointer(dtype=np.float64,\0A    ...                                                  ndim=1,\0A    ...                                                  flags='C_CONTIGUOUS')]\0A    ... #doctest: +SKIP\0A    >>> clib.somefunc(np.array([1, 2, 3], dtype=np.float64))\0A    ... #doctest: +SKIP\0A\0A    \22\22\22\0A\0A    # normalize dtype to an Optional[dtype]\0A    if dtype is not None:\0A        dtype = _dtype(dtype)\0A\0A    # normaliz