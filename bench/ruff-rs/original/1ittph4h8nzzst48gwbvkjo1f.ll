ar\22\0A\0A\0Adef test_insert_fail(ds1):\0A    da = ds1[0]\0A    with pytest.raises(ValueError, match=\22Cannot add the same object\22):\0A        ds1.insert(2, da)\0A\0A    vals = ds1[0].values\0A    da = ds1[0].copy()\0A    da.values = vals\0A    with pytest.raises(ValueError, match=\22refer to the same data\22):\0A        ds1.insert(2, da)\0A\0A\0Adef test_remove(ds1):\0A    ds1.remove(-1)\0A    assert len(ds1) == 1\0A    assert ds1.names == [\22Foo\22]\0A\0A    ds1.remove(\22Foo\22)\0A    assert len(ds1) == 0\0A\0A\0Adef test_index_with_attribute():\0A\0A    nt = 10000\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    time = pd.date_range(start=datetime(2000, 1, 1), freq=\22S\22, periods=nt)\0A\0A    # We cannot create a mikeio.Dataset with multiple references to the same DataArray\0A    da = mikeio.DataArray(data=d, time=time)\0A    data = [da, da]\0A    with pytest.raises(ValueError):\0A        mikeio.Dataset(data)\0A\0A    # We cannot create a mikeio.Dataset with multiple references to the same data\0A    da1 = mikeio.DataArray(item=\22Foo\22, data=d, time=time)\0A    da2 = mikeio.DataArray(item=\22Bar\22, data=d, time=time)\0A    data = [da1, da2]\0A    with pytest.raises(ValueError):\0A        mikeio.Dataset(data)\0A\0A    da1 = mikeio.DataArray(item=\22Foo\22, data=d, time=time)\0A    da2 = mikeio.DataArray(item=\22Bar\22, data=d.copy(), time=time)\0A    data = [da1, da2]\0A    ds = mikeio.Dataset(data)\0A    assert ds[\22Foo\22].name == \22Foo\22\0A    assert ds.Bar.name == \22Bar\22\0A\0A    assert ds[\22Foo\22] is ds.Foo  # This is the same object\0A\0A    ds[\22Foo\22] = ds.Foo + 2.0\0A    assert (\0A        ds[\22Foo\22] is ds.Foo\0A    )  # This is now modified, but both methods points to the same object\0A\0A\0Adef test_getitem_time(ds3):\0A    # time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=100)\0A    ds_sel = ds3[\222000-1-2\22]\0A    assert ds_sel.n_timesteps == 24\0A    assert ds_sel.is_equidistant\0A\0A    ds_sel = ds3[\222000-1-2\22:\222000-1-3 00:00\22]\0A    assert ds_sel.n_timesteps == 25\0A    assert ds_sel.is_equidistant\0A\0A    time = [\222000-1-2 04:00:00\22, \222000-1-2 08:00:00\22, \222000-1-2 12:00:00\22]\0A    ds_sel = ds3[time]\0A    assert ds_sel.n_timesteps == 3\0A    assert ds_sel.is_equidistant\0A\0A    time = [ds3.time[0], ds3.time[1], ds3.time[7], ds3.time[23]]\0A    ds_sel = ds3[time]\0A    assert ds_sel.n_timesteps == 4\0A    assert not ds_sel.is_equidistant\0A\0A    ds_sel = ds3[ds3.time[:10]]\0A    assert ds_sel.n_timesteps == 10\0A    assert ds_sel.is_equidistant\0A\0A\0Adef test_getitem_multi_indexing_attempted(ds3):\0A    with pytest.raises(TypeError, match=\22not allow multi-index\22):\0A        ds3[0, 0]\0A    with pytest.warns(Warning, match=\22ambiguity\22):\0A        ds3[0, 1]  # indistinguishable from ds3[(0,1)]\0A    with pytest.raises(TypeError, match=\22not allow multi-index\22):\0A        ds3[:, 1]\0A    with pytest.raises(TypeError, match=\22not allow multi-index\22):\0A        ds3[-1, [0, 1], 1]\0A\0A\0Adef test_select_subset_isel():\0A\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    d1[0, 10, :] = 2.0\0A    d2[0, 10, :] = 3.0\0A\0A    time = pd.date_range(start=datetime(2000, 1, 1), freq=\22S\22, periods=nt)\0A\0A    geometry = mikeio.Grid2D(nx=30, ny=100, bbox=[0, 0, 1, 1])\0A\0A    data = {\0A        \22Foo\22: mikeio.DataArray(\0A            data=d1, time=time, geometry=geometry, item=ItemInfo(\22Foo\22)\0A        ),\0A        \22Bar\22: mikeio.DataArray(\0A            data=d2, time=time, geometry=geometry, item=ItemInfo(\22Bar\22)\0A        ),\0A    }\0A\0A    ds = mikeio.Dataset(data)\0A\0A    selds = ds.isel(10, axis=1)\0A\0A    assert len(selds.items) == 2\0A    assert len(selds.to_numpy()) == 2\0A    assert selds[\22Foo\22].shape == (100, 30)\0A    assert selds[\22Foo\22].to_numpy()[0, 0] == 2.0\0A    assert selds[\22Bar\22].to_numpy()[0, 0] == 3.0\0A\0A    selds_named_axis = ds.isel(10, axis=\22y\22)\0A\0A    assert len(selds_named_axis.items) == 2\0A    assert selds_named_axis[\22Foo\22].shape == (100, 30)\0A\0A\0Adef test_select_subset_isel_axis_out_of_range_error(ds2):\0A\0A    assert len(ds2.shape) == 2\0A    dss = ds2.isel(idx=0)\0A\0A    # After subsetting there is only one dimension\0A    assert len(dss.shape) == 1\0A\0A    with pytest.raises(IndexError):\0A        dss.isel(idx=0, axis=1)\0A\0A\0Adef test_isel_named_axis(ds2: mikeio.Dataset):\0A    dss = ds2.isel(time=0)\0A    assert len(dss.shape) == 1\0A\0A\0Adef test_select_temporal_subset_by_idx():\0A\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    d1[0, 10, :] = 2.0\0A    d2[0, 10, :] = 3.0\0A    data = [d1, d2]\0A\0A    time = pd.date_range(start=datetime(2000, 1, 1), freq=\22S\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    selds = ds.isel([0, 1, 2], axis=0)\0A\0A    assert len(selds) == 2\0A    assert selds[\22Foo\22].shape == (3, 100, 30)\0A\0A\0Adef test_temporal_subset_fancy():\0A\0A    nt = (24 * 31) + 1\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-1\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert ds.time[0].hour == 0\0A    assert ds.time[-1].hour == 0\0A\0A    selds = ds[\222000-01-01 00:00\22:\222000-01-02 00:00\22]\0A\0A    assert len(selds) == 2\0A    assert selds[\22Foo\22].shape == (25, 100, 30)\0A\0A    selds = ds[:\222000-01-02 00:00\22]\0A    assert selds[\22Foo\22].shape == (25, 100, 30)\0A\0A    selds = ds[\222000-01-31 00:00\22:]\0A    assert selds[\22Foo\22].shape == (25, 100, 30)\0A\0A    selds = ds[\222000-01-30\22:]\0A    assert selds[\22Foo\22].shape == (49, 100, 30)\0A\0A\0Adef test_subset_with_datetime():\0A    nt = (24 * 31) + 1\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    dssub = ds[datetime(2000, 1, 2)]\0A    assert dssub.n_timesteps == 1\0A\0A    dssub = ds[pd.Timestamp(datetime(2000, 1, 2))]\0A    assert dssub.n_timesteps == 1\0A\0A    dssub = ds[\222000-1-2\22]\0A    assert dssub.n_timesteps == 24\0A\0A\0Adef test_select_item_by_name():\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    d1[0, 10, :] = 2.0\0A    d2[0, 10, :] = 3.0\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    foo_data = ds[\22Foo\22]\0A    assert foo_data.to_numpy()[0, 10, 0] == 2.0\0A\0A\0Adef test_missing_item_error():\0A    nt = 100\0A\0A    da1 = mikeio.DataArray(\0A        data=np.zeros(nt),\0A        time=pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt),\0A        item=\22Foo\22,\0A    )\0A\0A    da2 = mikeio.DataArray(\0A        data=np.ones(nt),\0A        time=pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt),\0A        item=\22Bar\22,\0A    )\0A\0A    ds = mikeio.Dataset([da1, da2])\0A\0A    with pytest.raises(KeyError, match=\22Baz\22):\0A        ds[\22Baz\22]  # there is no Bar item\0A\0A\0Adef test_select_multiple_items_by_name():\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A    d3 = np.zeros([nt, 100, 30]) + 3.0\0A\0A    data = [d1, d2, d3]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    # items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22), ItemInfo(\22Baz\22)]\0A    items = [ItemInfo(x) for x in [\22Foo\22, \22Bar\22, \22Baz\22]]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert len(ds) == 3  # Length of a dataset is the number of items\0A\0A    newds = ds[[\22Baz\22, \22Foo\22]]\0A    assert newds.items[0].name == \22Baz\22\0A    assert newds.items[1].name == \22Foo\22\0A    assert newds[\22Foo\22].to_numpy()[0, 10, 0] == 1.5\0A\0A    assert len(newds) == 2\0A\0A\0Adef test_select_multiple_items_by_index(ds3):\0A    assert len(ds3) == 3  # Length of a dataset is the number of items\0A\0A    newds = ds3[[2, 0]]\0A    assert len(newds) == 2\0A    assert newds.items[0].name == \22Baz\22\0A    assert newds.items[1].name == \22Foo\22\0A    assert newds[\22Foo\22].to_numpy()[0, 10, 0] == 1.5\0A\0A\0Adef test_select_multiple_items_by_slice(ds3):\0A    assert len(ds3) == 3  # Length of a dataset is the number of items\0A\0A    newds = ds3[:2]\0A    assert len(newds) == 2\0A    assert newds.items[0].name == \22Foo\22\0A    assert newds.items[1].name == \22Bar\22\0A    assert newds[\22Foo\22].to_numpy()[0, 10, 0] == 1.5\0A\0A\0Adef test_select_item_by_iteminfo():\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    d1[0, 10, :] = 2.0\0A    d2[0, 10, :] = 3.0\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    foo_item = items[0]\0A\0A    foo_data = ds[foo_item]\0A    assert foo_data.to_numpy()[0, 10, 0] == 2.0\0A\0A\0Adef test_select_subset_isel_multiple_idxs():\0A\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    selds = ds.isel([10, 15], axis=1)\0A\0A    assert len(selds.items) == 2\0A    assert len(selds.to_numpy()) == 2\0A    assert selds[\22Foo\22].shape == (100, 2, 30)\0A\0A\0Adef test_decribe(ds1):\0A    df = ds1.describe()\0A    assert df.columns[0] == \22Foo\22\0A    assert df.loc[\22mean\22][1] == pytest.approx(0.2)\0A    assert df.loc[\22max\22][0] == pytest.approx(0.1)\0A\0A\0Adef test_create_undefined():\0A\0A    nt = 100\0A    d1 = np.zeros([nt])\0A    d2 = np.zeros([nt])\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    data = {\0A        \22Item 1\22: mikeio.DataArray(\0A            data=d1, time=time, item=ItemInfo(\22Item 1\22)\0A        ),  # TODO redundant name\0A        \22Item 2\22: mikeio.DataArray(data=d2, time=time, item=ItemInfo(\22Item 2\22)),\0A    }\0A\0A    ds = mikeio.Dataset(data)\0A\0A    assert len(ds.items) == 2\0A    assert len(ds.to_numpy()) == 2\0A    assert ds[0].name == \22Item 1\22\0A    assert ds[0].type == EUMType.Undefined\0A\0A\0Adef test_create_named_undefined():\0A\0A    nt = 100\0A    d1 = np.zeros([nt])\0A    d2 = np.zeros([nt])\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    ds = mikeio.Dataset(data=data, time=time, items=[\22Foo\22, \22Bar\22])\0A\0A    assert len(ds.items) == 2\0A    assert len(ds.to_numpy()) == 2\0A    assert ds[1].name == \22Bar\22\0A    assert ds[1].type == EUMType.Undefined\0A\0A\0Adef test_to_dataframe_single_timestep():\0A\0A    nt = 1\0A    d1 = np.zeros([nt])\0A    d2 = np.zeros([nt])\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A    df = ds.to_dataframe()\0A\0A    assert \22Bar\22 in df.columns\0A    # assert isinstance(df.index, pd.DatetimeIndex)\0A\0A\0Adef test_to_dataframe():\0A\0A    nt = 100\0A    d1 = np.zeros([nt])\0A    d2 = np.zeros([nt])\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A    df = ds.to_dataframe()\0A\0A    assert list(df.columns) == [\22Foo\22, \22Bar\22]\0A    assert isinstance(df.index, pd.DatetimeIndex)\0A\0A\0Adef test_multidimensional_to_dataframe_no_supported():\0A\0A    nt = 100\0A    d1 = np.zeros([nt, 2])\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset([d1], time, items)\0A\0A    with pytest.raises(ValueError):\0A        ds.to_dataframe()\0A\0A\0Adef test_get_data():\0A\0A    data = []\0A    nt = 100\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    data.append(d)\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert ds.shape == (100, 100, 30)\0A\0A\0Adef test_interp_time():\0A\0A    nt = 4\0A    d = np.zeros([nt, 10, 3])\0A    d[1] = 2.0\0A    d[3] = 4.0\0A    data = [d]\0A    time = pd.date_range(\222000-1-1\22, freq=\22D\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert ds[0].shape == (nt, 10, 3)\0A\0A    dsi = ds.interp_time(dt=3600)\0A\0A    assert ds.time[0] == dsi.time[0]\0A    assert dsi[0].shape == (73, 10, 3)\0A\0A    dsi2 = ds.interp_time(freq=\222H\22)\0A    assert dsi2.timestep == 2 * 3600\0A\0A\0Adef test_interp_time_to_other_dataset():\0A\0A    # Arrange\0A    ## mikeio.Dataset 1\0A    nt = 4\0A    data = [np.zeros([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-1\22, freq=\22D\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds1 = mikeio.Dataset(data, time, items)\0A    assert ds1.shape == (nt, 10, 3)\0A\0A    ## mikeio.Dataset 2\0A    nt = 12\0A    data = [np.ones([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-1\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds2 = mikeio.Dataset(data, time, items)\0A\0A    # Act\0A    ## interp\0A    dsi = ds1.interp_time(dt=ds2.time)\0A\0A    # Assert\0A    assert dsi.time[0] == ds2.time[0]\0A    assert dsi.time[-1] == ds2.time[-1]\0A    assert len(dsi.time) == len(ds2.time)\0A    assert dsi[0].shape[0] == ds2[0].shape[0]\0A\0A    # Accept dataset as argument\0A    dsi2 = ds1.interp_time(ds2)\0A    assert dsi2.time[0] == ds2.time[0]\0A\0A\0Adef test_extrapolate():\0A    # Arrange\0A    ## mikeio.Dataset 1\0A    nt = 2\0A    data = [np.zeros([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-1\22, freq=\22D\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds1 = mikeio.Dataset(data, time, items)\0A    assert ds1.shape == (nt, 10, 3)\0A\0A    ## mikeio.Dataset 2 partly overlapping with mikeio.Dataset 1\0A    nt = 3\0A    data = [np.ones([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds2 = mikeio.Dataset(data, time, items)\0A\0A    # Act\0A    ## interp\0A    dsi = ds1.interp_time(dt=ds2.time, fill_value=1.0)\0A\0A    # Assert\0A    assert dsi.time[0] == ds2.time[0]\0A    assert dsi.time[-1] == ds2.time[-1]\0A    assert len(dsi.time) == len(ds2.time)\0A    assert dsi[0].values[0] == pytest.approx(0.0)\0A    assert dsi[0].values[1] == pytest.approx(1.0)  # filled\0A    assert dsi[0].values[2] == pytest.approx(1.0)  # filled\0A\0A\0Adef test_extrapolate_not_allowed():\0A    ## mikeio.Dataset 1\0A    nt = 2\0A    data = [np.zeros([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-1\22, freq=\22D\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds1 = mikeio.Dataset(data, time, items)\0A    assert ds1.shape == (nt, 10, 3)\0A\0A    ## mikeio.Dataset 2 partly overlapping with mikeio.Dataset 1\0A    nt = 3\0A    data = [np.ones([nt, 10, 3])]\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds2 = mikeio.Dataset(data, time, items)\0A\0A    with pytest.raises(ValueError):\0A        dsi = ds1.interp_time(dt=ds2.time, fill_value=1.0, extrapolate=False)\0A\0A\0Adef test_get_data_2():\0A\0A    nt = 100\0A    data = []\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    data.append(d)\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert data[0].shape == (100, 100, 30)\0A\0A\0Adef test_get_data_name():\0A\0A    nt = 100\0A    data = []\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    data.append(d)\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert ds[\22Foo\22].shape == (100, 100, 30)\0A\0A\0Adef test_modify_selected_variable():\0A\0A    nt = 100\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset([np.zeros((nt, 10))], time, items)\0A\0A    assert ds.Foo.to_numpy()[0, 0] == 0.0\0A\0A    foo = ds.Foo\0A    foo_mod = foo + 1.0\0A\0A    ds[\22Foo\22] = foo_mod\0A    assert ds.Foo.to_numpy()[0, 0] == 1.0\0A\0A\0Adef test_get_bad_name():\0A    nt = 100\0A    data = []\0A    d = np.zeros([100, 100, 30]) + 1.0\0A    data.append(d)\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    with pytest.raises(Exception):\0A        ds[\22BAR\22]\0A\0A\0Adef test_flipud():\0A\0A    nt = 2\0A    d = np.random.random([nt, 100, 30])\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset([d], time, items)\0A\0A    dsud = ds.copy()\0A    dsud.flipud()\0A\0A    assert dsud.shape == ds.shape\0A    assert dsud[\22Foo\22].to_numpy()[0, 0, 0] == ds[\22Foo\22].to_numpy()[0, -1, 0]\0A\0A\0Adef test_aggregation_workflows(tmpdir):\0A    filename = \22tests/testdata/HD2D.dfsu\22\0A    dfs = mikeio.open(filename)\0A\0A    ds = dfs.read(items=[\22Surface elevation\22, \22Current speed\22])\0A    ds2 = ds.max(axis=1)\0A\0A    outfilename = os.path.join(tmpdir.dirname, \22max.dfs0\22)\0A    ds2.to_dfs(outfilename)\0A    assert os.path.isfile(outfilename)\0A\0A    ds3 = ds.min(axis=1)\0A\0A    outfilename = os.path.join(tmpdir.dirname, \22min.dfs0\22)\0A    ds3.to_dfs(outfilename)\0A    assert os.path.isfile(outfilename)\0A\0A\0Adef test_aggregation_dataset_no_time():\0A    filename = \22tests/testdata/HD2D.dfsu\22\0A    dfs = mikeio.open(filename)\0A    ds = dfs.read(time=-1, items=[\22Surface elevation\22, \22Current speed\22])\0A\0A    ds2 = ds.max()\0A    assert ds2[\22Current speed\22].values == pytest.approx(1.6463733)\0A\0A\0Adef test_aggregations():\0A    filename = \22tests/testdata/gebco_sound.dfs2\22\0A    ds = mikeio.read(filename)\0A\0A    for axis in [0, 1, 2]:\0A        ds.mean(axis=axis)\0A        ds.nanmean(axis=axis)\0A        ds.nanmin(axis=axis)\0A        ds.nanmax(axis=axis)\0A\0A    assert ds.mean().shape == (264, 216)\0A    assert ds.mean(axis=\22time\22).shape == (264, 216)\0A    assert ds.mean(axis=\22spatial\22).shape == (1,)\0A    assert ds.mean(axis=\22space\22).shape == (1,)\0A\0A    with pytest.raises(ValueError, match=\22space\22):\0A        ds.mean(axis=\22spaghetti\22)\0A\0A    dsm = ds.mean(axis=\22time\22)\0A    assert dsm.geometry is not None\0A\0A\0Adef test_to_dfs_extension_validation(tmpdir):\0A\0A    outfilename = os.path.join(tmpdir, \22not_gonna_happen.dfs2\22)\0A\0A    ds = mikeio.read(\0A        \22tests/testdata/HD2D.dfsu\22, items=[\22Surface elevation\22, \22Current speed\22]\0A    )\0A    with pytest.raises(ValueError) as excinfo:\0A        ds.to_dfs(outfilename)\0A\0A    assert \22dfsu\22 in str(excinfo.value)\0A\0A\0Adef test_weighted_average(tmpdir):\0A    filename = \22tests/testdata/HD2D.dfsu\22\0A    dfs = mikeio.open(filename)\0A\0A    ds = dfs.read(items=[\22Surface elevation\22, \22Current speed\22])\0A\0A    area = dfs.get_element_area()\0A    ds2 = ds.average(weights=area, axis=1)\0A\0A    outfilename = os.path.join(tmpdir.dirname, \22average.dfs0\22)\0A    ds2.to_dfs(outfilename)\0A    assert os.path.isfile(outfilename)\0A\0A\0Adef test_quantile_axis1(ds1):\0A    dsq = ds1.quantile(q=0.345, axis=1)\0A    assert dsq[0].to_numpy()[0] == 0.1\0A    assert dsq[1].to_numpy()[0] == 0.2\0A\0A    assert dsq.n_items == ds1.n_items\0A    assert dsq.n_timesteps == ds1.n_timesteps\0A\0A    # q as list\0A    dsq = ds1.quantile(q=[0.25, 0.75], axis=1)\0A    assert dsq.n_items == 2 * ds1.n_items\0A    assert \22Quantile 0.75, \22 in dsq.items[1].name\0A    assert \22Quantile 0.25, \22 in dsq.items[2].name\0A\0A\0Adef test_quantile_axis0(ds1):\0A    dsq = ds1.quantile(q=0.345)  # axis=0 is default\0A    assert dsq[0].to_numpy()[0] == 0.1\0A    assert dsq[1].to_numpy()[0] == 0.2\0A\0A    assert dsq.n_items == ds1.n_items\0A    assert dsq.n_timesteps == 1\0A    assert dsq.shape[-1] == ds1.shape[-1]\0A\0A    # q as list\0A    dsq = ds1.quantile(q=[0.25, 0.75], axis=0)\0A    assert dsq.n_items == 2 * ds1.n_items\0A    assert dsq[0].to_numpy()[0] == 0.1\0A    assert dsq[1].to_numpy()[0] == 0.1\0A    assert dsq[2].to_numpy()[0] == 0.2\0A    assert dsq[3].to_numpy()[0] == 0.2\0A\0A    assert \22Quantile 0.75, \22 in dsq.items[1].name\0A    assert \22Quantile 0.25, \22 in dsq.items[2].name\0A    assert \22Quantile 0.75, \22 in dsq.items[3].name\0A\0A\0Adef test_nanquantile():\0A    q = 0.99\0A    fn = \22tests/testdata/random.dfs0\22  # has delete value\0A    ds = mikeio.read(fn)\0A\0A    dsq1 = ds.quantile(q=q)\0A    dsq2 = ds.nanquantile(q=q)\0A\0A    assert np.isnan(dsq1[0].to_numpy())\0A    assert not np.isnan(dsq2[0].to_numpy())\0A\0A    qnt = np.quantile(ds[0].to_numpy(), q=q)\0A    nqnt = np.nanquantile(ds[0].to_numpy(), q=q)\0A\0A    assert np.isnan(qnt)\0A    assert dsq2[0].to_numpy() == nqnt\0A\0A\0Adef test_aggregate_across_items():\0A\0A    ds = mikeio.read(\22tests/testdata/State_wlbc_north_err.dfs1\22)\0A\0A    with pytest.warns(FutureWarning):  # TODO: remove in 1.5.0\0A        dam = ds.max(axis=\22items\22)\0A\0A    assert isinstance(dam, mikeio.DataArray)\0A    assert dam.geometry == ds.geometry\0A    assert dam.dims == ds.dims\0A    assert dam.type == ds[-1].type\0A\0A    dsm = ds.mean(axis=\22items\22, keepdims=True)\0A\0A    assert isinstance(dsm, mikeio.Dataset)\0A    assert dsm.geometry == ds.geometry\0A    assert dsm.dims == ds.dims\0A\0A\0Adef test_aggregate_selected_items_dfsu_save_to_new_file(tmpdir):\0A\0A    ds = mikeio.read(\22tests/testdata/State_Area.dfsu\22, items=\22*Level*\22)\0A\0A    assert ds.n_items == 5\0A\0A    with pytest.warns(FutureWarning):  # TODO: remove keepdims in 1.5.0\0A        dsm = ds.max(\0A            axis=\22items\22, keepdims=True, name=\22Max Water Level\22\0A        )  # add a nice name\0A    assert len(dsm) == 1\0A    assert dsm[0].name == \22Max Water Level\22\0A    assert dsm.geometry == ds.geometry\0A    assert dsm.dims == ds.dims\0A    assert dsm[0].type == ds[-1].type\0A\0A    outfilename = os.path.join(tmpdir, \22maxwl.dfsu\22)\0A    dsm.to_dfs(outfilename)\0A\0A\0Adef test_copy():\0A    nt = 100\0A    d1 = np.zeros([nt, 100, 30]) + 1.5\0A    d2 = np.zeros([nt, 100, 30]) + 2.0\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert len(ds.items) == 2\0A    assert len(ds.to_numpy()) == 2\0A    assert ds[0].name == \22Foo\22\0A\0A    ds2 = ds.copy()\0A\0A    ds2[0].name = \22New name\22\0A\0A    assert ds2[0].name == \22New name\22\0A    assert ds[0].name == \22Foo\22\0A\0A\0Adef test_dropna():\0A    nt = 10\0A    d1 = np.zeros([nt, 100, 30])\0A    d2 = np.zeros([nt, 100, 30])\0A\0A    d1[9:] = np.nan\0A    d2[8:] = np.nan\0A\0A    data = [d1, d2]\0A\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    assert len(ds.items) == 2\0A    assert len(ds.to_numpy()) == 2\0A\0A    ds2 = ds.dropna()\0A\0A    assert ds2.n_timesteps == 8\0A\0A\0Adef test_default_type():\0A\0A    item = ItemInfo(\22Foo\22)\0A    assert item.type == EUMType.Undefined\0A    assert repr(item.unit) == \22undefined\22\0A\0A\0Adef test_int_is_valid_type_info():\0A\0A    item = ItemInfo(\22Foo\22, 100123)\0A    assert item.type == EUMType.Viscosity\0A\0A    item = ItemInfo(\22U\22, 100002)\0A    assert item.type == EUMType.Wind_Velocity\0A\0A\0Adef test_int_is_valid_unit_info():\0A\0A    item = ItemInfo(\22U\22, 100002, 2000)\0A    assert item.type == EUMType.Wind_Velocity\0A    assert item.unit == EUMUnit.meter_per_sec\0A    assert repr(item.unit) == \22meter per sec\22  # TODO replace _per_ with /\0A\0A\0Adef test_default_unit_from_type():\0A\0A    item = ItemInfo(\22Foo\22, EUMType.Water_Level)\0A    assert item.type == EUMType.Water_Level\0A    assert item.unit == EUMUnit.meter\0A    assert repr(item.unit) == \22meter\22\0A\0A    item = ItemInfo(\22Tp\22, EUMType.Wave_period)\0A    assert item.type == EUMType.Wave_period\0A    assert item.unit == EUMUnit.second\0A    assert repr(item.unit) == \22second\22\0A\0A    item = ItemInfo(\22Temperature\22, EUMType.Temperature)\0A    assert item.type == EUMType.Temperature\0A    assert item.unit == EUMUnit.degree_Celsius\0A    assert repr(item.unit) == \22degree Celsius\22\0A\0A\0Adef test_default_name_from_type():\0A\0A    item = ItemInfo(EUMType.Current_Speed)\0A    assert item.name == \22Current Speed\22\0A    assert item.unit == EUMUnit.meter_per_sec\0A\0A    item2 = ItemInfo(EUMType.Current_Direction, EUMUnit.degree)\0A    assert item2.unit == EUMUnit.degree\0A    item3 = ItemInfo(\0A        \22Current direction (going to)\22, EUMType.Current_Direction, EUMUnit.degree\0A    )\0A    assert item3.type == EUMType.Current_Direction\0A    assert item3.unit == EUMUnit.degree\0A\0A\0Adef test_iteminfo_string_type_should_fail_with_helpful_message():\0A\0A    with pytest.raises(ValueError):\0A\0A        item = ItemInfo(\22Water level\22, \22Water level\22)\0A\0A\0Adef test_item_search():\0A\0A    res = EUMType.search(\22level\22)\0A\0A    assert len(res) > 0\0A    assert isinstance(res[0], EUMType)\0A\0A\0Adef test_dfsu3d_dataset():\0A\0A    filename = \22tests/testdata/oresund_sigma_z.dfsu\22\0A\0A    dfsu = mikeio.open(filename)\0A\0A    ds = dfsu.read()\0A\0A    text = repr(ds)\0A\0A    assert len(ds) == 2  # Salinity, Temperature\0A\0A    dsagg = ds.nanmean(axis=0)  # Time averaged\0A\0A    assert len(dsagg) == 2  # Salinity, Temperature\0A\0A    assert dsagg[0].shape[0] == 17118\0A\0A    assert dsagg.time[0] == ds.time[0]  # Time-averaged data index by start time\0A\0A    ds_elm = dfsu.read(elements=[0])\0A\0A    assert len(ds_elm) == 2  # Salinity, Temperature\0A\0A    dss = ds_elm.squeeze()\0A\0A    assert len(dss) == 2  # Salinity, Temperature\0A\0A\0Adef test_items_data_mismatch():\0A\0A    nt = 100\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22), ItemInfo(\22Bar\22)]  # Two items is not correct!\0A\0A    with pytest.raises(ValueError):\0A        mikeio.Dataset([d], time, items)\0A\0A\0Adef test_time_data_mismatch():\0A\0A    nt = 100\0A    d = np.zeros([nt, 100, 30]) + 1.0\0A    time = pd.date_range(\0A        \222000-1-2\22, freq=\22H\22, periods=nt + 1\0A    )  # 101 timesteps is not correct!\0A    items = [ItemInfo(\22Foo\22)]\0A\0A    with pytest.raises(ValueError):\0A        mikeio.Dataset([d], time, items)\0A\0A\0Adef test_properties_dfs2():\0A    filename = \22tests/testdata/gebco_sound.dfs2\22\0A    ds = mikeio.read(filename)\0A\0A    assert ds.n_timesteps == 1\0A    assert ds.n_items == 1\0A    assert np.all(ds.shape == (1, 264, 216))\0A    assert ds.n_elements == (264 * 216)\0A    assert ds.is_equidistant\0A\0A\0Adef test_properties_dfsu():\0A    filename = \22tests/testdata/oresund_vertical_slice.dfsu\22\0A    ds = mikeio.read(filename)\0A\0A    assert ds.n_timesteps == 3\0A    assert ds.start_time == datetime(1997, 9, 15, 21, 0, 0)\0A    assert ds.end_time == datetime(1997, 9, 16, 3, 0, 0)\0A    assert ds.timestep == (3 * 3600)\0A    assert ds.n_items == 2\0A    assert np.all(ds.shape == (3, 441))\0A    assert ds.n_elements == 441\0A    assert ds.is_equidistant\0A\0A\0Adef test_create_empty_data():\0A    ne = 34\0A    d = mikeio.Dataset.create_empty_data(n_elements=ne)\0A    assert len(d) == 1\0A    assert d[0].shape == (1, ne)\0A\0A    nt = 100\0A    d = mikeio.Dataset.create_empty_data(n_timesteps=nt, shape=(3, 4, 6))\0A    assert len(d) == 1\0A    assert d[0].shape == (nt, 3, 4, 6)\0A\0A    ni = 4\0A    d = mikeio.Dataset.create_empty_data(n_items=ni, n_elements=ne)\0A    assert len(d) == ni\0A    assert d[-1].shape == (1, ne)\0A\0A    with pytest.raises(Exception):\0A        d = mikeio.Dataset.create_empty_data()\0A\0A    with pytest.raises(Exception):\0A        d = mikeio.Dataset.create_empty_data(n_elements=None, shape=None)\0A\0A\0Adef test_create_infer_name_from_eum():\0A\0A    nt = 100\0A    d = np.random.uniform(size=nt)\0A\0A    ds = mikeio.Dataset(\0A        data=[d],\0A        time=pd.date_range(\222000-01-01\22, freq=\22H\22, periods=nt),\0A        items=[EUMType.Wind_speed],\0A    )\0A\0A    assert isinstance(ds.items[0], ItemInfo)\0A    assert ds.items[0].type == EUMType.Wind_speed\0A    assert ds.items[0].name == \22Wind speed\22\0A\0A\0Adef test_add_scalar(ds1):\0A    ds2 = ds1 + 10.0\0A    assert np.all(ds2[0].to_numpy() - ds1[0].to_numpy() == 10.0)\0A\0A    ds3 = 10.0 + ds1\0A    assert np.all(ds3[0].to_numpy() == ds2[0].to_numpy())\0A    assert np.all(ds3[1].to_numpy() == ds2[1].to_numpy())\0A\0A\0Adef test_add_inconsistent_dataset(ds1):\0A\0A    ds2 = ds1[[0]]\0A\0A    assert len(ds1) != len(ds2)\0A\0A    with pytest.raises(ValueError):\0A        ds1 + ds2\0A\0A    with pytest.raises(ValueError):\0A        ds1 * ds2\0A\0A\0Adef test_add_bad_value(ds1):\0A\0A    with pytest.raises(ValueError):\0A        ds1 + [\22one\22]\0A\0A\0Adef test_multiple_bad_value(ds1):\0A\0A    with pytest.raises(ValueError):\0A        ds1 * [\22pi\22]\0A\0A\0Adef test_sub_scalar(ds1):\0A    ds2 = ds1 - 10.0\0A    assert isinstance(ds2, mikeio.Dataset)\0A    assert np.all(ds1[0].to_numpy() - ds2[0].to_numpy() == 10.0)\0A\0A    ds3 = 10.0 - ds1\0A    assert isinstance(ds3, mikeio.Dataset)\0A    assert np.all(ds3[0].to_numpy() == 9.9)\0A    assert np.all(ds3[1].to_numpy() == 9.8)\0A\0A\0Adef test_mul_scalar(ds1):\0A    ds2 = ds1 * 2.0\0A    assert np.all(ds2[0].to_numpy() * 0.5 == ds1[0].to_numpy())\0A\0A    ds3 = 2.0 * ds1\0A    assert np.all(ds3[0].to_numpy() == ds2[0].to_numpy())\0A    assert np.all(ds3[1].to_numpy() == ds2[1].to_numpy())\0A\0A\0Adef test_add_dataset(ds1, ds2):\0A    ds3 = ds1 + ds2\0A    assert np.all(ds3[0].to_numpy() == 1.1)\0A    assert np.all(ds3[1].to_numpy() == 2.2)\0A\0A    ds4 = ds2 + ds1\0A    assert np.all(ds3[0].to_numpy() == ds4[0].to_numpy())\0A    assert np.all(ds3[1].to_numpy() == ds4[1].to_numpy())\0A\0A    ds2b = ds2.copy()\0A    ds2b[0].item = ItemInfo(EUMType.Wind_Velocity)\0A    with pytest.raises(ValueError):\0A        # item type does not match\0A        ds1 + ds2b\0A\0A    ds2c = ds2.copy()\0A    tt = ds2c.time.to_numpy()\0A    tt[-1] = tt[-1] + np.timedelta64(1, \22s\22)\0A    ds2c.time = pd.DatetimeIndex(tt)\0A    with pytest.raises(ValueError):\0A        # time does not match\0A        ds1 + ds2c\0A\0A\0Adef test_sub_dataset(ds1, ds2):\0A    ds3 = ds2 - ds1\0A    assert np.all(ds3[0].to_numpy() == 0.9)\0A    assert np.all(ds3[1].to_numpy() == 1.8)\0A\0A\0Adef test_non_equidistant():\0A    nt = 4\0A    d = np.random.uniform(size=nt)\0A\0A    ds = mikeio.Dataset(\0A        data=[d],\0A        time=[\0A            datetime(2000, 1, 1),\0A            datetime(2001, 1, 1),\0A            datetime(2002, 1, 1),\0A            datetime(2003, 1, 1),\0A        ],\0A    )\0A\0A    assert not ds.is_equidistant\0A\0A\0Adef test_concat_dataarray_by_time():\0A    da1 = mikeio.read(\22tests/testdata/tide1.dfs1\22)[0]\0A    da2 = mikeio.read(\22tests/testdata/tide2.dfs1\22)[0]\0A    da3 = mikeio.DataArray.concat([da1, da2])\0A\0A    assert da3.start_time == da1.start_time\0A    assert da3.start_time < da2.start_time\0A    assert da3.end_time == da2.end_time\0A    assert da3.end_time > da1.end_time\0A    assert da3.n_timesteps == 145\0A    assert da3.is_equidistant\0A\0A\0Adef test_concat_by_time():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22)\0A    ds2 = mikeio.read(\22tests/testdata/tide2.dfs1\22) + 0.5  # add offset\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert isinstance(ds3, mikeio.Dataset)\0A    assert len(ds1) == len(ds2) == len(ds3)\0A    assert ds3.start_time == ds1.start_time\0A    assert ds3.start_time < ds2.start_time\0A    assert ds3.end_time == ds2.end_time\0A    assert ds3.end_time > ds1.end_time\0A    assert ds3.n_timesteps == 145\0A    assert ds3.is_equidistant\0A\0A\0Adef test_concat_by_time_ndim1():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22).isel(x=0)\0A    ds2 = mikeio.read(\22tests/testdata/tide2.dfs1\22).isel(x=0)\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert isinstance(ds3, mikeio.Dataset)\0A    assert len(ds1) == len(ds2) == len(ds3)\0A    assert ds3.start_time == ds1.start_time\0A    assert ds3.start_time < ds2.start_time\0A    assert ds3.end_time == ds2.end_time\0A    assert ds3.end_time > ds1.end_time\0A    assert ds3.n_timesteps == 145\0A    assert ds3.is_equidistant\0A\0A\0Adef test_concat_by_time_inconsistent_shape_not_possible():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22).isel(x=[0, 1])\0A    ds2 = mikeio.read(\22tests/testdata/tide2.dfs1\22).isel(x=[0, 1, 2])\0A    with pytest.raises(ValueError, match=\22Shape\22):\0A        mikeio.Dataset.concat([ds1, ds2])\0A\0A\0A# TODO: implement this\0Adef test_concat_by_time_no_time():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22, time=0)\0A    ds2 = mikeio.read(\22tests/testdata/tide2.dfs1\22, time=1)\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert ds3.n_timesteps == 2\0A\0A\0Adef test_concat_by_time_2():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22, time=range(0, 12))\0A    ds2 = mikeio.read(\22tests/testdata/tide2.dfs1\22)\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert ds3.n_timesteps == 109\0A    assert not ds3.is_equidistant\0A\0A    # create concatd datasets in 8 chunks of 6 hours\0A    dsall = []\0A    for j in range(8):\0A        dsall.append(\0A            mikeio.read(\0A                \22tests/testdata/tide1.dfs1\22, time=range(j * 12, 1 + (j + 1) * 12)\0A            )\0A        )\0A    ds4 = mikeio.Dataset.concat(dsall)\0A    assert len(dsall) == 8\0A    assert ds4.n_timesteps == 97\0A    assert ds4.is_equidistant\0A\0A\0Adef test_renamed_dataset_has_updated_attributes(ds1: mikeio.Dataset):\0A    assert hasattr(ds1, \22Foo\22)\0A    assert isinstance(ds1.Foo, mikeio.DataArray)\0A    ds2 = ds1.rename(dict(Foo=\22Baz\22))\0A    assert not hasattr(ds2, \22Foo\22)\0A    assert hasattr(ds2, \22Baz\22)\0A    assert isinstance(ds2.Baz, mikeio.DataArray)\0A\0A    # inplace version\0A    ds1.rename(dict(Foo=\22Baz\22), inplace=True)\0A    assert not hasattr(ds1, \22Foo\22)\0A    assert hasattr(ds1, \22Baz\22)\0A    assert isinstance(ds1.Baz, mikeio.DataArray)\0A\0A\0Adef test_merge_by_item():\0A    ds1 = mikeio.read(\22tests/testdata/tide1.dfs1\22)\0A    ds2 = mikeio.read(\22tests/testdata/tide1.dfs1\22)\0A    old_name = ds2[0].name\0A    new_name = old_name + \22 v2\22\0A    # ds2[0].name = ds2[0].name + \22 v2\22\0A    ds2.rename({old_name: new_name}, inplace=True)\0A    ds3 = mikeio.Dataset.merge([ds1, ds2])\0A\0A    assert isinstance(ds3, mikeio.Dataset)\0A    assert ds3.n_items == 2\0A    assert ds3[1].name == ds1[0].name + \22 v2\22\0A\0A\0Adef test_merge_by_item_dfsu_3d():\0A    ds1 = mikeio.read(\22tests/testdata/oresund_sigma_z.dfsu\22, items=[0])\0A    assert ds1.n_items == 1\0A    ds2 = mikeio.read(\22tests/testdata/oresund_sigma_z.dfsu\22, items=[1])\0A    assert ds2.n_items == 1\0A\0A    ds3 = mikeio.Dataset.merge([ds1, ds2])\0A\0A    assert isinstance(ds3, mikeio.Dataset)\0A    itemnames = [x.name for x in ds3.items]\0A    assert \22Salinity\22 in itemnames\0A    assert \22Temperature\22 in itemnames\0A    assert ds3.n_items == 2\0A\0A\0Adef test_to_numpy(ds2):\0A\0A    X = ds2.to_numpy()\0A\0A    assert X.shape == (ds2.n_items,) + ds2.shape\0A    assert isinstance(X, np.ndarray)\0A\0A\0Adef test_concat():\0A    filename = \22tests/testdata/HD2D.dfsu\22\0A    ds1 = mikeio.read(filename, time=[0, 1])\0A    ds2 = mikeio.read(filename, time=[2, 3])\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A    ds3.n_timesteps\0A\0A    assert ds1.n_items == ds2.n_items == ds3.n_items\0A    assert ds3.n_timesteps == (ds1.n_timesteps + ds2.n_timesteps)\0A    assert ds3.start_time == ds1.start_time\0A    assert ds3.end_time == ds2.end_time\0A    assert type(ds3.geometry) == type(ds1.geometry)\0A    assert ds3.geometry.n_elements == ds1.geometry.n_elements\0A\0A\0Adef test_concat_dfsu3d():\0A    filename = \22tests/testdata/basin_3d.dfsu\22\0A    ds = mikeio.read(filename)\0A    ds1 = mikeio.read(filename, time=[0, 1])\0A    ds2 = mikeio.read(filename, time=[1, 2])\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert ds1.n_items == ds2.n_items == ds3.n_items\0A    assert ds3.start_time == ds.start_time\0A    assert ds3.end_time == ds.end_time\0A    assert type(ds3.geometry) == type(ds.geometry)\0A    assert ds3.geometry.n_elements == ds1.geometry.n_elements\0A    assert ds3._zn.shape == ds._zn.shape\0A    assert np.all(ds3._zn == ds._zn)\0A\0A\0Adef test_concat_dfsu3d_single_timesteps():\0A    filename = \22tests/testdata/basin_3d.dfsu\22\0A    ds = mikeio.read(filename)\0A    ds1 = mikeio.read(filename, time=0)\0A    ds2 = mikeio.read(filename, time=2)\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert ds1.n_items == ds2.n_items == ds3.n_items\0A    assert ds3.start_time == ds1.start_time\0A    assert ds3.end_time == ds2.end_time\0A\0A\0Adef test_concat_dfs2_single_timesteps():\0A    filename = \22tests/testdata/single_row.dfs2\22\0A    ds = mikeio.read(filename)\0A    ds1 = mikeio.read(filename, time=0)\0A    ds2 = mikeio.read(filename, time=2)\0A    ds3 = mikeio.Dataset.concat([ds1, ds2])\0A\0A    assert ds1.n_items == ds2.n_items == ds3.n_items\0A    assert ds3.start_time == ds1.start_time\0A    assert ds3.end_time == ds2.end_time\0A    assert ds3.n_timesteps == 2\0A\0A\0Adef test_merge_same_name_error():\0A    filename = \22tests/testdata/HD2D.dfsu\22\0A    ds1 = mikeio.read(filename, items=0)\0A    ds2 = mikeio.read(filename, items=0)\0A\0A    assert ds1.items[0].name == ds2.items[0].name\0A\0A    with pytest.raises(ValueError):\0A        mikeio.Dataset.merge([ds1, ds2])\0A\0A\0Adef test_incompatible_data_not_allowed():\0A\0A    da1 = mikeio.read(\22tests/testdata/HD2D.dfsu\22)[0]\0A    da2 = mikeio.read(\22tests/testdata/oresundHD_run1.dfsu\22)[1]\0A\0A    with pytest.raises(ValueError) as excinfo:\0A        mikeio.Dataset([da1, da2])\0A\0A    assert \22shape\22 in str(excinfo.value).lower()\0A\0A    da1 = mikeio.read(\22tests/testdata/tide1.dfs1\22)[0]\0A    da2 = mikeio.read(\22tests/testdata/tide2.dfs1\22)[0]\0A\0A    with pytest.raises(ValueError) as excinfo:\0A        mikeio.Dataset([da1, da2])\0A\0A    assert \22name\22 in str(excinfo.value).lower()\0A\0A    da1 = mikeio.read(\22tests/testdata/tide1.dfs1\22)[0]\0A    da2 = mikeio.read(\22tests/testdata/tide2.dfs1\22)[0]\0A    da2.name = \22Foo\22\0A\0A    with pytest.raises(ValueError) as excinfo:\0A        mikeio.Dataset([da1, da2])\0A\0A    assert \22time\22 in str(excinfo.value).lower()\0A\0A\0Adef test_xzy_selection():\0A    # select in space via x,y,z coordinates test\0A    filename = \22tests/testdata/oresund_sigma_z.dfsu\22\0A    ds = mikeio.read(filename)\0A\0A    with pytest.raises(OutsideModelDomainError):\0A        ds.sel(x=340000, y=15.75, z=0)\0A\0A\0Adef test_layer_selection():\0A    # select layer test\0A    filename = \22tests/testdata/oresund_sigma_z.dfsu\22\0A    ds = mikeio.read(filename)\0A\0A    dss_layer = ds.sel(layers=0)\0A    # should not be layered after selection\0A    assert type(dss_layer.geometry) == mikeio.spatial.FM_geometry.GeometryFM\0A\0A\0Adef test_time_selection():\0A    # select time test\0A    nt = 100\0A    data = []\0A    d = np.random.rand(nt)\0A    data.append(d)\0A    time = pd.date_range(\222000-1-2\22, freq=\22H\22, periods=nt)\0A    items = [ItemInfo(\22Foo\22)]\0A    ds = mikeio.Dataset(data, time, items)\0A\0A    # check for string input\0A    dss_t = ds.sel(time=\222000-01-05\22)\0A    # and index based\0A    dss_tix = ds.sel(time=80)\0A\0A    assert dss_t.shape == (24,)\0A    assert len(dss_tix) == 1\0A\0A\0Adef test_create_dataset_with_many_items():\0A    n_items = 800\0A    nt = 2\0A    time = pd.date_range(\222000\22, freq=\22H\22, periods=nt)\0A\0A    das = []\0A\0A    for i in range(n_items):\0A        x = np.random.random(nt)\0A        da = mikeio.DataArray(data=x, time=time, item=mikeio.ItemInfo(f\22Item {i+1}\22))\0A        das.append(da)\0A\0A    ds = mikeio.Dataset(das)\0A\0A    assert ds.n_items == n_items\0A\0A\0Adef test_create_array_with_defaults_from_dataset():\0A\0A    filename = \22tests/testdata/oresund_sigma_z.dfsu\22\0A    ds: mikeio.Dataset = mikeio.read(filename)\0A\0A    values = np.zeros(ds.Temperature.shape)\0A\0A    da = ds.create_data_array(values)\0A\0A    assert isinstance(da, mikeio.DataArray)\0A    assert da.geometry == ds.geometry\0A    assert all(da.time == ds.time)\0A    assert da.item.type == mikeio.EUMType.Undefined\0A\0A    da_name = ds.create_data_array(values, \22Foo\22)\0A\0A    assert isinstance(da, mikeio.DataArray)\0A    assert da_name.geometry == ds.geometry\0A    assert da_name.item.type == mikeio.EUMType.Undefined\0A    assert da_name.name == \22Foo\22\0A\0A    da_eum = ds.create_data_array(\0A        values, item=mikeio.ItemInfo(\22TS\22, mikeio.EUMType.Temperature)\0A    )\0A\0A    assert isinstance(da_eum, mikeio.DataArray)\0A    assert da_eum.geometry == ds.geometry\0A    assert da_eum.item.type == mikeio.EUMType.Temperature\0A\0A\0Adef test_dataset_plot(ds1):\0A    ax = ds1.isel(x=0).plot()\0A    assert len(ax.lines) == 2\0A    ds2 = ds1 + 0.01\0A    ax = ds2.isel(x=-1).plot(ax=ax)\0A    assert len(ax.lines) == 4\0A\0A\0Adef test_interp_na():\0A    time = pd.date_range(\222000\22, periods=5, freq=\22D\22)\0A    da = mikeio.DataArray(\0A        data=np.array([np.nan, 1.0, np.nan, np.nan, 4.0]),\0A        time=time,\0A        item=ItemInfo(name=\22Foo\22),\0A    )\0A    da2 = mikeio.DataArray(\0A        data=np.array([np.nan, np.nan, np.nan, 4.0, 4.0]),\0A        time=time,\0A        item=ItemInfo(name=\22Bar\22),\0A    )\0A\0A    ds = mikeio.Dataset([da, da2])\0A\0A    dsi = ds.interp_na()\0A    assert np.isnan(dsi[0].to_numpy()[0])\0A    assert dsi.Foo.to_numpy()[2] == pytest.approx(2.0)\0A    assert np.isnan(dsi.Foo.to_numpy()[0])\0A\0A    dsi = ds.interp_na(fill_value=\22extrapolate\22)\0A    assert dsi.Foo.to_numpy()[0] == pytest.approx(0.0)\0A    assert dsi.Bar.to_numpy()[2] == pytest.approx(4.0)\0A\0A\0Adef test_plot_scatter():\0A    ds = mikeio.read(\22tests/testdata/oresund_sigma_z.dfsu\22, time=0)\0A    ds.plot.scatter(x=\22Salinity\22, y=\22Temperature\22, title=\22S-vs-T\22)\0A", align 1
