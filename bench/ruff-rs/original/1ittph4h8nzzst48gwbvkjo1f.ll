          brand = PaymentCardBrand.amex\0A        else:\0A            brand = PaymentCardBrand.other\0A\0A        required_length: Union[None, int, str] = None\0A        if brand in PaymentCardBrand.mastercard:\0A            required_length = 16\0A            valid = len(card_number) == required_length\0A        elif brand == PaymentCardBrand.visa:\0A            required_length = '13, 16 or 19'\0A            valid = len(card_number) in {13, 16, 19}\0A        elif brand == PaymentCardBrand.amex:\0A            required_length = 15\0A            valid = len(card_number) == required_length\0A        else:\0A            valid = True\0A\0A        if not valid:\0A            raise PydanticCustomError(\0A                'payment_card_number_brand',\0A                'Length for a {brand} card must be {required_length}',\0A                {'brand': brand, 'required_length': required_length},\0A            )\0A        return brand\0A\0A\0A# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ BYTE SIZE TYPE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\0A\0ABYTE_SIZES = {\0A    'b': 1,\0A    'kb': 10**3,\0A    'mb': 10**6,\0A    'gb': 10**9,\0A    'tb': 10**12,\0A    'pb': 10**15,\0A    'eb': 10**18,\0A    'kib': 2**10,\0A    'mib': 2**20,\0A    'gib': 2**30,\0A    'tib': 2**40,\0A    'pib': 2**50,\0A    'eib': 2**60,\0A}\0ABYTE_SIZES.update({k.lower()[0]: v for k, v in BYTE_SIZES.items() if 'i' not in k})\0Abyte_string_re = re.compile(r'^\\s*(\\d*\\.?\\d+)\\s*(\\w+)?', re.IGNORECASE)\0A\0A\0Aclass ByteSize(int):\0A    @classmethod\0A    def __get_pydantic_core_schema__(cls, **_kwargs: Any) -> core_schema.FunctionPlainSchema:\0A        # TODO better schema\0A        return core_schema.function_plain_schema(cls.validate)\0A\0A    @classmethod\0A    def validate(cls, __input_value: Any, _: core_schema.ValidationInfo) -> 'ByteSize':\0A        try:\0A            return cls(int(__input_value))\0A        except ValueError:\0A            pass\0A\0A        str_match = byte_string_re.match(str(__input_value))\0A        if str_match is None:\0A            raise PydanticCustomError('byte_size', 'could not parse value and unit from byte string')\0A\0A        scalar, unit = str_match.groups()\0A        if unit is None:\0A            unit = 'b'\0A\0A        try:\0A            unit_mult = BYTE_SIZES[unit.lower()]\0A        except KeyError:\0A            raise PydanticCustomError('byte_size_unit', 'could not interpret byte unit: {unit}', {'unit': unit})\0A\0A        return cls(int(float(scalar) * unit_mult))\0A\0A    def human_readable(self, decimal: bool = False) -> str:\0A        if decimal:\0A            divisor = 1000\0A            units = 'B', 'KB', 'MB', 'GB', 'TB', 'PB'\0A            final_unit = 'EB'\0A        else:\0A            divisor = 1024\0A            units = 'B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'\0A            final_unit = 'EiB'\0A\0A        num = float(self)\0A        for unit in units:\0A            if abs(num) < divisor:\0A                if unit == 'B':\0A                    return f'{num:0.0f}{unit}'\0A                else:\0A                    return f'{num:0.1f}{unit}'\0A            num /= divisor\0A\0A        return f'{num:0.1f}{final_unit}'\0A\0A    def to(self, unit: str) -> float:\0A        try:\0A            unit_div = BYTE_SIZES[unit.lower()]\0A        except KeyError:\0A            raise PydanticCustomError('byte_size_unit', 'Could not interpret byte unit: {unit}', {'unit': unit})\0A\0A        return self / unit_div\0A\0A\0A# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ DATE TYPES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\0A\0Aif TYPE_CHECKING:\0A    PastDate = Annotated[date, ...]\0A    FutureDate = Annotated[date, ...]\0Aelse:\0A\0A    class PastDate:\0A        @classmethod\0A        def __get_pydantic_core_schema__(\0A            cls, schema: core_schema.CoreSchema | None = None, **_kwargs: Any\0A        ) -> core_schema.CoreSchema:\0A            if schema is None:\0A                # used directly as a type\0A                return core_schema.date_schema(now_op='past')\0A            else:\0A                assert schema['type'] == 'date'\0A                schema['now_op'] = 'past'\0A                return schema\0A\0A        def __repr__(self) -> str:\0A            return 'PastDate'\0A\0A    class FutureDate:\0A        @classmethod\0A        def __get_pydantic_core_schema__(\0A            cls, schema: core_schema.CoreSchema | None = None, **_kwargs: Any\0A        ) -> core_schema.CoreSchema:\0A            if schema is None:\0A                # used directly as a type\0A                return core_schema.date_schema(now_op='future')\0A            else:\0A                assert schema['type'] == 'date'\0A                schema['now_op'] = 'future'\0A                return schema\0A\0A        def __repr__(self) -> str:\0A            return 'FutureDate'\0A\0A\0Adef condate(*, strict: bool = None, gt: date = None, ge: date = None, lt: date = None, le: date = None) -> type[date]:\0A    return Annotated[  # type: ignore[return-value]\0A        date,\0A        Strict(strict) if strict is not None else None,\0A        annotated_types.Interval(gt=gt, ge=ge, lt=lt, le=le),\0A    ]\0A\0A\0A# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ DATETIME TYPES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\0A\0Aif TYPE_CHECKING:\0A    AwareDatetime = Annotated[datetime, ...]\0A    NaiveDatetime = Annotated[datetime, ...]\0Aelse:\0A\0A    class AwareDatetime:\0A        @classmethod\0A        def __get_pydantic_core_schema__(\0A            cls, schema: core_schema.CoreSchema | None = None, **_kwargs: Any\0A        ) -> core_schema.CoreSchema:\0A            if schema is None:\0A                # used directly as a type\0A                return core_schema.datetime_schema(tz_constraint='aware')\0A            else:\0A                assert schema['type'] == 'datetime'\0A                schema['tz_constraint'] = 'aware'\0A                return schema\0A\0A        def __repr__(self) -> str:\0A            return 'AwareDatetime'\0A\0A    class NaiveDatetime:\0A        @classmethod\0A       