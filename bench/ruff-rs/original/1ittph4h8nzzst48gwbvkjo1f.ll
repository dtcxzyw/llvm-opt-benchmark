@anon.0e1c26e9d874215adbd54bac9512570c.3 = private unnamed_addr constant [3094 x i8] c"\22\22\22\0AModule defining global singleton classes.\0A\0AThis module raises a RuntimeError if an attempt to reload it is made. In that\0Away the identities of the classes defined here are fixed and will remain so\0Aeven if numpy itself is reloaded. In particular, a function like the following\0Awill still work correctly after numpy is reloaded::\0A\0A    def foo(arg=np._NoValue):\0A        if arg is np._NoValue:\0A            ...\0A\0AThat was not the case when the singleton classes were defined in the numpy\0A``__init__.py`` file. See gh-7844 for a discussion of the reload problem that\0Amotivated this module.\0A\0A\22\22\22\0Aimport enum\0A\0Afrom ._utils import set_module as _set_module\0A\0A__all__ = ['_NoValue', '_CopyMode']\0A\0A\0A# Disallow reloading this module so as to preserve the identities of the\0A# classes defined here.\0Aif '_is_loaded' in globals():\0A    raise RuntimeError('Reloading numpy._globals is not allowed')\0A_is_loaded = True\0A\0A\0Aclass _NoValueType:\0A    \22\22\22Special keyword value.\0A\0A    The instance of this class may be used as the default value assigned to a\0A    keyword if no other obvious default (e.g., `None`) is suitable,\0A\0A    Common reasons for using this keyword are:\0A\0A    - A new keyword is added to a function, and that function forwards its\0A      inputs to another function or method which can be defined outside of\0A      NumPy. For example, ``np.std(x)`` calls ``x.std``, so when a ``keepdims``\0A      keyword was added that could only be forwarded if the user explicitly\0A      specified ``keepdims``; downstream array libraries may not have added\0A      the same keyword, so adding ``x.std(..., keepdims=keepdims)``\0A      unconditionally could have broken previously working code.\0A    - A keyword is being deprecated, and a deprecation warning must only be\0A      emitted when the keyword is used.\0A\0A    \22\22\22\0A    __instance = None\0A    def __new__(cls):\0A        # ensure that only one instance exists\0A        if not cls.__instance:\0A            cls.__instance = super().__new__(cls)\0A        return cls.__instance\0A\0A    def __repr__(self):\0A        return \22<no value>\22\0A\0A\0A_NoValue = _NoValueType()\0A\0A\0A@_set_module(\22numpy\22)\0Aclass _CopyMode(enum.Enum):\0A    \22\22\22\0A    An enumeration for the copy modes supported\0A    by numpy.copy() and numpy.array(). The following three modes are supported,\0A\0A    - ALWAYS: This means that a deep copy of the input\0A              array will always be taken.\0A    - IF_NEEDED: This means that a deep copy of the input\0A                 array will be taken only if necessary.\0A    - NEVER: This means that the deep copy will never be taken.\0A             If a copy cannot be avoided then a `ValueError` will be\0A             raised.\0A\0A    Note that the buffer-protocol could in theory do copies.  NumPy currently\0A    assumes an object exporting the buffer protocol will never do this.\0A    \22\22\22\0A\0A    ALWAYS = True\0A    IF_NEEDED = False\0A    NEVER = 2\0A\0A    def __bool__(self):\0A        # For backwards compatibility\0A        if self == _CopyMode.ALWAYS:\0A            return True\0A\0A        if self == _CopyMode.IF_NEEDED:\0A            return False\0A\0A        raise ValueError(f\22{self} is neither True nor False.\22)\0A", align 1
