ys())\0AUN_RE = re.compile(r'([a-z]+)({tones})$'.format(tones='|'.join(UN_TONES)))\0A\0A\0Adef convert_zero_consonant(pinyin):\0A    \22\22\22\E9\9B\B6\E5\A3\B0\E6\AF\8D\E8\BD\AC\E6\8D\A2\EF\BC\8C\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\0A\0A    i\E8\A1\8C\E7\9A\84\E9\9F\B5\E6\AF\8D\EF\BC\8C\E5\89\8D\E9\9D\A2\E6\B2\A1\E6\9C\89\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90yi(\E8\A1\A3)\EF\BC\8Cya(\E5\91\80)\EF\BC\8Cye(\E8\80\B6)\EF\BC\8Cyao(\E8\85\B0)\EF\BC\8C\0A    you(\E5\BF\A7)\EF\BC\8Cyan(\E7\83\9F)\EF\BC\8Cyin(\E5\9B\A0)\EF\BC\8Cyang(\E5\A4\AE)\EF\BC\8Cying(\E8\8B\B1)\EF\BC\8Cyong(\E9\9B\8D)\E3\80\82\0A\0A    u\E8\A1\8C\E7\9A\84\E9\9F\B5\E6\AF\8D\EF\BC\8C\E5\89\8D\E9\9D\A2\E6\B2\A1\E6\9C\89\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90wu(\E4\B9\8C)\EF\BC\8Cwa(\E8\9B\99)\EF\BC\8Cwo(\E7\AA\9D)\EF\BC\8Cwai(\E6\AD\AA)\EF\BC\8C\0A    wei(\E5\A8\81)\EF\BC\8Cwan(\E5\BC\AF)\EF\BC\8Cwen(\E6\B8\A9)\EF\BC\8Cwang(\E6\B1\AA)\EF\BC\8Cweng(\E7\BF\81)\E3\80\82\0A\0A    \C3\BC\E8\A1\8C\E7\9A\84\E9\9F\B5\E6\AF\8D\EF\BC\8C\E5\89\8D\E9\9D\A2\E6\B2\A1\E6\9C\89\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90yu(\E8\BF\82)\EF\BC\8Cyue(\E7\BA\A6)\EF\BC\8Cyuan(\E5\86\A4)\EF\BC\8C\0A    yun(\E6\99\95)\EF\BC\9B\C3\BC\E4\B8\8A\E4\B8\A4\E7\82\B9\E7\9C\81\E7\95\A5\E3\80\82\0A    \22\22\22\0A    raw_pinyin = pinyin\0A    # y: yu -> v, yi -> i, y -> i\0A    if raw_pinyin.startswith('y'):\0A        # \E5\8E\BB\E9\99\A4 y \E5\90\8E\E7\9A\84\E6\8B\BC\E9\9F\B3\0A        no_y_py = pinyin[1:]\0A        first_char = no_y_py[0] if len(no_y_py) > 0 else None\0A\0A        # yu -> \C3\BC: yue -> \C3\BCe\0A        if first_char in U_TONES:\0A            pinyin = UV_MAP[first_char] + pinyin[2:]\0A        # yi -> i: yi -> i\0A        elif first_char in I_TONES:\0A            pinyin = no_y_py\0A        # y -> i: ya -> ia\0A        else:\0A            pinyin = 'i' + no_y_py\0A\0A    # w: wu -> u, w -> u\0A    if raw_pinyin.startswith('w'):\0A        # \E5\8E\BB\E9\99\A4 w \E5\90\8E\E7\9A\84\E6\8B\BC\E9\9F\B3\0A        no_w_py = pinyin[1:]\0A        first_char = no_w_py[0] if len(no_w_py) > 0 else None\0A\0A        # wu -> u: wu -> u\0A        if first_char in U_TONES:\0A            pinyin = pinyin[1:]\0A        # w -> u: wa -> ua\0A        else:\0A            pinyin = 'u' + pinyin[1:]\0A\0A    # \E7\A1\AE\E4\BF\9D\E4\B8\8D\E4\BC\9A\E5\87\BA\E7\8E\B0\E9\9F\B5\E6\AF\8D\E8\A1\A8\E4\B8\AD\E4\B8\8D\E5\AD\98\E5\9C\A8\E7\9A\84\E9\9F\B5\E6\AF\8D\0A    if pinyin not in _FINALS:\0A        return raw_pinyin\0A\0A    return pinyin\0A\0A\0Adef convert_uv(pinyin):\0A    \22\22\22\C3\BC \E8\BD\AC\E6\8D\A2\EF\BC\8C\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\0A\0A    \C3\BC\E8\A1\8C\E7\9A\84\E9\9F\B5\E8\B7\9F\E5\A3\B0\E6\AF\8Dj\EF\BC\8Cq\EF\BC\8Cx\E6\8B\BC\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90ju(\E5\B1\85)\EF\BC\8Cqu(\E5\8C\BA)\EF\BC\8Cxu(\E8\99\9A)\EF\BC\8C\0A    \C3\BC\E4\B8\8A\E4\B8\A4\E7\82\B9\E4\B9\9F\E7\9C\81\E7\95\A5\EF\BC\9B\E4\BD\86\E6\98\AF\E8\B7\9F\E5\A3\B0\E6\AF\8Dn\EF\BC\8Cl\E6\8B\BC\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E4\BB\8D\E7\84\B6\E5\86\99\E6\88\90n\C3\BC(\E5\A5\B3)\EF\BC\8Cl\C3\BC(\E5\90\95)\E3\80\82\0A    \22\22\22\0A    return UV_RE.sub(\0A        lambda m: ''.join((m.group(1), UV_MAP[m.group(2)], m.group(3))),\0A        pinyin)\0A\0A\0Adef convert_iou(pinyin):\0A    \22\22\22iou \E8\BD\AC\E6\8D\A2\EF\BC\8C\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\0A\0A    iou\EF\BC\8Cuei\EF\BC\8Cuen\E5\89\8D\E9\9D\A2\E5\8A\A0\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90iu\EF\BC\8Cui\EF\BC\8Cun\E3\80\82\0A    \E4\BE\8B\E5\A6\82niu(\E7\89\9B)\EF\BC\8Cgui(\E5\BD\92)\EF\BC\8Clun(\E8\AE\BA)\E3\80\82\0A    \22\22\22\0A    return IU_RE.sub(lambda m: m.group(1) + IU_MAP[m.group(2)], pinyin)\0A\0A\0Adef convert_uei(pinyin):\0A    \22\22\22uei \E8\BD\AC\E6\8D\A2\EF\BC\8C\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\0A\0A    iou\EF\BC\8Cuei\EF\BC\8Cuen\E5\89\8D\E9\9D\A2\E5\8A\A0\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90iu\EF\BC\8Cui\EF\BC\8Cun\E3\80\82\0A    \E4\BE\8B\E5\A6\82niu(\E7\89\9B)\EF\BC\8Cgui(\E5\BD\92)\EF\BC\8Clun(\E8\AE\BA)\E3\80\82\0A    \22\22\22\0A    return UI_RE.sub(lambda m: m.group(1) + UI_MAP[m.group(2)], pinyin)\0A\0A\0Adef convert_uen(pinyin):\0A    \22\22\22uen \E8\BD\AC\E6\8D\A2\EF\BC\8C\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\0A\0A    iou\EF\BC\8Cuei\EF\BC\8Cuen\E5\89\8D\E9\9D\A2\E5\8A\A0\E5\A3\B0\E6\AF\8D\E7\9A\84\E6\97\B6\E5\80\99\EF\BC\8C\E5\86\99\E6\88\90iu\EF\BC\8Cui\EF\BC\8Cun\E3\80\82\0A    \E4\BE\8B\E5\A6\82niu(\E7\89\9B)\EF\BC\8Cgui(\E5\BD\92)\EF\BC\8Clun(\E8\AE\BA)\E3\80\82\0A    \22\22\22\0A    return UN_RE.sub(lambda m: m.group(1) + UN_MAP[m.group(2)], pinyin)\0A\0A\0Adef convert_finals(pinyin):\0A    \22\22\22\E8\BF\98\E5\8E\9F\E5\8E\9F\E5\A7\8B\E7\9A\84\E9\9F\B5\E6\AF\8D\22\22\22\0A    pinyin = convert_zero_consonant(pinyin)\0A    pinyin = convert_uv(pinyin)\0A    pinyin = convert_iou(pinyin)\0A    pinyin = convert_uei(pinyin)\0A    pinyin = convert_uen(pinyin)\0A    return pinyin\0A", align 1
