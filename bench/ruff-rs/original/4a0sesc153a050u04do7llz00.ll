@anon.0de5ee8f4a9046f07397637c35d34c13.1877 = private unnamed_addr constant [41 x i8] c"single-line-implicit-string-concatenation", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.1878 = private unnamed_addr constant [568 x i8] c"## What it does\0AChecks for implicitly concatenated strings on a single line.\0A\0A## Why is this bad?\0AWhile it is valid Python syntax to concatenate multiple string or byte\0Aliterals implicitly (via whitespace delimiters), it is unnecessary and\0Anegatively affects code readability.\0A\0AIn some cases, the implicit concatenation may also be unintentional, as\0Acode formatters are capable of introducing single-line implicit\0Aconcatenations when collapsing long lines.\0A\0A## Example\0A```python\0Az = \22The quick \22 \22brown fox.\22\0A```\0A\0AUse instead:\0A```python\0Az = \22The quick brown fox.\22\0A```\0A", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.1879 = private unnamed_addr constant [51 x i8] c"Implicitly concatenated string literals on one line", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.1880 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.0de5ee8f4a9046f07397637c35d34c13.1879, [8 x i8] c"3\00\00\00\00\00\00\00" }>, align 8
@anon.0de5ee8f4a9046f07397637c35d34c13.1881 = private unnamed_addr constant [40 x i8] c"multi-line-implicit-string-concatenation", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.1882 = private unnamed_addr constant [1249 x i8] c"## What it does\0AChecks for implicitly concatenated strings that span multiple lines.\0A\0A## Why is this bad?\0AFor string literals that wrap across multiple lines, [PEP 8] recommends\0Athe use of implicit string concatenation within parentheses instead of\0Ausing a backslash for line continuation, as the former is more readable\0Athan the latter.\0A\0ABy default, this rule will only trigger if the string literal is\0Aconcatenated via a backslash. To disallow implicit string concatenation\0Aaltogether, set the [`lint.flake8-implicit-str-concat.allow-multiline`] option\0Ato `false`.\0A\0A## Example\0A```python\0Az = \22The quick brown fox jumps over the lazy \22\\\0A    \22dog.\22\0A```\0A\0AUse instead:\0A```python\0Az = (\0A    \22The quick brown fox jumps over the lazy \22\0A    \22dog.\22\0A)\0A```\0A\0A## Options\0A- `lint.flake8-implicit-str-concat.allow-multiline`\0A\0A## Formatter compatibility\0AUsing this rule with `allow-multiline = false` can be incompatible with the\0Aformatter because the [formatter] can introduce new multi-line implicitly\0Aconcatenated strings. We recommend to either:\0A\0A* Enable `ISC001` to disallow all implicit concatenated strings\0A* Setting `allow-multiline = true`\0A\0A[PEP 8]: https://peps.python.org/pep-0008/#maximum-line-length\0A[formatter]:https://docs.astral.sh/ruff/formatter/\0A", align 1
