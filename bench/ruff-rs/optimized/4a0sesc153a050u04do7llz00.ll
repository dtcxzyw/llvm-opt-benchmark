@anon.0de5ee8f4a9046f07397637c35d34c13.1859 = private unnamed_addr constant [21 x i8] c"ssl-with-bad-defaults", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.1860 = private unnamed_addr constant [531 x i8] c"## What it does\0AChecks for function definitions with default arguments set to insecure SSL\0Aand TLS protocol versions.\0A\0A## Why is this bad?\0ASeveral highly publicized exploitable flaws have been discovered in all\0Aversions of SSL and early versions of TLS. The following versions are\0Aconsidered insecure, and should be avoided:\0A- SSL v2\0A- SSL v3\0A- TLS v1\0A- TLS v1.1\0A\0A## Example\0A\0A```python\0Aimport ssl\0A\0A\0Adef func(version=ssl.PROTOCOL_TLSv1): ...\0A```\0A\0AUse instead:\0A\0A```python\0Aimport ssl\0A\0A\0Adef func(version=ssl.PROTOCOL_TLSv1_2): ...\0A```\0A", align 1
