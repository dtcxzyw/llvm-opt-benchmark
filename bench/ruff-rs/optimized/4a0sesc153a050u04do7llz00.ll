@anon.0de5ee8f4a9046f07397637c35d34c13.2074 = private unnamed_addr constant [28 x i8] c"missing-terminal-punctuation", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2075 = private unnamed_addr constant [1091 x i8] c"## What it does\0AChecks for docstrings in which the first line does not end in a punctuation\0Amark, such as a period, question mark, or exclamation point.\0A\0A## Why is this bad?\0AThe first line of a docstring should end with a period, question mark, or\0Aexclamation point, for grammatical correctness and consistency.\0A\0AThis rule may not apply to all projects; its applicability is a matter of\0Aconvention. By default, this rule is enabled when using the `google`\0Aconvention, and disabled when using the `numpy` and `pep257` conventions.\0A\0A## Example\0A```python\0Adef average(values: list[float]) -> float:\0A    \22\22\22Return the mean of the given values\22\22\22\0A```\0A\0AUse instead:\0A```python\0Adef average(values: list[float]) -> float:\0A    \22\22\22Return the mean of the given values.\22\22\22\0A```\0A\0A## Options\0A- `lint.pydocstyle.convention`\0A\0A## References\0A- [PEP 257 \E2\80\93 Docstring Conventions](https://peps.python.org/pep-0257/)\0A- [NumPy Style Guide](https://numpydoc.readthedocs.io/en/latest/format.html)\0A- [Google Python Style Guide - Docstrings](https://google.github.io/styleguide/pyguide.html#38-comments-and-docstrings)\0A", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2076 = private unnamed_addr constant [72 x i8] c"First line should end with a period, question mark, or exclamation point", align 1
