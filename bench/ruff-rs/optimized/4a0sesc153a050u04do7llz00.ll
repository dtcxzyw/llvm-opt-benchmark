@anon.0de5ee8f4a9046f07397637c35d34c13.2063 = private unnamed_addr constant [28 x i8] c"escape-sequence-in-docstring", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2064 = private unnamed_addr constant [1090 x i8] c"## What it does\0AChecks for docstrings that include backslashes, but are not defined as\0Araw string literals.\0A\0A## Why is this bad?\0AIn Python, backslashes are typically used to escape characters in strings.\0AIn raw strings (those prefixed with an `r`), however, backslashes are\0Atreated as literal characters.\0A\0A[PEP 257](https://peps.python.org/pep-0257/#what-is-a-docstring) recommends\0Athe use of raw strings (i.e., `r\22\22\22raw triple double quotes\22\22\22`) for\0Adocstrings that include backslashes. The use of a raw string ensures that\0Aany backslashes are treated as literal characters, and not as escape\0Asequences, which avoids confusion.\0A\0A## Example\0A```python\0Adef foobar():\0A    \22\22\22Docstring for foo\\bar.\22\22\22\0A\0A\0Afoobar.__doc__  # \22Docstring for foar.\22\0A```\0A\0AUse instead:\0A```python\0Adef foobar():\0A    r\22\22\22Docstring for foo\\bar.\22\22\22\0A\0A\0Afoobar.__doc__  # \22Docstring for foo\\bar.\22\0A```\0A\0A## References\0A- [PEP 257 \E2\80\93 Docstring Conventions](https://peps.python.org/pep-0257/)\0A- [Python documentation: String and Bytes literals](https://docs.python.org/3/reference/lexical_analysis.html#string-and-bytes-literals)\0A", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2065 = private unnamed_addr constant [44 x i8] c"Use `r\22\22\22` if any backslashes in a docstring", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2066 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.0de5ee8f4a9046f07397637c35d34c13.2065, [8 x i8] c",\00\00\00\00\00\00\00" }>, align 8
@anon.0de5ee8f4a9046f07397637c35d34c13.2067 = private unnamed_addr constant [32 x i8] c"missing-blank-line-after-summary", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2068 = private unnamed_addr constant [1101 x i8] c"## What it does\0AChecks for docstring summary lines that are not separated from the docstring\0Adescription by one blank line.\0A\0A## Why is this bad?\0A[PEP 257] recommends that multi-line docstrings consist of \22a summary line\0Ajust like a one-line docstring, followed by a blank line, followed by a\0Amore elaborate description.\22\0A\0A## Example\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22Return a sorted copy of the list.\0A    Sort the list in ascending order and return a copy of the\0A    result using the bubble sort algorithm.\0A    \22\22\22\0A```\0A\0AUse instead:\0A```python\0Adef sort_list(l: list[int]) -> list[int]:\0A    \22\22\22Return a sorted copy of the list.\0A\0A    Sort the list in ascending order and return a copy of the\0A    result using the bubble sort algorithm.\0A    \22\22\22\0A```\0A\0A## References\0A- [PEP 257 \E2\80\93 Docstring Conventions](https://peps.python.org/pep-0257/)\0A- [NumPy Style Guide](https://numpydoc.readthedocs.io/en/latest/format.html)\0A- [Google Python Style Guide - Docstrings](https://google.github.io/styleguide/pyguide.html#38-comments-and-docstrings)\0A\0A[PEP 257]: https://peps.python.org/pep-0257/\0A", align 1
@anon.0de5ee8f4a9046f07397637c35d34c13.2069 = private unnamed_addr constant [58 x i8] c"1 blank line required between summary line and description", align 1
