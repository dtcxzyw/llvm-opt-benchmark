@anon.a6b6a9a55df1a6fb8afb47e1f078e4b4.884 = private unnamed_addr constant [22 x i8] c"shebang-not-executable", align 1
@anon.a6b6a9a55df1a6fb8afb47e1f078e4b4.885 = private unnamed_addr constant [1190 x i8] c"## What it does\0AChecks for a shebang directive in a file that is not executable.\0A\0A## Why is this bad?\0AIn Python, a shebang (also known as a hashbang) is the first line of a\0Ascript, which specifies the interpreter that should be used to run the\0Ascript.\0A\0AThe presence of a shebang suggests that a file is intended to be\0Aexecutable. If a file contains a shebang but is not executable, then the\0Ashebang is misleading, or the file is missing the executable bit.\0A\0AIf the file is meant to be executable, add the executable bit to the file\0A(e.g., `chmod +x __main__.py` or `git update-index --chmod=+x __main__.py`).\0A\0AOtherwise, remove the shebang.\0A\0AA file is considered executable if it has the executable bit set (i.e., its\0Apermissions mode intersects with `0o111`). As such, _this rule is only\0Aavailable on Unix-like systems_, and is not enforced on Windows or WSL.\0A\0A## Example\0A```python\0A#!/usr/bin/env python\0A```\0A\0A## References\0A- [Python documentation: Executable Python Scripts](https://docs.python.org/3/tutorial/appendix.html#executable-python-scripts)\0A- [Git documentation: `git update-index --chmod`](https://git-scm.com/docs/git-update-index#Documentation/git-update-index.txt---chmod-x)\0A", align 1
@anon.a6b6a9a55df1a6fb8afb47e1f078e4b4.886 = private unnamed_addr constant [45 x i8] c"Shebang is present but file is not executable", align 1
