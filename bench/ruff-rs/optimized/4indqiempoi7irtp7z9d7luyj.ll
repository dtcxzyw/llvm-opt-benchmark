@anon.faf009aaacdb3bbda30f9435f6d39aa4.1465 = private unnamed_addr constant <{ ptr, [8 x i8], ptr, [8 x i8] }> <{ ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1463, [8 x i8] c"q\00\00\00\00\00\00\00", ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1464, [8 x i8] c"<\00\00\00\00\00\00\00" }>, align 8
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1466 = private unnamed_addr constant [27 x i8] c"start-process-with-no-shell", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1467 = private unnamed_addr constant [978 x i8] c"## What it does\0AChecks for functions that start a process without a shell.\0A\0A## Why is this bad?\0AInvoking any kind of external executable via a function call can pose\0Asecurity risks if arbitrary variables are passed to the executable, or if\0Athe input is otherwise unsanitised or unvalidated.\0A\0AThis rule specifically flags functions in the `os` module that spawn\0Asubprocesses *without* the use of a shell. Note that these typically pose a\0Amuch smaller security risk than subprocesses that are started *with* a\0Ashell, which are flagged by [`start-process-with-a-shell`][S605] (`S605`).\0AThis gives you the option of enabling one rule while disabling the other\0Aif you decide that the security risk from these functions is acceptable\0Afor your use case.\0A\0A## Example\0A```python\0Aimport os\0A\0A\0Adef insecure_function(arbitrary_user_input: str):\0A    os.spawnlp(os.P_NOWAIT, \22/bin/mycmd\22, \22mycmd\22, arbitrary_user_input)\0A```\0A\0A[S605]: https://docs.astral.sh/ruff/rules/start-process-with-a-shell\0A", align 1
@anon.faf009aaacdb3bbda30f9435f6d39aa4.1468 = private unnamed_addr constant [34 x i8] c"Starting a process without a shell", align 1
