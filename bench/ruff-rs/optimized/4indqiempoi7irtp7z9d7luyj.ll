@anon.faf009aaacdb3bbda30f9435f6d39aa4.1703 = private unnamed_addr constant <{ ptr, [8 x i8], ptr, [8 x i8] }> <{ ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1701, [8 x i8] c"\10\00\00\00\00\00\00\00", ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1702, [8 x i8] c"&\00\00\00\00\00\00\00" }>, align 8
