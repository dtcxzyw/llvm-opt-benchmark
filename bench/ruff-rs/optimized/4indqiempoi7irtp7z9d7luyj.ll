@anon.faf009aaacdb3bbda30f9435f6d39aa4.1710 = private unnamed_addr constant <{ ptr, [8 x i8], ptr, [8 x i8] }> <{ ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1708, [8 x i8] c"\0C\00\00\00\00\00\00\00", ptr @anon.faf009aaacdb3bbda30f9435f6d39aa4.1709, [8 x i8] c" \00\00\00\00\00\00\00" }>, align 8
