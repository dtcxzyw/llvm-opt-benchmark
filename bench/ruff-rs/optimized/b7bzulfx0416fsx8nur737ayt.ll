@anon.e792752b4454889dead1a66caae2c60f.1498 = private unnamed_addr constant [1230 x i8] c"Whether to avoid [PEP 585](https://peps.python.org/pep-0585/) (`List[int]` -> `list[int]`) and [PEP 604](https://peps.python.org/pep-0604/)\0A(`Union[str, int]` -> `str | int`) rewrites even if a file imports\0A`from __future__ import annotations`.\0A\0AThis setting is only applicable when the target Python version is below\0A3.9 and 3.10 respectively, and is most commonly used when working with\0Alibraries like Pydantic and FastAPI, which rely on the ability to parse\0Atype annotations at runtime. The use of `from __future__ import annotations`\0Acauses Python to treat the type annotations as strings, which typically\0Aallows for the use of language features that appear in later Python\0Aversions but are not yet supported by the current version (e.g., `str |\0Aint`). However, libraries that rely on runtime type annotations will\0Abreak if the annotations are incompatible with the current Python\0Aversion.\0A\0AFor example, while the following is valid Python 3.8 code due to the\0Apresence of `from __future__ import annotations`, the use of `str | int`\0Aprior to Python 3.10 will cause Pydantic to raise a `TypeError` at\0Aruntime:\0A\0A```python\0Afrom __future__ import annotations\0A\0Aimport pydantic\0A\0Aclass Foo(pydantic.BaseModel):\0A    bar: str | int\0A```", align 1
@anon.e792752b4454889dead1a66caae2c60f.1500 = private unnamed_addr constant [105 x i8] c"# Preserve types, even if a file imports `from __future__ import annotations`.\0Akeep-runtime-typing = true", align 1
@anon.e792752b4454889dead1a66caae2c60f.1502 = private unnamed_addr constant [19 x i8] c"keep-runtime-typing", align 1
@anon.e792752b4454889dead1a66caae2c60f.1504 = private unnamed_addr constant [16 x i8] c"PyUpgradeOptions", align 1
@anon.e792752b4454889dead1a66caae2c60f.1505 = private unnamed_addr constant [41 x i8] c"ruff_workspace::options::PyUpgradeOptions", align 1
@anon.e792752b4454889dead1a66caae2c60f.1506 = private unnamed_addr constant [1226 x i8] c"Whether to avoid [PEP 585](https://peps.python.org/pep-0585/) (`List[int]` -> `list[int]`) and [PEP 604](https://peps.python.org/pep-0604/) (`Union[str, int]` -> `str | int`) rewrites even if a file imports `from __future__ import annotations`.\0A\0AThis setting is only applicable when the target Python version is below 3.9 and 3.10 respectively, and is most commonly used when working with libraries like Pydantic and FastAPI, which rely on the ability to parse type annotations at runtime. The use of `from __future__ import annotations` causes Python to treat the type annotations as strings, which typically allows for the use of language features that appear in later Python versions but are not yet supported by the current version (e.g., `str | int`). However, libraries that rely on runtime type annotations will break if the annotations are incompatible with the current Python version.\0A\0AFor example, while the following is valid Python 3.8 code due to the presence of `from __future__ import annotations`, the use of `str | int` prior to Python 3.10 will cause Pydantic to raise a `TypeError` at runtime:\0A\0A```python from __future__ import annotations\0A\0Aimport pydantic\0A\0Aclass Foo(pydantic.BaseModel): bar: str | int ```", align 1
