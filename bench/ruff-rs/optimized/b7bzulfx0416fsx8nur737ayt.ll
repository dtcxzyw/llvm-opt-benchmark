@anon.e792752b4454889dead1a66caae2c60f.385 = private unnamed_addr constant [154 x i8] c"Whether to automatically exclude files that are ignored by `.ignore`,\0A`.gitignore`, `.git/info/exclude`, and global `gitignore` files.\0AEnabled by default.", align 1
