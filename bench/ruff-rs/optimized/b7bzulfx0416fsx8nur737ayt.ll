@anon.e792752b4454889dead1a66caae2c60f.397 = private unnamed_addr constant [198 x i8] c"Mark the specified directories as namespace packages. For the purpose of\0Amodule resolution, Ruff will treat those directories and all their subdirectories\0Aas if they contained an `__init__.py` file.", align 1
