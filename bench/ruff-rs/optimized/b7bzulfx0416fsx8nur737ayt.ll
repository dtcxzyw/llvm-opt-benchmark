@anon.e792752b4454889dead1a66caae2c60f.1519 = private unnamed_addr constant [20 x i8] c"struct FormatOptions", align 1
@anon.e792752b4454889dead1a66caae2c60f.1520 = private unnamed_addr constant [817 x i8] c"A list of file patterns to exclude from formatting in addition to the files excluded globally (see [`exclude`](#exclude), and [`extend-exclude`](#extend-exclude)).\0A\0AExclusions are based on globs, and can be either:\0A\0A- Single-path patterns, like `.mypy_cache` (to exclude any directory\0A  named `.mypy_cache` in the tree), `foo.py` (to exclude any file named\0A  `foo.py`), or `foo_*.py` (to exclude any file matching `foo_*.py` ).\0A- Relative patterns, like `directory/foo.py` (to exclude that specific\0A  file) or `directory/*.py` (to exclude any Python files in\0A  `directory`). Note that these paths are relative to the project root\0A  (e.g., the directory containing your `pyproject.toml`).\0A\0AFor more information on the glob syntax, refer to the [`globset` documentation](https://docs.rs/globset/latest/globset/#syntax).", align 1
@anon.e792752b4454889dead1a66caae2c60f.1522 = private unnamed_addr constant [56 x i8] c"Whether to enable the unstable preview style formatting.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1524 = private unnamed_addr constant [49 x i8] c"# Enable preview style formatting.\0Apreview = true", align 1
@anon.e792752b4454889dead1a66caae2c60f.1526 = private unnamed_addr constant [588 x i8] c"Whether to use spaces or tabs for indentation.\0A\0A`indent-style = \22space\22` (default):\0A\0A```python\0Adef f():\0A    print(\22Hello\22) #  Spaces indent the `print` statement.\0A```\0A\0A`indent-style = \22tab\22`:\0A\0A```python\0Adef f():\0A    print(\22Hello\22) #  A tab `\\t` indents the `print` statement.\0A```\0A\0APEP 8 recommends using spaces for [indentation](https://peps.python.org/pep-0008/#indentation).\0AWe care about accessibility; if you do not need tabs for accessibility, we do not recommend you use them.\0A\0ASee [`indent-width`](#indent-width) to configure the number of spaces per indentation and the tab width.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1528 = private unnamed_addr constant [7 x i8] c"\22space\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1530 = private unnamed_addr constant [15 x i8] c"\22space\22 | \22tab\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1532 = private unnamed_addr constant [63 x i8] c"# Use tabs instead of 4 space indentation.\0Aindent-style = \22tab\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1534 = private unnamed_addr constant [12 x i8] c"indent-style", align 1
@anon.e792752b4454889dead1a66caae2c60f.1535 = private unnamed_addr constant [1134 x i8] c"Configures the preferred quote character for strings. The recommended options are\0A\0A* `double` (default): Use double quotes `\22`\0A* `single`: Use single quotes `'`\0A\0AIn compliance with [PEP 8](https://peps.python.org/pep-0008/) and [PEP 257](https://peps.python.org/pep-0257/),\0ARuff prefers double quotes for triple quoted strings and docstrings even when using `quote-style = \22single\22`.\0A\0ARuff deviates from using the configured quotes if doing so prevents the need for\0Aescaping quote characters inside the string:\0A\0A```python\0Aa = \22a string without any quotes\22\0Ab = \22It's monday morning\22\0A```\0A\0ARuff will change the quotes of the string assigned to `a` to single quotes when using `quote-style = \22single\22`.\0AHowever, Ruff uses double quotes for the string assigned to `b` because using single quotes would require escaping the `'`,\0Awhich leads to the less readable code: `'It\\'s monday morning'`.\0A\0AIn addition, Ruff supports the quote style `preserve` for projects that already use\0Aa mixture of single and double quotes and can't migrate to the `double` or `single` style.\0AThe quote style `preserve` leaves the quotes of all strings unchanged.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1537 = private unnamed_addr constant [32 x i8] c"\22double\22 | \22single\22 | \22preserve\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1539 = private unnamed_addr constant [65 x i8] c"# Prefer single quotes over double quotes.\0Aquote-style = \22single\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1541 = private unnamed_addr constant [11 x i8] c"quote-style", align 1
@anon.e792752b4454889dead1a66caae2c60f.1542 = private unnamed_addr constant [657 x i8] c"Ruff uses existing trailing commas as an indication that short lines should be left separate.\0AIf this option is set to `true`, the magic trailing comma is ignored.\0A\0AFor example, Ruff leaves the arguments separate even though\0Acollapsing the arguments to a single line doesn't exceed the line length if `skip-magic-trailing-comma = false`:\0A\0A```python\0A# The arguments remain on separate lines because of the trailing comma after `b`\0Adef test(\0A    a,\0A    b,\0A): pass\0A```\0A\0ASetting `skip-magic-trailing-comma = true` changes the formatting to:\0A\0A```python\0A# The arguments remain on separate lines because of the trailing comma after `b`\0Adef test(a, b):\0A    pass\0A```", align 1
@anon.e792752b4454889dead1a66caae2c60f.1544 = private unnamed_addr constant [32 x i8] c"skip-magic-trailing-comma = true", align 1
@anon.e792752b4454889dead1a66caae2c60f.1546 = private unnamed_addr constant [25 x i8] c"skip-magic-trailing-comma", align 1
@anon.e792752b4454889dead1a66caae2c60f.1547 = private unnamed_addr constant [518 x i8] c"The character Ruff uses at the end of a line.\0A\0A* `auto`: The newline style is detected automatically on a file per file basis. Files with mixed line endings will be converted to the first detected line ending. Defaults to `\\n` for files that contain no line endings.\0A* `lf`: Line endings will be converted to `\\n`. The default line ending on Unix.\0A* `cr-lf`: Line endings will be converted to `\\r\\n`. The default line ending on Windows.\0A* `native`: Line endings will be converted to `\\n` on Unix and `\\r\\n` on Windows.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1549 = private unnamed_addr constant [6 x i8] c"\22auto\22", align 1
@anon.e792752b4454889dead1a66caae2c60f.1551 = private unnamed_addr constant [34 x i8] c"\22auto\22 | \22lf\22 | \22cr-lf\22 | \22native\22", align 1
