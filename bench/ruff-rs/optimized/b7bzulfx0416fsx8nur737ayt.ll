@anon.e792752b4454889dead1a66caae2c60f.365 = private unnamed_addr constant [127 x i8] c"# In addition to the standard set of exclusions, omit all tests, plus a specific file.\0Aextend-exclude = [\22tests\22, \22src/bad.py\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.367 = private unnamed_addr constant [14 x i8] c"extend-exclude", align 1
@anon.e792752b4454889dead1a66caae2c60f.368 = private unnamed_addr constant [363 x i8] c"A list of file patterns to include when linting, in addition to those\0Aspecified by [`include`](#include).\0A\0AInclusion are based on globs, and should be single-path patterns, like\0A`*.pyw`, to include any file with the `.pyw` extension.\0A\0AFor more information on the glob syntax, refer to the [`globset` documentation](https://docs.rs/globset/latest/globset/#syntax).", align 1
@anon.e792752b4454889dead1a66caae2c60f.370 = private unnamed_addr constant [97 x i8] c"# In addition to the standard set of inclusions, include `.pyw` files.\0Aextend-include = [\22*.pyw\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.372 = private unnamed_addr constant [14 x i8] c"extend-include", align 1
@anon.e792752b4454889dead1a66caae2c60f.373 = private unnamed_addr constant [586 x i8] c"Whether to enforce [`exclude`](#exclude) and [`extend-exclude`](#extend-exclude) patterns,\0Aeven for paths that are passed to Ruff explicitly. Typically, Ruff will lint\0Aany paths passed in directly, even if they would typically be\0Aexcluded. Setting `force-exclude = true` will cause Ruff to\0Arespect these exclusions unequivocally.\0A\0AThis is useful for [`pre-commit`](https://pre-commit.com/), which explicitly passes all\0Achanged files to the [`ruff-pre-commit`](https://github.com/astral-sh/ruff-pre-commit)\0Aplugin, regardless of whether they're marked as excluded by Ruff's own\0Asettings.", align 1
@anon.e792752b4454889dead1a66caae2c60f.375 = private unnamed_addr constant [20 x i8] c"force-exclude = true", align 1
@anon.e792752b4454889dead1a66caae2c60f.377 = private unnamed_addr constant [13 x i8] c"force-exclude", align 1
@anon.e792752b4454889dead1a66caae2c60f.378 = private unnamed_addr constant [508 x i8] c"A list of file patterns to include when linting.\0A\0AInclusion are based on globs, and should be single-path patterns, like\0A`*.pyw`, to include any file with the `.pyw` extension. `pyproject.toml` is\0Aincluded here not for configuration but because we lint whether e.g. the\0A`[project]` matches the schema.\0A\0ANotebook files (`.ipynb` extension) are included by default on Ruff 0.6.0+.\0A\0AFor more information on the glob syntax, refer to the [`globset` documentation](https://docs.rs/globset/latest/globset/#syntax).", align 1
@anon.e792752b4454889dead1a66caae2c60f.380 = private unnamed_addr constant [49 x i8] c"[\22*.py\22, \22*.pyi\22, \22*.ipynb\22, \22**/pyproject.toml\22]", align 1
