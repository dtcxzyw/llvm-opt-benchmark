@anon.e792752b4454889dead1a66caae2c60f.352 = private unnamed_addr constant [823 x i8] c"A list of file patterns to exclude from formatting and linting.\0A\0AExclusions are based on globs, and can be either:\0A\0A- Single-path patterns, like `.mypy_cache` (to exclude any directory\0A  named `.mypy_cache` in the tree), `foo.py` (to exclude any file named\0A  `foo.py`), or `foo_*.py` (to exclude any file matching `foo_*.py` ).\0A- Relative patterns, like `directory/foo.py` (to exclude that specific\0A  file) or `directory/*.py` (to exclude any Python files in\0A  `directory`). Note that these paths are relative to the project root\0A  (e.g., the directory containing your `pyproject.toml`).\0A\0AFor more information on the glob syntax, refer to the [`globset` documentation](https://docs.rs/globset/latest/globset/#syntax).\0A\0ANote that you'll typically want to use\0A[`extend-exclude`](#extend-exclude) to modify the excluded paths.", align 1
@anon.e792752b4454889dead1a66caae2c60f.354 = private unnamed_addr constant [217 x i8] c"[\22.bzr\22, \22.direnv\22, \22.eggs\22, \22.git\22, \22.git-rewrite\22, \22.hg\22, \22.mypy_cache\22, \22.nox\22, \22.pants.d\22, \22.pytype\22, \22.ruff_cache\22, \22.svn\22, \22.tox\22, \22.venv\22, \22__pypackages__\22, \22_build\22, \22buck-out\22, \22dist\22, \22node_modules\22, \22venv\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.356 = private unnamed_addr constant [9 x i8] c"list[str]", align 1
@anon.e792752b4454889dead1a66caae2c60f.358 = private unnamed_addr constant [19 x i8] c"exclude = [\22.venv\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.360 = private unnamed_addr constant [7 x i8] c"exclude", align 1
@anon.e792752b4454889dead1a66caae2c60f.361 = private unnamed_addr constant [771 x i8] c"A list of file patterns to omit from formatting and linting, in addition to those\0Aspecified by [`exclude`](#exclude).\0A\0AExclusions are based on globs, and can be either:\0A\0A- Single-path patterns, like `.mypy_cache` (to exclude any directory\0A  named `.mypy_cache` in the tree), `foo.py` (to exclude any file named\0A  `foo.py`), or `foo_*.py` (to exclude any file matching `foo_*.py` ).\0A- Relative patterns, like `directory/foo.py` (to exclude that specific\0A  file) or `directory/*.py` (to exclude any Python files in\0A  `directory`). Note that these paths are relative to the project root\0A  (e.g., the directory containing your `pyproject.toml`).\0A\0AFor more information on the glob syntax, refer to the [`globset` documentation](https://docs.rs/globset/latest/globset/#syntax).", align 1
