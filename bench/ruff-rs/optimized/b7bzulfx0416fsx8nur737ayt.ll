@anon.e792752b4454889dead1a66caae2c60f.450 = private unnamed_addr constant [329 x i8] c"A path to the cache directory.\0A\0ABy default, Ruff stores cache results in a `.ruff_cache` directory in the current project root.\0A\0AHowever, Ruff will also respect the `RUFF_CACHE_DIR` environment variable, which takes precedence over that default.\0A\0AThis setting will override even the `RUFF_CACHE_DIR` environment variable, if set.", align 1
@anon.e792752b4454889dead1a66caae2c60f.451 = private unnamed_addr constant [310 x i8] c"A path to a local `pyproject.toml` file to merge into this configuration. User home directory and environment variables will be expanded.\0A\0ATo resolve the current `pyproject.toml` file, Ruff will first resolve this base configuration file, then merge in any properties defined in the current configuration file.", align 1
@anon.e792752b4454889dead1a66caae2c60f.452 = private unnamed_addr constant [372 x i8] c"The style in which violation messages should be formatted: `\22full\22` (default) (shows source), `\22concise\22`, `\22grouped\22` (group messages by file), `\22json\22` (machine-readable), `\22junit\22` (machine-readable XML), `\22github\22` (GitHub Actions annotations), `\22gitlab\22` (GitLab CI code quality report), `\22pylint\22` (Pylint text format) or `\22azure\22` (Azure Pipeline logging commands).", align 1
@anon.e792752b4454889dead1a66caae2c60f.453 = private unnamed_addr constant [180 x i8] c"Enable fix behavior by-default when running `ruff` (overridden by the `--fix` and `--no-fix` command-line flags). Only includes automatic fixes unless `--unsafe-fixes` is provided.", align 1
