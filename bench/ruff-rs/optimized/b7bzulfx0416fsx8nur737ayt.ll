@anon.e792752b4454889dead1a66caae2c60f.1337 = private unnamed_addr constant [528 x i8] c"A list of decorators that, when applied to a method, indicate that the method should be treated as a class method (in addition to the builtin `@classmethod`).\0A\0AFor example, Ruff will expect that any method decorated by a decorator in this list takes a `cls` argument as its first argument.\0A\0AExpects to receive a list of fully-qualified names (e.g., `pydantic.validator`, rather than `validator`) or alternatively a plain name which is then matched against the last segment in case the decorator itself consists of a dotted name.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1338 = private unnamed_addr constant [519 x i8] c"A list of decorators that, when applied to a method, indicate that the method should be treated as a static method (in addition to the builtin `@staticmethod`).\0A\0AFor example, Ruff will expect that any method decorated by a decorator in this list has no `self` or `cls` argument.\0A\0AExpects to receive a list of fully-qualified names (e.g., `belay.Device.teardown`, rather than `teardown`) or alternatively a plain name which is then matched against the last segment in case the decorator itself consists of a dotted name.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1339 = private unnamed_addr constant [25 x i8] c"struct PycodestyleOptions", align 1
@anon.e792752b4454889dead1a66caae2c60f.1340 = private unnamed_addr constant [914 x i8] c"The maximum line length to allow for [`line-too-long`](https://docs.astral.sh/ruff/rules/line-too-long/) violations. By default,\0Athis is set to the value of the [`line-length`](#line-length) option.\0A\0AUse this option when you want to detect extra-long lines that the formatter can't automatically split by setting\0A`pycodestyle.line-length` to a value larger than [`line-length`](#line-length).\0A\0A```toml\0A# The formatter wraps lines at a length of 88.\0Aline-length = 88\0A\0A[pycodestyle]\0A# E501 reports lines that exceed the length of 100.\0Amax-line-length = 100\0A```\0A\0AThe length is determined by the number of characters per line, except for lines containing East Asian characters or emojis.\0AFor these lines, the [unicode width](https://unicode.org/reports/tr11/) of each character is added up to determine the length.\0A\0ASee the [`line-too-long`](https://docs.astral.sh/ruff/rules/line-too-long/) rule for more information.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1342 = private unnamed_addr constant [21 x i8] c"max-line-length = 100", align 1
@anon.e792752b4454889dead1a66caae2c60f.1344 = private unnamed_addr constant [15 x i8] c"max-line-length", align 1
@anon.e792752b4454889dead1a66caae2c60f.1345 = private unnamed_addr constant [615 x i8] c"The maximum line length to allow for [`doc-line-too-long`](https://docs.astral.sh/ruff/rules/doc-line-too-long/) violations within\0Adocumentation (`W505`), including standalone comments. By default,\0Athis is set to `null` which disables reporting violations.\0A\0AThe length is determined by the number of characters per line, except for lines containing Asian characters or emojis.\0AFor these lines, the [unicode width](https://unicode.org/reports/tr11/) of each character is added up to determine the length.\0A\0ASee the [`doc-line-too-long`](https://docs.astral.sh/ruff/rules/doc-line-too-long/) rule for more information.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1347 = private unnamed_addr constant [19 x i8] c"max-doc-length = 88", align 1
@anon.e792752b4454889dead1a66caae2c60f.1349 = private unnamed_addr constant [14 x i8] c"max-doc-length", align 1
