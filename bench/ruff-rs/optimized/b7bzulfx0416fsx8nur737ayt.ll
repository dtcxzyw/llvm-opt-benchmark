@anon.e792752b4454889dead1a66caae2c60f.1076 = private unnamed_addr constant [14 x i8] c"exempt-modules", align 1
@anon.e792752b4454889dead1a66caae2c60f.1077 = private unnamed_addr constant [605 x i8] c"Exempt classes that list any of the enumerated classes as a base class\0Afrom needing to be moved into type-checking blocks.\0A\0ACommon examples include Pydantic's `pydantic.BaseModel` and SQLAlchemy's\0A`sqlalchemy.orm.DeclarativeBase`, but can also support user-defined\0Aclasses that inherit from those base classes. For example, if you define\0Aa common `DeclarativeBase` subclass that's used throughout your project\0A(e.g., `class Base(DeclarativeBase) ...` in `base.py`), you can add it to\0Athis list (`runtime-evaluated-base-classes = [\22base.Base\22]`) to exempt\0Amodels from being moved into type-checking blocks.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1079 = private unnamed_addr constant [89 x i8] c"runtime-evaluated-base-classes = [\22pydantic.BaseModel\22, \22sqlalchemy.orm.DeclarativeBase\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.1081 = private unnamed_addr constant [30 x i8] c"runtime-evaluated-base-classes", align 1
@anon.e792752b4454889dead1a66caae2c60f.1082 = private unnamed_addr constant [571 x i8] c"Exempt classes and functions decorated with any of the enumerated\0Adecorators from being moved into type-checking blocks.\0A\0ACommon examples include Pydantic's `@pydantic.validate_call` decorator\0A(for functions) and attrs' `@attrs.define` decorator (for classes).\0A\0AThis also supports framework decorators like FastAPI's `fastapi.FastAPI.get`\0Awhich will work across assignments in the same module.\0A\0AFor example:\0A```python\0Aimport fastapi\0A\0Aapp = FastAPI(\22app\22)\0A\0A@app.get(\22/home\22)\0Adef home() -> str: ...\0A```\0A\0AHere `app.get` will correctly be identified as `fastapi.FastAPI.get`.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1084 = private unnamed_addr constant [73 x i8] c"runtime-evaluated-decorators = [\22pydantic.validate_call\22, \22attrs.define\22]", align 1
@anon.e792752b4454889dead1a66caae2c60f.1086 = private unnamed_addr constant [28 x i8] c"runtime-evaluated-decorators", align 1
@anon.e792752b4454889dead1a66caae2c60f.1087 = private unnamed_addr constant [1230 x i8] c"Whether to add quotes around type annotations, if doing so would allow\0Athe corresponding import to be moved into a type-checking block.\0A\0AFor example, in the following, Python requires that `Sequence` be\0Aavailable at runtime, despite the fact that it's only used in a type\0Aannotation:\0A\0A```python\0Afrom collections.abc import Sequence\0A\0A\0Adef func(value: Sequence[int]) -> None:\0A    ...\0A```\0A\0AIn other words, moving `from collections.abc import Sequence` into an\0A`if TYPE_CHECKING:` block above would cause a runtime error, as the\0Atype would no longer be available at runtime.\0A\0ABy default, Ruff will respect such runtime semantics and avoid moving\0Athe import to prevent such runtime errors.\0A\0ASetting `quote-annotations` to `true` will instruct Ruff to add quotes\0Aaround the annotation (e.g., `\22Sequence[int]\22`), which in turn enables\0ARuff to move the import into an `if TYPE_CHECKING:` block, like so:\0A\0A```python\0Afrom typing import TYPE_CHECKING\0A\0Aif TYPE_CHECKING:\0A    from collections.abc import Sequence\0A\0A\0Adef func(value: \22Sequence[int]\22) -> None:\0A    ...\0A```\0A\0ANote that this setting has no effect when `from __future__ import annotations`\0Ais present, as `__future__` annotations are always treated equivalently\0Ato quoted annotations.", align 1
@anon.e792752b4454889dead1a66caae2c60f.1089 = private unnamed_addr constant [138 x i8] c"# Add quotes around type annotations, if doing so would allow\0A# an import to be moved into a type-checking block.\0Aquote-annotations = true", align 1
@anon.e792752b4454889dead1a66caae2c60f.1091 = private unnamed_addr constant [17 x i8] c"quote-annotations", align 1
@anon.e792752b4454889dead1a66caae2c60f.1092 = private unnamed_addr constant [45 x i8] c"Options for the `flake8-type-checking` plugin", align 1
@anon.e792752b4454889dead1a66caae2c60f.1094 = private unnamed_addr constant [25 x i8] c"Flake8TypeCheckingOptions", align 1
