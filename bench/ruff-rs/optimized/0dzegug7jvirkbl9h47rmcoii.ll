@anon.158f56963078a041553d42a6ce1813d5.1230 = private unnamed_addr constant [28 x i8] c"pandas-use-of-dot-read-table", align 1
@anon.158f56963078a041553d42a6ce1813d5.1231 = private unnamed_addr constant [873 x i8] c"## What it does\0AChecks for uses of `pd.read_table` to read CSV files.\0A\0A## Why is this bad?\0AIn the Pandas API, `pd.read_csv` and `pd.read_table` are equivalent apart\0Afrom their default separator: `pd.read_csv` defaults to a comma (`,`),\0Awhile `pd.read_table` defaults to a tab (`\\t`) as the default separator.\0A\0APrefer `pd.read_csv` over `pd.read_table` when reading comma-separated\0Adata (like CSV files), as it is more idiomatic.\0A\0A## Example\0A```python\0Aimport pandas as pd\0A\0Acities_df = pd.read_table(\22cities.csv\22, sep=\22,\22)\0A```\0A\0AUse instead:\0A```python\0Aimport pandas as pd\0A\0Acities_df = pd.read_csv(\22cities.csv\22)\0A```\0A\0A## References\0A- [Pandas documentation: `read_csv`](https://pandas.pydata.org/docs/reference/api/pandas.read_csv.html#pandas.read_csv)\0A- [Pandas documentation: `read_table`](https://pandas.pydata.org/docs/reference/api/pandas.read_table.html#pandas.read_table)\0A", align 1
@anon.158f56963078a041553d42a6ce1813d5.1232 = private unnamed_addr constant [58 x i8] c"Use `.read_csv` instead of `.read_table` to read CSV files", align 1
@anon.158f56963078a041553d42a6ce1813d5.1233 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.158f56963078a041553d42a6ce1813d5.1232, [8 x i8] c":\00\00\00\00\00\00\00" }>, align 8
@anon.158f56963078a041553d42a6ce1813d5.1234 = private unnamed_addr constant [20 x i8] c"pandas-use-of-dot-ix", align 1
@anon.158f56963078a041553d42a6ce1813d5.1235 = private unnamed_addr constant [937 x i8] c"## What it does\0AChecks for uses of `.ix` on Pandas objects.\0A\0A## Why is this bad?\0AThe `.ix` method is deprecated as its behavior is ambiguous. Specifically,\0Ait's often unclear whether `.ix` is indexing by label or by ordinal position.\0A\0AInstead, prefer the `.loc` method for label-based indexing, and `.iloc` for\0Aordinal indexing.\0A\0A## Example\0A```python\0Aimport pandas as pd\0A\0Astudents_df = pd.read_csv(\22students.csv\22)\0Astudents_df.ix[0]  # 0th row or row with label 0?\0A```\0A\0AUse instead:\0A```python\0Aimport pandas as pd\0A\0Astudents_df = pd.read_csv(\22students.csv\22)\0Astudents_df.iloc[0]  # 0th row.\0A```\0A\0A## References\0A- [Pandas release notes: Deprecate `.ix`](https://pandas.pydata.org/pandas-docs/version/0.20/whatsnew.html#deprecate-ix)\0A- [Pandas documentation: `loc`](https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.loc.html)\0A- [Pandas documentation: `iloc`](https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.iloc.html)\0A", align 1
@anon.158f56963078a041553d42a6ce1813d5.1236 = private unnamed_addr constant [56 x i8] c"`.ix` is deprecated; use more explicit `.loc` or `.iloc`", align 1
@anon.158f56963078a041553d42a6ce1813d5.1237 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.158f56963078a041553d42a6ce1813d5.1236, [8 x i8] c"8\00\00\00\00\00\00\00" }>, align 8
@anon.158f56963078a041553d42a6ce1813d5.1238 = private unnamed_addr constant [20 x i8] c"pandas-use-of-dot-at", align 1
@anon.158f56963078a041553d42a6ce1813d5.1239 = private unnamed_addr constant [934 x i8] c"## What it does\0AChecks for uses of `.at` on Pandas objects.\0A\0A## Why is this bad?\0AThe `.at` method selects a single value from a `DataFrame` or Series based on\0Aa label index, and is slightly faster than using `.loc`. However, `.loc` is\0Amore idiomatic and versatile, as it can be used to select multiple values at\0Aonce.\0A\0AIf performance is an important consideration, convert the object to a NumPy\0Aarray, which will provide a much greater performance boost than using `.at`\0Aover `.loc`.\0A\0A## Example\0A```python\0Aimport pandas as pd\0A\0Astudents_df = pd.read_csv(\22students.csv\22)\0Astudents_df.at[\22Maria\22]\0A```\0A\0AUse instead:\0A```python\0Aimport pandas as pd\0A\0Astudents_df = pd.read_csv(\22students.csv\22)\0Astudents_df.loc[\22Maria\22]\0A```\0A\0A## References\0A- [Pandas documentation: `loc`](https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.loc.html)\0A- [Pandas documentation: `at`](https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.at.html)\0A", align 1
@anon.158f56963078a041553d42a6ce1813d5.1240 = private unnamed_addr constant [62 x i8] c"Use `.loc` instead of `.at`. If speed is important, use NumPy.", align 1
