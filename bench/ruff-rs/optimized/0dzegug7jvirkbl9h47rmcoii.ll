@anon.158f56963078a041553d42a6ce1813d5.981 = private unnamed_addr constant [15 x i8] c"async-busy-wait", align 1
@anon.158f56963078a041553d42a6ce1813d5.982 = private unnamed_addr constant [765 x i8] c"## What it does\0AChecks for the use of an async sleep function in a `while` loop.\0A\0A## Why is this bad?\0AInstead of sleeping in a `while` loop, and waiting for a condition\0Ato become true, it's preferable to `await` on an `Event` object such\0Aas: `asyncio.Event`, `trio.Event`, or `anyio.Event`.\0A\0A## Example\0A```python\0ADONE = False\0A\0A\0Aasync def func():\0A    while not DONE:\0A        await asyncio.sleep(1)\0A```\0A\0AUse instead:\0A```python\0ADONE = asyncio.Event()\0A\0A\0Aasync def func():\0A    await DONE.wait()\0A```\0A\0A## References\0A- [`asyncio` events](https://docs.python.org/3/library/asyncio-sync.html#asyncio.Event)\0A- [`anyio` events](https://anyio.readthedocs.io/en/latest/api.html#anyio.Event)\0A- [`trio` events](https://trio.readthedocs.io/en/latest/reference-core.html#trio.Event)\0A", align 1
@anon.158f56963078a041553d42a6ce1813d5.983 = private unnamed_addr constant [5 x i8] c"Use `", align 1
@anon.158f56963078a041553d42a6ce1813d5.984 = private unnamed_addr constant [29 x i8] c".Event` instead of awaiting `", align 1
@anon.158f56963078a041553d42a6ce1813d5.985 = private unnamed_addr constant [25 x i8] c".sleep` in a `while` loop", align 1
@anon.158f56963078a041553d42a6ce1813d5.986 = private unnamed_addr constant <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8] }> <{ ptr @anon.158f56963078a041553d42a6ce1813d5.983, [8 x i8] c"\05\00\00\00\00\00\00\00", ptr @anon.158f56963078a041553d42a6ce1813d5.984, [8 x i8] c"\1D\00\00\00\00\00\00\00", ptr @anon.158f56963078a041553d42a6ce1813d5.985, [8 x i8] c"\19\00\00\00\00\00\00\00" }>, align 8
@anon.158f56963078a041553d42a6ce1813d5.987 = private unnamed_addr constant [75 x i8] c"Use `{module}.Event` instead of awaiting `{module}.sleep` in a `while` loop", align 1
@anon.158f56963078a041553d42a6ce1813d5.988 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.158f56963078a041553d42a6ce1813d5.987, [8 x i8] c"K\00\00\00\00\00\00\00" }>, align 8
@anon.158f56963078a041553d42a6ce1813d5.989 = private unnamed_addr constant [29 x i8] c"hardcoded-bind-all-interfaces", align 1
@anon.158f56963078a041553d42a6ce1813d5.990 = private unnamed_addr constant [514 x i8] c"## What it does\0AChecks for hardcoded bindings to all network interfaces (`0.0.0.0`).\0A\0A## Why is this bad?\0ABinding to all network interfaces is insecure as it allows access from\0Aunintended interfaces, which may be poorly secured or unauthorized.\0A\0AInstead, bind to specific interfaces.\0A\0A## Example\0A```python\0AALLOWED_HOSTS = [\220.0.0.0\22]\0A```\0A\0AUse instead:\0A```python\0AALLOWED_HOSTS = [\22127.0.0.1\22, \22localhost\22]\0A```\0A\0A## References\0A- [Common Weakness Enumeration: CWE-200](https://cwe.mitre.org/data/definitions/200.html)\0A", align 1
@anon.158f56963078a041553d42a6ce1813d5.991 = private unnamed_addr constant [34 x i8] c"Possible binding to all interfaces", align 1
@anon.158f56963078a041553d42a6ce1813d5.992 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.158f56963078a041553d42a6ce1813d5.991, [8 x i8] c"\22\00\00\00\00\00\00\00" }>, align 8
@anon.158f56963078a041553d42a6ce1813d5.993 = private unnamed_addr constant [23 x i8] c"suspicious-pickle-usage", align 1
@anon.158f56963078a041553d42a6ce1813d5.994 = private unnamed_addr constant [1277 x i8] c"## What it does\0AChecks for calls to `pickle` functions or modules that wrap them.\0A\0A## Why is this bad?\0ADeserializing untrusted data with `pickle` and other deserialization\0Amodules is insecure as it can allow for the creation of arbitrary objects,\0Awhich can then be used to achieve arbitrary code execution and otherwise\0Aunexpected behavior.\0A\0AAvoid deserializing untrusted data with `pickle` and other deserialization\0Amodules. Instead, consider safer formats, such as JSON.\0A\0AIf you must deserialize untrusted data with `pickle`, consider signing the\0Adata with a secret key and verifying the signature before deserializing the\0Apayload, This will prevent an attacker from injecting arbitrary objects\0Ainto the serialized data.\0A\0AIn [preview], this rule will also flag references to `pickle` functions.\0A\0A## Example\0A```python\0Aimport pickle\0A\0Awith open(\22foo.pickle\22, \22rb\22) as file:\0A    foo = pickle.load(file)\0A```\0A\0AUse instead:\0A```python\0Aimport json\0A\0Awith open(\22foo.json\22, \22rb\22) as file:\0A    foo = json.load(file)\0A```\0A\0A## References\0A- [Python documentation: `pickle` \E2\80\94 Python object serialization](https://docs.python.org/3/library/pickle.html)\0A- [Common Weakness Enumeration: CWE-502](https://cwe.mitre.org/data/definitions/502.html)\0A\0A[preview]: https://docs.astral.sh/ruff/preview/\0A", align 1
