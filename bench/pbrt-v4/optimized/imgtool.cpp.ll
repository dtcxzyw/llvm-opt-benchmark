@.str.14 = private unnamed_addr constant [27 x i8] c"bloom [options] <filename>\00", align 1
@.str.15 = private unnamed_addr constant [136 x i8] c"Apply a bloom effect to the specified image where pixels that are\0A    brighter than a threshold are blurred and added to nearby pixels.\00", align 1
@.str.16 = private unnamed_addr constant [573 x i8] c"\0A    --iterations <n>   Number of filtering iterations used to generate the bloom\0A                       image. Default: 5\0A    --level <n>        Minimum RGB value for a pixel for it to contribute to bloom.\0A                       Default: Infinity (i.e., no bloom is applied)\0A    --outfile <name>   Output image filename.\0A    --scale <s>        Amount by which the bloom image is scaled before being\0A                       added to the original image. Default: 0.3\0A    --width <w>        Width of Gaussian used to generate bloom images.\0A                       Default: 15\0A\00", align 1
@.str.17 = private unnamed_addr constant [8 x i8] c"convert\00", align 1
@.str.18 = private unnamed_addr constant [29 x i8] c"convert [options] <filename>\00", align 1
@.str.19 = private unnamed_addr constant [132 x i8] c"Convert an image, possibly going from one format to another.\0A    A variety of image processing operations can be performed as well.\00", align 1
@.str.20 = private unnamed_addr constant [1810 x i8] c"\0A    --aces-filmic      Apply the ACES filmic s-curve to map values to [0,1].\0A    --bw               Convert to black and white (average channels)\0A    --channels <names> Process the provided comma-delineated set of channels.\0A                       Default: R,G,B.\0A    --clamp <value>    Rescale pixel components if necessary so that they do not\0A                       exceed <value>. Default: no clamping.\0A    --crop <x0,x1,y0,y1> Crop image to the given dimensions. Default: no crop.\0A    --colorspace <n>   Convert image to given colorspace.\0A                       (Options: \22ACES2065-1\22, \22Rec2020\22, \22DCI-P3\22, \22sRGB\22)\0A    --despike <v>      For any pixels with a luminance value greater than <v>,\0A                       replace the pixel with the median of the 3x3 neighboring\0A                       pixels. Default: infinity (i.e., disabled).\0A    --flipy            Flip the image along the y axis\0A    --fp16             Convert image to fp16 pixel format.\0A    --gamma <v>        Apply a gamma curve with exponent v. (Default: 1 (none)).\0A    --maxluminance <n> Luminance value mapped to white by tonemapping.\0A                       Default: 1\0A    --outfile <name>   Output image filename.\0A    --preservecolors   By default, out-of-gammut colors have each component\0A                       clamped to [0,1] when written to non-HDR formats. With\0A                       this option enabled, such colors are scaled by their\0A                       maximum component, which preserves the relative ratio\0A                       between RGB components.\0A    --repeatpix <n>    Repeat each pixel value n times in both directions\0A    --scale <scale>    Scale pixel values by given amount\0A    --tonemap          Apply tonemapping to the image (Reinhard et al.'s\0A                       photographic tone mapping operator)\0A\00", align 1
@.str.21 = private unnamed_addr constant [5 x i8] c"diff\00", align 1
@.str.22 = private unnamed_addr constant [26 x i8] c"diff [options] <filename>\00", align 1
@.str.23 = private unnamed_addr constant [146 x i8] c"Compute the difference between an image and a reference image\0A    according to a variety of metrics and optionally output a\0A    difference image.\00", align 1
@.str.24 = private unnamed_addr constant [589 x i8] c"\0A    --channels <names> Comma-separated list of channels to include in comparison.\0A                       Default: R,G,B.\0A    --crop <x0,x1,y0,y1> Crop images before performing diff.\0A    --difftol <v>      Acceptable image difference percentage before differences\0A                       are reported. Default: 0\0A    --metric <name>    Error metric to use. (Options: \22MAE\22, \22MSE\22, \22MRSE\22, \22FLIP\22)\0A    --outfile <name>   Filename to use for saving an image that encodes the\0A                       absolute value of per-pixel differences.\0A    --reference <name> Filename for reference image\0A\00", align 1
@.str.25 = private unnamed_addr constant [6 x i8] c"error\00", align 1
@.str.26 = private unnamed_addr constant [34 x i8] c"error [options] <filename prefix>\00", align 1
