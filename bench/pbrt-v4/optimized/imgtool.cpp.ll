@.str.28 = private unnamed_addr constant [244 x i8] c"\0A    --crop <x0,x1,y0,y1> Crop images before performing diff.\0A    --errorfile <name>   Output average error image.\0A    --metric <name>      Error metric to use. (Options: \22MAE\22, MSE\22, \22MRSE\22)\0A    --reference <name>   Reference image filename.\0A\00", align 1
@.str.29 = private unnamed_addr constant [11 x i8] c"falsecolor\00", align 1
@.str.30 = private unnamed_addr constant [32 x i8] c"falsecolor [options] <filename>\00", align 1
@.str.31 = private unnamed_addr constant [124 x i8] c"Generate a false color image encoding the magnitude of the\0A    average of the channels in each pixel in the provided image.\00", align 1
