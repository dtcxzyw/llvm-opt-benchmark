@.str.12 = private unnamed_addr constant [233 x i8] c"\0A    --csv              Output pixel values in CSV format.\0A    --list             Output pixel values in a brace-delimited list\0A                       (Mathematica-compatible).\0A    --sort             Sort output by pixel luminance.\0A\00", align 1
