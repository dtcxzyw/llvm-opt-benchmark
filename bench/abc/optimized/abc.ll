@.str.4448 = private unnamed_addr constant [81 x i8] c"\09         It should be a string without spaces containing monomials in terms of\0A\00", align 1
@.str.4449 = private unnamed_addr constant [85 x i8] c"\09         inputs (i<num>) and outputs (o<num>) where <num> is 0-based. Coefficients\0A\00", align 1
@.str.4450 = private unnamed_addr constant [81 x i8] c"\09         are degrees of two, represented by log2 of their value: for example, \0A\00", align 1
@.str.4451 = private unnamed_addr constant [66 x i8] c"\09         \222\22 is 2^2 = 4, \22-4\22 is -2^4=-16, \22-0\22 is -2^0=-1, etc\0A\00", align 1
@.str.4452 = private unnamed_addr constant [48 x i8] c"\09         Two types of signature are accepted:\0A\00", align 1
@.str.4453 = private unnamed_addr constant [92 x i8] c"\09         (1) a sequence of monomials without parentheses (for example, \22-2*o0+1*o1+0*o2\22)\0A\00", align 1
@.str.4454 = private unnamed_addr constant [76 x i8] c"\09         (2) a product of two sequences followed by a sum with a sequence\0A\00", align 1
@.str.4455 = private unnamed_addr constant [83 x i8] c"\09             (for example, \22(4*o0+2*o1+1*o2)*(4*i3+2*i4+1*i5)+(4*o3+2*o4+1*o5)\22)\0A\00", align 1
@.str.4456 = private unnamed_addr constant [87 x i8] c"\09         Here is the signature of a signed 2-bit multiplier: \22(0*o0+1*o1+2*o2-3*o3)\22\0A\00", align 1
