@.str.4505 = private unnamed_addr constant [83 x i8] c"\09-n      : toggles dumping faults not detected by a given test set [default = %s]\0A\00", align 1
@.str.4506 = private unnamed_addr constant [64 x i8] c"\09-v      : toggles printing verbose information [default = %s]\0A\00", align 1
@.str.4507 = private unnamed_addr constant [59 x i8] c"\09<file>  : (optional) file name with input test patterns\0A\0A\00", align 1
@.str.4508 = private unnamed_addr constant [56 x i8] c"\09-G file : (optional) file name with the golden model\0A\0A\00", align 1
@.str.4509 = private unnamed_addr constant [69 x i8] c"\09-F file : (optional) file name with the fault model in BLIF format\0A\00", align 1
@.str.4510 = private unnamed_addr constant [59 x i8] c"\09-S str  : (optional) string representing the fault model\0A\00", align 1
@.str.4511 = private unnamed_addr constant [46 x i8] c"\09          The following notations are used:\0A\00", align 1
@.str.4512 = private unnamed_addr constant [76 x i8] c"\09            Functional variables: {a,b} (both a and b are always present)\0A\00", align 1
@.str.4513 = private unnamed_addr constant [78 x i8] c"\09            Parameter variables: {p,q,r,s,t,u,v,w} (any number from 1 to 8)\0A\00", align 1
@.str.4514 = private unnamed_addr constant [72 x i8] c"\09            Boolean operators: AND(&), OR(|), XOR(^), MUX(?:), NOT(~)\0A\00", align 1
@.str.4515 = private unnamed_addr constant [83 x i8] c"\09            Parentheses should be used around each operator. Spaces not allowed.\0A\00", align 1
@.str.4516 = private unnamed_addr constant [82 x i8] c"\09            Complement (~) is only allowed before variables (use DeMorgan law).\0A\00", align 1
@.str.4517 = private unnamed_addr constant [24 x i8] c"\09            Examples:\0A\00", align 1
@.str.4518 = private unnamed_addr constant [65 x i8] c"\09              (((a&b)&~p)|q)        stuck-at-0/1 at the output\0A\00", align 1
@.str.4519 = private unnamed_addr constant [62 x i8] c"\09              (((a&~p)|q)&b)        stuck-at-0/1 at input a\0A\00", align 1
@.str.4520 = private unnamed_addr constant [92 x i8] c"\09              (((a|p)&(b|q))&~r)    stuck-at-1 at the inputs and stuck-at-0 at the output\0A\00", align 1
@.str.4521 = private unnamed_addr constant [92 x i8] c"\09              (((a&~p)&(b&~q))|r)   stuck-at-0 at the inputs and stuck-at-1 at the output\0A\00", align 1
@.str.4522 = private unnamed_addr constant [63 x i8] c"\09              ((a&b)^p)             complement at the output\0A\00", align 1
@.str.4523 = private unnamed_addr constant [81 x i8] c"\09              (((a^p)&(b^q))^r)     complement at the inputs and at the output\0A\00", align 1
@.str.4524 = private unnamed_addr constant [82 x i8] c"\09              (a?(b?~s:r):(b?q:p))  functionally observable fault at the output\0A\00", align 1
@.str.4525 = private unnamed_addr constant [56 x i8] c"\09              (p?(a|b):(a&b))       replace AND by OR\0A\00", align 1
@.str.4526 = private unnamed_addr constant [95 x i8] c"\09           If the BLIF file is used for the formula with option '-F', following rules apply:\0A\00", align 1
@.str.4527 = private unnamed_addr constant [90 x i8] c"\09              - the network should be combinational and have exactly one primary output\0A\00", align 1
@.str.4528 = private unnamed_addr constant [62 x i8] c"\09              - input names should have only one character:\0A\00", align 1
@.str.4529 = private unnamed_addr constant [52 x i8] c"\09                {a, b} (for functional variables)\0A\00", align 1
@.str.4530 = private unnamed_addr constant [62 x i8] c"\09                {p,q,r,s,t,u,v,w} (for parameter variables)\0A\00", align 1
@.str.4531 = private unnamed_addr constant [11 x i8] c"PICTKdegvh\00", align 1
@.str.4532 = private unnamed_addr constant [26 x i8] c"There is no current GIA.\0A\00", align 1
@.str.4533 = private unnamed_addr constant [35 x i8] c"usage: &qbf [-PICTK num] [-degvh]\0A\00", align 1
@.str.4534 = private unnamed_addr constant [53 x i8] c"\09-C num : conflict limit per problem [default = %d]\0A\00", align 1
@.str.4535 = private unnamed_addr constant [78 x i8] c"\09-K num : the number of input bits (for encoding miters only) [default = %d]\0A\00", align 1
@.str.4536 = private unnamed_addr constant [92 x i8] c"\09-d     : toggle dumping QDIMACS file instead of solving (complemented QBF) [default = %s]\0A\00", align 1
@.str.4537 = private unnamed_addr constant [88 x i8] c"\09-e     : toggle dumping QDIMACS file instead of solving (original QBF) [default = %s]\0A\00", align 1
@.str.4538 = private unnamed_addr constant [117 x i8] c"\09         As an example of using this command, consider specification (the three-input AND-gate) and implementation\0A\00", align 1
@.str.4539 = private unnamed_addr constant [125 x i8] c"\09         (the circuit with function AND(XOR(x0, x1), x2)).  The problem is to check whether the output of the XOR (node n)\0A\00", align 1
@.str.4540 = private unnamed_addr constant [115 x i8] c"\09         can be implemented differently, so that these two circuits are equivalent.  Obviously this can be done!\0A\00", align 1
@.str.4541 = private unnamed_addr constant [49 x i8] c"\09         Simply replace XOR gate by AND gate.\0A\0A\00", align 1
@.str.4542 = private unnamed_addr constant [28 x i8] c"\09         > # file s2.blif\0A\00", align 1
@.str.4543 = private unnamed_addr constant [25 x i8] c"\09         > .model and3\0A\00", align 1
@.str.4544 = private unnamed_addr constant [32 x i8] c"\09         > .inputs x0 x1 x2 n\0A\00", align 1
@.str.4545 = private unnamed_addr constant [27 x i8] c"\09         > .names m x2 F\0A\00", align 1
@.str.4546 = private unnamed_addr constant [18 x i8] c"\09         > 11 1\0A\00", align 1
@.str.4547 = private unnamed_addr constant [28 x i8] c"\09         > .names x0 x1 m\0A\00", align 1
@.str.4548 = private unnamed_addr constant [28 x i8] c"\09         > # file i2.blif\0A\00", align 1
@.str.4549 = private unnamed_addr constant [25 x i8] c"\09         > .model impl\0A\00", align 1
@.str.4550 = private unnamed_addr constant [27 x i8] c"\09         > .names n x2 F\0A\00", align 1
@.str.4551 = private unnamed_addr constant [29 x i8] c"\09         > #.names x0 x1 n\0A\00", align 1
@.str.4552 = private unnamed_addr constant [19 x i8] c"\09         > #01 1\0A\00", align 1
@.str.4553 = private unnamed_addr constant [19 x i8] c"\09         > #10 1\0A\00", align 1
@.str.4554 = private unnamed_addr constant [50 x i8] c"\09         > abc 08> miter -n i2.blif s2.blif; ps\0A\00", align 1
@.str.4555 = private unnamed_addr constant [98 x i8] c"\09         > impl_and3_miter               : i/o =    4/    1  lat =    0  and =      6  lev =  4\0A\00", align 1
@.str.4556 = private unnamed_addr constant [37 x i8] c"\09         > abc 09> &get; &qbf -P 3\0A\00", align 1
@.str.4557 = private unnamed_addr constant [76 x i8] c"\09         > The problem is UNSAT after 1 iterations.  Time =     0.00 sec\0A\0A\00", align 1
@.str.4558 = private unnamed_addr constant [104 x i8] c"\09         UNSAT here means that the ECO solution with the given rectification point *has* a solution.\0A\0A\00", align 1
@.str.4559 = private unnamed_addr constant [115 x i8] c"\09         For more info, refer to Figure 1 in the following paper A. Q. Dao, N.-Z. Lee, L.-C. Chen, M. P.-H. Lin,\0A\00", align 1
@.str.4560 = private unnamed_addr constant [120 x i8] c"\09         J.-H. R. Jiang, A. Mishchenko, and R. Brayton, \22Efficient computation of ECO patch functions\22, Proc. DAC'18.\0A\00", align 1
