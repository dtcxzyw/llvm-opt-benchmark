@.str.4316 = private unnamed_addr constant [86 x i8] c"\09-k      : toggles non-strict cardinality (n <= K, instead of n == K) [default = %s]\0A\00", align 1
@.str.4317 = private unnamed_addr constant [82 x i8] c"\09-b      : toggles testing for single faults (the same as \22-K 1\22) [default = %s]\0A\00", align 1
@.str.4318 = private unnamed_addr constant [78 x i8] c"\09-s      : toggles starting with the all-0 and all-1 patterns [default = %s]\0A\00", align 1
@.str.4319 = private unnamed_addr constant [87 x i8] c"\09-f      : toggles faults at flop inputs only with \22-A 1\22 and \22-S str\22 [default = %s]\0A\00", align 1
@.str.4320 = private unnamed_addr constant [75 x i8] c"\09-c      : toggles checking if there are untestable faults [default = %s]\0A\00", align 1
@.str.4321 = private unnamed_addr constant [86 x i8] c"\09-d      : toggles dumping test patterns into file \22<file>_tests.txt\22 [default = %s]\0A\00", align 1
@.str.4322 = private unnamed_addr constant [82 x i8] c"\09-e      : toggles dumping test pattern pairs (delay faults only) [default = %s]\0A\00", align 1
@.str.4323 = private unnamed_addr constant [86 x i8] c"\09-u      : toggles dumping untestable faults into \22<file>_untest.txt\22 [default = %s]\0A\00", align 1
@.str.4324 = private unnamed_addr constant [83 x i8] c"\09-n      : toggles dumping faults not detected by a given test set [default = %s]\0A\00", align 1
@.str.4325 = private unnamed_addr constant [64 x i8] c"\09-v      : toggles printing verbose information [default = %s]\0A\00", align 1
@.str.4326 = private unnamed_addr constant [59 x i8] c"\09<file>  : (optional) file name with input test patterns\0A\0A\00", align 1
@.str.4327 = private unnamed_addr constant [56 x i8] c"\09-G file : (optional) file name with the golden model\0A\0A\00", align 1
@.str.4328 = private unnamed_addr constant [69 x i8] c"\09-F file : (optional) file name with the fault model in BLIF format\0A\00", align 1
@.str.4329 = private unnamed_addr constant [59 x i8] c"\09-S str  : (optional) string representing the fault model\0A\00", align 1
@.str.4330 = private unnamed_addr constant [46 x i8] c"\09          The following notations are used:\0A\00", align 1
@.str.4331 = private unnamed_addr constant [76 x i8] c"\09            Functional variables: {a,b} (both a and b are always present)\0A\00", align 1
@.str.4332 = private unnamed_addr constant [78 x i8] c"\09            Parameter variables: {p,q,r,s,t,u,v,w} (any number from 1 to 8)\0A\00", align 1
@.str.4333 = private unnamed_addr constant [72 x i8] c"\09            Boolean operators: AND(&), OR(|), XOR(^), MUX(?:), NOT(~)\0A\00", align 1
@.str.4334 = private unnamed_addr constant [83 x i8] c"\09            Parentheses should be used around each operator. Spaces not allowed.\0A\00", align 1
@.str.4335 = private unnamed_addr constant [82 x i8] c"\09            Complement (~) is only allowed before variables (use DeMorgan law).\0A\00", align 1
@.str.4336 = private unnamed_addr constant [24 x i8] c"\09            Examples:\0A\00", align 1
@.str.4337 = private unnamed_addr constant [65 x i8] c"\09              (((a&b)&~p)|q)        stuck-at-0/1 at the output\0A\00", align 1
@.str.4338 = private unnamed_addr constant [62 x i8] c"\09              (((a&~p)|q)&b)        stuck-at-0/1 at input a\0A\00", align 1
@.str.4339 = private unnamed_addr constant [92 x i8] c"\09              (((a|p)&(b|q))&~r)    stuck-at-1 at the inputs and stuck-at-0 at the output\0A\00", align 1
@.str.4340 = private unnamed_addr constant [92 x i8] c"\09              (((a&~p)&(b&~q))|r)   stuck-at-0 at the inputs and stuck-at-1 at the output\0A\00", align 1
@.str.4341 = private unnamed_addr constant [63 x i8] c"\09              ((a&b)^p)             complement at the output\0A\00", align 1
@.str.4342 = private unnamed_addr constant [81 x i8] c"\09              (((a^p)&(b^q))^r)     complement at the inputs and at the output\0A\00", align 1
@.str.4343 = private unnamed_addr constant [82 x i8] c"\09              (a?(b?~s:r):(b?q:p))  functionally observable fault at the output\0A\00", align 1
@.str.4344 = private unnamed_addr constant [56 x i8] c"\09              (p?(a|b):(a&b))       replace AND by OR\0A\00", align 1
@.str.4345 = private unnamed_addr constant [95 x i8] c"\09           If the BLIF file is used for the formula with option '-F', following rules apply:\0A\00", align 1
@.str.4346 = private unnamed_addr constant [90 x i8] c"\09              - the network should be combinational and have exactly one primary output\0A\00", align 1
@.str.4347 = private unnamed_addr constant [62 x i8] c"\09              - input names should have only one character:\0A\00", align 1
@.str.4348 = private unnamed_addr constant [52 x i8] c"\09                {a, b} (for functional variables)\0A\00", align 1
@.str.4349 = private unnamed_addr constant [62 x i8] c"\09                {p,q,r,s,t,u,v,w} (for parameter variables)\0A\00", align 1
