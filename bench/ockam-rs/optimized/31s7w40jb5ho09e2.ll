@anon.028ca9b3aedbfbb221d4bc3d3e304b9c.107 = private unnamed_addr constant <{ [10783 x i8] }> <{ [10783 x i8] c"--------------\0A-- IDENTITIES\0A--------------\0A\0A-- This table stores identities with\0A--  - the identity identifier (as a hex-encoded string)\0A--  - the encoded history of all the key rotations for this identity\0ACREATE TABLE identity\0A(\0A    identifier     TEXT NOT NULL UNIQUE,\0A    change_history TEXT NOT NULL\0A);\0A\0A-- This table some local metadata about identities\0ACREATE TABLE named_identity\0A(\0A    identifier TEXT NOT NULL UNIQUE, -- Identity identifier\0A    name       TEXT UNIQUE,          -- user-specified name\0A    vault_name TEXT NOT NULL,        -- name of the vault used to store the identity keys\0A    is_default INTEGER DEFAULT 0     -- boolean indicating if this identity is the default one (0 means true)\0A);\0A\0A-- This table stores the time when a given identity was enrolled\0A-- In the current project\0ACREATE TABLE identity_enrollment\0A(\0A    identifier  TEXT    NOT NULL UNIQUE, -- Identifier of the identity\0A    enrolled_at INTEGER NOT NULL         -- UNIX timestamp in seconds\0A);\0A\0A-- This table lists attributes associated to a given identity\0ACREATE TABLE identity_attributes\0A(\0A    identifier  TEXT PRIMARY KEY, -- identity possessing those attributes\0A    attributes  BLOB    NOT NULL, -- serialized list of attribute names and values for the identity\0A    added       INTEGER NOT NULL, -- UNIX timestamp in seconds: when those attributes were inserted in the database\0A    expires     INTEGER,          -- optional UNIX timestamp in seconds: when those attributes expire\0A    attested_by TEXT              -- optional identifier which attested of these attributes\0A);\0A\0A-- This table stores purpose keys that have been created by a given identity\0ACREATE TABLE purpose_key\0A(\0A    identifier              TEXT NOT NULL, -- Identity identifier\0A    purpose                 TEXT NOT NULL, -- Purpose of the key: SecureChannels, or Credentials\0A    purpose_key_attestation BLOB NOT NULL  -- Encoded attestation: attestation data and attestation signature\0A);\0A\0ACREATE UNIQUE INDEX purpose_key_index ON purpose_key (identifier, purpose);\0A\0A----------\0A-- VAULTS\0A----------\0A\0A-- This table stores vault metadata when several vaults have been created locally\0ACREATE TABLE vault\0A(\0A    name       TEXT PRIMARY KEY, -- User-specified name for a vault\0A    path       TEXT NOT NULL,    -- Path where the vault is saved, This path can the current database path. In that case the vault data is stored in the *-secrets table below\0A    is_default INTEGER,          -- boolean indicating if this vault is the default one (0 means true)\0A    is_kms     INTEGER           -- boolean indicating if this vault is a KMS one (0 means true). In that case only key handles are stored in the database\0A);\0A\0A-- This table stores secrets for signing data\0ACREATE TABLE signing_secret\0A(\0A    handle      BLOB PRIMARY KEY, -- Secret handle\0A    secret_type TEXT NOT NULL,    -- Secret type (EdDSACurve25519 or ECDSASHA256CurveP256)\0A    secret      BLOB NOT NULL     -- Secret binary\0A);\0A\0A-- This table stores secrets for encrypting / decrypting data\0ACREATE TABLE x25519_secret\0A(\0A    handle BLOB PRIMARY KEY, -- Secret handle\0A    secret BLOB NOT NULL     -- Secret binary\0A);\0A\0A\0A---------------\0A-- CREDENTIALS\0A---------------\0A\0A-- This table stores credentials as received by the application\0ACREATE TABLE credential\0A(\0A    name                  TEXT PRIMARY KEY, -- User-defined name for this credential\0A    issuer_identifier     TEXT NOT NULL,    -- Identifier of the identity which issued this credential\0A    issuer_change_history TEXT NOT NULL,    -- Change history of the identity which issued this credential (hex-encoded)\0A    credential            TEXT NOT NULL     -- Encoded version of the credential: data + signature\0A);\0A\0A------------------\0A-- TRUST CONTEXTS\0A------------------\0A\0ACREATE TABLE trust_context\0A(\0A    name                     TEXT PRIMARY KEY, -- Name for the trust context\0A    trust_context_id         TEXT    NOT NULL, -- Identifier for the trust context to be used in policies\0A    is_default               INTEGER NOT NULL, -- boolean indicating if this trust context is the default one (0 means true)\0A    credential               TEXT,             -- optional encoded credential which can be retrieved from this trust context\0A    authority_change_history TEXT,             -- optional: change history of the authority to call for verifying credentials\0A    authority_route          TEXT              -- optional: route of the authority to call for verifying credentials\0A);\0A\0A-- This table stores policies. A policy is an expression which\0A-- can be evaluated against an environment (a list of name/value pairs)\0A-- to assess if a given action can be performed on a given resource\0ACREATE TABLE policy\0A(\0A    resource   TEXT NOT NULL, -- resource name\0A    action     TEXT NOT NULL, -- action name\0A    expression BLOB NOT NULL  -- encoded expression to evaluate\0A);\0A\0ACREATE UNIQUE INDEX policy_index ON policy (resource, action);\0A\0A---------\0A-- NODES\0A---------\0A\0A-- This table stores information about local nodes\0ACREATE TABLE node\0A(\0A    name                 TEXT PRIMARY KEY, -- Node name\0A    identifier           TEXT    NOT NULL, -- Identifier of the default identity associated to the node\0A    verbosity            INTEGER NOT NULL, -- Verbosity level used for logging\0A    is_default           INTEGER NOT NULL, -- boolean indicating if this node is the default one (0 means true)\0A    is_authority         INTEGER NOT NULL, -- boolean indicating if this node is an authority node (0 means true). This boolean is used to be able to show an authority node as UP even if its TCP listener cannot be accessed.\0A    tcp_listener_address TEXT,             -- Socket address for the node default TCP Listener (can be NULL if the node has not been started)\0A    pid                  INTEGER           -- Current process id of the node if it has been started\0A);\0A\0A-- This table stores the project name to use for a given node\0ACREATE TABLE node_project\0A(\0A    node_name    TEXT PRIMARY KEY, -- Node name\0A    project_name TEXT NOT NULL     -- Project name\0A);\0A\0A---------------------------\0A-- PROJECTS, SPACES, USERS\0A---------------------------\0A\0A-- This table store data about projects as returned by the Controller\0ACREATE TABLE project\0A(\0A    project_id             TEXT PRIMARY KEY, -- Identifier of the project\0A    project_name           TEXT    NOT NULL, -- Name of the project\0A    is_default             INTEGER NOT NULL, -- boolean indicating if this project is the default one (0 means true)\0A    space_id               TEXT    NOT NULL, -- Identifier of the space associated to the project\0A    space_name             TEXT    NOT NULL, -- Name of the space associated to the project\0A    identifier             TEXT,             -- optional: identifier of the project identity\0A    access_route           TEXT    NOT NULL, -- Route used to create a secure channel to the project\0A    authority_identity     TEXT,             -- Encoded identity of the authority associated to the project\0A    authority_access_route TEXT,             -- Route te the authority associated to the project\0A    version                TEXT,             -- Orchestrator software version\0A    running                INTEGER,          -- boolean indicating if this project is currently accessible\0A    operation_id           TEXT              -- optional id of the operation currently creating the project on the Controller side\0A);\0A\0A-- This table provides the list of users associated to a given project\0ACREATE TABLE user_project\0A(\0A    user_email TEXT NOT NULL, -- User email\0A    project_id TEXT NOT NULL  -- Project id\0A);\0A\0A-- This table provides additional information for users associated to a project or a space\0ACREATE TABLE user_role\0A(\0A    user_id    INTEGER NOT NULL, -- User id\0A    project_id TEXT    NOT NULL, -- Project id\0A    user_email TEXT    NOT NULL, -- User email\0A    role       TEXT    NOT NULL, -- Role of the user: admin or member\0A    scope      TEXT    NOT NULL  -- Scope of the role: space, project, or service\0A);\0A\0A-- This table stores data about spaces as returned by the controller\0ACREATE TABLE space\0A(\0A    space_id   TEXT PRIMARY KEY, -- Identifier of the space\0A    space_name TEXT    NOT NULL, -- Name of the space\0A    is_default INTEGER NOT NULL  -- boolean indicating if this project is the default one (0 means true)\0A);\0A\0A-- This table provides the list of users associated to a given project\0ACREATE TABLE user_space\0A(\0A    user_email TEXT NOT NULL, -- User email\0A    space_id   TEXT NOT NULL  -- Space id\0A);\0A\0A-- This table provides additional information for users after they have been authenticated\0ACREATE TABLE user\0A(\0A    email          TEXT PRIMARY KEY, -- User email\0A    sub            TEXT    NOT NULL, -- (Sub)ject: unique identifier for the user\0A    nickname       TEXT    NOT NULL, -- User nickname (or handle)\0A    name           TEXT    NOT NULL, -- User name\0A    picture        TEXT    NOT NULL, -- Link to a user picture\0A    updated_at     TEXT    NOT NULL, -- ISO-8601 date: when this user information was last update\0A    email_verified INTEGER NOT NULL, -- boolean indicating if the user email has been verified (0 means true)\0A    is_default     INTEGER NOT NULL  -- boolean indicating if this user is the default user locally (0 means true)\0A);\0A\0A---------------\0A-- APPLICATION\0A---------------\0A\0A-- This table stores the current state of an outlet created to expose a service with the desktop application\0ACREATE TABLE tcp_outlet_status\0A(\0A    alias       TEXT PRIMARY KEY, -- Name for the outlet\0A    socket_addr TEXT NOT NULL,    -- Socket address that the outlet connects to\0A    worker_addr TEXT NOT NULL,    -- Worker address for the outlet itself\0A    payload     TEXT              -- Optional status payload\0A);\0A\0A-- This table stores the list of services that a user has been invited to connect to\0A-- via the desktop application\0ACREATE TABLE incoming_service\0A(\0A    invitation_id TEXT PRIMARY KEY, -- Invitation id\0A    enabled       INTEGER NOT NULL, -- boolean indicating if the user wants to service to be accessible (0 means true)\0A    name          TEXT NULL         -- Optional user-defined name for the service\0A);\0A\0A----------\0A-- ADDONS\0A----------\0A\0A-- This table stores the data necessary to configure the Okta addon\0ACREATE TABLE okta_config\0A(\0A    project_id      TEXT NOT NULL, -- Project id of the project using the addon\0A    tenant_base_url TEXT NOT NULL, -- Base URL of the tenant\0A    client_id       TEXT NOT NULL, -- Client id\0A    certificate     TEXT NOT NULL, -- Certificate\0A    attributes      TEXT           -- Comma-separated list of attribute names\0A);\0A\0A-- This table stores the data necessary to configure the Confluent addon\0ACREATE TABLE confluent_config\0A(\0A    project_id       TEXT NOT NULL, -- Project id of the project using the addon\0A    bootstrap_server TEXT NOT NULL  -- URL of the bootstrap server\0A);\0A" }>, align 1
