@.str.428 = private unnamed_addr constant [47 x i8] c"upgrade packages using their most recent flake\00", align 1
@.str.429 = private unnamed_addr constant [741 x i8] c"\0A\0A# Examples\0A\0A* Upgrade all packages that were installed using an unlocked flake\0A  reference:\0A\0A  ```console\0A  # nix profile upgrade '.*'\0A  ```\0A\0A* Upgrade a specific package by name:\0A\0A  ```console\0A  # nix profile upgrade hello\0A  ```\0A\0A# Description\0A\0AThis command upgrades a previously installed package in a Nix profile,\0Aby fetching and evaluating the latest version of the flake from which\0Athe package was installed.\0A\0A> **Warning**\0A>\0A> This only works if you used an *unlocked* flake reference at\0A> installation time, e.g. `nixpkgs#hello`. It does not work if you\0A> used a *locked* flake reference\0A> (e.g. `github:NixOS/nixpkgs/13d0c311e3ae923a00f734b43fd1d35b47d8943a#hello`),\0A> since in that case the \22latest version\22 is always the same.\0A\0A\00", align 1
@.str.430 = private unnamed_addr constant [96 x i8] c"Found package '%s', but it was not installed from a flake, so it can't be checked for upgrades!\00", align 1
@.str.431 = private unnamed_addr constant [96 x i8] c"Found package '%s', but it was installed from a locked flake reference so it can't be upgraded!\00", align 1
@.str.432 = private unnamed_addr constant [26 x i8] c"checking '%s' for updates\00", align 1
@.str.433 = private unnamed_addr constant [39 x i8] c"upgrading '%s' from flake '%s' to '%s'\00", align 1
@.str.434 = private unnamed_addr constant [56 x i8] c"Found some packages but none of them could be upgraded.\00", align 1
