@.str.87 = private unnamed_addr constant [27 x i8] c"build-impersonate-linux-26\00", align 1
@.str.88 = private unnamed_addr constant [15 x i8] c"keep-build-log\00", align 1
@.str.89 = private unnamed_addr constant [291 x i8] c"\0A          If set to `true` (the default), Nix will write the build log of a\0A          derivation (i.e. the standard output and error of its builder) to\0A          the directory `/nix/var/log/nix/drvs`. The build log can be\0A          retrieved using the command `nix-store -l path`.\0A        \00", align 1
@.str.90 = private unnamed_addr constant [15 x i8] c"build-keep-log\00", align 1
@.str.91 = private unnamed_addr constant [19 x i8] c"compress-build-log\00", align 1
@.str.92 = private unnamed_addr constant [201 x i8] c"\0A          If set to `true` (the default), build logs written to\0A          `/nix/var/log/nix/drvs` will be compressed on the fly using bzip2.\0A          Otherwise, they will not be compressed.\0A        \00", align 1
@.str.93 = private unnamed_addr constant [19 x i8] c"build-compress-log\00", align 1
@.str.94 = private unnamed_addr constant [19 x i8] c"max-build-log-size\00", align 1
@.str.95 = private unnamed_addr constant [244 x i8] c"\0A          This option defines the maximum number of bytes that a builder can\0A          write to its stdout/stderr. If the builder exceeds this limit, it\E2\80\99s\0A          killed. A value of `0` (the default) means that there is no limit.\0A        \00", align 1
@.str.96 = private unnamed_addr constant [19 x i8] c"build-max-log-size\00", align 1
@.str.97 = private unnamed_addr constant [20 x i8] c"build-poll-interval\00", align 1
@.str.98 = private unnamed_addr constant [42 x i8] c"How often (in seconds) to poll for locks.\00", align 1
@.str.99 = private unnamed_addr constant [13 x i8] c"keep-outputs\00", align 1
@.str.100 = private unnamed_addr constant [633 x i8] c"\0A          If `true`, the garbage collector will keep the outputs of\0A          non-garbage derivations. If `false` (default), outputs will be\0A          deleted unless they are GC roots themselves (or reachable from other\0A          roots).\0A\0A          In general, outputs must be registered as roots separately. However,\0A          even if the output of a derivation is registered as a root, the\0A          collector will still delete store paths that are used only at build\0A          time (e.g., the C compiler, or source tarballs downloaded from the\0A          network). To prevent it from doing so, set this option to `true`.\0A        \00", align 1
@.str.101 = private unnamed_addr constant [16 x i8] c"gc-keep-outputs\00", align 1
@.str.102 = private unnamed_addr constant [17 x i8] c"keep-derivations\00", align 1
@.str.103 = private unnamed_addr constant [596 x i8] c"\0A          If `true` (default), the garbage collector will keep the derivations\0A          from which non-garbage store paths were built. If `false`, they will\0A          be deleted unless explicitly registered as a root (or reachable from\0A          other roots).\0A\0A          Keeping derivation around is useful for querying and traceability\0A          (e.g., it allows you to ask with what dependencies or options a\0A          store path was built), so by default this option is on. Turn it off\0A          to save a bit of disk space (or a lot if `keep-outputs` is also\0A          turned on).\0A        \00", align 1
@.str.104 = private unnamed_addr constant [20 x i8] c"gc-keep-derivations\00", align 1
@.str.105 = private unnamed_addr constant [20 x i8] c"auto-optimise-store\00", align 1
@.str.106 = private unnamed_addr constant [333 x i8] c"\0A          If set to `true`, Nix automatically detects files in the store\0A          that have identical contents, and replaces them with hard links to\0A          a single copy. This saves disk space. If set to `false` (the\0A          default), you can still run `nix-store --optimise` to get rid of\0A          duplicate files.\0A        \00", align 1
@.str.107 = private unnamed_addr constant [21 x i8] c"keep-env-derivations\00", align 1
@.str.108 = private unnamed_addr constant [914 x i8] c"\0A          If `false` (default), derivations are not stored in Nix user\0A          environments. That is, the derivations of any build-time-only\0A          dependencies may be garbage-collected.\0A\0A          If `true`, when you add a Nix derivation to a user environment, the\0A          path of the derivation is stored in the user environment. Thus, the\0A          derivation will not be garbage-collected until the user environment\0A          generation is deleted (`nix-env --delete-generations`). To prevent\0A          build-time-only dependencies from being collected, you should also\0A          turn on `keep-outputs`.\0A\0A          The difference between this option and `keep-derivations` is that\0A          this one is \E2\80\9Csticky\E2\80\9D: it applies to any user environment created\0A          while this option was enabled, while `keep-derivations` only applies\0A          at the moment the garbage collector is run.\0A        \00", align 1
@.str.109 = private unnamed_addr constant [21 x i8] c"env-keep-derivations\00", align 1
@.str.110 = private unnamed_addr constant [8 x i8] c"sandbox\00", align 1
@.str.111 = private unnamed_addr constant [1363 x i8] c"\0A          If set to `true`, builds will be performed in a *sandboxed\0A          environment*, i.e., they\E2\80\99re isolated from the normal file system\0A          hierarchy and will only see their dependencies in the Nix store,\0A          the temporary build directory, private versions of `/proc`,\0A          `/dev`, `/dev/shm` and `/dev/pts` (on Linux), and the paths\0A          configured with the `sandbox-paths` option. This is useful to\0A          prevent undeclared dependencies on files in directories such as\0A          `/usr/bin`. In addition, on Linux, builds run in private PID,\0A          mount, network, IPC and UTS namespaces to isolate them from other\0A          processes in the system (except that fixed-output derivations do\0A          not run in private network namespace to ensure they can access the\0A          network).\0A\0A          Currently, sandboxing only work on Linux and macOS. The use of a\0A          sandbox requires that Nix is run as root (so you should use the\0A          \E2\80\9Cbuild users\E2\80\9D feature to perform the actual builds under different\0A          users than root).\0A\0A          If this option is set to `relaxed`, then fixed-output derivations\0A          and derivations that have the `__noChroot` attribute set to `true`\0A          do not run in sandboxes.\0A\0A          The default is `true` on Linux and `false` on all other platforms.\0A        \00", align 1
@.str.112 = private unnamed_addr constant [17 x i8] c"build-use-chroot\00", align 1
@.str.113 = private unnamed_addr constant [18 x i8] c"build-use-sandbox\00", align 1
@.str.114 = private unnamed_addr constant [14 x i8] c"sandbox-paths\00", align 1
@.str.115 = private unnamed_addr constant [805 x i8] c"\0A          A list of paths bind-mounted into Nix sandbox environments. You can\0A          use the syntax `target=source` to mount a path in a different\0A          location in the sandbox; for instance, `/bin=/nix-bin` will mount\0A          the path `/nix-bin` as `/bin` inside the sandbox. If *source* is\0A          followed by `?`, then it is not an error if *source* does not exist;\0A          for example, `/dev/nvidiactl?` specifies that `/dev/nvidiactl` will\0A          only be mounted in the sandbox if it exists in the host filesystem.\0A\0A          If the source is in the Nix store, then its closure will be added to\0A          the sandbox as well.\0A\0A          Depending on how Nix was built, the default value for this option\0A          may be empty or provide `/bin/sh` as a bind-mount of `bash`.\0A        \00", align 1
@.str.116 = private unnamed_addr constant [18 x i8] c"build-chroot-dirs\00", align 1
@.str.117 = private unnamed_addr constant [20 x i8] c"build-sandbox-paths\00", align 1
@.str.118 = private unnamed_addr constant [17 x i8] c"sandbox-fallback\00", align 1
@.str.119 = private unnamed_addr constant [64 x i8] c"Whether to disable sandboxing when the kernel doesn't allow it.\00", align 1
@.str.120 = private unnamed_addr constant [34 x i8] c"require-drop-supplementary-groups\00", align 1
@.str.121 = private unnamed_addr constant [838 x i8] c"\0A          Following the principle of least privilege,\0A          Nix will attempt to drop supplementary groups when building with sandboxing.\0A\0A          However this can fail under some circumstances.\0A          For example, if the user lacks the `CAP_SETGID` capability.\0A          Search `setgroups(2)` for `EPERM` to find more detailed information on this.\0A\0A          If you encounter such a failure, setting this option to `false` will let you ignore it and continue.\0A          But before doing so, you should consider the security implications carefully.\0A          Not dropping supplementary groups means the build sandbox will be less restricted than intended.\0A\0A          This option defaults to `true` when the user is root\0A          (since `root` usually has permissions to call setgroups)\0A          and `false` otherwise.\0A        \00", align 1
@.str.122 = private unnamed_addr constant [4 x i8] c"50%\00", align 1
@.str.123 = private unnamed_addr constant [21 x i8] c"sandbox-dev-shm-size\00", align 1
@.str.124 = private unnamed_addr constant [261 x i8] c"\0A          This option determines the maximum size of the `tmpfs` filesystem\0A          mounted on `/dev/shm` in Linux sandboxes. For the format, see the\0A          description of the `size` option of `tmpfs` in mount(8). The default\0A          is `50%`.\0A        \00", align 1
@.str.125 = private unnamed_addr constant [7 x i8] c"/build\00", align 1
@.str.126 = private unnamed_addr constant [18 x i8] c"sandbox-build-dir\00", align 1
@.str.127 = private unnamed_addr constant [40 x i8] c"The build directory inside the sandbox.\00", align 1
@.str.128 = private unnamed_addr constant [25 x i8] c"allowed-impure-host-deps\00", align 1
@.str.129 = private unnamed_addr constant [81 x i8] c"Which prefixes to allow derivations to ask for access to (primarily for Darwin).\00", align 1
@.str.130 = private unnamed_addr constant [14 x i8] c"run-diff-hook\00", align 1
@.str.131 = private unnamed_addr constant [244 x i8] c"\0A          If true, enable the execution of the `diff-hook` program.\0A\0A          When using the Nix daemon, `run-diff-hook` must be set in the\0A          `nix.conf` configuration file, and cannot be passed at the command\0A          line.\0A        \00", align 1
@.str.132 = private unnamed_addr constant [10 x i8] c"diff-hook\00", align 1
@.str.133 = private unnamed_addr constant [1150 x i8] c"\0A          Absolute path to an executable capable of diffing build\0A          results. The hook is executed if `run-diff-hook` is true, and the\0A          output of a build is known to not be the same. This program is not\0A          executed to determine if two results are the same.\0A\0A          The diff hook is executed by the same user and group who ran the\0A          build. However, the diff hook does not have write access to the\0A          store path just built.\0A\0A          The diff hook program receives three parameters:\0A\0A          1.  A path to the previous build's results\0A\0A          2.  A path to the current build's results\0A\0A          3.  The path to the build's derivation\0A\0A          4.  The path to the build's scratch directory. This directory will\0A              exist only if the build was run with `--keep-failed`.\0A\0A          The stderr and stdout output from the diff hook will not be\0A          displayed to the user. Instead, it will print to the nix-daemon's\0A          log.\0A\0A          When using the Nix daemon, `diff-hook` must be set in the `nix.conf`\0A          configuration file, and cannot be passed at the command line.\0A        \00", align 1
@.str.134 = private unnamed_addr constant [63 x i8] c"cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=\00", align 1
@.str.135 = private unnamed_addr constant [20 x i8] c"trusted-public-keys\00", align 1
@.str.136 = private unnamed_addr constant [537 x i8] c"\0A          A whitespace-separated list of public keys.\0A\0A          At least one of the following condition must be met\0A          for Nix to accept copying a store object from another\0A          Nix store (such as a [substituter](#conf-substituters)):\0A\0A          - the store object has been signed using a key in the trusted keys list\0A          - the [`require-sigs`](#conf-require-sigs) option has been set to `false`\0A          - the store object is [content-addressed](@docroot@/glossary.md#gloss-content-addressed-store-object)\0A        \00", align 1
@.str.137 = private unnamed_addr constant [25 x i8] c"binary-cache-public-keys\00", align 1
@.str.138 = private unnamed_addr constant [17 x i8] c"secret-key-files\00", align 1
@.str.139 = private unnamed_addr constant [369 x i8] c"\0A          A whitespace-separated list of files containing secret (private)\0A          keys. These are used to sign locally-built paths. They can be\0A          generated using `nix-store --generate-binary-cache-key`. The\0A          corresponding public key can be distributed to other users, who\0A          can add it to `trusted-public-keys` in their `nix.conf`.\0A        \00", align 1
@.str.140 = private unnamed_addr constant [12 x i8] c"tarball-ttl\00", align 1
@.str.141 = private unnamed_addr constant [613 x i8] c"\0A          The number of seconds a downloaded tarball is considered fresh. If\0A          the cached tarball is stale, Nix will check whether it is still up\0A          to date using the ETag header. Nix will download a new version if\0A          the ETag header is unsupported, or the cached ETag doesn't match.\0A\0A          Setting the TTL to `0` forces Nix to always check if the tarball is\0A          up to date.\0A\0A          Nix caches tarballs in `$XDG_CACHE_HOME/nix/tarballs`.\0A\0A          Files fetched via `NIX_PATH`, `fetchGit`, `fetchMercurial`,\0A          `fetchTarball`, and `fetchurl` respect this TTL.\0A        \00", align 1
@.str.142 = private unnamed_addr constant [13 x i8] c"require-sigs\00", align 1
@.str.143 = private unnamed_addr constant [636 x i8] c"\0A          If set to `true` (the default), any non-content-addressed path added\0A          or copied to the Nix store (e.g. when substituting from a binary\0A          cache) must have a signature by a trusted key. A trusted key is one\0A          listed in `trusted-public-keys`, or a public key counterpart to a\0A          private key stored in a file listed in `secret-key-files`.\0A\0A          Set to `false` to disable signature checking and trust all\0A          non-content-addressed paths unconditionally.\0A\0A          (Content-addressed paths are inherently trustworthy and thus\0A          unaffected by this configuration option.)\0A        \00", align 1
@.str.144 = private unnamed_addr constant [16 x i8] c"extra-platforms\00", align 1
@.str.145 = private unnamed_addr constant [1216 x i8] c"\0A          System types of executables that can be run on this machine.\0A\0A          Nix will only build a given [derivation](@docroot@/language/derivations.md) locally when its `system` attribute equals any of the values specified here or in the [`system` option](#conf-system).\0A\0A          Setting this can be useful to build derivations locally on compatible machines:\0A          - `i686-linux` executables can be run on `x86_64-linux` machines (set by default)\0A          - `x86_64-darwin` executables can be run on macOS `aarch64-darwin` with Rosetta 2 (set by default where applicable)\0A          - `armv6` and `armv5tel` executables can be run on `armv7`\0A          - some `aarch64` machines can also natively run 32-bit ARM code\0A          - `qemu-user` may be used to support non-native platforms (though this\0A          may be slow and buggy)\0A\0A          Build systems will usually detect the target platform to be the current physical system and therefore produce machine code incompatible with what may be intended in the derivation.\0A          You should design your derivation's `builder` accordingly and cross-check the results when using this option against natively-built versions of your derivation.\0A        \00", align 1
@.str.146 = private unnamed_addr constant [16 x i8] c"system-features\00", align 1
@.str.147 = private unnamed_addr constant [2141 x i8] c"\0A          A set of system \E2\80\9Cfeatures\E2\80\9D supported by this machine.\0A\0A          This complements the [`system`](#conf-system) and [`extra-platforms`](#conf-extra-platforms) configuration options and the corresponding [`system`](@docroot@/language/derivations.md#attr-system) attribute on derivations.\0A\0A          A derivation can require system features in the [`requiredSystemFeatures` attribute](@docroot@/language/advanced-attributes.md#adv-attr-requiredSystemFeatures), and the machine to build the derivation must have them.\0A\0A          System features are user-defined, but Nix sets the following defaults:\0A\0A          - `apple-virt`\0A\0A            Included on Darwin if virtualization is available.\0A\0A          - `kvm`\0A\0A            Included on Linux if `/dev/kvm` is accessible.\0A\0A          - `nixos-test`, `benchmark`, `big-parallel`\0A\0A            These historical pseudo-features are always enabled for backwards compatibility, as they are used in Nixpkgs to route Hydra builds to specific machines.\0A\0A          - `ca-derivations`\0A\0A            Included by default if the [`ca-derivations` experimental feature](@docroot@/contributing/experimental-features.md#xp-feature-ca-derivations) is enabled.\0A\0A            This system feature is implicitly required by derivations with the [`__contentAddressed` attribute](@docroot@/language/advanced-attributes.md#adv-attr-__contentAddressed).\0A\0A          - `recursive-nix`\0A\0A            Included by default if the [`recursive-nix` experimental feature](@docroot@/contributing/experimental-features.md#xp-feature-recursive-nix) is enabled.\0A\0A          - `uid-range`\0A\0A            On Linux, Nix can run builds in a user namespace where they run as root (UID 0) and have 65,536 UIDs available.\0A            This is primarily useful for running containers such as `systemd-nspawn` inside a Nix build. For an example, see [`tests/systemd-nspawn/nix`][nspawn].\0A\0A            [nspawn]: https://github.com/NixOS/nix/blob/67bcb99700a0da1395fa063d7c6586740b304598/tests/systemd-nspawn.nix.\0A\0A            Included by default on Linux if the [`auto-allocate-uids`](#conf-auto-allocate-uids) setting is enabled.\0A        \00", align 1
@.str.148 = private unnamed_addr constant [25 x i8] c"https://cache.nixos.org/\00", align 1
@.str.149 = private unnamed_addr constant [13 x i8] c"substituters\00", align 1
@.str.150 = private unnamed_addr constant [986 x i8] c"\0A          A list of [URLs of Nix stores](@docroot@/store/types/index.md#store-url-format) to be used as substituters, separated by whitespace.\0A          A substituter is an additional [store](@docroot@/glossary.md#gloss-store) from which Nix can obtain [store objects](@docroot@/glossary.md#gloss-store-object) instead of building them.\0A\0A          Substituters are tried based on their priority value, which each substituter can set independently.\0A          Lower value means higher priority.\0A          The default is `https://cache.nixos.org`, which has a priority of 40.\0A\0A          At least one of the following conditions must be met for Nix to use a substituter:\0A\0A          - The substituter is in the [`trusted-substituters`](#conf-trusted-substituters) list\0A          - The user calling Nix is in the [`trusted-users`](#conf-trusted-users) list\0A\0A          In addition, each store path should be trusted as described in [`trusted-public-keys`](#conf-trusted-public-keys)\0A        \00", align 1
@.str.151 = private unnamed_addr constant [14 x i8] c"binary-caches\00", align 1
@.str.152 = private unnamed_addr constant [21 x i8] c"trusted-substituters\00", align 1
@.str.153 = private unnamed_addr constant [472 x i8] c"\0A          A list of [Nix store URLs](@docroot@/store/types/index.md#store-url-format), separated by whitespace.\0A          These are not used by default, but users of the Nix daemon can enable them by specifying [`substituters`](#conf-substituters).\0A\0A          Unprivileged users (those set in only [`allowed-users`](#conf-allowed-users) but not [`trusted-users`](#conf-trusted-users)) can pass as `substituters` only those URLs listed in `trusted-substituters`.\0A        \00", align 1
@.str.154 = private unnamed_addr constant [22 x i8] c"trusted-binary-caches\00", align 1
@.str.155 = private unnamed_addr constant [27 x i8] c"narinfo-cache-negative-ttl\00", align 1
@.str.156 = private unnamed_addr constant [518 x i8] c"\0A          The TTL in seconds for negative lookups.\0A          If a store path is queried from a [substituter](#conf-substituters) but was not found, there will be a negative lookup cached in the local disk cache database for the specified duration.\0A\0A          Set to `0` to force updating the lookup cache.\0A\0A          To wipe the lookup cache completely:\0A\0A          ```shell-session\0A          $ rm $HOME/.cache/nix/binary-cache-v*.sqlite*\0A          # rm /root/.cache/nix/binary-cache-v*.sqlite*\0A          ```\0A        \00", align 1
@.str.157 = private unnamed_addr constant [27 x i8] c"narinfo-cache-positive-ttl\00", align 1
@.str.158 = private unnamed_addr constant [594 x i8] c"\0A          The TTL in seconds for positive lookups. If a store path is queried\0A          from a substituter, the result of the query will be cached in the\0A          local disk cache database including some of the NAR metadata. The\0A          default TTL is a month, setting a shorter TTL for positive lookups\0A          can be useful for binary caches that have frequent garbage\0A          collection, in which case having a more frequent cache invalidation\0A          would prevent trying to pull the path again and failing with a hash\0A          mismatch if the build isn't reproducible.\0A        \00", align 1
@.str.159 = private unnamed_addr constant [14 x i8] c"print-missing\00", align 1
@.str.160 = private unnamed_addr constant [60 x i8] c"Whether to print what paths need to be built or downloaded.\00", align 1
@.str.161 = private unnamed_addr constant [15 x i8] c"pre-build-hook\00", align 1
@.str.162 = private unnamed_addr constant [852 x i8] c"\0A          If set, the path to a program that can set extra derivation-specific\0A          settings for this system. This is used for settings that can't be\0A          captured by the derivation model itself and are too variable between\0A          different versions of the same system to be hard-coded into nix.\0A\0A          The hook is passed the derivation path and, if sandboxes are\0A          enabled, the sandbox directory. It can then modify the sandbox and\0A          send a series of commands to modify various settings to stdout. The\0A          currently recognized commands are:\0A\0A            - `extra-sandbox-paths`\\\0A              Pass a list of files and directories to be included in the\0A              sandbox for this build. One entry per line, terminated by an\0A              empty line. Entries have the same format as `sandbox-paths`.\0A        \00", align 1
@.str.163 = private unnamed_addr constant [16 x i8] c"post-build-hook\00", align 1
@.str.164 = private unnamed_addr constant [1629 x i8] c"\0A          Optional. The path to a program to execute after each build.\0A\0A          This option is only settable in the global `nix.conf`, or on the\0A          command line by trusted users.\0A\0A          When using the nix-daemon, the daemon executes the hook as `root`.\0A          If the nix-daemon is not involved, the hook runs as the user\0A          executing the nix-build.\0A\0A            - The hook executes after an evaluation-time build.\0A\0A            - The hook does not execute on substituted paths.\0A\0A            - The hook's output always goes to the user's terminal.\0A\0A            - If the hook fails, the build succeeds but no further builds\0A              execute.\0A\0A            - The hook executes synchronously, and blocks other builds from\0A              progressing while it runs.\0A\0A          The program executes with no arguments. The program's environment\0A          contains the following environment variables:\0A\0A            - `DRV_PATH`\0A              The derivation for the built paths.\0A\0A              Example:\0A              `/nix/store/5nihn1a7pa8b25l9zafqaqibznlvvp3f-bash-4.4-p23.drv`\0A\0A            - `OUT_PATHS`\0A              Output paths of the built derivation, separated by a space\0A              character.\0A\0A              Example:\0A              `/nix/store/zf5lbh336mnzf1nlswdn11g4n2m8zh3g-bash-4.4-p23-dev\0A              /nix/store/rjxwxwv1fpn9wa2x5ssk5phzwlcv4mna-bash-4.4-p23-doc\0A              /nix/store/6bqvbzjkcp9695dq0dpl5y43nvy37pq1-bash-4.4-p23-info\0A              /nix/store/r7fng3kk3vlpdlh2idnrbn37vh4imlj2-bash-4.4-p23-man\0A              /nix/store/xfghy8ixrhz3kyy6p724iv3cxji088dx-bash-4.4-p23`.\0A        \00", align 1
@.str.165 = private unnamed_addr constant [15 x i8] c"download-speed\00", align 1
@.str.166 = private unnamed_addr constant [123 x i8] c"\0A          Specify the maximum transfer rate in kilobytes per second you want\0A          Nix to use for downloads.\0A        \00", align 1
@.str.167 = private unnamed_addr constant [6 x i8] c"%s/%s\00", align 1
@.str.168 = private unnamed_addr constant [6 x i8] c"netrc\00", align 1
@.str.169 = private unnamed_addr constant [11 x i8] c"netrc-file\00", align 1
@.str.170 = private unnamed_addr constant [769 x i8] c"\0A          If set to an absolute path to a `netrc` file, Nix will use the HTTP\0A          authentication credentials in this file when trying to download from\0A          a remote host through HTTP or HTTPS. Defaults to\0A          `$NIX_CONF_DIR/netrc`.\0A\0A          The `netrc` file consists of a list of accounts in the following\0A          format:\0A\0A              machine my-machine\0A              login my-username\0A              password my-password\0A\0A          For the exact syntax, see [the `curl`\0A          documentation](https://ec.haxx.se/usingcurl-netrc.html).\0A\0A          > **Note**\0A          >\0A          > This must be an absolute path, and `~` is not resolved. For\0A          > example, `~/.netrc` won't resolve to your home directory's\0A          > `.netrc`.\0A        \00", align 1
@.str.171 = private unnamed_addr constant [14 x i8] c"ssl-cert-file\00", align 1
@.str.172 = private unnamed_addr constant [498 x i8] c"\0A          The path of a file containing CA certificates used to\0A          authenticate `https://` downloads. Nix by default will use\0A          the first of the following files that exists:\0A\0A          1. `/etc/ssl/certs/ca-certificates.crt`\0A          2. `/nix/var/nix/profiles/default/etc/ssl/certs/ca-bundle.crt`\0A\0A          The path can be overridden by the following environment\0A          variables, in order of precedence:\0A\0A          1. `NIX_SSL_CERT_FILE`\0A          2. `SSL_CERT_FILE`\0A        \00", align 1
@.str.173 = private unnamed_addr constant [16 x i8] c"filter-syscalls\00", align 1
@.str.174 = private unnamed_addr constant [244 x i8] c"\0A          Whether to prevent certain dangerous system calls, such as\0A          creation of setuid/setgid files or adding ACLs or extended\0A          attributes. Only disable this if you're aware of the\0A          security implications.\0A        \00", align 1
@.str.175 = private unnamed_addr constant [21 x i8] c"allow-new-privileges\00", align 1
@.str.176 = private unnamed_addr constant [670 x i8] c"\0A          (Linux-specific.) By default, builders on Linux cannot acquire new\0A          privileges by calling setuid/setgid programs or programs that have\0A          file capabilities. For example, programs such as `sudo` or `ping`\0A          will fail. (Note that in sandbox builds, no such programs are\0A          available unless you bind-mount them into the sandbox via the\0A          `sandbox-paths` option.) You can allow the use of such programs by\0A          enabling this option. This is impure and usually undesirable, but\0A          may be useful in certain scenarios (e.g. to spin up containers or\0A          set up userspace network interfaces in tests).\0A        \00", align 1
@.str.177 = private unnamed_addr constant [17 x i8] c"security.selinux\00", align 1
@.str.178 = private unnamed_addr constant [16 x i8] c"system.nfs4_acl\00", align 1
@.str.179 = private unnamed_addr constant [13 x i8] c"security.csm\00", align 1
@.str.180 = private unnamed_addr constant [13 x i8] c"ignored-acls\00", align 1
@.str.181 = private unnamed_addr constant [306 x i8] c"\0A          A list of ACLs that should be ignored, normally Nix attempts to\0A          remove all ACLs from files and directories in the Nix store, but\0A          some ACLs like `security.selinux` or `system.nfs4_acl` can't be\0A          removed even by root. Therefore it's best to just ignore them.\0A        \00", align 1
@.str.182 = private unnamed_addr constant [15 x i8] c"hashed-mirrors\00", align 1
@.str.183 = private unnamed_addr constant [911 x i8] c"\0A          A list of web servers used by `builtins.fetchurl` to obtain files by\0A          hash. Given a hash algorithm *ha* and a base-16 hash *h*, Nix will try to\0A          download the file from *hashed-mirror*/*ha*/*h*. This allows files to\0A          be downloaded even if they have disappeared from their original URI.\0A          For example, given an example mirror `http://tarballs.nixos.org/`,\0A          when building the derivation\0A\0A          ```nix\0A          builtins.fetchurl {\0A            url = \22https://example.org/foo-1.2.3.tar.xz\22;\0A            sha256 = \222c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae\22;\0A          }\0A          ```\0A\0A          Nix will attempt to download this file from\0A          `http://tarballs.nixos.org/sha256/2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae`\0A          first. If it is not available there, if will try the original URI.\0A        \00", align 1
@.str.184 = private unnamed_addr constant [9 x i8] c"min-free\00", align 1
@.str.185 = private unnamed_addr constant [278 x i8] c"\0A          When free disk space in `/nix/store` drops below `min-free` during a\0A          build, Nix performs a garbage-collection until `max-free` bytes are\0A          available or there is no more garbage. A value of `0` (the default)\0A          disables this feature.\0A        \00", align 1
@.str.186 = private unnamed_addr constant [9 x i8] c"max-free\00", align 1
@.str.187 = private unnamed_addr constant [208 x i8] c"\0A          When a garbage collection is triggered by the `min-free` option, it\0A          stops as soon as `max-free` bytes are available. The default is\0A          infinity (i.e. delete all garbage).\0A        \00", align 1
@.str.188 = private unnamed_addr constant [24 x i8] c"min-free-check-interval\00", align 1
@.str.189 = private unnamed_addr constant [52 x i8] c"Number of seconds between checking free disk space.\00", align 1
@.str.190 = private unnamed_addr constant [13 x i8] c"plugin-files\00", align 1
@.str.191 = private unnamed_addr constant [1238 x i8] c"\0A          A list of plugin files to be loaded by Nix. Each of these files will\0A          be dlopened by Nix, allowing them to affect execution through static\0A          initialization. In particular, these plugins may construct static\0A          instances of RegisterPrimOp to add new primops or constants to the\0A          expression language, RegisterStoreImplementation to add new store\0A          implementations, RegisterCommand to add new subcommands to the `nix`\0A          command, and RegisterSetting to add new nix config settings. See the\0A          constructors for those types for more details.\0A\0A          Warning! These APIs are inherently unstable and may change from\0A          release to release.\0A\0A          Since these files are loaded into the same address space as Nix\0A          itself, they must be DSOs compatible with the instance of Nix\0A          running at the time (i.e. compiled against the same headers, not\0A          linked to any incompatible libraries). They should not be linked to\0A          any Nix libs directly, as those will be available already at load\0A          time.\0A\0A          If an entry in the list is a directory, all files in the directory\0A          are loaded as plugins (non-recursively).\0A        \00", align 1
@.str.192 = private unnamed_addr constant [16 x i8] c"nar-buffer-size\00", align 1
@.str.193 = private unnamed_addr constant [51 x i8] c"Maximum size of NARs before spilling them to disk.\00", align 1
@.str.194 = private unnamed_addr constant [22 x i8] c"allow-symlinked-store\00", align 1
@.str.195 = private unnamed_addr constant [540 x i8] c"\0A          If set to `true`, Nix will stop complaining if the store directory\0A          (typically /nix/store) contains symlink components.\0A\0A          This risks making some builds \22impure\22 because builders sometimes\0A          \22canonicalise\22 paths by resolving all symlink components. Problems\0A          occur if those builds are then deployed to machines where /nix/store\0A          resolves to a different location from that of the build machine. You\0A          can enable this setting if you are sure you're not going to do that.\0A        \00", align 1
@.str.196 = private unnamed_addr constant [25 x i8] c"use-xdg-base-directories\00", align 1
@.str.197 = private unnamed_addr constant [1659 x i8] c"\0A          If set to `true`, Nix will conform to the [XDG Base Directory Specification] for files in `$HOME`.\0A          The environment variables used to implement this are documented in the [Environment Variables section](@docroot@/command-ref/env-common.md).\0A\0A          [XDG Base Directory Specification]: https://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html\0A\0A          > **Warning**\0A          > This changes the location of some well-known symlinks that Nix creates, which might break tools that rely on the old, non-XDG-conformant locations.\0A\0A          In particular, the following locations change:\0A\0A          | Old               | New                            |\0A          |-------------------|--------------------------------|\0A          | `~/.nix-profile`  | `$XDG_STATE_HOME/nix/profile`  |\0A          | `~/.nix-defexpr`  | `$XDG_STATE_HOME/nix/defexpr`  |\0A          | `~/.nix-channels` | `$XDG_STATE_HOME/nix/channels` |\0A\0A          If you already have Nix installed and are using [profiles](@docroot@/package-management/profiles.md) or [channels](@docroot@/command-ref/nix-channel.md), you should migrate manually when you enable this option.\0A          If `$XDG_STATE_HOME` is not set, use `$HOME/.local/state/nix` instead of `$XDG_STATE_HOME/nix`.\0A          This can be achieved with the following shell commands:\0A\0A          ```sh\0A          nix_state_home=${XDG_STATE_HOME-$HOME/.local/state}/nix\0A          mkdir -p $nix_state_home\0A          mv $HOME/.nix-profile $nix_state_home/profile\0A          mv $HOME/.nix-defexpr $nix_state_home/defexpr\0A          mv $HOME/.nix-channels $nix_state_home/channels\0A          ```\0A        \00", align 1
@.str.198 = private unnamed_addr constant [11 x i8] c"impure-env\00", align 1
@.str.199 = private unnamed_addr constant [657 x i8] c"\0A          A list of items, each in the format of:\0A\0A          - `name=value`: Set environment variable `name` to `value`.\0A\0A          If the user is trusted (see `trusted-users` option), when building\0A          a fixed-output derivation, environment variables set in this option\0A          will be passed to the builder if they are listed in [`impureEnvVars`](@docroot@/language/advanced-attributes.md##adv-attr-impureEnvVars).\0A\0A          This option is useful for, e.g., setting `https_proxy` for\0A          fixed-output derivations and in a multi-user Nix installation, or\0A          setting private access tokens when fetching a private repository.\0A        \00", align 1
@.str.200 = private unnamed_addr constant [97 x i8] c"https://github.com/NixOS/nixpkgs/raw/master/nixos/modules/installer/tools/nix-fallback-paths.nix\00", align 1
