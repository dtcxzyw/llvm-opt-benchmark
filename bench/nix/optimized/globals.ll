@.str.39 = private unnamed_addr constant [244 x i8] c"\0A          This option defines the maximum number of substitution jobs that Nix\0A          will try to run in parallel. The default is `16`. The minimum value\0A          one can choose is `1` and lower values will be interpreted as `1`.\0A        \00", align 1
@.str.40 = private unnamed_addr constant [22 x i8] c"substitution-max-jobs\00", align 1
