              $__var_name = RANDOM || \\\0A              $__var_name = SHLVL || \\\0A              $__var_name = SECONDS || \\\0A              $__var_name = EPOCHREALTIME || \\\0A              $__var_name = EPOCHSECONDS \\\0A            ]]; then continue; fi\0A\0A        if [[ -z $__first ]]; then printf ',\\n'; else __first=; fi\0A\0A        printf \22    \22\0A        __escapeString \22$__var_name\22\0A        printf ': {'\0A\0A        # FIXME: handle -i, -r, -n.\0A        if [[ $type == -x ]]; then\0A            printf '\22type\22: \22exported\22, \22value\22: '\0A            __escapeString \22${!__var_name}\22\0A        elif [[ $type == -- ]]; then\0A            printf '\22type\22: \22var\22, \22value\22: '\0A            __escapeString \22${!__var_name}\22\0A        elif [[ $type == -a ]]; then\0A            printf '\22type\22: \22array\22, \22value\22: ['\0A            local __first2=1\0A            __var_name=\22$__var_name[@]\22\0A            for __i in \22${!__var_name}\22; do\0A                if [[ -z $__first2 ]]; then printf ', '; else __first2=; fi\0A                __escapeString \22$__i\22\0A                printf ' '\0A            done\0A            printf ']'\0A        elif [[ $type == -A ]]; then\0A            printf '\22type\22: \22associative\22, \22value\22: {\\n'\0A            local __first2=1\0A            declare -n __var_name2=\22$__var_name\22\0A            for __i in \22${!__var_name2[@]}\22; do\0A                if [[ -z $__first2 ]]; then printf ',\\n'; else __first2=; fi\0A                printf \22      \22\0A                __escapeString \22$__i\22\0A                printf \22: \22\0A                __escapeString \22${__var_name2[$__i]}\22\0A            done\0A            printf '\\n    }'\0A        else\0A            printf '\22type\22: \22unknown\22'\0A        fi\0A\0A        printf \22}\22\0A    done < <(printf \22%s\\n\22 \22$__vars\22)\0A    printf '\\n  }'\0A\0A    if [ -e \22$NIX_ATTRS_SH_FILE\22 ]; then\0A        printf ',\\