@.str.75 = private unnamed_addr constant [18 x i8] c"build-users-group\00", align 1
@.str.76 = private unnamed_addr constant [1882 x i8] c"\0A          This options specifies the Unix group containing the Nix build user\0A          accounts. In multi-user Nix installations, builds should not be\0A          performed by the Nix account since that would allow users to\0A          arbitrarily modify the Nix store and database by supplying specially\0A          crafted builders; and they cannot be performed by the calling user\0A          since that would allow him/her to influence the build result.\0A\0A          Therefore, if this option is non-empty and specifies a valid group,\0A          builds will be performed under the user accounts that are a member\0A          of the group specified here (as listed in `/etc/group`). Those user\0A          accounts should not be used for any other purpose\\!\0A\0A          Nix will never run two builds under the same user account at the\0A          same time. This is to prevent an obvious security hole: a malicious\0A          user writing a Nix expression that modifies the build result of a\0A          legitimate Nix expression being built by another user. Therefore it\0A          is good to have as many Nix build user accounts as you can spare.\0A          (Remember: uids are cheap.)\0A\0A          The build users should have permission to create files in the Nix\0A          store, but not delete them. Therefore, `/nix/store` should be owned\0A          by the Nix account, its group should be the group specified here,\0A          and its mode should be `1775`.\0A\0A          If the build users group is empty, builds will be performed under\0A          the uid of the Nix process (that is, the uid of the caller if\0A          `NIX_REMOTE` is empty, the uid under which the Nix daemon runs if\0A          `NIX_REMOTE` is `daemon`). Obviously, this should not be used\0A          with a nix daemon accessible to untrusted clients.\0A\0A          Defaults to `nixbld` when running as root, *empty* otherwise.\0A        \00", align 1
@.str.77 = private unnamed_addr constant [19 x i8] c"auto-allocate-uids\00", align 1
@.str.78 = private unnamed_addr constant [224 x i8] c"\0A          Whether to select UIDs for builds automatically, instead of using the\0A          users in `build-users-group`.\0A\0A          UIDs are allocated starting at 872415232 (0x34000000) on Linux and 56930 on macOS.\0A        \00", align 1
@.str.79 = private unnamed_addr constant [9 x i8] c"start-id\00", align 1
@.str.80 = private unnamed_addr constant [56 x i8] c"The first UID and GID to use for dynamic ID allocation.\00", align 1
@.str.81 = private unnamed_addr constant [9 x i8] c"id-count\00", align 1
@.str.82 = private unnamed_addr constant [58 x i8] c"The number of UIDs/GIDs to use for dynamic ID allocation.\00", align 1
@.str.83 = private unnamed_addr constant [12 x i8] c"use-cgroups\00", align 1
@.str.84 = private unnamed_addr constant [234 x i8] c"\0A          Whether to execute builds inside cgroups.\0A          This is only supported on Linux.\0A\0A          Cgroups are required and enabled automatically for derivations\0A          that require the `uid-range` system feature.\0A        \00", align 1
