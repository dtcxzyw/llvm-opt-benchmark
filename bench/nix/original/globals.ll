@.str.70 = private unnamed_addr constant [61 x i8] c"Whether to call `sync()` before registering a path as valid.\00", align 1
@.str.71 = private unnamed_addr constant [11 x i8] c"substitute\00", align 1
@.str.72 = private unnamed_addr constant [173 x i8] c"\0A          If set to `true` (default), Nix will use binary substitutes if\0A          available. This option can be disabled to force building from\0A          source.\0A        \00", align 1
@.str.73 = private unnamed_addr constant [22 x i8] c"build-use-substitutes\00", align 1
