@.str.35 = private unnamed_addr constant [9 x i8] c"max-jobs\00", align 1
@.str.36 = private unnamed_addr constant [871 x i8] c"\0A          Maximum number of jobs that Nix will try to build locally in parallel.\0A\0A          The special value `auto` causes Nix to use the number of CPUs in your system.\0A          Use `0` to disable local builds and directly use the remote machines specified in [`builders`](#conf-builders).\0A          This will not affect derivations that have [`preferLocalBuild = true`](@docroot@/language/advanced-attributes.md#adv-attr-preferLocalBuild), which are always built locally.\0A\0A          > **Note**\0A          >\0A          > The number of CPU cores to use for each build job is independently determined by the [`cores`](#conf-cores) setting.\0A\0A          <!-- TODO(@fricklerhandwerk): would be good to have those shorthands for common options as part of the specification -->\0A          The setting can be overridden using the `--max-jobs` (`-j`) command line switch.\0A        \00", align 1
@.str.37 = private unnamed_addr constant [15 x i8] c"build-max-jobs\00", align 1
@.str.38 = private unnamed_addr constant [22 x i8] c"max-substitution-jobs\00", align 1
@.str.39 = private unnamed_addr constant [244 x i8] c"\0A          This option defines the maximum number of substitution jobs that Nix\0A          will try to run in parallel. The default is `16`. The minimum value\0A          one can choose is `1` and lower values will be interpreted as `1`.\0A        \00", align 1
@.str.40 = private unnamed_addr constant [22 x i8] c"substitution-max-jobs\00", align 1
@.str.41 = private unnamed_addr constant [6 x i8] c"cores\00", align 1
@.str.42 = private unnamed_addr constant [1136 x i8] c"\0A          Sets the value of the `NIX_BUILD_CORES` environment variable in the [invocation of the `builder` executable](@docroot@/language/derivations.md#builder-execution) of a derivation.\0A          The `builder` executable can use this variable to control its own maximum amount of parallelism.\0A\0A          <!--\0A          FIXME(@fricklerhandwerk): I don't think this should even be mentioned here.\0A          A very generic example using `derivation` and `xargs` may be more appropriate to explain the mechanism.\0A          Using `mkDerivation` as an example requires being aware of that there are multiple independent layers that are completely opaque here.\0A          -->\0A          For instance, in Nixpkgs, if the attribute `enableParallelBuilding` for the `mkDerivation` build helper is set to `true`, it will pass the `-j${NIX_BUILD_CORES}` flag to GNU Make.\0A\0A          The value `0` means that the `builder` should use all available CPU cores in the system.\0A\0A          > **Note**\0A          >\0A          > The number of parallel local Nix build jobs is independently controlled with the [`max-jobs`](#conf-max-jobs) setting.\0A        \00", align 1
@.str.43 = private unnamed_addr constant [12 x i8] c"build-cores\00", align 1
@.str.44 = private unnamed_addr constant [13 x i8] c"x86_64-linux\00", align 1
@.str.45 = private unnamed_addr constant [7 x i8] c"system\00", align 1
@.str.46 = private unnamed_addr constant [1151 x i8] c"\0A          The system type of the current Nix installation.\0A          Nix will only build a given [derivation](@docroot@/language/derivations.md) locally when its `system` attribute equals any of the values specified here or in [`extra-platforms`](#conf-extra-platforms).\0A\0A          The default value is set when Nix itself is compiled for the system it will run on.\0A          The following system types are widely used, as Nix is actively supported on these platforms:\0A\0A          - `x86_64-linux`\0A          - `x86_64-darwin`\0A          - `i686-linux`\0A          - `aarch64-linux`\0A          - `aarch64-darwin`\0A          - `armv6l-linux`\0A          - `armv7l-linux`\0A\0A          In general, you do not have to modify this setting.\0A          While you can force Nix to run a Darwin-specific `builder` executable on a Linux machine, the result would obviously be wrong.\0A\0A          This value is available in the Nix language as\0A          [`builtins.currentSystem`](@docroot@/language/builtin-constants.md#builtins-currentSystem)\0A          if the\0A          [`eval-system`](#conf-eval-system)\0A          configuration option is set as the empty string.\0A        \00", align 1
@.str.47 = private unnamed_addr constant [16 x i8] c"max-silent-time\00", align 1
@.str.48 = private unnamed_addr constant [551 x i8] c"\0A          This option defines the maximum number of seconds that a builder can\0A          go without producing any data on standard output or standard error.\0A          This is useful (for instance in an automated build system) to catch\0A          builds that are stuck in an infinite loop, or to catch remote builds\0A          that are hanging due to network problems. It can be overridden using\0A          the `--max-silent-time` command line switch.\0A\0A          The value `0` means that there is no timeout. This is also the\0A          default.\0A        \00", align 1
@.str.49 = private unnamed_addr constant [22 x i8] c"build-max-silent-time\00", align 1
@.str.50 = private unnamed_addr constant [8 x i8] c"timeout\00", align 1
@.str.51 = private unnamed_addr constant [462 x i8] c"\0A          This option defines the maximum number of seconds that a builder can\0A          run. This is useful (for instance in an automated build system) to\0A          catch builds that are stuck in an infinite loop but keep writing to\0A          their standard output or standard error. It can be overridden using\0A          the `--timeout` command line switch.\0A\0A          The value `0` means that there is no timeout. This is also the\0A          default.\0A        \00", align 1
@.str.52 = private unnamed_addr constant [14 x i8] c"build-timeout\00", align 1
@.str.53 = private unnamed_addr constant [11 x i8] c"build-hook\00", align 1
@.str.54 = private unnamed_addr constant [440 x i8] c"\0A          The path to the helper program that executes remote builds.\0A\0A          Nix communicates with the build hook over `stdio` using a custom protocol to request builds that cannot be performed directly by the Nix daemon.\0A          The default value is the internal Nix binary that implements remote building.\0A\0A          > **Important**\0A          >\0A          > Change this setting only if you really know what you\E2\80\99re doing.\0A        \00", align 1
@.str.55 = private unnamed_addr constant [2 x i8] c"@\00", align 1
@.str.56 = private unnamed_addr constant [10 x i8] c"/machines\00", align 1
@.str.57 = private unnamed_addr constant [9 x i8] c"builders\00", align 1
@.str.58 = private unnamed_addr constant [5139 x i8] c"\0A          A semicolon- or newline-separated list of build machines.\0A\0A          In addition to the [usual ways of setting configuration options](@docroot@/command-ref/conf-file.md), the value can be read from a file by prefixing its absolute path with `@`.\0A\0A          > **Example**\0A          >\0A          > This is the default setting:\0A          >\0A          > ```\0A          > builders = @/etc/nix/machines\0A          > ```\0A\0A          Each machine specification consists of the following elements, separated by spaces.\0A          Only the first element is required.\0A          To leave a field at its default, set it to `-`.\0A\0A          1. The URI of the remote store in the format `ssh://[username@]hostname`.\0A\0A             > **Example**\0A             >\0A             > `ssh://nix@mac`\0A\0A             For backward compatibility, `ssh://` may be omitted.\0A             The hostname may be an alias defined in `~/.ssh/config`.\0A\0A          2. A comma-separated list of [Nix system types](@docroot@/contributing/hacking.md#system-type).\0A             If omitted, this defaults to the local platform type.\0A\0A             > **Example**\0A             >\0A             > `aarch64-darwin`\0A\0A             It is possible for a machine to support multiple platform types.\0A\0A             > **Example**\0A             >\0A             > `i686-linux,x86_64-linux`\0A\0A          3. The SSH identity file to be used to log in to the remote machine.\0A             If omitted, SSH will use its regular identities.\0A\0A             > **Example**\0A             >\0A             > `/home/user/.ssh/id_mac`\0A\0A          4. The maximum number of builds that Nix will execute in parallel on the machine.\0A             Typically this should be equal to the number of CPU cores.\0A\0A          5. The \E2\80\9Cspeed factor\E2\80\9D, indicating the relative speed of the machine as a positive integer.\0A             If there are multiple machines of the right type, Nix will prefer the fastest, taking load into account.\0A\0A          6. A comma-separated list of supported [system features](#conf-system-features).\0A\0A             A machine will only be used to build a derivation if all the features in the derivation's [`requiredSystemFeatures`](@docroot@/language/advanced-attributes.html#adv-attr-requiredSystemFeatures) attribute are supported by that machine.\0A\0A          7. A comma-separated list of required [system features](#conf-system-features).\0A\0A             A machine will only be used to build a derivation if all of the machine\E2\80\99s required features appear in the derivation\E2\80\99s [`requiredSystemFeatures`](@docroot@/language/advanced-attributes.html#adv-attr-requiredSystemFeatures) attribute.\0A\0A          8. The (base64-encoded) public host key of the remote machine.\0A             If omitted, SSH will use its regular `known_hosts` file.\0A\0A             The value for this field can be obtained via `base64 -w0`.\0A\0A          > **Example**\0A          >\0A          > Multiple builders specified on the command line:\0A          >\0A          > ```console\0A          > --builders 'ssh://mac x86_64-darwin ; ssh://beastie x86_64-freebsd'\0A          > ```\0A\0A          > **Example**\0A          >\0A          > This specifies several machines that can perform `i686-linux` builds:\0A          >\0A          > ```\0A          > nix@scratchy.labs.cs.uu.nl i686-linux /home/nix/.ssh/id_scratchy 8 1 kvm\0A          > nix@itchy.labs.cs.uu.nl    i686-linux /home/nix/.ssh/id_scratchy 8 2\0A          > nix@poochie.labs.cs.uu.nl  i686-linux /home/nix/.ssh/id_scratchy 1 2 kvm benchmark\0A          > ```\0A          >\0A          > However, `poochie` will only build derivations that have the attribute\0A          >\0A          > ```nix\0A          > requiredSystemFeatures = [ \22benchmark\22 ];\0A          > ```\0A          >\0A          > or\0A          >\0A          > ```nix\0A          > requiredSystemFeatures = [ \22benchmark\22 \22kvm\22 ];\0A          > ```\0A          >\0A          > `itchy` cannot do builds that require `kvm`, but `scratchy` does support such builds.\0A          > For regular builds, `itchy` will be preferred over `scratchy` because it has a higher speed factor.\0A\0A          For Nix to use substituters, the calling user must be in the [`trusted-users`](#conf-trusted-users) list.\0A\0A          > **Note**\0A          >\0A          > A build machine must be accessible via SSH and have Nix installed.\0A          > `nix` must be available in `$PATH` for the user connecting over SSH.\0A\0A          > **Warning**\0A          >\0A          > If you are building via the Nix daemon (default), the Nix daemon user account on the local machine (that is, `root`) requires access to a user account on the remote machine (not necessarily `root`).\0A          >\0A          > If you can\E2\80\99t or don\E2\80\99t want to configure `root` to be able to access the remote machine, set [`store`](#conf-store) to any [local store](@docroot@/store/types/local-store.html), e.g. by passing `--store /tmp` to the command on the local machine.\0A\0A          To build only on remote machines and disable local builds, set [`max-jobs`](#conf-max-jobs) to 0.\0A\0A          If you want the remote machines to use substituters, set [`builders-use-substitutes`](#conf-builders-use-substituters) to `true`.\0A        \00", align 1
@.str.59 = private unnamed_addr constant [25 x i8] c"always-allow-substitutes\00", align 1
@.str.60 = private unnamed_addr constant [219 x i8] c"\0A          If set to `true`, Nix will ignore the [`allowSubstitutes`](@docroot@/language/advanced-attributes.md) attribute in derivations and always attempt to use [available substituters](#conf-substituters).\0A        \00", align 1
@.str.61 = private unnamed_addr constant [25 x i8] c"builders-use-substitutes\00", align 1
@.str.62 = private unnamed_addr constant [508 x i8] c"\0A          If set to `true`, Nix will instruct [remote build machines](#conf-builders) to use their own [`substituters`](#conf-substituters) if available.\0A\0A          It means that remote build hosts will fetch as many dependencies as possible from their own substituters (e.g, from `cache.nixos.org`) instead of waiting for the local machine to upload them all.\0A          This can drastically reduce build times if the network connection between the local machine and the remote build host is slow.\0A        \00", align 1
@.str.63 = private unnamed_addr constant [18 x i8] c"gc-reserved-space\00", align 1
@.str.64 = private unnamed_addr constant [57 x i8] c"Amount of reserved disk space for the garbage collector.\00", align 1
@.str.65 = private unnamed_addr constant [15 x i8] c"fsync-metadata\00", align 1
@.str.66 = private unnamed_addr constant [260 x i8] c"\0A          If set to `true`, changes to the Nix store metadata (in\0A          `/nix/var/nix/db`) are synchronously flushed to disk. This improves\0A          robustness in case of system crashes, but reduces performance. The\0A          default is `true`.\0A        \00", align 1
