module asm ".intel_syntax"
module asm ".p2align 4"
module asm ".hidden wasmtime_fiber_start_21_0_0"
module asm ".global wasmtime_fiber_start_21_0_0"
module asm ".type wasmtime_fiber_start_21_0_0,@function"
module asm "wasmtime_fiber_start_21_0_0:"
module asm "        // Use the `simple` directive on the startproc here which indicates that"
module asm "        // some default settings for the platform are omitted, since this"
module asm "        // function is so nonstandard"
module asm "        .cfi_startproc simple"
module asm "        .cfi_def_cfa_offset 0"
module asm "        // This is where things get special, we're specifying a custom dwarf"
module asm "        // expression for how to calculate the CFA. The goal here is that we"
module asm "        // need to load the parent's stack pointer just before the call it made"
module asm "        // into `wasmtime_fiber_switch`. Note that the CFA value changes over"
module asm "        // time as well because a fiber may be resumed multiple times from"
module asm "        // different points on the original stack. This means that our custom"
module asm "        // CFA directive involves `DW_OP_deref`, which loads data from memory."
module asm "        //"
module asm "        // The expression we're encoding here is that the CFA, the stack pointer"
module asm "        // of whatever called into `wasmtime_fiber_start`, is:"
module asm "        //"
module asm "        //        *$rsp + 0x38"
module asm "        //"
module asm "        // $rsp is the stack pointer of `wasmtime_fiber_start` at the time the"
module asm "        // next instruction after the `.cfi_escape` is executed. Our $rsp at the"
module asm "        // start of this function is 16 bytes below the top of the stack (0xAff0"
module asm "        // in the diagram in unix.rs). The $rsp to resume at is stored at that"
module asm "        // location, so we dereference the stack pointer to load it."
module asm "        //"
module asm "        // After dereferencing, though, we have the $rsp value for"
module asm "        // `wasmtime_fiber_switch` itself. That's a weird function which sort of"
module asm "        // and sort of doesn't exist on the stack.  We want to point to the"
module asm "        // caller of `wasmtime_fiber_switch`, so to do that we need to skip the"
module asm "        // stack space reserved by `wasmtime_fiber_switch`, which is the 6 saved"
module asm "        // registers plus the return address of the caller's `call` instruction."
module asm "        // Hence we offset another 0x38 bytes."
module asm "        .cfi_escape 0x0f, /* DW_CFA_def_cfa_expression */ 4,            /* the byte length of this expression */ 0x57,         /* DW_OP_reg7 (rsp) */ 0x06,         /* DW_OP_deref */ 0x23, 0x38    /* DW_OP_plus_uconst 0x38 */"
module asm "        // And now after we've indicated where our CFA is for our parent"
module asm "        // function, we can define that where all of the saved registers are"
module asm "        // located. This uses standard `.cfi` directives which indicate that"
module asm "        // these registers are all stored relative to the CFA. Note that this"
module asm "        // order is kept in sync with the above register spills in"
module asm "        // `wasmtime_fiber_switch`."
module asm "        .cfi_rel_offset rip, -8"
module asm "        .cfi_rel_offset rbp, -16"
module asm "        .cfi_rel_offset rbx, -24"
module asm "        .cfi_rel_offset r12, -32"
module asm "        .cfi_rel_offset r13, -40"
module asm "        .cfi_rel_offset r14, -48"
module asm "        .cfi_rel_offset r15, -56"
module asm "        // The body of this function is pretty similar. All our parameters are"
module asm "        // already loaded into registers by the switch function. The"
module asm "        // `wasmtime_fiber_init` routine arranged the various values to be"
module asm "        // materialized into the registers used here. Our job is to then move"
module asm "        // the values into the ABI-defined registers and call the entry-point."
module asm "        // Note that `call` is used here to leave this frame on the stack so we"
module asm "        // can use the dwarf info here for unwinding. The trailing `ud2` is just"
module asm "        // for safety."
module asm "        mov rdi, r12"
module asm "        mov rsi, rbp"
module asm "        call rbx"
module asm "        ud2"
module asm "        .cfi_endproc"
module asm "    .size wasmtime_fiber_start_21_0_0,.-wasmtime_fiber_start_21_0_0"
module asm ".att_syntax"
module asm ".intel_syntax"
module asm ".p2align 4"
module asm ".hidden wasmtime_fiber_init_21_0_0"
module asm ".global wasmtime_fiber_init_21_0_0"
module asm ".type wasmtime_fiber_init_21_0_0,@function"
module asm "wasmtime_fiber_init_21_0_0:"
module asm "        // Here we're going to set up a stack frame as expected by"
module asm "        // `wasmtime_fiber_switch`. The values we store here will get restored into"
module asm "        // registers by that function and the `wasmtime_fiber_start` function will"
module asm "        // take over and understands which values are in which registers."
module asm "        //"
module asm "        // The first 16 bytes of stack are reserved for metadata, so we start"
module asm "        // storing values beneath that."
module asm "        lea rax, wasmtime_fiber_start_21_0_0[rip]"
module asm "        mov -0x18[rdi], rax"
module asm "        mov -0x20[rdi], rdi   // loaded into rbp during switch"
module asm "        mov -0x28[rdi], rsi   // loaded into rbx during switch"
module asm "        mov -0x30[rdi], rdx   // loaded into r12 during switch"
module asm "        // And then we specify the stack pointer resumption should begin at. Our"
module asm "        // `wasmtime_fiber_switch` function consumes 6 registers plus a return"
module asm "        // pointer, and the top 16 bytes are reserved, so that's:"
module asm "        //"
module asm "        //\09(6 + 1) * 16 + 16 = 0x48"
module asm "        lea rax, -0x48[rdi]"
module asm "        mov -0x10[rdi], rax"
module asm "        ret"
module asm "    .size wasmtime_fiber_init_21_0_0,.-wasmtime_fiber_init_21_0_0"
module asm ".att_syntax"
module asm ".intel_syntax"
module asm ".p2align 4"
module asm ".hidden wasmtime_fiber_switch_21_0_0"
module asm ".global wasmtime_fiber_switch_21_0_0"
module asm ".type wasmtime_fiber_switch_21_0_0,@function"
module asm "wasmtime_fiber_switch_21_0_0:"
module asm "        // We're switching to arbitrary code somewhere else, so pessimistically"
module asm "        // assume that all callee-save register are clobbered. This means we need"
module asm "        // to save/restore all of them."
module asm "        //"
module asm "        // Note that this order for saving is important since we use CFI directives"
module asm "        // below to point to where all the saved registers are."
module asm "        push rbp"
module asm "        push rbx"
module asm "        push r12"
module asm "        push r13"
module asm "        push r14"
module asm "        push r15"
module asm "        // Load pointer that we're going to resume at and store where we're going"
module asm "        // to get resumed from. This is in accordance with the diagram at the top"
module asm "        // of unix.rs."
module asm "        mov rax, -0x10[rdi]"
module asm "        mov -0x10[rdi], rsp"
module asm "        // Swap stacks and restore all our callee-saved registers"
module asm "        mov rsp, rax"
module asm "        pop r15"
module asm "        pop r14"
module asm "        pop r13"
module asm "        pop r12"
module asm "        pop rbx"
module asm "        pop rbp"
module asm "        ret"
module asm "    .size wasmtime_fiber_switch_21_0_0,.-wasmtime_fiber_switch_21_0_0"
