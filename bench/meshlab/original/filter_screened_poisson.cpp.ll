@.str.125 = private unnamed_addr constant [25 x i8] c"Merge all visible layers\00", align 1
@.str.126 = private unnamed_addr constant [92 x i8] c"Enabling this flag means that all the visible layers will be used for providing the points.\00", align 1
@.str.127 = private unnamed_addr constant [21 x i8] c"Reconstruction Depth\00", align 1
@.str.128 = private unnamed_addr constant [381 x i8] c"This integer is the maximum depth of the tree that will be used for surface reconstruction. Running at depth d corresponds to solving on a voxel grid whose resolution is no larger than 2^d x 2^d x 2^d. Note that since the reconstructor adapts the octree to the sampling density, the specified reconstruction depth is only an upper bound. The default value for this parameter is 8.\00", align 1
@.str.129 = private unnamed_addr constant [22 x i8] c"Adaptive Octree Depth\00", align 1
@.str.130 = private unnamed_addr constant [203 x i8] c"This integer specifies the depth beyond depth the octree will be adapted. At coarser depths, the octree will be complete, containing all 2^d x 2^d x 2^d nodes. The default value for this parameter is 5.\00", align 1
@.str.131 = private unnamed_addr constant [26 x i8] c"Conjugate Gradients Depth\00", align 1
@.str.132 = private unnamed_addr constant [207 x i8] c"This integer is the depth up to which a conjugate-gradients solver will be used to solve the linear system. Beyond this depth Gauss-Seidel relaxation will be used. The default value for this parameter is 0.\00", align 1
@.str.133 = private unnamed_addr constant [13 x i8] c"Scale Factor\00", align 1
@.str.134 = private unnamed_addr constant [177 x i8] c"This floating point value specifies the ratio between the diameter of the cube used for reconstruction and the diameter of the samples' bounding cube. The default value is 1.1.\00", align 1
@.str.135 = private unnamed_addr constant [26 x i8] c"Minimum Number of Samples\00", align 1
@.str.136 = private unnamed_addr constant [404 x i8] c"This floating point value specifies the minimum number of sample points that should fall within an octree node as the octree construction is adapted to sampling density. For noise-free samples, small values in the range [1.0 - 5.0] can be used. For more noisy samples, larger values in the range [15.0 - 20.0] may be needed to provide a smoother, noise-reduced, reconstruction. The default value is 1.5.\00", align 1
@.str.137 = private unnamed_addr constant [21 x i8] c"Interpolation Weight\00", align 1
@.str.138 = private unnamed_addr constant [304 x i8] c"This floating point value specifies the importants that interpolation of the point samples is given in the formulation of the screened Poisson equation. The results of the original (unscreened) Poisson Reconstruction can be obtained by setting this value to 0. The default value for this parameter is 4.\00", align 1
@.str.139 = private unnamed_addr constant [25 x i8] c"Gauss-Seidel Relaxations\00", align 1
@.str.140 = private unnamed_addr constant [159 x i8] c"This integer value specifies the number of Gauss-Seidel relaxations to be performed at each level of the hierarchy. The default value for this parameter is 8.\00", align 1
@.str.141 = private unnamed_addr constant [16 x i8] c"Confidence Flag\00", align 1
@.str.142 = private unnamed_addr constant [257 x i8] c"Enabling this flag tells the reconstructor to use the quality as confidence information; this is done by scaling the unit normals with the quality values. When the flag is not enabled, all normals are normalized to have unit-length prior to reconstruction.\00", align 1
@.str.143 = private unnamed_addr constant [10 x i8] c"Pre-Clean\00", align 1
@.str.144 = private unnamed_addr constant [123 x i8] c"Enabling this flag force a cleaning pre-pass on the data removing all unreferenced vertices or vertices with null normals.\00", align 1
@.str.145 = private unnamed_addr constant [15 x i8] c"Number Threads\00", align 1
@.str.146 = private unnamed_addr constant [69 x i8] c"Maximum number of threads that the reconstruction algorithm can use.\00", align 1
