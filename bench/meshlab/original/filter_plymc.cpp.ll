@.str.16 = private unnamed_addr constant [502 x i8] c"The surface reconstrction algorithm that have been used for a long time inside the ISTI-Visual Computer Lab.It is mostly a variant of the Curless et al. e.g. a volumetric approach with some original weighting schemes,a different expansion rule, and another approach to hole filling through volume dilation/relaxations.<br>The filter is applied to <b>ALL</b> the visible layers. In practice, all the meshes/point clouds that are currently <i>visible</i> are used to build the volumetric distance field.\00", align 1
@.str.17 = private unnamed_addr constant [101 x i8] c"A simplification/cleaning algorithm that works ONLY on meshes generated by Marching Cubes algorithm.\00", align 1
@.str.18 = private unnamed_addr constant [15 x i8] c"Unknown Filter\00", align 1
@.str.19 = private unnamed_addr constant [8 x i8] c"voxSize\00", align 1
@.str.20 = private unnamed_addr constant [11 x i8] c"Voxel Side\00", align 1
@.str.21 = private unnamed_addr constant [10 x i8] c"VoxelSide\00", align 1
@.str.22 = private unnamed_addr constant [7 x i8] c"subdiv\00", align 1
@.str.23 = private unnamed_addr constant [17 x i8] c"SubVol Splitting\00", align 1
@.str.24 = private unnamed_addr constant [308 x i8] c"The level of recursive splitting of the subvolume reconstruction process. A value of '3' means that a 3x3x3 regular space subdivision is created and the reconstruction process generate 8 matching meshes. It is useful for reconsruction objects at a very high resolution. Default value (1) means no splitting.\00", align 1
@.str.25 = private unnamed_addr constant [9 x i8] c"geodesic\00", align 1
@.str.26 = private unnamed_addr constant [19 x i8] c"Geodesic Weighting\00", align 1
@.str.27 = private unnamed_addr constant [208 x i8] c"The influence of each range map is weighted with its geodesic distance from the borders. In this way when two (or more ) range maps overlaps their contribution blends smoothly hiding possible misalignments. \00", align 1
@.str.28 = private unnamed_addr constant [11 x i8] c"openResult\00", align 1
@.str.29 = private unnamed_addr constant [12 x i8] c"Show Result\00", align 1
@.str.30 = private unnamed_addr constant [67 x i8] c"if not checked the result is only saved into the current directory\00", align 1
@.str.31 = private unnamed_addr constant [10 x i8] c"smoothNum\00", align 1
@.str.32 = private unnamed_addr constant [22 x i8] c"Volume Laplacian iter\00", align 1
@.str.33 = private unnamed_addr constant [87 x i8] c"How many volume smoothing step are performed to clean out the eventually noisy borders\00", align 1
@.str.34 = private unnamed_addr constant [8 x i8] c"wideNum\00", align 1
@.str.35 = private unnamed_addr constant [9 x i8] c"Widening\00", align 1
@.str.36 = private unnamed_addr constant [83 x i8] c" How many voxel the field is expanded. Larger this value more holes will be filled\00", align 1
@.str.37 = private unnamed_addr constant [11 x i8] c"mergeColor\00", align 1
@.str.38 = private unnamed_addr constant [17 x i8] c"Vertex Splatting\00", align 1
@.str.39 = private unnamed_addr constant [257 x i8] c"This option use a different way to build up the volume, instead of using rasterization of the triangular face it splat the vertices into the grids. It works under the assumption that you have at least one sample for each voxel of your reconstructed volume.\00", align 1
@.str.40 = private unnamed_addr constant [15 x i8] c"simplification\00", align 1
@.str.41 = private unnamed_addr constant [26 x i8] c"Post Merge simplification\00", align 1
@.str.42 = private unnamed_addr constant [65 x i8] c"After the merging an automatic simplification step is performed.\00", align 1
@.str.43 = private unnamed_addr constant [13 x i8] c"normalSmooth\00", align 1
@.str.44 = private unnamed_addr constant [15 x i8] c"PreSmooth iter\00", align 1
