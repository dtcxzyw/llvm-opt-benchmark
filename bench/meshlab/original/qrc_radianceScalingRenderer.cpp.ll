@_ZL16qt_resource_data = internal constant [39440 x i8] c"\00\00\1CO/****************************************************************************\0A* Render Radiance Scaling                                                   *\0A* Meshlab's plugin                                                          *\0A*                                                                           *\0A* Copyright(C) 2010                                                         *\0A* Vergne Romain, Dumas Olivier                                              *\0A* INRIA - Institut Nationnal de Recherche en Informatique et Automatique    *\0A*                                                                           *\0A* All rights reserved.                                                      *\0A*                                                                           *\0A* This program is free software; you can redistribute it and/or modify      *\0A* it under the terms of the GNU General Public License as published by      *\0A* the Free Software Foundation; either version 2 of the License, or         *\0A* (at your option) any later version.                                       *\0A*                                                                           *\0A* This program is distributed in the hope that it will be useful,           *\0A* but WITHOUT ANY WARRANTY; without even the implied warranty of            *\0A* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the             *\0A* GNU General Public License (http://www.gnu.org/licenses/gpl.txt)          *\0A* for more details.                                                         *\0A*                                                                           *\0A****************************************************************************/\0A#version 120\0A#extension GL_EXT_gpu_shader4 : enable\0A\0Auniform sampler2D grad;  // (gx,gy,depth,1.0)\0Auniform sampler2D norm;  // (nx,ny,nz,depth)\0Auniform sampler2D colormap; // (r,g,b,1.0)\0Auniform float     sw;\0Auniform float     sh;\0Auniform float     enhancement;\0Auniform float     transition;\0Auniform bool      enabled;\0Auniform bool      invert;\0Auniform bool      doubleSide;\0Auniform int       display;\0Auniform bool      twoLS;\0Auniform sampler2D convexLS;\0Auniform sampler2D concavLS;\0A\0A// **** GRADIENT DATA ****\0A// |A|B|C|\0A// |D|X|E|\0A// |F|G|H|\0Avec4 X,A,B,C,D,E,F,G,H;\0A\0A// **** UTIL FUNCTIONS ****\0Avoid loadValues() {\0A  float xc = gl_TexCoord[0].s;\0A  float xm = gl_TexCoord[0].s-sw;\0A  float xp = gl_TexCoord[0].s+sw;\0A\0A  float yc = gl_TexCoord[0].t;\0A  float ym = gl_TexCoord[0].t-sh;\0A  float yp = gl_TexCoord[0].t+sh;\0A\0A  X = texture2D(grad,vec2(xc,yc));\0A  A = texture2D(grad,vec2(xm,yp));\0A  B = texture2D(grad,vec2(xc,yp));\0A  C = texture2D(grad,vec2(xp,yp));\0A  D = texture2D(grad,vec2(xm,yc));\0A  E = texture2D(grad,vec2(xp,yc));\0A  F = texture2D(grad,vec2(xm,ym));\0A  G = texture2D(grad,vec2(xc,ym));\0A  H = texture2D(grad,vec2(xp,ym));\0A}\0A\0Avec3 hsvToRgb(in float h,in float s,in float v) {\0A  vec3 color;\0A  int hi = int(floor(h/60.0))%6;\0A  float f = h/60.0 - floor(h/60.0);\0A  float p = v*(1.0-s);\0A  float q = v*(1.0-f*s);\0A  float t = v*(1.0-(1.0-f)*s);\0A\0A  if(hi==0) color = vec3(v,t,p);\0A  else if(hi==1) color = vec3(q,v,p);\0A  else if(hi==2) color = vec3(p,v,t);\0A  else if(hi==3) color = vec3(p,q,v);\0A  else if(hi==4) color = vec3(t,p,v);\0A  else color = vec3(v,p,q);\0A\0A  return color;\0A}\0A\0Afloat tanh(in float c, in float en) {\0A  float cmax = en*15.0;\0A  const float tanhmax = 3.11622;\0A\0A  float x = ((c*cmax*1.0)/tanhmax);\0A  float e = exp(-2.0*x);\0A  float t = clamp((1.0-e)/(1.0+e),-1.0,1.0);\0A\0A  return t;\0A}\0A\0A// **** WARPING FUNCTION ****\0Afloat warp(in float impfunc,in float beta) {\0A  const float alpha = 0.1;\0A  float expbeta = exp(-beta);\0A  return (alpha*expbeta+impfunc*(1.0-alpha-alpha*expbeta)) / (alpha+impfunc*(expbeta-alpha-alpha*expbeta));\0A}\0A\0A// **** WEIGHT FUNCTIONS ****\0Afloat silhouetteWeight(in float s) {\0A  const float ts = 0.07;\0A  const float t2 = 0.9+ts;\0A  const float t1 = t2-0.01;\0A\0A  return smoothstep(t1,t2,max(1.0-s,0.9));\0A}\0A\0Afloat weight() {\0A  return (silhouetteWeight(abs(A.z-X.z)) +\0A    silhouetteWeight(abs(B.z-X.z)) +\0A    silhouetteWeight(abs(C.z-X.z)) +\0A    silhouetteWeight(abs(D.z-X.z)) +\0A    silhouetteWeight(abs(E.z-X.z)) +\0A    silhouetteWeight(abs(F.z-X.z)) +\0A    silhouetteWeight(abs(G.z-X.z)) +\0A    silhouetteWeight(abs(H.z-X.z)))/8.0;\0A}\0A\0A// **** CURVATURE FUNCTIONS ****\0Avec3 hessian() {\0A  float xx = E.x-D.x;\0A  float xy = E.y-D.y;\0A  float yx = B.x-G.x;\0A  float yy = B.y-G.y;\0A\0A  return vec3(xx,yy,(xy+yx)/2.0);\0A}\0A\0Afloat curvature(in float w, in vec3 h, in float e) {\0A  float c = tanh(-(h.x+h.y)/2.0,e);\0A  return invert ? -c*max(w-0.5,0.0) : c*max(w-0.5,0.0);\0A}\0A\0A// **** DESCRIPTOR FUNCTIONS ****\0Avec4 coloredDescriptor(in float c, in float s) {\0A  vec3 rgb;\0A  vec3 convMax = vec3(0.1,0.1,0.8);\0A  vec3 convMin = vec3(0.2,0.2,0.6);\0A  vec3 concMax = vec3(0.8,0.1,0.1);\0A  vec3 concMin = vec3(0.6,0.2,0.2);\0A  vec3 plane   = vec3(0.7,0.7,0.2);\0A  float t = 0.02;\0A  float a;\0A\0A  if(c<-t) {\0A    a = (-c-t)/(1.0-t);\0A    rgb = mix(concMin,concMax,a);\0A  } else if(c>t) {\0A    a = (c-t)/(1.0-t);\0A    rgb = mix(convMin,convMax,a);\0A  } else if(c<0.0) {\0A    a = -c/t;\0A    rgb = mix(plane,concMin,a);\0A  } else {\0A    a = c/t;\0A    rgb = mix(plane,convMin,a);\0A  }\0A\0A  if(s<1.0)\0A    rgb = vec3(0.2);\0A\0A  return vec4(rgb,1.0);\0A}\0A\0Avec4 greyDescriptor(in float c, in float s) {\0A  return vec4( vec3( (c*0.5+0.5)-(1.0-s) ), 1.0);\0A}\0A\0A// **** LIT SPHERE FUNCTIONS ****\0Avec4 oneLitSphere(in vec3 n,in float c) {\0A  vec4 color = texture2D(convexLS,(n.xy*0.5)+vec2(0.5));\0A\0A  return enabled ? color*warp(length(color),c) : color;\0A}\0A\0Avec4 twoLitSphere(in vec3 n,in float w,in vec3 h,in float c) {\0A  const float eps = 0.2;\0A\0A  vec2 coord = (n.xy*0.5)+vec2(0.5);\0A  vec4 cconv = texture2D(convexLS,coord);\0A  vec4 cconc = texture2D(concavLS,coord);\0A  vec4 color = mix(cconc,cconv,smoothstep(0.5-eps,0.5+eps,curvature(w,h,transition)*0.5+0.5));\0A\0A  return vec4( (enabled ? color*warp(length(color),c) : color).xyz,1.0);\0A}\0A\0A// **** LIGHTING COMPUTATION ****\0Avoid main(void) {\0A  vec3 n = texture2D(norm,gl_TexCoord[0].st).xyz;\0A\0A  if(n==vec3(0.0)) {\0A//    gl_FragColor = vec4(1.0);\0A    discard;  // So we can see the original background, outside the mesh.\0A    return;\0A  }\0A\0A  // data\0A  loadValues();\0A  float w = weight();\0A  vec3  h = hessian();\0A  float c = curvature(w,h,enhancement);\0A  vec3  l = normalize(gl_LightSource[0].position.xyz);\0A  //vec4  m = vec4(0.5,0.1,0.7,1.0);\0A  //vec4  m = vec4(n,1.0);\0A  vec4  m = vec4(texture2D(colormap,gl_TexCoord[0].st).xyz,1.0);\0A  //vec4  m = gl_FrontMaterial.diffuse;\0A\0A  //Initialize the depth of the fragment with the just saved depth\0A  gl_FragDepth = texture2D(norm,gl_TexCoord[0].st).w;\0A\0A  if(display==0)\0A  {\0A    // lambertian lighting\0A    float cosineTerm = doubleSide ? max(dot(n,l),-dot(n,l)) : max(dot(n,l),0.0);\0A    float warpedTerm = enabled ? cosineTerm*warp(cosineTerm,c) : cosineTerm;\0A    gl_FragColor = vec4(m.rgb*warpedTerm,1.0);\0A  }\0A  else if(display==1)\0A  {\0A    // using lit spheres\0A    if(twoLS) {\0A      gl_FragColor = twoLitSphere(n,w,h,c);\0A    } else {\0A      gl_FragColor = oneLitSphere(n,c);\0A    }\0A  }\0A  else if(display==2)\0A  {\0A    // colored descriptor\0A    gl_FragColor = coloredDescriptor(c,w);\0A  }\0A  else if(display==3)\0A  {\0A    // grey descriptor\0A    gl_FragColor = greyDescriptor(c,w);\0A  }\0A}\0A\00\00\07\1D/****************************************************************************\0A* Render Radiance Scaling                                                   *\0A* Meshlab's plugin                                                          *\0A*                                                                           *\0A* Copyright(C) 2010                                                         *\0A* Vergne Romain, Dumas Olivier                                              *\0A* INRIA - Institut Nationnal de Recherche en Informatique et Automatique    *\0A*                                                                           *\0A* All rights reserved.                                                      *\0A*                                                                           *\0A* This program is free software; you can redistribute it and/or modify      *\0A* it under the terms of the GNU General Public License as published by      *\0A* the Free Software Foundation; either version 2 of the License, or         *\0A* (at your option) any later version.                                       *\0A*                                                                           *\0A* This program is distributed in the hope that it will be useful,           *\0A* but WITHOUT ANY WARRANTY; without even the implied warranty of            *\0A* MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the             *\0A* GNU General Public License (http://www.gnu.org/licenses/gpl.txt)          *\0A* for more details.                                                         *\0A*                                                                           *\0A****************************************************************************/\0A#version 120\0A\0Avoid main(void) {\0A  gl_TexCoord[0] = gl_MultiTexCoord0;\0A  gl_Position    = ftransform();\0A}\0A\00\00\08\BA/****************************************************************************\0A* Render Radiance Scaling                                                   *\0A* Meshlab's plugin                                                          *\0A*                                                           