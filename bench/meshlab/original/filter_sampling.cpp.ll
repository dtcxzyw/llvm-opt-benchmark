@.str.38 = private unnamed_addr constant [270 x i8] c"Create a new layer populated with a point sampling of the current mesh; at most one sample for each element of the mesh is created. Samples are taking in a uniform way, one for each element (vertex/edge/face); all the elements have the same probability of being chosen.\00", align 1
@.str.39 = private unnamed_addr constant [197 x i8] c"Create a new layer populated with a point sampling of the current mesh; samples are generated in a randomly uniform way, or with a distribution biased by the per-vertex quality values of the mesh.\00", align 1
@.str.40 = private unnamed_addr constant [246 x i8] c"Create a new layer populated with a point sampling of the current mesh; to generate multiple samples inside a triangle each triangle is subdivided according to various <i>stratified</i> strategies. Distribution is often biased by triangle shape.\00", align 1
@.str.41 = private unnamed_addr constant [154 x i8] c"Create a new layer populated with a subsampling of the vertices of the current mesh; the subsampling is driven by a simple one-per-gridded cell strategy.\00", align 1
@.str.42 = private unnamed_addr constant [186 x i8] c"Create a new layer populated with a simplified version of the current point cloud. The simplification is performed by subsampling the original point cloud using a Poisson Disk strategy.\00", align 1
@.str.43 = private unnamed_addr constant [337 x i8] c"Create a new layer populated with a point sampling of the current mesh;samples are generated according to a Poisson-disk distribution, using the algorithm described in:<br><b>'Efficient and Flexible Sampling with Blue Noise Properties of Triangular Meshes'</b><br> Massimiliano Corsini, Paolo Cignoni, Roberto Scopigno<br>IEEE TVCG 2012\00", align 1
@.str.44 = private unnamed_addr constant [200 x i8] c"Compute the Hausdorff Distance between two layers, sampling one of the two and finding for each sample the closest point over the other mesh. Distance is stored in vertex quality of the sampled mesh.\00", align 1
@.str.45 = private unnamed_addr constant [147 x i8] c"Compute the signed/unsigned (per vertex) distance between a mesh/pointcloud and a reference mesh/pointcloud. Distance is stored in vertex quality.\00", align 1
@.str.46 = private unnamed_addr constant [111 x i8] c"Create a new layer with a point sampling of the current mesh, a sample for each texel of the mesh is generated\00", align 1
@.str.47 = private unnamed_addr constant [429 x i8] c"Transfer the chosen per-vertex attributes from one layer to another. Useful to transfer attributes to different representations of a same object.<br>For each vertex of the target mesh the closest point (not vertex!) on the source mesh is computed, and the requested interpolated attributes from that source point are copied into the target vertex.<br>The algorithm assumes that the two meshes are reasonably similar and aligned.\00", align 1
@.str.48 = private unnamed_addr constant [311 x i8] c"Create a new mesh that is a resampled version of the current one.<br>The resampling is done by building a uniform volumetric representation where each voxel contains the signed distance from the original surface. The resampled surface is reconstructed using the <b>marching cube</b> algorithm over this volume.\00", align 1
@.str.49 = private unnamed_addr constant [222 x i8] c"Given a Mesh <b>M</b> and a Pointset <b>P</b>, The filter project each vertex of P over M and color M according to the geodesic distance from these projected points. Projection and coloring are done on a per vertex basis.\00", align 1
@.str.50 = private unnamed_addr constant [223 x i8] c"Given a Mesh <b>M</b> and a Pointset <b>P</b>, The filter project each vertex of P over M and color M according to the Euclidean distance from these projected points. Projection and coloring are done on a per vertex basis.\00", align 1
@.str.51 = private unnamed_addr constant [227 x i8] c"The bounding box is recursively partitioned in a octree style, center of bbox are considered, when the center is nearer to the surface than a given threshold it is projected on it. It works also for building offsetted samples.\00", align 1
@.str.52 = private unnamed_addr constant [19 x i8] c"unknown filter!!!!\00", align 1
@.str.53 = private unnamed_addr constant [10 x i8] c"SampleNum\00", align 1
@.str.54 = private unnamed_addr constant [18 x i8] c"Number of samples\00", align 1
@.str.55 = private unnamed_addr constant [147 x i8] c"The desired number of samples. It can be smaller or larger than the mesh size, and according to the chosen sampling strategy it will try to adapt.\00", align 1
@.str.56 = private unnamed_addr constant [9 x i8] c"Weighted\00", align 1
@.str.57 = private unnamed_addr constant [26 x i8] c"Quality Weighted Sampling\00", align 1
@.str.58 = private unnamed_addr constant [185 x i8] c"Use per vertex quality to drive the vertex sampling. The number of samples falling in each face is proportional to the face area multiplied by the average quality of the face vertices.\00", align 1
@.str.59 = private unnamed_addr constant [14 x i8] c"PerFaceNormal\00", align 1
@.str.60 = private unnamed_addr constant [16 x i8] c"Per-Face Normal\00", align 1
@.str.61 = private unnamed_addr constant [123 x i8] c"If true for each sample we take the normal of the sampled face, otherwise the normal interpolated from the vertex normals.\00", align 1
@.str.62 = private unnamed_addr constant [15 x i8] c"RadiusVariance\00", align 1
@.str.63 = private unnamed_addr constant [16 x i8] c"Radius Variance\00", align 1
@.str.64 = private unnamed_addr constant [144 x i8] c"The radius of the disk is allowed to vary between r/var and r*var. If this parameter is 1 the sampling is the same of the Poisson Disk Sampling\00", align 1
@.str.65 = private unnamed_addr constant [9 x i8] c"ExactNum\00", align 1
@.str.66 = private unnamed_addr constant [20 x i8] c"Exact Sample Number\00", align 1
@.str.67 = private unnamed_addr constant [332 x i8] c"If the required total number of samples is not a strict exact requirement we can exploit a different algorithmbased on the choice of the number of samples inside each triangle by a random Poisson-distributed number with mean equal to the expected number of samples times the area of the triangle over the surface of the whole mesh.\00", align 1
@.str.68 = private unnamed_addr constant [13 x i8] c"EdgeSampling\00", align 1
@.str.69 = private unnamed_addr constant [23 x i8] c"Sample CreaseEdge Only\00", align 1
@.str.70 = private unnamed_addr constant [136 x i8] c"Restrict the sampling process to the crease edges only. Useful to sample in a more accurate way the feature edges of a mechanical mesh.\00", align 1
@.str.71 = private unnamed_addr constant [9 x i8] c"Sampling\00", align 1
@.str.72 = private unnamed_addr constant [17 x i8] c"Similar Triangle\00", align 1
@.str.73 = private unnamed_addr constant [22 x i8] c"Dual Similar Triangle\00", align 1
@.str.74 = private unnamed_addr constant [17 x i8] c"Long Edge Subdiv\00", align 1
@.str.75 = private unnamed_addr constant [13 x i8] c"Sample Edges\00", align 1
@.str.76 = private unnamed_addr constant [21 x i8] c"Sample NonFaux Edges\00", align 1
@.str.77 = private unnamed_addr constant [19 x i8] c"Element to sample:\00", align 1
@.str.78 = private unnamed_addr constant [633 x i8] c"<b>Similar Triangle</b>: each triangle is subdivided into similar triangles and the internal vertices of these triangles are considered. This sampling leave space around edges and vertices for separate sampling of these entities.<br><b>Dual Similar Triangle</b>: each triangle is subdivided into similar triangles and the internal vertices of these triangles are considered.  <br><b>Long Edge Subdiv</b> each triangle is recursively subdivided along the longest edge. <br><b>Sample Edges</b> Only the edges of the mesh are uniformly sampled. <br><b>Sample NonFaux Edges</b> Only the non-faux edges of the mesh are uniformly sampled.\00", align 1
@.str.79 = private unnamed_addr constant [7 x i8] c"Random\00", align 1
@.str.80 = private unnamed_addr constant [16 x i8] c"Random Sampling\00", align 1
@.str.81 = private unnamed_addr constant [94 x i8] c"if true, for each (virtual) face we draw a random point, otherwise we pick the face midpoint.\00", align 1
@.str.82 = private unnamed_addr constant [10 x i8] c"Threshold\00", align 1
@.str.83 = private unnamed_addr constant [10 x i8] c"Cell Size\00", align 1
@.str.84 = private unnamed_addr constant [140 x i8] c"The size of the cell of the clustering grid. Smaller the cell finer the resulting mesh. For obtaining a very coarse mesh use larger values.\00", align 1
@.str.85 = private unnamed_addr constant [8 x i8] c"Average\00", align 1
@.str.86 = private unnamed_addr constant [18 x i8] c"Closest to center\00", align 1
@.str.87 = private unnamed_addr constant [25 x i8] c"Representative Strategy:\00", align 1
@.str.88 = private unnamed_addr constant [270 x i8] c"<b>Average</b>: for each cell we take the average of the sample falling into. The resulting point is a new point.<br><b>Closest to center</b>: for each cell we take the sample that is closest to the center of the cell. Chosen vertices are a subset of the original ones.\00", align 1
@.str.89 = private unnamed_addr constant [9 x i8] c"Selected\00", align 1
@.str.90 = private unnamed_addr constant [18 x i8] c"Only on Selection\00", align 1
@.str.91 = private unnamed_addr constant [80 x i8] c"If true only for the filter is applied only on the selected subset of the mesh.\00", align 1
