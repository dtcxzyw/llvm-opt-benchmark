@.str.64 = private unnamed_addr constant [85 x i8] c"Laplacian smooth of the face normals, without touching the position of the vertices.\00", align 1
@.str.65 = private unnamed_addr constant [343 x i8] c"Unsharp mask filtering of the normals per face, putting in more evidence normal variations.<br><b>A simple normal enhancement technique for interactive non-photorealistic renderings</b> by <i>Cignoni, Scopigno and Tarini</i>, Comput Graph, 29 (1) (2005)<br><a href='https://doi.org/10.1016/j.cag.2004.11.012'>doi:10.1016/j.cag.2004.11.012</a>\00", align 1
