@.str.48 = private unnamed_addr constant [175 x i8] c"Merge together per-wedge texture coords that are very close. Used to correct apparent texture seams that can arise from numerical approximations when saving in ascii formats.\00", align 1
@.str.49 = private unnamed_addr constant [154 x i8] c"Delete all the duplicate faces. Two faces are considered equal if they are composed by the same set of vertices, regardless of the order of the vertices.\00", align 1
@.str.50 = private unnamed_addr constant [240 x i8] c"Delete all the single folded faces. A face is considered folded if its normal is opposite to all the adjacent faces. It is removed by flipping it against the face f adjacent along the edge e such that the vertex opposite to e fall inside f\00", align 1
@.str.51 = private unnamed_addr constant [226 x i8] c"Remove non-manifold edges by removing faces (for each non Manifold edge it iteratively deletes the smallest area face until it becomes 2-Manifold) or by splitting vertices (each non manifold edges chain will become a border).\00", align 1
