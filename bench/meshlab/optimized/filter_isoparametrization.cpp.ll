@_ZL6bibRef = internal global %class.QString zeroinitializer, align 8
@.str.17 = private unnamed_addr constant [270 x i8] c"For more details see: <br><b>N. Pietroni, M. Tarini and P. Cignoni</b>, <br><a href=\22http://vcg.isti.cnr.it/Publications/2010/PTC10/\22>'Almost isometric mesh parameterization through abstract domains'</a> <br>IEEE Transaction of Visualization and Computer Graphics, 2010\00", align 1
@.str.18 = private unnamed_addr constant [458 x i8] c"The filter builds the abstract domain mesh representing the Isoparameterization of a watertight two-manifold triangular mesh. <br>This abstract mesh can be used to uniformly remesh the input mesh, or to build a atlased texture parametrization. Abstract Mesh can be also loaded and saved. <br>In short this filter build a very coarse almost regular triangulation such that original mesh can be reprojected from this abstract mesh with minimal distortion.<br>\00", align 1
@.str.19 = private unnamed_addr constant [108 x i8] c"Uniform Remeshing based on Isoparameterization, each triangle of the domain is recursively subdivided. <br>\00", align 1
@.str.20 = private unnamed_addr constant [179 x i8] c"The filter build a new mesh with a standard atlased per wedge texture. The atlas is simply done by exploiting the low distortion, coarse, regular, mesh of the abstract domain<br>\00", align 1
@.str.21 = private unnamed_addr constant [242 x i8] c"Transfer the Isoparametrization between two meshes, the two meshes must be reasonably similar and well aligned. It is useful to transfer back an isoparam onto the original mesh after having computed it on a dummy, clean watertight model.<br>\00", align 1
@.str.22 = private unnamed_addr constant [7 x i8] c"error!\00", align 1
@.str.23 = private unnamed_addr constant [25 x i8] c"targetAbstractMinFaceNum\00", align 1
@.str.24 = private unnamed_addr constant [13 x i8] c"AM  Min Size\00", align 1
@.str.25 = private unnamed_addr constant [527 x i8] c"This number and the following one indicate the range face number of the abstract mesh that is used for the parametrization process.<br>The algorithm will choose the best abstract mesh with the number of triangles within the specified interval.<br>If the mesh has a very simple structure this range can be very low and strict;for a roughly spherical object if you can specify a range of [8,8] faces you get a octahedral abstract mesh, e.g. a geometry image.<br>Large numbers (greater than 400) are usually not of practical use.\00", align 1
@.str.26 = private unnamed_addr constant [25 x i8] c"targetAbstractMaxFaceNum\00", align 1
@.str.27 = private unnamed_addr constant [12 x i8] c"AM Max Size\00", align 1
@.str.28 = private unnamed_addr constant [162 x i8] c"Please notice that a large interval requires huge amount of memory to be allocated, in order save the intermediate results. <br>An interval of 50 should be fine.\00", align 1
@.str.29 = private unnamed_addr constant [15 x i8] c"Best Heuristic\00", align 1
@.str.30 = private unnamed_addr constant [13 x i8] c"Area + Angle\00", align 1
@.str.31 = private unnamed_addr constant [11 x i8] c"Regularity\00", align 1
@.str.32 = private unnamed_addr constant [3 x i8] c"L2\00", align 1
@.str.33 = private unnamed_addr constant [13 x i8] c"stopCriteria\00", align 1
@.str.34 = private unnamed_addr constant [22 x i8] c"Optimization Criteria\00", align 1
@.str.35 = private unnamed_addr constant [329 x i8] c"Choose a metric to stop the parametrization within the interval<br>1: Best Heuristic : stop considering both isometry and number of faces of base domain<br>2: Area + Angle : stop at minimum area and angle distorsion<br>3: Regularity : stop at minimum number of irregular vertices<br>4: L2 : stop at minimum OneWay L2 Stretch Eff\00", align 1
@.str.36 = private unnamed_addr constant [17 x i8] c"convergenceSpeed\00", align 1
@.str.37 = private unnamed_addr constant [22 x i8] c"Convergence Precision\00", align 1
@.str.38 = private unnamed_addr constant [185 x i8] c"This parameter controls the convergence speed/precision of the optimization of the texture coordinates. Larger the number slower the processing and, eventually, slightly better results\00", align 1
@.str.39 = private unnamed_addr constant [11 x i8] c"DoubleStep\00", align 1
