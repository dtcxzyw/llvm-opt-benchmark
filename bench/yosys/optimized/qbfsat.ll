@.str.38 = private unnamed_addr constant [78 x i8] c"        \22(maximize)\22 or \22(minimize)\22 in the SMT-LIBv2, and generally make no\0A\00", align 1
@.str.39 = private unnamed_addr constant [39 x i8] c"        attempt to optimize anything.\0A\00", align 1
@.str.40 = private unnamed_addr constant [18 x i8] c"    -nobisection\0A\00", align 1
