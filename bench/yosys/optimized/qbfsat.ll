@.str.19 = private unnamed_addr constant [34 x i8] c"    qbfsat [options] [selection]\0A\00", align 1
@.str.20 = private unnamed_addr constant [74 x i8] c"This command solves an \22exists-forall\22 2QBF-SAT problem defined over the\0A\00", align 1
@.str.21 = private unnamed_addr constant [79 x i8] c"currently selected module. Existentially-quantified variables are declared by\0A\00", align 1
