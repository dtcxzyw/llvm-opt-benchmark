@.str.30 = private unnamed_addr constant [80 x i8] c"        Add an \22$assume\22 cell for the conjunction of all one-bit module output\0A\00", align 1
@.str.31 = private unnamed_addr constant [16 x i8] c"        wires.\0A\00", align 1
@.str.32 = private unnamed_addr constant [31 x i8] c"    -assume-negative-polarity\0A\00", align 1
@.str.33 = private unnamed_addr constant [80 x i8] c"        When adding $assume cells for one-bit module output wires, assume they\0A\00", align 1
