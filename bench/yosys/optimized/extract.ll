@.str.50 = private unnamed_addr constant [34 x i8] c"    -mine_cells_span <min> <max>\0A\00", align 1
@.str.51 = private unnamed_addr constant [70 x i8] c"        only mine for subcircuits with the specified number of cells\0A\00", align 1
