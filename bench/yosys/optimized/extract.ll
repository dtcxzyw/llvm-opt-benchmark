@.str.60 = private unnamed_addr constant [74 x i8] c"        don't consider internal signals with more than <num> connections\0A\00", align 1
@.str.61 = private unnamed_addr constant [78 x i8] c"The modules in the map file may have the attribute 'extract_order' set to an\0A\00", align 1
