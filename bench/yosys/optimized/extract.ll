@.str.6 = private unnamed_addr constant [52 x i8] c"    extract -mine <out_file> [options] [selection]\0A\00", align 1
@.str.7 = private unnamed_addr constant [75 x i8] c"This pass looks for subcircuits that are isomorphic to any of the modules\0A\00", align 1
