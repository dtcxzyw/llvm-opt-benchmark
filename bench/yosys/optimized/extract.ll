@.str.55 = private unnamed_addr constant [27 x i8] c"        default value: 10\0A\00", align 1
@.str.56 = private unnamed_addr constant [42 x i8] c"    -mine_limit_matches_per_module <num>\0A\00", align 1
@.str.57 = private unnamed_addr constant [78 x i8] c"        when calculating the number of matches for a subcircuit, don't count\0A\00", align 1
@.str.58 = private unnamed_addr constant [62 x i8] c"        more than the specified number of matches per module\0A\00", align 1
