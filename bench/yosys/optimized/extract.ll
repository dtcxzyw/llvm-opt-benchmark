@.str.10 = private unnamed_addr constant [21 x i8] c"    -map <map_file>\0A\00", align 1
@.str.11 = private unnamed_addr constant [76 x i8] c"        use the modules in this file as reference. This option can be used\0A\00", align 1
@.str.12 = private unnamed_addr constant [25 x i8] c"        multiple times.\0A\00", align 1
@.str.13 = private unnamed_addr constant [26 x i8] c"    -map %%<design-name>\0A\00", align 1
@.str.14 = private unnamed_addr constant [80 x i8] c"        use the modules in this in-memory design as reference. This option can\0A\00", align 1
@.str.15 = private unnamed_addr constant [33 x i8] c"        be used multiple times.\0A\00", align 1
@.str.16 = private unnamed_addr constant [14 x i8] c"    -verbose\0A\00", align 1
@.str.17 = private unnamed_addr constant [44 x i8] c"        print debug output while analyzing\0A\00", align 1
@.str.18 = private unnamed_addr constant [17 x i8] c"    -constports\0A\00", align 1
@.str.19 = private unnamed_addr constant [69 x i8] c"        also find instances with constant drivers. this may be much\0A\00", align 1
@.str.20 = private unnamed_addr constant [43 x i8] c"        slower than the normal operation.\0A\00", align 1
@.str.21 = private unnamed_addr constant [21 x i8] c"    -nodefaultswaps\0A\00", align 1
@.str.22 = private unnamed_addr constant [78 x i8] c"        normally builtin port swapping rules for internal cells are used per\0A\00", align 1
@.str.23 = private unnamed_addr constant [74 x i8] c"        default. This turns that off, so e.g. 'a^b' does not match 'b^a'\0A\00", align 1
@.str.24 = private unnamed_addr constant [35 x i8] c"        when this option is used.\0A\00", align 1
@.str.25 = private unnamed_addr constant [43 x i8] c"    -compat <needle_type> <haystack_type>\0A\00", align 1
@.str.26 = private unnamed_addr constant [71 x i8] c"        Per default, the cells in the map file (needle) must have the\0A\00", align 1
@.str.27 = private unnamed_addr constant [72 x i8] c"        type as the cells in the active design (haystack). This option\0A\00", align 1
@.str.28 = private unnamed_addr constant [71 x i8] c"        can be used to register additional pairs of types that should\0A\00", align 1
@.str.29 = private unnamed_addr constant [56 x i8] c"        match. This option can be used multiple times.\0A\00", align 1
@.str.30 = private unnamed_addr constant [47 x i8] c"    -swap <needle_type> <port1>,<port2>[,...]\0A\00", align 1
@.str.31 = private unnamed_addr constant [67 x i8] c"        Register a set of swappable ports for a needle cell type.\0A\00", align 1
@.str.32 = private unnamed_addr constant [49 x i8] c"        This option can be used multiple times.\0A\00", align 1
@.str.33 = private unnamed_addr constant [69 x i8] c"    -perm <needle_type> <port1>,<port2>[,...] <portA>,<portB>[,...]\0A\00", align 1
@.str.34 = private unnamed_addr constant [70 x i8] c"        Register a valid permutation of swappable ports for a needle\0A\00", align 1
@.str.35 = private unnamed_addr constant [60 x i8] c"        cell type. This option can be used multiple times.\0A\00", align 1
