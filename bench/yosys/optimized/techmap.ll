@.str.3 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.4 = private unnamed_addr constant [41 x i8] c"    techmap [-map filename] [selection]\0A\00", align 1
@.str.5 = private unnamed_addr constant [77 x i8] c"This pass implements a very simple technology mapper that replaces cells in\0A\00", align 1
@.str.6 = private unnamed_addr constant [76 x i8] c"the design with implementations given in form of a Verilog or RTLIL source\0A\00", align 1
@.str.7 = private unnamed_addr constant [7 x i8] c"file.\0A\00", align 1
@.str.8 = private unnamed_addr constant [19 x i8] c"    -map filename\0A\00", align 1
@.str.9 = private unnamed_addr constant [57 x i8] c"        the library of cell implementations to be used.\0A\00", align 1
@.str.10 = private unnamed_addr constant [63 x i8] c"        without this parameter a builtin library is used that\0A\00", align 1
@.str.11 = private unnamed_addr constant [64 x i8] c"        transforms the internal RTL cells to the internal gate\0A\00", align 1
@.str.12 = private unnamed_addr constant [18 x i8] c"        library.\0A\00", align 1
@.str.13 = private unnamed_addr constant [26 x i8] c"    -map %%<design-name>\0A\00", align 1
@.str.14 = private unnamed_addr constant [74 x i8] c"        like -map above, but with an in-memory design instead of a file.\0A\00", align 1
@.str.15 = private unnamed_addr constant [13 x i8] c"    -extern\0A\00", align 1
@.str.16 = private unnamed_addr constant [75 x i8] c"        load the cell implementations as separate modules into the design\0A\00", align 1
@.str.17 = private unnamed_addr constant [35 x i8] c"        instead of inlining them.\0A\00", align 1
@.str.18 = private unnamed_addr constant [24 x i8] c"    -max_iter <number>\0A\00", align 1
@.str.19 = private unnamed_addr constant [69 x i8] c"        only run the specified number of iterations on each module.\0A\00", align 1
@.str.20 = private unnamed_addr constant [28 x i8] c"        default: unlimited\0A\00", align 1
@.str.21 = private unnamed_addr constant [16 x i8] c"    -recursive\0A\00", align 1
@.str.22 = private unnamed_addr constant [74 x i8] c"        instead of the iterative breadth-first algorithm use a recursive\0A\00", align 1
@.str.23 = private unnamed_addr constant [78 x i8] c"        depth-first algorithm. both methods should yield equivalent results,\0A\00", align 1
@.str.24 = private unnamed_addr constant [40 x i8] c"        but may differ in performance.\0A\00", align 1
@.str.25 = private unnamed_addr constant [15 x i8] c"    -autoproc\0A\00", align 1
@.str.26 = private unnamed_addr constant [78 x i8] c"        Automatically call \22proc\22 on implementations that contain processes.\0A\00", align 1
@.str.27 = private unnamed_addr constant [9 x i8] c"    -wb\0A\00", align 1
@.str.28 = private unnamed_addr constant [66 x i8] c"        Ignore the 'whitebox' attribute on cell implementations.\0A\00", align 1
@.str.29 = private unnamed_addr constant [13 x i8] c"    -assert\0A\00", align 1
@.str.30 = private unnamed_addr constant [78 x i8] c"        this option will cause techmap to exit with an error if it can't map\0A\00", align 1
@.str.31 = private unnamed_addr constant [81 x i8] c"        a selected cell. only cell types that end on an underscore are accepted\0A\00", align 1
@.str.32 = private unnamed_addr constant [43 x i8] c"        as final cell types by this mode.\0A\00", align 1
@.str.33 = private unnamed_addr constant [30 x i8] c"    -D <define>, -I <incdir>\0A\00", align 1
@.str.34 = private unnamed_addr constant [79 x i8] c"        this options are passed as-is to the Verilog frontend for loading the\0A\00", align 1
@.str.35 = private unnamed_addr constant [74 x i8] c"        map file. Note that the Verilog frontend is also called with the\0A\00", align 1
@.str.36 = private unnamed_addr constant [36 x i8] c"        '-nooverwrite' option set.\0A\00", align 1
@.str.37 = private unnamed_addr constant [81 x i8] c"When a module in the map file has the 'techmap_celltype' attribute set, it will\0A\00", align 1
@.str.38 = private unnamed_addr constant [80 x i8] c"match cells with a type that match the text value of this attribute. Otherwise\0A\00", align 1
@.str.39 = private unnamed_addr constant [80 x i8] c"the module name will be used to match the cell.  Multiple space-separated cell\0A\00", align 1
@.str.40 = private unnamed_addr constant [67 x i8] c"types can be listed, and wildcards using [] will be expanded (ie.\0A\00", align 1
@.str.41 = private unnamed_addr constant [52 x i8] c"\22$_DFF_[PN]_\22 is the same as \22$_DFF_P_ $_DFF_N_\22).\0A\00", align 1
@.str.42 = private unnamed_addr constant [82 x i8] c"When a module in the map file has the 'techmap_simplemap' attribute set, techmap\0A\00", align 1
@.str.43 = private unnamed_addr constant [79 x i8] c"will use 'simplemap' (see 'help simplemap') to map cells matching the module.\0A\00", align 1
@.str.44 = private unnamed_addr constant [80 x i8] c"When a module in the map file has the 'techmap_maccmap' attribute set, techmap\0A\00", align 1
@.str.45 = private unnamed_addr constant [75 x i8] c"will use 'maccmap' (see 'help maccmap') to map cells matching the module.\0A\00", align 1
@.str.46 = private unnamed_addr constant [77 x i8] c"When a module in the map file has the 'techmap_wrap' attribute set, techmap\0A\00", align 1
@.str.47 = private unnamed_addr constant [77 x i8] c"will create a wrapper for the cell and then run the command string that the\0A\00", align 1
@.str.48 = private unnamed_addr constant [44 x i8] c"attribute is set to on the wrapper module.\0A\00", align 1
@.str.49 = private unnamed_addr constant [79 x i8] c"When a port on a module in the map file has the 'techmap_autopurge' attribute\0A\00", align 1
@.str.50 = private unnamed_addr constant [79 x i8] c"set, and that port is not connected in the instantiation that is mapped, then\0A\00", align 1
@.str.51 = private unnamed_addr constant [80 x i8] c"a cell port connected only to such wires will be omitted in the mapped version\0A\00", align 1
@.str.52 = private unnamed_addr constant [17 x i8] c"of the circuit.\0A\00", align 1
@.str.53 = private unnamed_addr constant [76 x i8] c"All wires in the modules from the map file matching the pattern _TECHMAP_*\0A\00", align 1
@.str.54 = private unnamed_addr constant [75 x i8] c"or *._TECHMAP_* are special wires that are used to pass instructions from\0A\00", align 1
@.str.55 = private unnamed_addr constant [80 x i8] c"the mapping module to the techmap command. At the moment the following special\0A\00", align 1
@.str.56 = private unnamed_addr constant [22 x i8] c"wires are supported:\0A\00", align 1
@.str.57 = private unnamed_addr constant [20 x i8] c"    _TECHMAP_FAIL_\0A\00", align 1
@.str.58 = private unnamed_addr constant [78 x i8] c"        When this wire is set to a non-zero constant value, techmap will not\0A\00", align 1
@.str.59 = private unnamed_addr constant [73 x i8] c"        use this module and instead try the next module with a matching\0A\00", align 1
@.str.60 = private unnamed_addr constant [39 x i8] c"        'techmap_celltype' attribute.\0A\00", align 1
@.str.61 = private unnamed_addr constant [78 x i8] c"        When such a wire exists but does not have a constant value after all\0A\00", align 1
@.str.62 = private unnamed_addr constant [75 x i8] c"        _TECHMAP_DO_* commands have been executed, an error is generated.\0A\00", align 1
@.str.63 = private unnamed_addr constant [19 x i8] c"    _TECHMAP_DO_*\0A\00", align 1
@.str.64 = private unnamed_addr constant [81 x i8] c"        This wires are evaluated in alphabetical order. The constant text value\0A\00", align 1
@.str.65 = private unnamed_addr constant [79 x i8] c"        of this wire is a yosys command (or sequence of commands) that is run\0A\00", align 1
@.str.66 = private unnamed_addr constant [81 x i8] c"        by techmap on the module. A common use case is to run 'proc' on modules\0A\00", align 1
@.str.67 = private unnamed_addr constant [51 x i8] c"        that are written using always-statements.\0A\00", align 1
@.str.68 = private unnamed_addr constant [75 x i8] c"        When such a wire has a non-constant value at the time it is to be\0A\00", align 1
@.str.69 = private unnamed_addr constant [79 x i8] c"        evaluated, an error is produced. That means it is possible for such a\0A\00", align 1
@.str.70 = private unnamed_addr constant [76 x i8] c"        wire to start out as non-constant and evaluate to a constant value\0A\00", align 1
@.str.71 = private unnamed_addr constant [60 x i8] c"        during processing of other _TECHMAP_DO_* commands.\0A\00", align 1
@.str.72 = private unnamed_addr constant [80 x i8] c"        A _TECHMAP_DO_* command may start with the special token 'CONSTMAP; '.\0A\00", align 1
@.str.73 = private unnamed_addr constant [81 x i8] c"        in this case techmap will create a copy for each distinct configuration\0A\00", align 1
@.str.74 = private unnamed_addr constant [76 x i8] c"        of constant inputs and shorted inputs at this point and import the\0A\00", align 1
@.str.75 = private unnamed_addr constant [79 x i8] c"        constant and connected bits into the map module. All further commands\0A\00", align 1
@.str.76 = private unnamed_addr constant [78 x i8] c"        are executed in this copy. This is a very convenient way of creating\0A\00", align 1
@.str.77 = private unnamed_addr constant [80 x i8] c"        optimized specializations of techmap modules without using the special\0A\00", align 1
@.str.78 = private unnamed_addr constant [37 x i8] c"        parameters described below.\0A\00", align 1
@.str.79 = private unnamed_addr constant [81 x i8] c"        A _TECHMAP_DO_* command may start with the special token 'RECURSION; '.\0A\00", align 1
@.str.80 = private unnamed_addr constant [82 x i8] c"        then techmap will recursively replace the cells in the module with their\0A\00", align 1
@.str.81 = private unnamed_addr constant [71 x i8] c"        implementation. This is not affected by the -max_iter option.\0A\00", align 1
@.str.82 = private unnamed_addr constant [77 x i8] c"        It is possible to combine both prefixes to 'RECURSION; CONSTMAP; '.\0A\00", align 1
@.str.83 = private unnamed_addr constant [38 x i8] c"    _TECHMAP_REMOVEINIT_<port-name>_\0A\00", align 1
@.str.84 = private unnamed_addr constant [78 x i8] c"        When this wire is set to a constant value, the init attribute of the\0A\00", align 1
@.str.85 = private unnamed_addr constant [79 x i8] c"        wire(s) connected to this port will be consumed.  This wire must have\0A\00", align 1
@.str.86 = private unnamed_addr constant [81 x i8] c"        the same width as the given port, and for every bit that is set to 1 in\0A\00", align 1
@.str.87 = private unnamed_addr constant [82 x i8] c"        the value, the corresponding init attribute bit will be changed to 1'bx.\0A\00", align 1
@.str.88 = private unnamed_addr constant [77 x i8] c"        If all bits of an init attribute are left as x, it will be removed.\0A\00", align 1
@.str.89 = private unnamed_addr constant [80 x i8] c"In addition to this special wires, techmap also supports special parameters in\0A\00", align 1
@.str.90 = private unnamed_addr constant [26 x i8] c"modules in the map file:\0A\00", align 1
@.str.91 = private unnamed_addr constant [24 x i8] c"    _TECHMAP_CELLTYPE_\0A\00", align 1
@.str.92 = private unnamed_addr constant [81 x i8] c"        When a parameter with this name exists, it will be set to the type name\0A\00", align 1
@.str.93 = private unnamed_addr constant [46 x i8] c"        of the cell that matches the module.\0A\00", align 1
@.str.94 = private unnamed_addr constant [24 x i8] c"    _TECHMAP_CELLNAME_\0A\00", align 1
@.str.95 = private unnamed_addr constant [76 x i8] c"        When a parameter with this name exists, it will be set to the name\0A\00", align 1
@.str.96 = private unnamed_addr constant [36 x i8] c"    _TECHMAP_CONSTMSK_<port-name>_\0A\00", align 1
@.str.97 = private unnamed_addr constant [36 x i8] c"    _TECHMAP_CONSTVAL_<port-name>_\0A\00", align 1
@.str.98 = private unnamed_addr constant [80 x i8] c"        When this pair of parameters is available in a module for a port, then\0A\00", align 1
@.str.99 = private unnamed_addr constant [79 x i8] c"        former has a 1-bit for each constant input bit and the latter has the\0A\00", align 1
@.str.100 = private unnamed_addr constant [81 x i8] c"        value for this bit. The unused bits of the latter are set to undef (x).\0A\00", align 1
