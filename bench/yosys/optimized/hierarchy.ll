@.str.10 = private unnamed_addr constant [76 x i8] c"needed. It also resolves assignments to wired logic data types (wand/wor),\0A\00", align 1
@.str.11 = private unnamed_addr constant [75 x i8] c"resolves positional module parameters, unrolls array instances, and more.\0A\00", align 1
@.str.12 = private unnamed_addr constant [12 x i8] c"    -check\0A\00", align 1
@.str.13 = private unnamed_addr constant [71 x i8] c"        also check the design hierarchy. this generates an error when\0A\00", align 1
@.str.14 = private unnamed_addr constant [49 x i8] c"        an unknown module is used as cell type.\0A\00", align 1
@.str.15 = private unnamed_addr constant [15 x i8] c"    -simcheck\0A\00", align 1
