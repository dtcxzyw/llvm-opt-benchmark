@.str.19 = private unnamed_addr constant [59 x i8] c"        like -simcheck, but allow smtlib2_module modules.\0A\00", align 1
@.str.20 = private unnamed_addr constant [16 x i8] c"    -purge_lib\0A\00", align 1
@.str.21 = private unnamed_addr constant [77 x i8] c"        by default the hierarchy command will not remove library (blackbox)\0A\00", align 1
@.str.22 = private unnamed_addr constant [74 x i8] c"        modules. use this option to also remove unused blackbox modules.\0A\00", align 1
@.str.23 = private unnamed_addr constant [25 x i8] c"    -libdir <directory>\0A\00", align 1
