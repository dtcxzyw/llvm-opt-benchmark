@.str.226 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.227 = private unnamed_addr constant [75 x i8] c"    select [ -add | -del | -set <name> ] {-read <filename> | <selection>}\0A\00", align 1
@.str.228 = private unnamed_addr constant [30 x i8] c"    select [ -unset <name> ]\0A\00", align 1
@.str.229 = private unnamed_addr constant [65 x i8] c"    select [ <assert_option> ] {-read <filename> | <selection>}\0A\00", align 1
@.str.230 = private unnamed_addr constant [60 x i8] c"    select [ -list | -write <filename> | -count | -clear ]\0A\00", align 1
@.str.231 = private unnamed_addr constant [30 x i8] c"    select -module <modname>\0A\00", align 1
@.str.232 = private unnamed_addr constant [82 x i8] c"Most commands use the list of currently selected objects to determine which part\0A\00", align 1
@.str.233 = private unnamed_addr constant [79 x i8] c"of the design to operate on. This command can be used to modify and view this\0A\00", align 1
@.str.234 = private unnamed_addr constant [27 x i8] c"list of selected objects.\0A\00", align 1
@.str.235 = private unnamed_addr constant [78 x i8] c"Note that many commands support an optional [selection] argument that can be\0A\00", align 1
@.str.236 = private unnamed_addr constant [75 x i8] c"used to override the global selection for the command. The syntax of this\0A\00", align 1
@.str.237 = private unnamed_addr constant [74 x i8] c"optional argument is identical to the syntax of the <selection> argument\0A\00", align 1
@.str.238 = private unnamed_addr constant [17 x i8] c"described here.\0A\00", align 1
@.str.239 = private unnamed_addr constant [16 x i8] c"    -add, -del\0A\00", align 1
@.str.240 = private unnamed_addr constant [67 x i8] c"        add or remove the given objects to the current selection.\0A\00", align 1
@.str.241 = private unnamed_addr constant [65 x i8] c"        without this options the current selection is replaced.\0A\00", align 1
@.str.242 = private unnamed_addr constant [17 x i8] c"    -set <name>\0A\00", align 1
@.str.243 = private unnamed_addr constant [77 x i8] c"        do not modify the current selection. instead save the new selection\0A\00", align 1
@.str.244 = private unnamed_addr constant [82 x i8] c"        under the given name (see @<name> below). to save the current selection,\0A\00", align 1
@.str.245 = private unnamed_addr constant [37 x i8] c"        use \22select -set <name> %%\22\0A\00", align 1
@.str.246 = private unnamed_addr constant [19 x i8] c"    -unset <name>\0A\00", align 1
@.str.247 = private unnamed_addr constant [80 x i8] c"        do not modify the current selection. instead remove a previously saved\0A\00", align 1
@.str.248 = private unnamed_addr constant [61 x i8] c"        selection under the given name (see @<name> below).\0A\00", align 1
@.str.249 = private unnamed_addr constant [18 x i8] c"    -assert-none\0A\00", align 1
@.str.250 = private unnamed_addr constant [76 x i8] c"        do not modify the current selection. instead assert that the given\0A\00", align 1
@.str.251 = private unnamed_addr constant [75 x i8] c"        selection is empty. i.e. produce an error if any object or module\0A\00", align 1
@.str.252 = private unnamed_addr constant [42 x i8] c"        matching the selection is found.\0A\00", align 1
@.str.253 = private unnamed_addr constant [17 x i8] c"    -assert-any\0A\00", align 1
@.str.254 = private unnamed_addr constant [78 x i8] c"        selection is non-empty. i.e. produce an error if no object or module\0A\00", align 1
@.str.255 = private unnamed_addr constant [21 x i8] c"    -assert-count N\0A\00", align 1
@.str.256 = private unnamed_addr constant [47 x i8] c"        selection contains exactly N objects.\0A\00", align 1
@.str.257 = private unnamed_addr constant [19 x i8] c"    -assert-max N\0A\00", align 1
@.str.258 = private unnamed_addr constant [60 x i8] c"        selection contains less than or exactly N objects.\0A\00", align 1
@.str.259 = private unnamed_addr constant [19 x i8] c"    -assert-min N\0A\00", align 1
@.str.260 = private unnamed_addr constant [48 x i8] c"        selection contains at least N objects.\0A\00", align 1
@.str.261 = private unnamed_addr constant [11 x i8] c"    -list\0A\00", align 1
@.str.262 = private unnamed_addr constant [51 x i8] c"        list all objects in the current selection\0A\00", align 1
@.str.263 = private unnamed_addr constant [23 x i8] c"    -write <filename>\0A\00", align 1
@.str.264 = private unnamed_addr constant [63 x i8] c"        like -list but write the output to the specified file\0A\00", align 1
@.str.265 = private unnamed_addr constant [22 x i8] c"    -read <filename>\0A\00", align 1
@.str.266 = private unnamed_addr constant [53 x i8] c"        read the specified file (written by -write)\0A\00", align 1
@.str.267 = private unnamed_addr constant [12 x i8] c"    -count\0A\00", align 1
@.str.268 = private unnamed_addr constant [52 x i8] c"        count all objects in the current selection\0A\00", align 1
@.str.269 = private unnamed_addr constant [12 x i8] c"    -clear\0A\00", align 1
@.str.270 = private unnamed_addr constant [73 x i8] c"        clear the current selection. this effectively selects the whole\0A\00", align 1
@.str.271 = private unnamed_addr constant [75 x i8] c"        design. it also resets the selected module (see -module). use the\0A\00", align 1
@.str.272 = private unnamed_addr constant [81 x i8] c"        command 'select *' to select everything but stay in the current module.\0A\00", align 1
@.str.273 = private unnamed_addr constant [11 x i8] c"    -none\0A\00", align 1
@.str.274 = private unnamed_addr constant [69 x i8] c"        create an empty selection. the current module is unchanged.\0A\00", align 1
@.str.275 = private unnamed_addr constant [23 x i8] c"    -module <modname>\0A\00", align 1
@.str.276 = private unnamed_addr constant [58 x i8] c"        limit the current scope to the specified module.\0A\00", align 1
@.str.277 = private unnamed_addr constant [69 x i8] c"        the difference between this and simply selecting the module\0A\00", align 1
@.str.278 = private unnamed_addr constant [67 x i8] c"        is that all object names are interpreted relative to this\0A\00", align 1
@.str.279 = private unnamed_addr constant [73 x i8] c"        module after this command until the selection is cleared again.\0A\00", align 1
@.str.280 = private unnamed_addr constant [72 x i8] c"When this command is called without an argument, the current selection\0A\00", align 1
@.str.281 = private unnamed_addr constant [79 x i8] c"is displayed in a compact form (i.e. only the module name when a whole module\0A\00", align 1
@.str.282 = private unnamed_addr constant [15 x i8] c"is selected).\0A\00", align 1
@.str.283 = private unnamed_addr constant [76 x i8] c"The <selection> argument itself is a series of commands for a simple stack\0A\00", align 1
@.str.284 = private unnamed_addr constant [74 x i8] c"machine. Each element on the stack represents a set of selected objects.\0A\00", align 1
@.str.285 = private unnamed_addr constant [73 x i8] c"After this commands have been executed, the union of all remaining sets\0A\00", align 1
@.str.286 = private unnamed_addr constant [65 x i8] c"on the stack is computed and used as selection for the command.\0A\00", align 1
@.str.287 = private unnamed_addr constant [54 x i8] c"Pushing (selecting) object when not in -module mode:\0A\00", align 1
@.str.288 = private unnamed_addr constant [19 x i8] c"    <mod_pattern>\0A\00", align 1
@.str.289 = private unnamed_addr constant [40 x i8] c"        select the specified module(s)\0A\00", align 1
@.str.290 = private unnamed_addr constant [33 x i8] c"    <mod_pattern>/<obj_pattern>\0A\00", align 1
@.str.291 = private unnamed_addr constant [59 x i8] c"        select the specified object(s) from the module(s)\0A\00", align 1
@.str.292 = private unnamed_addr constant [50 x i8] c"Pushing (selecting) object when in -module mode:\0A\00", align 1
@.str.293 = private unnamed_addr constant [19 x i8] c"    <obj_pattern>\0A\00", align 1
@.str.294 = private unnamed_addr constant [64 x i8] c"        select the specified object(s) from the current module\0A\00", align 1
@.str.295 = private unnamed_addr constant [70 x i8] c"By default, patterns will not match black/white-box modules or their\0A\00", align 1
@.str.296 = private unnamed_addr constant [65 x i8] c"contents. To include such objects, prefix the pattern with '='.\0A\00", align 1
@.str.297 = private unnamed_addr constant [72 x i8] c"A <mod_pattern> can be a module name, wildcard expression (*, ?, [..])\0A\00", align 1
@.str.298 = private unnamed_addr constant [49 x i8] c"matching module names, or one of the following:\0A\00", align 1
@.str.299 = private unnamed_addr constant [40 x i8] c"    A:<pattern>, A:<pattern>=<pattern>\0A\00", align 1
@.str.300 = private unnamed_addr constant [66 x i8] c"        all modules with an attribute matching the given pattern\0A\00", align 1
@.str.301 = private unnamed_addr constant [62 x i8] c"        in addition to = also <, <=, >=, and > are supported\0A\00", align 1
@.str.302 = private unnamed_addr constant [17 x i8] c"    N:<pattern>\0A\00", align 1
@.str.303 = private unnamed_addr constant [60 x i8] c"        all modules with a name matching the given pattern\0A\00", align 1
@.str.304 = private unnamed_addr constant [68 x i8] c"        (i.e. 'N:' is optional as it is the default matching rule)\0A\00", align 1
@.str.305 = private unnamed_addr constant [72 x i8] c"An <obj_pattern> can be an object name, wildcard expression, or one of\0A\00", align 1
@.str.306 = private unnamed_addr constant [16 x i8] c"the following:\0A\00", align 1
@.str.307 = private unnamed_addr constant [17 x i8] c"    w:<pattern>\0A\00", align 1
@.str.308 = private unnamed_addr constant [67 x i8] c"        all wires with a name matching the given wildcard pattern\0A\00", align 1
@.str.309 = private unnamed_addr constant [43 x i8] c"    i:<pattern>, o:<pattern>, x:<pattern>\0A\00", align 1
@.str.310 = private unnamed_addr constant [77 x i8] c"        all inputs (i:), outputs (o:) or any ports (x:) with matching names\0A\00", align 1
@.str.311 = private unnamed_addr constant [29 x i8] c"    s:<size>, s:<min>:<max>\0A\00", align 1
@.str.312 = private unnamed_addr constant [41 x i8] c"        all wires with a matching width\0A\00", align 1
@.str.313 = private unnamed_addr constant [17 x i8] c"    m:<pattern>\0A\00", align 1
@.str.314 = private unnamed_addr constant [61 x i8] c"        all memories with a name matching the given pattern\0A\00", align 1
@.str.315 = private unnamed_addr constant [17 x i8] c"    c:<pattern>\0A\00", align 1
@.str.316 = private unnamed_addr constant [58 x i8] c"        all cells with a name matching the given pattern\0A\00", align 1
@.str.317 = private unnamed_addr constant [17 x i8] c"    t:<pattern>\0A\00", align 1
@.str.318 = private unnamed_addr constant [58 x i8] c"        all cells with a type matching the given pattern\0A\00", align 1
@.str.319 = private unnamed_addr constant [17 x i8] c"    p:<pattern>\0A\00", align 1
@.str.320 = private unnamed_addr constant [62 x i8] c"        all processes with a name matching the given pattern\0A\00", align 1
@.str.321 = private unnamed_addr constant [17 x i8] c"    a:<pattern>\0A\00", align 1
@.str.322 = private unnamed_addr constant [71 x i8] c"        all objects with an attribute name matching the given pattern\0A\00", align 1
@.str.323 = private unnamed_addr constant [27 x i8] c"    a:<pattern>=<pattern>\0A\00", align 1
@.str.324 = private unnamed_addr constant [64 x i8] c"        all objects with a matching attribute name-value-pair.\0A\00", align 1
@.str.325 = private unnamed_addr constant [40 x i8] c"    r:<pattern>, r:<pattern>=<pattern>\0A\00", align 1
@.str.326 = private unnamed_addr constant [68 x i8] c"        cells with matching parameters. also with <, <=, >= and >.\0A\00", align 1
@.str.327 = private unnamed_addr constant [17 x i8] c"    n:<pattern>\0A\00", align 1
@.str.328 = private unnamed_addr constant [60 x i8] c"        all objects with a name matching the given pattern\0A\00", align 1
@.str.329 = private unnamed_addr constant [68 x i8] c"        (i.e. 'n:' is optional as it is the default matching rule)\0A\00", align 1
@.str.330 = private unnamed_addr constant [13 x i8] c"    @<name>\0A\00", align 1
