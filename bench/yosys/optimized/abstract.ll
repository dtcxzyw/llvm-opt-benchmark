@.str.4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.5 = private unnamed_addr constant [43 x i8] c"    abstract [mode] [options] [selection]\0A\00", align 1
@.str.6 = private unnamed_addr constant [81 x i8] c"Perform abstraction of signals within the design. Abstraction replaces a signal\0A\00", align 1
@.str.7 = private unnamed_addr constant [80 x i8] c"with an unconstrained abstract value that can take an arbitrary concrete value\0A\00", align 1
@.str.8 = private unnamed_addr constant [79 x i8] c"during formal verification. The mode and options control when a signal should\0A\00", align 1
@.str.9 = private unnamed_addr constant [67 x i8] c"be abstracted and how it should affect FFs present in the design.\0A\00", align 1
@.str.10 = private unnamed_addr constant [7 x i8] c"Modes:\00", align 1
@.str.11 = private unnamed_addr constant [12 x i8] c"    -state\0A\00", align 1
@.str.12 = private unnamed_addr constant [81 x i8] c"        The selected FFs will be modified to load a new abstract value on every\0A\00", align 1
@.str.13 = private unnamed_addr constant [82 x i8] c"        active clock edge, async reset or async load. This is independent of any\0A\00", align 1
@.str.14 = private unnamed_addr constant [82 x i8] c"        clock enable that may be present on the FF cell. Conditional abstraction\0A\00", align 1
@.str.15 = private unnamed_addr constant [83 x i8] c"        is supported with the -enable/-enabeln options. If present, the condition\0A\00", align 1
@.str.16 = private unnamed_addr constant [82 x i8] c"        is sampled at the same time as the FF would smaple the correspnding data\0A\00", align 1
@.str.17 = private unnamed_addr constant [82 x i8] c"        or async-data input whose value will be replaced with an abstract value.\0A\00", align 1
@.str.18 = private unnamed_addr constant [80 x i8] c"        The selection can be used to specify which state bits to abstract. For\0A\00", align 1
@.str.19 = private unnamed_addr constant [79 x i8] c"        each selected wire, any state bits that the wire is driven by will be\0A\00", align 1
@.str.20 = private unnamed_addr constant [77 x i8] c"        abstracted. For a selected FF cell, all of its state is abstracted.\0A\00", align 1
@.str.21 = private unnamed_addr constant [80 x i8] c"        Individual bits of a single wire can be abtracted using the -slice and\0A\00", align 1
@.str.22 = private unnamed_addr constant [30 x i8] c"        -rtlilslice options.\0A\00", align 1
@.str.23 = private unnamed_addr constant [11 x i8] c"    -init\0A\00", align 1
@.str.24 = private unnamed_addr constant [78 x i8] c"        The selected FFs will be modified to have an abstract initial value.\0A\00", align 1
@.str.25 = private unnamed_addr constant [70 x i8] c"        The -enable/-enablen options are not supported in this mode.\0A\00", align 1
@.str.26 = private unnamed_addr constant [10 x i8] c"        \0A\00", align 1
@.str.27 = private unnamed_addr constant [77 x i8] c"        The selection is used in the same way as it is for the -state mode.\0A\00", align 1
@.str.28 = private unnamed_addr constant [12 x i8] c"    -value\0A\00", align 1
@.str.29 = private unnamed_addr constant [79 x i8] c"        The drivers of the selected signals will be replaced with an abstract\0A\00", align 1
@.str.30 = private unnamed_addr constant [79 x i8] c"        value. In this mode, the abstract value can change at any time and is\0A\00", align 1
@.str.31 = private unnamed_addr constant [80 x i8] c"        not synchronized to any clock or other signal. Conditional abstraction\0A\00", align 1
@.str.32 = private unnamed_addr constant [76 x i8] c"        is supported with the -enable/-enablen options. The condition will\0A\00", align 1
