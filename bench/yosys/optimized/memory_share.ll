@.str.6 = private unnamed_addr constant [68 x i8] c"This pass merges share-able memory ports into single memory ports.\0A\00", align 1
@.str.7 = private unnamed_addr constant [75 x i8] c"The following methods are used to consolidate the number of memory ports:\0A\00", align 1
@.str.8 = private unnamed_addr constant [78 x i8] c"  - When multiple write ports access the same address then this is converted\0A\00", align 1
@.str.9 = private unnamed_addr constant [79 x i8] c"    to a single write port with a more complex data and/or enable logic path.\0A\00", align 1
