@.str.4 = private unnamed_addr constant [50 x i8] c"    memory_share [-nosat] [-nowiden] [selection]\0A\00", align 1
@.str.5 = private unnamed_addr constant [68 x i8] c"This pass merges share-able memory ports into single memory ports.\0A\00", align 1
@.str.6 = private unnamed_addr constant [75 x i8] c"The following methods are used to consolidate the number of memory ports:\0A\00", align 1
@.str.7 = private unnamed_addr constant [78 x i8] c"  - When multiple write ports access the same address then this is converted\0A\00", align 1
@.str.8 = private unnamed_addr constant [79 x i8] c"    to a single write port with a more complex data and/or enable logic path.\0A\00", align 1
@.str.9 = private unnamed_addr constant [79 x i8] c"  - When multiple read or write ports access adjacent aligned addresses, they\0A\00", align 1
@.str.10 = private unnamed_addr constant [81 x i8] c"    are merged to a single wide read or write port.  This transformation can be\0A\00", align 1
@.str.11 = private unnamed_addr constant [42 x i8] c"    disabled with the \22-nowiden\22 option.\0A\00", align 1
@.str.12 = private unnamed_addr constant [74 x i8] c"  - When multiple write ports are never accessed at the same time (a SAT\0A\00", align 1
@.str.13 = private unnamed_addr constant [80 x i8] c"    solver is used to determine this), then the ports are merged into a single\0A\00", align 1
@.str.14 = private unnamed_addr constant [80 x i8] c"    write port.  This transformation can be disabled with the \22-nosat\22 option.\0A\00", align 1
@.str.15 = private unnamed_addr constant [78 x i8] c"Note that in addition to the algorithms implemented in this pass, the $memrd\0A\00", align 1
@.str.16 = private unnamed_addr constant [81 x i8] c"and $memwr cells are also subject to generic resource sharing passes (and other\0A\00", align 1
@.str.17 = private unnamed_addr constant [49 x i8] c"optimizations) such as \22share\22 and \22opt_merge\22.\0A\00", align 1
@.str.18 = private unnamed_addr constant [66 x i8] c"Executing MEMORY_SHARE pass (consolidating $memrd/$memwr cells).\0A\00", align 1
