@.str.3 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.4 = private unnamed_addr constant [37 x i8] c"    write_smt2 [options] [filename]\0A\00", align 1
@.str.5 = private unnamed_addr constant [81 x i8] c"Write a SMT-LIBv2 [1] description of the current design. For a module with name\0A\00", align 1
@.str.6 = private unnamed_addr constant [77 x i8] c"'<mod>' this will declare the sort '<mod>_s' (state of the module) and will\0A\00", align 1
@.str.7 = private unnamed_addr constant [55 x i8] c"define and declare functions operating on that state.\0A\00", align 1
@.str.8 = private unnamed_addr constant [76 x i8] c"The following SMT2 functions are generated for a module with name '<mod>'.\0A\00", align 1
@.str.9 = private unnamed_addr constant [76 x i8] c"Some declarations/definitions are printed with a special comment. A prover\0A\00", align 1
@.str.10 = private unnamed_addr constant [78 x i8] c"using the SMT2 files can use those comments to collect all relevant metadata\0A\00", align 1
@.str.11 = private unnamed_addr constant [19 x i8] c"about the design.\0A\00", align 1
@.str.12 = private unnamed_addr constant [31 x i8] c"    ; yosys-smt2-module <mod>\0A\00", align 1
@.str.13 = private unnamed_addr constant [32 x i8] c"    (declare-sort |<mod>_s| 0)\0A\00", align 1
@.str.14 = private unnamed_addr constant [56 x i8] c"        The sort representing a state of module <mod>.\0A\00", align 1
@.str.15 = private unnamed_addr constant [59 x i8] c"    (define-fun |<mod>_h| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.16 = private unnamed_addr constant [72 x i8] c"        This function must be asserted for each state to establish the\0A\00", align 1
@.str.17 = private unnamed_addr constant [27 x i8] c"        design hierarchy.\0A\00", align 1
@.str.18 = private unnamed_addr constant [43 x i8] c"    ; yosys-smt2-input <wirename> <width>\0A\00", align 1
@.str.19 = private unnamed_addr constant [44 x i8] c"    ; yosys-smt2-output <wirename> <width>\0A\00", align 1
@.str.20 = private unnamed_addr constant [46 x i8] c"    ; yosys-smt2-register <wirename> <width>\0A\00", align 1
@.str.21 = private unnamed_addr constant [42 x i8] c"    ; yosys-smt2-wire <wirename> <width>\0A\00", align 1
@.str.22 = private unnamed_addr constant [70 x i8] c"    (define-fun |<mod>_n <wirename>| (|<mod>_s|) (_ BitVec <width>))\0A\00", align 1
@.str.23 = private unnamed_addr constant [56 x i8] c"    (define-fun |<mod>_n <wirename>| (|<mod>_s|) Bool)\0A\00", align 1
@.str.24 = private unnamed_addr constant [76 x i8] c"        For each port, register, and wire with the 'keep' attribute set an\0A\00", align 1
@.str.25 = private unnamed_addr constant [80 x i8] c"        accessor function is generated. Single-bit wires are returned as Bool,\0A\00", align 1
@.str.26 = private unnamed_addr constant [36 x i8] c"        multi-bit wires as BitVec.\0A\00", align 1
@.str.27 = private unnamed_addr constant [47 x i8] c"    ; yosys-smt2-cell <submod> <instancename>\0A\00", align 1
@.str.28 = private unnamed_addr constant [69 x i8] c"    (declare-fun |<mod>_h <instancename>| (|<mod>_s|) |<submod>_s|)\0A\00", align 1
@.str.29 = private unnamed_addr constant [74 x i8] c"        There is a function like that for each hierarchical instance. It\0A\00", align 1
@.str.30 = private unnamed_addr constant [75 x i8] c"        returns the sort that represents the state of the sub-module that\0A\00", align 1
@.str.31 = private unnamed_addr constant [34 x i8] c"        implements the instance.\0A\00", align 1
@.str.32 = private unnamed_addr constant [47 x i8] c"    (declare-fun |<mod>_is| (|<mod>_s|) Bool)\0A\00", align 1
@.str.33 = private unnamed_addr constant [79 x i8] c"        This function must be asserted 'true' for initial states, and 'false'\0A\00", align 1
@.str.34 = private unnamed_addr constant [20 x i8] c"        otherwise.\0A\00", align 1
@.str.35 = private unnamed_addr constant [59 x i8] c"    (define-fun |<mod>_i| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.36 = private unnamed_addr constant [71 x i8] c"        This function must be asserted 'true' for initial states. For\0A\00", align 1
@.str.37 = private unnamed_addr constant [59 x i8] c"        non-initial states it must be left unconstrained.\0A\00", align 1
@.str.38 = private unnamed_addr constant [82 x i8] c"    (define-fun |<mod>_t| ((state |<mod>_s|) (next_state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.39 = private unnamed_addr constant [69 x i8] c"        This function evaluates to 'true' if the states 'state' and\0A\00", align 1
@.str.40 = private unnamed_addr constant [53 x i8] c"        'next_state' form a valid state transition.\0A\00", align 1
@.str.41 = private unnamed_addr constant [59 x i8] c"    (define-fun |<mod>_a| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.42 = private unnamed_addr constant [80 x i8] c"        This function evaluates to 'true' if all assertions hold in the state.\0A\00", align 1
@.str.43 = private unnamed_addr constant [59 x i8] c"    (define-fun |<mod>_u| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.44 = private unnamed_addr constant [81 x i8] c"        This function evaluates to 'true' if all assumptions hold in the state.\0A\00", align 1
@.str.45 = private unnamed_addr constant [49 x i8] c"    ; yosys-smt2-assert <id> <filename:linenum>\0A\00", align 1
@.str.46 = private unnamed_addr constant [64 x i8] c"    (define-fun |<mod>_a <id>| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.47 = private unnamed_addr constant [81 x i8] c"        Each $assert cell is converted into one of this functions. The function\0A\00", align 1
@.str.48 = private unnamed_addr constant [73 x i8] c"        evaluates to 'true' if the assert statement holds in the state.\0A\00", align 1
@.str.49 = private unnamed_addr constant [49 x i8] c"    ; yosys-smt2-assume <id> <filename:linenum>\0A\00", align 1
@.str.50 = private unnamed_addr constant [64 x i8] c"    (define-fun |<mod>_u <id>| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.51 = private unnamed_addr constant [81 x i8] c"        Each $assume cell is converted into one of this functions. The function\0A\00", align 1
@.str.52 = private unnamed_addr constant [73 x i8] c"        evaluates to 'true' if the assume statement holds in the state.\0A\00", align 1
@.str.53 = private unnamed_addr constant [48 x i8] c"    ; yosys-smt2-cover <id> <filename:linenum>\0A\00", align 1
@.str.54 = private unnamed_addr constant [64 x i8] c"    (define-fun |<mod>_c <id>| ((state |<mod>_s|)) Bool (...))\0A\00", align 1
@.str.55 = private unnamed_addr constant [80 x i8] c"        Each $cover cell is converted into one of this functions. The function\0A\00", align 1
@.str.56 = private unnamed_addr constant [79 x i8] c"        evaluates to 'true' if the cover statement is activated in the state.\0A\00", align 1
@.str.57 = private unnamed_addr constant [10 x i8] c"Options:\0A\00", align 1
@.str.58 = private unnamed_addr constant [14 x i8] c"    -verbose\0A\00", align 1
@.str.59 = private unnamed_addr constant [72 x i8] c"        this will print the recursive walk used to export the modules.\0A\00", align 1
@.str.60 = private unnamed_addr constant [11 x i8] c"    -stbv\0A\00", align 1
@.str.61 = private unnamed_addr constant [76 x i8] c"        Use a BitVec sort to represent a state instead of an uninterpreted\0A\00", align 1
@.str.62 = private unnamed_addr constant [73 x i8] c"        sort. As a side-effect this will prevent use of arrays to model\0A\00", align 1
@.str.63 = private unnamed_addr constant [19 x i8] c"        memories.\0A\00", align 1
@.str.64 = private unnamed_addr constant [11 x i8] c"    -stdt\0A\00", align 1
@.str.65 = private unnamed_addr constant [76 x i8] c"        Use SMT-LIB 2.6 style datatypes to represent a state instead of an\0A\00", align 1
@.str.66 = private unnamed_addr constant [29 x i8] c"        uninterpreted sort.\0A\00", align 1
@.str.67 = private unnamed_addr constant [11 x i8] c"    -nobv\0A\00", align 1
@.str.68 = private unnamed_addr constant [79 x i8] c"        disable support for BitVec (FixedSizeBitVectors theory). without this\0A\00", align 1
@.str.69 = private unnamed_addr constant [74 x i8] c"        option multi-bit wires are represented using the BitVec sort and\0A\00", align 1
@.str.70 = private unnamed_addr constant [71 x i8] c"        support for coarse grain cells (incl. arithmetic) is enabled.\0A\00", align 1
@.str.71 = private unnamed_addr constant [12 x i8] c"    -nomem\0A\00", align 1
@.str.72 = private unnamed_addr constant [76 x i8] c"        disable support for memories (via ArraysEx theory). this option is\0A\00", align 1
@.str.73 = private unnamed_addr constant [71 x i8] c"        implied by -nobv. only $mem cells without merged registers in\0A\00", align 1
@.str.74 = private unnamed_addr constant [75 x i8] c"        read ports are supported. call \22memory\22 with -nordff to make sure\0A\00", align 1
@.str.75 = private unnamed_addr constant [80 x i8] c"        that no registers are merged into $mem read ports. '<mod>_m' functions\0A\00", align 1
@.str.76 = private unnamed_addr constant [79 x i8] c"        will be generated for accessing the arrays that are used to represent\0A\00", align 1
@.str.77 = private unnamed_addr constant [12 x i8] c"    -wires\0A\00", align 1
@.str.78 = private unnamed_addr constant [81 x i8] c"        create '<mod>_n' functions for all public wires. by default only ports,\0A\00", align 1
@.str.79 = private unnamed_addr constant [70 x i8] c"        registers, and wires with the 'keep' attribute are exported.\0A\00", align 1
@.str.80 = private unnamed_addr constant [26 x i8] c"    -tpl <template_file>\0A\00", align 1
@.str.81 = private unnamed_addr constant [80 x i8] c"        use the given template file. the line containing only the token '%%%%'\0A\00", align 1
