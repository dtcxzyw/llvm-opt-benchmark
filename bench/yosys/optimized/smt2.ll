@.str.99 = private unnamed_addr constant [29 x i8] c"        (set-logic QF_UFBV)\0A\00", align 1
@.str.100 = private unnamed_addr constant [47 x i8] c"        ; insert the auto-generated code here\0A\00", align 1
@.str.101 = private unnamed_addr constant [14 x i8] c"        %%%%\0A\00", align 1
@.str.102 = private unnamed_addr constant [49 x i8] c"        ; declare two state variables s1 and s2\0A\00", align 1
@.str.103 = private unnamed_addr constant [36 x i8] c"        (declare-fun s1 () test_s)\0A\00", align 1
@.str.104 = private unnamed_addr constant [36 x i8] c"        (declare-fun s2 () test_s)\0A\00", align 1
@.str.105 = private unnamed_addr constant [49 x i8] c"        ; state s2 is the successor of state s1\0A\00", align 1
@.str.106 = private unnamed_addr constant [33 x i8] c"        (assert (test_t s1 s2))\0A\00", align 1
@.str.107 = private unnamed_addr constant [60 x i8] c"        ; we are looking for a model with y non-zero in s1\0A\00", align 1
@.str.108 = private unnamed_addr constant [52 x i8] c"        (assert (distinct (|test_n y| s1) #b0000))\0A\00", align 1
@.str.109 = private unnamed_addr constant [56 x i8] c"        ; we are looking for a model with y zero in s2\0A\00", align 1
@.str.110 = private unnamed_addr constant [45 x i8] c"        (assert (= (|test_n y| s2) #b0000))\0A\00", align 1
@.str.111 = private unnamed_addr constant [34 x i8] c"        ; is there such a model?\0A\00", align 1
@.str.112 = private unnamed_addr constant [21 x i8] c"        (check-sat)\0A\00", align 1
