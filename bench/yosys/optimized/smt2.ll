@.str.83 = private unnamed_addr constant [37 x i8] c"    -solver-option <option> <value>\0A\00", align 1
@.str.84 = private unnamed_addr constant [81 x i8] c"        emit a `; yosys-smt2-solver-option` directive for yosys-smtbmc to write\0A\00", align 1
@.str.85 = private unnamed_addr constant [76 x i8] c"        the given option as a `(set-option ...)` command in the SMT-LIBv2.\0A\00", align 1
@.str.86 = private unnamed_addr constant [79 x i8] c"[1] For more information on SMT-LIBv2 visit http://smt-lib.org/ or read David\0A\00", align 1
@.str.87 = private unnamed_addr constant [72 x i8] c"R. Cok's tutorial: https://smtlib.github.io/jSMTLIB/SMTLIBTutorial.pdf\0A\00", align 1
@.str.88 = private unnamed_addr constant [77 x i8] c"---------------------------------------------------------------------------\0A\00", align 1
@.str.89 = private unnamed_addr constant [10 x i8] c"Example:\0A\00", align 1
@.str.90 = private unnamed_addr constant [78 x i8] c"Consider the following module (test.v). We want to prove that the output can\0A\00", align 1
@.str.91 = private unnamed_addr constant [57 x i8] c"never transition from a non-zero value to a zero value.\0A\00", align 1
@.str.92 = private unnamed_addr constant [53 x i8] c"        module test(input clk, output reg [3:0] y);\0A\00", align 1
@.str.93 = private unnamed_addr constant [33 x i8] c"          always @(posedge clk)\0A\00", align 1
@.str.94 = private unnamed_addr constant [33 x i8] c"            y <= (y << 1) | ^y;\0A\00", align 1
@.str.95 = private unnamed_addr constant [19 x i8] c"        endmodule\0A\00", align 1
@.str.96 = private unnamed_addr constant [61 x i8] c"For this proof we create the following template (test.tpl).\0A\00", align 1
@.str.97 = private unnamed_addr constant [42 x i8] c"        ; we need QF_UFBV for this proof\0A\00", align 1
@.str.98 = private unnamed_addr constant [29 x i8] c"        (set-logic QF_UFBV)\0A\00", align 1
@.str.99 = private unnamed_addr constant [47 x i8] c"        ; insert the auto-generated code here\0A\00", align 1
@.str.100 = private unnamed_addr constant [14 x i8] c"        %%%%\0A\00", align 1
