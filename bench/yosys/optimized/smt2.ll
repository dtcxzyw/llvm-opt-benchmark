@.str.88 = private unnamed_addr constant [72 x i8] c"R. Cok's tutorial: https://smtlib.github.io/jSMTLIB/SMTLIBTutorial.pdf\0A\00", align 1
@.str.89 = private unnamed_addr constant [77 x i8] c"---------------------------------------------------------------------------\0A\00", align 1
@.str.90 = private unnamed_addr constant [10 x i8] c"Example:\0A\00", align 1
@.str.91 = private unnamed_addr constant [78 x i8] c"Consider the following module (test.v). We want to prove that the output can\0A\00", align 1
@.str.92 = private unnamed_addr constant [57 x i8] c"never transition from a non-zero value to a zero value.\0A\00", align 1
@.str.93 = private unnamed_addr constant [53 x i8] c"        module test(input clk, output reg [3:0] y);\0A\00", align 1
@.str.94 = private unnamed_addr constant [33 x i8] c"          always @(posedge clk)\0A\00", align 1
@.str.95 = private unnamed_addr constant [33 x i8] c"            y <= (y << 1) | ^y;\0A\00", align 1
@.str.96 = private unnamed_addr constant [19 x i8] c"        endmodule\0A\00", align 1
@.str.97 = private unnamed_addr constant [61 x i8] c"For this proof we create the following template (test.tpl).\0A\00", align 1
@.str.98 = private unnamed_addr constant [42 x i8] c"        ; we need QF_UFBV for this proof\0A\00", align 1
@.str.99 = private unnamed_addr constant [29 x i8] c"        (set-logic QF_UFBV)\0A\00", align 1
@.str.100 = private unnamed_addr constant [47 x i8] c"        ; insert the auto-generated code here\0A\00", align 1
@.str.101 = private unnamed_addr constant [14 x i8] c"        %%%%\0A\00", align 1
@.str.102 = private unnamed_addr constant [49 x i8] c"        ; declare two state variables s1 and s2\0A\00", align 1
@.str.103 = private unnamed_addr constant [36 x i8] c"        (declare-fun s1 () test_s)\0A\00", align 1
@.str.104 = private unnamed_addr constant [36 x i8] c"        (declare-fun s2 () test_s)\0A\00", align 1
@.str.105 = private unnamed_addr constant [49 x i8] c"        ; state s2 is the successor of state s1\0A\00", align 1
@.str.106 = private unnamed_addr constant [33 x i8] c"        (assert (test_t s1 s2))\0A\00", align 1
@.str.107 = private unnamed_addr constant [60 x i8] c"        ; we are looking for a model with y non-zero in s1\0A\00", align 1
@.str.108 = private unnamed_addr constant [52 x i8] c"        (assert (distinct (|test_n y| s1) #b0000))\0A\00", align 1
@.str.109 = private unnamed_addr constant [56 x i8] c"        ; we are looking for a model with y zero in s2\0A\00", align 1
@.str.110 = private unnamed_addr constant [45 x i8] c"        (assert (= (|test_n y| s2) #b0000))\0A\00", align 1
@.str.111 = private unnamed_addr constant [34 x i8] c"        ; is there such a model?\0A\00", align 1
@.str.112 = private unnamed_addr constant [21 x i8] c"        (check-sat)\0A\00", align 1
@.str.113 = private unnamed_addr constant [74 x i8] c"The following yosys script will create a 'test.smt2' file for our proof:\0A\00", align 1
@.str.114 = private unnamed_addr constant [29 x i8] c"        read_verilog test.v\0A\00", align 1
@.str.115 = private unnamed_addr constant [52 x i8] c"        hierarchy -check; proc; opt; check -assert\0A\00", align 1
@.str.116 = private unnamed_addr constant [48 x i8] c"        write_smt2 -bv -tpl test.tpl test.smt2\0A\00", align 1
@.str.117 = private unnamed_addr constant [76 x i8] c"Running 'cvc4 test.smt2' will print 'unsat' because y can never transition\0A\00", align 1
@.str.118 = private unnamed_addr constant [43 x i8] c"from non-zero to zero in the test design.\0A\00", align 1
