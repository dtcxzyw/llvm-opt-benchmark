@.str.90 = private unnamed_addr constant [10 x i8] c"Example:\0A\00", align 1
@.str.91 = private unnamed_addr constant [78 x i8] c"Consider the following module (test.v). We want to prove that the output can\0A\00", align 1
@.str.92 = private unnamed_addr constant [57 x i8] c"never transition from a non-zero value to a zero value.\0A\00", align 1
@.str.93 = private unnamed_addr constant [53 x i8] c"        module test(input clk, output reg [3:0] y);\0A\00", align 1
@.str.94 = private unnamed_addr constant [33 x i8] c"          always @(posedge clk)\0A\00", align 1
@.str.95 = private unnamed_addr constant [33 x i8] c"            y <= (y << 1) | ^y;\0A\00", align 1
@.str.96 = private unnamed_addr constant [19 x i8] c"        endmodule\0A\00", align 1
@.str.97 = private unnamed_addr constant [61 x i8] c"For this proof we create the following template (test.tpl).\0A\00", align 1
