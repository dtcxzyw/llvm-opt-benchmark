@.str.233 = private unnamed_addr constant [925 x i8] c"module \\$divfloor (A, B, Y);\0A    \0A    parameter A_SIGNED = 0;\0A    parameter B_SIGNED = 0;\0A    parameter A_WIDTH = 0;\0A    parameter B_WIDTH = 0;\0A    parameter Y_WIDTH = 0;\0A    \0A    input [A_WIDTH-1:0] A;\0A    input [B_WIDTH-1:0] B;\0A    output [Y_WIDTH-1:0] Y;\0A    \0A    generate\0A        if (A_SIGNED && B_SIGNED) begin:BLOCK1\0A            localparam WIDTH =\0A                    A_WIDTH >= B_WIDTH && A_WIDTH >= Y_WIDTH ? A_WIDTH :\0A                    B_WIDTH >= A_WIDTH && B_WIDTH >= Y_WIDTH ? B_WIDTH : Y_WIDTH;\0A            wire [WIDTH:0] A_buf, B_buf, N_buf;\0A            assign A_buf = $signed(A);\0A            assign B_buf = $signed(B);\0A            assign N_buf = (A[A_WIDTH-1] == B[B_WIDTH-1]) || A == 0 ? A_buf : $signed(A_buf - (B[B_WIDTH-1] ? B_buf+1 : B_buf-1));\0A            assign Y = $signed(N_buf) / $signed(B_buf);\0A        end else begin:BLOCK2\0A            assign Y = A / B;\0A        end\0A    endgenerate\0A    \0Aendmodule\00", align 1
