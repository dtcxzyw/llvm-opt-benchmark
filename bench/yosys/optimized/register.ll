@.str.218 = private unnamed_addr constant [495 x i8] c"Multiply and accumulate.\0AA building block for summing any number of negated and unnegated signals\0Aand arithmetic products of pairs of signals. Cell port A concatenates pairs\0Aof signals to be multiplied together. When the second signal in a pair is zero\0Alength, a constant 1 is used instead as the second factor. Cell port B\0Aconcatenates 1-bit-wide signals to also be summed, such as \22carry in\22 in adders.\0ATypically created by the `alumacc` pass, which transforms $add and $mul\0Ainto $macc cells.\00", align 1
@.str.219 = private unnamed_addr constant [5293 x i8] c"module \\$macc (A, B, Y);\0A    \0A    parameter A_WIDTH = 0;\0A    parameter B_WIDTH = 0;\0A    parameter Y_WIDTH = 0;\0A    // CONFIG determines the layout of A, as explained below\0A    parameter CONFIG = 4'b0000;\0A    parameter CONFIG_WIDTH = 4;\0A    \0A    // In the terms used for this cell, there's mixed meanings for the term \22port\22. To disambiguate:\0A    // A cell port is for example the A input (it is constructed in C++ as cell->setPort(ID::A, ...))\0A    // Multiplier ports are pairs of multiplier inputs (\22factors\22).\0A    // If the second signal in such a pair is zero length, no multiplication is necessary, and the first signal is just added to the sum.\0A    input [A_WIDTH-1:0] A; // Cell port A is the concatenation of all arithmetic ports\0A    input [B_WIDTH-1:0] B; // Cell port B is the concatenation of single-bit unsigned signals to be also added to the sum\0A    output reg [Y_WIDTH-1:0] Y; // Output sum\0A    \0A    // Xilinx XSIM does not like $clog2() below..\0A    function integer my_clog2;\0A        input integer v;\0A        begin\0A            if (v > 0)\0A                v = v - 1;\0A            my_clog2 = 0;\0A            while (v) begin\0A                v = v >> 1;\0A                my_clog2 = my_clog2 + 1;\0A            end\0A        end\0A    endfunction\0A    \0A    // Bits that a factor's length field in CONFIG per factor in cell port A\0A    localparam integer num_bits = CONFIG[3:0] > 0 ? CONFIG[3:0] : 1;\0A    // Number of multiplier ports\0A    localparam integer num_ports = (CONFIG_WIDTH-4) / (2 + 2*num_bits);\0A    // Minium bit width of an induction variable to iterate over all bits of cell port A\0A    localparam integer num_abits = my_clog2(A_WIDTH) > 0 ? my_clog2(A_WIDTH) : 1;\0A    \0A    // In this pseudocode, u(foo) means an unsigned int that's foo bits long.\0A    // The CONFIG parameter carries the following information:\0A    //    struct CONFIG {\0A    //        u4 num_bits;\0A    //        struct port_field {\0A    //            bool is_signed;\0A    //            bool is_subtract;\0A    //            u(num_bits) factor1_len;\0A    //            u(num_bits) factor2_len;\0A    //        }[num_ports];\0A    //    };\0A    \0A    // The A cell port carries the following information:\0A    //    struct A {\0A    //        u(CONFIG.port_field[0].factor1_len) port0factor1;\0A    //        u(CONFIG.port_field[0].factor2_len) port0factor2;\0A    //        u(CONFIG.port_field[1].factor1_len) port1factor1;\0A    //        u(CONFIG.port_field[1].factor2_len) port1factor2;\0A    //        ...\0A    //    };\0A    // and log(sizeof(A)) is num_abits.\0A    // No factor1 may have a zero length.\0A    // A factor2 having a zero length implies factor2 is replaced with a constant 1.\0A    \0A    // Additionally, B is an array of 1-bit-wide unsigned integers to also be summed up.\0A    // Finally, we have:\0A    // Y = port0factor1 * port0factor2 + port1factor1 * port1factor2 + ...\0A    //     * B[0] + B[1] + ...\0A    \0A    function [2*num_ports*num_abits-1:0] get_port_offsets;\0A        input [CONFIG_WIDTH-1:0] cfg;\0A        integer i, cursor;\0A        begin\0A            cursor = 0;\0A            get_port_offsets = 0;\0A            for (i = 0; i < num_ports; i = i+1) begin\0A                get_port_offsets[(2*i + 0)*num_abits +: num_abits] = cursor;\0A                cursor = cursor + cfg[4 + i*(2 + 2*num_bits) + 2 +: num_bits];\0A                get_port_offsets[(2*i + 1)*num_abits +: num_abits] = cursor;\0A                cursor = cursor + cfg[4 + i*(2 + 2*num_bits) + 2 + num_bits +: num_bits];\0A            end\0A        end\0A    endfunction\0A    \0A    localparam [2*num_ports*num_abits-1:0] port_offsets = get_port_offsets(CONFIG);\0A    \0A    `define PORT_IS_SIGNED   (0 + CONFIG[4 + i*(2 + 2*num_bits)])\0A    `define PORT_DO_SUBTRACT (0 + CONFIG[4 + i*(2 + 2*num_bits) + 1])\0A    `define PORT_SIZE_A      (0 + CONFIG[4 + i*(2 + 2*num_bits) + 2 +: num_bits])\0A    `define PORT_SIZE_B      (0 + CONFIG[4 + i*(2 + 2*num_bits) + 2 + num_bits +: num_bits])\0A    `define PORT_OFFSET_A    (0 + port_offsets[2*i*num_abits +: num_abits])\0A    `define PORT_OFFSET_B    (0 + port_offsets[2*i*num_abits + num_abits +: num_abits])\0A    \0A    integer i, j;\0A    reg [Y_WIDTH-1:0] tmp_a, tmp_b;\0A    \0A    always @* begin\0A        Y = 0;\0A        for (i = 0; i < num_ports; i = i+1)\0A        begin\0A            tmp_a = 0;\0A            tmp_b = 0;\0A    \0A            for (j = 0; j < `PORT_SIZE_A; j = j+1)\0A                tmp_a[j] = A[`PORT_OFFSET_A + j];\0A    \0A            if (`PORT_IS_SIGNED && `PORT_SIZE_A > 0)\0A                for (j = `PORT_SIZE_A; j < Y_WIDTH; j = j+1)\0A                    tmp_a[j] = tmp_a[`PORT_SIZE_A-1];\0A    \0A            for (j = 0; j < `PORT_SIZE_B; j = j+1)\0A                tmp_b[j] = A[`PORT_OFFSET_B + j];\0A    \0A            if (`PORT_IS_SIGNED && `PORT_SIZE_B > 0)\0A                for (j = `PORT_SIZE_B; j < Y_WIDTH; j = j+1)\0A                    tmp_b[j] = tmp_b[`PORT_SIZE_B-1];\0A    \0A            if (`PORT_SIZE_B > 0)\0A                tmp_a = tmp_a * tmp_b;\0A    \0A            if (`PORT_DO_SUBTRACT)\0A                Y = Y - tmp_a;\0A            else\0A                Y = Y + tmp_a;\0A        end\0A        for (i = 0; i < B_WIDTH; i = i+1) begin\0A            Y = Y + B[i];\0A        end\0A    end\0A    \0A    `undef PORT_IS_SIGNED\0A    `undef PORT_DO_SUBTRACT\0A    `undef PORT_SIZE_A\0A    `undef PORT_SIZE_B\0A    `undef PORT_OFFSET_A\0A    `undef PORT_OFFSET_B\0A    \0Aendmodule\00", align 1
