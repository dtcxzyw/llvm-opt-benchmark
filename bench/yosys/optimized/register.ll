@.str.168 = private unnamed_addr constant [1633 x i8] c"module \\$alu (A, B, CI, BI, X, Y, CO);\0A    \0A    parameter A_SIGNED = 0;\0A    parameter B_SIGNED = 0;\0A    parameter A_WIDTH = 1;\0A    parameter B_WIDTH = 1;\0A    parameter Y_WIDTH = 1;\0A    \0A    input [A_WIDTH-1:0] A;      // Input operand\0A    input [B_WIDTH-1:0] B;      // Input operand\0A    output [Y_WIDTH-1:0] X;     // A xor B (sign-extended, optional B inversion,\0A                                //          used in combination with\0A                                //          reduction-AND for $eq/$ne ops)\0A    output [Y_WIDTH-1:0] Y;     // Sum\0A    \0A    input CI;                   // Carry-in (set for $sub)\0A    input BI;                   // Invert-B (set for $sub)\0A    output [Y_WIDTH-1:0] CO;    // Carry-out\0A    \0A    wire [Y_WIDTH-1:0] AA, BB;\0A    \0A    generate\0A        if (A_SIGNED && B_SIGNED) begin:BLOCK1\0A            assign AA = $signed(A), BB = BI ? ~$signed(B) : $signed(B);\0A        end else begin:BLOCK2\0A            assign AA = $unsigned(A), BB = BI ? ~$unsigned(B) : $unsigned(B);\0A        end\0A    endgenerate\0A    \0A    // this is 'x' if Y and CO should be all 'x', and '0' otherwise\0A    wire y_co_undef = ^{A, A, B, B, CI, CI, BI, BI};\0A    \0A    assign X = AA ^ BB;\0A    // Full adder\0A    assign Y = (AA + BB + CI) ^ {Y_WIDTH{y_co_undef}};\0A    \0A    function get_carry;\0A        input a, b, c;\0A        get_carry = (a&b) | (a&c) | (b&c);\0A    endfunction\0A    \0A    genvar i;\0A    generate\0A        assign CO[0] = get_carry(AA[0], BB[0], CI) ^ y_co_undef;\0A        for (i = 1; i < Y_WIDTH; i = i+1) begin:BLOCK3\0A            assign CO[i] = get_carry(AA[i], BB[i], CO[i-1]) ^ y_co_undef;\0A        end\0A    endgenerate\0A    \0Aendmodule\00", align 1
