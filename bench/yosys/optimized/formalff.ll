@.str.4 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.5 = private unnamed_addr constant [36 x i8] c"    formalff [options] [selection]\0A\00", align 1
@.str.6 = private unnamed_addr constant [72 x i8] c"This pass transforms clocked flip-flops to prepare a design for formal\0A\00", align 1
@.str.7 = private unnamed_addr constant [81 x i8] c"verification. If a design contains latches and/or multiple different clocks run\0A\00", align 1
@.str.8 = private unnamed_addr constant [62 x i8] c"the async2sync or clk2fflogic passes before using this pass.\0A\00", align 1
@.str.9 = private unnamed_addr constant [13 x i8] c"    -clk2ff\0A\00", align 1
@.str.10 = private unnamed_addr constant [77 x i8] c"        Replace all clocked flip-flops with $ff cells that use the implicit\0A\00", align 1
@.str.11 = private unnamed_addr constant [78 x i8] c"        global clock. This assumes, without checking, that the design uses a\0A\00", align 1
@.str.12 = private unnamed_addr constant [76 x i8] c"        single global clock. If that is not the case, the clk2fflogic pass\0A\00", align 1
@.str.13 = private unnamed_addr constant [33 x i8] c"        should be used instead.\0A\00", align 1
@.str.14 = private unnamed_addr constant [17 x i8] c"    -ff2anyinit\0A\00", align 1
@.str.15 = private unnamed_addr constant [73 x i8] c"        Replace uninitialized bits of $ff cells with $anyinit cells. An\0A\00", align 1
@.str.16 = private unnamed_addr constant [74 x i8] c"        $anyinit cell behaves exactly like an $ff cell with an undefined\0A\00", align 1
@.str.17 = private unnamed_addr constant [72 x i8] c"        initialization value. The difference is that $anyinit inhibits\0A\00", align 1
@.str.18 = private unnamed_addr constant [78 x i8] c"        don't-care optimizations and is used to track solver-provided values\0A\00", align 1
@.str.19 = private unnamed_addr constant [28 x i8] c"        in witness traces.\0A\00", align 1
@.str.20 = private unnamed_addr constant [77 x i8] c"        If combined with -clk2ff this also affects newly created $ff cells.\0A\00", align 1
@.str.21 = private unnamed_addr constant [17 x i8] c"    -anyinit2ff\0A\00", align 1
@.str.22 = private unnamed_addr constant [81 x i8] c"        Replaces $anyinit cells with uninitialized $ff cells. This performs the\0A\00", align 1
@.str.23 = private unnamed_addr constant [79 x i8] c"        reverse of -ff2anyinit and can be used, before running a backend pass\0A\00", align 1
@.str.24 = private unnamed_addr constant [63 x i8] c"        (or similar) that is not yet aware of $anyinit cells.\0A\00", align 1
@.str.25 = private unnamed_addr constant [80 x i8] c"        Note that after running -anyinit2ff, in general, performing don't-care\0A\00", align 1
@.str.26 = private unnamed_addr constant [70 x i8] c"        optimizations is not sound in a formal verification setting.\0A\00", align 1
@.str.27 = private unnamed_addr constant [11 x i8] c"    -fine\0A\00", align 1
@.str.28 = private unnamed_addr constant [79 x i8] c"        Emit fine-grained $_FF_ cells instead of coarse-grained $ff cells for\0A\00", align 1
@.str.29 = private unnamed_addr constant [70 x i8] c"        -anyinit2ff. Cannot be combined with -clk2ff or -ff2anyinit.\0A\00", align 1
@.str.30 = private unnamed_addr constant [15 x i8] c"    -setundef\0A\00", align 1
@.str.31 = private unnamed_addr constant [78 x i8] c"        Find FFs with undefined initialization values for which changing the\0A\00", align 1
@.str.32 = private unnamed_addr constant [79 x i8] c"        initialization does not change the observable behavior and initialize\0A\00", align 1
@.str.33 = private unnamed_addr constant [78 x i8] c"        them. For -ff2anyinit, this reduces the number of generated $anyinit\0A\00", align 1
@.str.34 = private unnamed_addr constant [52 x i8] c"        cells that drive wires with private names.\0A\00", align 1
@.str.35 = private unnamed_addr constant [16 x i8] c"    -hierarchy\0A\00", align 1
@.str.36 = private unnamed_addr constant [75 x i8] c"        Propagates the 'replaced_by_gclk' attribute set by clk2ff upwards\0A\00", align 1
@.str.37 = private unnamed_addr constant [79 x i8] c"        through the design hierarchy towards the toplevel inputs. This option\0A\00", align 1
@.str.38 = private unnamed_addr constant [62 x i8] c"        works on the whole design and ignores the selection.\0A\00", align 1
@.str.39 = private unnamed_addr constant [13 x i8] c"    -assume\0A\00", align 1
@.str.40 = private unnamed_addr constant [74 x i8] c"        Add assumptions that constrain wires with the 'replaced_by_gclk'\0A\00", align 1
@.str.41 = private unnamed_addr constant [77 x i8] c"        attribute to the value they would have before an active clock edge.\0A\00", align 1
@.str.42 = private unnamed_addr constant [26 x i8] c"Executing FORMALFF pass.\0A\00", align 1
@.str.43 = private unnamed_addr constant [8 x i8] c"-clk2ff\00", align 1
