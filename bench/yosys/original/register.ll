@.str.162 = private unnamed_addr constant [504 x i8] c"module \\$lcu (P, G, CI, CO);\0A    \0A    parameter WIDTH = 1;\0A    \0A    input [WIDTH-1:0] P;    // Propagate\0A    input [WIDTH-1:0] G;    // Generate\0A    input CI;               // Carry-in\0A    \0A    output reg [WIDTH-1:0] CO; // Carry-out\0A    \0A    integer i;\0A    always @* begin\0A        CO = 'bx;\0A        if (^{P, G, CI} !== 1'bx) begin\0A            CO[0] = G[0] || (P[0] && CI);\0A            for (i = 1; i < WIDTH; i = i+1)\0A                CO[i] = G[i] || (P[i] && CO[i-1]);\0A        end\0A    end\0A    \0Aendmodule\00", align 1
