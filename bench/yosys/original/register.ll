@.str.278 = private unnamed_addr constant [750 x i8] c"module \\$pmux (A, B, S, Y);\0A    \0A    parameter WIDTH = 0;\0A    parameter S_WIDTH = 0;\0A    \0A    input [WIDTH-1:0] A;\0A    input [WIDTH*S_WIDTH-1:0] B;\0A    input [S_WIDTH-1:0] S;\0A    output reg [WIDTH-1:0] Y;\0A    \0A    integer i;\0A    reg found_active_sel_bit;\0A    \0A    always @* begin\0A        Y = A;\0A        found_active_sel_bit = 0;\0A        for (i = 0; i < S_WIDTH; i = i+1)\0A            case (S[i])\0A                1'b1: begin\0A                    Y = found_active_sel_bit ? 'bx : B >> (WIDTH*i);\0A                    found_active_sel_bit = 1;\0A                end\0A                1'b0: ;\0A                1'bx: begin\0A                    Y = 'bx;\0A                    found_active_sel_bit = 'bx;\0A                end\0A            endcase\0A    end\0A    \0Aendmodule\00", align 1
