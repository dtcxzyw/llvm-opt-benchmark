@.str.237 = private unnamed_addr constant [1068 x i8] c"module \\$modfloor (A, B, Y);\0A    \0A    parameter A_SIGNED = 0;\0A    parameter B_SIGNED = 0;\0A    parameter A_WIDTH = 0;\0A    parameter B_WIDTH = 0;\0A    parameter Y_WIDTH = 0;\0A    \0A    input [A_WIDTH-1:0] A;\0A    input [B_WIDTH-1:0] B;\0A    output [Y_WIDTH-1:0] Y;\0A    \0A    generate\0A        if (A_SIGNED && B_SIGNED) begin:BLOCK1\0A            localparam WIDTH = B_WIDTH >= Y_WIDTH ? B_WIDTH : Y_WIDTH;\0A            wire [WIDTH-1:0] B_buf, Y_trunc;\0A            assign B_buf = $signed(B);\0A            assign Y_trunc = $signed(A) % $signed(B);\0A            // flooring mod is the same as truncating mod for positive division results (A and B have\0A            // the same sign), as well as when there's no remainder.\0A            // For all other cases, they behave as `floor - trunc = B`\0A            assign Y = (A[A_WIDTH-1] == B[B_WIDTH-1]) || Y_trunc == 0 ? Y_trunc : $signed(B_buf) + $signed(Y_trunc);\0A        end else begin:BLOCK2\0A            // no difference between truncating and flooring for unsigned\0A            assign Y = A % B;\0A        end\0A    endgenerate\0A    \0Aendmodule\00", align 1
