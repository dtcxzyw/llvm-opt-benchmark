@.str.34 = private unnamed_addr constant [76 x i8] c"        graph still is ambiguous. A seed of zero deactivates the coloring.\0A\00", align 1
@.str.35 = private unnamed_addr constant [33 x i8] c"    -colorattr <attribute_name>\0A\00", align 1
@.str.36 = private unnamed_addr constant [73 x i8] c"        Use the specified attribute to assign colors. A unique color is\0A\00", align 1
