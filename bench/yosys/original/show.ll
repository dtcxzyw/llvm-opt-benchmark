@.str.3 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.4 = private unnamed_addr constant [32 x i8] c"    show [options] [selection]\0A\00", align 1
@.str.5 = private unnamed_addr constant [79 x i8] c"Create a graphviz DOT file for the selected part of the design and compile it\0A\00", align 1
@.str.6 = private unnamed_addr constant [49 x i8] c"to a graphics file (usually SVG or PostScript).\0A\00", align 1
@.str.7 = private unnamed_addr constant [22 x i8] c"    -viewer <viewer>\0A\00", align 1
@.str.8 = private unnamed_addr constant [72 x i8] c"        Run the specified command with the graphics file as parameter.\0A\00", align 1
@.str.9 = private unnamed_addr constant [63 x i8] c"        On Windows, this pauses yosys until the viewer exits.\0A\00", align 1
@.str.10 = private unnamed_addr constant [52 x i8] c"        Use \22-viewer none\22 to not run any command.\0A\00", align 1
@.str.11 = private unnamed_addr constant [22 x i8] c"    -format <format>\0A\00", align 1
@.str.12 = private unnamed_addr constant [77 x i8] c"        Generate a graphics file in the specified format. Use 'dot' to just\0A\00", align 1
@.str.13 = private unnamed_addr constant [79 x i8] c"        generate a .dot file, or other <format> strings such as 'svg' or 'ps'\0A\00", align 1
@.str.14 = private unnamed_addr constant [76 x i8] c"        to generate files in other formats (this calls the 'dot' command).\0A\00", align 1
@.str.15 = private unnamed_addr constant [34 x i8] c"    -lib <verilog_or_rtlil_file>\0A\00", align 1
@.str.16 = private unnamed_addr constant [79 x i8] c"        Use the specified library file for determining whether cell ports are\0A\00", align 1
@.str.17 = private unnamed_addr constant [78 x i8] c"        inputs or outputs. This option can be used multiple times to specify\0A\00", align 1
@.str.18 = private unnamed_addr constant [32 x i8] c"        more than one library.\0A\00", align 1
@.str.19 = private unnamed_addr constant [77 x i8] c"        note: in most cases it is better to load the library before calling\0A\00", align 1
@.str.20 = private unnamed_addr constant [74 x i8] c"        show with 'read_verilog -lib <filename>'. it is also possible to\0A\00", align 1
@.str.21 = private unnamed_addr constant [65 x i8] c"        load liberty files with 'read_liberty -lib <filename>'.\0A\00", align 1
@.str.22 = private unnamed_addr constant [22 x i8] c"    -prefix <prefix>\0A\00", align 1
@.str.23 = private unnamed_addr constant [56 x i8] c"        generate <prefix>.* instead of ~/.yosys_show.*\0A\00", align 1
@.str.24 = private unnamed_addr constant [29 x i8] c"    -color <color> <object>\0A\00", align 1
@.str.25 = private unnamed_addr constant [79 x i8] c"        assign the specified color to the specified object. The object can be\0A\00", align 1
@.str.26 = private unnamed_addr constant [78 x i8] c"        a single selection wildcard expressions or a saved set of objects in\0A\00", align 1
@.str.27 = private unnamed_addr constant [61 x i8] c"        the @<name> syntax (see \22help select\22 for details).\0A\00", align 1
@.str.28 = private unnamed_addr constant [28 x i8] c"    -label <text> <object>\0A\00", align 1
@.str.29 = private unnamed_addr constant [81 x i8] c"        assign the specified label text to the specified object. The object can\0A\00", align 1
@.str.30 = private unnamed_addr constant [81 x i8] c"        be a single selection wildcard expressions or a saved set of objects in\0A\00", align 1
@.str.31 = private unnamed_addr constant [20 x i8] c"    -colors <seed>\0A\00", align 1
