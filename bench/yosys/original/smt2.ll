@.str.108 = private unnamed_addr constant [56 x i8] c"        ; we are looking for a model with y zero in s2\0A\00", align 1
@.str.109 = private unnamed_addr constant [45 x i8] c"        (assert (= (|test_n y| s2) #b0000))\0A\00", align 1
