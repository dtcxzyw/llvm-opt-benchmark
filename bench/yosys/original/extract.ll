@.str.3 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.4 = private unnamed_addr constant [51 x i8] c"    extract -map <map_file> [options] [selection]\0A\00", align 1
@.str.5 = private unnamed_addr constant [52 x i8] c"    extract -mine <out_file> [options] [selection]\0A\00", align 1
@.str.6 = private unnamed_addr constant [75 x i8] c"This pass looks for subcircuits that are isomorphic to any of the modules\0A\00", align 1
@.str.7 = private unnamed_addr constant [77 x i8] c"in the given map file and replaces them with instances of this modules. The\0A\00", align 1
@.str.8 = private unnamed_addr constant [77 x i8] c"map file can be a Verilog source file (*.v) or an RTLIL source file (*.il).\0A\00", align 1
@.str.9 = private unnamed_addr constant [21 x i8] c"    -map <map_file>\0A\00", align 1
@.str.10 = private unnamed_addr constant [76 x i8] c"        use the modules in this file as reference. This option can be used\0A\00", align 1
@.str.11 = private unnamed_addr constant [25 x i8] c"        multiple times.\0A\00", align 1
@.str.12 = private unnamed_addr constant [26 x i8] c"    -map %%<design-name>\0A\00", align 1
@.str.13 = private unnamed_addr constant [80 x i8] c"        use the modules in this in-memory design as reference. This option can\0A\00", align 1
@.str.14 = private unnamed_addr constant [33 x i8] c"        be used multiple times.\0A\00", align 1
@.str.15 = private unnamed_addr constant [14 x i8] c"    -verbose\0A\00", align 1
@.str.16 = private unnamed_addr constant [44 x i8] c"        print debug output while analyzing\0A\00", align 1
@.str.17 = private unnamed_addr constant [17 x i8] c"    -constports\0A\00", align 1
@.str.18 = private unnamed_addr constant [69 x i8] c"        also find instances with constant drivers. this may be much\0A\00", align 1
@.str.19 = private unnamed_addr constant [43 x i8] c"        slower than the normal operation.\0A\00", align 1
@.str.20 = private unnamed_addr constant [21 x i8] c"    -nodefaultswaps\0A\00", align 1
@.str.21 = private unnamed_addr constant [78 x i8] c"        normally builtin port swapping rules for internal cells are used per\0A\00", align 1
@.str.22 = private unnamed_addr constant [74 x i8] c"        default. This turns that off, so e.g. 'a^b' does not match 'b^a'\0A\00", align 1
@.str.23 = private unnamed_addr constant [35 x i8] c"        when this option is used.\0A\00", align 1
@.str.24 = private unnamed_addr constant [43 x i8] c"    -compat <needle_type> <haystack_type>\0A\00", align 1
@.str.25 = private unnamed_addr constant [71 x i8] c"        Per default, the cells in the map file (needle) must have the\0A\00", align 1
@.str.26 = private unnamed_addr constant [72 x i8] c"        type as the cells in the active design (haystack). This option\0A\00", align 1
@.str.27 = private unnamed_addr constant [71 x i8] c"        can be used to register additional pairs of types that should\0A\00", align 1
@.str.28 = private unnamed_addr constant [56 x i8] c"        match. This option can be used multiple times.\0A\00", align 1
@.str.29 = private unnamed_addr constant [47 x i8] c"    -swap <needle_type> <port1>,<port2>[,...]\0A\00", align 1
@.str.30 = private unnamed_addr constant [67 x i8] c"        Register a set of swappable ports for a needle cell type.\0A\00", align 1
@.str.31 = private unnamed_addr constant [49 x i8] c"        This option can be used multiple times.\0A\00", align 1
@.str.32 = private unnamed_addr constant [69 x i8] c"    -perm <needle_type> <port1>,<port2>[,...] <portA>,<portB>[,...]\0A\00", align 1
@.str.33 = private unnamed_addr constant [70 x i8] c"        Register a valid permutation of swappable ports for a needle\0A\00", align 1
@.str.34 = private unnamed_addr constant [60 x i8] c"        cell type. This option can be used multiple times.\0A\00", align 1
@.str.35 = private unnamed_addr constant [33 x i8] c"    -cell_attr <attribute_name>\0A\00", align 1
@.str.36 = private unnamed_addr constant [61 x i8] c"        Attributes on cells with the given name must match.\0A\00", align 1
@.str.37 = private unnamed_addr constant [33 x i8] c"    -wire_attr <attribute_name>\0A\00", align 1
@.str.38 = private unnamed_addr constant [61 x i8] c"        Attributes on wires with the given name must match.\0A\00", align 1
@.str.39 = private unnamed_addr constant [24 x i8] c"    -ignore_parameters\0A\00", align 1
@.str.40 = private unnamed_addr constant [52 x i8] c"        Do not use parameters when matching cells.\0A\00", align 1
@.str.41 = private unnamed_addr constant [48 x i8] c"    -ignore_param <cell_type> <parameter_name>\0A\00", align 1
@.str.42 = private unnamed_addr constant [56 x i8] c"        Do not use this parameter when matching cells.\0A\00", align 1
@.str.43 = private unnamed_addr constant [73 x i8] c"This pass does not operate on modules with unprocessed processes in it.\0A\00", align 1
@.str.44 = private unnamed_addr constant [79 x i8] c"(I.e. the 'proc' pass should be used first to convert processes to netlists.)\0A\00", align 1
@.str.45 = private unnamed_addr constant [78 x i8] c"This pass can also be used for mining for frequent subcircuits. In this mode\0A\00", align 1
@.str.46 = private unnamed_addr constant [66 x i8] c"the following options are to be used instead of the -map option.\0A\00", align 1
@.str.47 = private unnamed_addr constant [22 x i8] c"    -mine <out_file>\0A\00", align 1
@.str.48 = private unnamed_addr constant [78 x i8] c"        mine for frequent subcircuits and write them to the given RTLIL file\0A\00", align 1
@.str.49 = private unnamed_addr constant [34 x i8] c"    -mine_cells_span <min> <max>\0A\00", align 1
@.str.50 = private unnamed_addr constant [70 x i8] c"        only mine for subcircuits with the specified number of cells\0A\00", align 1
@.str.51 = private unnamed_addr constant [28 x i8] c"        default value: 3 5\0A\00", align 1
@.str.52 = private unnamed_addr constant [26 x i8] c"    -mine_min_freq <num>\0A\00", align 1
@.str.53 = private unnamed_addr constant [81 x i8] c"        only mine for subcircuits with at least the specified number of matches\0A\00", align 1
@.str.54 = private unnamed_addr constant [27 x i8] c"        default value: 10\0A\00", align 1
@.str.55 = private unnamed_addr constant [42 x i8] c"    -mine_limit_matches_per_module <num>\0A\00", align 1
@.str.56 = private unnamed_addr constant [78 x i8] c"        when calculating the number of matches for a subcircuit, don't count\0A\00", align 1
@.str.57 = private unnamed_addr constant [62 x i8] c"        more than the specified number of matches per module\0A\00", align 1
@.str.58 = private unnamed_addr constant [28 x i8] c"    -mine_max_fanout <num>\0A\00", align 1
@.str.59 = private unnamed_addr constant [74 x i8] c"        don't consider internal signals with more than <num> connections\0A\00", align 1
