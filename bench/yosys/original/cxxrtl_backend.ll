@.str.3 = private unnamed_addr constant [2 x i8] c"\0A\00", align 1
@.str.4 = private unnamed_addr constant [39 x i8] c"    write_cxxrtl [options] [filename]\0A\00", align 1
@.str.5 = private unnamed_addr constant [80 x i8] c"Write C++ code that simulates the design. The generated code requires a driver\0A\00", align 1
@.str.6 = private unnamed_addr constant [80 x i8] c"that instantiates the design, toggles its clock, and interacts with its ports.\0A\00", align 1
@.str.7 = private unnamed_addr constant [81 x i8] c"The following driver may be used as an example for a design with a single clock\0A\00", align 1
@.str.8 = private unnamed_addr constant [43 x i8] c"driving rising edge triggered flip-flops:\0A\00", align 1
@.str.9 = private unnamed_addr constant [23 x i8] c"    #include \22top.cc\22\0A\00", align 1
@.str.10 = private unnamed_addr constant [18 x i8] c"    int main() {\0A\00", align 1
@.str.11 = private unnamed_addr constant [33 x i8] c"      cxxrtl_design::p_top top;\0A\00", align 1
@.str.12 = private unnamed_addr constant [19 x i8] c"      top.step();\0A\00", align 1
@.str.13 = private unnamed_addr constant [19 x i8] c"      while (1) {\0A\00", align 1
@.str.14 = private unnamed_addr constant [26 x i8] c"        /* user logic */\0A\00", align 1
@.str.15 = private unnamed_addr constant [31 x i8] c"        top.p_clk.set(false);\0A\00", align 1
@.str.16 = private unnamed_addr constant [21 x i8] c"        top.step();\0A\00", align 1
@.str.17 = private unnamed_addr constant [30 x i8] c"        top.p_clk.set(true);\0A\00", align 1
@.str.18 = private unnamed_addr constant [9 x i8] c"      }\0A\00", align 1
@.str.19 = private unnamed_addr constant [7 x i8] c"    }\0A\00", align 1
@.str.20 = private unnamed_addr constant [79 x i8] c"Note that CXXRTL simulations, just like the hardware they are simulating, are\0A\00", align 1
@.str.21 = private unnamed_addr constant [80 x i8] c"subject to race conditions. If, in the example above, the user logic would run\0A\00", align 1
@.str.22 = private unnamed_addr constant [81 x i8] c"simultaneously with the rising edge of the clock, the design would malfunction.\0A\00", align 1
@.str.23 = private unnamed_addr constant [82 x i8] c"This backend supports replacing parts of the design with black boxes implemented\0A\00", align 1
@.str.24 = private unnamed_addr constant [82 x i8] c"in C++. If a module marked as a CXXRTL black box, its implementation is ignored,\0A\00", align 1
@.str.25 = private unnamed_addr constant [78 x i8] c"and the generated code consists only of an interface and a factory function.\0A\00", align 1
@.str.26 = private unnamed_addr constant [82 x i8] c"The driver must implement the factory function that creates an implementation of\0A\00", align 1
@.str.27 = private unnamed_addr constant [76 x i8] c"the black box, taking into account the parameters it is instantiated with.\0A\00", align 1
@.str.28 = private unnamed_addr constant [82 x i8] c"For example, the following Verilog code defines a CXXRTL black box interface for\0A\00", align 1
@.str.29 = private unnamed_addr constant [27 x i8] c"a synchronous debug sink:\0A\00", align 1
@.str.30 = private unnamed_addr constant [27 x i8] c"    (* cxxrtl_blackbox *)\0A\00", align 1
@.str.31 = private unnamed_addr constant [24 x i8] c"    module debug(...);\0A\00", align 1
@.str.32 = private unnamed_addr constant [42 x i8] c"      (* cxxrtl_edge = \22p\22 *) input clk;\0A\00", align 1
@.str.33 = private unnamed_addr constant [17 x i8] c"      input en;\0A\00", align 1
@.str.34 = private unnamed_addr constant [27 x i8] c"      input [7:0] i_data;\0A\00", align 1
@.str.35 = private unnamed_addr constant [46 x i8] c"      (* cxxrtl_sync *) output [7:0] o_data;\0A\00", align 1
@.str.36 = private unnamed_addr constant [15 x i8] c"    endmodule\0A\00", align 1
@.str.37 = private unnamed_addr constant [81 x i8] c"For this HDL interface, this backend will generate the following C++ interface:\0A\00", align 1
@.str.38 = private unnamed_addr constant [41 x i8] c"    struct bb_p_debug : public module {\0A\00", align 1
@.str.39 = private unnamed_addr constant [23 x i8] c"      value<1> p_clk;\0A\00", align 1
@.str.40 = private unnamed_addr constant [48 x i8] c"      bool posedge_p_clk() const { /* ... */ }\0A\00", align 1
@.str.41 = private unnamed_addr constant [22 x i8] c"      value<1> p_en;\0A\00", align 1
@.str.42 = private unnamed_addr constant [26 x i8] c"      value<8> p_i_data;\0A\00", align 1
@.str.43 = private unnamed_addr constant [25 x i8] c"      wire<8> p_o_data;\0A\00", align 1
@.str.44 = private unnamed_addr constant [49 x i8] c"      bool eval(performer *performer) override;\0A\00", align 1
@.str.45 = private unnamed_addr constant [48 x i8] c"      virtual bool commit(observer &observer);\0A\00", align 1
@.str.46 = private unnamed_addr constant [31 x i8] c"      bool commit() override;\0A\00", align 1
@.str.47 = private unnamed_addr constant [42 x i8] c"      static std::unique_ptr<bb_p_debug>\0A\00", align 1
@.str.48 = private unnamed_addr constant [83 x i8] c"      create(std::string name, metadata_map parameters, metadata_map attributes);\0A\00", align 1
@.str.49 = private unnamed_addr constant [8 x i8] c"    };\0A\00", align 1
@.str.50 = private unnamed_addr constant [80 x i8] c"The `create' function must be implemented by the driver. For example, it could\0A\00", align 1
@.str.51 = private unnamed_addr constant [79 x i8] c"always provide an implementation logging the values to standard error stream:\0A\00", align 1
@.str.52 = private unnamed_addr constant [31 x i8] c"    namespace cxxrtl_design {\0A\00", align 1
@.str.53 = private unnamed_addr constant [47 x i8] c"    struct stderr_debug : public bb_p_debug {\0A\00", align 1
@.str.54 = private unnamed_addr constant [50 x i8] c"      bool eval(performer *performer) override {\0A\00", align 1
@.str.55 = private unnamed_addr constant [38 x i8] c"        if (posedge_p_clk() && p_en)\0A\00", align 1
@.str.56 = private unnamed_addr constant [64 x i8] c"          fprintf(stderr, \22debug: %%02x\\n\22, p_i_data.data[0]);\0A\00", align 1
@.str.57 = private unnamed_addr constant [35 x i8] c"        p_o_data.next = p_i_data;\0A\00", align 1
@.str.58 = private unnamed_addr constant [45 x i8] c"        return bb_p_debug::eval(performer);\0A\00", align 1
@.str.59 = private unnamed_addr constant [33 x i8] c"    std::unique_ptr<bb_p_debug>\0A\00", align 1
@.str.60 = private unnamed_addr constant [75 x i8] c"    bb_p_debug::create(std::string name, cxxrtl::metadata_map parameters,\0A\00", align 1
@.str.61 = private unnamed_addr constant [59 x i8] c"                       cxxrtl::metadata_map attributes) {\0A\00", align 1
@.str.62 = private unnamed_addr constant [48 x i8] c"      return std::make_unique<stderr_debug>();\0A\00", align 1
@.str.63 = private unnamed_addr constant [79 x i8] c"For complex applications of black boxes, it is possible to parameterize their\0A\00", align 1
@.str.64 = private unnamed_addr constant [81 x i8] c"port widths. For example, the following Verilog code defines a CXXRTL black box\0A\00", align 1
@.str.65 = private unnamed_addr constant [48 x i8] c"interface for a configurable width debug sink:\0A\00", align 1
@.str.66 = private unnamed_addr constant [54 x i8] c"    (* cxxrtl_blackbox, cxxrtl_template = \22WIDTH\22 *)\0A\00", align 1
@.str.67 = private unnamed_addr constant [28 x i8] c"      parameter WIDTH = 8;\0A\00", align 1
@.str.68 = private unnamed_addr constant [64 x i8] c"      (* cxxrtl_width = \22WIDTH\22 *) input [WIDTH - 1:0] i_data;\0A\00", align 1
@.str.69 = private unnamed_addr constant [65 x i8] c"      (* cxxrtl_width = \22WIDTH\22 *) output [WIDTH - 1:0] o_data;\0A\00", align 1
@.str.70 = private unnamed_addr constant [81 x i8] c"For this parametric HDL interface, this backend will generate the following C++\0A\00", align 1
@.str.71 = private unnamed_addr constant [45 x i8] c"interface (only the differences are shown):\0A\00", align 1
@.str.72 = private unnamed_addr constant [28 x i8] c"    template<size_t WIDTH>\0A\00", align 1
@.str.73 = private unnamed_addr constant [14 x i8] c"      // ...\0A\00", align 1
@.str.74 = private unnamed_addr constant [30 x i8] c"      value<WIDTH> p_i_data;\0A\00", align 1
@.str.75 = private unnamed_addr constant [29 x i8] c"      wire<WIDTH> p_o_data;\0A\00", align 1
@.str.76 = private unnamed_addr constant [49 x i8] c"      static std::unique_ptr<bb_p_debug<WIDTH>>\0A\00", align 1
@.str.77 = private unnamed_addr constant [80 x i8] c"The `create' function must be implemented by the driver, specialized for every\0A\00", align 1
@.str.78 = private unnamed_addr constant [78 x i8] c"possible combination of template parameters. (Specialization is necessary to\0A\00", align 1
@.str.79 = private unnamed_addr constant [79 x i8] c"enable separate compilation of generated code and black box implementations.)\0A\00", align 1
@.str.80 = private unnamed_addr constant [27 x i8] c"    template<size_t SIZE>\0A\00", align 1
@.str.81 = private unnamed_addr constant [53 x i8] c"    struct stderr_debug : public bb_p_debug<SIZE> {\0A\00", align 1
@.str.82 = private unnamed_addr constant [16 x i8] c"    template<>\0A\00", align 1
@.str.83 = private unnamed_addr constant [36 x i8] c"    std::unique_ptr<bb_p_debug<8>>\0A\00", align 1
@.str.84 = private unnamed_addr constant [78 x i8] c"    bb_p_debug<8>::create(std::string name, cxxrtl::metadata_map parameters,\0A\00", align 1
@.str.85 = private unnamed_addr constant [62 x i8] c"                          cxxrtl::metadata_map attributes) {\0A\00", align 1
@.str.86 = private unnamed_addr constant [51 x i8] c"      return std::make_unique<stderr_debug<8>>();\0A\00", align 1
@.str.87 = private unnamed_addr constant [58 x i8] c"The following attributes are recognized by this backend:\0A\00", align 1
@.str.88 = private unnamed_addr constant [21 x i8] c"    cxxrtl_blackbox\0A\00", align 1
@.str.89 = private unnamed_addr constant [79 x i8] c"        only valid on modules. if specified, the module contents are ignored,\0A\00", align 1
@.str.90 = private unnamed_addr constant [81 x i8] c"        and the generated code includes only the module interface and a factory\0A\00", align 1
@.str.91 = private unnamed_addr constant [67 x i8] c"        function, which will be called to instantiate the module.\0A\00", align 1
@.str.92 = private unnamed_addr constant [17 x i8] c"    cxxrtl_edge\0A\00", align 1
@.str.93 = private unnamed_addr constant [76 x i8] c"        only valid on inputs of black boxes. must be one of \22p\22, \22n\22, \22a\22.\0A\00", align 1
@.str.94 = private unnamed_addr constant [82 x i8] c"        if specified on signal `clk`, the generated code includes edge detectors\0A\00", align 1
@.str.95 = private unnamed_addr constant [77 x i8] c"        `posedge_p_clk()` (if \22p\22), `negedge_p_clk()` (if \22n\22), or both (if\0A\00", align 1
@.str.96 = private unnamed_addr constant [66 x i8] c"        \22a\22), simplifying implementation of clocked black boxes.\0A\00", align 1
@.str.97 = private unnamed_addr constant [21 x i8] c"    cxxrtl_template\0A\00", align 1
@.str.98 = private unnamed_addr constant [79 x i8] c"        only valid on black boxes. must contain a space separated sequence of\0A\00", align 1
@.str.99 = private unnamed_addr constant [78 x i8] c"        identifiers that have a corresponding black box parameters. for each\0A\00", align 1
@.str.100 = private unnamed_addr constant [77 x i8] c"        of them, the generated code includes a `size_t` template parameter.\0A\00", align 1
@.str.101 = private unnamed_addr constant [18 x i8] c"    cxxrtl_width\0A\00", align 1
@.str.102 = private unnamed_addr constant [82 x i8] c"        only valid on ports of black boxes. must be a constant expression, which\0A\00", align 1
@.str.103 = private unnamed_addr constant [51 x i8] c"        is directly inserted into generated code.\0A\00", align 1
@.str.104 = private unnamed_addr constant [30 x i8] c"    cxxrtl_comb, cxxrtl_sync\0A\00", align 1
@.str.105 = private unnamed_addr constant [82 x i8] c"        only valid on outputs of black boxes. if specified, indicates that every\0A\00", align 1
@.str.106 = private unnamed_addr constant [80 x i8] c"        bit of the output port is driven, correspondingly, by combinatorial or\0A\00", align 1
@.str.107 = private unnamed_addr constant [81 x i8] c"        synchronous logic. this knowledge is used for scheduling optimizations.\0A\00", align 1
@.str.108 = private unnamed_addr constant [80 x i8] c"        if neither is specified, the output will be pessimistically treated as\0A\00", align 1
@.str.109 = private unnamed_addr constant [61 x i8] c"        driven by both combinatorial and synchronous logic.\0A\00", align 1
@.str.110 = private unnamed_addr constant [54 x i8] c"The following options are supported by this backend:\0A\00", align 1
@.str.111 = private unnamed_addr constant [48 x i8] c"    -print-wire-types, -print-debug-wire-types\0A\00", align 1
@.str.112 = private unnamed_addr constant [63 x i8] c"        enable additional debug logging, for pass developers.\0A\00", align 1
@.str.113 = private unnamed_addr constant [13 x i8] c"    -header\0A\00", align 1
@.str.114 = private unnamed_addr constant [74 x i8] c"        generate separate interface (.h) and implementation (.cc) files.\0A\00", align 1
@.str.115 = private unnamed_addr constant [80 x i8] c"        if specified, the backend must be called with a filename, and filename\0A\00", align 1
@.str.116 = private unnamed_addr constant [74 x i8] c"        of the interface is derived from filename of the implementation.\0A\00", align 1
@.str.117 = private unnamed_addr constant [73 x i8] c"        otherwise, interface and implementation are generated together.\0A\00", align 1
@.str.118 = private unnamed_addr constant [26 x i8] c"    -namespace <ns-name>\0A\00", align 1
@.str.119 = private unnamed_addr constant [78 x i8] c"        place the generated code into namespace <ns-name>. if not specified,\0A\00", align 1
@.str.120 = private unnamed_addr constant [34 x i8] c"        \22cxxrtl_design\22 is used.\0A\00", align 1
@.str.121 = private unnamed_addr constant [28 x i8] c"    -print-output <stream>\0A\00", align 1
@.str.122 = private unnamed_addr constant [77 x i8] c"        $print cells in the generated code direct their output to <stream>.\0A\00", align 1
@.str.123 = private unnamed_addr constant [68 x i8] c"        must be one of \22std::cout\22, \22std::cerr\22. if not specified,\0A\00", align 1
@.str.124 = private unnamed_addr constant [76 x i8] c"        \22std::cout\22 is used. explicitly provided performer overrides this.\0A\00", align 1
@.str.125 = private unnamed_addr constant [18 x i8] c"    -nohierarchy\0A\00", align 1
@.str.126 = private unnamed_addr constant [77 x i8] c"        use design hierarchy as-is. in most designs, a top module should be\0A\00", align 1
@.str.127 = private unnamed_addr constant [79 x i8] c"        present as it is exposed through the C API and has unbuffered outputs\0A\00", align 1
@.str.128 = private unnamed_addr constant [82 x i8] c"        for improved performance; it will be determined automatically if absent.\0A\00", align 1
@.str.129 = private unnamed_addr constant [16 x i8] c"    -noflatten\0A\00", align 1
@.str.130 = private unnamed_addr constant [79 x i8] c"        don't flatten the design. fully flattened designs can evaluate within\0A\00", align 1
@.str.131 = private unnamed_addr constant [65 x i8] c"        one delta cycle if they have no combinatorial feedback.\0A\00", align 1
@.str.132 = private unnamed_addr constant [80 x i8] c"        note that the debug interface and waveform dumps use full hierarchical\0A\00", align 1
@.str.133 = private unnamed_addr constant [56 x i8] c"        names for all wires even in flattened designs.\0A\00", align 1
@.str.134 = private unnamed_addr constant [13 x i8] c"    -noproc\0A\00", align 1
@.str.135 = private unnamed_addr constant [74 x i8] c"        don't convert processes to netlists. in most designs, converting\0A\00", align 1
@.str.136 = private unnamed_addr constant [80 x i8] c"        processes significantly improves evaluation performance at the cost of\0A\00", align 1
@.str.137 = private unnamed_addr constant [46 x i8] c"        slight increase in compilation time.\0A\00", align 1
@.str.138 = private unnamed_addr constant [16 x i8] c"    -O <level>\0A\00", align 1
@.str.139 = private unnamed_addr constant [78 x i8] c"        set the optimization level. the default is -O%d. higher optimization\0A\00", align 1
@.str.140 = private unnamed_addr constant [78 x i8] c"        levels dramatically decrease compile and run time, and highest level\0A\00", align 1
@.str.141 = private unnamed_addr constant [47 x i8] c"        possible for a design should be used.\0A\00", align 1
@.str.142 = private unnamed_addr constant [9 x i8] c"    -O0\0A\00", align 1
@.str.143 = private unnamed_addr constant [26 x i8] c"        no optimization.\0A\00", align 1
@.str.144 = private unnamed_addr constant [46 x i8] c"        unbuffer internal wires if possible.\0A\00", align 1
@.str.145 = private unnamed_addr constant [60 x i8] c"        like -O0, and localize internal wires if possible.\0A\00", align 1
@.str.146 = private unnamed_addr constant [58 x i8] c"        like -O0, and inline internal wires if possible.\0A\00", align 1
@.str.147 = private unnamed_addr constant [9 x i8] c"    -O4\0A\00", align 1
@.str.148 = private unnamed_addr constant [78 x i8] c"        like -O0, and unbuffer public wires not marked (*keep*) if possible.\0A\00", align 1
@.str.149 = private unnamed_addr constant [9 x i8] c"    -O5\0A\00", align 1
@.str.150 = private unnamed_addr constant [78 x i8] c"        like -O4, and localize public wires not marked (*keep*) if possible.\0A\00", align 1
@.str.151 = private unnamed_addr constant [9 x i8] c"    -O6\0A\00", align 1
@.str.152 = private unnamed_addr constant [76 x i8] c"        like -O5, and inline public wires not marked (*keep*) if possible.\0A\00", align 1
@.str.153 = private unnamed_addr constant [16 x i8] c"    -g <level>\0A\00", align 1
@.str.154 = private unnamed_addr constant [79 x i8] c"        set the debug level. the default is -g%d. higher debug levels provide\0A\00", align 1
@.str.155 = private unnamed_addr constant [82 x i8] c"        more visibility and generate more code, but do not pessimize evaluation.\0A\00", align 1
@.str.156 = private unnamed_addr constant [9 x i8] c"    -g0\0A\00", align 1
@.str.157 = private unnamed_addr constant [54 x i8] c"        no debug information. the C API is disabled.\0A\00", align 1
@.str.158 = private unnamed_addr constant [9 x i8] c"    -g1\0A\00", align 1
@.str.159 = private unnamed_addr constant [82 x i8] c"        include bare minimum of debug information necessary to access all design\0A\00", align 1
@.str.160 = private unnamed_addr constant [38 x i8] c"        state. the C API is enabled.\0A\00", align 1
@.str.161 = private unnamed_addr constant [9 x i8] c"    -g2\0A\00", align 1
@.str.162 = private unnamed_addr constant [79 x i8] c"        like -g1, but include debug information for all public wires that are\0A\00", align 1
@.str.163 = private unnamed_addr constant [56 x i8] c"        directly accessible through the C++ interface.\0A\00", align 1
@.str.164 = private unnamed_addr constant [9 x i8] c"    -g3\0A\00", align 1
