@anon.42b86dac05eb578258e9e0f4074366cb.135 = private unnamed_addr constant <{ [541 x i8] }> <{ [541 x i8] c"Whether the project should be considered a Python package, or a non-package (\22virtual\22)\0Aproject.\0A\0APackages are built and installed into the virtual environment in editable mode and thus\0Arequire a build backend, while virtual projects are _not_ built or installed; instead, only\0Atheir dependencies are included in the virtual environment.\0A\0ACreating a package requires that a `build-system` is present in the `pyproject.toml`, and\0Athat the project adheres to a structure that adheres to the build backend's expectations\0A(e.g., a `src` layout)." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.137 = private unnamed_addr constant <{ [15 x i8] }> <{ [15 x i8] c"package = false" }>, align 1
