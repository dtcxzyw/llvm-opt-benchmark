@anon.42b86dac05eb578258e9e0f4074366cb.156 = private unnamed_addr constant <{ [940 x i8] }> <{ [940 x i8] c"Overrides to apply when resolving the project's dependencies.\0A\0AOverrides are used to force selection of a specific version of a package, regardless of the\0Aversion requested by any other package, and regardless of whether choosing that version\0Awould typically constitute an invalid resolution.\0A\0AWhile constraints are _additive_, in that they're combined with the requirements of the\0Aconstituent packages, overrides are _absolute_, in that they completely replace the\0Arequirements of any constituent packages.\0A\0AIncluding a package as an override will _not_ trigger installation of the package on its\0Aown; instead, the package must be requested elsewhere in the project's first-party or\0Atransitive dependencies.\0A\0A!!! note\0A    In `uv lock`, `uv sync`, and `uv run`, uv will only read `override-dependencies` from\0A    the `pyproject.toml` at the workspace root, and will ignore any declarations in other\0A    workspace members or `uv.toml` files." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.158 = private unnamed_addr constant <{ [153 x i8] }> <{ [153 x i8] c"# Always install Werkzeug 2.3.0, regardless of whether transitive dependencies request\0A# a different version.\0Aoverride-dependencies = [\22werkzeug==2.3.0\22]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.160 = private unnamed_addr constant <{ [21 x i8] }> <{ [21 x i8] c"override-dependencies" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.161 = private unnamed_addr constant <{ [599 x i8] }> <{ [599 x i8] c"Constraints to apply when resolving the project's dependencies.\0A\0AConstraints are used to restrict the versions of dependencies that are selected during\0Aresolution.\0A\0AIncluding a package as a constraint will _not_ trigger installation of the package on its\0Aown; instead, the package must be requested elsewhere in the project's first-party or\0Atransitive dependencies.\0A\0A!!! note\0A    In `uv lock`, `uv sync`, and `uv run`, uv will only read `constraint-dependencies` from\0A    the `pyproject.toml` at the workspace root, and will ignore any declarations in other\0A    workspace members or `uv.toml` files." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.163 = private unnamed_addr constant <{ [158 x i8] }> <{ [158 x i8] c"# Ensure that the grpcio version is always less than 1.65, if it's requested by a\0A# direct or transitive dependency.\0Aconstraint-dependencies = [\22grpcio<1.65\22]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.165 = private unnamed_addr constant <{ [23 x i8] }> <{ [23 x i8] c"constraint-dependencies" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.166 = private unnamed_addr constant <{ [635 x i8] }> <{ [635 x i8] c"Constraints to apply when solving build dependencies.\0A\0ABuild constraints are used to restrict the versions of build dependencies that are selected\0Awhen building a package during resolution or installation.\0A\0AIncluding a package as a constraint will _not_ trigger installation of the package during\0Aa build; instead, the package must be requested elsewhere in the project's build dependency\0Agraph.\0A\0A!!! note\0A    In `uv lock`, `uv sync`, and `uv run`, uv will only read `build-constraint-dependencies` from\0A    the `pyproject.toml` at the workspace root, and will ignore any declarations in other\0A    workspace members or `uv.toml` files." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.168 = private unnamed_addr constant <{ [158 x i8] }> <{ [158 x i8] c"# Ensure that the setuptools v60.0.0 is used whenever a package has a build dependency\0A# on setuptools.\0Abuild-constraint-dependencies = [\22setuptools==60.0.0\22]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.170 = private unnamed_addr constant <{ [29 x i8] }> <{ [29 x i8] c"build-constraint-dependencies" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.171 = private unnamed_addr constant <{ [404 x i8] }> <{ [404 x i8] c"A list of supported environments against which to resolve dependencies.\0A\0ABy default, uv will resolve for all possible environments during a `uv lock` operation.\0AHowever, you can restrict the set of supported environments to improve performance and avoid\0Aunsatisfiable branches in the solution space.\0A\0AThese environments will also be respected when `uv pip compile` is invoked with the\0A`--universal` flag." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.173 = private unnamed_addr constant <{ [94 x i8] }> <{ [94 x i8] c"# Resolve for macOS, but not for Linux or Windows.\0Aenvironments = [\22sys_platform == 'darwin'\22]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.175 = private unnamed_addr constant <{ [12 x i8] }> <{ [12 x i8] c"environments" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.176 = private unnamed_addr constant <{ [1173 x i8] }> <{ [1173 x i8] c"A list of required platforms, for packages that lack source distributions.\0A\0AWhen a package does not have a source distribution, it's availability will be limited to\0Athe platforms supported by its built distributions (wheels). For example, if a package only\0Apublishes wheels for Linux, then it won't be installable on macOS or Windows.\0A\0ABy default, uv requires each package to include at least one wheel that is compatible with\0Athe designated Python version. The `required-environments` setting can be used to ensure that\0Athe resulting resolution contains wheels for specific platforms, or fails if no such wheels\0Aare available.\0A\0AWhile the `environments` setting _limits_ the set of environments that uv will consider when\0Aresolving dependencies, `required-environments` _expands_ the set of platforms that uv _must_\0Asupport when resolving dependencies.\0A\0AFor example, `environments = [\22sys_platform == 'darwin'\22]` would limit uv to solving for\0AmacOS (and ignoring Linux and Windows). On the other hand, `required-environments = [\22sys_platform == 'darwin'\22]`\0Awould _require_ that any package without a source distribution include a wheel for macOS in\0Aorder to be installable." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.178 = private unnamed_addr constant <{ [227 x i8] }> <{ [227 x i8] c"# Require that the package is available for macOS ARM and x86 (Intel).\0Arequired-environments = [\0A    \22sys_platform == 'darwin' and platform_machine == 'arm64'\22,\0A    \22sys_platform == 'darwin' and platform_machine == 'x86_64'\22,\0A]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.180 = private unnamed_addr constant <{ [21 x i8] }> <{ [21 x i8] c"required-environments" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.181 = private unnamed_addr constant <{ [804 x i8] }> <{ [804 x i8] c"Declare collections of extras or dependency groups that are conflicting\0A(i.e., mutually exclusive).\0A\0AIt's useful to declare conflicts when two or more extras have mutually\0Aincompatible dependencies. For example, extra `foo` might depend\0Aon `numpy==2.0.0` while extra `bar` depends on `numpy==2.1.0`. While these\0Adependencies conflict, it may be the case that users are not expected to\0Aactivate both `foo` and `bar` at the same time, making it possible to\0Agenerate a universal resolution for the project despite the incompatibility.\0A\0ABy making such conflicts explicit, uv can generate a universal resolution\0Afor a project, taking into account that certain combinations of extras and\0Agroups are mutually exclusive. In exchange, installation will fail if a\0Auser attempts to activate both conflicting extras." }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.183 = private unnamed_addr constant <{ [16 x i8] }> <{ [16 x i8] c"list[list[dict]]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.185 = private unnamed_addr constant <{ [454 x i8] }> <{ [454 x i8] c"# Require that `package[extra1]` and `package[extra2]` are resolved\0A# in different forks so that they cannot conflict with one another.\0Aconflicts = [\0A    [\0A        { extra = \22extra1\22 },\0A        { extra = \22extra2\22 },\0A    ]\0A]\0A\0A# Require that the dependency groups `group1` and `group2`\0A# are resolved in different forks so that they cannot conflict\0A# with one another.\0Aconflicts = [\0A    [\0A        { group = \22group1\22 },\0A        { group = \22group2\22 },\0A    ]\0A]" }>, align 1
@anon.42b86dac05eb578258e9e0f4074366cb.187 = private unnamed_addr constant <{ [9 x i8] }> <{ [9 x i8] c"conflicts" }>, align 1
