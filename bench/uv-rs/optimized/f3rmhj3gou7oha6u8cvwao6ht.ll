@anon.c8777b812d6b35c09a8e6156f259107b.355 = private unnamed_addr constant <{ [1213 x i8] }> <{ [1213 x i8] c"The package indexes to use when resolving dependencies.\0A\0AAccepts either a repository compliant with [PEP 503](https://peps.python.org/pep-0503/) (the simple repository API), or a local directory laid out in the same format.\0A\0AIndexes are considered in the order in which they're defined, such that the first-defined index has the highest priority. Further, the indexes provided by this setting are given higher priority than any indexes specified via [`index_url`](#index-url) or [`extra_index_url`](#extra-index-url). uv will only consider the first index that contains a given package, unless an alternative [index strategy](#index-strategy) is specified.\0A\0AIf an index is marked as `explicit = true`, it will be used exclusively for those dependencies that select it explicitly via `[tool.uv.sources]`, as in:\0A\0A```toml [[tool.uv.index]] name = \22pytorch\22 url = \22https://download.pytorch.org/whl/cu121\22 explicit = true\0A\0A[tool.uv.sources] torch = { index = \22pytorch\22 } ```\0A\0AIf an index is marked as `default = true`, it will be moved to the end of the prioritized list, such that it is given the lowest priority when resolving packages. Additionally, marking an index as default will disable the PyPI default index." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.356 = private unnamed_addr constant <{ [431 x i8] }> <{ [431 x i8] c"The URL of the Python package index (by default: <https://pypi.org/simple>).\0A\0AAccepts either a repository compliant with [PEP 503](https://peps.python.org/pep-0503/) (the simple repository API), or a local directory laid out in the same format.\0A\0AThe index provided by this setting is given lower priority than any indexes specified via [`extra_index_url`](#extra-index-url) or [`index`](#index).\0A\0A(Deprecated: use `index` instead.)" }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.357 = private unnamed_addr constant <{ [598 x i8] }> <{ [598 x i8] c"Extra URLs of package indexes to use, in addition to `--index-url`.\0A\0AAccepts either a repository compliant with [PEP 503](https://peps.python.org/pep-0503/) (the simple repository API), or a local directory laid out in the same format.\0A\0AAll indexes provided via this flag take priority over the index specified by [`index_url`](#index-url) or [`index`](#index) with `default = true`. When multiple indexes are provided, earlier values take priority.\0A\0ATo control uv's resolution strategy when multiple indexes are present, see [`index_strategy`](#index-strategy).\0A\0A(Deprecated: use `index` instead.)" }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.358 = private unnamed_addr constant <{ [123 x i8] }> <{ [123 x i8] c"Ignore all registry indexes (e.g., PyPI), instead relying on direct URL dependencies and those provided via `--find-links`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.359 = private unnamed_addr constant <{ [372 x i8] }> <{ [372 x i8] c"Locations to search for candidate distributions, in addition to those found in the registry indexes.\0A\0AIf a path, the target must be a directory that contains packages as wheel files (`.whl`) or source distributions (e.g., `.tar.gz` or `.zip`) at the top level.\0A\0AIf a URL, the page must contain a flat list of links to package files adhering to the formats described above." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.360 = private unnamed_addr constant <{ [363 x i8] }> <{ [363 x i8] c"The strategy to use when resolving against multiple index URLs.\0A\0ABy default, uv will stop at the first index on which a given package is available, and limit resolutions to those present on that first index (`first-index`). This prevents \22dependency confusion\22 attacks, whereby an attacker can upload a malicious package under the same name to an alternate index." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.361 = private unnamed_addr constant <{ [194 x i8] }> <{ [194 x i8] c"Attempt to use `keyring` for authentication for index URLs.\0A\0AAt present, only `--keyring-provider subprocess` is supported, which configures uv to use the `keyring` CLI to handle authentication." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.362 = private unnamed_addr constant <{ [193 x i8] }> <{ [193 x i8] c"The strategy to use when selecting between the different compatible versions for a given package requirement.\0A\0ABy default, uv will use the latest compatible version of each package (`highest`)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.363 = private unnamed_addr constant <{ [283 x i8] }> <{ [283 x i8] c"The strategy to use when considering pre-release versions.\0A\0ABy default, uv will accept pre-releases for packages that _only_ publish pre-releases, along with first-party requirements that contain an explicit pre-release marker in the declared specifiers (`if-necessary-or-explicit`)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.364 = private unnamed_addr constant <{ [502 x i8] }> <{ [502 x i8] c"The strategy to use when selecting multiple versions of a given package across Python versions and platforms.\0A\0ABy default, uv will optimize for selecting the latest version of each package for each supported Python version (`requires-python`), while minimizing the number of selected versions across platforms.\0A\0AUnder `fewest`, uv will minimize the number of selected versions for each package, preferring older versions that are compatible with a wider range of supported Python versions or platforms." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.365 = private unnamed_addr constant <{ [832 x i8] }> <{ [832 x i8] c"Pre-defined static metadata for dependencies of the project (direct or transitive). When provided, enables the resolver to use the specified metadata instead of querying the registry or building the relevant package from source.\0A\0AMetadata should be provided in adherence with the [Metadata 2.3](https://packaging.python.org/en/latest/specifications/core-metadata/) standard, though only the following fields are respected:\0A\0A- `name`: The name of the package. - (Optional) `version`: The version of the package. If omitted, the metadata will be applied to all versions of the package. - (Optional) `requires-dist`: The dependencies of the package (e.g., `werkzeug>=0.14`). - (Optional) `requires-python`: The Python version required by the package (e.g., `>=3.10`). - (Optional) `provides-extras`: The extras provided by the package." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.366 = private unnamed_addr constant <{ [115 x i8] }> <{ [115 x i8] c"Settings to pass to the [PEP 517](https://peps.python.org/pep-0517/) build backend, specified as `KEY=VALUE` pairs." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.367 = private unnamed_addr constant <{ [167 x i8] }> <{ [167 x i8] c"Disable isolation when building source distributions.\0A\0AAssumes that build dependencies specified by [PEP 518](https://peps.python.org/pep-0518/) are already installed." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.368 = private unnamed_addr constant <{ [204 x i8] }> <{ [204 x i8] c"Disable isolation when building source distributions for a specific package.\0A\0AAssumes that the packages' build dependencies specified by [PEP 518](https://peps.python.org/pep-0518/) are already installed." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.369 = private unnamed_addr constant <{ [284 x i8] }> <{ [284 x i8] c"Limit candidate packages to those that were uploaded prior to the given date.\0A\0AAccepts both [RFC 3339](https://www.rfc-editor.org/rfc/rfc3339.html) timestamps (e.g., `2006-12-02T02:07:43Z`) and local dates in the same format (e.g., `2006-12-02`) in your system's configured time zone." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.370 = private unnamed_addr constant <{ [163 x i8] }> <{ [163 x i8] c"The method to use when installing packages from the global cache.\0A\0ADefaults to `clone` (also known as Copy-on-Write) on macOS, and `hardlink` on Linux and Windows." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.371 = private unnamed_addr constant <{ [595 x i8] }> <{ [595 x i8] c"Compile Python files to bytecode after installation.\0A\0ABy default, uv does not compile Python (`.py`) files to bytecode (`__pycache__/*.pyc`); instead, compilation is performed lazily the first time a module is imported. For use-cases in which start time is critical, such as CLI applications and Docker containers, this option can be enabled to trade longer installation times for faster start times.\0A\0AWhen enabled, uv will process the entire site-packages directory (including packages that are not being modified by the current operation) for consistency. Like pip, it will also ignore errors." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.372 = private unnamed_addr constant <{ [185 x i8] }> <{ [185 x i8] c"Ignore the `tool.uv.sources` table when resolving dependencies. Used to lock against the standards-compliant, publishable package metadata, as opposed to using any local or Git sources." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.373 = private unnamed_addr constant <{ [179 x i8] }> <{ [179 x i8] c"Allow upgrades for a specific package, ignoring pinned versions in any existing output file.\0A\0AAccepts both standalone package names (`ruff`) and version specifiers (`ruff<0.5.0`)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.374 = private unnamed_addr constant <{ [102 x i8] }> <{ [102 x i8] c"Reinstall a specific package, regardless of whether it's already installed. Implies `refresh-package`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.375 = private unnamed_addr constant <{ [242 x i8] }> <{ [242 x i8] c"Don't build source distributions.\0A\0AWhen enabled, resolving will not run arbitrary Python code. The cached wheels of already-built source distributions will be reused, but operations that require building distributions will exit with an error." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.376 = private unnamed_addr constant <{ [180 x i8] }> <{ [180 x i8] c"Don't install pre-built wheels.\0A\0AThe given packages will be built and installed from source. The resolver will still use pre-built wheels to extract package metadata, if available." }>, align 1
