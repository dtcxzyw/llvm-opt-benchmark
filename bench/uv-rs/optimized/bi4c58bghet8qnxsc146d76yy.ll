@anon.3aa18e283ff517eb43af79d2053ec9e5.98 = private unnamed_addr constant <{ [308 x i8] }> <{ [308 x i8] c"The name of the index.\0A\0AIndex names can be used to reference indexes elsewhere in the configuration. For example, you can pin a package to a specific index by name:\0A\0A```toml [[tool.uv.index]] name = \22pytorch\22 url = \22https://download.pytorch.org/whl/cu121\22\0A\0A[tool.uv.sources] torch = { index = \22pytorch\22 } ```" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.99 = private unnamed_addr constant <{ [4 x i8] }> <{ [4 x i8] c"name" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.100 = private unnamed_addr constant <{ [98 x i8] }> <{ [98 x i8] c"The URL of the index.\0A\0AExpects to receive a URL (e.g., `https://pypi.org/simple`) or a local path." }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.101 = private unnamed_addr constant <{ [3 x i8] }> <{ [3 x i8] c"url" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.102 = private unnamed_addr constant <{ [296 x i8] }> <{ [296 x i8] c"Mark the index as explicit.\0A\0AExplicit indexes will _only_ be used when explicitly requested via a `[tool.uv.sources]` definition, as in:\0A\0A```toml [[tool.uv.index]] name = \22pytorch\22 url = \22https://download.pytorch.org/whl/cu121\22 explicit = true\0A\0A[tool.uv.sources] torch = { index = \22pytorch\22 } ```" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.103 = private unnamed_addr constant <{ [8 x i8] }> <{ [8 x i8] c"explicit" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.104 = private unnamed_addr constant <{ [464 x i8] }> <{ [464 x i8] c"Mark the index as the default index.\0A\0ABy default, uv uses PyPI as the default index, such that even if additional indexes are defined via `[[tool.uv.index]]`, PyPI will still be used as a fallback for packages that aren't found elsewhere. To disable the PyPI default, set `default = true` on at least one other index.\0A\0AMarking an index as default will move it to the front of the list of indexes, such that it is given the highest priority when resolving packages." }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.105 = private unnamed_addr constant <{ [7 x i8] }> <{ [7 x i8] c"default" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.106 = private unnamed_addr constant <{ [268 x i8] }> <{ [268 x i8] c"The format used by the index.\0A\0AIndexes can either be PEP 503-compliant (i.e., a PyPI-style registry implementing the Simple API) or structured as a flat list of distributions (e.g., `--find-links`). In both cases, indexes can point to either local or remote resources." }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.107 = private unnamed_addr constant <{ [6 x i8] }> <{ [6 x i8] c"format" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.108 = private unnamed_addr constant <{ [297 x i8] }> <{ [297 x i8] c"The URL of the upload endpoint.\0A\0AWhen using `uv publish --index <name>`, this URL is used for publishing.\0A\0AA configuration for the default index PyPI would look as follows:\0A\0A```toml [[tool.uv.index]] name = \22pypi\22 url = \22https://pypi.org/simple\22 publish-url = \22https://upload.pypi.org/legacy/\22 ```" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.109 = private unnamed_addr constant <{ [11 x i8] }> <{ [11 x i8] c"publish-url" }>, align 1
