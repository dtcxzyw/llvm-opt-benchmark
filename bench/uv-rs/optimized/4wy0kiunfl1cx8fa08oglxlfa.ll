@anon.e6c53ddf7a52ddad39f1398bd442c07c.86 = private unnamed_addr constant <{ [4219 x i8] }> <{ [4219 x i8] c"# Copyright (c) 2020-202x The virtualenv developers\0A#\0A# Permission is hereby granted, free of charge, to any person obtaining\0A# a copy of this software and associated documentation files (the\0A# \22Software\22), to deal in the Software without restriction, including\0A# without limitation the rights to use, copy, modify, merge, publish,\0A# distribute, sublicense, and/or sell copies of the Software, and to\0A# permit persons to whom the Software is furnished to do so, subject to\0A# the following conditions:\0A#\0A# The above copyright notice and this permission notice shall be\0A# included in all copies or substantial portions of the Software.\0A#\0A# THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND,\0A# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\0A# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\0A# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\0A# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\0A# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A\0A# This file must be used using `source bin/activate.fish` *within a running fish ( http://fishshell.com ) session*.\0A# Do not run it directly.\0A\0Afunction _bashify_path -d \22Converts a fish path to something bash can recognize\22\0A    set fishy_path $argv\0A    set bashy_path $fishy_path[1]\0A    for path_part in $fishy_path[2..-1]\0A        set bashy_path \22$bashy_path:$path_part\22\0A    end\0A    echo $bashy_path\0Aend\0A\0Afunction _fishify_path -d \22Converts a bash path to something fish can recognize\22\0A    echo $argv | tr ':' '\\n'\0Aend\0A\0Afunction deactivate -d 'Exit virtualenv mode and return to the normal environment.'\0A    # reset old environment variables\0A    if test -n \22$_OLD_VIRTUAL_PATH\22\0A        # https://github.com/fish-shell/fish-shell/issues/436 altered PATH handling\0A        if test (echo $FISH_VERSION | head -c 1) -lt 3\0A            set -gx PATH (_fishify_path \22$_OLD_VIRTUAL_PATH\22)\0A        else\0A            set -gx PATH $_OLD_VIRTUAL_PATH\0A        end\0A        set -e _OLD_VIRTUAL_PATH\0A    end\0A\0A    if test -n \22$_OLD_VIRTUAL_PYTHONHOME\22\0A        set -gx PYTHONHOME \22$_OLD_VIRTUAL_PYTHONHOME\22\0A        set -e _OLD_VIRTUAL_PYTHONHOME\0A    end\0A\0A    if test -n \22$_OLD_FISH_PROMPT_OVERRIDE\22\0A       and functions -q _old_fish_prompt\0A        # Set an empty local `$fish_function_path` to allow the removal of `fish_prompt` using `functions -e`.\0A        set -l fish_function_path\0A\0A        # Erase virtualenv's `fish_prompt` and restore the original.\0A        functions -e fish_prompt\0A        functions -c _old_fish_prompt fish_prompt\0A        functions -e _old_fish_prompt\0A        set -e _OLD_FISH_PROMPT_OVERRIDE\0A    end\0A\0A    set -e VIRTUAL_ENV\0A    set -e VIRTUAL_ENV_PROMPT\0A\0A    if test \22$argv[1]\22 != 'nondestructive'\0A        # Self-destruct!\0A        functions -e pydoc\0A        functions -e deactivate\0A        functions -e _bashify_path\0A        functions -e _fishify_path\0A    end\0Aend\0A\0A# Unset irrelevant variables.\0Adeactivate nondestructive\0A\0Aset -gx VIRTUAL_ENV '{{ VIRTUAL_ENV_DIR }}'\0A\0A# https://github.com/fish-shell/fish-shell/issues/436 altered PATH handling\0Aif test (echo $FISH_VERSION | head -c 1) -lt 3\0A    set -gx _OLD_VIRTUAL_PATH (_bashify_path $PATH)\0Aelse\0A    set -gx _OLD_VIRTUAL_PATH $PATH\0Aend\0Aset -gx PATH \22$VIRTUAL_ENV\22'/{{ BIN_NAME }}' $PATH\0A\0A# Prompt override provided?\0A# If not, just use the environment name.\0Aif test -n '{{ VIRTUAL_PROMPT }}'\0A    set -gx VIRTUAL_ENV_PROMPT '{{ VIRTUAL_PROMPT }}'\0Aelse\0A    set -gx VIRTUAL_ENV_PROMPT (basename \22$VIRTUAL_ENV\22)\0Aend\0A\0A# Unset `$PYTHONHOME` if set.\0Aif set -q PYTHONHOME\0A    set -gx _OLD_VIRTUAL_PYTHONHOME $PYTHONHOME\0A    set -e PYTHONHOME\0Aend\0A\0Afunction pydoc\0A    python -m pydoc $argv\0Aend\0A\0Aif test -z \22$VIRTUAL_ENV_DISABLE_PROMPT\22\0A    # Copy the current `fish_prompt` function as `_old_fish_prompt`.\0A    functions -c fish_prompt _old_fish_prompt\0A\0A    function fish_prompt\0A        # Run the user's prompt first; it might depend on (pipe)status.\0A        set -l prompt (_old_fish_prompt)\0A\0A        printf '(%s) ' $VIRTUAL_ENV_PROMPT\0A\0A        string join -- \\n $prompt # handle multi-line prompts\0A    end\0A\0A    set -gx _OLD_FISH_PROMPT_OVERRIDE \22$VIRTUAL_ENV\22\0Aend\0A" }>, align 1
