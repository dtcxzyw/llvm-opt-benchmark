fined _OLD_VIRTUAL_PROMPT (\0D\0A    @set \22PROMPT=%_OLD_VIRTUAL_PROMPT%\22\0D\0A) else (\0D\0A    @if not defined PROMPT (\0D\0A        @set \22PROMPT=$P$G\22\0D\0A    )\0D\0A    @if not defined VIRTUAL_ENV_DISABLE_PROMPT (\0D\0A        @set \22_OLD_VIRTUAL_PROMPT=%PROMPT%\22\0D\0A    )\0D\0A)\0D\0A@if not defined VIRTUAL_ENV_DISABLE_PROMPT (\0D\0A    @set \22PROMPT=(%VIRTUAL_ENV_PROMPT%) %PROMPT%\22\0D\0A)\0D\0A\0D\0A@REM Don't use () to avoid problems with them in %PATH%\0D\0A@if defined _OLD_VIRTUAL_PYTHONHOME @goto ENDIFVHOME\0D\0A    @set \22_OLD_VIRTUAL_PYTHONHOME=%PYTHONHOME%\22\0D\0A:ENDIFVHOME\0D\0A\0D\0A@set PYTHONHOME=\0D\0A\0D\0A@REM if defined _OLD_VIRTUAL_PATH (\0D\0A@if not defined _OLD_VIRTUAL_PATH @goto ENDIFVPATH1\0D\0A    @set \22PATH=%_OLD_VIRTUAL_PATH%\22\0D\0A:ENDIFVPATH1\0D\0A@REM ) else (\0D\0A@if defined _OLD_VIRTUAL_PATH @goto ENDIFVPATH2\0D\0A    @set \22_OLD_VIRTUAL_PATH=%PATH%\22\0D\0A:ENDIFVPATH2\0D\0A\0D\0A@set \22PATH=%VIRTUAL_ENV%\\{{ BIN_NAME }};%PATH%\22\0D\0A\0D\0A:END\0D\0A@if defined _OLD_CODEPAGE (\0D\0A    @\22%SystemRoot%\\System32\\chcp.com\22 %_OLD_CODEPAGE% > nul\0D\0A    @set _OLD_CODEPAGE=\0D\0A)\0D\0A" }>, align 1
