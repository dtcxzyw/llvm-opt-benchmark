@anon.e6c53ddf7a52ddad39f1398bd442c07c.121 = private unnamed_addr constant <{ [4342 x i8] }> <{ [4342 x i8] c"\22\22\22Patches that are applied at runtime to the virtual environment.\22\22\22\0A\0Aimport os\0Aimport sys\0A\0AVIRTUALENV_PATCH_FILE = os.path.join(__file__)\0A\0A\0Adef patch_dist(dist):\0A    \22\22\22\0A    Distutils allows user to configure some arguments via a configuration file:\0A    https://docs.python.org/3.11/install/index.html#distutils-configuration-files.\0A\0A    Some of this arguments though don't make sense in context of the virtual environment files, let's fix them up.\0A    \22\22\22  # noqa: D205\0A    # we cannot allow some install config as that would get packages installed outside of the virtual environment\0A    old_parse_config_files = dist.Distribution.parse_config_files\0A\0A    def parse_config_files(self, *args, **kwargs):\0A        result = old_parse_config_files(self, *args, **kwargs)\0A        install = self.get_option_dict(\22install\22)\0A\0A        if \22prefix\22 in install:  # the prefix governs where to install the libraries\0A            install[\22prefix\22] = VIRTUALENV_PATCH_FILE, os.path.abspath(sys.prefix)\0A        for base in (\22purelib\22, \22platlib\22, \22headers\22, \22scripts\22, \22data\22):\0A            key = f\22install_{base}\22\0A            if key in install:  # do not allow global configs to hijack venv paths\0A                install.pop(key, None)\0A        return result\0A\0A    dist.Distribution.parse_config_files = parse_config_files\0A\0A\0A# Import hook that patches some modules to ignore configuration values that break package installation in case\0A# of virtual environments.\0A_DISTUTILS_PATCH = \22distutils.dist\22, \22setuptools.dist\22\0A# https://docs.python.org/3/library/importlib.html#setting-up-an-importer\0A\0A\0Aclass _Finder:\0A    \22\22\22A meta path finder that allows patching the imported distutils modules.\22\22\22\0A\0A    fullname = None\0A\0A    # lock[0] is threading.Lock(), but initialized lazily to avoid importing threading very early at startup,\0A    # because there are gevent-based applications that need to be first to import threading by themselves.\0A    # See https://github.com/pypa/virtualenv/issues/1895 for details.\0A    lock = []  # noqa: RUF012\0A\0A    def find_spec(self, fullname, path, target=None):  # noqa: ARG002\0A        if fullname in _DISTUTILS_PATCH and self.fullname is None:\0A            # initialize lock[0] lazily\0A            if len(self.lock) == 0:\0A                import threading\0A\0A                lock = threading.Lock()\0A                # there is possibility that two threads T1 and T2 are simultaneously running into find_spec,\0A                # observing .lock as empty, and further going into hereby initialization. However due to the GIL,\0A                # list.append() operation is atomic and this way only one of the threads will \22win\22 to put the lock\0A                # - that every thread will use - into .lock[0].\0A                # https://docs.python.org/3/faq/library.html#what-kinds-of-global-value-mutation-are-thread-safe\0A                self.lock.append(lock)\0A\0A            from functools import partial\0A            from importlib.util import find_spec\0A\0A            with self.lock[0]:\0A                self.fullname = fullname\0A                try:\0A                    spec = find_spec(fullname, path)\0A                    if spec is not None:\0A                        # https://www.python.org/dev/peps/pep-0451/#how-loading-will-work\0A                        is_new_api = hasattr(spec.loader, \22exec_module\22)\0A                        func_name = \22exec_module\22 if is_new_api else \22load_module\22\0A                        old = getattr(spec.loader, func_name)\0A                        func = self.exec_module if is_new_api else self.load_module\0A                        if old is not func:\0A                            try:  # noqa: SIM105\0A                                setattr(spec.loader, func_name, partial(func, old))\0A                            except AttributeError:\0A                                pass  # C-Extension loaders are r/o such as zipimporter with <3.7\0A                        return spec\0A                finally:\0A                    self.fullname = None\0A        return None\0A\0A    @staticmethod\0A    def exec_module(old, module):\0A        old(module)\0A        if module.__name__ in _DISTUTILS_PATCH:\0A            patch_dist(module)\0A\0A    @staticmethod\0A    def load_module(old, name):\0A        module = old(name)\0A        if module.__name__ in _DISTUTILS_PATCH:\0A            patch_dist(module)\0A        return module\0A\0A\0Asys.meta_path.insert(0, _Finder())\0A" }>, align 1
