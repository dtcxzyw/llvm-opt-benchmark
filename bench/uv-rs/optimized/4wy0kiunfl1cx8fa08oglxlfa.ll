NV:q/{{ BIN_NAME }}:$PATH:q\22\0A\0A\0A\0Aif ('{{ VIRTUAL_PROMPT }}' != \22\22) then\0A    setenv VIRTUAL_ENV_PROMPT '{{ VIRTUAL_PROMPT }}'\0Aelse\0A    setenv VIRTUAL_ENV_PROMPT \22$VIRTUAL_ENV:t:q\22\0Aendif\0A\0Aif ( $?VIRTUAL_ENV_DISABLE_PROMPT ) then\0A    if ( $VIRTUAL_ENV_DISABLE_PROMPT == \22\22 ) then\0A        set do_prompt = \221\22\0A    else\0A        set do_prompt = \220\22\0A    endif\0Aelse\0A    set do_prompt = \221\22\0Aendif\0A\0Aif ( $do_prompt == \221\22 ) then\0A    # Could be in a non-interactive environment,\0A    # in which case, $prompt is undefined and we wouldn't\0A    # care about the prompt anyway.\0A    if ( $?prompt ) then\0A        set _OLD_VIRTUAL_PROMPT=\22$prompt:q\22\0A        if ( \22$prompt:q\22 =~ *\22$newline:q\22* ) then\0A            :\0A        else\0A            set prompt = '('\22$VIRTUAL_ENV_PROMPT:q\22') '\22$prompt:q\22\0A        endif\0A    endif\0Aendif\0A\0Aunset env_name\0Aunset do_prompt\0A\0Aalias pydoc python -m pydoc\0A\0Arehash\0A" }>, align 1
