@anon.e6c53ddf7a52ddad39f1398bd442c07c.90 = private unnamed_addr constant <{ [2826 x i8] }> <{ [2826 x i8] c"# Copyright (c) 2020-202x The virtualenv developers\0A#\0A# Permission is hereby granted, free of charge, to any person obtaining\0A# a copy of this software and associated documentation files (the\0A# \22Software\22), to deal in the Software without restriction, including\0A# without limitation the rights to use, copy, modify, merge, publish,\0A# distribute, sublicense, and/or sell copies of the Software, and to\0A# permit persons to whom the Software is furnished to do so, subject to\0A# the following conditions:\0A#\0A# The above copyright notice and this permission notice shall be\0A# included in all copies or substantial portions of the Software.\0A#\0A# THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND,\0A# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\0A# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\0A# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\0A# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\0A# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A\0A$script:THIS_PATH = $myinvocation.mycommand.path\0A$script:BASE_DIR = Split-Path (Resolve-Path \22$THIS_PATH/..\22) -Parent\0A\0Afunction global:deactivate([switch] $NonDestructive) {\0A    if (Test-Path variable:_OLD_VIRTUAL_PATH) {\0A        $env:PATH = $variable:_OLD_VIRTUAL_PATH\0A        Remove-Variable \22_OLD_VIRTUAL_PATH\22 -Scope global\0A    }\0A\0A    if (Test-Path function:_old_virtual_prompt) {\0A        $function:prompt = $function:_old_virtual_prompt\0A        Remove-Item function:\\_old_virtual_prompt\0A    }\0A\0A    if ($env:VIRTUAL_ENV) {\0A        Remove-Item env:VIRTUAL_ENV -ErrorAction SilentlyContinue\0A    }\0A\0A    if ($env:VIRTUAL_ENV_PROMPT) {\0A        Remove-Item env:VIRTUAL_ENV_PROMPT -ErrorAction SilentlyContinue\0A    }\0A\0A    if (!$NonDestructive) {\0A        # Self destruct!\0A        Remove-Item function:deactivate\0A        Remove-Item function:pydoc\0A    }\0A}\0A\0Afunction global:pydoc {\0A    python -m pydoc $args\0A}\0A\0A# unset irrelevant variables\0Adeactivate -nondestructive\0A\0A$VIRTUAL_ENV = $BASE_DIR\0A$env:VIRTUAL_ENV = $VIRTUAL_ENV\0A\0Aif (\22{{ VIRTUAL_PROMPT }}\22 -ne \22\22) {\0A    $env:VIRTUAL_ENV_PROMPT = \22{{ VIRTUAL_PROMPT }}\22\0A}\0Aelse {\0A    $env:VIRTUAL_ENV_PROMPT = $( Split-Path $env:VIRTUAL_ENV -Leaf )\0A}\0A\0ANew-Variable -Scope global -Name _OLD_VIRTUAL_PATH -Value $env:PATH\0A\0A$env:PATH = \22$env:VIRTUAL_ENV/{{ BIN_NAME }}{{ PATH_SEP }}\22 + $env:PATH\0Aif (!$env:VIRTUAL_ENV_DISABLE_PROMPT) {\0A    function global:_old_virtual_prompt {\0A        \22\22\0A    }\0A    $function:_old_virtual_prompt = $function:prompt\0A\0A    function global:prompt {\0A        # Add the custom prefix to the existing prompt\0A        $previous_prompt_value = & $function:_old_virtual_prompt\0A        (\22(\22 + $env:VIRTUAL_ENV_PROMPT + \22) \22 + $previous_prompt_value)\0A    }\0A}\0A" }>, align 1
