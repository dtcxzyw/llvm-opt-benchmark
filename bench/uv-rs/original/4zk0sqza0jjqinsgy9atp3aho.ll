t called \22nt\22.\0A                return os.name\0A            return \22posix_prefix\22\0A\0A        scheme_name = _infer_prefix()\0A        paths = sysconfig.get_paths(scheme=scheme_name)\0A\0A        # Logic here is very arbitrary, we're doing it for compatibility, don't ask.\0A        # 1. Pip historically uses a special header path in virtual environments.\0A        if running_under_virtualenv():\0A            python_xy = f\22python{get_major_minor_version()}\22\0A            paths[\22include\22] = os.path.join(sys.prefix, \22include\22, \22site\22, python_xy)\0A\0A        return {\0A            \22platlib\22: paths[\22platlib\22],\0A            \22purelib\22: paths[\22purelib\22],\0A            \22include\22: paths[\22include\22],\0A            \22scripts\22: paths[\22scripts\22],\0A            \22data\22: paths[\22data\22],\0A        }\0A\0A    def get_distutils_scheme():\0A        \22\22\22Get the \22scheme\22 corresponding to the input parameters.\0A\0A        Uses the deprecated `distutils` module to get the scheme.\0A\0A        Based on (with default arguments):\0A            https://github.com/pypa/pip/blob/ae5fff36b0aad6e5e0037884927eaa29163c0611/src/pip/_internal/locations/_distutils.py#L115\0A        \22\22\22\0A        import warnings\0A\0A        with warnings.catch_warnings():  # disable warning for PEP-632\0A            warnings.simplefilter(\22ignore\22)\0A            from distutils.dist import Distribution\0A\0A        dist_args = {}\0A\0A        d = Distribution(dist_args)\0A        try:\0A            d.parse_config_files()\0A        except UnicodeDecodeError:\0A            pass\0A\0A        with warnings.catch_warnings():\0A            warnings.simplefilter(\22ignore\22)\0A            i = d.get_command_obj(\22install\22, create=True)\0A\0A        i.finalize_options()\0A\0A        scheme = {}\0A        for key in (\22purelib\22, \22platlib\22, \22headers\22, \22scripts\22, \22data\22):\0A            scheme[key] = getattr(i, \22install_\22 + 