@anon.aa72cd09675a613f70bae4f22405c9d0.245 = private unnamed_addr constant <{ [25037 x i8] }> <{ [25037 x i8] c"\22\22\22\0AQueries information about the current Python interpreter and prints it as JSON.\0A\0AThe script will exit with status 0 on known error that are turned into rust errors.\0A\22\22\22\0A\0Aimport sys\0A\0Aimport json\0Aimport os\0Aimport platform\0Aimport struct\0Aimport sysconfig\0A\0A\0Adef format_full_version(info):\0A    version = \22{0.major}.{0.minor}.{0.micro}\22.format(info)\0A    kind = info.releaselevel\0A    if kind != \22final\22:\0A        version += kind[0] + str(info.serial)\0A    return version\0A\0A\0Aif sys.version_info[0] < 3:\0A    print(\0A        json.dumps(\0A            {\0A                \22result\22: \22error\22,\0A                \22kind\22: \22unsupported_python_version\22,\0A                \22python_version\22: format_full_version(sys.version_info),\0A            }\0A        )\0A    )\0A    sys.exit(0)\0A\0Aif hasattr(sys, \22implementation\22):\0A    implementation_name = sys.implementation.name\0A    if implementation_name == \22graalpy\22:\0A        # GraalPy reports the CPython version as sys.implementation.version,\0A        # so we need to discover the GraalPy version from the cache_tag\0A        import re\0A        implementation_version = re.sub(\0A            r\22graalpy(\\d)(\\d+)-\\d+\22,\0A            r\22\\1.\\2\22,\0A            sys.implementation.cache_tag\0A        )\0A    else:\0A        implementation_version = format_full_version(sys.implementation.version)\0Aelse:\0A    implementation_version = \220\22\0A    implementation_name = \22\22\0A\0Apython_full_version = platform.python_version()\0A# For local builds of Python, at time of writing, the version numbers end with\0A# a `+`. This makes the version non-PEP-440 compatible since a `+` indicates\0A# the start of a local segment which must be non-empty. Thus, `uv` chokes on it\0A# and spits out an error[1] when trying to create a venv using a \22local\22 build\0A# of Python. Arguably, the right fix for this is for CPython to use a PEP-440\0A# compatible version number[2].\0A#\0A# However, as a work-around for now, as suggested by pradyunsg[3] as one\0A# possible direction forward, we strip the `+`.\0A#\0A# This fix does unfortunately mean that one cannot specify a Python version\0A# constraint that specifically selects a local version[4]. But at the time of\0A# writing, it seems reasonable to block such functionality on this being fixed\0A# upstream (in some way).\0A#\0A# Another alternative would be to treat such invalid versions as strings (which\0A# is what PEP-508 suggests), but this leads to undesirable behavior in this\0A# case. For example, let's say you have a Python constraint of `>=3.9.1` and\0A# a local build of Python with a version `3.11.1+`. Using string comparisons\0A# would mean the constraint wouldn't be satisfied:\0A#\0A#     >>> \223.9.1\22 < \223.11.1+\22\0A#     False\0A#\0A# So in the end, we just strip the trailing `+`, as was done in the days of old\0A# for legacy version numbers[5].\0A#\0A# [1]: https://github.com/astral-sh/uv/issues/1357\0A# [2]: https://github.com/python/cpython/issues/99968\0A# [3]: https://github.com/pypa/packaging/issues/678#issuecomment-1436033646\0A# [4]: https://github.com/astral-sh/uv/issues/1357#issuecomment-1947645243\0A# [5]: https://github.com/pypa/packaging/blob/085ff41692b687ae5b0772a55615b69a5b677be9/packaging/version.py#L168-L193\0Aif len(python_full_version) > 0 and python_full_version[-1] == \22+\22:\0A    python_full_version = python_full_version[:-1]\0A\0A\0Adef _running_under_venv() -> bool:\0A    \22\22\22Checks if sys.base_prefix and sys.prefix match.\0A\0A    This handles PEP 405 compliant virtual environments.\0A    \22\22\22\0A    return sys.prefix != getattr(sys, \22base_prefix\22, sys.prefix)\0A\0A\0Adef _running_under_legacy_virtualenv() -> bool:\0A    \22\22\22Checks if sys.real_prefix is set.\0A\0A    This handles virtual environments created with pypa's virtualenv.\0A    \22\22\22\0A    # pypa/virtualenv case\0A    return hasattr(sys, \22real_prefix\22)\0A\0A\0Adef running_under_virtualenv() -> bool:\0A    \22\22\22True if we're running inside a virtual environment, False otherwise.\22\22\22\0A    return _running_under_venv() or _running_under_legacy_virtualenv()\0A\0A\0Adef get_major_minor_version() -> str:\0A    \22\22\22\0A    Return the major-minor version of the current Python as a string, e.g.\0A    \223.7\22 or \223.10\22.\0A    \22\22\22\0A    return \22{}.{}\22.format(*sys.version_info)\0A\0A\0Adef get_virtualenv():\0A    \22\22\22Return the expected Scheme for virtualenvs created by this interpreter.\0A\0A    The paths returned should be relative to a root directory.\0A\0A    This is based on virtualenv's path discovery logic:\0A        https://github.com/pypa/virtualenv/blob/5cd543fdf8047600ff2737babec4a635ad74d169/src/virtualenv/discovery/py_info.py#L80C9-L80C17\0A    \22\22\22\0A    scheme_names = sysconfig.get_scheme_names()\0A\0A    # Determine the scheme to use, if any.\0A    if \22venv\22 in scheme_names:\0A        sysconfig_scheme = \22venv\22\0A    elif sys.version_info[:2] == (3, 10) and \22deb_system\22 in scheme_names:\0A        # debian / ubuntu python 3.10 without `python3-distutils` will report\0A        # mangled `local/bin` / etc. names for the default prefix\0A        # intentionally select `posix_prefix` which is the unaltered posix-like paths\0A        sysconfig_scheme = \22posix_prefix\22\0A    else:\0A        sysconfig_scheme = None\0A\0A    # Use `sysconfig`, if available.\0A    if sysconfig_scheme:\0A        import re\0A\0A        sysconfig_paths = {\0A            i: sysconfig.get_path(i, expand=False, scheme=sysconfig_scheme)\0A            for i in sysconfig.get_path_names()\0A        }\0A\0A        # Determine very configuration variable that we need to resolve.\0A        config_var_keys = set()\0A\0A        conf_var_re = re.compile(r\22\\{\\w+}\22)\0A        f