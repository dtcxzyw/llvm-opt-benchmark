@anon.aa72cd09675a613f70bae4f22405c9d0.250 = private unnamed_addr constant <{ [3282 x i8] }> <{ [3282 x i8] c"\22\22\22\0AELF file parser.\0A\0AThis provides a class ``ELFFile`` that parses an ELF executable in a similar\0Ainterface to ``ZipFile``. Only the read interface is implemented.\0A\0ABased on: https://gist.github.com/lyssdod/f51579ae8d93c8657a5564aefc2ffbca\0AELF header: https://refspecs.linuxfoundation.org/elf/gabi4+/ch4.eheader.html\0A\22\22\22\0A\0Afrom __future__ import annotations\0A\0Aimport enum\0Aimport os\0Aimport struct\0Afrom typing import IO\0A\0A\0Aclass ELFInvalid(ValueError):\0A    pass\0A\0A\0Aclass EIClass(enum.IntEnum):\0A    C32 = 1\0A    C64 = 2\0A\0A\0Aclass EIData(enum.IntEnum):\0A    Lsb = 1\0A    Msb = 2\0A\0A\0Aclass EMachine(enum.IntEnum):\0A    I386 = 3\0A    S390 = 22\0A    Arm = 40\0A    X8664 = 62\0A    AArc64 = 183\0A\0A\0Aclass ELFFile:\0A    \22\22\22\0A    Representation of an ELF executable.\0A    \22\22\22\0A\0A    def __init__(self, f: IO[bytes]) -> None:\0A        self._f = f\0A\0A        try:\0A            ident = self._read(\2216B\22)\0A        except struct.error:\0A            raise ELFInvalid(\22unable to parse identification\22)\0A        magic = bytes(ident[:4])\0A        if magic != b\22\\x7fELF\22:\0A            raise ELFInvalid(f\22invalid magic: {magic!r}\22)\0A\0A        self.capacity = ident[4]  # Format for program header (bitness).\0A        self.encoding = ident[5]  # Data structure encoding (endianness).\0A\0A        try:\0A            # e_fmt: Format for program header.\0A            # p_fmt: Format for section header.\0A            # p_idx: Indexes to find p_type, p_offset, and p_filesz.\0A            e_fmt, self._p_fmt, self._p_idx = {\0A                (1, 1): (\22<HHIIIIIHHH\22, \22<IIIIIIII\22, (0, 1, 4)),  # 32-bit LSB.\0A                (1, 2): (\22>HHIIIIIHHH\22, \22>IIIIIIII\22, (0, 1, 4)),  # 32-bit MSB.\0A                (2, 1): (\22<HHIQQQIHHH\22, \22<IIQQQQQQ\22, (0, 2, 5)),  # 64-bit LSB.