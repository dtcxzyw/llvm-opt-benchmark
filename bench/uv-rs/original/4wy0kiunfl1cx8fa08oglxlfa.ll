@anon.e6c53ddf7a52ddad39f1398bd442c07c.121 = private unnamed_addr constant <{ [4342 x i8] }> <{ [4342 x i8] c"\22\22\22Patches that are applied at runtime to the virtual environment.\22\22\22\0A\0Aimport os\0Aimport sys\0A\0AVIRTUALENV_PATCH_FILE = os.path.join(__file__)\0A\0A\0Adef patch_dist(dist):\0A    \22\22\22\0A    Distutils allows user to configure some arguments via a configuration file:\0A    https://docs.python.org/3.11/install/index.html#distutils-configuration-files.\0A\0A    Some of this arguments though don't make sense in context of the virtual environment files, let's fix them up.\0A    \22\22\22  # noqa: D205\0A    # we cannot allow some install config as that would get packages installed outside of the virtual environment\0A    old_parse_config_files = dist.Distribution.parse_config_files\0A\0A    def parse_config_files(self, *args, **kwargs):\0A        result = old_parse_config_files(self, *args, **kwargs)\0A        install = self.get_option_dict(\22install\22)\0A\0A        if \22prefix\22 in install:  # the prefix governs where to install the libraries\0A            install[\22prefix\22] = VIRTUALENV_PATCH_FILE, os.path.abspath(sys.prefix)\0A        for base in (\22purelib\22, \22platlib\22, \22headers\22, \22scripts\22, \22data\22):\0A            key = f\22install_{base}\22\0A            if key in install:  # do not allow global configs to hijack venv paths\0A                install.pop(key, None)\0A        return result\0A\0A    dist.Distribution.parse_config_files = parse_config_files\0A\0A\0A# Import hook that patches some modules to ignore configuration values that break package installation in case\0A# of virtual environments.\0A_DISTUTILS_PATCH = \22distutils.dist\22, \22setuptools.dist\22\0A# https://docs.python.org/3/library/importlib.html#setting-up-an-importer\0A\0A\0Aclass _Finder:\0A    \22\22\22A meta path finder that allows patching the imported distutils modules.\22\22\22\0A\0A    fullname = None\0A\0A    # lock[0] is threading.L