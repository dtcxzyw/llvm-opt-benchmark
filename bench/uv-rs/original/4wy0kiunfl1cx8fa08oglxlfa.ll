@anon.e6c53ddf7a52ddad39f1398bd442c07c.82 = private unnamed_addr constant <{ [4117 x i8] }> <{ [4117 x i8] c"# Copyright (c) 2020-202x The virtualenv developers\0A#\0A# Permission is hereby granted, free of charge, to any person obtaining\0A# a copy of this software and associated documentation files (the\0A# \22Software\22), to deal in the Software without restriction, including\0A# without limitation the rights to use, copy, modify, merge, publish,\0A# distribute, sublicense, and/or sell copies of the Software, and to\0A# permit persons to whom the Software is furnished to do so, subject to\0A# the following conditions:\0A#\0A# The above copyright notice and this permission notice shall be\0A# included in all copies or substantial portions of the Software.\0A#\0A# THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND,\0A# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\0A# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\0A# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\0A# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\0A# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A\0A# This file must be used with \22source bin/activate\22 *from bash*\0A# you cannot run it directly\0A\0Aif ! [ -z \22${SCRIPT_PATH+_}\22 ] ; then\0A    _OLD_SCRIPT_PATH=\22$SCRIPT_PATH\22\0Afi\0A\0A# Get script path (only used if environment is relocatable).\0Aif [ -n \22${BASH_VERSION:+x}\22 ] ; then\0A    SCRIPT_PATH=\22${BASH_SOURCE[0]}\22\0A    if [ \22$SCRIPT_PATH\22 = \22$0\22 ]; then\0A        # Only bash has a reasonably robust check for source'dness.\0A        echo \22You must source this script: \\$ source $0\22 >&2\0A        exit 33\0A    fi\0Aelif [ -n \22${ZSH_VERSION:+x}\22 ] ; then\0A    SCRIPT_PATH=\22${(%):-%x}\22\0Aelif [ -n \22${KSH_VERSION:+x}\22 ] ; then\0A    SCRIPT_PATH=\22${.sh.file}\22\0Afi\0A\0Adeactivate () {\0A    unset -f pydoc >/dev/null 2>&1 || true\0A\0A    # reset old environment variables\0A    # ! [ -z ${VAR+_} ] returns true if VAR is declared at all\0A    if ! [ -z \22${_OLD_VIRTUAL_PATH:+_}\22 ] ; then\0A        PATH=\22$_OLD_VIRTUAL_PATH\22\0A        export PATH\0A        unset _OLD_VIRTUAL_PATH\0A    fi\0A    if ! [ -z \22${_OLD_VIRTUAL_PYTHONHOME+_}\22 ] ; then\0A        PYTHONHOME=\22$_OLD_VIRTUAL_PYTHONHOME\22\0A        export PYTHONHOME\0A        unset _OLD_VIRTUAL_PYTHONHOME\0A    fi\0A\0A    # The hash command must be called to get it to forget past\0A    # commands. Without forgetting past commands the $PATH changes\0A    # we made may not be respected\0A    hash -r 2>/dev/null\0A\0A    if ! [ -z \22${_OLD_VIRTUAL_PS1+_}\22 ] ; then\0A        PS1=\22$_OLD_VIRTUAL_PS1\22\0A        export PS1\0A        unset _OLD_VIRTUAL_PS1\0A    fi\0A\0A    unset VIRTUAL_ENV\0A    unset VIRTUAL_ENV_PROMPT\0A    if [ ! \22${1-}\22 = \22nondestructive\22 ] ; then\0A    # Self destruct!\0A        unset -f deactivate\0A    fi\0A}\0A\0A# unset irrelevant variables\0Adeactivate nondestructive\0A\0AVIRTUAL_ENV='{{ VIRTUAL_ENV_DIR }}'\0Aif ([ \22$OSTYPE\22 = \22cygwin\22 ] || [ \22$OSTYPE\22 = \22msys\22 ]) && $(command -v cygpath &> /dev/null) ; then\0A    VIRTUAL_ENV=$(cygpath -u \22$VIRTUAL_ENV\22)\0Afi\0Aexport VIRTUAL_ENV\0A\0A# Unset the `SCRIPT_PATH` variable, now that the `VIRTUAL_ENV` variable\0A# has been set. This is important for relocatable environments.\0Aif ! [ -z \22${_OLD_SCRIPT_PATH+_}\22 ] ; then\0A    SCRIPT_PATH=\22$_OLD_SCRIPT_PATH\22\0A    export SCRIPT_PATH\0A    unset _OLD_SCRIPT_PATH\0Aelse\0A    unset SCRIPT_PATH\0Afi\0A\0A_OLD_VIRTUAL_PATH=\22$PATH\22\0APATH=\22$VIRTUAL_ENV/{{ BIN_NAME }}:$PATH\22\0Aexport PATH\0A\0Aif [ \22x{{ VIRTUAL_PROMPT }}\22 != x ] ; then\0A    VIRTUAL_ENV_PROMPT=\22{{ VIRTUAL_PROMPT }}\22\0Aelse\0A    VIRTUAL_ENV_PROMPT=$(basename \22$VIRTUAL_ENV\22)\0Afi\0Aexport VIRTUAL_ENV_PROMPT\0A\0A# unset PYTHONHOME if set\0Aif ! [ -z \22${PYTHONHOME+_}\22 ] ; then\0A    _OLD_VIRTUAL_PYTHONHOME=\22$PYTHONHOME\22\0A    unset PYTHONHOME\0Afi\0A\0Aif [ -z \22${VIRTUAL_ENV_DISABLE_PROMPT-}\22 ] ; then\0A    _OLD_VIRTUAL_PS1=\22${PS1-}\22\0A    PS1=\22(${VIRTUAL_ENV_PROMPT}) ${PS1-}\22\0A    export PS1\0Afi\0A\0A# Make sure to unalias pydoc if it's already there\0Aalias pydoc 2>/dev/null >/dev/null && unalias pydoc || true\0A\0Apydoc () {\0A    python -m pydoc \22$@\22\0A}\0A\0A# The hash command must be called to get it to forget past\0A# commands. Without forgetting past commands the $PATH changes\0A# we made may not be respected\0Ahash -r 2>/dev/null\0A" }>, align 1
