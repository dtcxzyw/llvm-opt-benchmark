@anon.e6c53ddf7a52ddad39f1398bd442c07c.88 = private unnamed_addr constant <{ [3904 x i8] }> <{ [3904 x i8] c"# Copyright (c) 2020-202x The virtualenv developers\0A#\0A# Permission is hereby granted, free of charge, to any person obtaining\0A# a copy of this software and associated documentation files (the\0A# \22Software\22), to deal in the Software without restriction, including\0A# without limitation the rights to use, copy, modify, merge, publish,\0A# distribute, sublicense, and/or sell copies of the Software, and to\0A# permit persons to whom the Software is furnished to do so, subject to\0A# the following conditions:\0A#\0A# The above copyright notice and this permission notice shall be\0A# included in all copies or substantial portions of the Software.\0A#\0A# THE SOFTWARE IS PROVIDED \22AS IS\22, WITHOUT WARRANTY OF ANY KIND,\0A# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\0A# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND\0A# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE\0A# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION\0A# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION\0A# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\0A\0A# virtualenv activation module\0A# Activate with `overlay use activate.nu`\0A# Deactivate with `deactivate`, as usual\0A#\0A# To customize the overlay name, you can call `overlay use activate.nu as foo`,\0A# but then simply `deactivate` won't work because it is just an alias to hide\0A# the \22activate\22 overlay. You'd need to call `overlay hide foo` manually.\0A\0Aexport-env {\0A    def is-string [x] {\0A        ($x | describe) == 'string'\0A    }\0A\0A    def has-env [...names] {\0A        $names | each {|n|\0A            $n in $env\0A        } | all {|i| $i == true}\0A    }\0A\0A    # Emulates a `test -z`, but better as it handles e.g 'false'\0A    def is-env-true [name: string] {\0A      if (has-env $name) {\0A        # Try to parse 'true', '0', '1', and fail if not convertible\0A        let parsed = (do -i { $env | get $name | into bool })\0A        if ($parsed | describe) == 'bool' {\0A          $parsed\0A        } else {\0A          not ($env | get -i $name | is-empty)\0A        }\0A      } else {\0A        false\0A      }\0A    }\0A\0A    let virtual_env = '{{ VIRTUAL_ENV_DIR }}'\0A    let bin = '{{ BIN_NAME }}'\0A\0A    let is_windows = ($nu.os-info.family) == 'windows'\0A    let path_name = (if (has-env 'Path') {\0A            'Path'\0A        } else {\0A            'PATH'\0A        }\0A    )\0A\0A    let venv_path = ([$virtual_env $bin] | path join)\0A    let new_path = ($env | get $path_name | prepend $venv_path)\0A\0A    # If there is no default prompt, then use the env name instead\0A    let virtual_env_prompt = (if ('{{ VIRTUAL_PROMPT }}' | is-empty) {\0A        ($virtual_env | path basename)\0A    } else {\0A        '{{ VIRTUAL_PROMPT }}'\0A    })\0A\0A    let new_env = {\0A        $path_name         : $new_path\0A        VIRTUAL_ENV        : $virtual_env\0A        VIRTUAL_ENV_PROMPT : $virtual_env_prompt\0A    }\0A\0A    let new_env = (if (is-env-true 'VIRTUAL_ENV_DISABLE_PROMPT') {\0A      $new_env\0A    } else {\0A      # Creating the new prompt for the session\0A      let virtual_prefix = $'(char lparen)($virtual_env_prompt)(char rparen) '\0A\0A      # Back up the old prompt builder\0A      let old_prompt_command = (if (has-env 'PROMPT_COMMAND') {\0A              $env.PROMPT_COMMAND\0A          } else {\0A              ''\0A        })\0A\0A      let new_prompt = (if (has-env 'PROMPT_COMMAND') {\0A          if 'closure' in ($old_prompt_command | describe) {\0A              {|| $'($virtual_prefix)(do $old_prompt_command)' }\0A          } else {\0A              {|| $'($virtual_prefix)($old_prompt_command)' }\0A          }\0A      } else {\0A          {|| $'($virtual_prefix)' }\0A      })\0A\0A      $new_env | merge {\0A        PROMPT_COMMAND      : $new_prompt\0A        VIRTUAL_PREFIX      : $virtual_prefix\0A      }\0A    })\0A\0A    # Environment variables that will be loaded as the virtual env\0A    load-env $new_env\0A}\0A\0Aexport alias pydoc = python -m pydoc\0Aexport alias deactivate = overlay hide activate\0A" }>, align 1
