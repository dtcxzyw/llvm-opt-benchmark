             setattr(spec.loader, func_name, partial(func, old))\0A                            except AttributeError:\0A                                pass  # C-Extension loaders are r/o such as zipimporter with <3.7\0A                        return spec\0A                finally:\0A                    self.fullname = None\0A        return None\0A\0A    @staticmethod\0A    def exec_module(old, module):\0A        old(module)\0A        if module.__name__ in _DISTUTILS_PATCH:\0A            patch_dist(module)\0A\0A    @staticmethod\0A    def load_module(old, name):\0A        module = old(name)\0A        if module.__name__ in _DISTUTILS_PATCH:\0A            patch_dist(module)\0A        return module\0A\0A\0Asys.meta_path.insert(0, _Finder())\0A" }>, align 1
