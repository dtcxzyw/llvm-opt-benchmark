@anon.c8777b812d6b35c09a8e6156f259107b.590 = private unnamed_addr constant <{ [657 x i8] }> <{ [657 x i8] c"The Python interpreter into which packages should be installed.\0A\0ABy default, uv installs into the virtual environment in the current working directory or any parent directory. The `--python` option allows you to specify a different interpreter, which is intended for use in continuous integration (CI) environments or other automated workflows.\0A\0ASupported formats: - `3.10` looks for an installed Python 3.10 in the registry on Windows (see `py --list-paths`), or `python3.10` on Linux and macOS. - `python3.10` or `python.exe` looks for a binary with the given name in `PATH`. - `/home/ferris/.local/bin/python3.10` uses the exact Python at the given path." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.591 = private unnamed_addr constant <{ [426 x i8] }> <{ [426 x i8] c"Install packages into the system Python environment.\0A\0ABy default, uv installs into the virtual environment in the current working directory or any parent directory. The `--system` option instructs uv to instead use the first Python found in the system `PATH`.\0A\0AWARNING: `--system` is intended for use in continuous integration (CI) environments and should be used with caution, as it can modify the system Python installation." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.592 = private unnamed_addr constant <{ [415 x i8] }> <{ [415 x i8] c"Allow uv to modify an `EXTERNALLY-MANAGED` Python installation.\0A\0AWARNING: `--break-system-packages` is intended for use in continuous integration (CI) environments, when installing into Python installations that are managed by an external package manager, like `apt`. It should be used with caution, as such Python installations explicitly recommend against modifications by other package managers (like uv or pip)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.593 = private unnamed_addr constant <{ [171 x i8] }> <{ [171 x i8] c"Install packages into the specified directory, rather than into the virtual or system Python environment. The packages will be installed at the top-level of the directory." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.594 = private unnamed_addr constant <{ [428 x i8] }> <{ [428 x i8] c"Install packages into `lib`, `bin`, and other top-level folders under the specified directory, as if a virtual environment were present at that location.\0A\0AIn general, prefer the use of `--python` to install into an alternate environment, as scripts and other artifacts installed via `--prefix` will reference the installing interpreter, rather than any interpreter added to the `--prefix` directory, rendering them non-portable." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.595 = private unnamed_addr constant <{ [374 x i8] }> <{ [374 x i8] c"The URL of the Python package index (by default: <https://pypi.org/simple>).\0A\0AAccepts either a repository compliant with [PEP 503](https://peps.python.org/pep-0503/) (the simple repository API), or a local directory laid out in the same format.\0A\0AThe index provided by this setting is given lower priority than any indexes specified via [`extra_index_url`](#extra-index-url)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.596 = private unnamed_addr constant <{ [519 x i8] }> <{ [519 x i8] c"Extra URLs of package indexes to use, in addition to `--index-url`.\0A\0AAccepts either a repository compliant with [PEP 503](https://peps.python.org/pep-0503/) (the simple repository API), or a local directory laid out in the same format.\0A\0AAll indexes provided via this flag take priority over the index specified by [`index_url`](#index-url). When multiple indexes are provided, earlier values take priority.\0A\0ATo control uv's resolution strategy when multiple indexes are present, see [`index_strategy`](#index-strategy)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.597 = private unnamed_addr constant <{ [276 x i8] }> <{ [276 x i8] c"Don't build source distributions.\0A\0AWhen enabled, resolving will not run arbitrary Python code. The cached wheels of already-built source distributions will be reused, but operations that require building distributions will exit with an error.\0A\0AAlias for `--only-binary :all:`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.598 = private unnamed_addr constant <{ [315 x i8] }> <{ [315 x i8] c"Don't install pre-built wheels.\0A\0AThe given packages will be built and installed from source. The resolver will still use pre-built wheels to extract package metadata, if available.\0A\0AMultiple packages may be provided. Disable binaries for all packages with `:all:`. Clear previously specified packages with `:none:`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.599 = private unnamed_addr constant <{ [411 x i8] }> <{ [411 x i8] c"Only use pre-built wheels; don't build source distributions.\0A\0AWhen enabled, resolving will not run code from the given packages. The cached wheels of already-built source distributions will be reused, but operations that require building distributions will exit with an error.\0A\0AMultiple packages may be provided. Disable binaries for all packages with `:all:`. Clear previously specified packages with `:none:`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.600 = private unnamed_addr constant <{ [95 x i8] }> <{ [95 x i8] c"Validate the Python environment, to detect packages with missing dependencies and other issues." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.601 = private unnamed_addr constant <{ [134 x i8] }> <{ [134 x i8] c"Ignore package dependencies, instead only add those packages explicitly listed on the command line to the resulting requirements file." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.602 = private unnamed_addr constant <{ [94 x i8] }> <{ [94 x i8] c"Allow `uv pip sync` with empty requirements, which will clear the environment of all packages." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.603 = private unnamed_addr constant <{ [226 x i8] }> <{ [226 x i8] c"Write the requirements generated by `uv pip compile` to the given `requirements.txt` file.\0A\0AIf the file already exists, the existing versions will be preferred when resolving dependencies, unless `--upgrade` is also specified." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.604 = private unnamed_addr constant <{ [301 x i8] }> <{ [301 x i8] c"Include extras in the output file.\0A\0ABy default, uv strips extras, as any packages pulled in by the extras are already included as dependencies in the output file directly. Further, output files generated with `--no-strip-extras` cannot be used as constraints files in `install` and `sync` invocations." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.605 = private unnamed_addr constant <{ [223 x i8] }> <{ [223 x i8] c"Include environment markers in the output file generated by `uv pip compile`.\0A\0ABy default, uv strips environment markers, as the resolution generated by `compile` is only guaranteed to be correct for the target environment." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.606 = private unnamed_addr constant <{ [117 x i8] }> <{ [117 x i8] c"Exclude comment annotations indicating the source of each package from the output file generated by `uv pip compile`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.607 = private unnamed_addr constant <{ [218 x i8] }> <{ [218 x i8] c"The minimum Python version that should be supported by the resolved requirements (e.g., `3.8` or `3.8.17`).\0A\0AIf a patch version is omitted, the minimum patch version is assumed. For example, `3.8` is mapped to `3.8.0`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.608 = private unnamed_addr constant <{ [249 x i8] }> <{ [249 x i8] c"The platform for which requirements should be resolved.\0A\0ARepresented as a \22target triple\22, a string that describes the target platform in terms of its CPU, vendor, and operating system name, like `x86_64-unknown-linux-gnu` or `aarch64-apple-darwin`." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.609 = private unnamed_addr constant <{ [414 x i8] }> <{ [414 x i8] c"Perform a universal resolution, attempting to generate a single `requirements.txt` output file that is compatible with all operating systems, architectures, and Python implementations.\0A\0AIn universal mode, the current Python version (or user-provided `--python-version`) will be treated as a lower bound. For example, `--universal --python-version 3.7` would produce a universal resolution for Python 3.7 and later." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.610 = private unnamed_addr constant <{ [295 x i8] }> <{ [295 x i8] c"Limit candidate packages to those that were uploaded prior to a given point in time.\0A\0AAccepts a superset of [RFC 3339](https://www.rfc-editor.org/rfc/rfc3339.html) (e.g., `2006-12-02T02:07:43Z`). A full timestamp is required to ensure that the resolver will behave consistently across timezones." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.611 = private unnamed_addr constant <{ [167 x i8] }> <{ [167 x i8] c"Specify a package to omit from the output resolution. Its dependencies will still be included in the resolution. Equivalent to pip-compile's `--unsafe-package` option." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.612 = private unnamed_addr constant <{ [265 x i8] }> <{ [265 x i8] c"Whether to emit a marker string indicating the conditions under which the set of pinned dependencies is valid.\0A\0AThe pinned dependencies may be valid even when the marker expression is false, but when the expression is true, the requirements are known to be correct." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.613 = private unnamed_addr constant <{ [119 x i8] }> <{ [119 x i8] c"Include comment annotations indicating the index used to resolve each package (e.g., `# from https://pypi.org/simple`)." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.614 = private unnamed_addr constant <{ [110 x i8] }> <{ [110 x i8] c"The style of the annotation comments included in the output file, used to indicate the source of each package." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.615 = private unnamed_addr constant <{ [610 x i8] }> <{ [610 x i8] c"Require a matching hash for each requirement.\0A\0AHash-checking mode is all or nothing. If enabled, _all_ requirements must be provided with a corresponding hash or set of hashes. Additionally, if enabled, _all_ requirements must either be pinned to exact versions (e.g., `==1.0.0`), or be specified via direct URL.\0A\0AHash-checking mode introduces a number of additional constraints:\0A\0A- Git dependencies are not supported. - Editable installs are not supported. - Local dependencies are not supported, unless they point to a specific wheel (`.whl`) or source archive (`.zip`, `.tar.gz`), as opposed to a directory." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.616 = private unnamed_addr constant <{ [250 x i8] }> <{ [250 x i8] c"Validate any hashes provided in the requirements file.\0A\0AUnlike `--require-hashes`, `--verify-hashes` does not require that all requirements have hashes; instead, it will limit itself to verifying the hashes of those requirements that do include them." }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.617 = private unnamed_addr constant <{ [521 x i8] }> <{ [521 x i8] c"The backend to use when fetching packages in the PyTorch ecosystem.\0A\0AWhen set, uv will ignore the configured index URLs for packages in the PyTorch ecosystem, and will instead use the defined backend.\0A\0AFor example, when set to `cpu`, uv will use the CPU-only PyTorch index; when set to `cu126`, uv will use the PyTorch index for CUDA 12.6.\0A\0AThe `auto` mode will attempt to detect the appropriate PyTorch index based on the currently installed CUDA drivers.\0A\0AThis option is in preview and may change in any future release." }>, align 1
