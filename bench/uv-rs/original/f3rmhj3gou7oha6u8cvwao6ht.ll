@anon.c8777b812d6b35c09a8e6156f259107b.382 = private unnamed_addr constant <{ ptr, [8 x i8] }> <{ ptr @anon.c8777b812d6b35c09a8e6156f259107b.381, [8 x i8] c"`\00\00\00\00\00\00\00" }>, align 8
@anon.c8777b812d6b35c09a8e6156f259107b.383 = private unnamed_addr constant <{ [21 x i8] }> <{ [21 x i8] c"python-install-mirror" }>, align 1
@anon.c8777b812d6b35c09a8e6156f259107b.384 = private unnamed_addr constant <{ [494 x i8] }> <{ [494 x i8] c"Mirror URL to use for downloading managed PyPy installations.\0A\0ABy default, managed PyPy installations are downloaded from [downloads.python.org](https://downloads.python.org/).\0AThis variable can be set to a mirror URL to use a different source for PyPy installations.\0AThe provided URL will replace `https://downloads.python.org/pypy` in, e.g., `https://downloads.python.org/pypy/pypy3.8-v7.3.7-osx64.tar.bz2`.\0A\0ADistributions can be read from a\0Alocal directory by using the `file://` URL scheme." }>, align 1
