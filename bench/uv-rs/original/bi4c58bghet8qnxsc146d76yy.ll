@anon.3aa18e283ff517eb43af79d2053ec9e5.98 = private unnamed_addr constant <{ [308 x i8] }> <{ [308 x i8] c"The name of the index.\0A\0AIndex names can be used to reference indexes elsewhere in the configuration. For example, you can pin a package to a specific index by name:\0A\0A```toml [[tool.uv.index]] name = \22pytorch\22 url = \22https://download.pytorch.org/whl/cu121\22\0A\0A[tool.uv.sources] torch = { index = \22pytorch\22 } ```" }>, align 1
@anon.3aa18e283ff517eb43af79d2053ec9e5.99 = private unnamed_addr constant <{ [4 x i8] }> <{ [4 x i8] c"name" }>, align 1
