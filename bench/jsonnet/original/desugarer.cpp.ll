ength 1 or greater, got ' + std.length(c);\0A    assert std.isNumber(maxsplits) : 'str.splitLimitR third parameter must be a Number, got ' + std.type(maxsplits);\0A    if maxsplits == -1 then\0A      std.splitLimit(str, c, -1)\0A    else\0A      local revStr(str) = std.join('', std.reverse(std.stringChars(str)));\0A      std.map(function(e) revStr(e), std.reverse(std.splitLimit(revStr(str), revStr(c), maxsplits))),\0A\0A  strReplace(str, from, to)::\0A    assert std.isString(str);\0A    assert std.isString(from);\0A    assert std.isString(to);\0A    assert from != '' : \22'from' string must not be zero length.\22;\0A\0A    // Cache for performance.\0A    local str_len = std.length(str);\0A    local from_len = std.length(from);\0A\0A    // True if from is at str[i].\0A    local found_at(i) = str[i:i + from_len] == from;\0A\0A    // Return the remainder of 'str' starting with 'start_index' where\0A    // all occurrences of 'from' after 'curr_index' are replaced with 'to'.\0A    local replace_after(start_index, curr_index, acc) =\0A      if curr_index > str_len then\0A        acc + str[start_index:curr_index]\0A      else if found_at(curr_index) then\0A        local new_index = curr_index + std.length(from);\0A        replace_after(new_index, new_index, acc + str[start_index:curr_index] + to) tailstrict\0A      else\0A        replace_after(start_index, curr_index + 1, acc) tailstrict;\0A\0A    // if from_len==1, then we replace by splitting and rejoining the\0A    // string which is much faster than recursing on replace_after\0A    if from_len == 1 then\0A      std.join(to, std.split(str, from))\0A    else\0A      replace_after(0, 0, ''),\0A\0A  asciiUpper(str)::\0A    local cp = std.codepoint;\0A    local up_letter(c) = if cp(c) >= 97 && cp(c) < 123 then\0A      std.char(cp(c) - 32)\0A    else\0A      c;\0A    std.join('', std.map(up_letter, std.stringChars(str))),\0A\0A  asciiLower(str)::\0A    local cp = std.codepoint;\0A    local down_letter(c) = if cp(c) >= 65 && 