 else error ('std.flatMap second param must be array / string, got ' + std.type(arr)),\0A\0A  join(sep, arr)::\0A    local aux(arr, i, first, running) =\0A      if i >= std.length(arr) then\0A        running\0A      else if arr[i] == null then\0A        aux(arr, i + 1, first, running) tailstrict\0A      else if std.type(arr[i]) != std.type(sep) then\0A        error 'expected %s but arr[%d] was %s ' % [std.type(sep), i, std.type(arr[i])]\0A      else if first then\0A        aux(arr, i + 1, false, running + arr[i]) tailstrict\0A      else\0A        aux(arr, i + 1, false, running + sep + arr[i]) tailstrict;\0A    if !std.isArray(arr) then\0A      error 'join second parameter should be array, got ' + std.type(arr)\0A    else if std.isString(sep) then\0A      aux(arr, 0, true, '')\0A    else if std.isArray(sep) then\0A      aux(arr, 0, true, [])\0A    else\0A      error 'join first parameter should be string or array, got ' + std.type(sep),\0A\0A  lines(arr)::\0A    std.join('\\n', arr + ['']),\0A\0A  deepJoin(arr)::\0A    if std.isString(arr) then\0A      arr\0A    else if std.isArray(arr) then\0A      std.join('', [std.deepJoin(x) for x in arr])\0A    else\0A      error 'Expected string or array, got %s' % std.type(arr),\0A\0A\0A  format(str, vals)::\0A\0A    /////////////////////////////\0A    // Parse the mini-language //\0A    /////////////////////////////\0A\0A    local try_parse_mapping_key(str, i) =\0A      assert i < std.length(str) : 'Truncated format code.';\0A      local c = str[i];\0A      if c == '(' then\0A        local consume(str, j, v) =\0A          if j >= std.length(str) then\0A            error 'Truncated format code.'\0A          else\0A            local c = str[j];\0A            if c != ')' then\0A              consume(str, j + 1, v + c)\0A            else\0A              { i: j + 1, v: v };\0A        consume(str, i + 1, '')\0A      else\0A        { i: i, v: null };\0A\0A    local try_parse_cflags(str, i) =\0A      local consume(str, j, v) =\0A    