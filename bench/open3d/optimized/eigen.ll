@.str.240 = private unnamed_addr constant [943 x i8] c"Convert int32 numpy array of shape ``(n, 3)`` to Open3D format..\0A\0AExample usage\0A\0A.. code-block:: python\0A\0A    import open3d\0A    import numpy as np\0A\0A    # Example mesh\0A    # x, y coordinates:\0A    # [0: (-1, 2)]__________[1: (1, 2)]\0A    #             \\        /\\\0A    #              \\  (0) /  \\\0A    #               \\    / (1)\\\0A    #                \\  /      \\\0A    #      [2: (0, 0)]\\/________\\[3: (2, 0)]\0A    #\0A    # z coordinate: 0\0A\0A    mesh = open3d.geometry.TriangleMesh()\0A    np_vertices = np.array([[-1, 2, 0],\0A                            [1, 2, 0],\0A                            [0, 0, 0],\0A                            [2, 0, 0]])\0A    np_triangles = np.array([[0, 2, 1],\0A                             [1, 2, 3]]).astype(np.int32)\0A    mesh.vertices = open3d.Vector3dVector(np_vertices)\0A\0A    # From numpy to Open3D\0A    mesh.triangles = open3d.Vector3iVector(np_triangles)\0A\0A    # From Open3D to numpy\0A    np_triangles = np.asarray(mesh.triangles)\0A\00", align 1
