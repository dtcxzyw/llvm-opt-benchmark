@.str.6 = private unnamed_addr constant [2598 x i8] c"\0AA triangle mesh contains vertices and triangles. The triangle mesh class stores\0Athe attribute data in key-value maps. There are two maps: the vertex attributes\0Amap, and the triangle attribute map.\0A\0AThe attributes of the triangle mesh have different levels::\0A\0A    import open3d as o3d\0A\0A    device = o3d.core.Device(\22CPU:0\22)\0A    dtype_f = o3d.core.float32\0A    dtype_i = o3d.core.int32\0A\0A    # Create an empty triangle mesh\0A    # Use mesh.vertex to access the vertices' attributes\0A    # Use mesh.triangle to access the triangles' attributes\0A    mesh = o3d.t.geometry.TriangleMesh(device)\0A\0A    # Default attribute: vertex.positions, triangle.indices\0A    # These attributes is created by default and is required by all triangle\0A    # meshes. The shape of both must be (N, 3). The device of \22positions\22\0A    # determines the device of the triangle mesh.\0A    mesh.vertex.positions = o3d.core.Tensor([[0, 0, 0],\0A                                                [0, 0, 1],\0A                                                [0, 1, 0],\0A                                                [0, 1, 1]], dtype_f, device)\0A    mesh.triangle.indices = o3d.core.Tensor([[0, 1, 2],\0A                                                [0, 2, 3]]], dtype_i, device)\0A\0A    # Common attributes: vertex.colors  , vertex.normals\0A    #                    triangle.colors, triangle.normals\0A    # Common attributes are used in built-in triangle mesh operations. The\0A    # spellings must be correct. For example, if \22normal\22 is used instead of\0A    # \22normals\22, some internal operations that expects \22normals\22 will not work.\0A    # \22normals\22 and \22colors\22 must have shape (N, 3) and must be on the same\0A    # device as the triangle mesh.\0A    mesh.vertex.normals = o3d.core.Tensor([[0, 0, 1],\0A                                              [0, 1, 0],\0A                                              [1, 0, 0],\0A                                              [1, 1, 1]], dtype_f, device)\0A    mesh.vertex.colors = o3d.core.Tensor([[0.0, 0.0, 0.0],\0A                                             [0.1, 0.1, 0.1],\0A                                             [0.2, 0.2, 0.2],\0A                                             [0.3, 0.3, 0.3]], dtype_f, device)\0A    mesh.triangle.normals = o3d.core.Tensor(...)\0A    mesh.triangle.colors = o3d.core.Tensor(...)\0A\0A    # User-defined attributes\0A    # You can also attach custom attributes. The value tensor must be on the\0A    # same device as the triangle mesh. The are no restrictions on the shape and\0A    # dtype, e.g.,\0A    pcd.vertex.labels = o3d.core.Tensor(...)\0A    pcd.triangle.features = o3d.core.Tensor(...)\0A\00", align 1
