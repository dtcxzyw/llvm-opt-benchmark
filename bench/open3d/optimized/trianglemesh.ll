@.str.180 = private unnamed_addr constant [590 x i8] c"Fill holes by triangulating boundary edges.\0A\0AThis function always uses the CPU device.\0A\0AArgs:\0A    hole_size (float): This is the approximate threshold for filling holes.\0A        The value describes the maximum radius of holes to be filled.\0A\0AReturns:\0A    New mesh after filling holes.\0A\0AExample:\0A    Fill holes at the bottom of the Stanford Bunny mesh::\0A\0A        bunny = o3d.data.BunnyMesh()\0A        mesh = o3d.t.geometry.TriangleMesh.from_legacy(o3d.io.read_triangle_mesh(bunny.path))\0A        filled = mesh.fill_holes()\0A        o3d.visualization.draw([{'name': 'filled', 'geometry': ans}])\0A\00", align 1
