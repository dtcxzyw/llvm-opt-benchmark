@.str.146 = private unnamed_addr constant [1242 x i8] c"Cluster PointCloud using the DBSCAN algorithm  Ester et al.,'A\0ADensity-Based Algorithm for Discovering Clusters in Large Spatial Databases\0Awith Noise', 1996. This is a wrapper for a CPU implementation and a copy of the\0Apoint cloud data and resulting labels will be made.\0A\0AArgs:\0A    eps: Density parameter that is used to find neighbouring points.\0A\0A    min_points: Minimum number of points to form a cluster.\0A\0Aprint_progress (default False): If 'True' the progress is visualized in the console.\0A\0AReturn:\0A    A Tensor list of point labels on the same device as the point cloud, -1\0A    indicates noise according to the algorithm.\0A\0AExample:\0A\0A    We use Redwood dataset for demonstration::\0A\0A        import matplotlib.pyplot as plt\0A\0A        sample_ply_data = o3d.data.PLYPointCloud()\0A        pcd = o3d.t.io.read_point_cloud(sample_ply_data.path)\0A        labels = pcd.cluster_dbscan(eps=0.02, min_points=10, print_progress=True)\0A\0A        max_label = labels.max().item()\0A        colors = plt.get_cmap(\22tab20\22)(\0A                labels.numpy() / (max_label if max_label > 0 else 1))\0A        colors = o3d.core.Tensor(colors[:, :3], o3d.core.float32)\0A        colors[labels < 0] = 0\0A        pcd.point.colors = colors\0A        o3d.visualization.draw([pcd])\00", align 1
