@.str.18 = private unnamed_addr constant [1106 x i8] c"Perform knn search.\0A\0ANote:\0A    To use knn_search initialize the index using knn_index before calling this function.\0A\0AArgs:\0A    query_points (open3d.core.Tensor): Query points with shape {n, d}.\0A    knn (int): Number of neighbors to search per query point.\0A\0AExample:\0A    The following searches the 3 nearest neighbors for random dataset and query points::\0A\0A        import open3d as o3d\0A        import numpy as np\0A\0A        dataset = np.random.rand(10,3)\0A        query_points = np.random.rand(5,3)\0A\0A        nns = o3d.core.nns.NearestNeighborSearch(dataset)\0A\0A        # initialize the knn_index before we can use knn_search\0A        nns.knn_index()\0A\0A        # perform knn search to get the 3 closest points with respect to the \0A        # Euclidean distance. The returned distance is given as the squared\0A        # distances\0A        indices, squared_distances = nns.knn_search(query_points, knn=3)\0A\0AReturns:\0A    Tuple of Tensors (indices, squared_distances).\0A        - indices: Tensor of shape {n, knn}.\0A        - squared_distances: Tensor of shape {n, knn}. The distances are squared L2 distances.\0A\0A            \00", align 1
@.str.19 = private unnamed_addr constant [20 x i8] c"fixed_radius_search\00", align 1
@.str.20 = private unnamed_addr constant [5 x i8] c"sort\00", align 1
@.str.21 = private unnamed_addr constant [2130 x i8] c"Perform fixed-radius search.\0A\0ANote:\0A    To use fixed_radius_search initialize the index using fixed_radius_index before calling this function.\0A\0AArgs:\0A        query_points (open3d.core.Tensor): Query points with shape {n, d}.\0A        radius (float): Radius value for fixed-radius search. Note that this\0A            parameter can differ from the radius used to initialize the index\0A            for convenience, which may cause the index to be rebuilt for GPU \0A            devices.\0A        sort (bool, optional): Sort the results by distance. Default is True.\0A\0AReturns:\0A        Tuple of Tensors (indices, splits, distances).\0A            - indices: The indices of the neighbors.\0A            - distances: The squared L2 distances.\0A            - splits: The splits of the indices and distances defining the start \0A                and exclusive end of each query point's neighbors. The shape is {num_queries+1}\0A\0AExample:\0A    The following searches the neighbors within a radius of 1.0 a set of data and query points::\0A\0A        # define data and query points\0A        points = np.array([\0A        [0.1,0.1,0.1],\0A        [0.9,0.9,0.9],\0A        [0.5,0.5,0.5],\0A        [1.7,1.7,1.7],\0A        [1.8,1.8,1.8],\0A        [0.3,2.4,1.4]], dtype=np.float32)\0A\0A        queries = np.array([\0A        [1.0,1.0,1.0],\0A        [0.5,2.0,2.0],\0A        [0.5,2.1,2.1],\0A        [100,100,100],\0A        ], dtype=np.float32)\0A\0A        nns = o3d.core.nns.NearestNeighborSearch(points)\0A        nns.fixed_radius_index(radius=1.0)\0A\0A        neighbors_index, neighbors_distance, neighbors_splits = nns.fixed_radius_search(queries, radius=1.0, sort=True)\0A        # returns neighbors_index      = [1, 2, 5, 5]\0A        #         neighbors_distance   = [0.03 0.75 0.56000006 0.62]\0A        #         neighbors_splits = [0, 2, 3, 4, 4]\0A\0A        for i, (start_i, end_i) in enumerate(zip(neighbors_splits, neighbors_splits[1:])):\0A        start_i = start_i.item()\0A        end_i = end_i.item()\0A        print(f\22query_point {i} has the neighbors {neighbors_index[start_i:end_i].numpy()} \22\0A              f\22with squared distances {neighbors_distance[start_i:end_i].numpy()}\22)\0A            \00", align 1
@.str.22 = private unnamed_addr constant [20 x i8] c"multi_radius_search\00", align 1
@.str.23 = private unnamed_addr constant [6 x i8] c"radii\00", align 1
@.str.24 = private unnamed_addr constant [1990 x i8] c"Perform multi-radius search. Each query point has an independent radius.\0A\0ANote:\0A    To use multi_radius_search initialize the index using multi_radius_index before calling this function.\0A\0AArgs:\0A    query_points (open3d.core.Tensor): Query points with shape {n, d}.\0A    radii (open3d.core.Tensor): Radii of query points. Each query point has one radius.\0A\0AReturns:\0A        Tuple of Tensors (indices, splits, distances).\0A            - indices: The indices of the neighbors.\0A            - distances: The squared L2 distances.\0A            - splits: The splits of the indices and distances defining the start \0A                and exclusive end of each query point's neighbors. The shape is {num_queries+1}\0A\0AExample:\0A    The following searches the neighbors with an individual radius for each query point::\0A\0A        # define data, query points and radii\0A        points = np.array([\0A        [0.1,0.1,0.1],\0A        [0.9,0.9,0.9],\0A        [0.5,0.5,0.5],\0A        [1.7,1.7,1.7],\0A        [1.8,1.8,1.8],\0A        [0.3,2.4,1.4]], dtype=np.float32)\0A\0A        queries = np.array([\0A            [1.0,1.0,1.0],\0A            [0.5,2.0,2.0],\0A            [0.5,2.1,2.1],\0A            [100,100,100],\0A        ], dtype=np.float32)\0A\0A        radii = np.array([0.5, 1.0, 1.5, 2], dtype=np.float32)\0A\0A        nns = o3d.core.nns.NearestNeighborSearch(points)\0A\0A        nns.multi_radius_index()\0A\0A        neighbors_index, neighbors_distance, neighbors_splits = nns.multi_radius_search(queries, radii)\0A        # returns neighbors_index      = [1 5 5 3 4]\0A        #         neighbors_distance   = [0.03 0.56 0.62 1.76 1.87]\0A        #         neighbors_splits = [0 1 2 5 5]\0A\0A\0A        for i, (start_i, end_i) in enumerate(zip(neighbors_splits, neighbors_splits[1:])):\0A            start_i = start_i.item()\0A            end_i = end_i.item()\0A            print(f\22query_point {i} has the neighbors {neighbors_index[start_i:end_i].numpy()} \22\0A                f\22with squared distances {neighbors_distance[start_i:end_i].numpy()}\22)\0A            \00", align 1
@.str.25 = private unnamed_addr constant [14 x i8] c"hybrid_search\00", align 1
@.str.26 = private unnamed_addr constant [8 x i8] c"max_knn\00", align 1
@.str.27 = private unnamed_addr constant [1019 x i8] c"Perform hybrid search.\0A\0AHybrid search behaves similarly to fixed-radius search, but with a maximum number of neighbors to search per query point.\0A\0ANote:\0A    To use hybrid_search initialize the index using hybrid_index before calling this function.\0A\0AArgs:\0A    query_points (open3d.core.Tensor): Query points with shape {n, d}.\0A    radius (float): Radius value for hybrid search.\0A    max_knn (int): Maximum number of neighbor to search per query.\0A\0AReturns:\0A        Tuple of Tensors (indices, distances, counts)\0A            - indices: The indices of the neighbors with shape {n, max_knn}.\0A                If there are less than max_knn neighbors within the radius then the\0A                last entries are padded with -1.\0A            - distances: The squared L2 distances with shape {n, max_knn}.\0A                If there are less than max_knn neighbors within the radius then the\0A                last entries are padded with 0.\0A            - counts: Counts of neighbour for each query points with shape {n}.\0A            \00", align 1
