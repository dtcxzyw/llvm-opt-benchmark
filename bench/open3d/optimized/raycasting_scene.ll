@.str = private unnamed_addr constant [16 x i8] c"RaycastingScene\00", align 1
@.str.6 = private unnamed_addr constant [1350 x i8] c"\0AA scene class with basic ray casting and closest point queries.\0A\0AThe RaycastingScene allows to compute ray intersections with triangle meshes\0Aor compute the closest point on the surface of a mesh with respect to one\0Aor more query points.\0AIt builds an internal acceleration structure to speed up those queries.\0A\0AThis class supports the CPU device and SYCL GPU device.\0A\0AThe following shows how to create a scene and compute ray intersections::\0A\0A    import open3d as o3d\0A    import matplotlib.pyplot as plt\0A\0A    cube = o3d.t.geometry.TriangleMesh.from_legacy(\0A                                        o3d.geometry.TriangleMesh.create_box())\0A\0A    # Create scene and add the cube mesh\0A    scene = o3d.t.geometry.RaycastingScene()\0A    scene.add_triangles(cube)\0A\0A    # Rays are 6D vectors with origin and ray direction.\0A    # Here we use a helper function to create rays for a pinhole camera.\0A    rays = scene.create_rays_pinhole(fov_deg=60,\0A                                     center=[0.5,0.5,0.5],\0A                                     eye=[-1,-1,-1],\0A                                     up=[0,0,1],\0A                                     width_px=320,\0A                                     height_px=240)\0A\0A    # Compute the ray intersections.\0A    ans = scene.cast_rays(rays)\0A\0A    # Visualize the hit distance (depth)\0A    plt.imshow(ans['t_hit'].numpy())\0A\0A\00", align 1
@.str.7 = private unnamed_addr constant [9 x i8] c"nthreads\00", align 1
@.str.8 = private unnamed_addr constant [6 x i8] c"CPU:0\00", align 1
@.str.9 = private unnamed_addr constant [7 x i8] c"device\00", align 1
@.str.10 = private unnamed_addr constant [230 x i8] c"\0ACreate a RaycastingScene.\0A\0AArgs:\0A    nthreads (int): The number of threads to use for building the scene. Set to 0 for automatic.\0A    device (open3d.core.Device): The device to use. Currently CPU and SYCL devices are supported.\0A\00", align 1
@.str.11 = private unnamed_addr constant [14 x i8] c"add_triangles\00", align 1
@.str.12 = private unnamed_addr constant [17 x i8] c"vertex_positions\00", align 1
@.str.13 = private unnamed_addr constant [17 x i8] c"triangle_indices\00", align 1
@.str.14 = private unnamed_addr constant [281 x i8] c"\0AAdd a triangle mesh to the scene.\0A\0AArgs:\0A    vertices (open3d.core.Tensor): Vertices as Tensor of dim {N,3} and dtype\0A        Float32.\0A    triangles (open3d.core.Tensor): Triangles as Tensor of dim {M,3} and dtype\0A        UInt32.\0A\0AReturns:\0A    The geometry ID of the added mesh.\0A\00", align 1
@.str.15 = private unnamed_addr constant [5 x i8] c"mesh\00", align 1
@.str.16 = private unnamed_addr constant [152 x i8] c"\0AAdd a triangle mesh to the scene.\0A\0AArgs:\0A    mesh (open3d.t.geometry.TriangleMesh): A triangle mesh.\0A\0AReturns:\0A    The geometry ID of the added mesh.\0A\00", align 1
@.str.17 = private unnamed_addr constant [10 x i8] c"cast_rays\00", align 1
@.str.18 = private unnamed_addr constant [5 x i8] c"rays\00", align 1
@.str.19 = private unnamed_addr constant [1468 x i8] c"\0AComputes the first intersection of the rays with the scene.\0A\0AArgs:\0A    rays (open3d.core.Tensor): A tensor with >=2 dims, shape {.., 6}, and Dtype\0A        Float32 describing the rays.\0A        {..} can be any number of dimensions, e.g., to organize rays for\0A        creating an image the shape can be {height, width, 6}. The last\0A        dimension must be 6 and has the format [ox, oy, oz, dx, dy, dz]\0A        with [ox,oy,oz] as the origin and [dx,dy,dz] as the direction. It is\0A        not necessary to normalize the direction but the returned hit distance\0A        uses the length of the direction vector as unit.\0A\0A    nthreads (int): The number of threads to use. Set to 0 for automatic.\0A\0AReturns:\0A    A dictionary which contains the following keys\0A\0A    t_hit\0A        A tensor with the distance to the first hit. The shape is {..}. If there\0A        is no intersection the hit distance is *inf*.\0A\0A    geometry_ids\0A        A tensor with the geometry IDs. The shape is {..}. If there\0A        is no intersection the ID is *INVALID_ID*.\0A\0A    primitive_ids\0A        A tensor with the primitive IDs, which corresponds to the triangle\0A        index. The shape is {..}.  If there is no intersection the ID is\0A        *INVALID_ID*.\0A\0A    primitive_uvs\0A        A tensor with the barycentric coordinates of the hit points within the\0A        hit triangles. The shape is {.., 2}.\0A\0A    primitive_normals\0A        A tensor with the normals of the hit triangles. The shape is {.., 3}.\0A\00", align 1
@.str.20 = private unnamed_addr constant [16 x i8] c"test_occlusions\00", align 1
@.str.21 = private unnamed_addr constant [6 x i8] c"tnear\00", align 1
@.str.22 = private unnamed_addr constant [5 x i8] c"tfar\00", align 1
@.str.23 = private unnamed_addr constant [853 x i8] c"\0AChecks if the rays have any intersection with the scene.\0A\0AArgs:\0A    rays (open3d.core.Tensor): A tensor with >=2 dims, shape {.., 6}, and Dtype\0A        Float32 describing the rays.\0A        {..} can be any number of dimensions, e.g., to organize rays for\0A        creating an image the shape can be {height, width, 6}.\0A        The last dimension must be 6 and has the format [ox, oy, oz, dx, dy, dz]\0A        with [ox,oy,oz] as the origin and [dx,dy,dz] as the direction. It is not\0A        necessary to normalize the direction.\0A\0A    tnear (float): The tnear offset for the rays. The default is 0.\0A\0A    tfar (float): The tfar value for the ray. The default is infinity.\0A\0A    nthreads (int): The number of threads to use. Set to 0 for automatic.\0A\0AReturns:\0A    A boolean tensor which indicates if the ray is occluded by the scene (true)\0A    or not (false).\0A\00", align 1
@.str.24 = private unnamed_addr constant [20 x i8] c"count_intersections\00", align 1
@.str.25 = private unnamed_addr constant [685 x i8] c"\0AComputes the number of intersection of the rays with the scene.\0A\0AArgs:\0A    rays (open3d.core.Tensor): A tensor with >=2 dims, shape {.., 6}, and Dtype\0A        Float32 describing the rays.\0A        {..} can be any number of dimensions, e.g., to organize rays for\0A        creating an image the shape can be {height, width, 6}.\0A        The last dimension must be 6 and has the format [ox, oy, oz, dx, dy, dz]\0A        with [ox,oy,oz] as the origin and [dx,dy,dz] as the direction. It is not\0A        necessary to normalize the direction.\0A\0A    nthreads (int): The number of threads to use. Set to 0 for automatic.\0A\0AReturns:\0A    A tensor with the number of intersections. The shape is {..}.\0A\00", align 1
@.str.26 = private unnamed_addr constant [19 x i8] c"list_intersections\00", align 1
@.str.27 = private unnamed_addr constant [3549 x i8] c"\0ALists the intersections of the rays with the scene::\0A\0A    import open3d as o3d\0A    import numpy as np\0A\0A    # Create scene and add the monkey model.\0A    scene = o3d.t.geometry.RaycastingScene()\0A    d = o3d.data.MonkeyModel()\0A    mesh = o3d.t.io.read_triangle_mesh(d.path)\0A    mesh_id = scene.add_triangles(mesh)\0A\0A    # Create a grid of rays covering the bounding box\0A    bb_min = mesh.vertex['positions'].min(dim=0).numpy()\0A    bb_max = mesh.vertex['positions'].max(dim=0).numpy()\0A    x,y = np.linspace(bb_min, bb_max, num=10)[:,:2].T\0A    xv, yv = np.meshgrid(x,y)\0A    orig = np.stack([xv, yv, np.full_like(xv, bb_min[2]-1)], axis=-1).reshape(-1,3)\0A    dest = orig + np.full(orig.shape, (0,0,2+bb_max[2]-bb_min[2]),dtype=np.float32)\0A    rays = np.concatenate([orig, dest-orig], axis=-1).astype(np.float32)\0A\0A    # Compute the ray intersections.\0A    lx = scene.list_intersections(rays)\0A    lx = {k:v.numpy() for k,v in lx.items()}\0A\0A    # Calculate intersection coordinates using the primitive uvs and the mesh\0A    v = mesh.vertex['positions'].numpy()\0A    t = mesh.triangle['indices'].numpy()\0A    tidx = lx['primitive_ids']\0A    uv = lx['primitive_uvs']\0A    w = 1 - np.sum(uv, axis=1)\0A    c = \\\0A    v[t[tidx, 1].flatten(), :] * uv[:, 0][:, None] + \\\0A    v[t[tidx, 2].flatten(), :] * uv[:, 1][:, None] + \\\0A    v[t[tidx, 0].flatten(), :] * w[:, None]\0A\0A    # Calculate intersection coordinates using ray_ids\0A    c = rays[lx['ray_ids']][:,:3] + rays[lx['ray_ids']][:,3:]*lx['t_hit'][...,None]\0A\0A    # Visualize the rays and intersections.\0A    lines = o3d.t.geometry.LineSet()\0A    lines.point.positions = np.hstack([orig,dest]).reshape(-1,3)\0A    lines.line.indices = np.arange(lines.point.positions.shape[0]).reshape(-1,2)\0A    lines.line.colors = np.full((lines.line.indices.shape[0],3), (1,0,0))\0A    x = o3d.t.geometry.PointCloud(positions=c)\0A    o3d.visualization.draw([mesh, lines, x], point_size=8)\0A\0A\0AArgs:\0A    rays (open3d.core.Tensor): A tensor with >=2 dims, shape {.., 6}, and Dtype\0A        Float32 describing the rays; {..} can be any number of dimensions.\0A        The last dimension must be 6 and has the format [ox, oy, oz, dx, dy, dz]\0A        with [ox,oy,oz] as the origin and [dx,dy,dz] as the direction. It is not\0A        necessary to normalize the direction although it should be normalised if\0A        t_hit is to be calculated in coordinate units.\0A\0A    nthreads (int): The number of threads to use. Set to 0 for automatic.\0A\0AReturns:\0A    The returned dictionary contains\0A\0A    ray_splits\0A        A tensor with ray intersection splits. Can be used to iterate over all intersections for each ray. The shape is {num_rays + 1}.\0A\0A    ray_ids\0A        A tensor with ray IDs. The shape is {num_intersections}.\0A\0A    t_hit\0A        A tensor with the distance to the hit. The shape is {num_intersections}.\0A\0A    geometry_ids\0A        A tensor with the geometry IDs. The shape is {num_intersections}.\0A\0A    primitive_ids\0A        A tensor with the primitive IDs, which corresponds to the triangle\0A        index. The shape is {num_intersections}.\0A\0A    primitive_uvs\0A        A tensor with the barycentric coordinates of the intersection points within\0A        the triangles. The shape is {num_intersections, 2}.\0A\0A\0AAn example of using ray_splits::\0A\0A    ray_splits: [0, 2, 3, 6, 6, 8] # note that the length of this is num_rays+1\0A    t_hit: [t1, t2, t3, t4, t5, t6, t7, t8]\0A\0A    for ray_id, (start, end) in enumerate(zip(ray_splits[:-1], ray_splits[1:])):\0A        for i,t in enumerate(t_hit[start:end]):\0A            print(f'ray {ray_id}, intersection {i} at {t}')\0A\0A\0A\00", align 1
