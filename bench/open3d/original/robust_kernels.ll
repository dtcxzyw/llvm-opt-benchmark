@.str.20 = private unnamed_addr constant [9 x i8] c"__repr__\00", align 1
@.str.21 = private unnamed_addr constant [2 x i8] c"k\00", align 1
@.str.22 = private unnamed_addr constant [22 x i8] c"Parameter of the loss\00", align 1
