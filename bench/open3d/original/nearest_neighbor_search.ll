@.str.7 = private unnamed_addr constant [158 x i8] c"Initialize the index for knn search. \0A\0AThis function needs to be called once before performing search operations.\0A\0AReturns:\0A    True on success.\0A            \00", align 1
@.str.8 = private unnamed_addr constant [19 x i8] c"fixed_radius_index\00", align 1
@.str.9 = private unnamed_addr constant [7 x i8] c"radius\00", align 1
@.str.10 = private unnamed_addr constant [286 x i8] c"Initialize the index for fixed-radius search.\0A\0AThis function needs to be called once before performing search operations.\0A\0AArgs:\0A    radius (float, optional): Radius value for fixed-radius search. Required\0A        for GPU fixed radius index.\0A\0AReturns:\0A    True on success.\0A            \00", align 1
@.str.11 = private unnamed_addr constant [19 x i8] c"multi_radius_index\00", align 1
@.str.12 = private unnamed_addr constant [171 x i8] c"Initialize the index for multi-radius search.\0A\0AThis function needs to be called once before performing search operations.\0A\0AReturns:\0A        True on success.\0A             \00", align 1
@.str.13 = private unnamed_addr constant [13 x i8] c"hybrid_index\00", align 1
