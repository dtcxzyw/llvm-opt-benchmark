@.str.192 = private unnamed_addr constant [1772 x i8] c"Bake vertex attributes into textures.\0A\0AThis function assumes a triangle attribute with name 'texture_uvs'.\0AOnly float type attributes can be baked to textures.\0A\0AThis function always uses the CPU device.\0A\0AArgs:\0A    size (int): The width and height of the texture in pixels. Only square\0A        textures are supported.\0A\0A    vertex_attr (set): The vertex attributes for which textures should be\0A        generated.\0A\0A    margin (float): The margin in pixels. The recommended value is 2. The margin\0A        are additional pixels around the UV islands to avoid discontinuities.\0A\0A    fill (float): The value used for filling texels outside the UV islands.\0A\0A    update_material (bool): If true updates the material of the mesh.\0A        Baking a vertex attribute with the name 'albedo' will become the albedo\0A        texture in the material. Existing textures in the material will be\0A        overwritten.\0A\0AReturns:\0A    A dictionary of tensors that store the baked textures.\0A\0AExample:\0A    We generate a texture storing the xyz coordinates for each texel::\0A\0A        import open3d as o3d\0A        from matplotlib import pyplot as plt\0A\0A        box = o3d.geometry.TriangleMesh.create_box(create_uv_map=True)\0A        box = o3d.t.geometry.TriangleMesh.from_legacy(box)\0A        box.vertex['albedo'] = box.vertex.positions\0A\0A        # Initialize material and bake the 'albedo' vertex attribute to a\0A        # texture. The texture will be automatically added to the material of\0A        # the object.\0A        box.material.set_default_properties()\0A        texture_tensors = box.bake_vertex_attr_textures(128, {'albedo'})\0A\0A        # Shows the textured cube.\0A        o3d.visualization.draw([box])\0A\0A        # Plot the tensor with the texture.\0A        plt.imshow(texture_tensors['albedo'].numpy())\0A\0A\00", align 1
