@anon.863986d00e4103fb69f29fe2b65b0919.763 = private unnamed_addr constant <{ [583 x i8] }> <{ [583 x i8] c"How to fill the cells.\0A\0AThis can be a color or a function that returns a color. The function\0Areceives the cells' column and row indices, starting from zero. This can\0Abe used to implement striped tables.\0A\0A```example\0A#table(\0A  fill: (x, _) =>\0A    if calc.odd(x) { luma(240) }\0A    else { white },\0A  align: (x, y) =>\0A    if y == 0 { center }\0A    else if x == 0 { left }\0A    else { right },\0A  columns: 4,\0A  [], [*Q1*], [*Q2*], [*Q3*],\0A  [Revenue:], [1000 \E2\82\AC], [2000 \E2\82\AC], [3000 \E2\82\AC],\0A  [Expenses:], [500 \E2\82\AC], [1000 \E2\82\AC], [1500 \E2\82\AC],\0A  [Profit:], [500 \E2\82\AC], [1000 \E2\82\AC], [1500 \E2\82\AC],\0A)\0A```" }>, align 1
@anon.863986d00e4103fb69f29fe2b65b0919.764 = private unnamed_addr constant <{ [411 x i8] }> <{ [411 x i8] c"How to align the cells' content.\0A\0AThis can either be a single alignment, an array of alignments\0A(corresponding to each column) or a function that returns an alignment.\0AThe function receives the cells' column and row indices, starting from\0Azero. If set to `{auto}`, the outer alignment is used.\0A\0A```example\0A#table(\0A  columns: 3,\0A  align: (left, center, right),\0A  [Hello], [Hello], [Hello],\0A  [A], [B], [C],\0A)\0A```" }>, align 1
@anon.863986d00e4103fb69f29fe2b65b0919.765 = private unnamed_addr constant <{ [449 x i8] }> <{ [449 x i8] c"How to [stroke] the cells.\0A\0AStrokes can be disabled by setting this to `{none}`.\0A\0AIf it is necessary to place lines which can cross spacing between cells\0Aproduced by the `gutter` option, or to override the stroke between\0Amultiple specific cells, consider specifying one or more of\0A[`table.hline`]($table.hline) and [`table.vline`]($table.vline)\0Aalongside your table cells.\0A\0ASee the [grid documentation]($grid.stroke) for more information on\0Astrokes." }>, align 1
