@anon.9efbc0c128adab6190fabe7f7e045142.576 = private unnamed_addr constant <{ [46 x i8] }> <{ [46 x i8] c"A standard paper size to set width and height." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.577 = private unnamed_addr constant <{ [135 x i8] }> <{ [135 x i8] c"The width of the page.\0A\0A```example\0A#set page(\0A  width: 3cm,\0A  margin: (x: 0cm),\0A)\0A\0A#for i in range(3) {\0A  box(square(width: 1cm))\0A}\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.578 = private unnamed_addr constant <{ [273 x i8] }> <{ [273 x i8] c"The height of the page.\0A\0AIf this is set to `{auto}`, page breaks can only be triggered manually\0Aby inserting a [page break]($pagebreak). Most examples throughout this\0Adocumentation use `{auto}` for the height of the page to dynamically\0Agrow and shrink to fit their content." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.579 = private unnamed_addr constant <{ [298 x i8] }> <{ [298 x i8] c"Whether the page is flipped into landscape orientation.\0A\0A```example\0A#set page(\0A  \22us-business-card\22,\0A  flipped: true,\0A  fill: rgb(\22f2e5dd\22),\0A)\0A\0A#set align(bottom + end)\0A#text(14pt)[*Sam H. Richards*] \\\0A_Procurement Manager_\0A\0A#set text(10pt)\0A17 Main Street \\\0ANew York, NY 10001 \\\0A+1 555 555 5555\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.580 = private unnamed_addr constant <{ [1089 x i8] }> <{ [1089 x i8] c"The page's margins.\0A\0A- `{auto}`: The margins are set automatically to 2.5/21 times the smaller\0A  dimension of the page. This results in 2.5cm margins for an A4 page.\0A- A single length: The same margin on all sides.\0A- A dictionary: With a dictionary, the margins can be set individually.\0A  The dictionary can contain the following keys in order of precedence:\0A  - `top`: The top margin.\0A  - `right`: The right margin.\0A  - `bottom`: The bottom margin.\0A  - `left`: The left margin.\0A  - `inside`: The margin at the inner side of the page (where the\0A    [binding]($page.binding) is).\0A  - `outside`: The margin at the outer side of the page (opposite to the\0A    [binding]($page.binding)).\0A  - `x`: The horizontal margins.\0A  - `y`: The vertical margins.\0A  - `rest`: The margins on all sides except those for which the\0A    dictionary explicitly sets a size.\0A\0AThe values for `left` and `right` are mutually exclusive with\0Athe values for `inside` and `outside`.\0A\0A```example\0A#set page(\0A width: 3cm,\0A height: 4cm,\0A margin: (x: 8pt, y: 4pt),\0A)\0A\0A#rect(\0A  width: 100%,\0A  height: 100%,\0A  fill: aqua,\0A)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.581 = private unnamed_addr constant <{ [309 x i8] }> <{ [309 x i8] c"On which side the pages will be bound.\0A\0A- `{auto}`: Equivalent to `left` if the [text direction]($text.dir)\0A  is left-to-right and `right` if it is right-to-left.\0A- `left`: Bound on the left side.\0A- `right`: Bound on the right side.\0A\0AThis affects the meaning of the `inside` and `outside` options for\0Amargins." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.582 = private unnamed_addr constant <{ [491 x i8] }> <{ [491 x i8] c"How many columns the page has.\0A\0AIf you need to insert columns into a page or other container, you can\0Aalso use the [`columns` function]($columns).\0A\0A```example:single\0A#set page(columns: 2, height: 4.8cm)\0AClimate change is one of the most\0Apressing issues of our time, with\0Athe potential to devastate\0Acommunities, ecosystems, and\0Aeconomies around the world. It's\0Aclear that we need to take urgent\0Aaction to reduce our carbon\0Aemissions and mitigate the impacts\0Aof a rapidly changing climate.\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.583 = private unnamed_addr constant <{ [362 x i8] }> <{ [362 x i8] c"The page's background color.\0A\0AThis instructs the printer to color the complete page with the given\0Acolor. If you are considering larger production runs, it may be more\0Aenvironmentally friendly and cost-effective to source pre-dyed pages and\0Anot set this property.\0A\0A```example\0A#set page(fill: rgb(\22444352\22))\0A#set text(fill: rgb(\22fdfdfd\22))\0A*Dark mode enabled.*\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.584 = private unnamed_addr constant <{ [256 x i8] }> <{ [256 x i8] c"How to [number]($numbering) the pages.\0A\0AIf an explicit `footer` (or `header` for top-aligned numbering) is\0Agiven, the numbering is ignored.\0A\0A```example\0A#set page(\0A  height: 100pt,\0A  margin: (top: 16pt, bottom: 24pt),\0A  numbering: \221 / 1\22,\0A)\0A\0A#lorem(48)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.585 = private unnamed_addr constant <{ [396 x i8] }> <{ [396 x i8] c"The alignment of the page numbering.\0A\0AIf the vertical component is `top`, the numbering is placed into the\0Aheader and if it is `bottom`, it is placed in the footer. Horizon\0Aalignment is forbidden. If an explicit matching `header` or `footer` is\0Agiven, the numbering is ignored.\0A\0A```example\0A#set page(\0A  margin: (top: 16pt, bottom: 24pt),\0A  numbering: \221\22,\0A  number-align: right,\0A)\0A\0A#lorem(30)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.586 = private unnamed_addr constant <{ [253 x i8] }> <{ [253 x i8] c"The page's header. Fills the top margin of each page.\0A\0A```example\0A#set par(justify: true)\0A#set page(\0A  margin: (top: 32pt, bottom: 20pt),\0A  header: [\0A    #set text(8pt)\0A    #smallcaps[Typst Academcy]\0A    #h(1fr) _Exercise Sheet 3_\0A  ],\0A)\0A\0A#lorem(19)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.587 = private unnamed_addr constant <{ [52 x i8] }> <{ [52 x i8] c"The amount the header is raised into the top margin." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.588 = private unnamed_addr constant <{ [486 x i8] }> <{ [486 x i8] c"The page's footer. Fills the bottom margin of each page.\0A\0AFor just a page number, the `numbering` property, typically suffices. If\0Ayou want to create a custom footer, but still display the page number,\0Ayou can directly access the [page counter]($counter).\0A\0A```example\0A#set par(justify: true)\0A#set page(\0A  height: 100pt,\0A  margin: 20pt,\0A  footer: context [\0A    #set align(right)\0A    #set text(8pt)\0A    #counter(page).display(\0A      \221 of I\22,\0A      both: true,\0A    )\0A  ]\0A)\0A\0A#lorem(48)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.589 = private unnamed_addr constant <{ [56 x i8] }> <{ [56 x i8] c"The amount the footer is lowered into the bottom margin." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.590 = private unnamed_addr constant <{ [349 x i8] }> <{ [349 x i8] c"Content in the page's background.\0A\0AThis content will be placed behind the page's body. It can be\0Aused to place a background image or a watermark.\0A\0A```example\0A#set page(background: rotate(24deg,\0A  text(18pt, fill: rgb(\22FFCBC4\22))[\0A    *CONFIDENTIAL*\0A  ]\0A))\0A\0A= Typst's secret plans\0AIn the year 2023, we plan to take\0Aover the world (of typesetting).\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.591 = private unnamed_addr constant <{ [228 x i8] }> <{ [228 x i8] c"Content in the page's foreground.\0A\0AThis content will overlay the page's body.\0A\0A```example\0A#set page(foreground: text(24pt)[\F0\9F\A5\B8])\0A\0AReviewer 2 has marked our paper\0A\22Weak Reject\22 because they did\0Anot understand our approach...\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.592 = private unnamed_addr constant <{ [224 x i8] }> <{ [224 x i8] c"The contents of the page(s).\0A\0AMultiple pages will be created if the content does not fit on a single\0Apage. A new page with the page properties prior to the function invocation\0Awill be created after the body has been typeset." }>, align 1
