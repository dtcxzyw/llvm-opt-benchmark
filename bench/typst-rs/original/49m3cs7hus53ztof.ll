@anon.9efbc0c128adab6190fabe7f7e045142.574 = private unnamed_addr constant <{ [598 x i8] }> <{ [598 x i8] c"Layouts its child onto one or multiple pages.\0A\0AAlthough this function is primarily used in set rules to affect page\0Aproperties, it can also be used to explicitly render its argument onto\0Aa set of pages of its own.\0A\0APages can be set to use `{auto}` as their width or height. In this case, the\0Apages will grow to fit their content on the respective axis.\0A\0AThe [Guide for Page Setup]($guides/page-setup-guide) explains how to use\0Athis and related functions to set up a document with many examples.\0A\0A# Example\0A```example\0A>>> #set page(margin: auto)\0A#set page(\22us-letter\22)\0A\0AThere you go, US friends!\0A```" }>, align 1
@"_ZN5typst6layout4page1_102_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..layout..page..PageElem$GT$4data4DATA17hcb6021cfd74d7345E.llvm.12777920187102919001" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.9efbc0c128adab6190fabe7f7e045142.572, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.573, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.574, [8 x i8] c"V\02\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.64.llvm.12777920187102919001, [8 x i8] zeroinitializer, ptr @"_ZN5typst6layout4page1_98_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..layout..page..PageElem$GT$9construct17h8553424e1501d452E", ptr @"_ZN5typst6layout4page1_92_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..layout..page..PageElem$GT$3set17h25019c2de2813c92E", ptr @"_ZN5typst6layout4page1_96_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..layout..page..PageElem$GT$6vtable17h4e4b6ec9c4b132e3E", ptr @_ZN4core3ops8function6FnOnce9call_once17h87d2cd6a70f4e0c4E, ptr @_ZN4core3ops8function6FnOnce9call_once17hd2f79f271f88d555E, ptr @"_ZN5typst6layout4page1_95_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..layout..page..PageElem$GT$17field_from_styles17he7442831973c81acE", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17he81368c85f30c89aE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17hf238add468eb9025E }>, align 8
