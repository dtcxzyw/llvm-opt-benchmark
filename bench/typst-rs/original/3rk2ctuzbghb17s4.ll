@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.737 = private unnamed_addr constant <{ [310 x i8] }> <{ [310 x i8] c"The footnote for this entry. It's location can be used to determine\0Athe footnote counter state.\0A\0A```example\0A#show footnote.entry: it => {\0A  let loc = it.note.location()\0A  numbering(\0A    \221: \22,\0A    ..counter(footnote).at(loc),\0A  )\0A  it.note.body\0A}\0A\0ACustomized #footnote[Hello]\0Alisting #footnote[World! \F0\9F\8C\8F]\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.738 = private unnamed_addr constant <{ [216 x i8] }> <{ [216 x i8] c"The separator between the document body and the footnote listing.\0A\0A```example\0A#set footnote.entry(\0A  separator: repeat[.]\0A)\0A\0ATesting a different separator.\0A#footnote[\0A  Unconventional, but maybe\0A  not that bad?\0A]\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.739 = private unnamed_addr constant <{ [187 x i8] }> <{ [187 x i8] c"The amount of clearance between the document body and the separator.\0A\0A```example\0A#set footnote.entry(clearance: 3em)\0A\0AFootnotes also need ...\0A#footnote[\0A  ... some space to breathe.\0A]\0A```" }>, align 1
