@anon.5c04a1d5f2b09caa3146db3fe8360175.878 = private unnamed_addr constant <{ [190 x i8] }> <{ [190 x i8] c"How to fill the rectangle.\0A\0AWhen setting a fill, the default stroke disappears. To create a\0Arectangle with both fill and stroke, you have to configure both.\0A\0A```example\0A#rect(fill: blue)\0A```" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.879 = private unnamed_addr constant <{ [721 x i8] }> <{ [721 x i8] c"How to stroke the rectangle. This can be:\0A\0A- `{none}` to disable stroking\0A- `{auto}` for a stroke of `{1pt + black}` if and if only if no fill is\0A  given.\0A- Any kind of [stroke]\0A- A dictionary describing the stroke for each side inidvidually. The\0A  dictionary can contain the following keys in order of precedence:\0A  - `top`: The top stroke.\0A  - `right`: The right stroke.\0A  - `bottom`: The bottom stroke.\0A  - `left`: The left stroke.\0A  - `x`: The horizontal stroke.\0A  - `y`: The vertical stroke.\0A  - `rest`: The stroke on all sides except those for which the\0A    dictionary explicitly sets a size.\0A\0A```example\0A#stack(\0A  dir: ltr,\0A  spacing: 1fr,\0A  rect(stroke: red),\0A  rect(stroke: 2pt),\0A  rect(stroke: 2pt + red),\0A)\0A```" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.880 = private unnamed_addr constant <{ [1060 x i8] }> <{ [1060 x i8] c"How much to round the rectangle's corners, relative to the minimum of\0Athe width and height divided by two. This can be:\0A\0A- A relative length for a uniform corner radius.\0A- A dictionary: With a dictionary, the stroke for each side can be set\0A  individually. The dictionary can contain the following keys in order\0A  of precedence:\0A  - `top-left`: The top-left corner radius.\0A  - `top-right`: The top-right corner radius.\0A  - `bottom-right`: The bottom-right corner radius.\0A  - `bottom-left`: The bottom-left corner radius.\0A  - `left`: The top-left and bottom-left corner radii.\0A  - `top`: The top-left and top-right corner radii.\0A  - `right`: The top-right and bottom-right corner radii.\0A  - `bottom`: The bottom-left and bottom-right corner radii.\0A  - `rest`: The radii for all corners except those for which the\0A    dictionary explicitly sets a size.\0A\0A```example\0A#set rect(stroke: 4pt)\0A#rect(\0A  radius: (\0A    left: 5pt,\0A    top-right: 20pt,\0A    bottom-right: 10pt,\0A  ),\0A  stroke: (\0A    left: red,\0A    top: yellow,\0A    right: green,\0A    bottom: blue,\0A  ),\0A)\0A```" }>, align 1
