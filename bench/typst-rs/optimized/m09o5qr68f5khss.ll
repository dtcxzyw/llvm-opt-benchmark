@anon.5c04a1d5f2b09caa3146db3fe8360175.829 = private unnamed_addr constant <{ [1348 x i8] }> <{ [1348 x i8] c"Raw text with optional syntax highlighting.\0A\0ADisplays the text verbatim and in a monospace font. This is typically used\0Ato embed computer code into your document.\0A\0A# Example\0A````example\0AAdding `rbx` to `rcx` gives\0Athe desired result.\0A\0AWhat is ```rust fn main()``` in Rust\0Awould be ```c int main()``` in C.\0A\0A```rust\0Afn main() {\0A    println!(\22Hello World!\22);\0A}\0A```\0A\0AThis has ``` `backticks` ``` in it\0A(but the spaces are trimmed). And\0A``` here``` the leading space is\0Aalso trimmed.\0A````\0A\0A# Syntax\0AThis function also has dedicated syntax. You can enclose text in 1 or 3+\0Abackticks (`` ` ``) to make it raw. Two backticks produce empty raw text.\0AWhen you use three or more backticks, you can additionally specify a\0Alanguage tag for syntax highlighting directly after the opening backticks.\0AWithin raw blocks, everything (except for the language tag, if applicable)\0Ais rendered as is, in particular, there are no escape sequences.\0A\0AThe language tag is an identifier that directly follows the opening\0Abackticks only if there are three or more backticks. If your text starts\0Awith something that looks like an identifier, but no syntax highlighting is\0Aneeded, start the text with a single space (which will be trimmed) or use\0Athe single backtick syntax. If your text should start or end with a\0Abacktick, put a space before or after it (it will be trimmed)." }>, align 1
@"_ZN5typst4text3raw1_98_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..text..raw..RawElem$GT$4data4DATA17hadb8b0bd47084a67E.llvm.14728845296163125433" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, ptr, [16 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.5c04a1d5f2b09caa3146db3fe8360175.827, [8 x i8] c"\03\00\00\00\00\00\00\00", ptr @anon.5c04a1d5f2b09caa3146db3fe8360175.828, [8 x i8] c"\0F\00\00\00\00\00\00\00", ptr @anon.5c04a1d5f2b09caa3146db3fe8360175.829, [8 x i8] c"D\05\00\00\00\00\00\00", ptr @anon.5c04a1d5f2b09caa3146db3fe8360175.20.llvm.14728845296163125433, [8 x i8] zeroinitializer, ptr @"_ZN5typst4text3raw1_94_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..text..raw..RawElem$GT$9construct17h9a05e8ebacad5380E", ptr @"_ZN5typst4text3raw1_88_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..text..raw..RawElem$GT$3set17h72fe3f9ea2efa293E", ptr @"_ZN5typst4text3raw1_92_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..text..raw..RawElem$GT$6vtable17h72e6d18e7257a59bE", ptr @_ZN4core3ops8function6FnOnce9call_once17hd8865dab54e405bbE, ptr @_ZN4core3ops8function6FnOnce9call_once17h216207125e51dd51E, ptr @"_ZN5typst4text3raw1_91_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..text..raw..RawElem$GT$17field_from_styles17hb3ee64582ec66a43E", ptr @"_ZN5typst4text3raw127_$LT$impl$u20$typst..text..lang..LocalName$u20$for$u20$typst..foundations..content..Packed$LT$typst..text..raw..RawElem$GT$$GT$10local_name17h8653e7694649165aE", [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h6668fe089ef46036E, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17hcd6ba6937e0795f1E }>, align 8
@anon.5c04a1d5f2b09caa3146db3fe8360175.830 = private unnamed_addr constant <{ [352 x i8] }> <{ [352 x i8] c"The raw text.\0A\0AYou can also use raw blocks creatively to create custom syntaxes for\0Ayour automations.\0A\0A````example\0A// Parse numbers in raw blocks with the\0A// `mydsl` tag and sum them up.\0A#show raw.where(lang: \22mydsl\22): it => {\0A  let sum = 0\0A  for part in it.text.split(\22+\22) {\0A    sum += int(part.trim())\0A  }\0A  sum\0A}\0A\0A```mydsl\0A1 + 2 + 3 + 4 + 5\0A```\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.831 = private unnamed_addr constant <{ [770 x i8] }> <{ [770 x i8] c"Whether the raw text is displayed as a separate block.\0A\0AIn markup mode, using one-backtick notation makes this `{false}`.\0AUsing three-backtick notation makes it `{true}` if the enclosed content\0Acontains at least one line break.\0A\0A````example\0A// Display inline code in a small box\0A// that retains the correct baseline.\0A#show raw.where(block: false): box.with(\0A  fill: luma(240),\0A  inset: (x: 3pt, y: 0pt),\0A  outset: (y: 3pt),\0A  radius: 2pt,\0A)\0A\0A// Display block code in a larger block\0A// with more padding.\0A#show raw.where(block: true): block.with(\0A  fill: luma(240),\0A  inset: 10pt,\0A  radius: 4pt,\0A)\0A\0AWith `rg`, you can search through your files quickly.\0AThis example searches the current directory recursively\0Afor the text `Hello World`:\0A\0A```bash\0Arg \22Hello World\22\0A```\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.832 = private unnamed_addr constant <{ [333 x i8] }> <{ [333 x i8] c"The language to syntax-highlight in.\0A\0AApart from typical language tags known from Markdown, this supports the\0A`{\22typ\22}` and `{\22typc\22}` tags for\0A[Typst markup]($reference/syntax/#markup) and\0A[Typst code]($reference/syntax/#code), respectively.\0A\0A````example\0A```typ\0AThis is *Typst!*\0A```\0A\0AThis is ```typ also *Typst*```, but inline!\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.833 = private unnamed_addr constant <{ [563 x i8] }> <{ [563 x i8] c"The horizontal alignment that each line in a raw block should have.\0AThis option is ignored if this is not a raw block (if specified\0A`block: false` or single backticks were used in markup mode).\0A\0ABy default, this is set to `{start}`, meaning that raw text is\0Aaligned towards the start of the text direction inside the block\0Aby default, regardless of the current context's alignment (allowing\0Ayou to center the raw block itself without centering the text inside\0Ait, for example).\0A\0A````example\0A#set raw(align: center)\0A\0A```typc\0Alet f(x) = x\0Acode = \22centered\22\0A```\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.834 = private unnamed_addr constant <{ [349 x i8] }> <{ [349 x i8] c"One or multiple additional syntax definitions to load. The syntax\0Adefinitions should be in the\0A[`sublime-syntax` file format](https://www.sublimetext.com/docs/syntax.html).\0A\0A````example\0A#set raw(syntaxes: \22SExpressions.sublime-syntax\22)\0A\0A```sexp\0A(defun factorial (x)\0A  (if (zerop x)\0A    ; with a comment\0A    1\0A    (* x (factorial (- x 1)))))\0A```\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.835 = private unnamed_addr constant <{ [787 x i8] }> <{ [787 x i8] c"The theme to use for syntax highlighting. Theme files should be in the\0Ain the [`tmTheme` file format](https://www.sublimetext.com/docs/color_schemes_tmtheme.html).\0A\0AApplying a theme only affects the color of specifically highlighted\0Atext. It does not consider the theme's foreground and background\0Aproperties, so that you retain control over the color of raw text. You\0Acan apply the foreground color yourself with the [`text`] function and\0Athe background with a [filled block]($block.fill). You could also use\0Athe [`xml`] function to extract these properties from the theme.\0A\0A````example\0A#set raw(theme: \22halcyon.tmTheme\22)\0A#show raw: it => block(\0A  fill: rgb(\22#1d2433\22),\0A  inset: 8pt,\0A  radius: 5pt,\0A  text(fill: rgb(\22#a2aabc\22), it)\0A)\0A\0A```typ\0A= Chapter 1\0A#let hi = \22Hello World\22\0A```\0A````" }>, align 1
@anon.5c04a1d5f2b09caa3146db3fe8360175.836 = private unnamed_addr constant <{ [210 x i8] }> <{ [210 x i8] c"The size for a tab stop in spaces. A tab is replaced with enough spaces to\0Aalign with the next multiple of the size.\0A\0A````example\0A#set raw(tab-size: 8)\0A```tsv\0AYear\09Month\09Day\0A2000\092\093\0A2001\092\091\0A2002\093\0910\0A```\0A````" }>, align 1
