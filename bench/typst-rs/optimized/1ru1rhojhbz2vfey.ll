@anon.984efe779a4077b66be6415f964eeb42.2121 = private unnamed_addr constant <{ [1341 x i8] }> <{ [1341 x i8] c"A cell in the grid. You can use this function in the argument list of a grid\0Ato override grid style properties for an individual cell or manually\0Apositioning it within the grid. You can also use this function in show rules\0Ato apply certain styles to multiple cells at once.\0A\0AFor example, you can override the position and stroke for a single cell:\0A\0A```example\0A>>> #set page(width: auto)\0A>>> #set text(15pt, font: \22Noto Sans Symbols 2\22, bottom-edge: -.2em)\0A<<< #set text(15pt, font: \22Noto Sans Symbols 2\22)\0A#show regex(\22[\E2\99\9A-\E2\99\9F\EF\B8\8E]\22): set text(fill: rgb(\2221212A\22))\0A#show regex(\22[\E2\99\94-\E2\99\99]\22): set text(fill: rgb(\22111015\22))\0A\0A#grid(\0A  fill: (x, y) => rgb(\0A    if calc.odd(x + y) { \227F8396\22 }\0A    else { \22EFF0F3\22 }\0A  ),\0A  columns: (1em,) * 8,\0A  rows: 1em,\0A  align: center + horizon,\0A\0A  [\E2\99\96], [\E2\99\98], [\E2\99\97], [\E2\99\95], [\E2\99\94], [\E2\99\97], [\E2\99\98], [\E2\99\96],\0A  [\E2\99\99], [\E2\99\99], [\E2\99\99], [\E2\99\99], [],  [\E2\99\99], [\E2\99\99], [\E2\99\99],\0A  grid.cell(\0A    x: 4, y: 3,\0A    stroke: blue.transparentize(60%)\0A  )[\E2\99\99],\0A\0A  ..(grid.cell(y: 6)[\E2\99\9F],) * 8,\0A  ..([\E2\99\9C], [\E2\99\9E], [\E2\99\9D], [\E2\99\9B], [\E2\99\9A], [\E2\99\9D], [\E2\99\9E], [\E2\99\9C])\0A    .map(grid.cell.with(y: 7)),\0A)\0A```\0A\0AYou may also apply a show rule on `grid.cell` to style all cells at once,\0Awhich allows you, for example, to apply styles based on a cell's position.\0ARefer to the examples of the [`table.cell`]($table.cell) element to learn\0Amore about this." }>, align 1
@"_ZN5typst6layout4grid1_102_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..layout..grid..GridCell$GT$4data4DATA17h34bf1afb9098e9cbE.llvm.13383457361836014260" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.984efe779a4077b66be6415f964eeb42.2119, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.2120, [8 x i8] c"\09\00\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.2121, [8 x i8] c"=\05\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.43.llvm.13383457361836014260, [8 x i8] zeroinitializer, ptr @"_ZN5typst6layout4grid1_98_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..layout..grid..GridCell$GT$9construct17h91d39c2cbeb5c6a2E", ptr @"_ZN5typst6layout4grid1_92_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..layout..grid..GridCell$GT$3set17h1e69b336705b1fd0E", ptr @"_ZN5typst6layout4grid1_96_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..layout..grid..GridCell$GT$6vtable17hb55070d24cc10733E", ptr @_ZN4core3ops8function6FnOnce9call_once17h75bdef7d50869b13E, ptr @_ZN4core3ops8function6FnOnce9call_once17h6210608a95569e05E, ptr @"_ZN5typst6layout4grid1_95_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..layout..grid..GridCell$GT$17field_from_styles17h49e74704f1eae982E", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h2a242413aa94950aE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h1d088f2dca68041aE }>, align 8
