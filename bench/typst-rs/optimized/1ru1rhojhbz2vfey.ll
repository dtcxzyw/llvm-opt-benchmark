@anon.984efe779a4077b66be6415f964eeb42.2143 = private unnamed_addr constant <{ [300 x i8] }> <{ [300 x i8] c"The length of the line, relative to the length of the diagonal spanning\0Athe whole element being \22cancelled\22. A value of `{100%}` would then have\0Athe line span precisely the element's diagonal.\0A\0A```example\0A>>> #set page(width: 140pt)\0A$ a + cancel(x, length: #200%)\0A    - cancel(x, length: #200%) $\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2144 = private unnamed_addr constant <{ [299 x i8] }> <{ [299 x i8] c"Whether the cancel line should be inverted (flipped along the y-axis).\0AFor the default angle setting, inverted means the cancel line\0Apoints to the top left instead of top right.\0A\0A```example\0A>>> #set page(width: 140pt)\0A$ (a cancel((b + c), inverted: #true)) /\0A    cancel(b + c, inverted: #true) $\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2145 = private unnamed_addr constant <{ [179 x i8] }> <{ [179 x i8] c"Whether two opposing cancel lines should be drawn, forming a cross over\0Athe element. Overrides `inverted`.\0A\0A```example\0A>>> #set page(width: 140pt)\0A$ cancel(Pi, cross: #true) $\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2146 = private unnamed_addr constant <{ [615 x i8] }> <{ [615 x i8] c"How much to rotate the cancel line.\0A\0A- If `{auto}`, the line assumes the default angle; that is, along the\0A  diagonal line of the content box.\0A- If given an angle, the line is rotated by that angle clockwise w.r.t\0A  the y-axis.\0A- If given a function `angle => angle`, the line is rotated by the angle\0A  returned by that function. The function receives the default angle as\0A  its input.\0A\0A```example\0A>>> #set page(width: 140pt)\0A$ cancel(Pi)\0A  cancel(Pi, angle: #0deg)\0A  cancel(Pi, angle: #45deg)\0A  cancel(Pi, angle: #90deg)\0A  cancel(1/(1+x), angle: #(a => a + 45deg))\0A  cancel(1/(1+x), angle: #(a => a + 90deg)) $\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2147 = private unnamed_addr constant <{ [184 x i8] }> <{ [184 x i8] c"How to [stroke]($stroke) the cancel line.\0A\0A```example\0A>>> #set page(width: 140pt)\0A$ cancel(\0A  sum x,\0A  stroke: #(\0A    paint: red,\0A    thickness: 1.5pt,\0A    dash: \22dashed\22,\0A  ),\0A) $\0A```" }>, align 1
