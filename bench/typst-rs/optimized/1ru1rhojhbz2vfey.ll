@anon.984efe779a4077b66be6415f964eeb42.2123 = private unnamed_addr constant <{ [843 x i8] }> <{ [843 x i8] c"The cell's column (zero-indexed).\0AThis field may be used in show rules to style a cell depending on its\0Acolumn.\0A\0AYou may override this field to pick in which column the cell must\0Abe placed. If no row (`y`) is chosen, the cell will be placed in the\0Afirst row (starting at row 0) with that column available (or a new row\0Aif none). If both `x` and `y` are chosen, however, the cell will be\0Aplaced in that exact position. An error is raised if that position is\0Anot available (thus, it is usually wise to specify cells with a custom\0Aposition before cells with automatic positions).\0A\0A```example\0A#let circ(c) = circle(\0A    fill: c, width: 5mm\0A)\0A\0A#grid(\0A  columns: 4,\0A  rows: 7mm,\0A  stroke: .5pt + blue,\0A  align: center + horizon,\0A  inset: 1mm,\0A\0A  grid.cell(x: 2, y: 2, circ(aqua)),\0A  circ(yellow),\0A  grid.cell(x: 3, circ(green)),\0A  circ(black),\0A)\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2124 = private unnamed_addr constant <{ [628 x i8] }> <{ [628 x i8] c"The cell's row (zero-indexed).\0AThis field may be used in show rules to style a cell depending on its\0Arow.\0A\0AYou may override this field to pick in which row the cell must be\0Aplaced. If no column (`x`) is chosen, the cell will be placed in the\0Afirst column (starting at column 0) available in the chosen row. If all\0Acolumns in the chosen row are already occupied, an error is raised.\0A\0A```example\0A#let tri(c) = polygon.regular(\0A  fill: c,\0A  size: 5mm,\0A  vertices: 3,\0A)\0A\0A#grid(\0A  columns: 2,\0A  stroke: blue,\0A  inset: 1mm,\0A\0A  tri(black),\0A  grid.cell(y: 1, tri(teal)),\0A  grid.cell(y: 1, tri(red)),\0A  grid.cell(y: 2, tri(orange))\0A)\0A```" }>, align 1
