@anon.984efe779a4077b66be6415f964eeb42.2067 = private unnamed_addr constant <{ [445 x i8] }> <{ [445 x i8] c"How to fill the cells.\0A\0AThis can be a color or a function that returns a color. The function\0Areceives the cells' column and row indices, starting from zero. This can\0Abe used to implement striped grids.\0A\0A```example\0A#grid(\0A  fill: (x, y) =>\0A    if calc.even(x + y) { luma(230) }\0A    else { white },\0A  align: center + horizon,\0A  columns: 4,\0A  inset: 2pt,\0A  [X], [O], [X], [O],\0A  [O], [X], [O], [X],\0A  [X], [O], [X], [O],\0A  [O], [X], [O], [X],\0A)\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2068 = private unnamed_addr constant <{ [384 x i8] }> <{ [384 x i8] c"How to align the cells' content.\0A\0AThis can either be a single alignment, an array of alignments\0A(corresponding to each column) or a function that returns an alignment.\0AThe function receives the cells' column and row indices, starting from\0Azero. If set to `{auto}`, the outer alignment is used.\0A\0AYou can find an example for this argument at the\0A[`table.align`]($table.align) parameter." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2069 = private unnamed_addr constant <{ [1821 x i8] }> <{ [1821 x i8] c"How to [stroke]($stroke) the cells.\0A\0AGrids have no strokes by default, which can be changed by setting this\0Aoption to the desired stroke.\0A\0AIf it is necessary to place lines which can cross spacing between cells\0Aproduced by the `gutter` option, or to override the stroke between\0Amultiple specific cells, consider specifying one or more of\0A[`grid.hline`]($grid.hline) and [`grid.vline`]($grid.vline) alongside\0Ayour grid cells.\0A\0A```example\0A#set page(height: 13em, width: 26em)\0A\0A#let cv(..jobs) = grid(\0A    columns: 2,\0A    inset: 5pt,\0A    stroke: (x, y) => if x == 0 and y > 0 {\0A      (right: (\0A        paint: luma(180),\0A        thickness: 1.5pt,\0A        dash: \22dotted\22\0A      ))\0A    },\0A    grid.header(grid.cell(colspan: 2)[\0A      *Professional Experience*\0A      #box(width: 1fr, line(length: 100%, stroke: luma(180)))\0A    ]),\0A    ..{\0A      let last = none\0A      for job in jobs.pos() {\0A        (\0A          if job.year != last [*#job.year*],\0A          [\0A            *#job.company* - #job.role _(#job.timeframe)_ \\\0A            #job.details\0A          ]\0A        )\0A        last = job.year\0A      }\0A    }\0A  )\0A\0A  #cv(\0A    (\0A      year: 2012,\0A      company: [Pear Seed & Co.],\0A      role: [Lead Engineer],\0A      timeframe: [Jul - Dec],\0A      details: [\0A        - Raised engineers from 3x to 10x\0A        - Did a great job\0A      ],\0A    ),\0A    (\0A      year: 2012,\0A      company: [Mega Corp.],\0A      role: [VP of Sales],\0A      timeframe: [Mar - Jun],\0A      details: [- Closed tons of customers],\0A    ),\0A    (\0A      year: 2013,\0A      company: [Tiny Co.],\0A      role: [CEO],\0A      timeframe: [Jan - Dec],\0A      details: [- Delivered 4x more shareholder value],\0A    ),\0A    (\0A      year: 2014,\0A      company: [Glorbocorp Ltd],\0A      role: [CTO],\0A      timeframe: [Jan - Mar],\0A      details: [- Drove containerization forward],\0A    ),\0A  )\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2070 = private unnamed_addr constant <{ [126 x i8] }> <{ [126 x i8] c"How much to pad the cells' content.\0A\0AYou can find an example for this argument at the\0A[`table.inset`]($table.inset) parameter." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2071 = private unnamed_addr constant <{ [191 x i8] }> <{ [191 x i8] c"The contents of the grid cells, plus any extra grid lines specified\0Awith the [`grid.hline`]($grid.hline) and [`grid.vline`]($grid.vline)\0Aelements.\0A\0AThe cells are populated in row-major order." }>, align 1
