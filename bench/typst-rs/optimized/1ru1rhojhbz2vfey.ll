@anon.984efe779a4077b66be6415f964eeb42.2241 = private unnamed_addr constant <{ [1106 x i8] }> <{ [1106 x i8] c"Displays a quote alongside an optional attribution.\0A\0A# Example\0A```example\0APlato is often misquoted as the author of #quote[I know that I know\0Anothing], however, this is a derivation form his original quote:\0A\0A#set quote(block: true)\0A\0A#quote(attribution: [Plato])[\0A  ... \E1\BC\94\CE\BF\CE\B9\CE\BA\CE\B1 \CE\B3\CE\BF\E1\BF\A6\CE\BD \CF\84\CE\BF\CF\8D\CF\84\CE\BF\CF\85 \CE\B3\CE\B5 \CF\83\CE\BC\CE\B9\CE\BA\CF\81\E1\BF\B7 \CF\84\CE\B9\CE\BD\CE\B9 \CE\B1\E1\BD\90\CF\84\E1\BF\B7 \CF\84\CE\BF\CF\8D\CF\84\E1\BF\B3 \CF\83\CE\BF\CF\86\CF\8E\CF\84\CE\B5\CF\81\CE\BF\CF\82 \CE\B5\E1\BC\B6\CE\BD\CE\B1\CE\B9, \E1\BD\85\CF\84\CE\B9\0A  \E1\BC\83 \CE\BC\E1\BD\B4 \CE\BF\E1\BC\B6\CE\B4\CE\B1 \CE\BF\E1\BD\90\CE\B4\E1\BD\B2 \CE\BF\E1\BC\B4\CE\BF\CE\BC\CE\B1\CE\B9 \CE\B5\E1\BC\B0\CE\B4\CE\AD\CE\BD\CE\B1\CE\B9.\0A]\0A#quote(attribution: [from the Henry Cary literal translation of 1897])[\0A  ... I seem, then, in just this little thing to be wiser than this man at\0A  any rate, that what I do not know I do not think I know either.\0A]\0A```\0A\0ABy default block quotes are padded left and right by `{1em}`, alignment and\0Apadding can be controlled with show rules:\0A```example\0A#set quote(block: true)\0A#show quote: set align(center)\0A#show quote: set pad(x: 5em)\0A\0A#quote[\0A  You cannot pass... I am a servant of the Secret Fire, wielder of the\0A  flame of Anor. You cannot pass. The dark fire will not avail you,\0A  flame of Ud\C3\BBn. Go back to the Shadow! You cannot pass.\0A]\0A```" }>, align 1
@"_ZN5typst5model5quote1_103_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..model..quote..QuoteElem$GT$4data4DATA17h1d64e1e6212c1c0cE.llvm.13383457361836014260" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.984efe779a4077b66be6415f964eeb42.2239, [8 x i8] c"\05\00\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.2240, [8 x i8] c"\05\00\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.2241, [8 x i8] c"R\04\00\00\00\00\00\00", ptr @anon.984efe779a4077b66be6415f964eeb42.43.llvm.13383457361836014260, [8 x i8] zeroinitializer, ptr @"_ZN5typst5model5quote1_99_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..model..quote..QuoteElem$GT$9construct17h0b099135c585ca2eE", ptr @"_ZN5typst5model5quote1_93_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..model..quote..QuoteElem$GT$3set17hd2e54164e356f7edE", ptr @"_ZN5typst5model5quote1_97_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..model..quote..QuoteElem$GT$6vtable17hda6a2f375794a032E", ptr @_ZN4core3ops8function6FnOnce9call_once17h580093e34b028e9bE, ptr @_ZN4core3ops8function6FnOnce9call_once17h4fc3238910ca2566E, ptr @"_ZN5typst5model5quote1_96_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..model..quote..QuoteElem$GT$17field_from_styles17h8f88d1a7b0ce03aaE", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17he55df9549a45002cE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h4af4155f297b7f5cE }>, align 8
@anon.984efe779a4077b66be6415f964eeb42.2242 = private unnamed_addr constant <{ [258 x i8] }> <{ [258 x i8] c"Whether this is a block quote.\0A\0A```example\0AAn inline citation would look like\0Athis: #quote(\0A  attribution: [Ren\C3\A9 Descartes]\0A)[\0A  cogito, ergo sum\0A], and a block equation like this:\0A#quote(\0A  block: true,\0A  attribution: [JFK]\0A)[\0A  Ich bin ein Berliner.\0A]\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2243 = private unnamed_addr constant <{ [683 x i8] }> <{ [683 x i8] c"Whether double quotes should be added around this quote.\0A\0AThe double quotes used are inferred from the `quotes` property on\0A[smartquote], which is affected by the `lang` property on [text].\0A\0A- `{true}`: Wrap this quote in double quotes.\0A- `{false}`: Do not wrap this quote in double quotes.\0A- `{auto}`: Infer whether to wrap this quote in double quotes based on\0A  the `block` property. If `block` is `{false}`, double quotes are\0A  automatically added.\0A\0A```example\0A#set text(lang: \22de\22)\0A\0AEin deutsch-sprechender Author\0Azitiert unter umst\C3\A4nden JFK:\0A#quote[Ich bin ein Berliner.]\0A\0A#set text(lang: \22en\22)\0A\0AAnd an english speaking one may\0Atranslate the quote:\0A#quote[I am a Berliner.]\0A```" }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2244 = private unnamed_addr constant <{ [846 x i8] }> <{ [846 x i8] c"The attribution of this quote, usually the author or source. Can be a\0Alabel pointing to a bibliography entry or any content. By default only\0Adisplayed for block quotes, but can be changed using a `{show}` rule.\0A\0A```example\0A#quote(attribution: [Ren\C3\A9 Descartes])[\0A  cogito, ergo sum\0A]\0A\0A#show quote.where(block: false): it => {\0A  [\22] + h(0pt, weak: true) + it.body + h(0pt, weak: true) + [\22]\0A  if it.attribution != none [ (#it.attribution)]\0A}\0A\0A#quote(\0A  attribution: link(\22https://typst.app/home\22)[typst.com]\0A)[\0A  Compose papers faster\0A]\0A\0A#set quote(block: true)\0A\0A#quote(attribution: <tolkien54>)[\0A  You cannot pass... I am a servant\0A  of the Secret Fire, wielder of the\0A  flame of Anor. You cannot pass. The\0A  dark fire will not avail you, flame\0A  of Ud\C3\BBn. Go back to the Shadow! You\0A  cannot pass.\0A]\0A\0A#bibliography(\22works.bib\22, style: \22apa\22)\0A```" }>, align 1
