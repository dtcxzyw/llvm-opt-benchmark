@anon.984efe779a4077b66be6415f964eeb42.2098 = private unnamed_addr constant <{ [689 x i8] }> <{ [689 x i8] c"The row above which the horizontal line is placed (zero-indexed).\0AIf the `position` field is set to `{bottom}`, the line is placed below\0Athe row with the given index instead (see that field's docs for\0Adetails).\0A\0ASpecifying `{auto}` causes the line to be placed at the row below the\0Alast automatically positioned cell (that is, cell without coordinate\0Aoverrides) before the line among the grid's children. If there is no\0Asuch cell before the line, it is placed at the top of the grid (row 0).\0ANote that specifying for this option exactly the total amount of rows\0Ain the grid causes this horizontal line to override the bottom border\0Aof the grid, while a value of 0 overrides the top border." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2099 = private unnamed_addr constant <{ [73 x i8] }> <{ [73 x i8] c"The column at which the horizontal line starts (zero-indexed, inclusive)." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2100 = private unnamed_addr constant <{ [271 x i8] }> <{ [271 x i8] c"The column before which the horizontal line ends (zero-indexed,\0Aexclusive).\0ATherefore, the horizontal line will be drawn up to and across column\0A`end - 1`.\0A\0AA value equal to `{none}` or to the amount of columns causes it to\0Aextend all the way towards the end of the grid." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2101 = private unnamed_addr constant <{ [147 x i8] }> <{ [147 x i8] c"The line's stroke.\0A\0ASpecifying `{none}` removes any lines previously placed across this\0Aline's range, including hlines or per-cell stroke below it." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2102 = private unnamed_addr constant <{ [398 x i8] }> <{ [398 x i8] c"The position at which the line is placed, given its row (`y`) - either\0A`{top}` to draw above it or `{bottom}` to draw below it.\0A\0AThis setting is only relevant when row gutter is enabled (and\0Ashouldn't be used otherwise - prefer just increasing the `y` field by\0Aone instead), since then the position below a row becomes different\0Afrom the position above the next row due to the spacing between both." }>, align 1
