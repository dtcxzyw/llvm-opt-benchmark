@anon.984efe779a4077b66be6415f964eeb42.2108 = private unnamed_addr constant <{ [763 x i8] }> <{ [763 x i8] c"The column before which the horizontal line is placed (zero-indexed).\0AIf the `position` field is set to `{end}`, the line is placed after the\0Acolumn with the given index instead (see that field's docs for\0Adetails).\0A\0ASpecifying `{auto}` causes the line to be placed at the column after\0Athe last automatically positioned cell (that is, cell without\0Acoordinate overrides) before the line among the grid's children. If\0Athere is no such cell before the line, it is placed before the grid's\0Afirst column (column 0).\0ANote that specifying for this option exactly the total amount of\0Acolumns in the grid causes this vertical line to override the end\0Aborder of the grid (right in LTR, left in RTL), while a value of 0\0Aoverrides the start border (left in LTR, right in RTL)." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2109 = private unnamed_addr constant <{ [68 x i8] }> <{ [68 x i8] c"The row at which the vertical line starts (zero-indexed, inclusive)." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2110 = private unnamed_addr constant <{ [264 x i8] }> <{ [264 x i8] c"The row on top of which the vertical line ends (zero-indexed,\0Aexclusive).\0ATherefore, the vertical line will be drawn up to and across row\0A`end - 1`.\0A\0AA value equal to `{none}` or to the amount of rows causes it to extend\0Aall the way towards the bottom of the grid." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2111 = private unnamed_addr constant <{ [147 x i8] }> <{ [147 x i8] c"The line's stroke.\0A\0ASpecifying `{none}` removes any lines previously placed across this\0Aline's range, including vlines or per-cell stroke below it." }>, align 1
@anon.984efe779a4077b66be6415f964eeb42.2112 = private unnamed_addr constant <{ [575 x i8] }> <{ [575 x i8] c"The position at which the line is placed, given its column (`x`) -\0Aeither `{start}` to draw before it or `{end}` to draw after it.\0A\0AThe values `{left}` and `{right}` are also accepted, but discouraged as\0Athey cause your grid to be inconsistent between left-to-right and\0Aright-to-left documents.\0A\0AThis setting is only relevant when column gutter is enabled (and\0Ashouldn't be used otherwise - prefer just increasing the `x` field by\0Aone instead), since then the position after a column becomes different\0Afrom the position before the next column due to the spacing between\0Aboth." }>, align 1
