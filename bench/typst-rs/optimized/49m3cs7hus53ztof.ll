@anon.9efbc0c128adab6190fabe7f7e045142.876 = private unnamed_addr constant <{ [1204 x i8] }> <{ [1204 x i8] c"A numbered list.\0A\0ADisplays a sequence of items vertically and numbers them consecutively.\0A\0A# Example\0A```example\0AAutomatically numbered:\0A+ Preparations\0A+ Analysis\0A+ Conclusions\0A\0AManually numbered:\0A2. What is the first step?\0A5. I am confused.\0A+  Moving on ...\0A\0AMultiple lines:\0A+ This enum item has multiple\0A  lines because the next line\0A  is indented.\0A\0AFunction call.\0A#enum[First][Second]\0A```\0A\0AYou can easily switch all your enumerations to a different numbering style\0Awith a set rule.\0A```example\0A#set enum(numbering: \22a)\22)\0A\0A+ Starting off ...\0A+ Don't forget step two\0A```\0A\0AYou can also use [`enum.item`]($enum.item) to programmatically customize the\0Anumber of each item in the enumeration:\0A\0A```example\0A#enum(\0A  enum.item(1)[First step],\0A  enum.item(5)[Fifth step],\0A  enum.item(10)[Tenth step]\0A)\0A```\0A\0A# Syntax\0AThis functions also has dedicated syntax:\0A\0A- Starting a line with a plus sign creates an automatically numbered\0A  enumeration item.\0A- Starting a line with a number followed by a dot creates an explicitly\0A  numbered enumeration item.\0A\0AEnumeration items can contain multiple paragraphs and other block-level\0Acontent. All content that is indented more than an item's marker becomes\0Apart of that item." }>, align 1
@"_ZN5typst5model5enum_1_102_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..model..enum_..EnumElem$GT$4data4DATA17hf354842333958aabE.llvm.12777920187102919001" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.9efbc0c128adab6190fabe7f7e045142.874, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.875, [8 x i8] c"\0D\00\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.876, [8 x i8] c"\B4\04\00\00\00\00\00\00", ptr @anon.9efbc0c128adab6190fabe7f7e045142.64.llvm.12777920187102919001, [8 x i8] zeroinitializer, ptr @"_ZN5typst5model5enum_1_98_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..model..enum_..EnumElem$GT$9construct17h8ff6faae80790fe1E", ptr @"_ZN5typst5model5enum_1_92_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..model..enum_..EnumElem$GT$3set17h14a8c8cedc9eb586E", ptr @"_ZN5typst5model5enum_1_96_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..model..enum_..EnumElem$GT$6vtable17hc39174179a430552E", ptr @_ZN4core3ops8function6FnOnce9call_once17h19d66e7ac773e2e2E, ptr @_ZN4core3ops8function6FnOnce9call_once17h7a0d8dfe30bdb123E, ptr @"_ZN5typst5model5enum_1_95_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..model..enum_..EnumElem$GT$17field_from_styles17h5c61f9fc09569bc0E", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h9ec5b3d3e29d68edE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h4040a14b91f34e23E }>, align 8
@anon.9efbc0c128adab6190fabe7f7e045142.877 = private unnamed_addr constant <{ [673 x i8] }> <{ [673 x i8] c"If this is `{false}`, the items are spaced apart with\0A[enum spacing]($enum.spacing). If it is `{true}`, they use normal\0A[leading]($par.leading) instead. This makes the enumeration more\0Acompact, which can look better if the items are short.\0A\0AIn markup mode, the value of this parameter is determined based on\0Awhether items are separated with a blank line. If items directly follow\0Aeach other, this is set to `{true}`; if items are separated by a blank\0Aline, this is set to `{false}`.\0A\0A```example\0A+ If an enum has a lot of text, and\0A  maybe other inline content, it\0A  should not be tight anymore.\0A\0A+ To make an enum wide, simply\0A  insert a blank line between the\0A  items.\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.878 = private unnamed_addr constant <{ [463 x i8] }> <{ [463 x i8] c"How to number the enumeration. Accepts a\0A[numbering pattern or function]($numbering).\0A\0AIf the numbering pattern contains multiple counting symbols, they apply\0Ato nested enums. If given a function, the function receives one argument\0Aif `full` is `{false}` and multiple arguments if `full` is `{true}`.\0A\0A```example\0A#set enum(numbering: \221.a)\22)\0A+ Different\0A+ Numbering\0A  + Nested\0A  + Items\0A+ Style\0A\0A#set enum(numbering: n => super[#n])\0A+ Superscript\0A+ Numbering!\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.879 = private unnamed_addr constant <{ [105 x i8] }> <{ [105 x i8] c"Which number to start the enumeration with.\0A\0A```example\0A#enum(\0A  start: 3,\0A  [Skipping],\0A  [Ahead],\0A)\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.880 = private unnamed_addr constant <{ [196 x i8] }> <{ [196 x i8] c"Whether to display the full numbering, including the numbers of\0Aall parent enumerations.\0A\0A\0A```example\0A#set enum(numbering: \221.a)\22, full: true)\0A+ Cook\0A  + Heat water\0A  + Add integredients\0A+ Eat\0A```" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.881 = private unnamed_addr constant <{ [29 x i8] }> <{ [29 x i8] c"The indentation of each item." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.882 = private unnamed_addr constant <{ [58 x i8] }> <{ [58 x i8] c"The space between the numbering and the body of each item." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.883 = private unnamed_addr constant <{ [132 x i8] }> <{ [132 x i8] c"The spacing between the items of a wide (non-tight) enumeration.\0A\0AIf set to `{auto}`, uses the spacing [below blocks]($block.below)." }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.884 = private unnamed_addr constant <{ [789 x i8] }> <{ [789 x i8] c"The alignment that enum numbers should have.\0A\0ABy default, this is set to `{end + top}`, which aligns enum numbers\0Atowards end of the current text direction (in left-to-right script,\0Afor example, this is the same as `{right}`) and at the top of the line.\0AThe choice of `{end}` for horizontal alignment of enum numbers is\0Ausually preferred over `{start}`, as numbers then grow away from the\0Atext instead of towards it, avoiding certain visual issues. This option\0Alets you override this behaviour, however. (Also to note is that the\0A[unordered list]($list) uses a different method for this, by giving the\0A`marker` content an alignment directly.).\0A\0A````example\0A#set enum(number-align: start + bottom)\0A\0AHere are some powers of two:\0A1. One\0A2. Two\0A4. Four\0A8. Eight\0A16. Sixteen\0A32. Thirty two\0A````" }>, align 1
@anon.9efbc0c128adab6190fabe7f7e045142.885 = private unnamed_addr constant <{ [241 x i8] }> <{ [241 x i8] c"The numbered list's items.\0A\0AWhen using the enum syntax, adjacent items are automatically collected\0Ainto enumerations, even through constructs like for loops.\0A\0A```example\0A#for phase in (\0A   \22Launch\22,\0A   \22Orbit\22,\0A   \22Descent\22,\0A) [+ #phase]\0A```" }>, align 1
