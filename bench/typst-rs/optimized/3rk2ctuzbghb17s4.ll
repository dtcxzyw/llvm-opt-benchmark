@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.689 = private unnamed_addr constant <{ [2098 x i8] }> <{ [2098 x i8] c"A figure with an optional caption.\0A\0AAutomatically detects its kind to select the correct counting track. For\0Aexample, figures containing images will be numbered separately from figures\0Acontaining tables.\0A\0A# Examples\0AThe example below shows a basic figure with an image:\0A```example\0A@glacier shows a glacier. Glaciers\0Aare complex systems.\0A\0A#figure(\0A  image(\22glacier.jpg\22, width: 80%),\0A  caption: [A curious figure.],\0A) <glacier>\0A```\0A\0AYou can also insert [tables]($table) into figures to give them a caption.\0AThe figure will detect this and automatically use a separate counter.\0A\0A```example\0A#figure(\0A  table(\0A    columns: 4,\0A    [t], [1], [2], [3],\0A    [y], [0.3s], [0.4s], [0.8s],\0A  ),\0A  caption: [Timing results],\0A)\0A```\0A\0AThis behaviour can be overridden by explicitly specifying the figure's\0A`kind`. All figures of the same kind share a common counter.\0A\0A# Figure behaviour\0ABy default, figures are placed within the flow of content. To make them\0Afloat to the top or bottom of the page, you can use the\0A[`placement`]($figure.placement) argument.\0A\0AIf your figure is too large and its contents are breakable across pages\0A(e.g. if it contains a large table), then you can make the figure itself\0Abreakable across pages as well with this show rule:\0A```typ\0A#show figure: set block(breakable: true)\0A```\0A\0ASee the [block]($block.breakable) documentation for more information about\0Abreakable and non-breakable blocks.\0A\0A# Caption customization\0AYou can modify the appearance of the figure's caption with its associated\0A[`caption`]($figure.caption) function. In the example below, we emphasize\0Aall captions:\0A\0A```example\0A#show figure.caption: emph\0A\0A#figure(\0A  rect[Hello],\0A  caption: [I am emphasized!],\0A)\0A```\0A\0ABy using a [`where`]($function.where) selector, we can scope such rules to\0Aspecific kinds of figures. For example, to position the caption above\0Atables, but keep it below for all other kinds of figures, we could write the\0Afollowing show-set rule:\0A\0A```example\0A#show figure.where(\0A  kind: table\0A): set figure.caption(position: top)\0A\0A#figure(\0A  table(columns: 2)[A][B][C][D],\0A  caption: [I'm up here],\0A)\0A```" }>, align 1
@"_ZN5typst5model6figure1_105_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..model..figure..FigureElem$GT$4data4DATA17ha487504e1c8deac3E.llvm.11057974413330164255" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.687, [8 x i8] c"\06\00\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.688, [8 x i8] c"\06\00\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.689, [8 x i8] c"2\08\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.10.llvm.11057974413330164255, [8 x i8] zeroinitializer, ptr @"_ZN5typst5model6figure1_101_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..model..figure..FigureElem$GT$9construct17h2edf490c4d8ada2bE", ptr @"_ZN5typst5model6figure1_95_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..model..figure..FigureElem$GT$3set17h2c30edb196063fd7E", ptr @"_ZN5typst5model6figure1_99_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..model..figure..FigureElem$GT$6vtable17h4f8e00a001658ce5E", ptr @_ZN4core3ops8function6FnOnce9call_once17h017e6dbcdcee81aeE, ptr @_ZN4core3ops8function6FnOnce9call_once17h596abbd896e13ab2E, ptr @"_ZN5typst5model6figure1_98_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..model..figure..FigureElem$GT$17field_from_styles17h009b520ecba0b5edE", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h2eee2476a05eb22fE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h90092e1ff85101e4E }>, align 8
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.690 = private unnamed_addr constant <{ [45 x i8] }> <{ [45 x i8] c"The content of the figure. Often, an [image]." }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.691 = private unnamed_addr constant <{ [631 x i8] }> <{ [631 x i8] c"The figure's placement on the page.\0A\0A- `{none}`: The figure stays in-flow exactly where it was specified\0A  like other content.\0A- `{auto}`: The figure picks `{top}` or `{bottom}` depending on which\0A  is closer.\0A- `{top}`: The figure floats to the top of the page.\0A- `{bottom}`: The figure floats to the bottom of the page.\0A\0AThe gap between the main flow content and the floating figure is\0Acontrolled by the [`clearance`]($place.clearance) argument on the\0A`place` function.\0A\0A```example\0A#set page(height: 200pt)\0A\0A= Introduction\0A#figure(\0A  placement: bottom,\0A  caption: [A glacier],\0A  image(\22glacier.jpg\22, width: 60%),\0A)\0A#lorem(60)\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.692 = private unnamed_addr constant <{ [21 x i8] }> <{ [21 x i8] c"The figure's caption." }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.693 = private unnamed_addr constant <{ [949 x i8] }> <{ [949 x i8] c"The kind of figure this is.\0A\0AAll figures of the same kind share a common counter.\0A\0AIf set to `{auto}`, the figure will try to automatically determine its\0Akind based on the type of its body. Automatically detected kinds are\0A[tables]($table) and [code]($raw). In other cases, the inferred kind is\0Athat of an [image].\0A\0ASetting this to something other than `{auto}` will override the\0Aautomatic detection. This can be useful if\0A- you wish to create a custom figure type that is not an\0A  [image], a [table] or [code]($raw),\0A- you want to force the figure to use a specific counter regardless of\0A  its content.\0A\0AYou can set the kind to be an element function or a string. If you set\0Ait to an element function other than [`{table}`]($table), [`{raw}`](raw)\0Aor [`{image}`](image), you will need to manually specify the figure's\0Asupplement.\0A\0A```example\0A#figure(\0A  circle(radius: 10pt),\0A  caption: [A curious atom.],\0A  kind: \22atom\22,\0A  supplement: [Atom],\0A)\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.694 = private unnamed_addr constant <{ [539 x i8] }> <{ [539 x i8] c"The figure's supplement.\0A\0AIf set to `{auto}`, the figure will try to automatically determine the\0Acorrect supplement based on the `kind` and the active\0A[text language]($text.lang). If you are using a custom figure type, you\0Awill need to manually specify the supplement.\0A\0AIf a function is specified, it is passed the first descendant of the\0Aspecified `kind` (typically, the figure's body) and should return\0Acontent.\0A\0A```example\0A#figure(\0A  [The contents of my figure!],\0A  caption: [My custom figure],\0A  supplement: [Bar],\0A  kind: \22foo\22,\0A)\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.695 = private unnamed_addr constant <{ [80 x i8] }> <{ [80 x i8] c"How to number the figure. Accepts a\0A[numbering pattern or function]($numbering)." }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.696 = private unnamed_addr constant <{ [46 x i8] }> <{ [46 x i8] c"The vertical gap between the body and caption." }>, align 1
