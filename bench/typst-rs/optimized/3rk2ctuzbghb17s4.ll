@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.752 = private unnamed_addr constant <{ [1133 x i8] }> <{ [1133 x i8] c"A section heading.\0A\0AWith headings, you can structure your document into sections. Each heading\0Ahas a _level,_ which starts at one and is unbounded upwards. This level\0Aindicates the logical role of the following content (section, subsection,\0Aetc.) A top-level heading indicates a top-level section of the document\0A(not the document's title).\0A\0ATypst can automatically number your headings for you. To enable numbering,\0Aspecify how you want your headings to be numbered with a\0A[numbering pattern or function]($numbering).\0A\0AIndependently of the numbering, Typst can also automatically generate an\0A[outline] of all headings for you. To exclude one or more headings from this\0Aoutline, you can set the `outlined` parameter to `{false}`.\0A\0A# Example\0A```example\0A#set heading(numbering: \221.a)\22)\0A\0A= Introduction\0AIn recent years, ...\0A\0A== Preliminaries\0ATo start, ...\0A```\0A\0A# Syntax\0AHeadings have dedicated syntax: They can be created by starting a line with\0Aone or multiple equals signs, followed by a space. The number of equals\0Asigns determines the heading's logical nesting depth. The `{offset}` field\0Acan be set to configure the starting depth." }>, align 1
@"_ZN5typst5model7heading1_107_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..model..heading..HeadingElem$GT$4data4DATA17hea2039c21598b9daE.llvm.11057974413330164255" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, ptr, [16 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.750, [8 x i8] c"\07\00\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.751, [8 x i8] c"\07\00\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.752, [8 x i8] c"m\04\00\00\00\00\00\00", ptr @anon.9bf146a73cb71d9c7e3fe69f46c42f4a.10.llvm.11057974413330164255, [8 x i8] zeroinitializer, ptr @"_ZN5typst5model7heading1_103_$LT$impl$u20$typst..foundations..element..Construct$u20$for$u20$typst..model..heading..HeadingElem$GT$9construct17h8622242993d267a7E", ptr @"_ZN5typst5model7heading1_97_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..model..heading..HeadingElem$GT$3set17h47ac2f378c17e2bcE", ptr @"_ZN5typst5model7heading1_101_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..model..heading..HeadingElem$GT$6vtable17hcd881a64271e7953E", ptr @_ZN4core3ops8function6FnOnce9call_once17h31720758ea5c4b05E, ptr @_ZN4core3ops8function6FnOnce9call_once17h7bb5a938e6dbbd5bE, ptr @"_ZN5typst5model7heading1_100_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..model..heading..HeadingElem$GT$17field_from_styles17hbb32d6c5b91dacb1E", ptr @"_ZN5typst5model7heading136_$LT$impl$u20$typst..text..lang..LocalName$u20$for$u20$typst..foundations..content..Packed$LT$typst..model..heading..HeadingElem$GT$$GT$10local_name17h9acd2da07faadd59E", [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h0c12e930c69c88a3E, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17hd71b89ff35b6ddbdE }>, align 8
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.753 = private unnamed_addr constant <{ [435 x i8] }> <{ [435 x i8] c"The absolute nesting depth of the heading, starting from one. If set\0Ato `{auto}`, it is computed from `{offset + depth}`.\0A\0AThis is primarily useful for usage in [show rules]($styling/#show-rules)\0A(either with [`where`]($function.where) selectors or by accessing the\0Alevel directly on a shown heading).\0A\0A```example\0A#show heading.where(level: 2): set text(red)\0A\0A= Level 1\0A== Level 2\0A\0A#set heading(offset: 1)\0A= Also level 2\0A== Level 3\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.754 = private unnamed_addr constant <{ [367 x i8] }> <{ [367 x i8] c"The relative nesting depth of the heading, starting from one. This is\0Acombined with `{offset}` to compute the actual `{level}`.\0A\0AThis is set by the heading syntax, such that `[== Heading]` creates a\0Aheading with logical depth of 2, but actual level `{offset + 2}`. If you\0Aconstruct a heading manually, you should typically prefer this over\0Asetting the absolute level." }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.755 = private unnamed_addr constant <{ [240 x i8] }> <{ [240 x i8] c"The starting offset of each heading's `{level}`, used to turn its\0Arelative `{depth}` into its absolute `{level}`.\0A\0A```example\0A= Level 1\0A\0A#set heading(offset: 1, numbering: \221.1\22)\0A= Level 2\0A\0A#heading(offset: 2, depth: 2)[\0A  I'm level 4\0A]\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.756 = private unnamed_addr constant <{ [179 x i8] }> <{ [179 x i8] c"How to number the heading. Accepts a\0A[numbering pattern or function]($numbering).\0A\0A```example\0A#set heading(numbering: \221.a.\22)\0A\0A= A section\0A== A subsection\0A=== A sub-subsection\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.757 = private unnamed_addr constant <{ [383 x i8] }> <{ [383 x i8] c"A supplement for the heading.\0A\0AFor references to headings, this is added before the referenced number.\0A\0AIf a function is specified, it is passed the referenced heading and\0Ashould return content.\0A\0A```example\0A#set heading(numbering: \221.\22, supplement: [Chapter])\0A\0A= Introduction <intro>\0AIn @intro, we see how to turn\0ASections into Chapters. And\0Ain @intro[Part], it is done\0Amanually.\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.758 = private unnamed_addr constant <{ [407 x i8] }> <{ [407 x i8] c"Whether the heading should appear in the [outline].\0A\0ANote that this property, if set to `{true}`, ensures the heading is also\0Ashown as a bookmark in the exported PDF's outline (when exporting to\0APDF). To change that behavior, use the `bookmarked` property.\0A\0A```example\0A#outline()\0A\0A#heading[Normal]\0AThis is a normal heading.\0A\0A#heading(outlined: false)[Hidden]\0AThis heading does not appear\0Ain the outline.\0A```" }>, align 1
@anon.9bf146a73cb71d9c7e3fe69f46c42f4a.759 = private unnamed_addr constant <{ [643 x i8] }> <{ [643 x i8] c"Whether the heading should appear as a bookmark in the exported PDF's\0Aoutline. Doesn't affect other export formats, such as PNG.\0A\0AThe default value of `{auto}` indicates that the heading will only\0Aappear in the exported PDF's outline if its `outlined` property is set\0Ato `{true}`, that is, if it would also be listed in Typst's [outline].\0ASetting this property to either `{true}` (bookmark) or `{false}` (don't\0Abookmark) bypasses that behavior.\0A\0A```example\0A#heading[Normal heading]\0AThis heading will be shown in\0Athe PDF's bookmark outline.\0A\0A#heading(bookmarked: false)[Not bookmarked]\0AThis heading won't be\0Abookmarked in the resulting\0APDF.\0A```" }>, align 1
