@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1062 = private unnamed_addr constant <{ [387 x i8] }> <{ [387 x i8] c"Customizes the look and layout of text in a variety of ways.\0A\0AThis function is used frequently, both with set rules and directly. While\0Athe set rule is often the simpler choice, calling the `text` function\0Adirectly can be useful when passing text as an argument to another function.\0A\0A# Example\0A```example\0A#set text(18pt)\0AWith a set rule.\0A\0A#emph(text(blue)[\0A  With a function call.\0A])\0A```" }>, align 1
@"_ZN5typst4text1_94_$LT$impl$u20$typst..foundations..element..NativeElement$u20$for$u20$typst..text..TextElem$GT$4data4DATA17h23ec8ea186ccda7fE.llvm.7325118056162354838" = hidden global <{ ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, ptr, ptr, ptr, ptr, ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr }> <{ ptr @anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1024.llvm.7325118056162354838, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1025.llvm.7325118056162354838, [8 x i8] c"\04\00\00\00\00\00\00\00", ptr @anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1062, [8 x i8] c"\83\01\00\00\00\00\00\00", ptr @anon.6e01a69b2c234dfdc5e23dbc943ea0bc.57.llvm.7325118056162354838, [8 x i8] zeroinitializer, ptr @"_ZN80_$LT$typst..text..TextElem$u20$as$u20$typst..foundations..element..Construct$GT$9construct17h24fb6ba6f40aeb3bE", ptr @"_ZN5typst4text1_84_$LT$impl$u20$typst..foundations..element..Set$u20$for$u20$typst..text..TextElem$GT$3set17ha9c12c489c05f719E", ptr @"_ZN5typst4text1_88_$LT$impl$u20$typst..foundations..element..Capable$u20$for$u20$typst..text..TextElem$GT$6vtable17h33e67a5cc2d1af8aE", ptr @_ZN4core3ops8function6FnOnce9call_once17h62bb486857e1d72fE, ptr @_ZN4core3ops8function6FnOnce9call_once17h08cb7336e6d0eb6cE, ptr @"_ZN5typst4text1_87_$LT$impl$u20$typst..foundations..element..Fields$u20$for$u20$typst..text..TextElem$GT$17field_from_styles17h9631f90b7213c632E", [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17h952bc7054ba34545E, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17hed89ea6b13419abcE }>, align 8
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1063 = private unnamed_addr constant <{ [978 x i8] }> <{ [978 x i8] c"A font family name or priority list of font family names.\0A\0AWhen processing text, Typst tries all specified font families in order\0Auntil it finds a font that has the necessary glyphs. In the example\0Abelow, the font `Inria Serif` is preferred, but since it does not\0Acontain Arabic glyphs, the arabic text uses `Noto Sans Arabic` instead.\0A\0AThe collection of available fonts differs by platform:\0A\0A- In the web app, you can see the list of available fonts by clicking on\0A  the \22Ag\22 button. You can provide additional fonts by uploading `.ttf`\0A  or `.otf` files into your project. They will be discovered\0A  automatically.\0A\0A- Locally, Typst uses your installed system fonts. In addition, you can\0A  use the `--font-path` argument or `TYPST_FONT_PATHS` environment\0A  variable to add directories that should be scanned for fonts.\0A\0A```example\0A#set text(font: \22PT Sans\22)\0AThis is sans-serif.\0A\0A#set text(font: (\0A  \22Inria Serif\22,\0A  \22Noto Sans Arabic\22,\0A))\0A\0AThis is Latin. \\\0A\D9\87\D8\B0\D8\A7 \D8\B9\D8\B1\D8\A8\D9\8A.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1064 = private unnamed_addr constant <{ [604 x i8] }> <{ [604 x i8] c"Whether to allow last resort font fallback when the primary font list\0Acontains no match. This lets Typst search through all available fonts\0Afor the most similar one that has the necessary glyphs.\0A\0A_Note:_ Currently, there are no warnings when fallback is disabled and\0Ano glyphs are found. Instead, your text shows up in the form of \22tofus\22:\0ASmall boxes that indicate the lack of an appropriate glyph. In the\0Afuture, you will be able to instruct Typst to issue warnings so you know\0Asomething is up.\0A\0A```example\0A#set text(font: \22Inria Serif\22)\0A\D9\87\D8\B0\D8\A7 \D8\B9\D8\B1\D8\A8\D9\8A\0A\0A#set text(fallback: false)\0A\D9\87\D8\B0\D8\A7 \D8\B9\D8\B1\D8\A8\D9\8A\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1065 = private unnamed_addr constant <{ [743 x i8] }> <{ [743 x i8] c"The desired font style.\0A\0AWhen an italic style is requested and only an oblique one is available,\0Ait is used. Similarly, the other way around, an italic style can stand\0Ain for an oblique one.  When neither an italic nor an oblique style is\0Aavailable, Typst selects the normal style. Since most fonts are only\0Aavailable either in an italic or oblique style, the difference between\0Aitalic and oblique style is rarely observable.\0A\0AIf you want to emphasize your text, you should do so using the [emph]\0Afunction instead. This makes it easy to adapt the style later if you\0Achange your mind about how to signify the emphasis.\0A\0A```example\0A#text(font: \22Linux Libertine\22, style: \22italic\22)[Italic]\0A#text(font: \22DejaVu Sans\22, style: \22oblique\22)[Oblique]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1066 = private unnamed_addr constant <{ [656 x i8] }> <{ [656 x i8] c"The desired thickness of the font's glyphs. Accepts an integer between\0A`{100}` and `{900}` or one of the predefined weight names. When the\0Adesired weight is not available, Typst selects the font from the family\0Athat is closest in weight.\0A\0AIf you want to strongly emphasize your text, you should do so using the\0A[strong] function instead. This makes it easy to adapt the style later\0Aif you change your mind about how to signify the strong emphasis.\0A\0A```example\0A#set text(font: \22IBM Plex Sans\22)\0A\0A#text(weight: \22light\22)[Light] \\\0A#text(weight: \22regular\22)[Regular] \\\0A#text(weight: \22medium\22)[Medium] \\\0A#text(weight: 500)[Medium] \\\0A#text(weight: \22bold\22)[Bold]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1067 = private unnamed_addr constant <{ [515 x i8] }> <{ [515 x i8] c"The desired width of the glyphs. Accepts a ratio between `{50%}` and\0A`{200%}`. When the desired width is not available, Typst selects the\0Afont from the family that is closest in stretch. This will only stretch\0Athe text if a condensed or expanded version of the font is available.\0A\0AIf you want to adjust the amount of space between characters instead of\0Astretching the glyphs itself, use the [`tracking`]($text.tracking)\0Aproperty instead.\0A\0A```example\0A#text(stretch: 75%)[Condensed] \\\0A#text(stretch: 100%)[Normal]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1068 = private unnamed_addr constant <{ [277 x i8] }> <{ [277 x i8] c"The size of the glyphs. This value forms the basis of the `em` unit:\0A`{1em}` is equivalent to the font size.\0A\0AYou can also give the font size itself in `em` units. Then, it is\0Arelative to the previous font size.\0A\0A```example\0A#set text(size: 20pt)\0Avery #text(1.5em)[big] text\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1069 = private unnamed_addr constant <{ [76 x i8] }> <{ [76 x i8] c"The glyph fill paint.\0A\0A```example\0A#set text(fill: red)\0AThis text is red.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1070 = private unnamed_addr constant <{ [75 x i8] }> <{ [75 x i8] c"How to stroke the text.\0A\0A```example\0A#text(stroke: 0.5pt + red)[Stroked]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1071 = private unnamed_addr constant <{ [117 x i8] }> <{ [117 x i8] c"The amount of space that should be added between characters.\0A\0A```example\0A#set text(tracking: 1.5pt)\0ADistant text.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1072 = private unnamed_addr constant <{ [340 x i8] }> <{ [340 x i8] c"The amount of space between words.\0A\0ACan be given as an absolute length, but also relative to the width of\0Athe space character in the font.\0A\0AIf you want to adjust the amount of space between characters rather than\0Awords, use the [`tracking`]($text.tracking) property instead.\0A\0A```example\0A#set text(spacing: 200%)\0AText with distant words.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1073 = private unnamed_addr constant <{ [224 x i8] }> <{ [224 x i8] c"Whether to automatically insert spacing between CJK and Latin characters.\0A\0A```example\0A#set text(cjk-latin-spacing: auto)\0A\E7\AC\AC4\E7\AB\A0\E4\BB\8B\E7\BB\8D\E4\BA\86\E5\9F\BA\E6\9C\AC\E7\9A\84API\E3\80\82\0A\0A#set text(cjk-latin-spacing: none)\0A\E7\AC\AC4\E7\AB\A0\E4\BB\8B\E7\BB\8D\E4\BA\86\E5\9F\BA\E6\9C\AC\E7\9A\84API\E3\80\82\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1074 = private unnamed_addr constant <{ [94 x i8] }> <{ [94 x i8] c"An amount to shift the text baseline by.\0A\0A```example\0AA #text(baseline: 3pt)[lowered]\0Aword.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1075 = private unnamed_addr constant <{ [481 x i8] }> <{ [481 x i8] c"Whether certain glyphs can hang over into the margin in justified text.\0AThis can make justification visually more pleasing.\0A\0A```example\0A#set par(justify: true)\0AThis justified text has a hyphen in\0Athe paragraph's first line. Hanging\0Athe hyphen slightly into the margin\0Aresults in a clearer paragraph edge.\0A\0A#set text(overhang: false)\0AThis justified text has a hyphen in\0Athe paragraph's first line. Hanging\0Athe hyphen slightly into the margin\0Aresults in a clearer paragraph edge.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1076 = private unnamed_addr constant <{ [314 x i8] }> <{ [314 x i8] c"The top end of the conceptual frame around the text used for layout and\0Apositioning. This affects the size of containers that hold text.\0A\0A```example\0A#set rect(inset: 0pt)\0A#set text(size: 20pt)\0A\0A#set text(top-edge: \22ascender\22)\0A#rect(fill: aqua)[Typst]\0A\0A#set text(top-edge: \22cap-height\22)\0A#rect(fill: aqua)[Typst]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1077 = private unnamed_addr constant <{ [322 x i8] }> <{ [322 x i8] c"The bottom end of the conceptual frame around the text used for layout\0Aand positioning. This affects the size of containers that hold text.\0A\0A```example\0A#set rect(inset: 0pt)\0A#set text(size: 20pt)\0A\0A#set text(bottom-edge: \22baseline\22)\0A#rect(fill: aqua)[Typst]\0A\0A#set text(bottom-edge: \22descender\22)\0A#rect(fill: aqua)[Typst]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1078 = private unnamed_addr constant <{ [476 x i8] }> <{ [476 x i8] c"An [ISO 639-1/2/3 language code.](https://en.wikipedia.org/wiki/ISO_639)\0A\0ASetting the correct language affects various parts of Typst:\0A\0A- The text processing pipeline can make more informed choices.\0A- Hyphenation will use the correct patterns for the language.\0A- [Smart quotes]($smartquote) turns into the correct quotes for the\0A  language.\0A- And all other things which are language-aware.\0A\0A```example\0A#set text(lang: \22de\22)\0A#outline()\0A\0A= Einleitung\0AIn diesem Dokument, ...\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1079 = private unnamed_addr constant <{ [154 x i8] }> <{ [154 x i8] c"An [ISO 3166-1 alpha-2 region code.](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)\0A\0AThis lets the text processing pipeline make more informed choices." }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1080 = private unnamed_addr constant <{ [746 x i8] }> <{ [746 x i8] c"The OpenType writing script.\0A\0AThe combination of `{lang}` and `{script}` determine how font features,\0Asuch as glyph substitution, are implemented. Frequently the value is a\0Amodified (all-lowercase) ISO 15924 script identifier, and the `math`\0Awriting script is used for features appropriate for mathematical\0Asymbols.\0A\0AWhen set to `{auto}`, the default and recommended setting, an\0Aappropriate script is chosen for each block of characters sharing a\0Acommon Unicode script property.\0A\0A```example\0A#set text(\0A  font: \22Linux Libertine\22,\0A  size: 20pt,\0A)\0A\0A#let scedilla = [\C5\9E]\0A#scedilla // S with a cedilla\0A\0A#set text(lang: \22ro\22, script: \22latn\22)\0A#scedilla // S with a subscript comma\0A\0A#set text(lang: \22ro\22, script: \22grek\22)\0A#scedilla // S with a cedilla\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1081 = private unnamed_addr constant <{ [1035 x i8] }> <{ [1035 x i8] c"The dominant direction for text and inline objects. Possible values are:\0A\0A- `{auto}`: Automatically infer the direction from the `lang` property.\0A- `{ltr}`: Layout text from left to right.\0A- `{rtl}`: Layout text from right to left.\0A\0AWhen writing in right-to-left scripts like Arabic or Hebrew, you should\0Aset the [text language]($text.lang) or direction. While individual runs\0Aof text are automatically layouted in the correct direction, setting the\0Adominant direction gives the bidirectional reordering algorithm the\0Anecessary information to correctly place punctuation and inline objects.\0AFurthermore, setting the direction affects the alignment values `start`\0Aand `end`, which are equivalent to `left` and `right` in `ltr` text and\0Athe other way around in `rtl` text.\0A\0AIf you set this to `rtl` and experience bugs or in some way bad looking\0Aoutput, please do get in touch with us through the\0A[contact form](https://typst.app/contact) or our\0A[Discord server]($community/#discord)!\0A\0A```example\0A#set text(dir: rtl)\0A\D9\87\D8\B0\D8\A7 \D8\B9\D8\B1\D8\A8\D9\8A.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1082 = private unnamed_addr constant <{ [470 x i8] }> <{ [470 x i8] c"Whether to hyphenate text to improve line breaking. When `{auto}`, text\0Awill be hyphenated if and only if justification is enabled.\0A\0ASetting the [text language]($text.lang) ensures that the correct\0Ahyphenation patterns are used.\0A\0A```example\0A#set page(width: 200pt)\0A\0A#set par(justify: true)\0AThis text illustrates how\0Aenabling hyphenation can\0Aimprove justification.\0A\0A#set text(hyphenate: false)\0AThis text illustrates how\0Aenabling hyphenation can\0Aimprove justification.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1083 = private unnamed_addr constant <{ [423 x i8] }> <{ [423 x i8] c"Whether to apply kerning.\0A\0AWhen enabled, specific letter pairings move closer together or further\0Aapart for a more visually pleasing result. The example below\0Ademonstrates how decreasing the gap between the \22T\22 and \22o\22 results in a\0Amore natural look. Setting this to `{false}` disables kerning by turning\0Aoff the OpenType `kern` font feature.\0A\0A```example\0A#set text(size: 25pt)\0ATotally\0A\0A#set text(kerning: false)\0ATotally\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1084 = private unnamed_addr constant <{ [317 x i8] }> <{ [317 x i8] c"Whether to apply stylistic alternates.\0A\0ASometimes fonts contain alternative glyphs for the same codepoint.\0ASetting this to `{true}` switches to these by enabling the OpenType\0A`salt` font feature.\0A\0A```example\0A#set text(\0A  font: \22IBM Plex Sans\22,\0A  size: 20pt,\0A)\0A\0A0, a, g, \C3\9F\0A\0A#set text(alternates: true)\0A0, a, g, \C3\9F\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1085 = private unnamed_addr constant <{ [331 x i8] }> <{ [331 x i8] c"Which stylistic set to apply. Font designers can categorize alternative\0Aglyphs forms into stylistic sets. As this value is highly font-specific,\0Ayou need to consult your font to know which sets are available. When set\0Ato an integer between `{1}` and `{20}`, enables the corresponding\0AOpenType font feature from `ss01`, ..., `ss20`." }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1086 = private unnamed_addr constant <{ [356 x i8] }> <{ [356 x i8] c"Whether standard ligatures are active.\0A\0ACertain letter combinations like \22fi\22 are often displayed as a single\0Amerged glyph called a _ligature._ Setting this to `{false}` disables\0Athese ligatures by turning off the OpenType `liga` and `clig` font\0Afeatures.\0A\0A```example\0A#set text(size: 20pt)\0AA fine ligature.\0A\0A#set text(ligatures: false)\0AA fine ligature.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1087 = private unnamed_addr constant <{ [126 x i8] }> <{ [126 x i8] c"Whether ligatures that should be used sparingly are active. Setting this\0Ato `{true}` enables the OpenType `dlig` font feature." }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1088 = private unnamed_addr constant <{ [107 x i8] }> <{ [107 x i8] c"Whether historical ligatures are active. Setting this to `{true}`\0Aenables the OpenType `hlig` font feature." }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1089 = private unnamed_addr constant <{ [248 x i8] }> <{ [248 x i8] c"Which kind of numbers / figures to select. When set to `{auto}`, the\0Adefault numbers for the font are used.\0A\0A```example\0A#set text(font: \22Noto Sans\22, 20pt)\0A#set text(number-type: \22lining\22)\0ANumber 9.\0A\0A#set text(number-type: \22old-style\22)\0ANumber 9.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1090 = private unnamed_addr constant <{ [271 x i8] }> <{ [271 x i8] c"The width of numbers / figures. When set to `{auto}`, the default\0Anumbers for the font are used.\0A\0A```example\0A#set text(font: \22Noto Sans\22, 20pt)\0A#set text(number-width: \22proportional\22)\0AA 12 B 34. \\\0AA 56 B 78.\0A\0A#set text(number-width: \22tabular\22)\0AA 12 B 34. \\\0AA 56 B 78.\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1091 = private unnamed_addr constant <{ [162 x i8] }> <{ [162 x i8] c"Whether to have a slash through the zero glyph. Setting this to `{true}`\0Aenables the OpenType `zero` font feature.\0A\0A```example\0A0, #text(slashed-zero: true)[0]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1092 = private unnamed_addr constant <{ [342 x i8] }> <{ [342 x i8] c"Whether to turn numbers into fractions. Setting this to `{true}`\0Aenables the OpenType `frac` font feature.\0A\0AIt is not advisable to enable this property globally as it will mess\0Awith all appearances of numbers after a slash (e.g., in URLs). Instead,\0Aenable it locally when you want a fraction.\0A\0A```example\0A1/2 \\\0A#text(fractions: true)[1/2]\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1093 = private unnamed_addr constant <{ [312 x i8] }> <{ [312 x i8] c"Raw OpenType features to apply.\0A\0A- If given an array of strings, sets the features identified by the\0A  strings to `{1}`.\0A- If given a dictionary mapping to numbers, sets the features\0A  identified by the keys to the values.\0A\0A```example\0A// Enable the `frac` feature manually.\0A#set text(features: (\22frac\22,))\0A1/2\0A```" }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1094 = private unnamed_addr constant <{ [69 x i8] }> <{ [69 x i8] c"Content in which all text is styled according to the other arguments." }>, align 1
@anon.6e01a69b2c234dfdc5e23dbc943ea0bc.1095 = private unnamed_addr constant <{ [9 x i8] }> <{ [9 x i8] c"The text." }>, align 1
