@anon.db70647216840ea9fd0320153731fc7a.453 = private unnamed_addr constant <{ [577 x i8] }> <{ [577 x i8] c"Applies a numbering to a sequence of numbers.\0A\0AA numbering defines how a sequence of numbers should be displayed as\0Acontent. It is defined either through a pattern string or an arbitrary\0Afunction.\0A\0AA numbering pattern consists of counting symbols, for which the actual\0Anumber is substituted, their prefixes, and one suffix. The prefixes and the\0Asuffix are repeated as-is.\0A\0A# Example\0A```example\0A#numbering(\221.1)\22, 1, 2, 3) \\\0A#numbering(\221.a.i\22, 1, 2) \\\0A#numbering(\22I \E2\80\93 1\22, 12, 2) \\\0A#numbering(\0A  (..nums) => nums\0A    .pos()\0A    .map(str)\0A    .join(\22.\22) + \22)\22,\0A  1, 2, 3,\0A)\0A```" }>, align 1
@"_ZN92_$LT$typst..model..numbering_..numbering$u20$as$u20$typst..foundations..func..NativeFunc$GT$4data4DATA17h700516203cc4b808E.llvm.4930786928582598558" = hidden global <{ ptr, ptr, [8 x i8], ptr, [8 x i8], ptr, [8 x i8], ptr, [24 x i8], [80 x i8], ptr, [16 x i8], [16 x i8], ptr, [1 x i8], [47 x i8], [8 x i8], ptr, [1 x i8], [7 x i8] }> <{ ptr @_ZN4core3ops8function6FnOnce9call_once17h8a3bb1e0f5f55acaE, ptr @anon.db70647216840ea9fd0320153731fc7a.451, [8 x i8] c"\09\00\00\00\00\00\00\00", ptr @anon.db70647216840ea9fd0320153731fc7a.452, [8 x i8] c"\09\00\00\00\00\00\00\00", ptr @anon.db70647216840ea9fd0320153731fc7a.453, [8 x i8] c"A\02\00\00\00\00\00\00", ptr @anon.db70647216840ea9fd0320153731fc7a.27.llvm.4930786928582598558, [24 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [80 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17haf275fc79446af3eE, [16 x i8] c"\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\80", [16 x i8] undef, ptr @_ZN4core3ops8function6FnOnce9call_once17hf9ba98275ea0988cE, [1 x i8] c"\22", [47 x i8] undef, [8 x i8] zeroinitializer, ptr @_ZN4core3ops8function6FnOnce9call_once17hd33dc606cda713e4E, [1 x i8] zeroinitializer, [7 x i8] undef }>, align 8
@anon.db70647216840ea9fd0320153731fc7a.454 = private unnamed_addr constant <{ [1112 x i8] }> <{ [1112 x i8] c"Defines how the numbering works.\0A\0A**Counting symbols** are `1`, `a`, `A`, `i`, `I`, `\E4\B8\80`, `\E5\A3\B9`, `\E3\81\82`, `\E3\81\84`, `\E3\82\A2`, `\E3\82\A4`, `\D7\90`, `\EA\B0\80`,\0A`\E3\84\B1`, and `*`. They are replaced by the number in the sequence, in the\0Agiven case.\0A\0AThe `*` character means that symbols should be used to count, in the\0Aorder of `*`, `\E2\80\A0`, `\E2\80\A1`, `\C2\A7`, `\C2\B6`, and `\E2\80\96`. If there are more than six\0Aitems, the number is represented using multiple symbols.\0A\0A**Suffixes** are all characters after the last counting symbol. They are\0Arepeated as-is at the end of any rendered number.\0A\0A**Prefixes** are all characters that are neither counting symbols nor\0Asuffixes. They are repeated as-is at in front of their rendered\0Aequivalent of their counting symbol.\0A\0AThis parameter can also be an arbitrary function that gets each number\0Aas an individual argument. When given a function, the `numbering`\0Afunction just forwards the arguments to that function. While this is not\0Aparticularly useful in itself, it means that you can just give arbitrary\0Anumberings to the `numbering` function without caring whether they are\0Adefined as a pattern or function." }>, align 1
