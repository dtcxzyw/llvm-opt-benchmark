@anon.863986d00e4103fb69f29fe2b65b0919.777 = private unnamed_addr constant <{ [955 x i8] }> <{ [955 x i8] c"A repeatable table header.\0A\0AYou should wrap your tables' heading rows in this function even if you do not\0Aplan to wrap your table across pages because Typst will use this function to\0Aattach accessibility metadata to tables in the future and ensure universal\0Aaccess to your document.\0A\0AYou can use the `repeat` parameter to control whether your table's header\0Awill be repeated across pages.\0A\0A```example\0A#set page(height: 11.5em)\0A#set table(\0A  fill: (x, y) =>\0A    if x == 0 or y == 0 {\0A      gray.lighten(40%)\0A    },\0A  align: right,\0A)\0A\0A#show table.cell.where(x: 0): strong\0A#show table.cell.where(y: 0): strong\0A\0A#table(\0A  columns: 4,\0A  table.header(\0A    [], [Blue chip],\0A    [Fresh IPO], [Penny st'k],\0A  ),\0A  table.cell(\0A    rowspan: 6,\0A    align: horizon,\0A    rotate(-90deg, reflow: true)[\0A      *USD / day*\0A    ],\0A  ),\0A  [0.20], [104], [5],\0A  [3.17], [108], [4],\0A  [1.59], [84],  [1],\0A  [0.26], [98],  [15],\0A  [0.01], [195], [4],\0A  [7.34], [57],  [2],\0A)\0A```" }>, align 1
