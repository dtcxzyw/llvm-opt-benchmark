@anon.863986d00e4103fb69f29fe2b65b0919.763 = private unnamed_addr constant <{ [583 x i8] }> <{ [583 x i8] c"How to fill the cells.\0A\0AThis can be a color or a function that returns a color. The function\0Areceives the cells' column and row indices, starting from zero. This can\0Abe used to implement striped tables.\0A\0A```example\0A#table(\0A  fill: (x, _) =>\0A    if calc.odd(x) { luma(240) }\0A    else { white },\0A  align: (x, y) =>\0A    if y == 0 { center }\0A    else if x == 0 { left }\0A    else { right },\0A  columns: 4,\0A  [], [*Q1*], [*Q2*], [*Q3*],\0A  [Revenue:], [1000 \E2\82\AC], [2000 \E2\82\AC], [3000 \E2\82\AC],\0A  [Expenses:], [500 \E2\82\AC], [1000 \E2\82\AC], [1500 \E2\82\AC],\0A  [Profit:], [500 \E2\82\AC], [1000 \E2\82\AC], [1500 \E2\82\AC],\0A)\0A```" }>, align 1
