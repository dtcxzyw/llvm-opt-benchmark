; Function Attrs: nounwind uwtable
define double @dsum_(ptr nocapture noundef readonly %0, ptr noundef %1, ptr nocapture noundef readonly %2) local_unnamed_addr #0 {
  %4 = load i32, ptr %0, align 4, !tbaa !3
  %5 = icmp slt i32 %4, 1
  br i1 %5, label %11, label %6

6:                                                ; preds = %3
  %7 = zext nneg i32 %4 to i64
  %8 = load i32, ptr %2, align 4, !tbaa !3
  %9 = sext i32 %8 to i64
  %10 = tail call double @dsum_k(i64 noundef %7, ptr noundef %1, i64 noundef %9) #2
  br label %11

11:                                               ; preds = %6, %3
  %12 = phi double [ %10, %6 ], [ 0.000000e+00, %3 ]
  ret double %12
}

