@stderr = external local_unnamed_addr global ptr, align 8

; Function Attrs: nounwind uwtable
define void @openblas_warning(i32 noundef %0, ptr nocapture noundef readonly %1) local_unnamed_addr #0 {
  %3 = tail call i32 @openblas_verbose() #3
  %4 = icmp slt i32 %3, %0
  br i1 %4, label %8, label %5

5:                                                ; preds = %2
  %6 = load ptr, ptr @stderr, align 8, !tbaa !3
  %7 = tail call i32 @fputs(ptr %1, ptr %6) #4
  br label %8

8:                                                ; preds = %5, %2
  ret void
}

declare i32 @openblas_verbose() local_unnamed_addr #1

