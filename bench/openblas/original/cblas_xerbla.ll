16:                                               ; preds = %11, %3
  %17 = load ptr, ptr @stderr, align 8, !tbaa !10
  %18 = load ptr, ptr %6, align 8, !tbaa !7
  %19 = getelementptr inbounds [1 x %struct.__va_list_tag], ptr %7, i64 0, i64 0
