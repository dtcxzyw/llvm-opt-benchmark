@.str.618 = private unnamed_addr constant [25 x i8] c"BOOST_TEST_USE_ALT_STACK\00", align 1
@.str.619 = private unnamed_addr constant [219 x i8] c"Instructs the framework to use an alternative stack for operating system's signals handling (on platforms where this is supported). The feature is enabled by default, but can be disabled using this command line switch.\00", align 1
