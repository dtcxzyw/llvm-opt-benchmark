@.str.582 = private unnamed_addr constant [150 x i8] c"Allows to switch between sequential and random order of test units execution. Optionally allows to specify concrete seed for random number generator.\00", align 1
@.str.583 = private unnamed_addr constant [18 x i8] c"BOOST_TEST_RANDOM\00", align 1
@.str.584 = private unnamed_addr constant [7 x i8] c"<seed>\00", align 1
@.str.585 = private unnamed_addr constant [478 x i8] c"Instructs the framework to execute the test cases in random order. This parameter accepts an optional unsigned integer argument. If parameter is specified without the argument value testing order is randomized based on current time. Alternatively you can specify any positive value greater than 1 and it will be used as random seed for the run. By default, the test cases are executed in an order defined by their declaration and the optional dependencies among the test units.\00", align 1
@.str.586 = private unnamed_addr constant [34 x i8] c"Specifies the test report format.\00", align 1
@.str.587 = private unnamed_addr constant [25 x i8] c"BOOST_TEST_REPORT_FORMAT\00", align 1
@.str.588 = private unnamed_addr constant [361 x i8] c"Set the framework's report format to one of the formats supplied by the framework. The only acceptable values for this parameter are the names of the output formats. By default the framework uses human readable format (HRF) for results reporting. Alternatively you can specify XML as report format. This format is easier to process by testing automation tools.\00", align 1
@.str.589 = private unnamed_addr constant [2 x i8] c"m\00", align 1
@.str.590 = private unnamed_addr constant [29 x i8] c"Specifies test report level.\00", align 1
@.str.591 = private unnamed_addr constant [24 x i8] c"BOOST_TEST_REPORT_LEVEL\00", align 1
@.str.592 = private unnamed_addr constant [8 x i8] c"confirm\00", align 1
@.str.593 = private unnamed_addr constant [6 x i8] c"short\00", align 1
@.str.594 = private unnamed_addr constant [9 x i8] c"detailed\00", align 1
@.str.595 = private unnamed_addr constant [3 x i8] c"no\00", align 1
@.str.596 = private unnamed_addr constant [138 x i8] c"Set the verbosity level of the result report generated by the testing framework. Use value 'no' to disable the results report completely.\00", align 1
@.str.597 = private unnamed_addr constant [2 x i8] c"r\00", align 1
@.str.598 = private unnamed_addr constant [38 x i8] c"File where to report memory leaks to.\00", align 1
@.str.599 = private unnamed_addr constant [34 x i8] c"BOOST_TEST_REPORT_MEMORY_LEAKS_TO\00", align 1
@.str.600 = private unnamed_addr constant [12 x i8] c"<file name>\00", align 1
@.str.601 = private unnamed_addr constant [11 x i8] c"Parameter \00", align 1
@.str.602 = private unnamed_addr constant [191 x i8] c" allows to specify a file where to report memory leaks to. The parameter does not have default value. If it is not specified, memory leaks (if any) are reported to the standard error stream.\00", align 1
@.str.603 = private unnamed_addr constant [61 x i8] c"Specifies report sink: stderr(default), stdout or file name.\00", align 1
@.str.604 = private unnamed_addr constant [23 x i8] c"BOOST_TEST_REPORT_SINK\00", align 1
@.str.605 = private unnamed_addr constant [191 x i8] c"Sets the result report sink - the location where the framework writes the result report to. The sink may be a a file or a standard stream. The default is 'stderr': the standard error stream.\00", align 1
@.str.606 = private unnamed_addr constant [2 x i8] c"e\00", align 1
@.str.607 = private unnamed_addr constant [48 x i8] c"Disables test modules's result code generation.\00", align 1
@.str.608 = private unnamed_addr constant [23 x i8] c"BOOST_TEST_RESULT_CODE\00", align 1
@.str.609 = private unnamed_addr constant [43 x i8] c"The 'no' argument value for the parameter \00", align 1
