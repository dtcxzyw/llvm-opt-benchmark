@.str.611 = private unnamed_addr constant [2 x i8] c"c\00", align 1
@.str.612 = private unnamed_addr constant [32 x i8] c"Filters which tests to execute.\00", align 1
@.str.613 = private unnamed_addr constant [23 x i8] c"BOOST_TEST_RUN_FILTERS\00", align 1
@.str.614 = private unnamed_addr constant [19 x i8] c"<test unit filter>\00", align 1
@.str.615 = private unnamed_addr constant [382 x i8] c"Filters which test units to execute. The framework supports both 'selection filters', which allow to select which test units to enable from the set of available test units, and 'disabler filters', which allow to disable some test units. Boost.test also supports enabling/disabling test units at compile time. These settings identify the default set of test units to run. Parameter \00", align 1
@.str.616 = private unnamed_addr constant [117 x i8] c" is used to change this default. This parameter is repeatable, so you can specify more than one filter if necessary.\00", align 1
@.str.617 = private unnamed_addr constant [2 x i8] c"t\00", align 1
@.str.618 = private unnamed_addr constant [63 x i8] c"Allows to switch between saving or matching test pattern file.\00", align 1
@.str.619 = private unnamed_addr constant [24 x i8] c"BOOST_TEST_SAVE_PATTERN\00", align 1
@.str.620 = private unnamed_addr constant [265 x i8] c" facilitates switching mode of operation for testing output streams.\0A\0AThis parameter serves no particular purpose within the framework itself. It can be used by test modules relying on output_test_stream to implement testing logic. Default mode is 'match' (false).\00", align 1
@.str.621 = private unnamed_addr constant [27 x i8] c"Turns on progress display.\00", align 1
@.str.622 = private unnamed_addr constant [25 x i8] c"BOOST_TEST_SHOW_PROGRESS\00", align 1
@.str.623 = private unnamed_addr constant [101 x i8] c"Instructs the framework to display the progress of the tests. This feature is turned off by default.\00", align 1
@.str.624 = private unnamed_addr constant [2 x i8] c"p\00", align 1
@.str.625 = private unnamed_addr constant [64 x i8] c"Turns on/off usage of an alternative stack for signal handling.\00", align 1
@.str.626 = private unnamed_addr constant [25 x i8] c"BOOST_TEST_USE_ALT_STACK\00", align 1
@.str.627 = private unnamed_addr constant [219 x i8] c"Instructs the framework to use an alternative stack for operating system's signals handling (on platforms where this is supported). The feature is enabled by default, but can be disabled using this command line switch.\00", align 1
@.str.628 = private unnamed_addr constant [78 x i8] c"Forces test module to wait for button to be pressed before starting test run.\00", align 1
@.str.629 = private unnamed_addr constant [29 x i8] c"BOOST_TEST_WAIT_FOR_DEBUGGER\00", align 1
@.str.630 = private unnamed_addr constant [172 x i8] c"Instructs the framework to pause before starting test units execution, so that you can attach a debugger to the test module process. This feature is turned off by default.\00", align 1
@.str.631 = private unnamed_addr constant [2 x i8] c"w\00", align 1
@.str.632 = private unnamed_addr constant [31 x i8] c"Help for framework parameters.\00", align 1
