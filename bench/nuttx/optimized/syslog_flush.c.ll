; ModuleID = 'bench/nuttx/original/syslog_flush.c.ll'
source_filename = "bench/nuttx/original/syslog_flush.c.ll"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@g_syslog_channel = external local_unnamed_addr global [1 x ptr], align 8

; Function Attrs: nounwind uwtable
define noundef i32 @syslog_flush() local_unnamed_addr #0 {
.critedge:
  %0 = load ptr, ptr @g_syslog_channel, align 8
  %1 = icmp eq ptr %0, null
  br i1 %1, label %8, label %2

2:                                                ; preds = %.critedge
  %3 = load ptr, ptr %0, align 8
  %4 = getelementptr inbounds i8, ptr %3, i64 16
  %5 = load ptr, ptr %4, align 8
  %.not = icmp eq ptr %5, null
  br i1 %.not, label %8, label %6

6:                                                ; preds = %2
  %7 = tail call i32 %5(ptr noundef nonnull %0) #1
  br label %8

8:                                                ; preds = %6, %2, %.critedge
  ret i32 0
}

attributes #0 = { nounwind uwtable "frame-pointer"="all" "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+rdrnd,+sse,+sse2,+x87" "tune-cpu"="generic" }
attributes #1 = { nounwind }

!llvm.module.flags = !{!0, !1, !2, !3, !4, !5}

!0 = !{i32 7, !"Dwarf Version", i32 5}
!1 = !{i32 2, !"Debug Info Version", i32 3}
