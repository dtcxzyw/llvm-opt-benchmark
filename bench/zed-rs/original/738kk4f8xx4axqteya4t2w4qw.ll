@anon.31b1a286ba77a0236d4eb2360ac932ee.721 = private unnamed_addr constant <{ [21882 x i8] }> <{ [21882 x i8] c"struct GlobalParams {\0A    viewport_size: vec2<f32>,\0A    premultiplied_alpha: u32,\0A    pad: u32,\0A}\0A\0Avar<uniform> globals: GlobalParams;\0Avar t_sprite: texture_2d<f32>;\0Avar s_sprite: sampler;\0A\0Aconst M_PI_F: f32 = 3.1415926;\0Aconst GRAYSCALE_FACTORS: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);\0A\0Astruct Bounds {\0A    origin: vec2<f32>,\0A    size: vec2<f32>,\0A}\0Astruct Corners {\0A    top_left: f32,\0A    top_right: f32,\0A    bottom_right: f32,\0A    bottom_left: f32,\0A}\0Astruct Edges {\0A    top: f32,\0A    right: f32,\0A    bottom: f32,\0A    left: f32,\0A}\0Astruct Hsla {\0A    h: f32,\0A    s: f32,\0A    l: f32,\0A    a: f32,\0A}\0A\0Astruct AtlasTextureId {\0A    index: u32,\0A    kind: u32,\0A}\0A\0Astruct AtlasBounds {\0A    origin: vec2<i32>,\0A    size: vec2<i32>,\0A}\0Astruct AtlasTile {\0A    texture_id: AtlasTextureId,\0A    tile_id: u32,\0A    padding: u32,\0A    bounds: AtlasBounds,\0A}\0A\0Astruct TransformationMatrix {\0A    rotation_scale: mat2x2<f32>,\0A    translation: vec2<f32>,\0A}\0A\0Afn to_device_position_impl(position: vec2<f32>) -> vec4<f32> {\0A    let device_position = position / globals.viewport_size * vec2<f32>(2.0, -2.0) + vec2<f32>(-1.0, 1.0);\0A    return vec4<f32>(device_position, 0.0, 1.0);\0A}\0A\0Afn to_device_position(unit_vertex: vec2<f32>, bounds: Bounds) -> vec4<f32> {\0A    let position = unit_vertex * vec2<f32>(bounds.size) + bounds.origin;\0A    return to_device_position_impl(position);\0A}\0A\0Afn to_device_position_transformed(unit_vertex: vec2<f32>, bounds: Bounds, transform: TransformationMatrix) -> vec4<f32> {\0A    let position = unit_vertex * vec2<f32>(bounds.size) + bounds.origin;\0A    //Note: Rust side stores it as row-major, so transposing here\0A    let transformed = transpose(transform.rotation_scale) * position + transform.translation;\0A    return to_device_position_impl(transformed);\0A}\0A\0Afn to_tile_position(unit_vertex: vec2<f32>, tile: AtlasTile) -> vec2<f32> {\0A  let atlas_size = vec2<f32>(textureDimensions(t_sprite, 0));\0A  return (vec2<f32>(tile.bounds.origin) + unit_vertex * vec2<f32>(tile.bounds.size)) / atlas_size;\0A}\0A\0Afn distance_from_clip_rect_impl(position: vec2<f32>, clip_bounds: Bounds) -> vec4<f32> {\0A    let tl = position - clip_bounds.origin;\0A    let br = clip_bounds.origin + clip_bounds.size - position;\0A    return vec4<f32>(tl.x, br.x, tl.y, br.y);\0A}\0A\0Afn distance_from_clip_rect(unit_vertex: vec2<f32>, bounds: Bounds, clip_bounds: Bounds) -> vec4<f32> {\0A    let position = unit_vertex * vec2<f32>(bounds.size) + bounds.origin;\0A    return distance_from_clip_rect_impl(position, clip_bounds);\0A}\0A\0A// https://gamedev.stackexchange.com/questions/92015/optimized-linear-to-srgb-glsl\0Afn srgb_to_linear(srgb: vec3<f32>) -> vec3<f32> {\0A    let cutoff = srgb < vec3<f32>(0.04045);\0A    let higher = pow((srgb + vec3<f32>(0.055)) / vec3<f32>(1.055), vec3<f32>(2.4));\0A    let lower = srgb / vec3<f32>(12.92);\0A    return select(higher, lower, cutoff);\0A}\0A\0Afn hsla_to_rgba(hsla: Hsla) -> vec4<f32> {\0A    let h = hsla.h * 6.0; // Now, it's an angle but scaled in [0, 6) range\0A    let s = hsla.s;\0A    let l = hsla.l;\0A    let a = hsla.a;\0A\0A    let c = (1.0 - abs(2.0 * l - 1.0)) * s;\0A    let x = c * (1.0 - abs(h % 2.0 - 1.0));\0A    let m = l - c / 2.0;\0A    var color = vec3<f32>(m);\0A\0A    if (h >= 0.0 && h < 1.0) {\0A        color.r += c;\0A        color.g += x;\0A    } else if (h >= 1.0 && h < 2.0) {\0A        color.r += x;\0A        color.g += c;\0A    } else if (h >= 2.0 && h < 3.0) {\0A        color.g += c;\0A        color.b += x;\0A    } else if (h >= 3.0 && h < 4.0) {\0A        color.g += x;\0A        color.b += c;\0A    } else if (h >= 4.0 && h < 5.0) {\0A        color.r += x;\0A        color.b += c;\0A    } else {\0A        color.r += c;\0A        color.b += x;\0A    }\0A\0A    // Input colors are assumed to be in sRGB space,\0A    // but blending and rendering needs to happen in linear space.\0A    // The output will be converted to sRGB by either the target\0A    // texture format or the swapchain color space.\0A    let linear = srgb_to_linear(color);\0A    return vec4<f32>(linear, a);\0A}\0A\0Afn over(below: vec4<f32>, above: vec4<f32>) -> vec4<f32> {\0A    let alpha = above.a + below.a * (1.0 - above.a);\0A    let color = (above.rgb * above.a + below.rgb * below.a * (1.0 - above.a)) / alpha;\0A    return vec4<f32>(color, alpha);\0A}\0A\0A// A standard gaussian function, used for weighting samples\0Afn gaussian(x: f32, sigma: f32) -> f32{\0A    return exp(-(x * x) / (2.0 * sigma * sigma)) / (sqrt(2.0 * M_PI_F) * sigma);\0A}\0A\0A// This approximates the error function, needed for the gaussian integral\0Afn erf(v: vec2<f32>) -> vec2<f32> {\0A    let s = sign(v);\0A    let a = abs(v);\0A    let r1 = 1.0 + (0.278393 + (0.230389 + (0.000972 + 0.078108 * a) * a) * a) * a;\0A    let r2 = r1 * r1;\0A    return s - s / (r2 * r2);\0A}\0A\0Afn blur_along_x(x: f32, y: f32, sigma: f32, corner: f32, half_size: vec2<f32>) -> f32 {\0A  let delta = min(half_size.y - corner - abs(y), 0.0);\0A  let curved = half_size.x - corner + sqrt(max(0.0, corner * corner - delta * delta));\0A  let integral = 0.5 + 0.5 * erf((x + vec2<f32>(-curved, curved)) * (sqrt(0.5) / sigma));\0A  return integral.y - integral.x;\0A}\0A\0Afn pick_corner_radius(point: vec2<f32>, radii: Corners) -> f32 {\0A    if (point.x < 0.0) {\0A        if (point.y < 0.0) {\0A            return radii.top_left;\0A        } else {\0A            return radii.bottom_left;\0A        }\0A    } else {\0A        if (point.y < 0.0) {\0A            return radii.top_right;\0A        } else {\0A            return radii.bottom_right;\0A        }\0A    }\0A}\0A\0Afn quad_sdf(point: vec2<f32>, bounds: Bounds, corner_radii: Corners) -> f32 {\0A    let half_size = bounds.size / 2.0;\0A    let center = bounds.origin + half_size;\0A    let center_to_point = point - center;\0A    let corner_radius = pick_corner_radius(center_to_point, corner_radii);\0A    let rounded_edge_to_point = abs(center_to_point) - half_size + corner_radius;\0A    return length(max(vec2<f32>(0.0), rounded_edge_to_point)) +\0A        min(0.0, max(rounded_edge_to_point.x, rounded_edge_to_point.y)) -\0A        corner_radius;\0A}\0A\0A// Abstract away the final color transformation based on the\0A// target alpha compositing mode.\0Afn blend_color(color: vec4<f32>, alpha_factor: f32) -> vec4<f32> {\0A    let alpha = color.a * alpha_factor;\0A    let multiplier = select(1.0, alpha, globals.premultiplied_alpha != 0u);\0A    return vec4<f32>(color.rgb * multiplier, alpha);\0A}\0A\0A// --- quads --- //\0A\0Astruct Quad {\0A    order: u32,\0A    pad: u32,\0A    bounds: Bounds,\0A    content_mask: Bounds,\0A    background: Hsla,\0A    border_color: Hsla,\0A    corner_radii: Corners,\0A    border_widths: Edges,\0A}\0Avar<storage, read> b_quads: array<Quad>;\0A\0Astruct QuadVarying {\0A    @builtin(position) position: vec4<f32>,\0A    @location(0) @interpolate(flat) background_color: vec4<f32>,\0A    @location(1) @interpolate(flat) border_color: vec4<f32>,\0A    @location(2) @interpolate(flat) quad_id: u32,\0A    //TODO: use `clip_distance` once Naga supports it\0A    @location(3) clip_distances: vec4<f32>,\0A}\0A\0A@vertex\0Afn vs_quad(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> QuadVarying {\0A    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));\0A    let quad = b_quads[instance_id];\0A\0A    var out = QuadVarying();\0A    out.position = to_device_position(unit_vertex, quad.bounds);\0A    out.background_color = hsla_to_rgba(quad.background);\0A    out.border_color = hsla_to_rgba(quad.border_color);\0A    out.quad_id = instance_id;\0A    out.clip_distances = distance_from_clip_rect(unit_vertex, quad.bounds, quad.content_mask);\0A    return out;\0A}\0A\0A@fragment\0Afn fs_quad(input: QuadVarying) -> @location(0) vec4<f32> {\0A    // Alpha clip first, since we don't have `clip_distance`.\0A    if (any(input.clip_distances < vec4<f32>(0.0))) {\0A        return vec4<f32>(0.0);\0A    }\0A\0A    let quad = b_quads[input.quad_id];\0A    // Fast path when the quad is not rounded and doesn't have any border.\0A    if (quad.corner_radii.top_left == 0.0 && quad.corner_radii.bottom_left == 0.0 &&\0A        quad.corner_radii.top_right == 0.0 &&\0A        quad.corner_radii.bottom_right == 0.0 && quad.border_widths.top == 0.0 &&\0A        quad.border_widths.left == 0.0 && quad.border_widths.right == 0.0 &&\0A        quad.border_widths.bottom == 0.0) {\0A        return blend_color(input.background_color, 1.0);\0A    }\0A\0A    let half_size = quad.bounds.size / 2.0;\0A    let center = quad.bounds.origin + half_size;\0A    let center_to_point = input.position.xy - center;\0A\0A    let corner_radius = pick_corner_radius(center_to_point, quad.corner_radii);\0A\0A    let rounded_edge_to_point = abs(center_to_point) - half_size + corner_radius;\0A    let distance =\0A      length(max(vec2<f32>(0.0), rounded_edge_to_point)) +\0A      min(0.0, max(rounded_edge_to_point.x, rounded_edge_to_point.y)) -\0A      corner_radius;\0A\0A    let vertical_border = select(quad.border_widths.left, quad.border_widths.right, center_to_point.x > 0.0);\0A    let horizontal_border = select(quad.border_widths.top, quad.border_widths.bottom, center_to_point.y > 0.0);\0A    let inset_size = half_size - corner_radius - vec2<f32>(vertical_border, horizontal_border);\0A    let point_to_inset_corner = abs(center_to_point) - inset_size;\0A\0A    var border_width = 0.0;\0A    if (point_to_inset_corner.x < 0.0 && point_to_inset_corner.y < 0.0) {\0A        border_width = 0.0;\0A    } else if (point_to_inset_corner.y > point_to_inset_corner.x) {\0A        border_width = horizontal_border;\0A    } else {\0A        border_width = vertical_border;\0A    }\0A\0A    var color = input.background_color;\0A    if (border_width > 0.0) {\0A        let inset_distance = distance + border_width;\0A        // Blend the border on top of the background and then linearly interpolate\0A        // between the two as we slide inside the background.\0A        let blended_border = over(input.background_color, input.border_color);\0A        color = mix(blended_border, input.background_color,\0A                    saturate(0.5 - inset_distance));\0A    }\0A\0A    return blend_color(color, saturate(0.5 - distance));\0A}\0A\0A// --- shadows --- //\0A\0Astruct Shadow {\0A    order: u32,\0A    blur_radius: f32,\0A    bounds: Bounds,\0A    corner_radii: Corners,\0A    content_mask: Bounds,\0A    color: Hsla,\0A}\0Avar<storage, read> b_shadows: array<Shadow>;\0A\0Astruct ShadowVarying {\0A    @builtin(position) position: vec4<f32>,\0A    @location(0) @interpolate(flat) color: vec4<f32>,\0A    @location(1) @interpolate(flat) shadow_id: u32,\0A    //TODO: use `clip_distance` once Naga supports it\0A    @location(3) clip_distances: vec4<f32>,\0A}\0A\0A@vertex\0Afn vs_shadow(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> ShadowVarying {\0A    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));\0A    var shadow = b_shadows[instance_id];\0A\0A    let margin = 3.0 * shadow.blur_radius;\0A    // Set the bounds of the shadow and adjust its size based on the shadow's\0A    // spread radius to achieve the spreading effect\0A    shadow.bounds.origin -= vec2<f32>(margin);\0A    shadow.bounds.size += 2.0 * vec2<f32>(margin);\0A\0A    var out = ShadowVarying();\0A    out.position = to_device_position(unit_vertex, shadow.bounds);\0A    out.color = hsla_to_rgba(shadow.color);\0A    out.shadow_id = instance_id;\0A    out.clip_distances = distance_from_clip_rect(unit_vertex, shadow.bounds, shadow.content_mask);\0A    return out;\0A}\0A\0A@fragment\0Afn fs_shadow(input: ShadowVarying) -> @location(0) vec4<f32> {\0A    // Alpha clip first, since we don't have `clip_distance`.\0A    if (any(input.clip_distances < vec4<f32>(0.0))) {\0A        return vec4<f32>(0.0);\0A    }\0A\0A    let shadow = b_shadows[input.shadow_id];\0A    let half_size = shadow.bounds.size / 2.0;\0A    let center = shadow.bounds.origin + half_size;\0A    let center_to_point = input.position.xy - center;\0A\0A    let corner_radius = pick_corner_radius(center_to_point, shadow.corner_radii);\0A\0A    // The signal is only non-zero in a limited range, so don't waste samples\0A    let low = center_to_point.y - half_size.y;\0A    let high = center_to_point.y + half_size.y;\0A    let start = clamp(-3.0 * shadow.blur_radius, low, high);\0A    let end = clamp(3.0 * shadow.blur_radius, low, high);\0A\0A    // Accumulate samples (we can get away with surprisingly few samples)\0A    let step = (end - start) / 4.0;\0A    var y = start + step * 0.5;\0A    var alpha = 0.0;\0A    for (var i = 0; i < 4; i += 1) {\0A        let blur = blur_along_x(center_to_point.x, center_to_point.y - y,\0A            shadow.blur_radius, corner_radius, half_size);\0A        alpha +=  blur * gaussian(y, shadow.blur_radius) * step;\0A        y += step;\0A    }\0A\0A    return blend_color(input.color, alpha);\0A}\0A\0A// --- path rasterization --- //\0A\0Astruct PathVertex {\0A    xy_position: vec2<f32>,\0A    st_position: vec2<f32>,\0A    content_mask: Bounds,\0A}\0Avar<storage, read> b_path_vertices: array<PathVertex>;\0A\0Astruct PathRasterizationVarying {\0A    @builtin(position) position: vec4<f32>,\0A    @location(0) st_position: vec2<f32>,\0A    //TODO: use `clip_distance` once Naga supports it\0A    @location(3) clip_distances: vec4<f32>,\0A}\0A\0A@vertex\0Afn vs_path_rasterization(@builtin(vertex_index) vertex_id: u32) -> PathRasterizationVarying {\0A    let v = b_path_vertices[vertex_id];\0A\0A    var out = PathRasterizationVarying();\0A    out.position = to_device_position_impl(v.xy_position);\0A    out.st_position = v.st