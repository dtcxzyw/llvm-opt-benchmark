@.str = private unnamed_addr constant [72 x i8] c"You have to compile with libprelude using ./configure --enable-prelude\0A\00", align 1

; Function Attrs: nounwind uwtable
define void @prelude_logging(ptr noundef %0, ptr noundef %1, ptr noundef %2, i32 noundef %3) #0 {
  %5 = alloca ptr, align 8
  %6 = alloca ptr, align 8
  %7 = alloca ptr, align 8
  %8 = alloca i32, align 4
  store ptr %0, ptr %5, align 8, !tbaa !3
  store ptr %1, ptr %6, align 8, !tbaa !3
  store ptr %2, ptr %7, align 8, !tbaa !3
  store i32 %3, ptr %8, align 4, !tbaa !8
  %9 = call i32 (i32, ptr, ...) @logg(i32 noundef 0, ptr noundef @.str)
  ret void
}

declare i32 @logg(i32 noundef, ptr noundef, ...) #1

