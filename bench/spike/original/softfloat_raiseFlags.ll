@softfloat_exceptionFlags = external global i8, align 1

; Function Attrs: nounwind uwtable
define void @softfloat_raiseFlags(i8 noundef zeroext %0) #0 {
  %2 = alloca i8, align 1
  store i8 %0, ptr %2, align 1
  %3 = load i8, ptr %2, align 1
  %4 = zext i8 %3 to i32
  %5 = load i8, ptr @softfloat_exceptionFlags, align 1
  %6 = zext i8 %5 to i32
  %7 = or i32 %6, %4
  %8 = trunc i32 %7 to i8
  store i8 %8, ptr @softfloat_exceptionFlags, align 1
  ret void
}

