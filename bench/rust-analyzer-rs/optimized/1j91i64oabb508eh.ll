@anon.6cb58fc054cbebc1183ce38d4f851cdf.818 = private unnamed_addr constant <{ [4260 x i8] }> <{ [4260 x i8] c"rust-analyzer\0A  LSP server for the Rust programming language.\0A\0A  Subcommands and their flags do not provide any stability guarantees and may be removed or\0A  changed without notice. Top-level flags that are not marked as [Unstable] provide\0A  backwards-compatibility and may be relied on.\0A\0AOPTIONS:\0A    -v, --verbose\0A      Verbosity level, can be repeated multiple times.\0A\0A    -q, --quiet\0A      Verbosity level.\0A\0A    --log-file <path>\0A      Log to the specified file instead of stderr.\0A\0A    --no-log-buffering\0A      Flush log records to the file immediately.\0A\0A    --wait-dbg\0A      [Unstable] Wait until a debugger is attached to (requires debug build).\0A\0A    -h, --help\0A      Prints help information.\0A\0A    -V, --version\0A      Print version.\0A\0A    --print-config-schema\0A      Dump a LSP config JSON schema.\0A\0ASUBCOMMANDS:\0A\0Arust-analyzer parse\0A  Parse stdin.\0A\0A  OPTIONS:\0A    --no-dump\0A      Suppress printing.\0A\0A\0Arust-analyzer symbols\0A  Parse stdin and print the list of symbols.\0A\0A\0Arust-analyzer highlight\0A  Highlight stdin as html.\0A\0A  OPTIONS:\0A    --rainbow\0A      Enable rainbow highlighting of identifiers.\0A\0A\0Arust-analyzer analysis-stats\0A  Batch typecheck project and print summary statistics\0A\0A  ARGS:\0A    <path>\0A      Directory with Cargo.toml.\0A\0A  OPTIONS:\0A    --output <format>\0A\0A    --randomize\0A      Randomize order in which crates, modules, and items are processed.\0A\0A    --parallel\0A      Run type inference in parallel.\0A\0A    --source-stats\0A      Print the total length of all source and macro files (whitespace is not counted).\0A\0A    -o, --only <path>\0A      Only analyze items matching this path.\0A\0A    --with-deps\0A      Also analyze all dependencies.\0A\0A    --no-sysroot\0A      Don't load sysroot crates (`std`, `core` & friends).\0A\0A    --query-sysroot-metadata\0A      Run cargo metadata on the sysroot to analyze its third-party dependencies.\0A      Requires --no-sysroot to not be set.\0A\0A    --disable-build-scripts\0A      Don't run build scripts or load `OUT_DIR` values by running `cargo check` before analysis.\0A\0A    --disable-proc-macros\0A      Don't use expand proc macros.\0A\0A    --skip-lowering\0A      Skip body lowering.\0A\0A    --skip-inference\0A      Skip type inference.\0A\0A    --skip-mir-stats\0A      Skip lowering to mir\0A\0A    --skip-data-layout\0A      Skip data layout calculation\0A\0A    --skip-const-eval\0A      Skip const evaluation\0A\0A    --run-all-ide-things\0A      Runs several IDE features after analysis, including semantics highlighting, diagnostics\0A      and annotations. This is useful for benchmarking the memory usage on a project that has\0A      been worked on for a bit in a longer running session.\0A\0A    --run-term-search\0A      Run term search on all the tail expressions (of functions, block, if statements etc.)\0A\0A    --validate-term-search\0A      Validate term search by running `cargo check` on every response.\0A      Note that this also temporarily modifies the files on disk, use with caution!\0A\0A\0Arust-analyzer run-tests\0A  Run unit tests of the project using mir interpreter\0A\0A  ARGS:\0A    <path>\0A      Directory with Cargo.toml.\0A\0A\0Arust-analyzer rustc-tests\0A  Run unit tests of the project using mir interpreter\0A\0A  ARGS:\0A    <rustc_repo>\0A      Directory with Cargo.toml.\0A\0A  OPTIONS:\0A    --filter <path>\0A      Only run tests with filter as substring\0A\0A\0Arust-analyzer diagnostics\0A\0A  ARGS:\0A    <path>\0A      Directory with Cargo.toml.\0A\0A  OPTIONS:\0A    --disable-build-scripts\0A      Don't run build scripts or load `OUT_DIR` values by running `cargo check` before analysis.\0A\0A    --disable-proc-macros\0A      Don't use expand proc macros.\0A\0A    --proc-macro-srv <path>\0A      Run a custom proc-macro-srv binary.\0A\0A\0Arust-analyzer ssr\0A\0A  ARGS:\0A    <rule>...\0A      A structured search replace rule (`$a.foo($b) ==>> bar($a, $b)`)\0A\0A\0Arust-analyzer search\0A\0A  ARGS:\0A    <pattern>...\0A      A structured search replace pattern (`$a.foo($b)`)\0A\0A  OPTIONS:\0A    --debug <snippet>\0A      Prints debug information for any nodes with source exactly equal to snippet.\0A\0A\0Arust-analyzer lsif\0A\0A  ARGS:\0A    <path>\0A\0A\0Arust-analyzer scip\0A\0A  ARGS:\0A    <path>\0A\0A  OPTIONS:\0A    --output <path>\0A      The output path where the SCIP file will be written to. Defaults to `index.scip`.\0A\0A    --config-path <config_path>\0A      A path to an json configuration file that can be used to customize cargo behavior.\0A" }>, align 1
