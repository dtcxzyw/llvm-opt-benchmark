@anon.3c5d4856225436a016f648d8ca8332b3.2229 = private unnamed_addr constant <{ [2961 x i8] }> <{ [2961 x i8] c"# `cmse_nonsecure_entry`\0A\0AThe tracking issue for this feature is: [#75835]\0A\0A[#75835]: https://github.com/rust-lang/rust/issues/75835\0A\0A------------------------\0A\0AThe [TrustZone-M\0Afeature](https://developer.arm.com/documentation/100690/latest/) is available\0Afor targets with the Armv8-M architecture profile (`thumbv8m` in their target\0Aname).\0ALLVM, the Rust compiler and the linker are providing\0A[support](https://developer.arm.com/documentation/ecm0359818/latest/) for the\0ATrustZone-M feature.\0A\0AOne of the things provided, with this unstable feature, is the\0A`cmse_nonsecure_entry` attribute.  This attribute marks a Secure function as an\0Aentry function (see [section\0A5.4](https://developer.arm.com/documentation/ecm0359818/latest/) for details).\0AWith this attribute, the compiler will do the following:\0A* add a special symbol on the function which is the `__acle_se_` prefix and the\0A  standard function name\0A* constrain the number of parameters to avoid using the Non-Secure stack\0A* before returning from the function, clear registers that might contain Secure\0A  information\0A* use the `BXNS` instruction to return\0A\0ABecause the stack can not be used to pass parameters, there will be compilation\0Aerrors if:\0A* the total size of all parameters is too big (for example more than four 32\0A  bits integers)\0A* the entry function is not using a C ABI\0A\0AThe special symbol `__acle_se_` will be used by the linker to generate a secure\0Agateway veneer.\0A\0A<!-- NOTE(ignore) this example is specific to thumbv8m targets -->\0A\0A``` rust,ignore\0A#![feature(cmse_nonsecure_entry)]\0A\0A#[no_mangle]\0A#[cmse_nonsecure_entry]\0Apub extern \22C\22 fn entry_function(input: u32) -> u32 {\0A    input + 6\0A}\0A```\0A\0A``` text\0A$ rustc --emit obj --crate-type lib --target thumbv8m.main-none-eabi function.rs\0A$ arm-none-eabi-objdump -D function.o\0A\0A00000000 <entry_function>:\0A   0:   b580            push    {r7, lr}\0A   2:   466f            mov     r7, sp\0A   4:   b082            sub     sp, #8\0A   6:   9001            str     r0, [sp, #4]\0A   8:   1d81            adds    r1, r0, #6\0A   a:   460a            mov     r2, r1\0A   c:   4281            cmp     r1, r0\0A   e:   9200            str     r2, [sp, #0]\0A  10:   d30b            bcc.n   2a <entry_function+0x2a>\0A  12:   e7ff            b.n     14 <entry_function+0x14>\0A  14:   9800            ldr     r0, [sp, #0]\0A  16:   b002            add     sp, #8\0A  18:   e8bd 4080       ldmia.w sp!, {r7, lr}\0A  1c:   4671            mov     r1, lr\0A  1e:   4672            mov     r2, lr\0A  20:   4673            mov     r3, lr\0A  22:   46f4            mov     ip, lr\0A  24:   f38e 8800       msr     CPSR_f, lr\0A  28:   4774            bxns    lr\0A  2a:   f240 0000       movw    r0, #0\0A  2e:   f2c0 0000       movt    r0, #0\0A  32:   f240 0200       movw    r2, #0\0A  36:   f2c0 0200       movt    r2, #0\0A  3a:   211c            movs    r1, #28\0A  3c:   f7ff fffe       bl      0 <_ZN4core9panicking5panic17h5c028258ca2fb3f5E>\0A  40:   defe            udf     #254    ; 0xfe\0A```\0A" }>, align 1
