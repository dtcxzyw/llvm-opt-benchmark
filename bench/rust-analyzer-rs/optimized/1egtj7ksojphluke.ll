rt\0A        .save   {r7, lr}\0A        push    {r7, lr}\0A        .setfp  r7, sp\0A        mov     r7, sp\0A        .pad    #16\0A        sub     sp, #16\0A        str     r0, [sp, #12]\0A        ldr     r0, [sp, #12]\0A        str     r0, [sp, #8]\0A        b       .LBB0_1\0A.LBB0_1:\0A        ldr     r0, [sp, #8]\0A        push.w  {r4, r5, r6, r7, r8, r9, r10, r11}\0A        bic     r0, r0, #1\0A        mov     r1, r0\0A        mov     r2, r0\0A        mov     r3, r0\0A        mov     r4, r0\0A        mov     r5, r0\0A        mov     r6, r0\0A        mov     r7, r0\0A        mov     r8, r0\0A        mov     r9, r0\0A        mov     r10, r0\0A        mov     r11, r0\0A        mov     r12, r0\0A        msr     apsr_nzcvq, r0\0A        blxns   r0\0A        pop.w   {r4, r5, r6, r7, r8, r9, r10, r11}\0A        str     r0, [sp, #4]\0A        b       .LBB0_2\0A.LBB0_2:\0A        ldr     r0, [sp, #4]\0A        add     sp, #16\0A        pop     {r7, pc}\0A```\0A" }>, align 1
