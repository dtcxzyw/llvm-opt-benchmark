@.str.40 = private unnamed_addr constant [1444 x i8] c"\0A// Helper functions for extracting fields from encoded instructions.\0A// InsnType must either be integral or an APInt-like object that must:\0A// * be default-constructible and copy-constructible\0A// * be constructible from an APInt (this can be private)\0A// * Support insertBits(bits, startBit, numBits)\0A// * Support extractBitsAsZExtValue(numBits, startBit)\0A// * Support the ~, &, ==, and != operators with other objects of the same type\0A// * Support the != and bitwise & with uint64_t\0A// * Support put (<<) to raw_ostream&\0Atemplate <typename InsnType>\0A#if defined(_MSC_VER) && !defined(__clang__)\0A__declspec(noinline)\0A#endif\0Astatic std::enable_if_t<std::is_integral<InsnType>::value, InsnType>\0AfieldFromInstruction(const InsnType &insn, unsigned startBit,\0A                     unsigned numBits) {\0A  assert(startBit + numBits <= 64 && \22Cannot support >64-bit extractions!\22);\0A  assert(startBit + numBits <= (sizeof(InsnType) * 8) &&\0A         \22Instruction field out of bounds!\22);\0A  InsnType fieldMask;\0A  if (numBits == sizeof(InsnType) * 8)\0A    fieldMask = (InsnType)(-1LL);\0A  else\0A    fieldMask = (((InsnType)1 << numBits) - 1) << startBit;\0A  return (insn & fieldMask) >> startBit;\0A}\0A\0Atemplate <typename InsnType>\0Astatic std::enable_if_t<!std::is_integral<InsnType>::value, uint64_t>\0AfieldFromInstruction(const InsnType &insn, unsigned startBit,\0A                     unsigned numBits) {\0A  return insn.extractBitsAsZExtValue(numBits, startBit);\0A}\0A\00", align 1
